#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveRegularChart.contDiff_regularMap

/-- info: 'MAIS.Run2PositiveRegularChart.regularMap_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
