-- ==================== begin module O7.Run2FullSpanSlice (formalization/O7/Run2FullSpanSlice.lean) ====================
section

/-! Actual full-span coordinates carry the physical normal complement and its
literal reduced zero-output product. No structural splitting is an input. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
noncomputable section
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2FullSpanSlice
open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear
open MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalNormal
open MAIS.Run2FullSpanCoordinates MAIS.Run2FullSpanProduct
open MAIS.MatrixCoordinateTransport MAIS.QuiverCoordinateMeasuredPair
open MAIS.Run2OrbitDifferentialCoordinates

section GeneralTransport
variable {D : ℕ} {ι κ : Fin (D+1) → Type*}
variable [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]
variable [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

omit [∀ v, DecidableEq (ι v)] [∀ v, DecidableEq (κ v)] in
/-- Literal coordinate covariance carries the actual entire tangent range. -/
theorem orbitDifferential_range_map (e : ∀ v, ι v ≃ κ v) (A : Rep ι) :
    (orbitDifferential ι A).range.map (coordinateLinearEquiv e).toLinearMap =
      (orbitDifferential κ (transport e A)).range := by
  ext y
  constructor
  · rintro ⟨x, ⟨X,hX⟩,hxy⟩
    refine ⟨lieCoordinates e X, ?_⟩
    rw [orbitDifferential_transport, hX]
    exact hxy
  · rintro ⟨Y,rfl⟩
    refine ⟨orbitDifferential ι A ((lieCoordinates e).symm Y), ⟨_,rfl⟩, ?_⟩
    change transport e (orbitDifferential ι A ((lieCoordinates e).symm Y)) = _
    rw [← orbitDifferential_transport, (lieCoordinates e).apply_symm_apply]

omit [∀ v, DecidableEq (ι v)] [∀ v, DecidableEq (κ v)] in
/-- A genuine normal complement remains a genuine complement after reindexing. -/
theorem isCompl_transport_normal (e : ∀ v, ι v ≃ κ v) (A : Rep ι)
    (N : Submodule ℝ (Rep ι)) (hN : IsCompl (orbitDifferential ι A).range N) :
    IsCompl (orbitDifferential κ (transport e A)).range
      (N.map (coordinateLinearEquiv e).toLinearMap) := by
  have h := (Submodule.orderIsoMapComap (coordinateLinearEquiv e)).isCompl_iff.mp hN
  change IsCompl ((orbitDifferential ι A).range.map (coordinateLinearEquiv e).toLinearMap)
    (N.map (coordinateLinearEquiv e).toLinearMap) at h
  rw [orbitDifferential_range_map] at h
  exact h
end GeneralTransport

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D+1)
abbrev SplitIndex (v : Fin (D+1)) := FullSlot D birth death ⊕ ReducedIndex D birth death v

def splitBase : Rep (SplitIndex D birth death) :=
  transport (vertexEquiv D birth death) (intervalRep D birth death)

def splitNormalSpace : Submodule ℝ (Rep (SplitIndex D birth death)) :=
  (normalSpace D birth death hD).map
    (coordinateLinearEquiv (vertexEquiv D birth death)).toLinearMap

/-- Original independent physical normal parameters identify with the
transported actual normal subspace, with no choice of a new complement. -/
def splitNormalParamEquiv : MAIS.IntervalCochainProduct.NormalParams birth death ≃L[ℝ]
    splitNormalSpace D birth death hD :=
  (MAIS.ActiveIntervalSliceChart.normalParamEquiv D birth death hD).trans
    ((coordinateLinearEquiv (vertexEquiv D birth death)).submoduleMap
      (normalSpace D birth death hD)).toContinuousLinearEquiv

omit [DecidableEq S] in
@[simp] theorem splitNormalParamEquiv_coe
    (t : MAIS.IntervalCochainProduct.NormalParams birth death) :
    ((splitNormalParamEquiv D birth death hD t : splitNormalSpace D birth death hD) :
      Rep (SplitIndex D birth death)) =
    transport (vertexEquiv D birth death) (normalInjection D birth death hD t) := rfl

/-- Reduced independent normal parameters give the actual transported subspace. -/
def reducedNormalParamEquiv :
    MAIS.IntervalCochainProduct.NormalParams (reducedBirth D birth death)
      (reducedDeath D birth death) ≃L[ℝ] splitNormalSpace D birth death hD :=
  (normalParamsEquiv D birth death hD).symm.trans (splitNormalParamEquiv D birth death hD)

/-- The complementary hypothesis required by the genuine ambient slice is derived. -/
theorem splitNormalSpace_isCompl (hvalid : ∀ s, birth s < death s) :
    IsCompl (orbitDifferential (SplitIndex D birth death) (splitBase D birth death)).range
      (splitNormalSpace D birth death hD) :=
  isCompl_transport_normal (vertexEquiv D birth death) (intervalRep D birth death)
    (normalSpace D birth death hD)
    (orbitDifferential_normalSpace_isCompl D birth death hD hvalid)

/-- Literal complete product in the actual transported normal space. -/
theorem split_normal_completeProduct
    (t : MAIS.IntervalCochainProduct.NormalParams birth death) :
    MAIS.MatrixChainIsomorphism.pathMatrix
      (splitBase D birth death +
        ((splitNormalParamEquiv D birth death hD t : splitNormalSpace D birth death hD) :
          Rep (SplitIndex D birth death)))
      0 (Fin.last D) (Nat.zero_le D) =
    Matrix.fromBlocks (1 : Matrix (FullSlot D birth death) (FullSlot D birth death) ℝ)
      0 0 (MAIS.MatrixChainIsomorphism.pathMatrix
        (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death) +
          normalInjection D (reducedBirth D birth death) (reducedDeath D birth death)
            (reduced_bound D birth death hD) (normalParamsEquiv D birth death hD t))
        0 (Fin.last D) (Nat.zero_le D)) := by
  rw [splitNormalParamEquiv_coe]
  change MAIS.MatrixChainIsomorphism.pathMatrix
    (transport (vertexEquiv D birth death)
      (intervalRep D birth death + normalInjection D birth death hD t))
    0 (Fin.last D) (Nat.zero_le D) = _
  rw [path_transport]
  exact reindex_normal_completeProduct D birth death hD t

include hD in
/-- The actual split base has the prescribed literal positive-rank target. -/
theorem split_base_completeProduct :
    MAIS.MatrixChainIsomorphism.pathMatrix (splitBase D birth death)
      0 (Fin.last D) (Nat.zero_le D) =
      Matrix.fromBlocks (1 : Matrix (FullSlot D birth death) (FullSlot D birth death) ℝ)
        0 0 (0 : Matrix (ReducedIndex D birth death (Fin.last D))
          (ReducedIndex D birth death 0) ℝ) := by
  rw [splitBase,path_transport]
  exact reindex_base_completeProduct D birth death hD


/-- In reduced independent coordinates the residual product is the literal
complete affine-normal product of the actual reduced interval family. -/
theorem reduced_normal_completeProduct
    (u : MAIS.IntervalCochainProduct.NormalParams (reducedBirth D birth death)
      (reducedDeath D birth death)) :
    MAIS.MatrixChainIsomorphism.pathMatrix
      (splitBase D birth death +
        ((reducedNormalParamEquiv D birth death hD u : splitNormalSpace D birth death hD) :
          Rep (SplitIndex D birth death)))
      0 (Fin.last D) (Nat.zero_le D) =
    Matrix.fromBlocks (1 : Matrix (FullSlot D birth death) (FullSlot D birth death) ℝ)
      0 0 (MAIS.MatrixChainIsomorphism.pathMatrix
        (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death) +
          normalInjection D (reducedBirth D birth death) (reducedDeath D birth death)
            (reduced_bound D birth death hD) u)
        0 (Fin.last D) (Nat.zero_le D)) := by
  have h := split_normal_completeProduct D birth death hD
    ((normalParamsEquiv D birth death hD).symm u)
  simpa only [reducedNormalParamEquiv, ContinuousLinearEquiv.trans_apply,
    ContinuousLinearEquiv.apply_symm_apply] using h

/-- Every actual normal vector has the exact identity/zero-block product
required by positive-target reconstruction; no splitting premise is supplied. -/
theorem splitNormalSpace_completeProduct (x : splitNormalSpace D birth death hD) :
    MAIS.MatrixChainIsomorphism.pathMatrix
      (splitBase D birth death + (x : Rep (SplitIndex D birth death)))
      0 (Fin.last D) (Nat.zero_le D) =
    Matrix.fromBlocks (1 : Matrix (FullSlot D birth death) (FullSlot D birth death) ℝ)
      0 0 (MAIS.MatrixChainIsomorphism.pathMatrix
        (splitBase D birth death + (x : Rep (SplitIndex D birth death)))
        0 (Fin.last D) (Nat.zero_le D)).toBlocks₂₂ := by
  have h := split_normal_completeProduct D birth death hD
    ((splitNormalParamEquiv D birth death hD).symm x)
  rw [(splitNormalParamEquiv D birth death hD).apply_symm_apply] at h
  rw [h]
  simp only [Matrix.toBlocks_fromBlocks₂₂]

end MAIS.Run2FullSpanSlice

/-- info: 'MAIS.Run2FullSpanSlice.orbitDifferential_range_map' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanSlice.orbitDifferential_range_map
/-- info: 'MAIS.Run2FullSpanSlice.isCompl_transport_normal' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanSlice.isCompl_transport_normal
/-- info: 'MAIS.Run2FullSpanSlice.splitNormalParamEquiv' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanSlice.splitNormalParamEquiv
/-- info: 'MAIS.Run2FullSpanSlice.splitNormalParamEquiv_coe' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
