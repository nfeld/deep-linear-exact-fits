-- ==================== begin module O7.ActiveIntervalBlocks (formalization/O7/ActiveIntervalBlocks.lean) ====================
section

/-! The actual active-interval orbit differential is conjugate, by literal
entry-coordinate bijections, to the product of actual scalar incidence matrices. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000

namespace MAIS.ActiveIntervalBlocks

open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.IntervalBlockRank
open MAIS.IntervalBlockDifferential MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalCoordinates
open scoped Matrix

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

omit [Fintype S] [DecidableEq S] in
/-- At every actual active matrix entry, the physical extension of the encoded
    cochain recovers the original actual entry. -/
theorem physicalValue_encodeLie (X : Lie (Index D birth death))
    (v : Fin (D + 1)) (r s : Index D birth death v) :
    physicalValue (max (birth s.val) (birth r.val))
      (vertexCount (birth s.val) (death s.val) (birth r.val) (death r.val))
      ((lieEquiv D birth death hD X) r.val s.val) v.val = X v r s := by
  let j := vertexCoordinate D birth death v r s
  have hNat : max (birth s.val) (birth r.val) + j.val = v.val :=
    congrArg Fin.val (physicalVertex_coordinate D birth death hD v r s)
  have hrec := congrArg (fun Y : Lie (Index D birth death) => Y v r s)
    ((lieEquiv D birth death hD).symm_apply_apply X)
  change (lieEquiv D birth death hD X) r.val s.val j = X v r s at hrec
  calc
    _ = physicalValue (max (birth s.val) (birth r.val))
      (vertexCount (birth s.val) (death s.val) (birth r.val) (death r.val))
      ((lieEquiv D birth death hD X) r.val s.val)
      (max (birth s.val) (birth r.val) + j.val) := by rw [hNat]
    _ = (lieEquiv D birth death hD X) r.val s.val j := physicalValue_own _ _ _ _
    _ = X v r s := hrec

/-- The actual matrix derivative entry is exactly the finite physical
    difference, including both possibly missing boundary vertex entries. -/
theorem orbitDifferential_entry_physical (X : Lie (Index D birth death)) (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    orbitDifferential (Index D birth death) (MAIS.ActiveIntervalDifferential.intervalRep D birth death) X e r s =
      physicalValue (max (birth s.val) (birth r.val))
        (vertexCount (birth s.val) (death s.val) (birth r.val) (death r.val))
        ((lieEquiv D birth death hD X) r.val s.val) (e.val + 1) -
      physicalValue (max (birth s.val) (birth r.val))
        (vertexCount (birth s.val) (death s.val) (birth r.val) (death r.val))
        ((lieEquiv D birth death hD X) r.val s.val) e.val := by
  rw [orbitDifferential_entry]
  congr 1
  · by_cases hs : active D birth death e.succ s.val
    · rw [dite_eq_left hs]
      exact (physicalValue_encodeLie D birth death hD X e.succ r ⟨s.val, hs⟩).symm
    · rw [dite_eq_right hs]
      symm
      apply physicalValue_zero_of_not_active
      intro hv
      exact hs ⟨hv.1, hv.2.1⟩
  · by_cases hr : active D birth death e.castSucc r.val
    · rw [dite_eq_left hr]
      exact (physicalValue_encodeLie D birth death hD X e.castSucc ⟨r.val, hr⟩ s).symm
    · rw [dite_eq_right hr]
      symm
      apply physicalValue_zero_of_not_active
      intro hv
      exact hr ⟨hv.2.2.1, hv.2.2.2⟩

/-- The literal actual orbit differential is conjugate to the full product
    of actual finite scalar incidence matrices, with no missing directions. -/
theorem repEquiv_orbitDifferential (X : Lie (Index D birth death)) :
    repEquiv D birth death hD
      (orbitDifferential (Index D birth death)
        (MAIS.ActiveIntervalDifferential.intervalRep D birth death) X) =
      MAIS.IntervalCochainProduct.differential birth death (lieEquiv D birth death hD X) := by
  funext r s i
  rw [repEquiv_apply, orbitDifferential_entry_physical]
  let e := physicalEdge D birth death hD r s i
  change physicalValue (max (birth s) (birth r))
      (vertexCount (birth s) (death s) (birth r) (death r))
      ((lieEquiv D birth death hD X) r s) (e.val + 1) -
    physicalValue (max (birth s) (birth r))
      (vertexCount (birth s) (death s) (birth r) (death r))
      ((lieEquiv D birth death hD X) r s) e.val =
    (shiftedDifference ℝ (max (birth s + 1) (birth r)) (max (birth s) (birth r))
      (arrowCount (birth s) (death s) (birth r) (death r))
      (vertexCount (birth s) (death s) (birth r) (death r))).mulVec
      ((lieEquiv D birth death hD X) r s) i
  have hq : e.val + 1 = max (birth s + 1) (birth r) + i.val :=
    (physicalArrow_properties D (birth s) (death s) (birth r) (death r) (hD r) i).2.2.2.2
  have hm := shiftedDifference_mulVec (max (birth s + 1) (birth r))
    (max (birth s) (birth r)) (arrowCount (birth s) (death s) (birth r) (death r))
    (vertexCount (birth s) (death s) (birth r) (death r))
    (by omega) ((lieEquiv D birth death hD X) r s) i
  rw [← hq] at hm
  exact hm.symm

/-- Equality of literal linear maps, useful for transporting images and kernels. -/
theorem conjugate_orbitDifferential :
    (repEquiv D birth death hD).toLinearMap.comp
      (orbitDifferential (Index D birth death)
        (MAIS.ActiveIntervalDifferential.intervalRep D birth death)) =
      (MAIS.IntervalCochainProduct.differential birth death).comp
        (lieEquiv D birth death hD).toLinearMap := by
  apply LinearMap.ext
  exact repEquiv_orbitDifferential D birth death hD

end MAIS.ActiveIntervalBlocks
end
-- ==================== end module O7.ActiveIntervalBlocks ====================

-- ==================== begin module O7.ActiveIntervalNormal (formalization/O7/ActiveIntervalNormal.lean) ====================
section

/-! An explicit physical entrance-arrow normal space in the literal active
interval matrix representation, suitable for the full ambient analytic chart. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000

namespace MAIS.ActiveIntervalNormal

open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.IntervalBlockRank
open MAIS.IntervalBlockDifferential MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalCoordinates
open MAIS.ActiveIntervalBlocks MAIS.IntervalCochainProduct MAIS.IntervalBlockGeometry
open scoped Matrix Matrix.Norms.Frobenius

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- Actual arrow matrices with independently prescribed physical entrance entries. -/
noncomputable def normalInjection : MAIS.IntervalCochainProduct.NormalParams birth death →ₗ[ℝ]
    Rep (Index D birth death) :=
  (repEquiv D birth death hD).symm.toLinearMap.comp
    (MAIS.IntervalCochainProduct.normalInjection birth death)

noncomputable def normalSpace : Submodule ℝ (Rep (Index D birth death)) :=
  (normalInjection D birth death hD).range

omit [Fintype S] [DecidableEq S] in
/-- The normal coordinates occupy exactly the physical arrow entering the
    target interval, with the actual source/target slot labels. -/
theorem normalInjection_apply (t : MAIS.IntervalCochainProduct.NormalParams birth death)
    (e : Fin D) (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    normalInjection D birth death hD t e r s =
      if h : Linked birth death r.val s.val then
        t ⟨(r.val, s.val), h⟩ * (if e.val + 1 = birth r.val then 1 else 0) else 0 := by
  change ((MAIS.IntervalCochainProduct.normalInjection birth death t) r.val s.val)
    (arrowCoordinate D birth death e r s) = _
  by_cases h : Linked birth death r.val s.val
  · have hzero : (arrowCoordinate D birth death e r s).val = 0 ↔
        e.val + 1 = birth r.val := by
      have hr := r.property
      have hlink : birth s.val < birth r.val ∧ birth r.val ≤ death s.val ∧
          death s.val < death r.val := h
      dsimp [active] at hr
      change e.val + 1 - max (birth s.val + 1) (birth r.val) = 0 ↔ _
      omega
    simp only [MAIS.IntervalCochainProduct.normalInjection, LinearMap.coe_mk, AddHom.coe_mk,
      dite_eq_left h, Pi.smul_apply, smul_eq_mul, firstVector, hzero]
  · simp only [MAIS.IntervalCochainProduct.normalInjection, LinearMap.coe_mk, AddHom.coe_mk,
      dite_eq_right h, Pi.zero_apply]

/-- The entry-coordinate isomorphism carries the actual orbit tangent image
    onto the full product of actual scalar matrix images. -/
theorem map_orbitDifferential_range :
    (orbitDifferential (Index D birth death)
      (MAIS.ActiveIntervalDifferential.intervalRep D birth death)).range.map
        (repEquiv D birth death hD).toLinearMap =
      (MAIS.IntervalCochainProduct.differential birth death).range := by
  rw [← LinearMap.range_comp, conjugate_orbitDifferential]
  exact LinearMap.range_comp_of_range_eq_top _ (lieEquiv D birth death hD).range

omit [Fintype S] [DecidableEq S] in
/-- The explicit actual normal injection is injective. -/
theorem normalInjection_injective : Function.Injective (normalInjection D birth death hD) :=
  (repEquiv D birth death hD).symm.injective.comp
    (MAIS.IntervalCochainProduct.normalInjection_injective birth death)

/-- The actual finite entry spaces split into orbit tangent and the physical
    entrance-arrow normal space, with no padding or formal quotient substitute. -/
theorem orbitDifferential_normalSpace_isCompl (hvalid : ∀ s, birth s < death s) :
    IsCompl (orbitDifferential (Index D birth death)
      (MAIS.ActiveIntervalDifferential.intervalRep D birth death)).range
      (normalSpace D birth death hD) := by
  apply (Submodule.orderIsoMapComap (repEquiv D birth death hD)).isCompl_iff.mpr
  change IsCompl
    ((orbitDifferential (Index D birth death)
      (MAIS.ActiveIntervalDifferential.intervalRep D birth death)).range.map
      (repEquiv D birth death hD).toLinearMap)
    ((normalSpace D birth death hD).map (repEquiv D birth death hD).toLinearMap)
  rw [map_orbitDifferential_range]
  have hn : (normalSpace D birth death hD).map (repEquiv D birth death hD).toLinearMap =
      (MAIS.IntervalCochainProduct.normalInjection birth death).range := by
    rw [normalSpace, ← LinearMap.range_comp]
    congr 1
    apply LinearMap.ext
    intro t
    exact (repEquiv D birth death hD).apply_symm_apply
      (MAIS.IntervalCochainProduct.normalInjection birth death t)
  rw [hn]
  exact differential_normalInjection_isCompl birth death hvalid

omit [DecidableEq S] in
/-- The actual normal-space dimension counts linked ordered multiplicity slots. -/
theorem finrank_normalSpace :
    Module.finrank ℝ (normalSpace D birth death hD) =
      Fintype.card (MAIS.IntervalCochainProduct.NormalIndex birth death) := by
  rw [normalSpace, LinearMap.finrank_range_of_inj (normalInjection_injective D birth death hD)]
  simp only [Module.finrank_pi]

include hD in
/-- Actual cokernel dimension of the actual orbit tangent map. -/
theorem finrank_orbitDifferential_cokernel (hvalid : ∀ s, birth s < death s) :
    Module.finrank ℝ (Rep (Index D birth death) ⧸
      (orbitDifferential (Index D birth death)
        (MAIS.ActiveIntervalDifferential.intervalRep D birth death)).range) =
      Fintype.card (MAIS.IntervalCochainProduct.NormalIndex birth death) := by
  have hsum := Submodule.finrank_add_eq_of_isCompl
    (orbitDifferential_normalSpace_isCompl D birth death hD hvalid)
  have hquot := Submodule.finrank_quotient_add_finrank
    (orbitDifferential (Index D birth death)
      (MAIS.ActiveIntervalDifferential.intervalRep D birth death)).range
  rw [finrank_normalSpace] at hsum
  omega

/-- An actual basis of the actual normal subspace, labelled by linked ordered
    multiplicity-slot pairs. -/
noncomputable def normalBasis : Module.Basis
    (MAIS.IntervalCochainProduct.NormalIndex birth death) ℝ (normalSpace D birth death hD) :=
  (Pi.basisFun ℝ (MAIS.IntervalCochainProduct.NormalIndex birth death)).map
    (LinearEquiv.ofInjective (normalInjection D birth death hD)
      (normalInjection_injective D birth death hD))

@[simp]
theorem normalBasis_apply_coe (p : MAIS.IntervalCochainProduct.NormalIndex birth death) :
    ((normalBasis D birth death hD) p : Rep (Index D birth death)) =
      normalInjection D birth death hD (Pi.single p 1) := by
  simp [normalBasis, Pi.basisFun_apply]
  rfl

/-- Each actual normal basis vector is the literal matrix unit in the physical
    entrance arrow of its linked target interval. -/
theorem normalBasis_entry (p : MAIS.IntervalCochainProduct.NormalIndex birth death)
    (e : Fin D) (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    ((normalBasis D birth death hD) p : Rep (Index D birth death)) e r s =
      if r.val = p.val.1 ∧ s.val = p.val.2 ∧ e.val + 1 = birth p.val.1 then 1 else 0 := by
  rw [normalBasis_apply_coe, normalInjection_apply]
  rcases p with ⟨⟨r0, s0⟩, hp⟩
  change Linked birth death r0 s0 at hp
  by_cases hr : r.val = r0
  · by_cases hs : s.val = s0
    · simp [hp, hr, hs]
    · simp [Subtype.ext_iff, Prod.mk.injEq, hs]
  · simp [Subtype.ext_iff, Prod.mk.injEq, hr]

end MAIS.ActiveIntervalNormal
end
-- ==================== end module O7.ActiveIntervalNormal ====================

-- ==================== begin module O7.MatrixPrefixPolynomial (formalization/O7/MatrixPrefixPolynomial.lean) ====================
section

/-! Literal rectangular prefix products over any semiring, with evaluation
commuting exactly with every actual matrix multiplication. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

universe u
namespace MAIS.MatrixPrefixPolynomial

open scoped Matrix
variable {D : ℕ} (I : Fin (D + 1) → Type u)
variable [∀ v, Fintype (I v)] [∀ v, DecidableEq (I v)]
variable {R T : Type*} [Semiring R] [Semiring T]

/-- The literal consecutive rectangular matrix product starting at vertex zero. -/
noncomputable def prefixProduct
    (A : (e : Fin D) → Matrix (I e.succ) (I e.castSucc) R) :
    (j : Fin (D + 1)) → Matrix (I j) (I 0) R :=
  Fin.induction 1 (fun e P => A e * P)

@[simp]
theorem prefixProduct_zero
    (A : (e : Fin D) → Matrix (I e.succ) (I e.castSucc) R) :
    prefixProduct I A 0 = 1 := rfl

@[simp]
theorem prefixProduct_succ
    (A : (e : Fin D) → Matrix (I e.succ) (I e.castSucc) R) (e : Fin D) :
    prefixProduct I A e.succ = A e * prefixProduct I A e.castSucc := rfl

/-- Ring-homomorphic evaluation commutes with the full actual finite product. -/
theorem map_prefixProduct (f : R →+* T)
    (A : (e : Fin D) → Matrix (I e.succ) (I e.castSucc) R)
    (j : Fin (D + 1)) :
    (prefixProduct I A j).map f = prefixProduct I (fun e => (A e).map f) j := by
  induction j using Fin.induction with
  | zero => simp only [prefixProduct_zero, Matrix.map_one f (map_zero f) (map_one f)]
  | succ e ih => simp only [prefixProduct_succ, Matrix.map_mul, ih]

/-- At real coefficients this semiring product is the actual composed-map
    matrix used in the orbit and rank classification theorems. -/
theorem pathMatrix_zero_eq_prefixProduct
    (A : MAIS.QuiverRealOrbit.Rep I) (j : Fin (D + 1)) :
    MAIS.MatrixChainIsomorphism.pathMatrix A 0 j (by exact Nat.zero_le j.val) =
      prefixProduct I A j := by
  induction j using Fin.induction with
  | zero => exact MAIS.MatrixChainIsomorphism.pathMatrix_self A 0
  | succ e ih =>
    rw [MAIS.MatrixChainIsomorphism.pathMatrix_step A 0 e (by exact Nat.zero_le e.val)]
    rw [ih, prefixProduct_succ]

/-- The actual product of affine arrow entries has degree at most the actual
    number of multiplied arrows.  This is a bound on the literal polynomials. -/
theorem totalDegree_prefixProduct_le {σ C : Type*} [CommSemiring C]
    (A : (e : Fin D) → Matrix (I e.succ) (I e.castSucc) (MvPolynomial σ C))
    (hA : ∀ e r s, (A e r s).totalDegree ≤ 1)
    (j : Fin (D + 1)) (r : I j) (s : I 0) :
    (prefixProduct I A j r s).totalDegree ≤ j.val := by
  induction j using Fin.induction with
  | zero =>
    simp only [prefixProduct_zero, Matrix.one_apply]
    split_ifs <;> simp
  | succ e ih =>
    rw [prefixProduct_succ, Matrix.mul_apply]
    apply MvPolynomial.totalDegree_finsetSum_le
    intro k _
    have h := (MvPolynomial.totalDegree_mul (A e r k)
      (prefixProduct I A e.castSucc k s)).trans (Nat.add_le_add (hA e r k) (ih k))
    simpa only [Fin.val_succ, Fin.val_castSucc, Nat.add_comm] using h

end MAIS.MatrixPrefixPolynomial
end
-- ==================== end module O7.MatrixPrefixPolynomial ====================

-- ==================== begin module O7.ActiveIntervalPathPolynomial (formalization/O7/ActiveIntervalPathPolynomial.lean) ====================
section

/-! The actual complete normal-slice path map as a multivariate polynomial,
with all nonlinear terms retained and literal evaluation into real matrices. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000

namespace MAIS.ActiveIntervalPathPolynomial

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.MatrixPrefixPolynomial
open scoped Matrix

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- Literal universal arrow entries, with one genuinely independent variable
    for each linked ordered slot pair at its physical entrance arrow. -/
noncomputable def universalArrow (e : Fin D) :
    Matrix (Index D birth death e.succ) (Index D birth death e.castSucc)
      (MvPolynomial (NormalIndex birth death) ℝ) := fun r s =>
  MvPolynomial.C (if r.val = s.val then 1 else 0) +
    if h : Linked birth death r.val s.val then
      if e.val + 1 = birth r.val then MvPolynomial.X ⟨(r.val, s.val), h⟩ else 0
    else 0

omit [Fintype S] in
/-- Evaluation is exactly the actual affine normal matrix, entry by entry. -/
theorem eval_universalArrow (t : NormalParams birth death) (e : Fin D) :
    (universalArrow D birth death e).map (MvPolynomial.eval t) =
      MAIS.ActiveIntervalDifferential.intervalRep D birth death e +
        MAIS.ActiveIntervalNormal.normalInjection D birth death hD t e := by
  ext r s
  simp only [Matrix.map_apply, universalArrow, map_add, MvPolynomial.eval_C,
    Matrix.add_apply, MAIS.ActiveIntervalDifferential.intervalRep,
    MAIS.ActiveIntervalNormal.normalInjection_apply]
  by_cases h : Linked birth death r.val s.val
  · by_cases he : e.val + 1 = birth r.val <;> simp [h, he]
  · simp [h]

/-- Every entry is the actual finite product of literal universal arrow
    matrices.  This includes every degree of the path map. -/
noncomputable def pathPolynomial (j : Fin (D + 1)) :
    Matrix (Index D birth death j) (Index D birth death 0)
      (MvPolynomial (NormalIndex birth death) ℝ) :=
  prefixProduct (Index D birth death) (universalArrow D birth death) j

/-- Exact full multivariate polynomial identity for the actual normal slice.
    There is no linearization, truncation, or assumed path expansion. -/
theorem eval_pathPolynomial (t : NormalParams birth death) (j : Fin (D + 1)) :
    (pathPolynomial D birth death j).map (MvPolynomial.eval t) =
      MAIS.MatrixChainIsomorphism.pathMatrix
        (MAIS.ActiveIntervalDifferential.intervalRep D birth death +
          MAIS.ActiveIntervalNormal.normalInjection D birth death hD t)
        0 j (by exact Nat.zero_le j.val) := by
  unfold pathPolynomial
  rw [map_prefixProduct, MAIS.MatrixPrefixPolynomial.pathMatrix_zero_eq_prefixProduct]
  congr 1
  funext e
  exact eval_universalArrow D birth death hD t e

/-- Literal entrywise form of the full normal-slice product polynomial. -/
theorem eval_pathPolynomial_entry (t : NormalParams birth death) (j : Fin (D + 1))
    (r : Index D birth death j) (s : Index D birth death 0) :
    MvPolynomial.eval t (pathPolynomial D birth death j r s) =
      MAIS.MatrixChainIsomorphism.pathMatrix
        (MAIS.ActiveIntervalDifferential.intervalRep D birth death +
          MAIS.ActiveIntervalNormal.normalInjection D birth death hD t)
        0 j (by exact Nat.zero_le j.val) r s :=
  congrFun (congrFun (eval_pathPolynomial D birth death hD t j) r) s

omit [Fintype S] in
/-- Each literal universal arrow entry is affine in the linked parameters. -/
theorem totalDegree_universalArrow_le (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    (universalArrow D birth death e r s).totalDegree ≤ 1 := by
  unfold universalArrow
  apply (MvPolynomial.totalDegree_add _ _).trans
  apply max_le
  · split_ifs <;> simp
  · split_ifs <;> simp

/-- All higher terms are retained, and the total degree is bounded by the
    literal path length. -/
theorem totalDegree_pathPolynomial_le (j : Fin (D + 1))
    (r : Index D birth death j) (s : Index D birth death 0) :
    (pathPolynomial D birth death j r s).totalDegree ≤ j.val :=
  totalDegree_prefixProduct_le (Index D birth death) (universalArrow D birth death)
    (totalDegree_universalArrow_le D birth death) j r s

/-- The actual complete half squared residual as a multivariate polynomial;
    the supplied target is arbitrary and all product terms are retained. -/
noncomputable def residualLossPolynomial (j : Fin (D + 1))
    (target : Matrix (Index D birth death j) (Index D birth death 0) ℝ) :
    MvPolynomial (NormalIndex birth death) ℝ :=
  MvPolynomial.C (1 / 2 : ℝ) * ∑ r, ∑ s,
    (pathPolynomial D birth death j r s - MvPolynomial.C (target r s)) ^ 2

/-- Literal sum-of-squared-entries loss identity, valid at every parameter. -/
theorem eval_residualLossPolynomial (j : Fin (D + 1))
    (target : Matrix (Index D birth death j) (Index D birth death 0) ℝ)
    (t : NormalParams birth death) :
    MvPolynomial.eval t (residualLossPolynomial D birth death j target) =
      (1 / 2 : ℝ) * ∑ r, ∑ s,
        (MAIS.MatrixChainIsomorphism.pathMatrix
          (MAIS.ActiveIntervalDifferential.intervalRep D birth death +
            MAIS.ActiveIntervalNormal.normalInjection D birth death hD t)
          0 j (by exact Nat.zero_le j.val) r s - target r s) ^ 2 := by
  simp only [residualLossPolynomial, map_mul, MvPolynomial.eval_C, map_sum,
    map_pow, map_sub, eval_pathPolynomial_entry D birth death hD]

/-- The complete arbitrary-target loss has degree at most twice the actual
    number of arrows. -/
theorem totalDegree_residualLossPolynomial_le (j : Fin (D + 1))
    (target : Matrix (Index D birth death j) (Index D birth death 0) ℝ) :
    (residualLossPolynomial D birth death j target).totalDegree ≤ 2 * j.val := by
  unfold residualLossPolynomial
  apply (MvPolynomial.totalDegree_mul _ _).trans
  simp only [MvPolynomial.totalDegree_C, zero_add]
  apply MvPolynomial.totalDegree_finsetSum_le
  intro r _
  apply MvPolynomial.totalDegree_finsetSum_le
  intro s _
  apply (MvPolynomial.totalDegree_pow _ 2).trans
  apply Nat.mul_le_mul_left
  exact (MvPolynomial.totalDegree_sub_C_le _ _).trans
    (totalDegree_pathPolynomial_le D birth death j r s)

end MAIS.ActiveIntervalPathPolynomial
end
-- ==================== end module O7.ActiveIntervalPathPolynomial ====================

-- ==================== begin module O7.Run2FullSpanCoordinates (formalization/O7/Run2FullSpanCoordinates.lean) ====================
section

/-! Literal isolation of full-span interval labels. These labels carry identity
arrows and cannot occur in a linked normal-coordinate pair. -/
set_option autoImplicit false
set_option maxHeartbeats 1200000
noncomputable section
namespace MAIS.Run2FullSpanCoordinates
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open scoped Matrix
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ)

def IsFull (s : S) : Prop := birth s = 0 ∧ death s = D + 1
instance isFull_decidable (s : S) : Decidable (IsFull D birth death s) := by
  unfold IsFull
  infer_instance
abbrev FullSlot := {s : S // IsFull D birth death s}
abbrev ReducedSlot := {s : S // ¬ IsFull D birth death s}
abbrev reducedBirth (s : ReducedSlot D birth death) : ℕ := birth s.val
abbrev reducedDeath (s : ReducedSlot D birth death) : ℕ := death s.val
abbrev ReducedIndex (v : Fin (D + 1)) :=
  Index D (reducedBirth D birth death) (reducedDeath D birth death) v

omit [Fintype S] [DecidableEq S] in
theorem full_active (s : FullSlot D birth death) (v : Fin (D + 1)) :
    active D birth death v s.val := by
  change birth s.val ≤ v.val ∧ v.val < death s.val
  rw [s.property.1, s.property.2]
  exact ⟨Nat.zero_le _, v.isLt⟩

/-- Actual vertex labels partition into full labels and the remaining active labels. -/
def vertexEquiv (v : Fin (D + 1)) :
    Index D birth death v ≃ FullSlot D birth death ⊕ ReducedIndex D birth death v := by
  classical
  exact {
    toFun := fun x => if h : IsFull D birth death x.val then
      Sum.inl ⟨x.val,h⟩ else Sum.inr ⟨⟨x.val,h⟩,x.property⟩
    invFun := fun x => match x with
      | Sum.inl f => ⟨f.val, full_active D birth death f v⟩
      | Sum.inr r => ⟨r.val.val,r.property⟩
    left_inv := by
      intro x
      by_cases h : IsFull D birth death x.val <;> simp [h]
    right_inv := by
      intro x
      cases x with
      | inl f => simp [f.property]
      | inr r => simp [r.val.property]
  }

omit [Fintype S] [DecidableEq S] in
theorem linked_target_not_full (p : NormalIndex birth death) :
    ¬ IsFull D birth death p.val.1 := by
  intro h
  have hp := p.property.1
  rw [h.1] at hp
  exact Nat.not_lt_zero _ hp

omit [Fintype S] [DecidableEq S] in
theorem linked_source_not_full (hD : ∀ s, death s ≤ D + 1)
    (p : NormalIndex birth death) : ¬ IsFull D birth death p.val.2 := by
  intro h
  have hp := p.property.2.2
  rw [h.2] at hp
  exact (Nat.not_lt_of_ge (hD p.val.1)) hp

/-- Actual independent normal coordinates are unchanged by deleting full labels. -/
def normalIndexEquiv (hD : ∀ s, death s ≤ D + 1) :
    NormalIndex birth death ≃
      NormalIndex (reducedBirth D birth death) (reducedDeath D birth death) where
  toFun p := ⟨(⟨p.val.1,linked_target_not_full D birth death p⟩,
      ⟨p.val.2,linked_source_not_full D birth death hD p⟩),p.property⟩
  invFun p := ⟨(p.val.1.val,p.val.2.val),p.property⟩
  left_inv p := by rfl
  right_inv p := by rfl

/-- The coordinate permutation is a genuine continuous linear equivalence. -/
def normalParamsEquiv (hD : ∀ s, death s ≤ D + 1) :
    NormalParams birth death ≃L[ℝ]
      NormalParams (reducedBirth D birth death) (reducedDeath D birth death) :=
  (LinearEquiv.piCongrLeft ℝ (fun _ => ℝ) (normalIndexEquiv D birth death hD)).toContinuousLinearEquiv

end MAIS.Run2FullSpanCoordinates

/-- info: 'MAIS.Run2FullSpanCoordinates.full_active' does not depend on any axioms -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanCoordinates.full_active
/-- info: 'MAIS.Run2FullSpanCoordinates.vertexEquiv' depends on axioms: [propext] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanCoordinates.vertexEquiv
/-- info: 'MAIS.Run2FullSpanCoordinates.linked_target_not_full' does not depend on any axioms -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanCoordinates.linked_target_not_full
/-- info: 'MAIS.Run2FullSpanCoordinates.normalIndexEquiv' does not depend on any axioms -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanCoordinates.normalIndexEquiv
/-- info: 'MAIS.Run2FullSpanCoordinates.normalParamsEquiv' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanCoordinates.normalParamsEquiv
end
end
