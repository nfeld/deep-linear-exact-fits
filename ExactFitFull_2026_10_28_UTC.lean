#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCodimension.relevant_nonempty

/-- info: 'MAIS.Run2GeometricCodimension.exists_orbit_realizing_localDimH' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCodimension.exists_orbit_realizing_localDimH

