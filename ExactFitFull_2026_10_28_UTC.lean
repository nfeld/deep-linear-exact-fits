-- ==================== begin module O7.Run2GeometricFiberAllDepth (formalization/O7/Run2GeometricFiberAllDepth.lean) ====================
section

/-! Genuine local product-fiber geometry at every finite depth. The depth-zero
case is treated by its actual zero-dimensional arrow carrier, independently of
the positive-depth regular-output reconstruction. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set
open scoped ENNReal NNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2GeometricFiberAllDepth
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.BarcodeActiveNormalForm
open MAIS.Run2GeometricCharts MAIS.Run2GeometricCodimCharts MAIS.Run2GeometricIntegralCodim
open MAIS.Run2GeometricActualFiber MAIS.Run2PositiveFiberTransport

theorem fixedProductFiber_depth_zero_eq_univ
    (ι : Fin 1 → Type*) [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)] (A : Rep ι) :
    fixedProductFiber ι A=univ := by
  ext B
  constructor
  · exact fun _=>mem_univ _
  · intro _
    exact congrArg (fun C : Rep ι=>pathMatrix C 0 (Fin.last 0) (Nat.zero_le 0))
      (Subsingleton.elim B A)

theorem localDimH_depth_zero
    (ι : Fin 1 → Type*) [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)] (A : Rep ι) :
    localDimH (fixedProductFiber ι A) A=0 := by
  apply le_antisymm
  · have h:=MAIS.Run2GeometricIntegralCodim.localDimH_le_ambient (fixedProductFiber ι A) A
    simpa only [Module.finrank_zero_of_subsingleton,Nat.cast_zero] using h
  · exact bot_le

theorem geometricCodimNat_depth_zero
    (ι : Fin 1 → Type*) [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)] (A : Rep ι) :
    geometricCodimNat (fixedProductFiber ι A) A=0 := by
  simp only [geometricCodimNat,Module.finrank_zero_of_subsingleton,Nat.zero_sub]

variable {D : ℕ} (ι : Fin (D+1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

/-- Actual integral local Hausdorff dimension of every actual product fiber,
with the actual normal form constructed internally in positive depth. -/
theorem integralLocalDimension (A : Rep ι) :
    ∃ n : ℕ,localDimH (fixedProductFiber ι A) A=(n:ℝ≥0∞) := by
  by_cases hD : 0<D
  · obtain ⟨N⟩ := exists_normal_form A
    exact fixedProductFiber_integralLocalDimension ι hD N
  · have hz : D=0 := by omega
    subst D
    exact ⟨0,by simpa only [Nat.cast_zero] using localDimH_depth_zero ι A⟩

/-- The true finite extended-real codimension and its natural presentation
agree at every finite depth; no floor or infinity ambiguity remains. -/
theorem actualCodimH_eq_nat (A : Rep ι) :
    geometricCodimH (fixedProductFiber ι A) A=
      (geometricCodimNat (fixedProductFiber ι A) A:ℝ≥0∞) :=
  geometricCodimH_eq_nat _ _ (integralLocalDimension ι A)
end MAIS.Run2GeometricFiberAllDepth

/-- info: 'MAIS.Run2GeometricFiberAllDepth.fixedProductFiber_depth_zero_eq_univ' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricFiberAllDepth.fixedProductFiber_depth_zero_eq_univ

/-- info: 'MAIS.Run2GeometricFiberAllDepth.localDimH_depth_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricFiberAllDepth.localDimH_depth_zero

/-- info: 'MAIS.Run2GeometricFiberAllDepth.geometricCodimNat_depth_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricFiberAllDepth.geometricCodimNat_depth_zero

/-- info: 'MAIS.Run2GeometricFiberAllDepth.integralLocalDimension' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricFiberAllDepth.integralLocalDimension

/-- info: 'MAIS.Run2GeometricFiberAllDepth.actualCodimH_eq_nat' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricFiberAllDepth.actualCodimH_eq_nat
end
end
