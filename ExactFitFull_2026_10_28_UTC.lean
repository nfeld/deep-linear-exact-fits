-- ==================== begin module O7.OptionPivotDeterminant (formalization/O7/OptionPivotDeterminant.lean) ====================
section

/-! Literal determinant derivative at an identity block plus one zero pivot. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open scoped Matrix Matrix.Norms.Elementwise
namespace MAIS.OptionPivotDeterminant
variable {K : Type*} [Fintype K] [DecidableEq K]

/-- The actual corank-one pivot base, including the empty identity block. -/
def pivotBase : Matrix (Option K) (Option K) ℝ :=
  Matrix.diagonal (fun i => if i = none then 0 else 1)

omit [Fintype K] in
@[simp] theorem pivotBase_none (j : Option K) : pivotBase (K := K) none j = 0 := by
  simp [pivotBase,Matrix.diagonal_apply]

omit [Fintype K] in
@[simp] theorem pivotBase_some (i : K) (j : Option K) :
    pivotBase (some i) j = (1 : Matrix (Option K) (Option K) ℝ) (some i) j := by
  simp [pivotBase,Matrix.diagonal_apply,Matrix.one_apply]

omit [Fintype K] in
@[simp] theorem pivotBase_some_some (i j : K) :
    pivotBase (some i) (some j) = if i = j then 1 else 0 := by
  simp [pivotBase,Matrix.diagonal_apply]

/-- Replace the missing pivot row: its determinant is its missing-pivot entry. -/
theorem det_update_none (v : Option K → ℝ) :
    Matrix.det (Matrix.updateRow (pivotBase (K := K)) none v) = v none := by
  have heq : Matrix.updateRow (pivotBase (K := K)) none v =
      Matrix.updateRow (1 : Matrix (Option K) (Option K) ℝ) none v := by
    ext i j
    change Function.update (pivotBase (K := K)) none v i j =
      Function.update (1 : Matrix (Option K) (Option K) ℝ) none v i j
    cases i <;> simp
  rw [heq]
  have hv : (∑ i : Option K, (v i) • (1 : Matrix (Option K) (Option K) ℝ) i) = v := by
    funext j
    simp [Matrix.one_apply,smul_eq_mul]
  simpa only [hv,Matrix.det_one,smul_eq_mul,mul_one] using
    Matrix.det_updateRow_sum (1 : Matrix (Option K) (Option K) ℝ) none v

/-- Replacing any other row leaves the actual zero pivot row untouched. -/
theorem det_update_some (i : K) (v : Option K → ℝ) :
    Matrix.det (Matrix.updateRow (pivotBase (K := K)) (some i) v) = 0 := by
  apply Matrix.det_eq_zero_of_row_eq_zero none
  intro j
  change Function.update (pivotBase (K := K)) (some i) v none j = 0
  simp

/-- The literal determinant, bundled as its actual continuous row-multilinear map. -/
def determinantMultilinear :
    ContinuousMultilinearMap ℝ (fun _ : Option K => Option K → ℝ) ℝ where
  toMultilinearMap := Matrix.detRowAlternating.toMultilinearMap
  cont := by
    change Continuous (fun M : Matrix (Option K) (Option K) ℝ => M.det)
    simp_rw [Matrix.det_apply']
    fun_prop

@[simp] theorem determinantMultilinear_apply (M : Matrix (Option K) (Option K) ℝ) :
    determinantMultilinear M = M.det := rfl

/-- The literal determinant is analytic on its actual finite matrix carrier. -/
theorem analyticAt_det (M : Matrix (Option K) (Option K) ℝ) :
    AnalyticAt ℝ (fun N : Matrix (Option K) (Option K) ℝ => N.det) M := by
  change AnalyticAt ℝ (determinantMultilinear (K := K)) M
  exact (determinantMultilinear (K := K)).analyticAt

/-- Smoothness follows from the actual determinant polynomial/multilinear map. -/
theorem contDiff_det {n : WithTop ℕ∞} :
    ContDiff ℝ n (fun N : Matrix (Option K) (Option K) ℝ => N.det) := by
  exact contDiff_iff_contDiffAt.mpr (fun M => (analyticAt_det M).contDiffAt)

/-- The derived full Fréchet derivative is exactly evaluation at the missing pivot. -/
theorem linearDeriv_pivot (H : Matrix (Option K) (Option K) ℝ) :
    (determinantMultilinear (K := K)).linearDeriv pivotBase H = H none none := by
  rw [ContinuousMultilinearMap.linearDeriv_apply]
  have hrow : ∀ i : Option K,
      determinantMultilinear (Function.update (pivotBase (K := K)) i (H i)) =
        if i = none then H none none else 0 := by
    intro i
    change (Matrix.updateRow (pivotBase (K := K)) i (H i)).det = _
    cases i with
    | none => simpa only [ite_true] using det_update_none (H none)
    | some i => simpa only [Option.some_ne_none,ite_false] using det_update_some i (H (some i))

  simp_rw [hrow]
  simp

/-- The actual continuous linear missing-pivot coordinate. -/
def pivotEntry : Matrix (Option K) (Option K) ℝ →L[ℝ] ℝ :=
  (ContinuousLinearMap.proj (R := ℝ) (none : Option K) : (Option K → ℝ) →L[ℝ] ℝ).comp
    (ContinuousLinearMap.proj (R := ℝ) (none : Option K) :
      Matrix (Option K) (Option K) ℝ →L[ℝ] (Option K → ℝ))

omit [Fintype K] [DecidableEq K] in
@[simp] theorem pivotEntry_apply (M : Matrix (Option K) (Option K) ℝ) :
    pivotEntry M = M none none := rfl

/-- No determinant differential is assumed: the actual row-multilinear
formula derives it from the actual identity-block matrix. -/
theorem hasFDerivAt_det_pivot :
    HasFDerivAt (fun M : Matrix (Option K) (Option K) ℝ => M.det)
      pivotEntry pivotBase := by
  change HasFDerivAt (determinantMultilinear (K := K)) pivotEntry pivotBase
  apply (determinantMultilinear (K := K)).hasFDerivAt pivotBase |>.congr_fderiv
  ext H
  exact linearDeriv_pivot H

/-- The same actual multilinear calculation supplies a strict derivative,
which is directly usable in an inverse-function argument. -/
theorem hasStrictFDerivAt_det_pivot :
    HasStrictFDerivAt (fun M : Matrix (Option K) (Option K) ℝ => M.det)
      pivotEntry pivotBase := by
  change HasStrictFDerivAt (determinantMultilinear (K := K)) pivotEntry pivotBase
  apply (determinantMultilinear (K := K)).hasStrictFDerivAt pivotBase |>.congr_fderiv
  ext H
  exact linearDeriv_pivot H

end MAIS.OptionPivotDeterminant
end

