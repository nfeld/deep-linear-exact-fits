-- ==================== begin module O7.Run2FullSpanProduct (formalization/O7/Run2FullSpanProduct.lean) ====================
section

/-! Literal block identity for every affine normal arrow and every complete
prefix product after actual full-span labels have been isolated. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000
noncomputable section
namespace MAIS.Run2FullSpanProduct
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.Run2FullSpanCoordinates MAIS.ActiveIntervalNormal
open MAIS.MatrixPrefixPolynomial
open scoped Matrix
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D+1)

omit [Fintype S] [DecidableEq S] in
@[simp] theorem vertexEquiv_symm_inl (v : Fin (D+1)) (f : FullSlot D birth death) :
    (vertexEquiv D birth death v).symm (Sum.inl f) =
      ⟨f.val,full_active D birth death f v⟩ := rfl
omit [Fintype S] [DecidableEq S] in
@[simp] theorem vertexEquiv_symm_inr (v : Fin (D+1)) (r : ReducedIndex D birth death v) :
    (vertexEquiv D birth death v).symm (Sum.inr r) = ⟨r.val.val,r.property⟩ := rfl
omit [DecidableEq S] in
@[simp] theorem normalParamsEquiv_apply (t : NormalParams birth death)
    (p : NormalIndex (reducedBirth D birth death) (reducedDeath D birth death)) :
    normalParamsEquiv D birth death hD t p =
      t ⟨(p.val.1.val,p.val.2.val),p.property⟩ := rfl

include hD in
omit [Fintype S] [DecidableEq S] in
/-- The reduced family satisfies the same literal upper endpoint bound. -/
theorem reduced_bound (s : ReducedSlot D birth death) :
    reducedDeath D birth death s ≤ D+1 := hD s.val

/-- Every actual affine normal arrow is exactly identity plus the reduced arrow. -/
theorem reindex_normal_arrow (t : NormalParams birth death) (e : Fin D) :
    Matrix.reindex (vertexEquiv D birth death e.succ)
      (vertexEquiv D birth death e.castSucc)
      ((intervalRep D birth death + MAIS.ActiveIntervalNormal.normalInjection D birth death hD t) e) =
    Matrix.fromBlocks (1 : Matrix (FullSlot D birth death) (FullSlot D birth death) ℝ)
      0 0 ((intervalRep D (reducedBirth D birth death) (reducedDeath D birth death) +
        MAIS.ActiveIntervalNormal.normalInjection D (reducedBirth D birth death) (reducedDeath D birth death)
          (reduced_bound D birth death hD) (normalParamsEquiv D birth death hD t)) e) := by
  classical
  ext r s
  cases r with
  | inl r =>
    have hlink (x : S) : ¬ Linked birth death r.val x := by
      intro h; have hlt := h.1; rw [r.property.1] at hlt; omega
    cases s with
    | inl s =>
      simp [Matrix.reindex_apply, Matrix.submatrix_apply, intervalRep,
        normalInjection_apply, hlink, Matrix.one_apply, Subtype.ext_iff]
    | inr s =>
      have hne : r.val ≠ s.val.val := by
        intro he; apply s.val.property; rw [← he]; exact r.property
      simp [Matrix.reindex_apply, Matrix.submatrix_apply, intervalRep,
        normalInjection_apply, hlink, hne]
  | inr r =>
    cases s with
    | inl s =>
      have hlink : ¬ Linked birth death r.val.val s.val := by
        intro h; have hlt := h.2.2; rw [s.property.2] at hlt
        exact (Nat.not_lt_of_ge (hD r.val.val)) hlt
      have hne : r.val.val ≠ s.val := by
        intro he; apply r.val.property; rw [he]; exact s.property
      simp [Matrix.reindex_apply, Matrix.submatrix_apply, intervalRep,
        normalInjection_apply, hlink, hne]
    | inr s =>
      simp only [Matrix.reindex_apply, Matrix.submatrix_apply,
        vertexEquiv_symm_inr, Pi.add_apply, Matrix.add_apply,
        Matrix.fromBlocks_apply₂₂, normalInjection_apply, intervalRep]
      have heq : (r.val = s.val) ↔ r.val.val = s.val.val := Subtype.ext_iff
      simp only [heq]
      by_cases h : Linked birth death r.val.val s.val.val
      · have hr : Linked (reducedBirth D birth death) (reducedDeath D birth death)
            r.val s.val := h
        simp only [h, hr, dite_true, normalParamsEquiv_apply]
      · have hr : ¬ Linked (reducedBirth D birth death) (reducedDeath D birth death)
            r.val s.val := h
        simp only [h, hr, dite_false]


/-- Every literal prefix product has the exact block decomposition. -/
theorem reindex_normal_prefix (t : NormalParams birth death) (j : Fin (D+1)) :
    Matrix.reindex (vertexEquiv D birth death j) (vertexEquiv D birth death 0)
      (prefixProduct (Index D birth death)
        (intervalRep D birth death + MAIS.ActiveIntervalNormal.normalInjection D birth death hD t) j) =
    Matrix.fromBlocks (1 : Matrix (FullSlot D birth death) (FullSlot D birth death) ℝ)
      0 0 (prefixProduct (ReducedIndex D birth death)
        (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death) +
        MAIS.ActiveIntervalNormal.normalInjection D (reducedBirth D birth death)
          (reducedDeath D birth death) (reduced_bound D birth death hD)
          (normalParamsEquiv D birth death hD t)) j) := by
  classical
  induction j using Fin.induction with
  | zero =>
    simp [Matrix.reindex_apply, Matrix.submatrix_one_equiv]
  | succ e ih =>
    rw [prefixProduct_succ]
    rw [Matrix.reindex_apply, ← Matrix.submatrix_mul_equiv _ _ _
      (vertexEquiv D birth death e.castSucc).symm _]
    change Matrix.reindex (vertexEquiv D birth death e.succ)
      (vertexEquiv D birth death e.castSucc)
      ((intervalRep D birth death + MAIS.ActiveIntervalNormal.normalInjection D birth death hD t) e) *
      Matrix.reindex (vertexEquiv D birth death e.castSucc) (vertexEquiv D birth death 0)
        (prefixProduct (Index D birth death)
          (intervalRep D birth death + MAIS.ActiveIntervalNormal.normalInjection D birth death hD t)
          e.castSucc) = _
    rw [reindex_normal_arrow, ih, Matrix.fromBlocks_multiply]
    simp only [Matrix.mul_one, Matrix.mul_zero, Matrix.zero_mul,
      add_zero, zero_add, prefixProduct_succ]

/-- The complete actual product, not merely its derivative, splits off identity. -/
theorem reindex_normal_completeProduct (t : NormalParams birth death) :
    Matrix.reindex (vertexEquiv D birth death (Fin.last D)) (vertexEquiv D birth death 0)
      (MAIS.MatrixChainIsomorphism.pathMatrix
        (intervalRep D birth death + MAIS.ActiveIntervalNormal.normalInjection D birth death hD t)
        0 (Fin.last D) (Nat.zero_le D)) =
    Matrix.fromBlocks (1 : Matrix (FullSlot D birth death) (FullSlot D birth death) ℝ)
      0 0 (MAIS.MatrixChainIsomorphism.pathMatrix
        (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death) +
        MAIS.ActiveIntervalNormal.normalInjection D (reducedBirth D birth death)
          (reducedDeath D birth death) (reduced_bound D birth death hD)
          (normalParamsEquiv D birth death hD t))
        0 (Fin.last D) (Nat.zero_le D)) := by
  rw [pathMatrix_zero_eq_prefixProduct, pathMatrix_zero_eq_prefixProduct]
  exact reindex_normal_prefix D birth death hD t (Fin.last D)


include hD in
/-- The reduced base has actual zero complete product, including depth zero. -/
theorem reduced_base_completeProduct_zero :
    MAIS.MatrixChainIsomorphism.pathMatrix
      (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death))
      0 (Fin.last D) (Nat.zero_le D) = 0 := by
  apply (MAIS.ActiveIntervalBasePaths.pathMatrix_intervalRep_eq_zero_iff
    D (reducedBirth D birth death) (reducedDeath D birth death)
    0 (Fin.last D) (Nat.zero_le D)).mpr
  intro s hs
  apply s.property
  change birth s.val = 0 ∧ death s.val = D+1
  have hinput := hs.1.1
  have houtput := hs.2.2
  have hbound := hD s.val
  change birth s.val ≤ 0 at hinput
  change D < death s.val at houtput
  omega

include hD in
/-- The actual base complete product becomes the literal rank block diag(I,0). -/
theorem reindex_base_completeProduct :
    Matrix.reindex (vertexEquiv D birth death (Fin.last D)) (vertexEquiv D birth death 0)
      (MAIS.MatrixChainIsomorphism.pathMatrix (intervalRep D birth death)
        0 (Fin.last D) (Nat.zero_le D)) =
    Matrix.fromBlocks (1 : Matrix (FullSlot D birth death) (FullSlot D birth death) ℝ)
      0 0 (0 : Matrix (ReducedIndex D birth death (Fin.last D))
        (ReducedIndex D birth death 0) ℝ) := by
  have h := reindex_normal_completeProduct D birth death hD 0
  simp only [map_zero, add_zero] at h
  rw [reduced_base_completeProduct_zero D birth death hD] at h
  exact h

end MAIS.Run2FullSpanProduct

/-- info: 'MAIS.Run2FullSpanProduct.reindex_normal_arrow' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanProduct.reindex_normal_arrow
/-- info: 'MAIS.Run2FullSpanProduct.reindex_normal_prefix' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanProduct.reindex_normal_prefix
/-- info: 'MAIS.Run2FullSpanProduct.reindex_normal_completeProduct' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanProduct.reindex_normal_completeProduct
/-- info: 'MAIS.Run2FullSpanProduct.reduced_base_completeProduct_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanProduct.reduced_base_completeProduct_zero
/-- info: 'MAIS.Run2FullSpanProduct.reindex_base_completeProduct' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanProduct.reindex_base_completeProduct
end
end
-- ==================== end module O7.Run2FullSpanProduct ====================

-- ==================== begin module O7.Run2OrbitDifferentialCoordinates (formalization/O7/Run2OrbitDifferentialCoordinates.lean) ====================
section

/-! Literal vertex-coordinate bijections preserve the actual orbit tangent
range dimension, through an actual reindexing of the stabilizer kernel. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1100000
noncomputable section
open scoped Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2OrbitDifferentialCoordinates
open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear
open MAIS.MatrixCoordinateTransport MAIS.QuiverCoordinateMeasuredPair

variable {D : ℕ} {ι κ : Fin (D + 1) → Type*}
variable [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]
variable [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

def lieCoordinates (e : ∀ v, ι v ≃ κ v) : Lie ι ≃ₗ[ℝ] Lie κ where
  toFun X v := (X v).submatrix (e v).symm (e v).symm
  invFun X v := (X v).submatrix (e v) (e v)
  left_inv X := by ext v r s; simp only [Matrix.submatrix_apply, Equiv.symm_apply_apply]
  right_inv X := by ext v r s; simp only [Matrix.submatrix_apply, Equiv.apply_symm_apply]
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

omit [∀ v, DecidableEq (ι v)] [∀ v, DecidableEq (κ v)] in
theorem orbitDifferential_transport (e : ∀ v, ι v ≃ κ v) (A : Rep ι) (X : Lie ι) :
    orbitDifferential κ (transport e A) (lieCoordinates e X) =
      transport e (orbitDifferential ι A X) := by
  funext k
  change (X k.succ).submatrix (e k.succ).symm (e k.succ).symm *
      (A k).submatrix (e k.succ).symm (e k.castSucc).symm -
      (A k).submatrix (e k.succ).symm (e k.castSucc).symm *
      (X k.castSucc).submatrix (e k.castSucc).symm (e k.castSucc).symm =
    (X k.succ * A k - A k * X k.castSucc).submatrix (e k.succ).symm (e k.castSucc).symm
  rw [Matrix.submatrix_mul_equiv, Matrix.submatrix_mul_equiv]
  rfl

def kernelEquiv (e : ∀ v, ι v ≃ κ v) (A : Rep ι) :
    (orbitDifferential ι A).ker ≃ₗ[ℝ] (orbitDifferential κ (transport e A)).ker where
  toFun X := ⟨lieCoordinates e X.val, by
    rw [LinearMap.mem_ker, orbitDifferential_transport, X.property]
    exact (coordinateLinearEquiv e).map_zero⟩
  invFun Y := ⟨(lieCoordinates e).symm Y.val, by
    have h := orbitDifferential_transport e A ((lieCoordinates e).symm Y.val)
    rw [(lieCoordinates e).apply_symm_apply, Y.property] at h
    apply (coordinateLinearEquiv e).injective
    exact h.symm.trans ((coordinateLinearEquiv e).map_zero).symm⟩
  left_inv X := by apply Subtype.ext; exact (lieCoordinates e).symm_apply_apply X.val
  right_inv Y := by apply Subtype.ext; exact (lieCoordinates e).apply_symm_apply Y.val
  map_add' X Y := by apply Subtype.ext; exact map_add _ _ _
  map_smul' c X := by apply Subtype.ext; exact map_smul _ _ _

omit [∀ v, DecidableEq (ι v)] [∀ v, DecidableEq (κ v)] in
theorem finrank_range_transport (e : ∀ v, ι v ≃ κ v) (A : Rep ι) :
    Module.finrank ℝ (orbitDifferential κ (transport e A)).range =
      Module.finrank ℝ (orbitDifferential ι A).range := by
  have hk := (kernelEquiv e A).finrank_eq
  have hLie := (lieCoordinates e).finrank_eq
  have hA := (orbitDifferential ι A).finrank_range_add_finrank_ker
  have hT := (orbitDifferential κ (transport e A)).finrank_range_add_finrank_ker
  omega

end MAIS.Run2OrbitDifferentialCoordinates

/-- info: 'MAIS.Run2OrbitDifferentialCoordinates.lieCoordinates' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OrbitDifferentialCoordinates.lieCoordinates

/-- info: 'MAIS.Run2OrbitDifferentialCoordinates.orbitDifferential_transport' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OrbitDifferentialCoordinates.orbitDifferential_transport

/-- info: 'MAIS.Run2OrbitDifferentialCoordinates.kernelEquiv' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OrbitDifferentialCoordinates.kernelEquiv

/-- info: 'MAIS.Run2OrbitDifferentialCoordinates.finrank_range_transport' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OrbitDifferentialCoordinates.finrank_range_transport
end
end
-- ==================== end module O7.Run2OrbitDifferentialCoordinates ====================

-- ==================== begin module O7.ActiveIntervalSliceChart (formalization/O7/ActiveIntervalSliceChart.lean) ====================
section

/-! Full ambient real-analytic coordinates with independent scalar physical
entrance-arrow parameters for actual finite interval matrix representations. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000

namespace MAIS.ActiveIntervalSliceChart

open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.ActiveIntervalDifferential
open MAIS.ActiveIntervalCoordinates MAIS.OrbitSliceChart MAIS.OrbitSliceAnalytic
open MAIS.MatrixChainIsomorphism
open scoped Matrix Matrix.Norms.Frobenius Topology

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- Actual gauge directions complementary to the actual stabilizer Lie algebra. -/
noncomputable abbrev TangentParameters :=
  orbitDirections (Index D birth death) (MAIS.ActiveIntervalDifferential.intervalRep D birth death)

/-- Actual scalar entrance coordinates identify linearly and topologically with
    the explicit physical normal subspace. -/
noncomputable def normalParamEquiv : MAIS.IntervalCochainProduct.NormalParams birth death ≃L[ℝ]
    MAIS.ActiveIntervalNormal.normalSpace D birth death hD :=
  (LinearEquiv.ofInjective (MAIS.ActiveIntervalNormal.normalInjection D birth death hD)
    (MAIS.ActiveIntervalNormal.normalInjection_injective D birth death hD)).toContinuousLinearEquiv

noncomputable def parameterEquiv :
    (TangentParameters D birth death × MAIS.IntervalCochainProduct.NormalParams birth death) ≃L[ℝ]
    (TangentParameters D birth death × MAIS.ActiveIntervalNormal.normalSpace D birth death hD) :=
  ((LinearEquiv.refl ℝ (TangentParameters D birth death)).prodCongr
    (normalParamEquiv D birth death hD).toLinearEquiv).toContinuousLinearEquiv

/-- The actual ambient chart with its explicit physical normal subspace. -/
noncomputable def baseChart (hvalid : ∀ s, birth s < death s) :
    OpenPartialHomeomorph
      (TangentParameters D birth death × MAIS.ActiveIntervalNormal.normalSpace D birth death hD)
      (Rep (Index D birth death)) :=
  sliceChart (Index D birth death) (MAIS.ActiveIntervalDifferential.intervalRep D birth death)
    (TangentParameters D birth death) (MAIS.ActiveIntervalNormal.normalSpace D birth death hD)
    (orbitDirections_isCompl _ _)
    (MAIS.ActiveIntervalNormal.orbitDifferential_normalSpace_isCompl D birth death hD hvalid)

/-- A full ambient chart in genuinely independent scalar entrance parameters. -/
noncomputable def parameterChart (hvalid : ∀ s, birth s < death s) :
    OpenPartialHomeomorph
      (TangentParameters D birth death × MAIS.IntervalCochainProduct.NormalParams birth death)
      (Rep (Index D birth death)) :=
  (parameterEquiv D birth death hD).toHomeomorph.transOpenPartialHomeomorph
    (baseChart D birth death hD hvalid)

@[simp]
theorem parameterChart_apply (hvalid : ∀ s, birth s < death s)
    (p : TangentParameters D birth death × MAIS.IntervalCochainProduct.NormalParams birth death)
    (e : Fin D) :
    parameterChart D birth death hD hvalid p e =
      NormedSpace.exp ((p.1 : Lie (Index D birth death)) e.succ) *
        (MAIS.ActiveIntervalDifferential.intervalRep D birth death e +
          MAIS.ActiveIntervalNormal.normalInjection D birth death hD p.2 e) *
        NormedSpace.exp (-((p.1 : Lie (Index D birth death)) e.castSucc)) := rfl

theorem zero_mem_parameterChart_source (hvalid : ∀ s, birth s < death s) :
    0 ∈ (parameterChart D birth death hD hvalid).source := by
  change parameterEquiv D birth death hD 0 ∈ (baseChart D birth death hD hvalid).source
  rw [map_zero]
  exact zero_mem_sliceChart_source _ _ _ _ _ _

theorem base_mem_parameterChart_target (hvalid : ∀ s, birth s < death s) :
    MAIS.ActiveIntervalDifferential.intervalRep D birth death ∈
      (parameterChart D birth death hD hvalid).target :=
  base_mem_sliceChart_target _ _ _ _ _ _

/-- Forward analyticity is asserted for the literal full matrix-entry map. -/
theorem analyticAt_parameterChart (hvalid : ∀ s, birth s < death s)
    (p : TangentParameters D birth death × MAIS.IntervalCochainProduct.NormalParams birth death) :
    AnalyticAt ℝ (parameterChart D birth death hD hvalid) p := by
  have hg := analyticAt_sliceMap (Index D birth death)
    (MAIS.ActiveIntervalDifferential.intervalRep D birth death) (TangentParameters D birth death)
    (MAIS.ActiveIntervalNormal.normalSpace D birth death hD) (parameterEquiv D birth death hD p)
  have hf := (parameterEquiv D birth death hD).toContinuousLinearMap.analyticAt p
  convert hg.comp hf using 1
  rfl

/-- The actual inverse is real analytic at the actual base matrix chain. -/
theorem analyticAt_parameterChart_symm (hvalid : ∀ s, birth s < death s) :
    AnalyticAt ℝ (parameterChart D birth death hD hvalid).symm
      (MAIS.ActiveIntervalDifferential.intervalRep D birth death) := by
  have hf := analyticAt_sliceChart_symm (Index D birth death)
    (MAIS.ActiveIntervalDifferential.intervalRep D birth death) (TangentParameters D birth death)
    (MAIS.ActiveIntervalNormal.normalSpace D birth death hD) (orbitDirections_isCompl _ _)
    (MAIS.ActiveIntervalNormal.orbitDifferential_normalSpace_isCompl D birth death hD hvalid)
  have hg := (parameterEquiv D birth death hD).symm.toContinuousLinearMap.analyticAt
    ((baseChart D birth death hD hvalid).symm
      (MAIS.ActiveIntervalDifferential.intervalRep D birth death))
  convert hg.comp hf using 1
  rfl

/-- Both actual neighborhoods and the actual analytic inverse are retained. -/
theorem exists_open_inverse_neighborhood (hvalid : ∀ s, birth s < death s) :
    ∃ U : Set (Rep (Index D birth death)), IsOpen U ∧
      MAIS.ActiveIntervalDifferential.intervalRep D birth death ∈ U ∧
      U ⊆ (parameterChart D birth death hD hvalid).target ∧
      ∀ A ∈ U, AnalyticAt ℝ (parameterChart D birth death hD hvalid).symm A := by
  have h := (analyticAt_parameterChart_symm D birth death hD hvalid).eventually_analyticAt
  have ht := (parameterChart D birth death hD hvalid).open_target.mem_nhds
    (base_mem_parameterChart_target D birth death hD hvalid)
  obtain ⟨U, hU, hUo, hAU⟩ := eventually_nhds_iff.mp (h.and ht)
  exact ⟨U, hUo, hAU, fun A hA => (hU A hA).2, fun A hA => (hU A hA).1⟩

/-- Setting the gauge coordinates to zero gives exactly the affine normal
    matrices with the actual independent scalar entrance entries. -/
theorem parameterChart_normal (hvalid : ∀ s, birth s < death s)
    (t : MAIS.IntervalCochainProduct.NormalParams birth death) :
    parameterChart D birth death hD hvalid (0, t) =
      MAIS.ActiveIntervalDifferential.intervalRep D birth death +
        MAIS.ActiveIntervalNormal.normalInjection D birth death hD t := by
  funext e
  simp [parameterChart_apply]

/-- The literal squared product norm and the literal normal-slice product norm
    are comparable on a fixed full neighborhood of the independent parameters. -/
theorem exists_local_squared_norm_comparison (hvalid : ∀ s, birth s < death s)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ p : TangentParameters D birth death ×
        MAIS.IntervalCochainProduct.NormalParams birth death in 𝓝 0,
      ‖pathMatrix (MAIS.ActiveIntervalDifferential.intervalRep D birth death +
          MAIS.ActiveIntervalNormal.normalInjection D birth death hD p.2) i j hij‖ ^ 2 / C ≤
        ‖pathMatrix (parameterChart D birth death hD hvalid p) i j hij‖ ^ 2 ∧
      ‖pathMatrix (parameterChart D birth death hD hvalid p) i j hij‖ ^ 2 ≤
        C * ‖pathMatrix (MAIS.ActiveIntervalDifferential.intervalRep D birth death +
          MAIS.ActiveIntervalNormal.normalInjection D birth death hD p.2) i j hij‖ ^ 2 := by
  obtain ⟨C, hC, h⟩ := MAIS.OrbitSliceLoss.exists_local_squared_norm_comparison
    (Index D birth death) (MAIS.ActiveIntervalDifferential.intervalRep D birth death)
    (TangentParameters D birth death) (MAIS.ActiveIntervalNormal.normalSpace D birth death hD)
    i j hij
  have hp : Filter.Tendsto (parameterEquiv D birth death hD) (𝓝 0) (𝓝 0) := by
    simpa only [map_zero] using (parameterEquiv D birth death hD).continuous.tendsto 0
  refine ⟨C, hC, ?_⟩
  filter_upwards [hp.eventually h] with p hp
  exact hp

end MAIS.ActiveIntervalSliceChart
end
