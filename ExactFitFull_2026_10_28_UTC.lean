/-- info: 'MAIS.ActiveIntervalPolarDensity.integer_weight_sum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalPolarDensity.integer_weight_sum

/-- info: 'MAIS.ActiveIntervalPolarDensity.density_degree_ratio' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalPolarDensity.density_degree_ratio
end
