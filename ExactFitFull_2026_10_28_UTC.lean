#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedHomogeneousBoxOrder.order_iff_scaled

/-- info: 'MAIS.WeightedHomogeneousBoxOrder.neighborhood_windows' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedHomogeneousBoxOrder.neighborhood_windows

/-- info: 'MAIS.WeightedHomogeneousBoxOrder.band_windows' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedHomogeneousBoxOrder.band_windows

/-- info: 'MAIS.WeightedHomogeneousBoxOrder.order_windows_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedHomogeneousBoxOrder.order_windows_iff

