-- ==================== begin module O7.BarcodeMultiplicity (formalization/O7/BarcodeMultiplicity.lean) ====================
section

set_option autoImplicit false
universe u w
namespace MAIS.LinearChain

open Module
open MAIS.IntervalPaddingOrder
variable {K : Type u} [Field K] {n : ℕ}
variable {V : Fin n → Type w} [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)]
variable {C : Chain K (Fin n) V} (B : Barcode C)

/-- Actual finite counting by the pair of endpoint labels. -/
lemma finite_pair_fiber_count {T A E : Type*} [Fintype T] [Fintype A] [Fintype E]
    [DecidableEq A] [DecidableEq E]
    (f : T → A) (g : T → E) (P : A → E → Prop) [∀ a e, Decidable (P a e)] :
    (∑ a, ∑ e, if P a e then Fintype.card {s : T // f s = a ∧ g s = e} else 0) =
      Fintype.card {s : T // P (f s) (g s)} := by
  classical
  simp only [Fintype.card_subtype, Finset.card_eq_sum_ones, Finset.sum_filter]
  calc
    _ = ∑ a, ∑ e, ∑ s : T, if P a e ∧ f s = a ∧ g s = e then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro a _
      apply Finset.sum_congr rfl
      intro e _
      by_cases h : P a e <;> simp [h]
    _ = ∑ a, ∑ s : T, ∑ e, if P a e ∧ f s = a ∧ g s = e then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro a _
      rw [Finset.sum_comm]
    _ = ∑ s : T, ∑ a, ∑ e, if P a e ∧ f s = a ∧ g s = e then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = _ := by
      apply Finset.sum_congr rfl
      intro s _
      simp only [show ∀ a e, (P a e ∧ f s = a ∧ g s = e) ↔
        (a = f s ∧ e = g s ∧ P (f s) (g s)) by intro a e; aesop]
      calc
        _ = ∑ a, if a = f s then (if P (f s) (g s) then 1 else 0) else 0 := by
          apply Finset.sum_congr rfl
          intro a _
          by_cases ha : a = f s <;> by_cases hp : P (f s) (g s) <;> simp [ha, hp]
        _ = _ := by simp

/-- Actual barcode multiplicities, with an exclusive right endpoint. -/
noncomputable def Barcode.multiplicity : Fin (n + 1) → Fin (n + 1) → ℕ := fun a k =>
  Fintype.card {s : B.Index // (B.birth s).castSucc = a ∧ (B.death s).succ = k}

lemma Barcode.multiplicity_upper (a k : Fin (n + 1)) (hka : k ≤ a) :
    B.multiplicity a k = 0 := by
  classical
  rw [Barcode.multiplicity, Fintype.card_eq_zero_iff]
  refine ⟨fun s => ?_⟩
  have hb := B.valid s.val
  have ha := congrArg Fin.val s.property.1
  have hk := congrArg Fin.val s.property.2
  simp only [Fin.val_castSucc, Fin.val_succ] at ha hk
  have hka' : k.val ≤ a.val := hka
  have hb' : (B.birth s.val).val ≤ (B.death s.val).val := hb
  omega

/-- The array crossing count is an actual finite count of barcode slots. -/
theorem Barcode.crossing_multiplicity (i j : ℕ) :
    crossing B.multiplicity i j =
      Fintype.card {s : B.Index // (B.birth s).val < i ∧ j ≤ (B.death s).val + 1} := by
  classical
  exact finite_pair_fiber_count (fun s => (B.birth s).castSucc)
    (fun s => (B.death s).succ) (fun a k => a.val < i ∧ j ≤ k.val)

/-- Interior crossing cuts are the actual ranks of the original persistence maps. -/
theorem Barcode.crossing_multiplicity_interior (i j : Fin n) (hij : i ≤ j) :
    crossing B.multiplicity (i.val + 1) (j.val + 1) =
      Module.finrank K (LinearMap.range (C.map i j hij)) := by
  rw [B.crossing_multiplicity, B.finrank_range i j hij]
  apply Fintype.card_congr
  exact Equiv.subtypeEquivRight (fun s => by
    simp only [Fin.le_def, Nat.lt_succ_iff, Nat.add_le_add_iff_right])

end MAIS.LinearChain

/-- info: 'MAIS.LinearChain.Barcode.crossing_multiplicity_interior' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.Barcode.crossing_multiplicity_interior
end
-- ==================== end module O7.BarcodeMultiplicity ====================

-- ==================== begin module O7.MatrixBlockProjection (formalization/O7/MatrixBlockProjection.lean) ====================
section

/-!
Project actual finite permutations to actual row/column block multiplicities.
An increasing swap projects either to no change or to a positive integer
matrix switch.  Entries and northwest counts are finite cardinalities.
-/
set_option autoImplicit false
open scoped BigOperators

namespace MAIS.MatrixBlockProjection

variable {N m n : ℕ}

/-- Actual number of permutation entries in one specified pair of blocks. -/
def cellCount (row : Fin N → Fin m) (col : Fin N → Fin n)
    (v : Equiv.Perm (Fin N)) (r : Fin m) (c : Fin n) : ℕ :=
  ((Finset.univ : Finset (Fin N)).filter (fun p => row p = r ∧ col (v p) = c)).card

lemma cellCount_eq_sum (row : Fin N → Fin m) (col : Fin N → Fin n)
    (v : Equiv.Perm (Fin N)) (r : Fin m) (c : Fin n) :
    cellCount row col v r c = ∑ p, if row p = r ∧ col (v p) = c then 1 else 0 := by
  simp only [cellCount, Finset.card_eq_sum_ones, Finset.sum_filter]

/-- The actual two selected old cells have positive multiplicity. -/
lemma selected_cell_positive (row : Fin N → Fin m) (col : Fin N → Fin n)
    (v : Equiv.Perm (Fin N)) (p : Fin N) :
    0 < cellCount row col v (row p) (col (v p)) := by
  apply Finset.card_pos.mpr
  exact ⟨p, by simp⟩

/-- Exact integer balance of actual block multiplicities under a position swap. -/
theorem swap_cell_balance (row : Fin N → Fin m) (col : Fin N → Fin n)
    (v : Equiv.Perm (Fin N)) (p q : Fin N) (hpq : p ≠ q) (r : Fin m) (c : Fin n) :
    cellCount row col (v * Equiv.swap p q) r c +
        (if row p = r ∧ col (v p) = c then 1 else 0) +
        (if row q = r ∧ col (v q) = c then 1 else 0) =
      cellCount row col v r c +
        (if row p = r ∧ col (v q) = c then 1 else 0) +
        (if row q = r ∧ col (v p) = c then 1 else 0) := by
  classical
  have hpoint (x : Fin N) :
      (if row x = r ∧ col ((v * Equiv.swap p q) x) = c then 1 else 0) +
          (if x = p then (if row p = r ∧ col (v p) = c then 1 else 0) else 0) +
          (if x = q then (if row q = r ∧ col (v q) = c then 1 else 0) else 0) =
        (if row x = r ∧ col (v x) = c then 1 else 0) +
          (if x = p then (if row p = r ∧ col (v q) = c then 1 else 0) else 0) +
          (if x = q then (if row q = r ∧ col (v p) = c then 1 else 0) else 0) := by
    by_cases hxp : x = p
    · subst x
      simp [Equiv.Perm.mul_apply, hpq, Nat.add_comm]
    · by_cases hxq : x = q
      · subst x
        simp [Equiv.Perm.mul_apply, Ne.symm hpq, Nat.add_comm]
      · simp [Equiv.Perm.mul_apply, Equiv.swap_apply_def, hxp, hxq]
  have hs := Finset.sum_congr rfl (fun x (_hx : x ∈ (Finset.univ : Finset (Fin N))) => hpoint x)
  simp only [Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ,
    ite_true] at hs
  simpa only [← cellCount_eq_sum] using hs

/-- A genuine positive matrix switch, expressed without truncated subtraction. -/
def MatrixSwitch (A B : Fin m → Fin n → ℕ) : Prop :=
  ∃ a b : Fin m, ∃ c d : Fin n,
    a < b ∧ c < d ∧ 0 < A a c ∧ 0 < A b d ∧
      ∀ r s, B r s + (if a = r ∧ c = s then 1 else 0) +
          (if b = r ∧ d = s then 1 else 0) =
        A r s + (if a = r ∧ d = s then 1 else 0) +
          (if b = r ∧ c = s then 1 else 0)

/-- Every increasing permutation swap is either an idle block step or an actual positive
    matrix switch.  Monotone block labels enforce the correct order of its four cells. -/
theorem increasing_swap_projects (row : Fin N → Fin m) (col : Fin N → Fin n)
    (hrow : Monotone row) (hcol : Monotone col)
    (v : Equiv.Perm (Fin N)) (p q : Fin N) (hpq : p < q) (hv : v p < v q) :
    cellCount row col (v * Equiv.swap p q) = cellCount row col v ∨
      MatrixSwitch (cellCount row col v) (cellCount row col (v * Equiv.swap p q)) := by
  by_cases hr : row p = row q
  · left
    funext r c
    have h := swap_cell_balance row col v p q (ne_of_lt hpq) r c
    rw [hr] at h
    omega
  · by_cases hc : col (v p) = col (v q)
    · left
      funext r c
      have h := swap_cell_balance row col v p q (ne_of_lt hpq) r c
      rw [hc] at h
      omega
    · right
      refine ⟨row p, row q, col (v p), col (v q), ?_, ?_,
        selected_cell_positive row col v p, selected_cell_positive row col v q, ?_⟩
      · exact lt_of_le_of_ne (hrow (le_of_lt hpq)) hr
      · exact lt_of_le_of_ne (hcol (le_of_lt hv)) hc
      · intro r c
        exact swap_cell_balance row col v p q (ne_of_lt hpq) r c

/-- Summing actual cell multiplicities over a northwest block rectangle counts actual
    permutation entries in the corresponding pair of block prefixes. -/
theorem northwest_cellCount (row : Fin N → Fin m) (col : Fin N → Fin n)
    (v : Equiv.Perm (Fin N)) (i j : ℕ) :
    MAIS.CanonicalPermutation.northWest (cellCount row col v) i j =
      ((Finset.univ : Finset (Fin N)).filter
        (fun p => (row p).val < i ∧ (col (v p)).val < j)).card := by
  classical
  unfold MAIS.CanonicalPermutation.northWest
  simp only [cellCount_eq_sum]
  calc
    _ = ∑ r : Fin m, ∑ c : Fin n, ∑ p : Fin N,
        if row p = r ∧ col (v p) = c ∧ r.val < i ∧ c.val < j then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro r _hr
      apply Finset.sum_congr rfl
      intro c _hc
      by_cases h : r.val < i ∧ c.val < j <;> simp [h]
    _ = ∑ p : Fin N, ∑ r : Fin m, ∑ c : Fin n,
        if row p = r ∧ col (v p) = c ∧ r.val < i ∧ c.val < j then 1 else 0 := by
      conv_lhs =>
        arg 2
        ext r
        rw [Finset.sum_comm]
      rw [Finset.sum_comm]
    _ = ∑ p : Fin N, if (row p).val < i ∧ (col (v p)).val < j then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro p _hp
      rw [Finset.sum_eq_single (row p)]
      · rw [Finset.sum_eq_single (col (v p))]
        · simp
        · intro c _hc hne
          simp [Ne.symm hne]
        · simp
      · intro r _hr hne
        simp [Ne.symm hne]
      · simp
    _ = _ := by simp only [Finset.card_eq_sum_ones, Finset.sum_filter]


/-- Actual number of labels in an initial block prefix. -/
def cutCard {d : ℕ} (label : Fin N → Fin d) (i : ℕ) : ℕ :=
  ((Finset.univ : Finset (Fin N)).filter (fun p => (label p).val < i)).card

lemma cutCard_le {d : ℕ} (label : Fin N → Fin d) (i : ℕ) : cutCard label i ≤ N := by
  exact (Finset.card_filter_le _ _).trans_eq (by simp)

lemma cutCard_permutation {d : ℕ} (label : Fin N → Fin d)
    (v : Equiv.Perm (Fin N)) (i : ℕ) :
    ((Finset.univ : Finset (Fin N)).filter (fun p => (label (v p)).val < i)).card =
      cutCard label i := by
  simp only [cutCard, Finset.card_eq_sum_ones, Finset.sum_filter]
  exact Equiv.sum_comp v (fun p => if (label p).val < i then (1 : ℕ) else 0)

/-- Projected northwest counts are actual permutation prefix counts at the two block cuts. -/
theorem northwest_eq_Q (row : Fin N → Fin m) (col : Fin N → Fin n)
    (hrow : Monotone row) (hcol : Monotone col)
    (v : Equiv.Perm (Fin N)) (i j : ℕ) :
    MAIS.CanonicalPermutation.northWest (cellCount row col v) i j =
      MAIS.PermutationInterpolation.Q v (cutCard row i) (cutCard col j) := by
  rw [northwest_cellCount, MAIS.CanonicalPermutation.Q_to_fin_count _ _ _ (cutCard_le row i)]
  congr 1
  ext p
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  have hr := MAIS.CanonicalPermutation.monotone_cut_nat
    (fun p : Fin N => (row p).val) (fun _ _ h => hrow h) i p
  have hc := MAIS.CanonicalPermutation.monotone_cut_nat
    (fun p : Fin N => (col p).val) (fun _ _ h => hcol h) j (v p)
  exact Iff.and hr hc

lemma columnBoundary_cellCount (row : Fin N → Fin m) (col : Fin N → Fin n)
    (v : Equiv.Perm (Fin N)) (j : ℕ) :
    MAIS.CanonicalPermutation.columnBoundary (cellCount row col v) j = cutCard col j := by
  have hall : MAIS.CanonicalPermutation.northWest (cellCount row col v) m j =
      MAIS.CanonicalPermutation.columnBoundary (cellCount row col v) j := by
    unfold MAIS.CanonicalPermutation.northWest MAIS.CanonicalPermutation.columnBoundary
    apply Finset.sum_congr rfl
    intro r _hr
    apply Finset.sum_congr rfl
    intro c _hc
    simp only [r.isLt, true_and]
  rw [← hall, northwest_cellCount]
  have heq : ((Finset.univ : Finset (Fin N)).filter
      (fun p => (row p).val < m ∧ (col (v p)).val < j)) =
      Finset.univ.filter (fun p => (col (v p)).val < j) := by
    ext p
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, (row p).isLt]
  rw [heq]
  exact cutCard_permutation col v j

lemma Q_mono_of_RankLE (v w : Equiv.Perm (Fin N))
    (h : MAIS.PermutationRankOrder.RankLE w v) :
    ∀ k l, MAIS.PermutationInterpolation.Q w k l ≤ MAIS.PermutationInterpolation.Q v k l := by
  intro k l
  cases l with
  | zero => simp only [MAIS.PermutationInterpolation.Q, MAIS.PrefixInterpolation.count,
      Nat.not_lt_zero, Finset.filter_false, Finset.card_empty, le_refl]
  | succ l =>
    simpa only [MAIS.PermutationInterpolation.prefixCount_eq_Q_succ] using h k l

/-- The entire actual matrix northwest order is inherited from permutation prefix order. -/
theorem northwest_mono_of_RankLE (row : Fin N → Fin m) (col : Fin N → Fin n)
    (hrow : Monotone row) (hcol : Monotone col)
    (v w : Equiv.Perm (Fin N)) (h : MAIS.PermutationRankOrder.RankLE w v) :
    ∀ i j, MAIS.CanonicalPermutation.northWest (cellCount row col w) i j ≤
      MAIS.CanonicalPermutation.northWest (cellCount row col v) i j := by
  intro i j
  rw [northwest_eq_Q row col hrow hcol w, northwest_eq_Q row col hrow hcol v]
  exact Q_mono_of_RankLE v w h _ _

/-- Diagonal saturation of actual northwest counts forces the projected matrix triangular. -/
theorem upper_of_diagonal (row col : Fin N → Fin m) (v : Equiv.Perm (Fin N))
    (hdiag : ∀ k, MAIS.CanonicalPermutation.northWest (cellCount row col v) k k =
      MAIS.CanonicalPermutation.columnBoundary (cellCount row col v) k) :
    ∀ r c, c < r → cellCount row col v r c = 0 := by
  classical
  intro r c hcr
  by_contra hzero
  have hpos : 0 < cellCount row col v r c := Nat.pos_of_ne_zero hzero
  obtain ⟨p, hp⟩ := Finset.card_pos.mp hpos
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hp
  let k := c.val + 1
  let S := (Finset.univ : Finset (Fin N)).filter (fun q => (col (v q)).val < k)
  let T := (Finset.univ : Finset (Fin N)).filter
    (fun q => (row q).val < k ∧ (col (v q)).val < k)
  have hsub : T ⊆ S := by
    intro q hq
    simp only [T, S, Finset.mem_filter, Finset.mem_univ, true_and] at hq ⊢
    exact hq.2
  have hpS : p ∈ S := by
    simp only [S, Finset.mem_filter, Finset.mem_univ, true_and, hp.2, k]
    omega
  have hpT : p ∉ T := by
    simp only [T, Finset.mem_filter, Finset.mem_univ, true_and, hp.1, hp.2, k]
    exact fun h => (not_lt_of_ge (show c.val + 1 ≤ r.val by exact hcr)) h.1
  have hstrict : T ⊂ S := by
    apply Finset.ssubset_iff_subset_ne.mpr
    refine ⟨hsub, ?_⟩
    intro heq
    exact hpT (heq.symm ▸ hpS)
  have hcard := Finset.card_lt_card hstrict
  have hD := hdiag k
  rw [northwest_cellCount, columnBoundary_cellCount] at hD
  have hS : S.card = cutCard col k := cutCard_permutation col v k
  change T.card = cutCard col k at hD
  omega

/-- A linked switch includes the adjacency case b=c, which creates an empty short interval. -/
def LinkedSwitch (A B : Fin m → Fin m → ℕ) : Prop :=
  ∃ a b c d : Fin m,
    a < b ∧ b ≤ c ∧ c < d ∧ 0 < A a c ∧ 0 < A b d ∧
      ∀ r s, B r s + (if a = r ∧ c = s then 1 else 0) +
          (if b = r ∧ d = s then 1 else 0) =
        A r s + (if a = r ∧ d = s then 1 else 0) +
          (if b = r ∧ c = s then 1 else 0)

/-- Triangularity of the next actual matrix forces the two intervals to be linked. -/
theorem linked_of_switch_upper (A B : Fin m → Fin m → ℕ)
    (hswitch : MatrixSwitch A B) (hupper : ∀ r c, c < r → B r c = 0) :
    LinkedSwitch A B := by
  obtain ⟨a, b, c, d, hab, hcd, hac, hbd, hbalance⟩ := hswitch
  have hbc : b ≤ c := by
    by_contra hn
    have hz := hupper b c (lt_of_not_ge hn)
    have h := hbalance b c
    simp only [ne_of_lt hab, ne_of_gt hcd, false_and, ite_false, true_and, ite_true] at h
    omega
  exact ⟨a, b, c, d, hab, hbc, hcd, hac, hbd, hbalance⟩

end MAIS.MatrixBlockProjection





