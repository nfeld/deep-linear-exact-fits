-- ==================== begin module O7.MatrixRestriction (formalization/O7/MatrixRestriction.lean) ====================
section

set_option autoImplicit false
namespace MAIS.MatrixRestriction

open scoped Matrix

variable {R α β γ ρ σ : Type*} [Field R]
variable [Fintype α] [Fintype β] [Fintype γ] [Fintype ρ] [Fintype σ]

/-- Deleting identically zero rows preserves actual matrix rank. -/
theorem rank_rows_eq (A : Matrix α β R) (P : α → Prop) [DecidablePred P]
    (hz : ∀ i, ¬ P i → ∀ j, A i j = 0) :
    (A.submatrix (fun i : {i // P i} => i.val) id).rank = A.rank := by
  classical
  let J : Matrix α {i // P i} R := fun i a => if a.val = i then 1 else 0
  have hJ : J * A.submatrix Subtype.val id = A := by
    ext i j
    change (∑ a : {a // P a}, (if a.val = i then 1 else 0) * A a.val j) = A i j
    by_cases hi : P i
    · rw [Fintype.sum_eq_single (⟨i, hi⟩ : {i // P i})
        (fun a ha => by rw [ite_eq_right (fun he => ha (Subtype.ext he)), zero_mul]),
        ite_eq_left rfl, one_mul]
    · rw [hz i hi j]
      apply Finset.sum_eq_zero
      intro a _
      have hne : a.val ≠ i := fun he => hi (he ▸ a.property)
      rw [ite_eq_right hne, zero_mul]
  apply le_antisymm (Matrix.rank_submatrix_le A _ _)
  calc
    A.rank = (J * A.submatrix Subtype.val id).rank := congrArg Matrix.rank hJ.symm
    _ ≤ (A.submatrix Subtype.val id).rank := Matrix.rank_mul_le_right _ _

/-- Deleting identically zero columns preserves actual matrix rank. -/
theorem rank_cols_eq (A : Matrix α β R) (P : β → Prop) [DecidablePred P]
    (hz : ∀ j, ¬ P j → ∀ i, A i j = 0) :
    (A.submatrix id (fun j : {j // P j} => j.val)).rank = A.rank := by
  classical
  have h := rank_rows_eq A.transpose P hz
  simpa only [← Matrix.transpose_submatrix, Matrix.rank_transpose] using h

/-- Restriction to actual active rows and columns preserves rank for a supported matrix. -/
theorem rank_restrict_eq (A : Matrix α β R) (P : α → Prop) (Q : β → Prop)
    [DecidablePred P] [DecidablePred Q]
    (hrow : ∀ i, ¬ P i → ∀ j, A i j = 0)
    (hcol : ∀ j, ¬ Q j → ∀ i, A i j = 0) :
    (A.submatrix (fun i : {i // P i} => i.val) (fun j : {j // Q j} => j.val)).rank = A.rank := by
  have hcol' : ∀ j, ¬ Q j → ∀ i : {i // P i},
      (A.submatrix Subtype.val id) i j = 0 := fun j hj i => hcol j hj i.val
  have hc := rank_cols_eq (A.submatrix (fun i : {i // P i} => i.val) id) Q hcol'
  rw [Matrix.submatrix_submatrix] at hc
  exact hc.trans (rank_rows_eq A P hrow)

omit [Fintype β] [Fintype γ] [Fintype ρ] [Fintype σ] in
/-- An actual product may be restricted through a middle active space when the left
    factor vanishes on all inactive middle columns. -/
theorem restrict_mul (A : Matrix γ α R) (B : Matrix α β R)
    (P : α → Prop) [DecidablePred P] (r : ρ → γ) (c : σ → β)
    (hcol : ∀ k, ¬ P k → ∀ i, A i k = 0) :
    A.submatrix r (fun k : {k // P k} => k.val) *
      B.submatrix (fun k : {k // P k} => k.val) c = (A * B).submatrix r c := by
  ext i j
  simp only [Matrix.mul_apply, Matrix.submatrix_apply]
  have h := Fintype.sum_subtype_add_sum_subtype P (fun k => A (r i) k * B k (c j))
  have hz : (∑ k : {k // ¬ P k}, A (r i) k.val * B k.val (c j)) = 0 := by
    apply Finset.sum_eq_zero
    intro k _
    rw [hcol k.val k.property (r i), zero_mul]
  rw [hz, add_zero] at h
  exact h

end MAIS.MatrixRestriction

/-- info: 'MAIS.MatrixRestriction.rank_restrict_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.MatrixRestriction.rank_restrict_eq
/-- info: 'MAIS.MatrixRestriction.restrict_mul' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.MatrixRestriction.restrict_mul
end
-- ==================== end module O7.MatrixRestriction ====================

-- ==================== begin module O7.TypeAIntervalMove (formalization/O7/TypeAIntervalMove.lean) ====================
section

/-!
# The elementary rank rectangle in a type-A interval move

This file checks the finite rank identity and dimension preservation for
I[a,c] + I[b,d] → I[a,d] + I[b,c], including the empty short interval.
It does not formalize generation of rank order or the real closure theorem.
-/

set_option autoImplicit false

namespace MAIS.TypeAIntervalMove

def intervalRank (a b i j : ℕ) : ℕ :=
  if a ≤ i ∧ j ≤ b then 1 else 0

/-- The linked-interval move adds exactly one rank on the stated rectangle. -/
theorem rank_rectangle (a b c d i j : ℕ)
    (hab : a < b) (_hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) (_hij : i ≤ j) :
    intervalRank a d i j + intervalRank b c i j =
      intervalRank a c i j + intervalRank b d i j +
        (if a ≤ i ∧ i < b ∧ c < j ∧ j ≤ d then 1 else 0) := by
  unfold intervalRank
  split_ifs <;> omega

/-- In particular every vertex dimension is preserved. -/
theorem vertex_dimension (a b c d i : ℕ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) :
    intervalRank a d i i + intervalRank b c i i =
      intervalRank a c i i + intervalRank b d i i := by
  have h := rank_rectangle a b c d i i hab hbc hcd (le_refl i)
  have hn : ¬ (a ≤ i ∧ i < b ∧ c < i ∧ i ≤ d) := by omega
  simpa [hn] using h

/-- The short interval has zero rank when the two old intervals are adjacent. -/
theorem empty_short_interval (b i j : ℕ) (hij : i ≤ j) :
    intervalRank (b + 1) b i j = 0 := by
  unfold intervalRank
  split_ifs <;> omega

end MAIS.TypeAIntervalMove

/--
info: 'MAIS.TypeAIntervalMove.rank_rectangle' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.TypeAIntervalMove.rank_rectangle
/--
info: 'MAIS.TypeAIntervalMove.vertex_dimension' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.TypeAIntervalMove.vertex_dimension
/--
info: 'MAIS.TypeAIntervalMove.empty_short_interval' depends on axioms:
  [propext, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.TypeAIntervalMove.empty_short_interval
end
-- ==================== end module O7.TypeAIntervalMove ====================

-- ==================== begin module O7.TypeARealFamily (formalization/O7/TypeARealFamily.lean) ====================
section

/-!
An actual real matrix family for a linked type-A interval move.
The arrow matrices depend linearly on t, specialize at zero to the split
interval arrows, and admit explicit invertible real changes of basis for
t ≠ 0.  All claims concern actual 2×2 matrices, determinants and products.
-/
set_option autoImplicit false
set_option maxRecDepth 2000
set_option maxHeartbeats 2000000

namespace MAIS.TypeARealFamily

open scoped Matrix
open MAIS.TypeAIntervalMove

abbrev Mat := Matrix (Fin 2) (Fin 2) ℝ

def diag (x y : ℝ) : Mat := Matrix.diagonal ![x,y]

/-- Arrows for two interval summands, embedded in a fixed two-dimensional space. -/
def intervalArrows (a c b d i : ℕ) : Mat :=
  diag (if a ≤ i ∧ i < c then 1 else 0) (if b ≤ i ∧ i < d then 1 else 0)

/-- Projector onto the actual graded interval space at one vertex. -/
def intervalProjector (a c b d i : ℕ) : Mat :=
  diag (if a ≤ i ∧ i ≤ c then 1 else 0) (if b ≤ i ∧ i ≤ d then 1 else 0)

/-- The sole perturbed arrow is the physical arrow b−1 → b. -/
def family (a b c d : ℕ) (t : ℝ) (i : ℕ) : Mat :=
  intervalArrows a c b d i + if i + 1 = b then !![0,0;t,0] else 0

/-- Columns are the long and short interval bases described in the real proof. -/
def basis (b c : ℕ) (t : ℝ) (i : ℕ) : Mat :=
  if i < b then 1 else if i ≤ c then !![1,1;t,0] else !![0,1;t,0]

theorem family_zero (a b c d i : ℕ) : family a b c d 0 i = intervalArrows a c b d i := by
  ext p q
  fin_cases p <;> fin_cases q <;> by_cases h : i + 1 = b <;> simp [family, h]

theorem basis_det_ne_zero (b c i : ℕ) (t : ℝ) (ht : t ≠ 0) :
    (basis b c t i).det ≠ 0 := by
  unfold basis
  split_ifs <;> simp [Matrix.det_fin_two, ht]

/-- Exact arrow intertwining for the real one-parameter linked-interval family. -/
theorem family_intertwines (a b c d i : ℕ) (t : ℝ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) :
    family a b c d t i * basis b c t i =
      basis b c t (i + 1) * intervalArrows a d b c i := by
  ext p q
  fin_cases p <;> fin_cases q <;>
    simp [family, basis, intervalArrows, diag, Matrix.mul_apply,
      Matrix.diagonal_apply] <;>
    split_ifs <;> simp_all <;> omega

/-- The same bases identify the actual graded subspaces, including the empty short interval. -/
theorem projector_intertwines (a b c d i : ℕ) (t : ℝ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) :
    intervalProjector a c b d i * basis b c t i =
      basis b c t i * intervalProjector a d b c i := by
  ext p q
  fin_cases p <;> fin_cases q <;>
    simp [basis, intervalProjector, diag, Matrix.mul_apply,
      Matrix.diagonal_apply] <;>
    split_ifs <;> simp_all <;> omega

/-- Multiplication in chronological arrow order; the last arrow multiplies on the left. -/
def pathProduct (A : ℕ → Mat) (i : ℕ) : ℕ → Mat
  | 0 => 1
  | len + 1 => A (i + len) * pathProduct A i len

/-- Every consecutive matrix product has the explicit real basis intertwiner. -/
theorem path_intertwines (a b c d i len : ℕ) (t : ℝ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) :
    pathProduct (family a b c d t) i len * basis b c t i =
      basis b c t (i + len) * pathProduct (intervalArrows a d b c) i len := by
  induction len with
  | zero => simp [pathProduct]
  | succ len ih =>
    simp only [pathProduct]
    calc
      _ = family a b c d t (i + len) *
          (pathProduct (family a b c d t) i len * basis b c t i) := by
            rw [Matrix.mul_assoc]
      _ = family a b c d t (i + len) *
          (basis b c t (i + len) * pathProduct (intervalArrows a d b c) i len) := by rw [ih]
      _ = (family a b c d t (i + len) * basis b c t (i + len)) *
          pathProduct (intervalArrows a d b c) i len := by rw [Matrix.mul_assoc]
      _ = (basis b c t (i + len + 1) * intervalArrows a d b c (i + len)) *
          pathProduct (intervalArrows a d b c) i len := by
            rw [family_intertwines a b c d (i + len) t hab hbc hcd]
      _ = _ := by simp only [Nat.add_assoc, Matrix.mul_assoc]

/-- Thus every actual consecutive matrix rank is the rank of the joined interval product. -/
theorem path_rank_nonzero (a b c d i len : ℕ) (t : ℝ) (ht : t ≠ 0)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) :
    (pathProduct (family a b c d t) i len).rank =
      (pathProduct (intervalArrows a d b c) i len).rank := by
  have h := congrArg Matrix.rank (path_intertwines a b c d i len t hab hbc hcd)
  rw [Matrix.rank_mul_eq_left_of_det_ne_zero _ _ (basis_det_ne_zero b c i t ht),
    Matrix.rank_mul_eq_right_of_det_ne_zero _ _ (basis_det_ne_zero b c (i + len) t ht)] at h
  exact h


lemma diag_mul (x y u v : ℝ) : diag x y * diag u v = diag (x*u) (y*v) := by
  ext p q
  fin_cases p <;> fin_cases q <;>
    simp [diag, Matrix.mul_apply, Matrix.diagonal_apply]

lemma diag_rank_indicators (P Q : Prop) [Decidable P] [Decidable Q] :
    (diag (if P then 1 else 0) (if Q then 1 else 0)).rank =
      (if P then 1 else 0) + (if Q then 1 else 0) := by
  rw [diag, Matrix.rank_diagonal, Fintype.card_subtype]
  simp only [Finset.card_eq_sum_ones, Finset.sum_filter]
  by_cases hP : P <;> by_cases hQ : Q <;> simp [hP, hQ]

/-- Every nonempty consecutive product of interval arrows is the actual diagonal projector
    onto the intervals which survive that whole path. -/
theorem interval_path_formula (a c b d i len : ℕ) :
    pathProduct (intervalArrows a c b d) i (len + 1) =
      diag (if a ≤ i ∧ i + len < c then 1 else 0)
           (if b ≤ i ∧ i + len < d then 1 else 0) := by
  induction len with
  | zero => simp [pathProduct, intervalArrows]
  | succ len ih =>
    change intervalArrows a c b d (i + (len + 1)) *
      pathProduct (intervalArrows a c b d) i (len + 1) = _
    rw [ih]
    unfold intervalArrows
    rw [diag_mul]
    congr 1 <;> split_ifs <;> norm_num at * <;> omega

/-- Actual matrix ranks recover the sum of interval ranks on every strict path. -/
theorem interval_path_rank (a c b d i len : ℕ) :
    (pathProduct (intervalArrows a c b d) i (len + 1)).rank =
      intervalRank a c i (i + (len + 1)) + intervalRank b d i (i + (len + 1)) := by
  rw [interval_path_formula, diag_rank_indicators]
  simp only [intervalRank, Nat.lt_iff_add_one_le, Nat.add_assoc]

/-- At zero the actual family has precisely the split-interval rank array. -/
theorem path_rank_zero (a b c d i len : ℕ) :
    (pathProduct (family a b c d 0) i (len + 1)).rank =
      intervalRank a c i (i + (len + 1)) + intervalRank b d i (i + (len + 1)) := by
  have hf : family a b c d 0 = intervalArrows a c b d := funext (family_zero a b c d)
  rw [hf, interval_path_rank]

/-- For every nonzero real parameter, all actual path ranks equal the joined interval ranks. -/
theorem path_rank_nonzero_explicit (a b c d i len : ℕ) (t : ℝ) (ht : t ≠ 0)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) :
    (pathProduct (family a b c d t) i (len + 1)).rank =
      intervalRank a d i (i + (len + 1)) + intervalRank b c i (i + (len + 1)) := by
  rw [path_rank_nonzero a b c d i (len + 1) t ht hab hbc hcd, interval_path_rank]

/-- The elementary combinatorial rectangle is realized by actual real matrix-product ranks. -/
theorem actual_rank_rectangle (a b c d i len : ℕ) (t : ℝ) (ht : t ≠ 0)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) :
    (pathProduct (family a b c d t) i (len + 1)).rank =
      (pathProduct (family a b c d 0) i (len + 1)).rank +
        (if a ≤ i ∧ i < b ∧ c < i + (len + 1) ∧ i + (len + 1) ≤ d then 1 else 0) := by
  rw [path_rank_nonzero_explicit a b c d i len t ht hab hbc hcd, path_rank_zero]
  exact rank_rectangle a b c d i (i + (len + 1)) hab hbc hcd (by omega)

/-- The real family is continuous in the ordinary Euclidean matrix topology. -/
theorem continuous_family (a b c d i : ℕ) : Continuous (fun t : ℝ => family a b c d t i) := by
  unfold family
  split_ifs <;> fun_prop

/-- Hence each actual consecutive product converges to its split value as t tends to zero. -/
theorem continuous_path (a b c d i len : ℕ) :
    Continuous (fun t : ℝ => pathProduct (family a b c d t) i len) := by
  induction len with
  | zero => simp only [pathProduct]; fun_prop
  | succ len ih =>
    simpa only [pathProduct] using (continuous_family a b c d (i + len)).matrix_mul ih

end MAIS.TypeARealFamily





/--
info: 'MAIS.TypeARealFamily.family_intertwines' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.TypeARealFamily.family_intertwines

/--
info: 'MAIS.TypeARealFamily.path_rank_nonzero' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.TypeARealFamily.path_rank_nonzero

/--
info: 'MAIS.TypeARealFamily.projector_intertwines' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.TypeARealFamily.projector_intertwines

/--
info: 'MAIS.TypeARealFamily.actual_rank_rectangle' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.TypeARealFamily.actual_rank_rectangle

