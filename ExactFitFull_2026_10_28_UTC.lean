-- ==================== begin module O7.Run2GeometricCylinderPatch (formalization/O7/Run2GeometricCylinderPatch.lean) ====================
section

/-! Genuine free-parameter patches for a Euclidean spectator times a zero
regular coordinate times a residual orbit. No fractal product formula is used. -/
set_option autoImplicit false
set_option maxHeartbeats 2200000
noncomputable section
open Set MeasureTheory Filter
open scoped Topology ENNReal NNReal

namespace MAIS.Run2GeometricCylinderPatch
open MAIS.Run2GeometricCharts

variable {K Q P N E : Type*}
  [NormedAddCommGroup K] [NormedSpace ℝ K] [FiniteDimensional ℝ K]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [FiniteDimensional ℝ P]
  [NormedAddCommGroup N] [NormedSpace ℝ N]
  [NormedAddCommGroup E] [NormedSpace ℝ E]

def cylinder (s : Set E) : Set (K × (Q × E)) :=
  {x | x.2.1 = 0 ∧ x.2.2 ∈ s}

/-- An actual residual chart yields an actual cylinder patch whose full
free parameter space is K×P. All normal and regular-zero equations are literal. -/
theorem dimH_cylinder_inter_of_chart
    (e : OpenPartialHomeomorph (P × N) E)
    (he : DifferentiableOn ℝ e e.source)
    (s U : Set E) (hUt : U ⊆ e.target)
    (hi : DifferentiableOn ℝ e.symm U)
    (p₀ : P) (hp : (p₀, (0 : N)) ∈ e.source)
    (hcut : ∀ p ∈ e.source, e p ∈ s ↔ p.2 = 0)
    (k₀ : K) (W : Set (K × (Q × E))) (hW : IsOpen W)
    (hW₀ : (k₀, ((0 : Q), e (p₀, (0 : N)))) ∈ W)
    (hWU : ∀ x ∈ W, x.2.2 ∈ U) :
    dimH ((cylinder s : Set (K × (Q × E))) ∩ W) =
      (Module.finrank ℝ K + Module.finrank ℝ P : ℕ) := by
  let ρ : K × P → P × N := fun x => (x.2, 0)
  let f : K × P → K × (Q × E) := fun x => (x.1, (0, e (ρ x)))
  let g : K × (Q × E) → K × P := fun x => (x.1, (e.symm x.2.2).1)
  let u : Set (K × P) := {x | ρ x ∈ e.source ∧ f x ∈ W}
  have hρ : Differentiable ℝ ρ :=
    differentiable_snd.prodMk (differentiable_const (0 : N))
  have hres : DifferentiableOn ℝ (fun x => e (ρ x)) u :=
    he.comp hρ.differentiableOn (fun _ hx => hx.1)
  have hf : DifferentiableOn ℝ f u :=
    differentiable_fst.differentiableOn.prodMk
      ((differentiable_const (0 : Q)).differentiableOn.prodMk hres)
  have hproj : Differentiable ℝ (fun x : K × (Q × E) => x.2.2) :=
    differentiable_snd.comp differentiable_snd
  have hinv : DifferentiableOn ℝ (fun x : K × (Q × E) => e.symm x.2.2) W :=
    hi.comp hproj.differentiableOn hWU
  have hg : DifferentiableOn ℝ g W :=
    differentiable_fst.differentiableOn.prodMk
      (differentiable_fst.differentiableOn.comp hinv (fun _ _ => mem_univ _))
  have hfu : f '' u ⊆ W := by
    rintro _ ⟨x, hx, rfl⟩
    exact hx.2
  have hleft : ∀ x ∈ u, g (f x) = x := by
    intro x hx
    change (x.1, (e.symm (e (ρ x))).1) = x
    rw [e.left_inv hx.1]
  have heAt : ContinuousAt e (p₀, (0 : N)) :=
    e.continuousOn.continuousAt (e.open_source.mem_nhds hp)
  have hresAt : ContinuousAt (fun x : K × P => e (ρ x)) (k₀, p₀) :=
    (show ContinuousAt e (ρ (k₀, p₀)) from heAt).comp hρ.continuous.continuousAt
  have hfAt : ContinuousAt f (k₀, p₀) :=
    continuousAt_fst.prodMk (continuousAt_const.prodMk hresAt)
  have hu : u ∈ 𝓝 (k₀, p₀) :=
    inter_mem (hρ.continuous.continuousAt.preimage_mem_nhds (e.open_source.mem_nhds hp))
      (hfAt.preimage_mem_nhds (hW.mem_nhds hW₀))
  have hset : f '' u = (cylinder s : Set (K × (Q × E))) ∩ W := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact ⟨⟨rfl, (hcut (ρ x) hx.1).mpr rfl⟩, hx.2⟩
    · intro hy
      let p := e.symm y.2.2
      have hps : p ∈ e.source := e.map_target (hUt (hWU y hy.2))
      have hep : e p = y.2.2 := e.right_inv (hUt (hWU y hy.2))
      have hp0 : p.2 = 0 := (hcut p hps).mp (hep.symm ▸ hy.1.2)
      have hρp : ρ (y.1, p.1) = p := by
        change (p.1, (0 : N)) = p
        ext
        · rfl
        · exact hp0.symm
      have hfy : f (y.1, p.1) = y := by
        change (y.1, ((0 : Q), e (ρ (y.1, p.1)))) = y
        apply Prod.ext
        · rfl
        apply Prod.ext
        · exact hy.1.1.symm
        · change e (ρ (y.1, p.1)) = y.2.2
          rw [hρp, hep]
      refine ⟨(y.1, p.1), ?_, hfy⟩
      exact ⟨hρp.symm ▸ hps, hfy.symm ▸ hy.2⟩
  calc
    dimH ((cylinder s : Set (K × (Q × E))) ∩ W) = dimH (f '' u) := by rw [hset]
    _ = dimH u := dimH_image_eq_of_left_inverse hf (hg.mono hfu) hleft
    _ = Module.finrank ℝ (K × P) := Real.dimH_of_mem_nhds hu
    _ = (Module.finrank ℝ K + Module.finrank ℝ P : ℕ) := by rw [Module.finrank_prod]

end MAIS.Run2GeometricCylinderPatch

/-- info: 'MAIS.Run2GeometricCylinderPatch.dimH_cylinder_inter_of_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderPatch.dimH_cylinder_inter_of_chart
end
end
-- ==================== end module O7.Run2GeometricCylinderPatch ====================

-- ==================== begin module O7.Run2GeometricCylinderHomogeneous (formalization/O7/Run2GeometricCylinderHomogeneous.lean) ====================
section

/-! Explicit cylinder patches and real linear homogeneity give pure local
dimensions without assuming any general product rule for fractal sets. -/
set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal

namespace MAIS.Run2GeometricCylinderHomogeneous
open MAIS.Run2GeometricCharts MAIS.Run2GeometricLocal MAIS.Run2GeometricCylinderPatch

variable {K Q P N E F : Type*}
  [NormedAddCommGroup K] [NormedSpace ℝ K] [FiniteDimensional ℝ K]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [FiniteDimensional ℝ P]
  [NormedAddCommGroup N] [NormedSpace ℝ N]
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

def liftEquiv (e : E ≃L[ℝ] F) : (K × (Q × E)) ≃L[ℝ] (K × (Q × F)) :=
  (ContinuousLinearEquiv.refl ℝ K).prodCongr
    ((ContinuousLinearEquiv.refl ℝ Q).prodCongr e)

omit [FiniteDimensional ℝ K] in
theorem liftEquiv_image_cylinder (e : E ≃L[ℝ] F) (s : Set E) :
    liftEquiv (K := K) (Q := Q) e '' cylinder s = cylinder (e '' s) := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨hx.1, ⟨x.2.2, hx.2, rfl⟩⟩
  · intro hy
    obtain ⟨z, hz, hez⟩ := hy.2
    refine ⟨(y.1, (y.2.1, z)), ⟨hy.1, hz⟩, ?_⟩
    change (y.1, (y.2.1, e z)) = y
    exact Prod.ext rfl (Prod.ext rfl hez)

theorem cylinder_pure_of_chart_transitive [SecondCountableTopology (K × (Q × E))]
    (e : OpenPartialHomeomorph (P × N) E)
    (he : DifferentiableOn ℝ e e.source)
    (s U : Set E) (hU : IsOpen U) (hUt : U ⊆ e.target)
    (hi : DifferentiableOn ℝ e.symm U)
    (p₀ : P) (hp : (p₀, (0 : N)) ∈ e.source)
    (hpU : e (p₀, (0 : N)) ∈ U)
    (hcut : ∀ p ∈ e.source, e p ∈ s ↔ p.2 = 0)
    (htrans : ∀ z ∈ s, ∃ f : E ≃L[ℝ] E,
      f (e (p₀, (0 : N))) = z ∧ f '' s = s) :
    ∀ x ∈ (cylinder s : Set (K × (Q × E))), ∀ r : ℝ, 0 < r →
      dimH ((cylinder s : Set (K × (Q × E))) ∩ Metric.ball x r) =
        (Module.finrank ℝ K + Module.finrank ℝ P : ℕ) := by
  let W : Set (K × (Q × E)) := {x | x.2.2 ∈ U}
  have hW : IsOpen W :=
    hU.preimage (continuous_snd.comp continuous_snd)
  have hdim : dimH ((cylinder s : Set (K × (Q × E))) ∩ W) =
      (Module.finrank ℝ K + Module.finrank ℝ P : ℕ) :=
    dimH_cylinder_inter_of_chart e he s U hUt hi p₀ hp hcut
      0 W hW hpU (fun _ hx => hx)
  have hglobal : dimH (cylinder s : Set (K × (Q × E))) ≤
      (Module.finrank ℝ K + Module.finrank ℝ P : ℕ) := by
    apply dimH_le_of_local
    intro x hx
    obtain ⟨f, hfa, hfs⟩ := htrans x.2.2 hx.2
    let g := liftEquiv (K := K) (Q := Q) f
    have hgs : g '' cylinder s = (cylinder s : Set (K × (Q × E))) := by
      rw [liftEquiv_image_cylinder, hfs]
    have hxW : x ∈ g '' W := by
      refine ⟨(x.1, (0, e (p₀, (0 : N)))), hpU, ?_⟩
      change (x.1, ((0 : Q), f (e (p₀, (0 : N))))) = x
      exact Prod.ext rfl (Prod.ext hx.1.symm hfa)
    obtain ⟨r, hr, hrW⟩ := Metric.mem_nhds_iff.mp
      ((g.toHomeomorph.isOpenMap W hW).mem_nhds hxW)
    have him : g '' ((cylinder s : Set (K × (Q × E))) ∩ W) =
        (cylinder s : Set (K × (Q × E))) ∩ (g '' W) := by
      rw [Set.image_inter g.injective, hgs]
    refine ⟨r, hr, ?_⟩
    calc
      dimH ((cylinder s : Set (K × (Q × E))) ∩ Metric.ball x r) ≤
          dimH ((cylinder s : Set (K × (Q × E))) ∩ (g '' W)) :=
        dimH_mono (inter_subset_inter_right _ hrW)
      _ = dimH (g '' ((cylinder s : Set (K × (Q × E))) ∩ W)) := by rw [him]
      _ = dimH ((cylinder s : Set (K × (Q × E))) ∩ W) := g.dimH_image _
      _ = _ := hdim
  intro x hx r hr
  apply le_antisymm ((dimH_mono inter_subset_left).trans hglobal)
  obtain ⟨f, hfa, hfs⟩ := htrans x.2.2 hx.2
  let g := liftEquiv (K := K) (Q := Q) f
  let V := W ∩ g ⁻¹' Metric.ball x r
  have hgbase : g (x.1, (0, e (p₀, (0 : N)))) = x := by
    change (x.1, ((0 : Q), f (e (p₀, (0 : N))))) = x
    exact Prod.ext rfl (Prod.ext hx.1.symm hfa)
  have hV : IsOpen V :=
    hW.inter (Metric.isOpen_ball.preimage g.continuous)
  have hbase : (x.1, ((0 : Q), e (p₀, (0 : N)))) ∈ V := by
    refine ⟨hpU, ?_⟩
    change g _ ∈ Metric.ball x r
    rw [hgbase]
    exact Metric.mem_ball_self hr
  have hd := dimH_cylinder_inter_of_chart e he s U hUt hi p₀ hp hcut
    x.1 V hV hbase (fun _ hy => hy.1)
  rw [← hd, ← g.dimH_image ((cylinder s : Set (K × (Q × E))) ∩ V)]
  apply dimH_mono
  rintro _ ⟨y, hy, rfl⟩
  refine ⟨?_, hy.2.2⟩
  have hgs : g '' cylinder s = (cylinder s : Set (K × (Q × E))) := by
    rw [liftEquiv_image_cylinder, hfs]
  rw [← hgs]
  exact ⟨y, hy.1, rfl⟩

end MAIS.Run2GeometricCylinderHomogeneous

/-- info: 'MAIS.Run2GeometricCylinderHomogeneous.liftEquiv_image_cylinder' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderHomogeneous.liftEquiv_image_cylinder

/-- info: 'MAIS.Run2GeometricCylinderHomogeneous.cylinder_pure_of_chart_transitive' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderHomogeneous.cylinder_pure_of_chart_transitive
end
end
-- ==================== end module O7.Run2GeometricCylinderHomogeneous ====================

-- ==================== begin module O7.Run2GeometricCylinderOrbit (formalization/O7/Run2GeometricCylinderOrbit.lean) ====================
section

/-! Actual residual gauge orbit cylinders have genuine pure Hausdorff
dimension equal to the spectator dimension plus the actual orbit rank. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricCylinderOrbit
open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear
open MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalSliceChart
open MAIS.Run2GeometricIntervalOrbit MAIS.Run2GeometricOrbitDimension
open MAIS.Run2GeometricTransport MAIS.Run2GeometricCylinderPatch
open MAIS.Run2GeometricCylinderHomogeneous
open MAIS.QuiverGaugeMeasuredPair MAIS.QuiverCoordinateMeasuredPair
open MAIS.MatrixCoordinateTransport MAIS.BarcodeActiveNormalForm
open MAIS.Run2OrbitDifferentialGauge MAIS.Run2OrbitDifferentialCoordinates

variable {K Q : Type*}
  [NormedAddCommGroup K] [NormedSpace ℝ K] [FiniteDimensional ℝ K]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q] [FiniteDimensional ℝ Q]

theorem interval_orbit_cylinder_inter_ball_dimH
    {S : Type*} [Fintype S] [DecidableEq S]
    (D : ℕ) (birth death : S → ℕ)
    (hD : ∀ s, death s ≤ D + 1) (hvalid : ∀ s, birth s < death s) :
    ∀ x ∈ (cylinder (MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)) :
        Set (K × (Q × Rep (Index D birth death)))),
      ∀ r : ℝ, 0 < r →
      dimH ((cylinder (MulAction.orbit (Gauge (Index D birth death))
        (intervalRep D birth death)) :
          Set (K × (Q × Rep (Index D birth death)))) ∩ Metric.ball x r) =
        (Module.finrank ℝ K + Module.finrank ℝ
          (orbitDifferential (Index D birth death) (intervalRep D birth death)).range : ℕ) := by
  let e := parameterChart D birth death hD hvalid
  let s := MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)
  obtain ⟨U, hU, hbU, hUt, hi⟩ :=
    exists_open_inverse_neighborhood D birth death hD hvalid
  have hf : DifferentiableOn ℝ e e.source := by
    intro p _
    exact (analyticAt_parameterChart D birth death hD hvalid p).differentiableAt.differentiableWithinAt
  have hInv : DifferentiableOn ℝ e.symm U := by
    intro A hA
    exact (hi A hA).differentiableAt.differentiableWithinAt
  have hp : ((0 : TangentParameters D birth death),
      (0 : MAIS.IntervalCochainProduct.NormalParams birth death)) ∈ e.source :=
    zero_mem_parameterChart_source D birth death hD hvalid
  have he0 : e (0, 0) = intervalRep D birth death := by
    rw [parameterChart_normal, map_zero, add_zero]
  have hcut : ∀ p ∈ e.source, e p ∈ s ↔ p.2 = 0 :=
    fun p _ => parameterChart_mem_base_orbit_iff D birth death hD hvalid p
  have htrans : ∀ z ∈ s, ∃ f : Rep (Index D birth death) ≃L[ℝ] Rep (Index D birth death),
      f (e (0, 0)) = z ∧ f '' s = s := by
    intro z hz
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp hz
    refine ⟨gaugeContinuousEquiv _ g, ?_, gauge_image_orbit g _⟩
    rw [he0]
    exact hg
  have h := cylinder_pure_of_chart_transitive (K := K) (Q := Q)
    e hf s U hU hUt hInv 0 hp (he0.symm ▸ hbU) hcut htrans
  simpa only [tangent_finrank] using h

variable {D : ℕ} {ι : Fin (D + 1) → Type*}
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

theorem orbit_cylinder_inter_ball_dimH (A : Rep ι) :
    ∀ x ∈ (cylinder (MulAction.orbit (Gauge ι) A) : Set (K × (Q × Rep ι))),
      ∀ r : ℝ, 0 < r →
      dimH ((cylinder (MulAction.orbit (Gauge ι) A) : Set (K × (Q × Rep ι))) ∩ Metric.ball x r) =
        (Module.finrank ℝ K + Module.finrank ℝ (orbitDifferential ι A).range : ℕ) := by
  obtain ⟨N⟩ := exists_normal_form A
  let C := intervalRep D N.birth N.death
  let f := coordinateContinuousEquiv N.coordinates
  let A₀ := transport N.coordinates C
  let g := liftEquiv (K := K) (Q := Q) f
  have hC := interval_orbit_cylinder_inter_ball_dimH (K := K) (Q := Q)
    D N.birth N.death N.bounded N.valid
  have himage : g '' (cylinder (MulAction.orbit (Gauge (Index D N.birth N.death)) C)) =
      (cylinder (MulAction.orbit (Gauge ι) A₀) : Set (K × (Q × Rep ι))) := by
    rw [liftEquiv_image_cylinder, coordinate_image_orbit]
  have hp := dimH_image_inter_ball g
    (cylinder (MulAction.orbit (Gauge (Index D N.birth N.death)) C))
    (Module.finrank ℝ K + Module.finrank ℝ
      (orbitDifferential (Index D N.birth N.death) C).range : ℕ) hC
  rw [himage] at hp
  have horb : MulAction.orbit (Gauge ι) A = MulAction.orbit (Gauge ι) A₀ :=
    MulAction.orbit_eq_iff.mpr N.original_in_orbit
  have hdim : Module.finrank ℝ (orbitDifferential ι A).range =
      Module.finrank ℝ (orbitDifferential (Index D N.birth N.death) C).range := by
    calc
      _ = Module.finrank ℝ (orbitDifferential ι A₀).range :=
        finrank_range_eq_of_mem_orbit ι N.original_in_orbit
      _ = _ := finrank_range_transport N.coordinates C
  rw [horb, hdim]
  exact hp

end MAIS.Run2GeometricCylinderOrbit

/-- info: 'MAIS.Run2GeometricCylinderOrbit.interval_orbit_cylinder_inter_ball_dimH' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderOrbit.interval_orbit_cylinder_inter_ball_dimH

/-- info: 'MAIS.Run2GeometricCylinderOrbit.orbit_cylinder_inter_ball_dimH' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderOrbit.orbit_cylinder_inter_ball_dimH
end
end
-- ==================== end module O7.Run2GeometricCylinderOrbit ====================

-- ==================== begin module O7.Run2GeometricCodimension (formalization/O7/Run2GeometricCodimension.lean) ====================
section

/-! The local dimension is finite and is attained by an actual zero-product
orbit. Hence actual geometric codimension equals the least actual differential
cokernel dimension among ordinary closure-generizing zero-product orbits. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricCodimension
open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.QuiverOrbitRank
open MAIS.Run2GeometricCharts MAIS.Run2GeometricZeroFiber
open MAIS.Run2OrbitDifferentialGauge

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

theorem localDimH_le_ambient (A : Rep ι) :
    localDimH (zeroFiber ι) A ≤ (Module.finrank ℝ (Rep ι) : ℝ≥0∞) := by
  exact (localDimH_le_dimH _ _).trans
    ((dimH_mono (subset_univ _)).trans_eq (Real.dimH_univ_eq_finrank _))

theorem localDimH_lt_top (A : Rep ι) :
    localDimH (zeroFiber ι) A < ⊤ :=
  (localDimH_le_ambient ι A).trans_lt (by simp)

/-- The natural codimension is derived from the true finite Hausdorff dimension.
No numerical orbit table or desired coefficient enters this definition. -/
def localCodimNat (A : Rep ι) : ℕ :=
  Module.finrank ℝ (Rep ι) - ⌊(localDimH (zeroFiber ι) A).toReal⌋₊

def RelevantOrbitIndex (A : Rep ι) :=
  {j : ZeroOrbitIndex ι //
    A ∈ closure (MulAction.orbit (Gauge ι) (representative ι j))}

instance (A : Rep ι) : Fintype (RelevantOrbitIndex ι A) := by
  unfold RelevantOrbitIndex
  exact Fintype.ofFinite _

theorem relevant_nonempty {A : Rep ι} (hA : A ∈ zeroFiber ι) :
    Nonempty (RelevantOrbitIndex ι A) := by
  have h := hA
  rw [zeroFiber_eq_iUnion_orbits] at h
  obtain ⟨j, hj⟩ := Set.mem_iUnion.mp h
  exact ⟨⟨j, subset_closure hj⟩⟩

/-- An actual ordinary real orbit realizes the true local Hausdorff dimension.
The final universal comparison ranges over all actual zero-product matrices. -/
theorem exists_orbit_realizing_localDimH {A : Rep ι} (hA : A ∈ zeroFiber ι) :
    ∃ B : Rep ι, B ∈ zeroFiber ι ∧
      A ∈ closure (MulAction.orbit (Gauge ι) B) ∧
      localDimH (zeroFiber ι) A =
        (Module.finrank ℝ (orbitDifferential ι B).range : ℝ≥0∞) ∧
      ∀ C : Rep ι, C ∈ zeroFiber ι →
        A ∈ closure (MulAction.orbit (Gauge ι) C) →
        Module.finrank ℝ (orbitDifferential ι C).range ≤
          Module.finrank ℝ (orbitDifferential ι B).range := by
  classical
  let : Nonempty (RelevantOrbitIndex ι A) := relevant_nonempty ι hA
  let rank : RelevantOrbitIndex ι A → ℕ :=
    fun j => Module.finrank ℝ (orbitDifferential ι (representative ι j.val)).range
  obtain ⟨j, _, hj⟩ := Finset.exists_max_image Finset.univ rank Finset.univ_nonempty
  let B := representative ι j.val
  have hmax : ∀ k : ZeroOrbitIndex ι,
      A ∈ closure (MulAction.orbit (Gauge ι) (representative ι k)) →
      Module.finrank ℝ (orbitDifferential ι (representative ι k)).range ≤
        Module.finrank ℝ (orbitDifferential ι B).range := by
    intro k hk
    exact hj ⟨k, hk⟩ (Finset.mem_univ _)
  have hdim : localDimH (zeroFiber ι) A =
      (Module.finrank ℝ (orbitDifferential ι B).range : ℝ≥0∞) := by
    rw [localDimH_zeroFiber]
    apply le_antisymm
    · exact iSup_le fun k => iSup_le fun hk => by exact_mod_cast hmax k hk
    · exact le_iSup_of_le j.val (le_iSup_of_le j.property le_rfl)
  refine ⟨B, (representative_spec ι j.val).1, j.property, hdim, ?_⟩
  intro C hC hclosure
  let k : ZeroOrbitIndex ι := ⟨Quotient.mk'' C, C, hC, rfl⟩
  have hq : Quotient.mk'' C = Quotient.mk'' (representative ι k) :=
    (representative_spec ι k).2.symm
  have horb : C ∈ MulAction.orbit (Gauge ι) (representative ι k) :=
    Quotient.exact hq
  have he : MulAction.orbit (Gauge ι) C =
      MulAction.orbit (Gauge ι) (representative ι k) :=
    MulAction.orbit_eq_iff.mpr horb
  have hkclosure : A ∈ closure (MulAction.orbit (Gauge ι) (representative ι k)) :=
    he ▸ hclosure
  rw [finrank_range_eq_of_mem_orbit ι horb]
  exact hmax k hkclosure

theorem exists_orbit_realizing_localCodimNat {A : Rep ι} (hA : A ∈ zeroFiber ι) :
    ∃ B : Rep ι, B ∈ zeroFiber ι ∧
      A ∈ closure (MulAction.orbit (Gauge ι) B) ∧
      localCodimNat ι A =
        Module.finrank ℝ (Rep ι) - Module.finrank ℝ (orbitDifferential ι B).range ∧
      ∀ C : Rep ι, C ∈ zeroFiber ι →
        A ∈ closure (MulAction.orbit (Gauge ι) C) →
        localCodimNat ι A ≤
          Module.finrank ℝ (Rep ι) - Module.finrank ℝ (orbitDifferential ι C).range := by
  obtain ⟨B, hB, hcl, hdim, hmax⟩ := exists_orbit_realizing_localDimH ι hA
  have hcod : localCodimNat ι A =
      Module.finrank ℝ (Rep ι) - Module.finrank ℝ (orbitDifferential ι B).range := by
    simp only [localCodimNat, hdim, ENNReal.toReal_natCast, Nat.floor_natCast]
  refine ⟨B, hB, hcl, hcod, ?_⟩
  intro C hC hCcl
  rw [hcod]
  exact Nat.sub_le_sub_left (hmax C hC hCcl) _

/-- The real geometric codimension and its natural-number presentation agree;
finiteness and actual integrality have already been derived from geometry. -/
theorem localCodimH_eq_nat {A : Rep ι} (hA : A ∈ zeroFiber ι) :
    localCodimH ι A = (localCodimNat ι A : ℝ≥0∞) := by
  obtain ⟨B, _, _, hdim, _⟩ := exists_orbit_realizing_localDimH ι hA
  let N := Module.finrank ℝ (Rep ι)
  let d := Module.finrank ℝ (orbitDifferential ι B).range
  have hd : d ≤ N := Submodule.finrank_le _
  have hcast : ((N - d : ℕ) : ℝ≥0∞) = (N : ℝ≥0∞) - (d : ℝ≥0∞) := by
    calc
      ((N - d : ℕ) : ℝ≥0∞) = ENNReal.ofReal ((N - d : ℕ) : ℝ) := by simp
      _ = ENNReal.ofReal ((N : ℝ) - (d : ℝ)) := by rw [Nat.cast_sub hd]
      _ = (N : ℝ≥0∞) - (d : ℝ≥0∞) := by
        rw [ENNReal.ofReal_sub _ (Nat.cast_nonneg d)]
        simp
  simp only [localCodimH, localCodimNat, hdim, ENNReal.toReal_natCast, Nat.floor_natCast]
  exact hcast.symm

end MAIS.Run2GeometricCodimension

/-- info: 'MAIS.Run2GeometricCodimension.localDimH_le_ambient' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCodimension.localDimH_le_ambient

/-- info: 'MAIS.Run2GeometricCodimension.localDimH_lt_top' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCodimension.localDimH_lt_top

