-- ==================== begin module O7.LocalDiffeomorphismTransfer (formalization/O7/LocalDiffeomorphismTransfer.lean) ====================
section

/-! Actual radius-first learning pairs are preserved by C1 local changes
of coordinates with C1 inverse. The inverse derivative and its determinant
bounds are proved from the chart identities, and measure comparison uses
the change-of-variables theorem; no Jacobian or volume estimate is assumed. -/

set_option autoImplicit false
noncomputable section

open Set Filter MeasureTheory
open scoped Topology ENNReal

namespace MAIS.LocalDiffeomorphismTransfer

open MAIS.AnalyticTransfer O77.Transport0906

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  (mu : Measure E) [Measure.IsAddHaarMeasure mu]

omit [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] in
/-- C1 local inverse maps derive their own positive inverse-Jacobian bounds. -/
theorem local_inverse_jacobian_bounds (e : OpenPartialHomeomorph E E) {w : E}
    (hw : w ∈ e.source)
    (he : ∀ x ∈ e.source, ContDiffAt ℝ 1 e x)
    (hei : ∀ z ∈ e.target, ContDiffAt ℝ 1 e.symm z) :
    ∃ V : Set E, ∃ lo hi : ℝ, IsOpen V ∧ e w ∈ V ∧ V ⊆ e.target ∧
      0 < lo ∧ 0 < hi ∧
      ∀ z ∈ V, lo ≤ |(fderiv ℝ e.symm z).det| ∧ |(fderiv ℝ e.symm z).det| ≤ hi := by
  have hy : e w ∈ e.target := e.map_source hw
  have hinv : (fderiv ℝ e (e.symm (e w))).comp (fderiv ℝ e.symm (e w)) =
      ContinuousLinearMap.id ℝ E := by
    apply derivative_left_inverse
      ((hei _ hy).differentiableAt one_ne_zero).hasFDerivAt
      ((he _ (e.map_target hy)).differentiableAt one_ne_zero).hasFDerivAt
    filter_upwards [e.open_target.mem_nhds hy] with z hz
    exact e.right_inv hz
  have hdet := det_ne_zero_of_left_inverse _ _ hinv
  obtain ⟨V, hV, hyV, hJ⟩ := local_abs_det_bounds
    ((hei _ hy).continuousAt_fderiv one_ne_zero) hdet
  let J : ℝ := |(fderiv ℝ e.symm (e w)).det|
  have hJpos : 0 < J := abs_pos.mpr hdet
  refine ⟨V ∩ e.target, J / 2, 2 * J, hV.inter e.open_target, ⟨hyV, hy⟩,
    inter_subset_right, half_pos hJpos, mul_pos (by norm_num) hJpos, ?_⟩
  exact fun z hz => hJ z hz.1

/-- A literal loss identity in a C1 chart transports the actual Haar band
volumes on every sufficiently small metric ball, including logarithmic
multiplicity and the radius-before-epsilon order of quantifiers. -/
theorem pair_of_chart (e : OpenPartialHomeomorph E E) {w : E}
    {f g : E → ℝ} {lam : ℝ} {m : ℕ}
    (hw : w ∈ e.source)
    (he : ∀ x ∈ e.source, ContDiffAt ℝ 1 e x)
    (hei : ∀ z ∈ e.target, ContDiffAt ℝ 1 e.symm z)
    (hg : Measurable g) (hmatch : ∀ x ∈ e.source, f x = g (e x))
    (hpair : HasMeasuredBandPair mu (Metric.ball (e w)) g (e w) lam m) :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m := by
  obtain ⟨V, lo, hi, hV, hyV, hVT, hlo, hhi, hJ⟩ :=
    local_inverse_jacobian_bounds e hw he hei
  have hy : e w ∈ e.target := e.map_source hw
  obtain ⟨L, rho, hL, hrho, hballs⟩ := O77.Canonical0906.compatible_balls
    (e.open_source.mem_nhds hw) (hV.mem_nhds hyV) rfl (e.left_inv hw)
    (he w hw).exists_lipschitzOnWith (hei (e w) hy).exists_lipschitzOnWith
  apply radiusOrder_of_fixed_distortion hpair hlo hhi hL hrho
  intro R hR hRsmall eps _heps
  have hb := hballs R hR hRsmall
  have hsmall : R / L ≤ L * R :=
    (div_le_self hR.le hL).trans (le_mul_of_one_le_left hR.le hL)
  have hiV : Metric.ball (e w) (R / L) ⊆ V :=
    fun z hz => hb.2.1 (Metric.ball_subset_ball hsmall hz)
  let loss : E → ℝ := fun x => |f x - f w|
  let model : E → ℝ := fun z => |g z - g (e w)|
  have hcenter : f w = g (e w) := hmatch w hw
  have hidentity : ∀ z ∈ V, loss (e.symm z) = model z := by
    intro z hz
    dsimp [loss, model]
    rw [hmatch _ (e.map_target (hVT hz)), e.right_inv (hVT hz), hcenter]
  have hbound := sublevel_window_sandwich mu
    (f := e) (g := e.symm) (Dg := fderiv ℝ e.symm)
    (U := Metric.ball w R) (V := V)
    (inner := Metric.ball (e w) (R / L)) (outer := Metric.ball (e w) (L * R))
    (loss := loss) (model := model)
    measurableSet_ball measurableSet_ball ((hg.sub_const _).abs) hiV hb.2.1
    (fun z hz => ((hei z (hVT hz)).differentiableAt one_ne_zero).hasFDerivAt)
    (fun z hz => e.right_inv (hVT hz))
    (fun x hx => e.left_inv (hb.1 hx)) hb.2.2.1 hb.2.2.2
    (a := 1) (b := 1) zero_lt_one zero_lt_one hJ
    (fun z hz => by rw [hidentity z (hiV hz), one_mul])
    (fun z hz => by rw [hidentity z (hb.2.1 hz), one_mul]) eps
  simpa only [bandMass, loss, model, div_one] using hbound

/-- A two-way actual measured chart invariance theorem. Global measurability
of the two literal losses suffices; their equality is needed only on the
chart source. There is no assumed Jacobian or band-volume comparison. -/
theorem pair_iff_of_chart (e : OpenPartialHomeomorph E E) {w : E}
    {f g : E → ℝ} {lam : ℝ} {m : ℕ}
    (hw : w ∈ e.source)
    (he : ∀ x ∈ e.source, ContDiffAt ℝ 1 e x)
    (hei : ∀ z ∈ e.target, ContDiffAt ℝ 1 e.symm z)
    (hf : Measurable f) (hg : Measurable g)
    (hmatch : ∀ x ∈ e.source, f x = g (e x)) :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair mu (Metric.ball (e w)) g (e w) lam m := by
  constructor
  · intro hp
    have hreverse : ∀ z ∈ e.target, g z = f (e.symm z) := by
      intro z hz
      rw [hmatch _ (e.map_target hz), e.right_inv hz]
    have h := pair_of_chart mu e.symm (e.map_source hw) hei he hf hreverse
      (by simpa only [e.left_inv hw] using hp)
    exact h
  · exact pair_of_chart mu e hw he hei hg hmatch

end MAIS.LocalDiffeomorphismTransfer

/--
info: 'MAIS.LocalDiffeomorphismTransfer.pair_iff_of_chart' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LocalDiffeomorphismTransfer.pair_iff_of_chart
end
end
