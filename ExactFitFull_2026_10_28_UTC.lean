-- ==================== begin module O7.QuiverFinitePairTable (formalization/O7/QuiverFinitePairTable.lean) ====================
section

/-! Actual finite orbit representatives turn genuine pointwise measured
zero-output pair existence into a genuine finite higher-orbit table. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.QuiverFinitePairTable
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.QuiverOrbitFiniteHeight MAIS.QuiverGaugeMeasuredPair MAIS.AnalyticTransfer
variable {D:ℕ} (ι:Fin (D+1)→Type*)
  [∀ v,Fintype (ι v)] [∀ v,DecidableEq (ι v)]

/-- Literal zero-output strict ordinary-real orbit generization. -/
def IsHigherZero (base A:Rep ι) : Prop :=
  pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0 ∧
  base∈closure (MulAction.orbit (Gauge ι) A) ∧
  A∉MulAction.orbit (Gauge ι) base

/-- Only actual orbit classes containing a genuine higher zero-output
point are retained; this is a subtype of the proved finite actual quotient. -/
def HigherOrbitIndex (base:Rep ι) :=
  {q:MulAction.orbitRel.Quotient (Gauge ι) (Rep ι) //
    ∃ A:Rep ι,IsHigherZero ι base A ∧ Quotient.mk'' A=q}

instance higherOrbitIndexFintype (base:Rep ι) : Fintype (HigherOrbitIndex ι base) :=
  by unfold HigherOrbitIndex; exact Fintype.ofFinite _

def representative (base:Rep ι) (j:HigherOrbitIndex ι base) : Rep ι :=
  Classical.choose j.property

theorem representative_spec (base:Rep ι) (j:HigherOrbitIndex ι base) :
    IsHigherZero ι base (representative ι base j) ∧
      Quotient.mk'' (representative ι base j)=j.val :=
  Classical.choose_spec j.property

/-- The exponent/multiplicity on each finite label is chosen from an
actual measured pair witness at an actual matrix representative. Gauge
invariance then supplies literal measured coverage at every higher point.
No numerical local type or desired origin coefficient is a premise. -/
theorem exists_finite_higher_table
    (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (base:Rep ι)
    (hexists:∀ A:Rep ι,IsHigherZero ι base A→
      ∃ lam:ℝ,∃ m:ℕ,HasMeasuredBandPair mu (Metric.ball A)
        (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A lam m) :
    ∃ a:HigherOrbitIndex ι base→ℝ,∃ m:HigherOrbitIndex ι base→ℕ,
      ∀ A:Rep ι,IsHigherZero ι base A→
        ∃ j:HigherOrbitIndex ι base,HasMeasuredBandPair mu (Metric.ball A)
          (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A (a j) (m j) := by
  classical
  have hp:∀ j:HigherOrbitIndex ι base,∃ lam:ℝ,∃ m:ℕ,
      HasMeasuredBandPair mu (Metric.ball (representative ι base j))
        (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2)
        (representative ι base j) lam m := fun j=>
    hexists _ (representative_spec ι base j).1
  choose a m hm using hp
  refine ⟨a,m,?_⟩
  intro A hA
  let j:HigherOrbitIndex ι base:=⟨Quotient.mk'' A,A,hA,rfl⟩
  have hq:Quotient.mk'' A=Quotient.mk'' (representative ι base j):=
    (representative_spec ι base j).2.symm
  have horb:A∈MulAction.orbit (Gauge ι) (representative ι base j):=
    Quotient.exact hq
  obtain ⟨g,hg⟩:=MulAction.mem_orbit_iff.mp horb
  refine ⟨j,?_⟩
  rw [← hg]
  exact (pair_iff_gauge_zero ι mu mu g (representative ι base j)
    0 (Fin.last D) (Nat.zero_le D) (representative_spec ι base j).1.1
    (a j) (m j)).mp (hm j)

end MAIS.QuiverFinitePairTable
end

/-- info: 'MAIS.QuiverFinitePairTable.higherOrbitIndexFintype' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverFinitePairTable.higherOrbitIndexFintype

/-- info: 'MAIS.QuiverFinitePairTable.exists_finite_higher_table' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverFinitePairTable.exists_finite_higher_table
end
