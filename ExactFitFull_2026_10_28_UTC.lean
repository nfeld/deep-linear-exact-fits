-- ==================== begin module O7.Run2PotentialMultiplicityStep (formalization/O7/Run2PotentialMultiplicityStep.lean) ====================
section

/-! Actual measured Bellman laws on constant-exponent strict higher zero
orbits. The critical increment is the independently specified radial equality
indicator, and all successor witnesses come from the actual volume recurrence. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2600000
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialMultiplicityStep
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalMeasuredSlice
open MAIS.QuiverFinitePairTable MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.Run2PotentialActualRecurrence MAIS.Run2PotentialMultiplicityBound
open MAIS.Run2PotentialNormalBound MAIS.ActiveIntervalWeightedResidual MAIS.AnalyticTransfer

def radialIndicator (lam tau : ℝ) : ℕ := if lam = tau then 1 else 0

theorem radialIndicator_le_one (lam tau : ℝ) : radialIndicator lam tau ≤ 1 := by
  unfold radialIndicator
  split_ifs <;> omega

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

include hD in
/-- Every actual constant-exponent higher successor satisfies the correct
critical increment inequality for its literal measured multiplicity. -/
theorem same_exponent_higher_multiplicity_le
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0)
    (B : Ambient D birth death)
    (hB : IsHigherZero (Index D birth death) (intervalRep D birth death) B)
    {lam : ℝ} {m n : ℕ}
    (hp : HasMeasuredBandPair muA (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
      (intervalRep D birth death) lam m)
    (hBp : HasMeasuredBandPair muA (Metric.ball B)
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) B lam n) :
    n + radialIndicator lam (threshold birth death (realPotential D birth death)) ≤ m := by
  rcases isEmpty_or_nonempty (ResidualIndex D birth death) with hR | hR
  · let _ : IsEmpty (ResidualIndex D birth death) := hR
    obtain ⟨z, hz, _⟩ := MAIS.Run2AllHigherAttainment.exists_nonzero_corrected_normal_mem_orbit
      D birth death hD hvalid B hB.1 hB.2.1 hB.2.2
    exact False.elim (hz (Subsingleton.elim _ _))
  · let _ : Nonempty (ResidualIndex D birth death) := hR
    obtain ⟨_, a, M, _, _, hbest, hlam, hm⟩ :=
      actual_nonterminal_recurrence D birth death hD hvalid muA hzero hp
    have hbestB := hbest B hB lam n hBp
    have ha0 : a ≤ lam := by rcases hbestB with h | ⟨h, _⟩; exact h.le; exact h.le
    have ha : a = lam := le_antisymm ha0 (hlam.le.trans (min_le_left _ _))
    have hn : n ≤ M := by
      rcases hbestB with h | ⟨_, hn⟩
      · exact False.elim ((ne_of_lt h) ha)
      · exact hn
    have hltau : lam ≤ threshold birth death (realPotential D birth death) :=
      hlam.le.trans (min_le_right _ _)
    rw [ha] at hm
    by_cases heq : lam = threshold birth death (realPotential D birth death)
    · simp only [heq, lt_self_iff_false, ite_false, ite_true] at hm
      simp only [radialIndicator, heq, ite_true]
      omega
    · have hlt : lam < threshold birth death (realPotential D birth death) :=
        lt_of_le_of_ne hltau heq
      simp only [ite_eq_left hlt] at hm
      simp only [radialIndicator, ite_eq_right heq]
      omega

include hD in
/-- If the actual multiplicity exceeds one, an actual constant-exponent
strict higher orbit attains equality in the critical increment Bellman law. -/
theorem exists_same_exponent_maximizing_successor
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair muA (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
      (intervalRep D birth death) lam m)
    (hmgt : 1 < m) :
    ∃ B : Ambient D birth death, ∃ n : ℕ,
      IsHigherZero (Index D birth death) (intervalRep D birth death) B ∧
      HasMeasuredBandPair muA (Metric.ball B)
        (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) B lam n ∧
      m = n + radialIndicator lam (threshold birth death (realPotential D birth death)) := by
  rcases isEmpty_or_nonempty (ResidualIndex D birth death) with hR | hR
  · let _ : IsEmpty (ResidualIndex D birth death) := hR
    rcases one_or_higher_multiplicity D birth death hD hvalid muA hzero hp with
      hm | ⟨B, _, _, hB, _⟩
    · omega
    · obtain ⟨z, hz, _⟩ := MAIS.Run2AllHigherAttainment.exists_nonzero_corrected_normal_mem_orbit
        D birth death hD hvalid B hB.1 hB.2.1 hB.2.2
      exact False.elim (hz (Subsingleton.elim _ _))
  · let _ : Nonempty (ResidualIndex D birth death) := hR
    obtain ⟨B, a, n, hB, hBp, _, hlam, hm⟩ :=
      actual_nonterminal_recurrence D birth death hD hvalid muA hzero hp
    have hle : a ≤ threshold birth death (realPotential D birth death) := by
      by_contra h
      have hlt := lt_of_not_ge h
      simp only [ite_eq_right (not_lt.mpr hlt.le), ite_eq_right (ne_of_gt hlt)] at hm
      omega
    have hla : lam = a := hlam.trans (min_eq_left hle)
    refine ⟨B, n, hB, by simpa only [hla] using hBp, ?_⟩
    rw [hla]
    by_cases heq : a = threshold birth death (realPotential D birth death)
    · simpa only [heq, lt_self_iff_false, ite_false, ite_true, radialIndicator] using hm
    · have hlt := lt_of_le_of_ne hle heq
      simpa only [ite_eq_left hlt, radialIndicator, ite_eq_right heq, add_zero] using hm

end MAIS.Run2PotentialMultiplicityStep

/-- info: 'MAIS.Run2PotentialMultiplicityStep.same_exponent_higher_multiplicity_le' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialMultiplicityStep.same_exponent_higher_multiplicity_le

/-- info: 'MAIS.Run2PotentialMultiplicityStep.exists_same_exponent_maximizing_successor' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialMultiplicityStep.exists_same_exponent_maximizing_successor
end
end
-- ==================== end module O7.Run2PotentialMultiplicityStep ====================

-- ==================== begin module O7.Run2PotentialOrbitGraph (formalization/O7/Run2PotentialOrbitGraph.lean) ====================
section

/-! An independently defined finite ACTUAL zero-orbit graph. Vertices are the
already proved finite real gauge-orbit classes, edges use literal ordinary
closure and equal independent incidence minima, and vertex costs use an actual
geometrically chosen normal form. No multiplicity occurs in these definitions. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialOrbitGraph
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.BarcodeActiveNormalForm
open MAIS.QuiverOrbitFiniteHeight MAIS.QuiverGaugeMeasuredPair
open MAIS.QuiverZeroFinitePairTable MAIS.Run2PotentialBalancedMinimum
open MAIS.ActiveIntervalWeightedResidual MAIS.Run2PotentialMultiplicityStep
open MAIS.AnalyticTransfer
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

abbrev Node := ZeroOrbitIndex ι

def rep (j : Node ι) : Rep ι := representative ι j

theorem rep_zero (j : Node ι) : pathMatrix (rep ι j) 0 (Fin.last D) (Nat.zero_le D) = 0 :=
  (representative_spec ι j).1

def normalForm (j : Node ι) : ActiveNormalForm (rep ι j) :=
  Classical.choice (exists_normal_form (rep ι j))

/-- Independent integer optimization coefficient, not an actual pair value. -/
def count (j : Node ι) : ℕ := balancedOutputMinimum ι (rep ι j)

def exponent (j : Node ι) : ℝ := (count ι j : ℝ) / 2

/-- Independent canonical threshold at the chosen genuine normal form. -/
def threshold (j : Node ι) : ℝ :=
  MAIS.Run2PotentialNormalBound.threshold (normalForm ι j).birth (normalForm ι j).death
    (realPotential D (normalForm ι j).birth (normalForm ι j).death)

/-- Literal strict higher orbit and equal independently defined exponents. -/
def edge (j k : Node ι) : Prop :=
  rep ι j ∈ closure (MulAction.orbit (Gauge ι) (rep ι k)) ∧ k ≠ j ∧ count ι j = count ι k

/-- A source node contributes one exactly at its independent radial equality.
Terminal nodes contribute no cost because the path has no outgoing edge. -/
def weight (j : Node ι) : ℕ := radialIndicator (exponent ι j) (threshold ι j)

def indexOf (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) : Node ι :=
  ⟨Quotient.mk'' A, A, hzero, rfl⟩

theorem rep_mem_orbit_indexOf (A : Rep ι)
    (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    rep ι (indexOf ι A hzero) ∈ MulAction.orbit (Gauge ι) A :=
  Quotient.exact (representative_spec ι (indexOf ι A hzero)).2

theorem node_eq_of_reps_mem_orbit {j k : Node ι}
    (h : rep ι j ∈ MulAction.orbit (Gauge ι) (rep ι k)) : j = k := by
  apply Subtype.ext
  have hh : (Quotient.mk'' (rep ι j) : MulAction.orbitRel.Quotient (Gauge ι) (Rep ι)) =
      Quotient.mk'' (rep ι k) := Quotient.sound h
  exact (representative_spec ι j).2.symm.trans (hh.trans (representative_spec ι k).2)

theorem rep_not_mem_orbit_of_edge {j k : Node ι} (h : edge ι j k) :
    rep ι k ∉ MulAction.orbit (Gauge ι) (rep ι j) := by
  intro hk
  exact h.2.1 (node_eq_of_reps_mem_orbit ι hk)

theorem edge_rankDefect_lt {j k : Node ι} (h : edge ι j k) :
    rankDefect ι (rep ι k) < rankDefect ι (rep ι j) :=
  rankDefect_lt_of_strict_generization ι (rep ι j) (rep ι k) h.1
    (rep_not_mem_orbit_of_edge ι h)

theorem wellFounded_edge : WellFounded (fun k j : Node ι => edge ι j k) := by
  apply Subrelation.wf (r := InvImage (fun a b : ℕ => a < b)
    (fun j : Node ι => rankDefect ι (rep ι j))) ?_
    (InvImage.wf _ Nat.lt_wfRel.wf)
  intro k j h
  exact edge_rankDefect_lt ι h

theorem weight_le_one (j : Node ι) : weight ι j ≤ 1 :=
  radialIndicator_le_one _ _

/-- Only here is the ACTUAL measured multiplicity introduced, separately
from the independently defined graph, coefficient and cost. -/
def multiplicity (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (j : Node ι) : ℕ :=
  (pairValue ι mu ⟨rep ι j, rep_zero ι j⟩).2

/-- The prior independent exponent formula identifies the genuine measured
pair at each actual orbit representative. -/
theorem pair_at_rep (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (j : Node ι) :
    HasMeasuredBandPair mu (Metric.ball (rep ι j))
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2)
      (rep ι j) (exponent ι j) (multiplicity ι mu j) := by
  have hp := pairValue_spec ι mu ⟨rep ι j, rep_zero ι j⟩
  have heq := exponent_eq_half_balancedOutputMinimum ι mu (rep ι j) (rep_zero ι j) hp
  change (pairValue ι mu ⟨rep ι j, rep_zero ι j⟩).1 = exponent ι j at heq
  simpa only [heq, multiplicity] using hp

theorem multiplicity_pos (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (j : Node ι) :
    1 ≤ multiplicity ι mu j := (pair_at_rep ι mu j).2.1

/-- Actual values at any literal zero-output point agree with its graph
vertex; genuine gauge transport and measured uniqueness prove this. -/
theorem measured_values_eq_indexOf
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {a : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A a m) :
    a = exponent ι (indexOf ι A hzero) ∧ m = multiplicity ι mu (indexOf ι A hzero) := by
  obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp (rep_mem_orbit_indexOf ι A hzero)
  have hgp := (pair_iff_gauge_zero ι mu mu g A 0 (Fin.last D) (Nat.zero_le D) hzero a m).mp hp
  rw [hg] at hgp
  exact O77.PowerLogUniqueness.radius_order_unique hgp (pair_at_rep ι mu (indexOf ι A hzero))

end MAIS.Run2PotentialOrbitGraph

/-- info: 'MAIS.Run2PotentialOrbitGraph.wellFounded_edge' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialOrbitGraph.wellFounded_edge

/-- info: 'MAIS.Run2PotentialOrbitGraph.pair_at_rep' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialOrbitGraph.pair_at_rep

/-- info: 'MAIS.Run2PotentialOrbitGraph.measured_values_eq_indexOf' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialOrbitGraph.measured_values_eq_indexOf
end
end
-- ==================== end module O7.Run2PotentialOrbitGraph ====================

-- ==================== begin module O7.Run2PotentialOrbitBellman (formalization/O7/Run2PotentialOrbitBellman.lean) ====================
section

/-! Actual measured multiplicities satisfy Bellman inequalities and attain
maximizing successors on the independently defined finite zero-orbit graph.
All graph edges, costs and exponent-equality tests were defined without them. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3200000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialOrbitBellman
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open MAIS.MatrixCoordinateTransport MAIS.BarcodeActiveNormalForm
open MAIS.QuiverIntervalMeasuredNormalForm MAIS.ActiveIntervalDifferential
open MAIS.ActiveIntervalMeasuredSlice MAIS.QuiverFinitePairTable
open MAIS.Run2PotentialOrbitGraph MAIS.Run2PotentialMultiplicityStep
open MAIS.AnalyticTransfer
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- Every independent graph edge satisfies the correct inequality for the
actual measured multiplicities, with the independent critical source cost. -/
theorem edge_multiplicity_inequality
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    {j k : Node ι} (h : edge ι j k) :
    multiplicity ι mu k + weight ι j ≤ multiplicity ι mu j := by
  let N := normalForm ι j
  let muK : Measure (Rep (Index D N.birth N.death)) := addHaar
  let T : Rep (Index D N.birth N.death) :=
    transport (fun v => (N.coordinates v).symm) (rep ι k)
  have hKzero := intervalRep_zero_of_original_zero N 0 (Fin.last D) (Nat.zero_le D) (rep_zero ι j)
  have hKp := (pair_iff_normal_form N mu muK 0 (Fin.last D) (Nat.zero_le D)
    (rep_zero ι j) (exponent ι j) (multiplicity ι mu j)).mp (pair_at_rep ι mu j)
  have hTzero : pathMatrix T 0 (Fin.last D) (Nat.zero_le D) = 0 := by
    rw [path_transport, rep_zero]
    rfl
  have hTp := (MAIS.QuiverCoordinateMeasuredPair.pair_iff_coordinate_transport
    (fun v => (N.coordinates v).symm) mu muK (rep ι k)
    0 (Fin.last D) (Nat.zero_le D) (exponent ι k) (multiplicity ι mu k)).mp (pair_at_rep ι mu k)
  have heq : exponent ι k = exponent ι j := by simp only [exponent, h.2.2]
  rw [heq] at hTp
  have hKT : intervalRep D N.birth N.death ∈
      closure (MulAction.orbit (Gauge (Index D N.birth N.death)) T) := by
    apply MAIS.RealTypeAClosure.mem_closure_orbit_of_path_rank_le
    intro a b hab
    rw [path_rank_transport, N.rank_eq a b hab]
    exact path_rank_le_of_mem_closure_orbit h.1 a b hab
  have hnot : T ∉ MulAction.orbit (Gauge (Index D N.birth N.death))
      (intervalRep D N.birth N.death) := by
    intro horb
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp horb
    apply rep_not_mem_orbit_of_edge ι h
    apply mem_gauge_orbit_of_path_rank_eq (rep ι j) (rep ι k)
    intro a b hab
    have hr : (pathMatrix T a b hab).rank =
        (pathMatrix (intervalRep D N.birth N.death) a b hab).rank := by
      rw [← hg]
      exact path_rank_gauge g _ a b hab
    rw [path_rank_transport] at hr
    exact (N.rank_eq a b hab).symm.trans hr.symm
  exact same_exponent_higher_multiplicity_le D N.birth N.death N.bounded N.valid
    muK hKzero T ⟨hTzero, hKT, hnot⟩ hKp hTp

/-- Whenever the actual multiplicity exceeds one, a genuine independent
graph edge attains equality. Its successor is obtained from an actual higher
measured witness and then passed to its true finite real-orbit class. -/
theorem exists_maximizing_edge
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (j : Node ι) (hmgt : 1 < multiplicity ι mu j) :
    ∃ k : Node ι, edge ι j k ∧
      multiplicity ι mu j = multiplicity ι mu k + weight ι j := by
  let N := normalForm ι j
  let muK : Measure (Rep (Index D N.birth N.death)) := addHaar
  have hKzero := intervalRep_zero_of_original_zero N 0 (Fin.last D) (Nat.zero_le D) (rep_zero ι j)
  have hKp := (pair_iff_normal_form N mu muK 0 (Fin.last D) (Nat.zero_le D)
    (rep_zero ι j) (exponent ι j) (multiplicity ι mu j)).mp (pair_at_rep ι mu j)
  obtain ⟨B, n, hB, hBp, hm⟩ := exists_same_exponent_maximizing_successor
    D N.birth N.death N.bounded N.valid muK hKzero hKp hmgt
  let T : Rep ι := transport N.coordinates B
  have hTzero : pathMatrix T 0 (Fin.last D) (Nat.zero_le D) = 0 := by
    rw [path_transport, hB.1]
    rfl
  have hcl : rep ι j ∈ closure (MulAction.orbit (Gauge ι) T) := by
    apply MAIS.RealTypeAClosure.mem_closure_orbit_of_path_rank_le
    intro a b hab
    rw [← N.rank_eq a b hab, path_rank_transport]
    exact path_rank_le_of_mem_closure_orbit hB.2.1 a b hab
  have hnot : T ∉ MulAction.orbit (Gauge ι) (rep ι j) := by
    intro horb
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp horb
    apply hB.2.2
    apply mem_gauge_orbit_of_path_rank_eq (intervalRep D N.birth N.death) B
    intro a b hab
    have hr : (pathMatrix T a b hab).rank = (pathMatrix (rep ι j) a b hab).rank := by
      rw [← hg]
      exact path_rank_gauge g _ a b hab
    rw [path_rank_transport] at hr
    exact (N.rank_eq a b hab).trans hr.symm
  have hTp := (MAIS.QuiverCoordinateMeasuredPair.pair_iff_coordinate_transport
    N.coordinates muK mu B 0 (Fin.last D) (Nat.zero_le D)
    (exponent ι j) n).mp hBp
  let k := indexOf ι T hTzero
  have hvalues := measured_values_eq_indexOf ι mu T hTzero hTp
  change exponent ι j = exponent ι k ∧ n = multiplicity ι mu k at hvalues
  have hRep : rep ι k ∈ MulAction.orbit (Gauge ι) T := rep_mem_orbit_indexOf ι T hTzero
  have hknot : k ≠ j := by
    intro hk
    rw [hk] at hRep
    exact hnot (MulAction.mem_orbit_symm.mp hRep)
  have hcount : count ι j = count ι k := by
    have hv : (count ι j : ℝ) = (count ι k : ℝ) := by
      have hh := hvalues.1
      unfold exponent at hh
      linarith
    exact_mod_cast hv
  refine ⟨k, ⟨closure_orbit_trans hcl
    (subset_closure (MulAction.mem_orbit_symm.mp hRep)), hknot, hcount⟩, ?_⟩
  simpa only [hvalues.2, weight, threshold, N] using hm

end MAIS.Run2PotentialOrbitBellman

/-- info: 'MAIS.Run2PotentialOrbitBellman.edge_multiplicity_inequality' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialOrbitBellman.edge_multiplicity_inequality

/-- info: 'MAIS.Run2PotentialOrbitBellman.exists_maximizing_edge' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialOrbitBellman.exists_maximizing_edge
end
