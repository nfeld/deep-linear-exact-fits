#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverOrbitFiniteHeight.finite_orbit_quotient

/-- info: 'MAIS.QuiverOrbitFiniteHeight.rankHeight_le' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverOrbitFiniteHeight.rankHeight_le

/-- info: 'MAIS.QuiverOrbitFiniteHeight.rankHeight_lt_of_strict_generization' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverOrbitFiniteHeight.rankHeight_lt_of_strict_generization

/-- info: 'MAIS.QuiverOrbitFiniteHeight.rankDefect_lt_of_strict_generization' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverOrbitFiniteHeight.rankDefect_lt_of_strict_generization

/-- info: 'MAIS.QuiverOrbitFiniteHeight.wellFounded_strict_generization' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverOrbitFiniteHeight.wellFounded_strict_generization
end
