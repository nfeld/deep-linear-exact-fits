-- ==================== begin module O7.Run2AllHigherAnnulus (formalization/O7/Run2AllHigherAnnulus.lean) ====================
section

/-! Every nonzero point has an actual positive weighted-dilation image in
the fixed compact annulus.  The witness is derived from the literal dyadic
shell partition, not supplied as a normalization hypothesis. -/
set_option autoImplicit false
set_option maxHeartbeats 800000
noncomputable section
open Set Filter
open scoped Topology

namespace MAIS.Run2AllHigherAnnulus
open MAIS.WeightedDyadicShells MAIS.WeightedCompactAnnulus
open MAIS.WeightedDilationNeighborhood
variable {I : Type*} [Fintype I] [DecidableEq I]

omit [DecidableEq I] in
theorem exists_positive_dilation_mem_compactAnnulus
    (W : I → ℕ) (hW : ∀ i, 0 < W i) (x : I → ℝ) (hx : x ≠ 0) :
    ∃ r : ℝ, 0 < r ∧ dilation W r x ∈ compactAnnulus W := by
  obtain ⟨s, hs, hball, hne⟩ := exists_positive_dilation_mem_nhds_ne_zero
    W hW x hx (Metric.ball 0 1) (Metric.ball_mem_nhds 0 zero_lt_one)
  have hbox : dilation W s x ∈ box W 0 := by
    intro i
    have hn : ‖dilation W s x‖ < 1 := by simpa only [Metric.mem_ball, dist_zero_right] using hball
    have hi := (norm_le_pi_norm (dilation W s x) i).trans_lt hn
    simpa only [Real.norm_eq_abs, Nat.zero_mul, pow_zero] using hi.le
  have hu : dilation W s x ∈ ⋃ k : ℕ, shell W k := by
    rw [iUnion_shell W hW]
    exact ⟨hbox, by simpa only [Set.mem_singleton_iff] using hne⟩
  obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hu
  rw [← dyadic_shell_image W k] at hk
  obtain ⟨z, hz, hzs⟩ := hk
  let d : ℝ := (1 / 2 : ℝ) ^ k
  have hd : 0 < d := pow_pos (by norm_num) k
  refine ⟨s / d, div_pos hs hd, ?_⟩
  have he : dilation W (s / d) x = z := by
    apply (dilationEquiv W d hd.ne').injective
    change dilation W d (dilation W (s / d) x) = dilation W d z
    rw [dilation_mul, mul_div_cancel₀ s hd.ne']
    exact hzs.symm
  rw [he]
  exact annulus_subset_compactAnnulus W hz

end MAIS.Run2AllHigherAnnulus

/-- info: 'MAIS.Run2AllHigherAnnulus.exists_positive_dilation_mem_compactAnnulus' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2AllHigherAnnulus.exists_positive_dilation_mem_compactAnnulus
end
end
