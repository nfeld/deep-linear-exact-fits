-- ==================== begin module O7.ActiveIntervalNormalContraction (formalization/O7/ActiveIntervalNormalContraction.lean) ====================
section

/-! A genuine global contracting real gauge ray for every actual affine
entrance-slice point, at arbitrary interval bases, including nonzero products. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section

namespace MAIS.ActiveIntervalNormalContraction

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalWeightedAction MAIS.ActiveIntervalEndpointRows
open MAIS.QuiverRealOrbit MAIS.QuiverOrbitRank MAIS.MatrixChainIsomorphism
open scoped Matrix Matrix.Norms.Frobenius Topology
variable {S : Type*} (birth death : S → ℕ)

def height (s : S) : ℕ := birth s + death s

def heightWeight (p : NormalIndex birth death) : ℕ :=
  height birth death p.val.1 - height birth death p.val.2

theorem height_lt_of_linked (r s : S) (hp : Linked birth death r s) :
    height birth death s < height birth death r := by
  unfold height
  rcases hp with ⟨h1, _, h3⟩
  omega

theorem heightWeight_pos (p : NormalIndex birth death) : 0 < heightWeight birth death p :=
  Nat.sub_pos_of_lt (height_lt_of_linked birth death p.val.1 p.val.2 p.property)

theorem heightWeight_ge_two (p : NormalIndex birth death) : 2 ≤ heightWeight birth death p := by
  unfold heightWeight height
  rcases p.property with ⟨h1, _, h3⟩
  omega

def dilation (r : ℝ) (t : NormalParams birth death) : NormalParams birth death :=
  fun p => r ^ heightWeight birth death p * t p

theorem dilation_zero (t : NormalParams birth death) : dilation birth death 0 t = 0 := by
  funext p
  simp only [dilation, zero_pow (Nat.ne_zero_of_lt (heightWeight_pos birth death p)),
    zero_mul, Pi.zero_apply]

theorem dilation_eq_scaleExp (r : ℝ) (hr : 0 < r) (t : NormalParams birth death) :
    dilation birth death r t = scaleExp birth death (fun s => (height birth death s : ℝ))
      (Real.log r) t := by
  funext p
  change r ^ heightWeight birth death p * t p = _
  rw [← Real.rpow_natCast, Real.rpow_def_of_pos hr]
  unfold scaleExp heightWeight
  rw [Nat.cast_sub (height_lt_of_linked birth death p.val.1 p.val.2 p.property).le]

section Finite
variable [Fintype S] [DecidableEq S]
variable (D : ℕ) (hD : ∀ s, death s ≤ D + 1)

omit [Fintype S] [DecidableEq S] in
theorem continuous_dilation (t : NormalParams birth death) :
    Continuous (fun r : ℝ => dilation birth death r t) := by
  apply continuous_pi
  intro p
  exact (continuous_id.pow _).mul_const (t p)

theorem continuous_normalFamily : Continuous (normalFamily D birth death hD) :=
  continuous_const.add
    (MAIS.ActiveIntervalNormal.normalInjection D birth death hD).toContinuousLinearMap.continuous

/-- Every positive point on the explicit polynomial contraction is in the
    same actual real matrix-gauge orbit as the original slice point. -/
theorem normalFamily_dilation_mem_orbit (t : NormalParams birth death) (r : ℝ) (hr : 0 < r) :
    normalFamily D birth death hD (dilation birth death r t) ∈
      MulAction.orbit (Gauge (Index D birth death)) (normalFamily D birth death hD t) := by
  rw [dilation_eq_scaleExp birth death r hr t, normalFamily_scaleExp]
  exact MulAction.mem_orbit _ _

/-- The actual interval base is in ordinary Euclidean closure of the actual
    orbit of EVERY affine entrance-slice point.  No zero-product, valid-slot,
    local-neighborhood or rank-comparison premise is supplied. -/
theorem intervalRep_mem_closure_orbit_normalFamily (t : NormalParams birth death) :
    intervalRep D birth death ∈ closure
      (MulAction.orbit (Gauge (Index D birth death)) (normalFamily D birth death hD t)) := by
  let f : ℝ → Rep (Index D birth death) := fun r =>
    normalFamily D birth death hD (dilation birth death r t)
  have hc : Continuous f := (continuous_normalFamily birth death D hD).comp
    (continuous_dilation birth death t)
  have hz : f 0 = intervalRep D birth death := by
    simp only [f, dilation_zero, normalFamily, map_zero, add_zero]
  have ht : Filter.Tendsto f (nhdsWithin (0 : ℝ) (Set.Ioi 0))
      (nhds (intervalRep D birth death)) := by
    have ht0 := hc.tendsto (0 : ℝ)
    rw [hz] at ht0
    exact ht0.mono_left nhdsWithin_le_nhds
  apply mem_closure_of_tendsto ht
  filter_upwards [self_mem_nhdsWithin] with r hr
  exact normalFamily_dilation_mem_orbit birth death D hD t r hr

/-- Consequently every actual consecutive matrix rank is globally at least
    its base rank on the whole actual affine normal slice. -/
theorem path_rank_base_le_normalFamily (t : NormalParams birth death)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (intervalRep D birth death) i j hij).rank ≤
      (pathMatrix (normalFamily D birth death hD t) i j hij).rank :=
  path_rank_le_of_mem_closure_orbit
    (intervalRep_mem_closure_orbit_normalFamily birth death D hD t) i j hij

end Finite
end MAIS.ActiveIntervalNormalContraction
end
end
