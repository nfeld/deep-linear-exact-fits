info: 'MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_positive_scale' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_positive_scale

/--
info: 'MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_entry_normal_slice' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_entry_normal_slice

