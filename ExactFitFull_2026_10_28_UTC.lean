-- ==================== begin module O7.Run2PositiveIntervalReduction (formalization/O7/Run2PositiveIntervalReduction.lean) ====================
section

/-! Exact actual measured-pair equivalence between a positive-output interval
family and its actual reduced zero-output family. The forward implication
uses proved residual existence and actual pair uniqueness. -/
set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PositiveIntervalReduction
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.ActiveIntervalDifferential
open MAIS.Run2FullSpanCoordinates MAIS.Run2FullSpanProduct MAIS.AnalyticTransfer
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D+1)

include hD in
/-- Actual pair iff with the true regular-coordinate dimension subtracted.
No residual existence hypothesis is required: it is derived from its zero
complete product. Multiplicity is preserved, including empty residual spaces. -/
theorem pair_iff_reduced_pair (hposD : 0 < D)
    (hvalid : ∀ s, birth s < death s)
    (mu : Measure (Rep (Index D birth death))) [Measure.IsAddHaarMeasure mu]
    (muRed : Measure (Rep (ReducedIndex D birth death))) [Measure.IsAddHaarMeasure muRed]
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball (intervalRep D birth death))
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-
        pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D)‖^2)
      (intervalRep D birth death) lam m ↔
    HasMeasuredBandPair muRed
      (Metric.ball (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death)))
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2)
      (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death))
      (lam-(Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace
        (FullSlot D birth death) (ReducedIndex D birth death (Fin.last D))
        (ReducedIndex D birth death 0)) : ℝ)/2) m := by
  let q : ℝ := (Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace
        (FullSlot D birth death) (ReducedIndex D birth death (Fin.last D))
        (ReducedIndex D birth death 0)) : ℝ)/2
  constructor
  · intro hp
    obtain ⟨a,n,hr⟩ := MAIS.QuiverZeroPairExistence.exists_pair_zero_output
      (ReducedIndex D birth death) muRed
      (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death))
      (reduced_base_completeProduct_zero D birth death hD)
    have hs := MAIS.Run2PositiveIntervalSuspension.pair_of_reduced_pair
      D birth death hD hposD hvalid mu muRed hr
    obtain ⟨hl,hm⟩ := O77.PowerLogUniqueness.radius_order_unique hp hs
    have he : lam-q=a := by change lam=a+q at hl; linarith
    change HasMeasuredBandPair muRed _ _ _ (lam-q) m
    rw [he,hm]
    exact hr
  · intro hp
    have hs := MAIS.Run2PositiveIntervalSuspension.pair_of_reduced_pair
      D birth death hD hposD hvalid mu muRed hp
    simpa only [sub_add_cancel] using hs

end MAIS.Run2PositiveIntervalReduction

/-- info: 'MAIS.Run2PositiveIntervalReduction.pair_iff_reduced_pair' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveIntervalReduction.pair_iff_reduced_pair
end
end
