-- ==================== begin module O7.WeightedRadialMoments (formalization/O7/WeightedRadialMoments.lean) ====================
section

/-! Literal exponential moments controlling weighted radial power-log integrals. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology
namespace MAIS.WeightedRadialMoments

/-- The actual finite-interval exponential moment. -/
def moment (c : ℝ) (n : ℕ) (T : ℝ) : ℝ := ∫ u in (0:ℝ)..T, Real.exp (c*u)*u^n

theorem continuous_integrand (c : ℝ) (n : ℕ) :
    Continuous (fun u : ℝ => Real.exp (c*u)*u^n) := by fun_prop

theorem integrable (c : ℝ) (n : ℕ) (a b : ℝ) :
    IntervalIntegrable (fun u : ℝ => Real.exp (c*u)*u^n) volume a b :=
  (continuous_integrand c n).intervalIntegrable a b

theorem moment_nonneg (c : ℝ) (n : ℕ) {T : ℝ} (hT : 0 ≤ T) : 0 ≤ moment c n T := by
  apply intervalIntegral.integral_nonneg hT
  intro u hu
  exact mul_nonneg (Real.exp_nonneg _) (pow_nonneg hu.1 n)

theorem moment_zero (n : ℕ) (T : ℝ) :
    moment 0 n T = T^(n+1)/(n+1:ℝ) := by
  simp [moment,integral_pow]

private theorem hasDerivAt_negative_primitive (a : ℝ) (ha : a ≠ 0) (n : ℕ) (x : ℝ) :
    HasDerivAt (fun y => -MAIS.GammaTail.tail n (a*y) / a^(n+1))
      (Real.exp (-a*x)*x^n) x := by
  have h := (((MAIS.GammaTail.hasDerivAt_tail n (a*x)).comp x
    ((hasDerivAt_id x).const_mul a)).neg).div_const (a^(n+1))
  convert! h using 1
  simp only [mul_pow,pow_succ,mul_one]
  field_simp

/-- Exact finite-interval formula, with its actual positive tail remainder. -/
theorem moment_negative_exact {a : ℝ} (ha : 0 < a) (n : ℕ) {T : ℝ} :
    moment (-a) n T =
      ((n.factorial:ℝ)-MAIS.GammaTail.tail n (a*T))/a^(n+1) := by
  have h := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun x _ => hasDerivAt_negative_primitive a ha.ne' n x)
    (integrable (-a) n 0 T)
  change (∫ u in (0:ℝ)..T, Real.exp (-a*u)*u^n) = _
  convert h using 1; simp only [mul_zero,MAIS.GammaTail.tail_zero]; ring

/-- Negative exponent moments remain uniformly bounded, independently of T. -/
theorem moment_negative_bounds {a : ℝ} (ha : 0 < a) (n : ℕ) {T : ℝ} (hT : 0 ≤ T) :
    0 ≤ moment (-a) n T ∧ moment (-a) n T ≤ (n.factorial:ℝ)/a^(n+1) := by
  refine ⟨moment_nonneg _ _ hT,?_⟩
  rw [moment_negative_exact ha]
  apply div_le_div_of_nonneg_right _ (pow_nonneg ha.le _)
  have ht := MAIS.GammaTail.tail_nonneg n (mul_nonneg ha.le hT)
  linarith

private theorem integral_exp_mul {c : ℝ} (hc : c ≠ 0) (T : ℝ) :
    (∫ u in (0:ℝ)..T, Real.exp (c*u)) = (Real.exp (c*T)-1)/c := by
  rw [intervalIntegral.integral_comp_mul_left Real.exp hc,mul_zero,integral_exp]
  simp only [Real.exp_zero,smul_eq_mul]
  ring

/-- The upper exponential-moment estimate uses the actual interval integral. -/
theorem moment_positive_upper {c : ℝ} (hc : 0 < c) (n : ℕ) {T : ℝ} (hT : 0 ≤ T) :
    moment c n T ≤ (Real.exp (c*T)*T^n)/c := by
  have hmono := intervalIntegral.integral_mono_on hT (integrable c n 0 T)
    ((Real.continuous_exp.comp (continuous_const.mul continuous_id)).mul_const (T^n)
      |>.intervalIntegrable 0 T)
    (fun u hu => mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hu.1 hu.2 n)
      (Real.exp_nonneg (c*u)))
  change moment c n T ≤ (∫ u in (0:ℝ)..T, Real.exp (c*u)*T^n) at hmono
  rw [intervalIntegral.integral_mul_const,integral_exp_mul hc.ne'] at hmono
  have hpow := pow_nonneg hT n
  have hdiv : (Real.exp (c*T)-1)/c ≤ Real.exp (c*T)/c :=
    div_le_div_of_nonneg_right (by linarith) hc.le
  exact hmono.trans ((mul_le_mul_of_nonneg_right hdiv hpow).trans_eq (by ring))

/-- A last-unit subinterval gives a uniform actual lower estimate. -/
theorem moment_positive_lower {c : ℝ} (hc : 0 < c) (n : ℕ) {T : ℝ} (hT : 2 ≤ T) :
    Real.exp (c*(T-1))*(T/2)^n ≤ moment c n T := by
  have h0 : 0 ≤ T := by linarith
  have h01 : 0 ≤ T-1 := by linarith
  have hab : T-1 ≤ T := by linarith
  have hlower := intervalIntegral.integral_mono_on hab
    (intervalIntegrable_const : IntervalIntegrable (fun _ : ℝ => Real.exp (c*(T-1))*(T/2)^n)
      volume (T-1) T) (integrable c n (T-1) T) (by
      intro u hu
      have hu0 : T-1 ≤ u := hu.1
      have he := Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hu.1 hc.le)
      have hp := pow_le_pow_left₀ (by linarith : 0 ≤ T/2) (by linarith : T/2 ≤ u) n
      exact mul_le_mul he hp (pow_nonneg (by linarith : 0 ≤ T/2) _) (Real.exp_nonneg _))
  have hnonneg : 0 ≤ᵐ[volume.restrict (Ioc (0:ℝ) T)]
      (fun u : ℝ => Real.exp (c*u)*u^n) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with u hu
    exact mul_nonneg (Real.exp_nonneg _) (pow_nonneg hu.1.le n)
  have hinterval := intervalIntegral.integral_mono_interval h01 hab le_rfl hnonneg
    (integrable c n 0 T)
  have hl : Real.exp (c*(T-1))*(T/2)^n ≤
      ∫ u in (T-1)..T, Real.exp (c*u)*u^n := by
    simpa only [intervalIntegral.integral_const,(show T-(T-1)=(1:ℝ) by ring),one_smul] using hlower
  exact hl.trans hinterval

end MAIS.WeightedRadialMoments
end

