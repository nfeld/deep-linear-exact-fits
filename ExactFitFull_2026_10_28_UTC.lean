-- ==================== begin module O7.ActiveIntervalNearbySlice (formalization/O7/ActiveIntervalNearbySlice.lean) ====================
section

/-! The actual full ambient slice remains a measured chart at every nearby
zero-output normal point; the neighborhood and inverse regularity are derived. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
noncomputable section
open Set Filter MeasureTheory MeasureTheory.Measure
open scoped Topology ENNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.ActiveIntervalNearbySlice
open MAIS.ActiveIntervalDifferential MAIS.MatrixChainIsomorphism
open MAIS.ActiveIntervalSliceChart MAIS.ActiveIntervalMeasuredSlice
open MAIS.AnalyticTransfer
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s≤D+1)

/-- A derived genuine open normal neighborhood works for all actual
nearby zero-output centers, with ordinary actual Haar balls on both sides. -/
theorem exists_open_pair_iff_nearby_normal
    (hvalid:∀ s,birth s<death s)
    (muA:Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muN:Measure (Normal birth death)) [Measure.IsAddHaarMeasure muN]
    (i j:Fin (D+1)) (hij:i≤j) :
    ∃ W:Set (Normal birth death),IsOpen W ∧ 0∈W ∧
      ∀ t∈W,pathMatrix (intervalRep D birth death+
        MAIS.ActiveIntervalNormal.normalInjection D birth death hD t) i j hij=0→
        ∀ lam:ℝ,∀ m:ℕ,
        HasMeasuredBandPair muA
          (Metric.ball (intervalRep D birth death+
            MAIS.ActiveIntervalNormal.normalInjection D birth death hD t))
          (ambientLoss D birth death i j hij)
          (intervalRep D birth death+
            MAIS.ActiveIntervalNormal.normalInjection D birth death hD t) lam m ↔
        HasMeasuredBandPair muN (Metric.ball t)
          (normalLoss D birth death hD i j hij) t lam m := by
  let P:=Parameters D birth death
  let muP:Measure P:=addHaar
  let e:=parameterChart D birth death hD hvalid
  have he:Continuous e:=continuous_iff_continuousAt.mpr
    (fun p=>(analyticAt_parameterChart D birth death hD hvalid p).continuousAt)
  obtain ⟨U,hUo,hBU,hUt,hUi⟩:=exists_open_inverse_neighborhood D birth death hD hvalid
  obtain ⟨C,hC,hc⟩:=exists_local_squared_norm_comparison D birth death hD hvalid i j hij
  obtain ⟨V,hV,hVo,h0V⟩:=eventually_nhds_iff.mp hc
  let G:Set P:=V∩e.source∩e⁻¹' U
  have hGo:IsOpen G:=((hVo.inter e.open_source).inter (hUo.preimage he))
  have he0:e (0:P)=intervalRep D birth death:=by
    change parameterChart D birth death hD hvalid (0,0)=_
    simpa only [map_zero,add_zero] using
      parameterChart_normal D birth death hD hvalid (0:Normal birth death)
  have h0pre:(0:P)∈e⁻¹' U:=by
    change e 0∈U
    rw [he0]
    exact hBU
  have h0G:(0:P)∈G:=⟨⟨h0V,zero_mem_parameterChart_source D birth death hD hvalid⟩,h0pre⟩
  let W:Set (Normal birth death):=(fun t=>(0,t):Normal birth death→P)⁻¹' G
  have hWo:IsOpen W:=hGo.preimage (continuous_const.prodMk continuous_id)
  refine ⟨W,hWo,h0G,?_⟩
  intro t ht hzero lam m
  let p:P:=(0,t)
  have hpG:p∈G:=ht
  have hepoint:e p=intervalRep D birth death+
      MAIS.ActiveIntervalNormal.normalInjection D birth death hD t:=
    parameterChart_normal D birth death hD hvalid t
  let f:P→ℝ:=fun q=>ambientLoss D birth death i j hij (e q)
  let g:P→ℝ:=fun q=>normalLoss D birth death hD i j hij q.2
  have hf:Measurable f:=(continuous_ambientLoss D birth death i j hij).measurable.comp he.measurable
  have hchart:=MAIS.CrossCarrierChartTransfer.pair_iff_of_chart_local muP muA e
    hpG.1.2 (analyticAt_parameterChart D birth death hD hvalid p).contDiffAt
    (hUi (e p) hpG.2).contDiffAt hf
    (continuous_ambientLoss D birth death i j hij).measurable
    (fun _ _=>rfl) (lam:=lam) (m:=m)
  have hf0:f p=0:=by
    change ambientLoss D birth death i j hij (e p)=0
    simp only [hepoint,ambientLoss,hzero,norm_zero,zero_pow (by decide : (2:ℕ)≠0)]
  have hg0:g p=0:=by
    change normalLoss D birth death hD i j hij t=0
    simp only [normalLoss,ambientLoss,hzero,norm_zero,zero_pow (by decide : (2:ℕ)≠0)]
  obtain ⟨rho,hrho,hball⟩:=Metric.isOpen_iff.mp hVo p hpG.1.1
  have hcompare:∀ q∈Metric.ball p rho,
      (1/C)*|g q-g p|≤|f q-f p| ∧ |f q-f p|≤C*|g q-g p|:=by
    intro q hq
    have hh:=hV q (hball hq)
    have hfp:0≤f q:=sq_nonneg _
    have hgp:0≤g q:=sq_nonneg _
    rw [hg0,hf0,sub_zero,sub_zero,abs_of_nonneg hgp,abs_of_nonneg hfp]
    constructor
    · simpa only [f,g,e,normalLoss,ambientLoss,one_div,div_eq_mul_inv,mul_comm,mul_one,one_mul] using hh.1
    · exact hh.2
  have hcmp:=MAIS.AnalyticTransfer.pair_iff_of_local_comparison
    (mu:=muP) (windows:=Metric.ball p) (f:=g) (g:=f)
    (fun _ _ hab=>Metric.ball_subset_ball hab) hrho (one_div_pos.mpr hC) hC hcompare
    (lam:=lam) (m:=m)
  let q:P→L[ℝ] Normal birth death:=ContinuousLinearMap.snd ℝ _ _
  have hq:Function.Surjective q:=fun t=>⟨(0,t),rfl⟩
  have hobs:=MAIS.LinearObservationTransfer.pair_iff_surjective_observation muP muN q hq p
    (continuous_normalLoss D birth death hD i j hij).measurable (lam:=lam) (m:=m)
  rw [hepoint] at hchart
  exact hchart.symm.trans (hcmp.symm.trans hobs)

end MAIS.ActiveIntervalNearbySlice
end

/-- info: 'MAIS.ActiveIntervalNearbySlice.exists_open_pair_iff_nearby_normal' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalNearbySlice.exists_open_pair_iff_nearby_normal
end
-- ==================== end module O7.ActiveIntervalNearbySlice ====================

-- ==================== begin module O7.PurePowerCancellation (formalization/O7/PurePowerCancellation.lean) ====================
section

/-! Actual extended-real asymptotic factor cancellation against a known
pure power, plus derived nonnegativity for any uniformly bounded band. -/
set_option autoImplicit false
set_option maxHeartbeats 1200000
noncomputable section
open Set Filter
open scoped Topology ENNReal
namespace MAIS.PurePowerCancellation
open O77.Residual O77.NormalForm0906 O77.PowerLogUniqueness

/-- Cancelling an actual pure-power factor from an actual product order.
The exponent subtraction takes place in the reals. -/
theorem order_factor {V W:ℝ→ℝ≥0∞} {a b:ℝ} {k:ℕ}
    (hp:EThetaZeroPowerLog (fun eps=>V eps*W eps) a k)
    (hW:EThetaZeroPowerLog W b 0) :
    EThetaZeroPowerLog V (a-b) k := by
  have hg:EThetaZeroPowerLog (fun eps=>powerLogZero (-b) 0 eps) (-b) 0:=by
    apply order_of_exact_powerLog (c:=1) zero_lt_one ENNReal.one_lt_top zero_lt_one
    intro eps _ _
    simp only [one_mul]
  have ht:=product_order hp hg
  simp only [← sub_eq_add_neg,Nat.add_zero] at ht
  obtain ⟨c,C,e,hc,hcC,he,hee,hT⟩:=ht
  obtain ⟨d,D,f,hd,hdD,hf,hfe,hW⟩:=hW
  have hD:0<D:=hd.trans_le hdD
  have he1:e<1:=hee.trans (Real.exp_lt_one_iff.mpr (by norm_num))
  apply eThetaZeroPowerLog_of_sublevelPowerLogBounds
  refine ⟨c/D,C/d,min e f,div_pos hc hD,div_pos (hc.trans_le hcC) hd,
    lt_min he hf,(min_le_left _ _).trans_lt he1,?_⟩
  intro eps heps hsmall
  have heps1:eps≤1:=(hsmall.trans_le (min_le_left _ _)).trans he1 |>.le
  have hte:=hT eps heps (hsmall.trans_le (min_le_left _ _))
  have hwe:=hW eps heps (hsmall.trans_le (min_le_right _ _))
  have hcancel:powerLogZero b 0 eps*powerLogZero (-b) 0 eps=1:=by
    rw [powerLogZero_product heps heps1]
    simp only [add_neg_cancel,Nat.zero_add,powerLogZero_zero_zero]
  have hlo:ENNReal.ofReal d*V eps≤(V eps*W eps)*powerLogZero (-b) 0 eps:=by
    calc
      _ = V eps*(ENNReal.ofReal d*(powerLogZero b 0 eps*powerLogZero (-b) 0 eps)):=by
        rw [hcancel,mul_one,mul_comm]
      _ ≤ V eps*((W eps)*powerLogZero (-b) 0 eps):=
        by
          apply mul_le_mul' le_rfl
          have hh:=mul_le_mul' hwe.1 (le_rfl:powerLogZero (-b) 0 eps≤powerLogZero (-b) 0 eps)
          simpa only [mul_assoc] using hh
      _ = _:=by ac_rfl
  have hhi:(V eps*W eps)*powerLogZero (-b) 0 eps≤ENNReal.ofReal D*V eps:=by
    calc
      _ ≤ (V eps*(ENNReal.ofReal D*powerLogZero b 0 eps))*powerLogZero (-b) 0 eps:=
        mul_le_mul' (mul_le_mul' le_rfl hwe.2) le_rfl
      _ = V eps*(ENNReal.ofReal D*(powerLogZero b 0 eps*powerLogZero (-b) 0 eps)):=by ac_rfl
      _ = _:=by rw [hcancel,mul_one,mul_comm]
  have hDinv:ENNReal.ofReal (1/D)*ENNReal.ofReal D=1:=by
    rw [← ENNReal.ofReal_mul (le_of_lt (one_div_pos.mpr hD))]
    simp [hD.ne']
  have hdinv:ENNReal.ofReal (1/d)*ENNReal.ofReal d=1:=by
    rw [← ENNReal.ofReal_mul (le_of_lt (one_div_pos.mpr hd))]
    simp [hd.ne']
  constructor
  · calc
      ENNReal.ofReal (c/D)*powerLogZero (a-b) k eps=
          ENNReal.ofReal (1/D)*(ENNReal.ofReal c*powerLogZero (a-b) k eps):=by
        rw [← mul_assoc,← ENNReal.ofReal_mul (le_of_lt (one_div_pos.mpr hD))]
        congr 2
        ring
      _ ≤ ENNReal.ofReal (1/D)*((V eps*W eps)*powerLogZero (-b) 0 eps):=
        mul_le_mul' le_rfl hte.1
      _ ≤ ENNReal.ofReal (1/D)*(ENNReal.ofReal D*V eps):=mul_le_mul' le_rfl hhi
      _ = V eps:=by rw [← mul_assoc,hDinv,one_mul]
  · calc
      V eps=ENNReal.ofReal (1/d)*(ENNReal.ofReal d*V eps):=by rw [← mul_assoc,hdinv,one_mul]
      _ ≤ ENNReal.ofReal (1/d)*((V eps*W eps)*powerLogZero (-b) 0 eps):=
        mul_le_mul' le_rfl hlo
      _ ≤ ENNReal.ofReal (1/d)*(ENNReal.ofReal C*powerLogZero (a-b) k eps):=
        mul_le_mul' le_rfl hte.2
      _ = ENNReal.ofReal (C/d)*powerLogZero (a-b) k eps:=by
        rw [← mul_assoc,← ENNReal.ofReal_mul (le_of_lt (one_div_pos.mpr hd))]
        congr 2
        ring

/-- A genuine finite upper bound prevents a negative power exponent.
No conversion of the possibly infinite measured band itself to real occurs. -/
theorem exponent_nonneg_of_bounded {V:ℝ→ℝ≥0∞} {a:ℝ} {k:ℕ}
    (hp:EThetaZeroPowerLog V a k) {M:ℝ} (hM:0<M)
    (hbound:∀ eps,0<eps→V eps≤ENNReal.ofReal M) : 0≤a := by
  by_contra hn
  have ha:a<0:=lt_of_not_ge hn
  obtain ⟨c,C,e,hc,_,he,_,hb⟩:=hp
  have hlower:∀ᶠ t:ℝ in atTop,
      c/M≤powerLogZeroReal 0 0 (Real.exp (-t))/powerLogZeroReal a k (Real.exp (-t)):=by
    filter_upwards [eventually_gt_atTop (0:ℝ),
      Real.tendsto_exp_neg_atTop_nhds_zero.eventually (gt_mem_nhds he)] with t ht he'
    have hcross:ENNReal.ofReal c*powerLogZero a k (Real.exp (-t))≤ENNReal.ofReal M:=
      (hb _ (Real.exp_pos _) he').1.trans (hbound _ (Real.exp_pos _))
    have hreal:c*powerLogZeroReal a k (Real.exp (-t))≤M:=by
      apply (ENNReal.ofReal_le_ofReal_iff hM.le).mp
      simpa only [powerLogZero,ENNReal.ofReal_mul hc.le] using hcross
    apply (div_le_div_iff₀ hM (gauge_exp_pos a k ht)).mpr
    simpa only [powerLogZeroReal,Real.rpow_zero,pow_zero,mul_one,one_mul] using hreal
  have hvanish:=ratio_tendsto_zero_threshold ha 0 k
  have hsmall:=hvanish.eventually (gt_mem_nhds (div_pos hc hM))
  obtain ⟨t,htlo,hthi⟩:=(hlower.and hsmall).exists
  exact (not_lt_of_ge htlo) hthi

end MAIS.PurePowerCancellation
end

/-- info: 'MAIS.PurePowerCancellation.order_factor' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.PurePowerCancellation.order_factor

/-- info: 'MAIS.PurePowerCancellation.exponent_nonneg_of_bounded' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.PurePowerCancellation.exponent_nonneg_of_bounded
end
-- ==================== end module O7.PurePowerCancellation ====================

-- ==================== begin module O7.RegularSquareCancellation (formalization/O7/RegularSquareCancellation.lean) ====================
section

/-! Genuine reverse Gaussian suspension. Actual product-band inclusions
produce the residual order and finite Haar windows derive its exponent's
nonnegativity; no residual-pair existence premise is used. -/
set_option autoImplicit false
set_option maxHeartbeats 1400000
noncomputable section
open Set MeasureTheory
open scoped ENNReal
namespace MAIS.RegularSquareCancellation
open MAIS.AnalyticTransfer MAIS.PurePowerCancellation
variable {E F:Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E]
  [PseudoMetricSpace F] [MeasurableSpace F]

/-- Reverse independent-sum integration against a genuine known pure-power
factor. The centered nonnegative first germ obtains an actual measured pair;
its nonnegative exponent is derived from actual finite Haar windows. -/
theorem pair_factor_of_independent_sum
    {mu:Measure E} [Measure.IsAddHaarMeasure mu]
    {nu:Measure F} [SigmaFinite nu]
    {f:E→ℝ} {g:F→ℝ} {w:E} {v:F} {a b rho:ℝ} {m:ℕ}
    (hp:HasMeasuredBandPair (mu.prod nu) (Metric.ball (w,v))
      (fun p=>f p.1+g p.2) (w,v) a m)
    (hgp:HasMeasuredBandPair nu (Metric.ball v) g v b 1)
    (hrho:0<rho)
    (hf:∀ x∈Metric.ball w rho,0≤f x-f w)
    (hg:∀ y∈Metric.ball v rho,0≤g y-g v) :
    HasMeasuredBandPair mu (Metric.ball w) f w (a-b) m := by
  obtain ⟨_,hm,rs,hrs,hsp⟩:=hp
  obtain ⟨_,_,rg,hrg,hgp⟩:=hgp
  let r:=min rho (min rs rg)
  have hr:0<r:=lt_min hrho (lt_min hrs hrg)
  have horder:∀ R,0<R→R<r→
      O77.Residual.EThetaZeroPowerLog (bandMass mu (Metric.ball w) f w R) (a-b) (m-1):=by
    intro R hR hRr
    have hRrho:R<rho:=hRr.trans_le (min_le_left _ _)
    have hRsg:=hRr.trans_le (min_le_right _ _)
    have hS:=hsp R hR (hRsg.trans_le (min_le_left _ _))
    have hG:=hgp R hR (hRsg.trans_le (min_le_right _ _))
    have hS2:=O77.NormalForm0906.rescale_order hS (by norm_num : (0:ℝ)<2)
    have hP:O77.Residual.EThetaZeroPowerLog
        (fun eps=>bandMass mu (Metric.ball w) f w R eps*
          bandMass nu (Metric.ball v) g v R eps) a (m-1):=by
      apply O77.Transport0906.order_of_two_window_bounds hS hS2 zero_lt_one zero_lt_one
      intro eps heps
      simp only [ENNReal.ofReal_one,one_mul]
      have hfR:=fun x hx=>hf x (Metric.ball_subset_ball hRrho.le hx)
      have hgR:=fun y hy=>hg y (Metric.ball_subset_ball hRrho.le hy)
      constructor
      · exact (MAIS.RegularSquareSuspension.sum_band_bounds mu nu f g w v R eps hfR hgR).2
      · have hb:=(MAIS.RegularSquareSuspension.sum_band_bounds mu nu f g w v R (2*eps) hfR hgR).1
        simpa only [show 2*eps/2=eps by ring] using hb
    exact order_factor hP (by simpa only [Nat.sub_self] using hG)
  have hsign:0≤a-b:=by
    let R:=r/2
    have hR:0<R:=half_pos hr
    have hRr:R<r:=half_lt_self hr
    have hfin:mu (Metric.ball w R)≠⊤:=
      ((measure_mono Metric.ball_subset_closedBall).trans_lt
        (isCompact_closedBall w R).measure_lt_top).ne
    have hM:0<(mu (Metric.ball w R)).toReal+1:=by positivity
    apply exponent_nonneg_of_bounded (horder R hR hRr) hM
    intro eps _
    calc
      bandMass mu (Metric.ball w) f w R eps ≤ mu (Metric.ball w R):=by
        apply measure_mono
        intro x hx
        exact hx.1
      _ = ENNReal.ofReal (mu (Metric.ball w R)).toReal:=(ENNReal.ofReal_toReal hfin).symm
      _ ≤ ENNReal.ofReal ((mu (Metric.ball w R)).toReal+1):=
        ENNReal.ofReal_le_ofReal (by linarith)
  exact ⟨hsign,hm,r,hr,horder⟩

section Quadratic
variable {Q:Type*} [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  [FiniteDimensional ℝ Q] [MeasurableSpace Q] [BorelSpace Q]

/-- Genuine Gaussian deconvolution, including a zero-dimensional Gaussian
factor: the residual pair is proved to exist and its exponent is subtracted
in the reals. -/
theorem pair_of_quadratic_sum
    {mu:Measure E} [Measure.IsAddHaarMeasure mu]
    (nu:Measure Q) [Measure.IsAddHaarMeasure nu]
    {f:E→ℝ} {w:E} {a rho:ℝ} {m:ℕ}
    (hp:HasMeasuredBandPair (mu.prod nu) (Metric.ball (w,(0:Q)))
      (fun p=>f p.1+‖p.2‖^2) (w,0) a m)
    (hrho:0<rho) (hf:∀ x∈Metric.ball w rho,0≤f x-f w) :
    HasMeasuredBandPair mu (Metric.ball w) f w
      (a-(Module.finrank ℝ Q:ℝ)/2) m := by
  apply pair_factor_of_independent_sum hp
    (MAIS.RegularSquareSuspension.quadratic_pair nu) hrho hf
  intro y _
  simp only [norm_zero,zero_pow (by decide : (2:ℕ)≠0),sub_zero]
  positivity

/-- The same reverse theorem for an actual positively scaled quadratic
block; the scale is not an assumed volume or exponent witness. -/
theorem pair_of_scaled_quadratic_sum
    {mu:Measure E} [Measure.IsAddHaarMeasure mu]
    (nu:Measure Q) [Measure.IsAddHaarMeasure nu]
    {f:E→ℝ} {w:E} {a rho:ℝ} {m:ℕ}
    (c:ℝ) (hc:0<c)
    (hp:HasMeasuredBandPair (mu.prod nu) (Metric.ball (w,(0:Q)))
      (fun p=>f p.1+c*‖p.2‖^2) (w,0) a m)
    (hrho:0<rho) (hf:∀ x∈Metric.ball w rho,0≤f x-f w) :
    HasMeasuredBandPair mu (Metric.ball w) f w
      (a-(Module.finrank ℝ Q:ℝ)/2) m := by
  apply pair_factor_of_independent_sum hp
    (MAIS.RegularSquareSuspension.quadratic_pair_scaled nu c hc) hrho hf
  intro y _
  simp only [norm_zero,zero_pow (by decide : (2:ℕ)≠0),mul_zero,sub_zero]
  positivity
end Quadratic
end MAIS.RegularSquareCancellation
end

/-- info: 'MAIS.RegularSquareCancellation.pair_factor_of_independent_sum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.RegularSquareCancellation.pair_factor_of_independent_sum

/-- info: 'MAIS.RegularSquareCancellation.pair_of_quadratic_sum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.RegularSquareCancellation.pair_of_quadratic_sum

/-- info: 'MAIS.RegularSquareCancellation.pair_of_scaled_quadratic_sum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.RegularSquareCancellation.pair_of_scaled_quadratic_sum
end
-- ==================== end module O7.RegularSquareCancellation ====================

-- ==================== begin module O7.ActiveIntervalEndpointRows (formalization/O7/ActiveIntervalEndpointRows.lean) ====================
section

/-! Actual endpoint row and column isolation in the physical entrance slice.
An interval born at the initial vertex has no incoming normal arrow; an
interval surviving the last vertex has no outgoing normal arrow. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000

namespace MAIS.ActiveIntervalEndpointRows

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.MatrixChainIsomorphism
open scoped Matrix
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

noncomputable def normalFamily (t : NormalParams birth death) :
    MAIS.QuiverRealOrbit.Rep (Index D birth death) :=
  MAIS.ActiveIntervalDifferential.intervalRep D birth death +
    MAIS.ActiveIntervalNormal.normalInjection D birth death hD t

omit [Fintype S] in
theorem normalFamily_row_birth_zero (t : NormalParams birth death) (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc)
    (hr : birth r.val = 0) :
    normalFamily D birth death hD t e r s = if r.val = s.val then 1 else 0 := by
  have hn : ¬ Linked birth death r.val s.val := by
    intro h
    have := h.1
    omega
  simp only [normalFamily, Pi.add_apply, Matrix.add_apply,
    MAIS.ActiveIntervalDifferential.intervalRep,
    MAIS.ActiveIntervalNormal.normalInjection_apply, dite_eq_right hn, add_zero]

omit [Fintype S] in
theorem normalFamily_column_death_last (t : NormalParams birth death) (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc)
    (hs : death s.val = D + 1) :
    normalFamily D birth death hD t e r s = if r.val = s.val then 1 else 0 := by
  have hn : ¬ Linked birth death r.val s.val := by
    intro h
    have := h.2.2
    have := hD r.val
    omega
  simp only [normalFamily, Pi.add_apply, Matrix.add_apply,
    MAIS.ActiveIntervalDifferential.intervalRep,
    MAIS.ActiveIntervalNormal.normalInjection_apply, dite_eq_right hn, add_zero]

/-- A literal path row for a slot born at zero is the corresponding coordinate
    row, even though all other normal coordinates are arbitrary. -/
theorem pathMatrix_row_birth_zero (t : NormalParams birth death)
    (i j : Fin (D + 1)) (hij : i ≤ j)
    (r : Index D birth death j) (s : Index D birth death i)
    (hr : birth r.val = 0) :
    pathMatrix (normalFamily D birth death hD t) i j hij r s =
      if r.val = s.val then 1 else 0 := by
  induction j using Fin.induction generalizing i with
  | zero =>
    have hi : i = 0 := le_antisymm hij (by exact Nat.zero_le i.val)
    subst i
    simp only [pathMatrix_self, Matrix.one_apply, Subtype.ext_iff]
  | succ e ih =>
    by_cases hi : i = e.succ
    · subst i
      simp only [pathMatrix_self, Matrix.one_apply, Subtype.ext_iff]
    · have hie : i ≤ e.castSucc := by
        change i.val ≤ e.val
        have h := hij
        change i.val ≤ e.val + 1 at h
        have hn : i.val ≠ e.val + 1 := fun h => hi (Fin.ext h)
        omega
      let k₀ : Index D birth death e.castSucc := ⟨r.val, by
        rcases r.property with ⟨hb, hd⟩
        change birth r.val ≤ e.val ∧ e.val < death r.val
        change e.val + 1 < death r.val at hd
        omega⟩
      rw [pathMatrix_step _ i e hie, Matrix.mul_apply]
      rw [Finset.sum_eq_single k₀]
      · rw [normalFamily_row_birth_zero D birth death hD t e r k₀ hr]
        simp only [show r.val = k₀.val from rfl, ite_true, one_mul]
        exact ih i hie k₀ s hr
      · intro k _ hk
        have hv : r.val ≠ k.val := by
          intro h
          apply hk
          apply Subtype.ext
          exact h.symm
        rw [normalFamily_row_birth_zero D birth death hD t e r k hr,
          ite_eq_right hv, zero_mul]
      · simp

/-- A literal path column for a slot surviving the last vertex is the
    corresponding coordinate column, at every pair of intermediate vertices. -/
theorem pathMatrix_column_death_last (t : NormalParams birth death)
    (i j : Fin (D + 1)) (hij : i ≤ j)
    (r : Index D birth death j) (s : Index D birth death i)
    (hs : death s.val = D + 1) :
    pathMatrix (normalFamily D birth death hD t) i j hij r s =
      if r.val = s.val then 1 else 0 := by
  induction j using Fin.induction generalizing i with
  | zero =>
    have hi : i = 0 := le_antisymm hij (by exact Nat.zero_le i.val)
    subst i
    simp only [pathMatrix_self, Matrix.one_apply, Subtype.ext_iff]
  | succ e ih =>
    by_cases hi : i = e.succ
    · subst i
      simp only [pathMatrix_self, Matrix.one_apply, Subtype.ext_iff]
    · have hie : i ≤ e.castSucc := by
        change i.val ≤ e.val
        have h := hij
        change i.val ≤ e.val + 1 at h
        have hn : i.val ≠ e.val + 1 := fun h => hi (Fin.ext h)
        omega
      let k₀ : Index D birth death e.castSucc := ⟨s.val, by
        rcases s.property with ⟨hb, hd⟩
        change birth s.val ≤ e.val ∧ e.val < death s.val
        change birth s.val ≤ i.val at hb
        have he := e.isLt
        change i.val ≤ e.val at hie
        omega⟩
      rw [pathMatrix_step _ i e hie, Matrix.mul_apply]
      have hsum : (∑ k, normalFamily D birth death hD t e r k *
          pathMatrix (normalFamily D birth death hD t) i e.castSucc hie k s) =
          normalFamily D birth death hD t e r k₀ := by
        rw [Finset.sum_eq_single k₀]
        · rw [ih i hie k₀ s hs]
          simp only [show k₀.val = s.val from rfl, ite_true, mul_one]
        · intro k _ hk
          have hv : k.val ≠ s.val := by
            intro h
            apply hk
            apply Subtype.ext
            exact h
          rw [ih i hie k s hs, ite_eq_right hv, mul_zero]
        · simp
      rw [hsum, normalFamily_column_death_last D birth death hD t e r k₀ hs]

end MAIS.ActiveIntervalEndpointRows
end
-- ==================== end module O7.ActiveIntervalEndpointRows ====================

-- ==================== begin module O7.MatrixPathLocality (formalization/O7/MatrixPathLocality.lean) ====================
section

/-! Locality and exact single-arrow replacement for actual finite rectangular
matrix-chain path products. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

universe u
namespace MAIS.MatrixPathLocality

open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open scoped Matrix
variable {D : ℕ} {I : Fin (D + 1) → Type u}
variable [∀ v, Fintype (I v)] [∀ v, DecidableEq (I v)]

/-- Actual path products use only the actual arrows in their interval. -/
theorem pathMatrix_congr_of_eq_arrows (A B : Rep I)
    (i j : Fin (D + 1)) (hij : i ≤ j)
    (h : ∀ e : Fin D, i ≤ e.castSucc → e.succ ≤ j → A e = B e) :
    pathMatrix A i j hij = pathMatrix B i j hij := by
  induction j using Fin.induction generalizing i with
  | zero =>
    have hi : i = 0 := le_antisymm hij (by exact Nat.zero_le i.val)
    subst i
    rw [pathMatrix_self, pathMatrix_self]
  | succ e ih =>
    by_cases hi : i = e.succ
    · subst i
      rw [pathMatrix_self, pathMatrix_self]
    · have hie : i ≤ e.castSucc := by
        change i.val ≤ e.val
        have hle : i.val ≤ e.val + 1 := hij
        have hn : i.val ≠ e.val + 1 := fun h => hi (Fin.ext h)
        omega
      rw [pathMatrix_step A i e hie, pathMatrix_step B i e hie, h e hie le_rfl]
      congr 1
      apply ih i hie
      intro k hik hke
      exact h k hik (hke.trans (by exact Nat.le_succ e.val))

/-- Literal factorization through any one of the actual arrows in a path. -/
theorem pathMatrix_factor_arrow (A : Rep I) (i j : Fin (D + 1))
    (hij : i ≤ j) (e : Fin D) (hie : i ≤ e.castSucc) (hej : e.succ ≤ j) :
    pathMatrix A i j hij =
      pathMatrix A e.succ j hej * A e * pathMatrix A i e.castSucc hie := by
  have his : i ≤ e.succ := hie.trans (by exact Nat.le_succ e.val)
  rw [← pathMatrix_comp A i e.succ j his hej, pathMatrix_step A i e hie]
  rw [Matrix.mul_assoc]

/-- Exact finite product replacement at one actual arrow, with every other
    arrow unchanged.  No derivative or limiting argument occurs. -/
theorem pathMatrix_single_arrow_change (A B : Rep I) (e : Fin D)
    (h : ∀ k : Fin D, k ≠ e → A k = B k)
    (i j : Fin (D + 1)) (hij : i ≤ j)
    (hie : i ≤ e.castSucc) (hej : e.succ ≤ j) :
    pathMatrix A i j hij = pathMatrix B i j hij +
      pathMatrix B e.succ j hej * (A e - B e) *
        pathMatrix B i e.castSucc hie := by
  have hl : pathMatrix A e.succ j hej = pathMatrix B e.succ j hej := by
    apply pathMatrix_congr_of_eq_arrows
    intro k hek _
    apply h k
    intro hk
    subst k
    have hh : e.val + 1 ≤ e.val := hek
    omega
  have hr : pathMatrix A i e.castSucc hie = pathMatrix B i e.castSucc hie := by
    apply pathMatrix_congr_of_eq_arrows
    intro k _ hke
    apply h k
    intro hk
    subst k
    have hh : e.val + 1 ≤ e.val := hke
    omega
  rw [pathMatrix_factor_arrow A i j hij e hie hej,
    pathMatrix_factor_arrow B i j hij e hie hej, hl, hr,
    Matrix.mul_sub, Matrix.sub_mul]
  abel

end MAIS.MatrixPathLocality
end
-- ==================== end module O7.MatrixPathLocality ====================

-- ==================== begin module O7.ActiveIntervalDirectUpdate (formalization/O7/ActiveIntervalDirectUpdate.lean) ====================
section

/-! Exact global endpoint response to a direct input-to-output entrance
parameter, retaining every other normal parameter and all nonlinear terms. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000

namespace MAIS.ActiveIntervalDirectUpdate

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalEndpointRows MAIS.MatrixChainIsomorphism MAIS.MatrixPathLocality
open scoped Matrix
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- The actual physical entrance arrow associated to a linked pair. -/
def entranceArrow (p : NormalIndex birth death) : Fin D :=
  ⟨birth p.val.1 - 1, by
    have h := p.property
    change birth p.val.2 < birth p.val.1 ∧ birth p.val.1 ≤ death p.val.2 ∧
      death p.val.2 < death p.val.1 at h
    have := hD p.val.1
    omega⟩

omit [Fintype S] [DecidableEq S] in
@[simp]
theorem entranceArrow_output (p : NormalIndex birth death) :
    (entranceArrow D birth death hD p).val + 1 = birth p.val.1 := by
  have h := p.property.1
  change birth p.val.1 - 1 + 1 = birth p.val.1
  omega

/-- Actual affine matrix response to a single scalar normal-coordinate update. -/
theorem normalFamily_basis_update (t : NormalParams birth death)
    (p : NormalIndex birth death) (τ : ℝ) :
    normalFamily D birth death hD (t + τ • Pi.single p 1) =
      normalFamily D birth death hD t + τ •
        ((MAIS.ActiveIntervalNormal.normalBasis D birth death hD) p :
          MAIS.QuiverRealOrbit.Rep (Index D birth death)) := by
  rw [MAIS.ActiveIntervalNormal.normalBasis_apply_coe]
  unfold normalFamily
  rw [map_add, map_smul]
  abel

/-- The selected basis vector vanishes at every other actual arrow. -/
theorem normalBasis_other_arrow (p : NormalIndex birth death) (k : Fin D)
    (hk : k ≠ entranceArrow D birth death hD p) :
    ((MAIS.ActiveIntervalNormal.normalBasis D birth death hD) p :
      MAIS.QuiverRealOrbit.Rep (Index D birth death)) k = 0 := by
  ext r s
  rw [MAIS.ActiveIntervalNormal.normalBasis_entry]
  have hn : k.val + 1 ≠ birth p.val.1 := by
    intro h
    apply hk
    apply Fin.ext
    have he := entranceArrow_output D birth death hD p
    omega
  simp only [hn, and_false, ite_false, Matrix.zero_apply]

private theorem sandwich_single {α β γ δ : Type*}
    [Fintype β] [Fintype γ] [DecidableEq β] [DecidableEq γ]
    (L : Matrix α β ℝ) (R : Matrix γ δ ℝ) (r : β) (s : γ) (τ : ℝ)
    (a : α) (b : δ) :
    (L * Matrix.single r s τ * R) a b = L a r * τ * R s b := by
  rw [Matrix.mul_apply, Finset.sum_eq_single s]
  · rw [Matrix.mul_single_apply_same]
  · intro k _ hk
    rw [Matrix.mul_single_apply_of_ne τ r s a k hk L, zero_mul]
  · simp

/-- Updating one direct input-to-output normal variable changes the full
    literal product by exactly its output matrix unit, globally in all other
    normal variables.  This is the exact triangular-elimination identity. -/
theorem fullProduct_direct_update (t : NormalParams birth death)
    (p : NormalIndex birth death) (τ : ℝ)
    (hin : birth p.val.2 = 0) (hout : death p.val.1 = D + 1)
    (r : Index D birth death (Fin.last D)) (s : Index D birth death 0) :
    pathMatrix (normalFamily D birth death hD (t + τ • Pi.single p 1))
        0 (Fin.last D) (by exact Nat.zero_le D) r s =
      pathMatrix (normalFamily D birth death hD t)
        0 (Fin.last D) (by exact Nat.zero_le D) r s +
        if r.val = p.val.1 ∧ s.val = p.val.2 then τ else 0 := by
  let e := entranceArrow D birth death hD p
  have he : e.val + 1 = birth p.val.1 := entranceArrow_output D birth death hD p
  have hp := p.property
  change birth p.val.2 < birth p.val.1 ∧ birth p.val.1 ≤ death p.val.2 ∧
    death p.val.2 < death p.val.1 at hp
  let re : Index D birth death e.succ := ⟨p.val.1, by
    change birth p.val.1 ≤ e.val + 1 ∧ e.val + 1 < death p.val.1
    omega⟩
  let se : Index D birth death e.castSucc := ⟨p.val.2, by
    change birth p.val.2 ≤ e.val ∧ e.val < death p.val.2
    omega⟩
  have hb : ((MAIS.ActiveIntervalNormal.normalBasis D birth death hD) p :
      MAIS.QuiverRealOrbit.Rep (Index D birth death)) e = Matrix.single re se 1 := by
    ext u v
    rw [MAIS.ActiveIntervalNormal.normalBasis_entry, Matrix.single_apply]
    simp only [he, and_true, Subtype.ext_iff, show re.val = p.val.1 from rfl,
      show se.val = p.val.2 from rfl, eq_comm]
  have hoff : ∀ k : Fin D, k ≠ e →
      normalFamily D birth death hD (t + τ • Pi.single p 1) k =
        normalFamily D birth death hD t k := by
    intro k hk
    rw [normalFamily_basis_update]
    change normalFamily D birth death hD t k + τ •
      (((MAIS.ActiveIntervalNormal.normalBasis D birth death hD) p :
        MAIS.QuiverRealOrbit.Rep (Index D birth death)) k) = _
    rw [normalBasis_other_arrow D birth death hD p k hk, smul_zero, add_zero]
  have hd : normalFamily D birth death hD (t + τ • Pi.single p 1) e -
      normalFamily D birth death hD t e = Matrix.single re se τ := by
    rw [normalFamily_basis_update]
    change (normalFamily D birth death hD t e + τ •
      (((MAIS.ActiveIntervalNormal.normalBasis D birth death hD) p :
        MAIS.QuiverRealOrbit.Rep (Index D birth death)) e)) - _ = _
    rw [add_sub_cancel_left, hb, Matrix.smul_single, smul_eq_mul, mul_one]
  have hchange := pathMatrix_single_arrow_change
    (normalFamily D birth death hD (t + τ • Pi.single p 1))
    (normalFamily D birth death hD t) e hoff 0 (Fin.last D)
    (by exact Nat.zero_le D) (by exact Nat.zero_le e.val) (by exact Nat.succ_le_of_lt e.isLt)
  rw [hd] at hchange
  have hentry := congrFun (congrFun hchange r) s
  rw [Matrix.add_apply, sandwich_single,
    pathMatrix_column_death_last D birth death hD t e.succ (Fin.last D)
      (by exact Nat.succ_le_of_lt e.isLt) r re hout,
    pathMatrix_row_birth_zero D birth death hD t 0 e.castSucc
      (by exact Nat.zero_le e.val) se s hin] at hentry
  convert hentry using 1
  by_cases hr : r.val = p.val.1 <;> by_cases hs : s.val = p.val.2 <;>
    simp [hr, hs, eq_comm, re, se]

end MAIS.ActiveIntervalDirectUpdate
end
-- ==================== end module O7.ActiveIntervalDirectUpdate ====================

-- ==================== begin module O7.ActiveIntervalDirectElimination (formalization/O7/ActiveIntervalDirectElimination.lean) ====================
section

/-! Simultaneous exact elimination of all actual direct endpoint entrance
variables.  The coordinate change is explicitly globally invertible. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000

namespace MAIS.ActiveIntervalDirectElimination

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalEndpointRows MAIS.ActiveIntervalDirectUpdate
open MAIS.MatrixChainIsomorphism
open scoped Matrix
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

def IsDirect (p : NormalIndex birth death) : Prop :=
  birth p.val.2 = 0 ∧ death p.val.1 = D + 1

instance isDirect_decidable (p : NormalIndex birth death) : Decidable (IsDirect D birth death p) := by
  unfold IsDirect
  infer_instance

noncomputable def fullProduct (t : NormalParams birth death) :
    Matrix (Index D birth death (Fin.last D)) (Index D birth death 0) ℝ :=
  pathMatrix (normalFamily D birth death hD t) 0 (Fin.last D) (by exact Nat.zero_le D)

noncomputable def directProjection : NormalParams birth death →ₗ[ℝ] NormalParams birth death where
  toFun t p := if IsDirect D birth death p then t p else 0
  map_add' t u := by ext p; by_cases h : IsDirect D birth death p <;> simp [h]
  map_smul' τ t := by ext p; by_cases h : IsDirect D birth death p <;> simp [h]

noncomputable def residualProjection : NormalParams birth death →ₗ[ℝ] NormalParams birth death :=
  LinearMap.id - directProjection D birth death

omit [Fintype S] [DecidableEq S] in
@[simp]
theorem residualProjection_apply (t : NormalParams birth death) (p : NormalIndex birth death) :
    residualProjection D birth death t p = if IsDirect D birth death p then 0 else t p := by
  by_cases h : IsDirect D birth death p <;> simp [residualProjection, directProjection, h]

omit [Fintype S] [DecidableEq S] in
theorem residual_add_direct (t : NormalParams birth death) :
    residualProjection D birth death t + directProjection D birth death t = t := by
  ext p
  by_cases h : IsDirect D birth death p <;> simp [directProjection, h]

/-- The actual endpoint injection has one entry for each linked endpoint pair. -/
noncomputable def endpointInjection : NormalParams birth death →ₗ[ℝ]
    Matrix (Index D birth death (Fin.last D)) (Index D birth death 0) ℝ where
  toFun t r s := if h : Linked birth death r.val s.val then t ⟨(r.val, s.val), h⟩ else 0
  map_add' t u := by ext r s; by_cases h : Linked birth death r.val s.val <;> simp [h]
  map_smul' τ t := by ext r s; by_cases h : Linked birth death r.val s.val <;> simp [h]

include hD in
omit [Fintype S] [DecidableEq S] in
theorem endpointPair_isDirect
    (r : Index D birth death (Fin.last D)) (s : Index D birth death 0)
    (h : Linked birth death r.val s.val) :
    IsDirect D birth death ⟨(r.val, s.val), h⟩ := by
  have hin := s.property.1
  have hout := r.property.2
  have hd := hD r.val
  change birth s.val ≤ 0 at hin
  change D < death r.val at hout
  change birth s.val = 0 ∧ death r.val = D + 1
  omega

private theorem fullProduct_sum_direct (U : Finset (NormalIndex birth death))
    (v : NormalParams birth death)
    (hv : ∀ p, ¬ IsDirect D birth death p → v p = 0)
    (t : NormalParams birth death)
    (r : Index D birth death (Fin.last D)) (s : Index D birth death 0) :
    fullProduct D birth death hD (t + ∑ p ∈ U, v p • Pi.single p 1) r s =
      fullProduct D birth death hD t r s +
        ∑ p ∈ U, if r.val = p.val.1 ∧ s.val = p.val.2 then v p else 0 := by
  classical
  induction U using Finset.induction_on with
  | empty => simp
  | @insert p U hp ih =>
    rw [Finset.sum_insert hp, Finset.sum_insert hp]
    rw [show t + (v p • Pi.single p 1 + ∑ q ∈ U, v q • Pi.single q 1) =
      (t + ∑ q ∈ U, v q • Pi.single q 1) + v p • Pi.single p 1 by abel]
    by_cases hd : IsDirect D birth death p
    · have h : fullProduct D birth death hD
          ((t + ∑ q ∈ U, v q • Pi.single q 1) + v p • Pi.single p 1) r s =
          fullProduct D birth death hD (t + ∑ q ∈ U, v q • Pi.single q 1) r s +
            if r.val = p.val.1 ∧ s.val = p.val.2 then v p else 0 :=
        fullProduct_direct_update D birth death hD
          (t + ∑ q ∈ U, v q • Pi.single q 1) p (v p) hd.1 hd.2 r s
      rw [h, ih]
      abel
    · rw [hv p hd]
      simp only [zero_smul, add_zero, ite_self, zero_add]
      exact ih

/-- Exact simultaneous response to any direct-coordinate increment. -/
theorem fullProduct_add_directProjection (t v : NormalParams birth death) :
    fullProduct D birth death hD (t + directProjection D birth death v) =
      fullProduct D birth death hD t + endpointInjection D birth death v := by
  classical
  ext r s
  have hv : ∀ p, ¬ IsDirect D birth death p → directProjection D birth death v p = 0 := by
    intro p hp
    simp [directProjection, hp]
  have h := fullProduct_sum_direct D birth death hD Finset.univ
    (directProjection D birth death v) hv t r s
  rw [← pi_eq_sum_univ' (directProjection D birth death v)] at h
  rw [h]
  change _ = fullProduct D birth death hD t r s +
    if hp : Linked birth death r.val s.val then v ⟨(r.val, s.val), hp⟩ else 0
  congr 1
  by_cases hl : Linked birth death r.val s.val
  · let p₀ : NormalIndex birth death := ⟨(r.val, s.val), hl⟩
    rw [dite_eq_left hl, Finset.sum_eq_single p₀]
    · simp [p₀, directProjection, endpointPair_isDirect D birth death hD r s hl]
    · intro p _ hp
      have hn : ¬ (r.val = p.val.1 ∧ s.val = p.val.2) := by
        rintro ⟨h1, h2⟩
        apply hp
        apply Subtype.ext
        exact Prod.ext h1.symm h2.symm
      rw [ite_eq_right hn]
    · simp
  · rw [dite_eq_right hl]
    apply Finset.sum_eq_zero
    intro p _
    have hn : ¬ (r.val = p.val.1 ∧ s.val = p.val.2) := by
      rintro ⟨h1, h2⟩
      apply hl
      simpa only [h1, h2] using p.property
    rw [ite_eq_right hn]

/-- The complete path map is its residual path map plus the actual independent
    direct endpoint matrix. -/
theorem fullProduct_direct_decomposition (t : NormalParams birth death) :
    fullProduct D birth death hD t =
      fullProduct D birth death hD (residualProjection D birth death t) +
        endpointInjection D birth death t := by
  have h := fullProduct_add_directProjection D birth death hD
    (residualProjection D birth death t) t
  rw [residual_add_direct] at h
  exact h

/-- The actual endpoint row belonging to a direct linked pair. -/
def directOutput (p : NormalIndex birth death) (hp : IsDirect D birth death p) :
    Index D birth death (Fin.last D) :=
  ⟨p.val.1, by
    have h := p.property
    change birth p.val.2 < birth p.val.1 ∧ birth p.val.1 ≤ death p.val.2 ∧
      death p.val.2 < death p.val.1 at h
    change birth p.val.1 ≤ D ∧ D < death p.val.1
    rcases hp with ⟨_, hd⟩
    omega⟩

/-- The actual endpoint column belonging to a direct linked pair. -/
def directInput (p : NormalIndex birth death) (hp : IsDirect D birth death p) :
    Index D birth death 0 :=
  ⟨p.val.2, by
    have h := p.property
    change birth p.val.2 < birth p.val.1 ∧ birth p.val.1 ≤ death p.val.2 ∧
      death p.val.2 < death p.val.1 at h
    change birth p.val.2 ≤ 0 ∧ 0 < death p.val.2
    rcases hp with ⟨hb, _⟩
    omega⟩

/-- Nonlinear corrections use only the residual coordinates and only alter
    direct coordinates.  Their entries are actual full product entries. -/
noncomputable def directResidual (t : NormalParams birth death) : NormalParams birth death := fun p =>
  if hp : IsDirect D birth death p then
    fullProduct D birth death hD (residualProjection D birth death t)
      (directOutput D birth death p hp) (directInput D birth death p hp)
  else 0

theorem residualProjection_directResidual (t : NormalParams birth death) :
    residualProjection D birth death (directResidual D birth death hD t) = 0 := by
  ext p
  by_cases hp : IsDirect D birth death p <;>
    simp [residualProjection_apply, directResidual, hp]

theorem directResidual_congr {t u : NormalParams birth death}
    (h : residualProjection D birth death t = residualProjection D birth death u) :
    directResidual D birth death hD t = directResidual D birth death hD u := by
  funext p
  unfold directResidual
  split_ifs
  · rw [h]
  · rfl

theorem residualProjection_add_directResidual (t : NormalParams birth death) :
    residualProjection D birth death (t + directResidual D birth death hD t) =
      residualProjection D birth death t := by
  rw [map_add, residualProjection_directResidual, add_zero]

theorem residualProjection_sub_directResidual (t : NormalParams birth death) :
    residualProjection D birth death (t - directResidual D birth death hD t) =
      residualProjection D birth death t := by
  rw [map_sub, residualProjection_directResidual, sub_zero]

theorem directResidual_add (t : NormalParams birth death) :
    directResidual D birth death hD (t + directResidual D birth death hD t) =
      directResidual D birth death hD t :=
  directResidual_congr D birth death hD (residualProjection_add_directResidual D birth death hD t)

theorem directResidual_sub (t : NormalParams birth death) :
    directResidual D birth death hD (t - directResidual D birth death hD t) =
      directResidual D birth death hD t :=
  directResidual_congr D birth death hD (residualProjection_sub_directResidual D birth death hD t)

/-- Explicit global triangular change of the actual independent parameters.
    Its inverse subtracts exactly the same residual correction. -/
noncomputable def normalElimination : NormalParams birth death ≃ NormalParams birth death where
  toFun t := t + directResidual D birth death hD t
  invFun u := u - directResidual D birth death hD u
  left_inv t := by
    change (t + directResidual D birth death hD t) -
      directResidual D birth death hD (t + directResidual D birth death hD t) = t
    rw [directResidual_add]
    abel
  right_inv u := by
    change (u - directResidual D birth death hD u) +
      directResidual D birth death hD (u - directResidual D birth death hD u) = u
    rw [directResidual_sub]
    abel

/-- The exact remaining output entries, with linked endpoint entries replaced
    by genuinely independent coordinate variables. -/
noncomputable def reducedFullProduct (u : NormalParams birth death) :
    Matrix (Index D birth death (Fin.last D)) (Index D birth death 0) ℝ := fun r s =>
  if hp : Linked birth death r.val s.val then u ⟨(r.val, s.val), hp⟩ else
    fullProduct D birth death hD (residualProjection D birth death u) r s

theorem fullProduct_eq_reduced_after_elimination (t : NormalParams birth death) :
    fullProduct D birth death hD t =
      reducedFullProduct D birth death hD (normalElimination D birth death hD t) := by
  ext r s
  have h := congrFun (congrFun (fullProduct_direct_decomposition D birth death hD t) r) s
  change fullProduct D birth death hD t r s =
    fullProduct D birth death hD (residualProjection D birth death t) r s +
      (endpointInjection D birth death t) r s at h
  change _ = if hp : Linked birth death r.val s.val then
      (normalElimination D birth death hD t) ⟨(r.val, s.val), hp⟩ else _
  by_cases hl : Linked birth death r.val s.val
  · rw [dite_eq_left hl]
    let p : NormalIndex birth death := ⟨(r.val, s.val), hl⟩
    have hd : IsDirect D birth death p := endpointPair_isDirect D birth death hD r s hl
    have hG : directResidual D birth death hD t p =
        fullProduct D birth death hD (residualProjection D birth death t) r s := by
      rw [directResidual, dite_eq_left hd]
      congr 2
    change _ = t p + directResidual D birth death hD t p
    rw [hG]
    have hE : endpointInjection D birth death t r s = t p := by
      change (if h : Linked birth death r.val s.val then t ⟨(r.val,s.val),h⟩ else 0) = t p
      rw [dite_eq_left hl]
    rw [hE] at h
    exact h.trans (add_comm _ _)
  · rw [dite_eq_right hl]
    change _ = fullProduct D birth death hD
      (residualProjection D birth death (t + directResidual D birth death hD t)) r s
    rw [residualProjection_add_directResidual]
    have hE : endpointInjection D birth death t r s = 0 := by
      change (if h : Linked birth death r.val s.val then t ⟨(r.val,s.val),h⟩ else 0) = 0
      rw [dite_eq_right hl]
    simpa only [hE, add_zero] using h

/-- Exact normal form after the explicit inverse parameter change. -/
theorem fullProduct_after_elimination (u : NormalParams birth death) :
    fullProduct D birth death hD ((normalElimination D birth death hD).symm u) =
      reducedFullProduct D birth death hD u := by
  rw [fullProduct_eq_reduced_after_elimination, Equiv.apply_symm_apply]

end MAIS.ActiveIntervalDirectElimination
end
-- ==================== end module O7.ActiveIntervalDirectElimination ====================

-- ==================== begin module O7.MvPolynomialAnalyticEval (formalization/O7/MvPolynomialAnalyticEval.lean) ====================
section

/-! Literal real multivariate polynomial evaluation is real analytic. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
namespace MAIS.MvPolynomialAnalyticEval

variable {σ : Type*} [Fintype σ]

theorem analyticAt_eval (P : MvPolynomial σ ℝ) (t : σ → ℝ) :
    AnalyticAt ℝ (fun x : σ → ℝ => MvPolynomial.eval x P) t := by
  induction P using MvPolynomial.induction_on with
  | C c => simpa only [MvPolynomial.eval_C] using (analyticAt_const (v := c) (x := t))
  | add p q hp hq =>
    convert hp.add hq using 1
    funext x
    exact map_add (MvPolynomial.eval x) p q
  | mul_X p i hp =>
    convert hp.mul ((ContinuousLinearMap.proj (R := ℝ) i).analyticAt t) using 1 <;> try rfl
    funext x
    simp only [map_mul, MvPolynomial.eval_X, Pi.mul_apply, ContinuousLinearMap.proj_apply]

end MAIS.MvPolynomialAnalyticEval
end
-- ==================== end module O7.MvPolynomialAnalyticEval ====================

-- ==================== begin module O7.ActiveIntervalEliminationChart (formalization/O7/ActiveIntervalEliminationChart.lean) ====================
section

/-! The exact direct-variable elimination is a genuine global analytic
coordinate change, with analytic inverse and fixed center zero. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000

namespace MAIS.ActiveIntervalEliminationChart

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalDirectElimination MAIS.ActiveIntervalEndpointRows
open MAIS.ActiveIntervalPathPolynomial MAIS.MvPolynomialAnalyticEval
open MAIS.ActiveIntervalBasePaths
open scoped Matrix Matrix.Norms.Elementwise
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- Analyticity of the literal complete path map follows from its exact full
    multivariate polynomial, not a truncated expansion. -/
theorem analyticAt_fullProduct (t : NormalParams birth death) :
    AnalyticAt ℝ (fullProduct D birth death hD) t := by
  apply AnalyticAt.pi
  intro r
  apply AnalyticAt.pi
  intro s
  convert analyticAt_eval (pathPolynomial D birth death (Fin.last D) r s) t using 1 <;> try rfl
  funext x
  exact (eval_pathPolynomial_entry D birth death hD x (Fin.last D) r s).symm

theorem analyticAt_directResidual (t : NormalParams birth death) :
    AnalyticAt ℝ (directResidual D birth death hD) t := by
  apply AnalyticAt.pi
  intro p
  by_cases hp : IsDirect D birth death p
  · have h := analyticAt_fullProduct D birth death hD (residualProjection D birth death t)
    have hentry := (analyticAt_pi_iff.mp (analyticAt_pi_iff.mp h
      (directOutput D birth death p hp))) (directInput D birth death p hp)
    have hc := hentry.comp ((residualProjection D birth death).toContinuousLinearMap.analyticAt t)
    simp only [directResidual, dite_eq_left hp]
    convert hc using 1
    rfl
  · simpa only [directResidual, dite_eq_right hp] using
      (analyticAt_const (v := (0 : ℝ)) (x := t))

theorem analyticAt_normalElimination (t : NormalParams birth death) :
    AnalyticAt ℝ (normalElimination D birth death hD) t := by
  convert analyticAt_id.add (analyticAt_directResidual D birth death hD t) using 1
  rfl

theorem analyticAt_normalElimination_symm (u : NormalParams birth death) :
    AnalyticAt ℝ (normalElimination D birth death hD).symm u := by
  convert analyticAt_id.sub (analyticAt_directResidual D birth death hD u) using 1
  rfl

/-- The explicit global parameter equivalence is an actual homeomorphism. -/
noncomputable def eliminationHomeomorph :
    NormalParams birth death ≃ₜ NormalParams birth death where
  toEquiv := normalElimination D birth death hD
  continuous_toFun := continuous_iff_continuousAt.mpr
    (fun t => (analyticAt_normalElimination D birth death hD t).continuousAt)
  continuous_invFun := continuous_iff_continuousAt.mpr
    (fun u => (analyticAt_normalElimination_symm D birth death hD u).continuousAt)

/-- The triangular correction vanishes at zero because distinct interval
    slots never acquire an off-diagonal base path entry. -/
theorem directResidual_zero : directResidual D birth death hD 0 = 0 := by
  funext p
  by_cases hp : IsDirect D birth death p
  · rw [directResidual, dite_eq_left hp, map_zero]
    unfold fullProduct normalFamily
    rw [map_zero, add_zero, pathMatrix_intervalRep_entry]
    have hn : (directOutput D birth death p hp).val ≠
        (directInput D birth death p hp).val := by
      change p.val.1 ≠ p.val.2
      intro h
      have hh := p.property.1
      rw [h] at hh
      exact (Nat.lt_irrefl _ hh)
    rw [ite_eq_right hn]
    rfl
  · rw [directResidual, dite_eq_right hp]
    rfl

@[simp]
theorem normalElimination_zero : normalElimination D birth death hD 0 = 0 := by
  change 0 + directResidual D birth death hD 0 = 0
  rw [directResidual_zero, add_zero]

@[simp]
theorem normalElimination_symm_zero : (normalElimination D birth death hD).symm 0 = 0 := by
  change 0 - directResidual D birth death hD 0 = 0
  rw [directResidual_zero, sub_zero]

/-- The global analytic elimination chart retains the exact actual reduced
    path matrix on its inverse coordinates. -/
theorem fullProduct_eliminationHomeomorph_symm (u : NormalParams birth death) :
    fullProduct D birth death hD ((eliminationHomeomorph D birth death hD).symm u) =
      reducedFullProduct D birth death hD u :=
  fullProduct_after_elimination D birth death hD u

/-- The literal arbitrary-target half squared-entry loss in the new global
    coordinates, keeping the complete residual path polynomials. -/
theorem half_squared_loss_after_elimination (u : NormalParams birth death)
    (target : Matrix (Index D birth death (Fin.last D)) (Index D birth death 0) ℝ) :
    (1 / 2 : ℝ) * ∑ r, ∑ s,
        (fullProduct D birth death hD ((eliminationHomeomorph D birth death hD).symm u) r s -
          target r s) ^ 2 =
      (1 / 2 : ℝ) * ∑ r, ∑ s,
        if hp : Linked birth death r.val s.val then
          (u ⟨(r.val, s.val), hp⟩ - target r s) ^ 2 else
          (fullProduct D birth death hD (residualProjection D birth death u) r s -
            target r s) ^ 2 := by
  rw [fullProduct_eliminationHomeomorph_symm]
  congr 1
  apply Finset.sum_congr rfl
  intro r _
  apply Finset.sum_congr rfl
  intro s _
  unfold reducedFullProduct
  split_ifs <;> rfl

end MAIS.ActiveIntervalEliminationChart
end
-- ==================== end module O7.ActiveIntervalEliminationChart ====================

-- ==================== begin module O7.ActiveIntervalGaussianCoordinates (formalization/O7/ActiveIntervalGaussianCoordinates.lean) ====================
section

/-! Genuine residual-Pi times direct-Euclidean coordinates, with the exact
literal Frobenius loss split after actual global analytic elimination. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000

namespace MAIS.ActiveIntervalGaussianCoordinates

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalDirectElimination MAIS.ActiveIntervalEliminationChart
open scoped Matrix Matrix.Norms.Frobenius
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

abbrev DirectIndex := {p : NormalIndex birth death // IsDirect D birth death p}
abbrev ResidualIndex := {p : NormalIndex birth death // ¬ IsDirect D birth death p}
abbrev Residual := ResidualIndex D birth death → ℝ
abbrev Regular := EuclideanSpace ℝ (DirectIndex D birth death)

/-- Literal restriction to the two complementary actual coordinate sets. -/
noncomputable def splitPi : NormalParams birth death ≃ₗ[ℝ]
    (Residual D birth death × (DirectIndex D birth death → ℝ)) where
  toEquiv := (Equiv.piEquivPiSubtypeProd (IsDirect D birth death) (fun _ => ℝ)).trans
    (Equiv.prodComm _ _)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The direct norm is genuinely Euclidean: its square is the sum of squares,
    rather than the maximum of the squared direct coordinates. -/
noncomputable def coordinateSplit : NormalParams birth death ≃L[ℝ]
    (Residual D birth death × Regular D birth death) :=
  (splitPi D birth death).toContinuousLinearEquiv.trans
    ((ContinuousLinearEquiv.refl ℝ (Residual D birth death)).prodCongr
      (PiLp.continuousLinearEquiv 2 ℝ (fun _ : DirectIndex D birth death => ℝ)).symm)

omit [DecidableEq S] in
@[simp]
theorem coordinateSplit_symm_apply (z : Residual D birth death) (q : Regular D birth death)
    (p : NormalIndex birth death) :
    (coordinateSplit D birth death).symm (z,q) p =
      if hp : IsDirect D birth death p then q ⟨p,hp⟩ else z ⟨p,hp⟩ := rfl

noncomputable def residualInjection : Residual D birth death →L[ℝ] NormalParams birth death :=
  (coordinateSplit D birth death).symm.toContinuousLinearMap.comp
    (ContinuousLinearMap.inl ℝ (Residual D birth death) (Regular D birth death))

omit [DecidableEq S] in
theorem residualProjection_coordinateSplit_symm (z : Residual D birth death)
    (q : Regular D birth death) :
    residualProjection D birth death ((coordinateSplit D birth death).symm (z,q)) =
      residualInjection D birth death z := by
  funext p
  change _ = (coordinateSplit D birth death).symm (z,0) p
  rw [residualProjection_apply, coordinateSplit_symm_apply, coordinateSplit_symm_apply]
  split_ifs <;> rfl

abbrev LinkedEndpoint := {p : Index D birth death (Fin.last D) × Index D birth death 0 //
  Linked birth death p.1.val p.2.val}

/-- Direct scalar coordinates are in actual bijection with linked physical
    output entries; no dimension equality is assumed. -/
noncomputable def endpointEquiv : LinkedEndpoint D birth death ≃ DirectIndex D birth death where
  toFun p := ⟨⟨(p.val.1.val,p.val.2.val),p.property⟩,
    endpointPair_isDirect D birth death hD p.val.1 p.val.2 p.property⟩
  invFun p := ⟨(directOutput D birth death p.val p.property,
    directInput D birth death p.val p.property), p.val.property⟩
  left_inv p := by
    apply Subtype.ext
    apply Prod.ext <;> apply Subtype.ext <;> rfl
  right_inv p := by
    apply Subtype.ext
    apply Subtype.ext
    rfl

private theorem frobenius_norm_sq_eq_sum {α β : Type*} [Fintype α] [Fintype β]
    (M : Matrix α β ℝ) : ‖M‖ ^ 2 = ∑ r, ∑ s, M r s ^ 2 := by
  rw [Matrix.frobenius_norm_def]
  simp only [Real.rpow_two, Real.norm_eq_abs, sq_abs]
  rw [← Real.sqrt_eq_rpow]
  exact Real.sq_sqrt (by positivity)

/-- Actual residual loss with all direct coordinates zero, retaining only the
    nonlinked endpoint entries of the complete path polynomial. -/
noncomputable def residualLoss (z : Residual D birth death) : ℝ :=
  ∑ r : Index D birth death (Fin.last D), ∑ s : Index D birth death 0,
    if Linked birth death r.val s.val then 0 else
      (fullProduct D birth death hD (residualInjection D birth death z) r s) ^ 2

/-- The exact matrix-square split in genuine independent coordinate carriers. -/
theorem squared_reduced_loss_coordinateSplit (z : Residual D birth death)
    (q : Regular D birth death) :
    ‖reducedFullProduct D birth death hD ((coordinateSplit D birth death).symm (z,q))‖ ^ 2 =
      residualLoss D birth death hD z + ‖q‖ ^ 2 := by
  classical
  rw [frobenius_norm_sq_eq_sum, EuclideanSpace.real_norm_sq_eq]
  have hentry : ∀ (r : Index D birth death (Fin.last D)) (s : Index D birth death 0),
      (reducedFullProduct D birth death hD ((coordinateSplit D birth death).symm (z,q)) r s)^2 =
        (if Linked birth death r.val s.val then 0 else
          (fullProduct D birth death hD (residualInjection D birth death z) r s)^2) +
        (if hp : Linked birth death r.val s.val then
          (q ⟨⟨(r.val,s.val),hp⟩,endpointPair_isDirect D birth death hD r s hp⟩)^2 else 0) := by
    intro r s
    unfold reducedFullProduct
    by_cases hp : Linked birth death r.val s.val
    · rw [dite_eq_left hp, coordinateSplit_symm_apply]
      have hd := endpointPair_isDirect D birth death hD r s hp
      simp only [dite_eq_left hd, ite_eq_left hp, zero_add, dite_eq_left hp]
    · rw [dite_eq_right hp, residualProjection_coordinateSplit_symm]
      simp only [ite_eq_right hp, dite_eq_right hp, add_zero]
  simp_rw [hentry, Finset.sum_add_distrib]
  change residualLoss D birth death hD z + _ = residualLoss D birth death hD z + _
  congr 1
  rw [← Fintype.sum_prod_type (fun p :
      Index D birth death (Fin.last D) × Index D birth death 0 =>
    if hp : Linked birth death p.1.val p.2.val then
      (q ⟨⟨(p.1.val,p.2.val),hp⟩,endpointPair_isDirect D birth death hD p.1 p.2 hp⟩)^2 else 0)]
  calc
    (∑ p : Index D birth death (Fin.last D) × Index D birth death 0,
      if hp : Linked birth death p.1.val p.2.val then
        (q ⟨⟨(p.1.val,p.2.val),hp⟩,endpointPair_isDirect D birth death hD p.1 p.2 hp⟩)^2 else 0) =
      ∑ p : LinkedEndpoint D birth death, (q (endpointEquiv D birth death hD p))^2 := by
        symm
        apply Fintype.sum_of_injective (fun p : LinkedEndpoint D birth death => p.val)
          Subtype.val_injective
        · intro p hp
          have hn : ¬ Linked birth death p.1.val p.2.val := by
            intro h
            apply hp
            exact ⟨⟨p,h⟩,rfl⟩
          rw [dite_eq_right hn]
        · intro p
          rw [dite_eq_left p.property]
          rfl
    _ = ∑ p : DirectIndex D birth death, q p ^ 2 :=
      Fintype.sum_equiv (endpointEquiv D birth death hD) _ _ (fun _ => rfl)

end MAIS.ActiveIntervalGaussianCoordinates
end
-- ==================== end module O7.ActiveIntervalGaussianCoordinates ====================

-- ==================== begin module O7.ActiveIntervalGaussianChart (formalization/O7/ActiveIntervalGaussianChart.lean) ====================
section

/-! A genuine analytic global chart splitting the actual normal squared loss
as a residual loss plus an independent Euclidean quadratic block. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000

namespace MAIS.ActiveIntervalGaussianChart

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalDirectElimination MAIS.ActiveIntervalEliminationChart
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalEndpointRows
open MAIS.MatrixChainIsomorphism
open scoped Matrix Matrix.Norms.Frobenius
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- Actual coordinates (residual, regular) map to the original independent
    normal parameters through the explicit global inverse elimination. -/
noncomputable def gaussianHomeomorph :
    (Residual D birth death × Regular D birth death) ≃ₜ NormalParams birth death :=
  (coordinateSplit D birth death).symm.toHomeomorph.trans
    (eliminationHomeomorph D birth death hD).symm

theorem analyticAt_gaussianHomeomorph (p : Residual D birth death × Regular D birth death) :
    AnalyticAt ℝ (gaussianHomeomorph D birth death hD) p := by
  have h := (analyticAt_normalElimination_symm D birth death hD
    ((coordinateSplit D birth death).symm p)).comp
      ((coordinateSplit D birth death).symm.toContinuousLinearMap.analyticAt p)
  convert h using 1
  rfl

theorem analyticAt_gaussianHomeomorph_symm (t : NormalParams birth death) :
    AnalyticAt ℝ (gaussianHomeomorph D birth death hD).symm t := by
  have h := ((coordinateSplit D birth death).toContinuousLinearMap.analyticAt
    (normalElimination D birth death hD t)).comp
      (analyticAt_normalElimination D birth death hD t)
  convert h using 1
  rfl

@[simp]
theorem gaussianHomeomorph_zero : gaussianHomeomorph D birth death hD 0 = 0 := by
  change (normalElimination D birth death hD).symm ((coordinateSplit D birth death).symm 0) = 0
  rw [map_zero, normalElimination_symm_zero]

/-- Literal full-product squared Frobenius loss, matching the ambient slice
    interface used by the independently checked measured chart reduction. -/
noncomputable abbrev normalSquaredLoss :=
  MAIS.ActiveIntervalMeasuredSlice.normalLoss D birth death hD
    0 (Fin.last D) (by exact Nat.zero_le D)

theorem normalSquaredLoss_gaussianHomeomorph
    (p : Residual D birth death × Regular D birth death) :
    normalSquaredLoss D birth death hD (gaussianHomeomorph D birth death hD p) =
      residualLoss D birth death hD p.1 + ‖p.2‖ ^ 2 := by
  change ‖fullProduct D birth death hD
    ((eliminationHomeomorph D birth death hD).symm ((coordinateSplit D birth death).symm p))‖^2 = _
  rw [fullProduct_eliminationHomeomorph_symm]
  exact squared_reduced_loss_coordinateSplit D birth death hD p.1 p.2

theorem continuous_normalSquaredLoss : Continuous (normalSquaredLoss D birth death hD) :=
  MAIS.ActiveIntervalMeasuredSlice.continuous_normalLoss D birth death hD
    0 (Fin.last D) (by exact Nat.zero_le D)

theorem continuous_residualLoss : Continuous (residualLoss D birth death hD) := by
  have h := (continuous_normalSquaredLoss D birth death hD).comp
    ((gaussianHomeomorph D birth death hD).continuous.comp
      (continuous_id.prodMk (continuous_const : Continuous (fun _ : Residual D birth death =>
        (0 : Regular D birth death)))))
  convert h using 1
  funext z
  change residualLoss D birth death hD z =
    normalSquaredLoss D birth death hD (gaussianHomeomorph D birth death hD (z,0))
  have he := normalSquaredLoss_gaussianHomeomorph D birth death hD
    (z, (0 : Regular D birth death))
  simpa only [norm_zero, zero_pow (by decide : 2 ≠ 0), add_zero] using he.symm

theorem residualLoss_nonneg (z : Residual D birth death) :
    0 ≤ residualLoss D birth death hD z := by
  apply Finset.sum_nonneg
  intro r _
  apply Finset.sum_nonneg
  intro s _
  split_ifs
  · exact le_rfl
  · exact sq_nonneg _

theorem residualLoss_zero
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) = 0) :
    residualLoss D birth death hD 0 = 0 := by
  have hn : normalSquaredLoss D birth death hD 0 = 0 := by
    simp only [normalSquaredLoss, MAIS.ActiveIntervalMeasuredSlice.normalLoss,
      MAIS.ActiveIntervalMeasuredSlice.ambientLoss, map_zero, add_zero, hzero,
      norm_zero, zero_pow (by decide : 2 ≠ 0)]
  have h := normalSquaredLoss_gaussianHomeomorph D birth death hD
    (0 : Residual D birth death × Regular D birth death)
  rw [gaussianHomeomorph_zero, hn] at h
  simpa only [Prod.fst_zero, Prod.snd_zero, norm_zero,
    zero_pow (by decide : 2 ≠ 0), add_zero] using h.symm

omit [DecidableEq S] in
theorem finrank_regular : Module.finrank ℝ (Regular D birth death) =
    Fintype.card (DirectIndex D birth death) := by
  exact finrank_euclideanSpace

end MAIS.ActiveIntervalGaussianChart
end
-- ==================== end module O7.ActiveIntervalGaussianChart ====================

-- ==================== begin module O7.MatrixChainEntryWindows (formalization/O7/MatrixChainEntryWindows.lean) ====================
section

/-! Genuine Euclidean flattening of all entries of arbitrary rectangular
matrix chains, and actual window comparison derived from that equivalence. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory
open scoped Topology Matrix Matrix.Norms.Frobenius
namespace MAIS.MatrixChainEntryWindows
open MAIS.QuiverRealOrbit MAIS.AnalyticTransfer
universe u
variable {D : ℕ} (I : Fin (D+1) → Type u)
variable [∀ v, Fintype (I v)]

/-- Every actual arrow entry has its own physical index. -/
abbrev EntryIndex := (e : Fin D) × (I e.succ × I e.castSucc)

/-- Literal encoding and decoding of all original matrix entries. -/
def entryEquiv : Rep I ≃ₗ[ℝ] (EntryIndex I → ℝ) where
  toFun A k := A k.1 k.2.1 k.2.2
  invFun x e r s := x ⟨e,(r,s)⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The target norm is genuinely Euclidean, not a Pi sup norm. -/
def flat : Rep I ≃L[ℝ] EuclideanSpace ℝ (EntryIndex I) :=
  (entryEquiv I).toContinuousLinearEquiv.trans
    (PiLp.continuousLinearEquiv 2 ℝ (fun _ : EntryIndex I => ℝ)).symm

@[simp]
theorem flat_apply (A : Rep I) (k : EntryIndex I) :
    flat I A k = A k.1 k.2.1 k.2.2 := rfl

/-- The Euclidean distance is the literal square root of the sum of squared
    differences of every original arrow entry. -/
theorem dist_flat (A B : Rep I) :
    dist (flat I A) (flat I B) =
      Real.sqrt (∑ e : Fin D, ∑ r : I e.succ, ∑ s : I e.castSucc,
        (A e r s - B e r s)^2) := by
  rw [EuclideanSpace.dist_eq]
  congr 1
  simp only [Fintype.sum_sigma, Fintype.sum_prod_type, flat_apply, Real.dist_eq, sq_abs]

/-- Literal original-entry Euclidean windows for arbitrary rectangular chains. -/
def entryBall (w : Rep I) (R : ℝ) : Set (Rep I) :=
  {A | Real.sqrt (∑ e : Fin D, ∑ r : I e.succ, ∑ s : I e.castSucc,
    (A e r s - w e r s)^2) < R}

theorem entryBall_eq (w : Rep I) (R : ℝ) :
    entryBall I w R = (flat I) ⁻¹' Metric.ball (flat I w) R := by
  ext A
  change _ < R ↔ dist (flat I A) (flat I w) < R
  rw [dist_flat]

/-- The measure is held fixed, and the two window systems are compared from
actual operator norms of the genuine entry flattening and inverse. -/
theorem pair_iff_entryBall (mu : Measure (Rep I)) (w : Rep I)
    {f : Rep I → ℝ} {lam : ℝ} {m : ℕ} :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair mu (entryBall I w) f w lam m := by
  have heq : entryBall I w = fun R => (flat I) ⁻¹' Metric.ball (flat I w) R := by
    funext R
    exact entryBall_eq I w R
  rw [heq]
  exact MAIS.LinearWindowTransfer.pair_iff_linear_windows mu (flat I) w

end MAIS.MatrixChainEntryWindows
end

