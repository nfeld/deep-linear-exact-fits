-- ==================== begin module O7.ActiveIntervalFamily (formalization/O7/ActiveIntervalFamily.lean) ====================
section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
universe w
namespace MAIS.ActiveIntervalFamily

open scoped Matrix
open MAIS.TypeARealFamily MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.MatrixRestriction

def active (a c b d i : ℕ) (r : Fin 2) : Prop :=
  if r = 0 then a ≤ i ∧ i ≤ c else b ≤ i ∧ i ≤ d

instance active_decidable (a c b d i : ℕ) (r : Fin 2) : Decidable (active a c b d i r) := by
  unfold active
  infer_instance

abbrev ActiveIndex (D a c b d : ℕ) : Fin (D + 1) → Type :=
  fun v => {r : Fin 2 // active a c b d v.val r}

/-- The literal real family restricted to its fixed, actual active vertex spaces. -/
def activeFamily (D a b c d : ℕ) (t : ℝ) : Rep (ActiveIndex D a c b d) :=
  fun e => (family a b c d t e.val).submatrix Subtype.val Subtype.val

lemma family_rows_zero (a b c d i : ℕ) (t : ℝ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d)
    (r : Fin 2) (hr : ¬ active a c b d (i + 1) r) (s : Fin 2) :
    family a b c d t i r s = 0 := by
  fin_cases r <;> fin_cases s <;>
    simp [active] at hr <;>
    simp [family, intervalArrows, diag] <;>
    split_ifs <;> simp_all <;> omega

lemma family_cols_zero (a b c d i : ℕ) (t : ℝ)
    (hab : a < b) (hbc : b ≤ c + 1) (_hcd : c + 1 ≤ d)
    (s : Fin 2) (hs : ¬ active a c b d i s) (r : Fin 2) :
    family a b c d t i r s = 0 := by
  fin_cases r <;> fin_cases s <;>
    simp [active] at hs <;>
    simp [family, intervalArrows, diag] <;>
    split_ifs <;> simp_all <;> omega

lemma path_rows_zero (a b c d i len : ℕ) (t : ℝ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d)
    (r : Fin 2) (hr : ¬ active a c b d (i + (len + 1)) r) (s : Fin 2) :
    pathProduct (family a b c d t) i (len + 1) r s = 0 := by
  rw [pathProduct]
  simp only [Matrix.mul_apply]
  apply Finset.sum_eq_zero
  intro k _
  rw [family_rows_zero a b c d (i + len) t hab hbc hcd r (by simpa [Nat.add_assoc] using hr) k,
    zero_mul]

lemma path_cols_zero (a b c d i len : ℕ) (t : ℝ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d)
    (s : Fin 2) (hs : ¬ active a c b d i s) (r : Fin 2) :
    pathProduct (family a b c d t) i (len + 1) r s = 0 := by
  induction len generalizing r with
  | zero => simpa [pathProduct] using family_cols_zero a b c d i t hab hbc hcd s hs r
  | succ len ih =>
    rw [pathProduct]
    simp only [Matrix.mul_apply]
    apply Finset.sum_eq_zero
    intro k _
    rw [ih k, mul_zero]

lemma continuous_activeFamily (D a b c d : ℕ) : Continuous (activeFamily D a b c d) := by
  apply continuous_pi
  intro e
  apply continuous_pi
  intro r
  apply continuous_pi
  intro s
  exact ((continuous_apply s.val).comp ((continuous_apply r.val).comp
    (continuous_family a b c d e.val)))

/-- Restricting the actual consecutive products gives exactly the actual active-space products. -/
theorem active_path_formula (D a b c d i len : ℕ) (t : ℝ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) (hbound : i + len ≤ D) :
    pathMatrix (activeFamily D a b c d t) ⟨i, by omega⟩ ⟨i + len, by omega⟩ (by change i ≤ i + len; omega) =
      (pathProduct (family a b c d t) i len).submatrix Subtype.val Subtype.val := by
  induction len with
  | zero =>
    change pathMatrix (activeFamily D a b c d t) ⟨i, by omega⟩ ⟨i, by omega⟩ le_rfl = _
    rw [pathMatrix_self]
    ext r s
    simp [pathProduct, Matrix.one_apply, Subtype.ext_iff]
  | succ len ih =>
    let e : Fin D := ⟨i + len, by omega⟩
    have hbound' : i + len ≤ D := by omega
    have hcomp := pathMatrix_comp (activeFamily D a b c d t)
      (⟨i, by omega⟩ : Fin (D + 1)) e.castSucc e.succ (by change i ≤ i + len; omega)
      (by exact Nat.le_succ e.val)
    change pathMatrix (activeFamily D a b c d t) ⟨i, by omega⟩ e.succ _ = _
    rw [← hcomp, pathMatrix_arrow]
    erw [ih hbound']
    exact restrict_mul (family a b c d t (i + len))
      (pathProduct (family a b c d t) i len) (active a c b d (i + len))
      Subtype.val Subtype.val (family_cols_zero a b c d (i + len) t hab hbc hcd)

end MAIS.ActiveIntervalFamily

/-- info: 'MAIS.ActiveIntervalFamily.active_path_formula' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalFamily.active_path_formula
end
-- ==================== end module O7.ActiveIntervalFamily ====================

-- ==================== begin module O7.ActiveIntervalClosure (formalization/O7/ActiveIntervalClosure.lean) ====================
section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
namespace MAIS.ActiveIntervalFamily

open scoped Matrix
open MAIS.TypeARealFamily MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.MatrixRestriction

/-- Restriction preserves the actual rank of every nonempty consecutive family product. -/
theorem active_path_rank (D a b c d i len : ℕ) (t : ℝ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) (hbound : i + (len + 1) ≤ D) :
    (pathMatrix (activeFamily D a b c d t)
      ⟨i, by omega⟩ ⟨i + (len + 1), by omega⟩ (by change i ≤ i + (len + 1); omega)).rank =
      (pathProduct (family a b c d t) i (len + 1)).rank := by
  rw [active_path_formula D a b c d i (len + 1) t hab hbc hcd hbound]
  exact rank_restrict_eq _ (active a c b d (i + (len + 1))) (active a c b d i)
    (path_rows_zero a b c d i len t hab hbc hcd)
    (path_cols_zero a b c d i len t hab hbc hcd)

/-- Actual active-space products have exactly the joined-interval ranks off the zero parameter. -/
theorem active_path_rank_nonzero (D a b c d i len : ℕ) (t : ℝ) (ht : t ≠ 0)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) (hbound : i + (len + 1) ≤ D) :
    (pathMatrix (activeFamily D a b c d t)
      ⟨i, by omega⟩ ⟨i + (len + 1), by omega⟩ (by change i ≤ i + (len + 1); omega)).rank =
      (pathProduct (intervalArrows a d b c) i (len + 1)).rank := by
  exact (active_path_rank D a b c d i len t hab hbc hcd hbound).trans
    (path_rank_nonzero a b c d i (len + 1) t ht hab hbc hcd)

/-- Every nonzero restricted family lies in one actual real gauge-group orbit on the
    genuine variable active spaces.  The gauges are supplied by actual rank classification. -/
theorem activeFamily_mem_gauge_orbit (D a b c d : ℕ) (t : ℝ) (ht : t ≠ 0)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) :
    activeFamily D a b c d t ∈ MulAction.orbit (Gauge (ActiveIndex D a c b d))
      (activeFamily D a b c d 1) := by
  apply mem_gauge_orbit_of_path_rank_eq
  intro i j hij
  by_cases heq : i = j
  · subst j
    rw [pathMatrix_self, pathMatrix_self]
  · have hij' : i.val ≤ j.val := hij
    have hne : i.val ≠ j.val := fun h => heq (Fin.ext h)
    obtain ⟨len, hv⟩ : ∃ len : ℕ, i.val + (len + 1) = j.val := by
      refine ⟨j.val - i.val - 1, ?_⟩
      omega
    have hb : i.val + (len + 1) ≤ D := by rw [hv]; exact Nat.le_of_lt_succ j.isLt
    have h1 := active_path_rank_nonzero D a b c d i.val len 1 one_ne_zero hab hbc hcd hb
    have ht' := active_path_rank_nonzero D a b c d i.val len t ht hab hbc hcd hb
    have h := h1.trans ht'.symm
    rcases j with ⟨jval, hjval⟩
    change i.val + (len + 1) = jval at hv
    subst jval
    simpa only [Fin.eta] using h

/-- The actual split-arrow representation on the genuine active vertex spaces. -/
def splitActive (D a c b d : ℕ) : Rep (ActiveIndex D a c b d) :=
  fun e => (intervalArrows a c b d e.val).submatrix Subtype.val Subtype.val

lemma activeFamily_zero (D a b c d : ℕ) :
    activeFamily D a b c d 0 = splitActive D a c b d := by
  funext e
  rw [activeFamily, family_zero]
  rfl

/-- The elementary linked degeneration in ordinary Euclidean closure on actual variable
    active spaces.  No fixed ambient extra vertex dimensions are retained. -/
theorem splitActive_mem_closure_gauge_orbit (D a b c d : ℕ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) :
    splitActive D a c b d ∈ closure
      (MulAction.orbit (Gauge (ActiveIndex D a c b d)) (activeFamily D a b c d 1)) := by
  rw [← activeFamily_zero D a b c d]
  have ht : Filter.Tendsto (activeFamily D a b c d)
      (nhdsWithin (0 : ℝ) ({0}ᶜ)) (nhds (activeFamily D a b c d 0)) :=
    (continuous_activeFamily D a b c d).continuousAt.tendsto.mono_left nhdsWithin_le_nhds
  apply mem_closure_of_tendsto ht
  filter_upwards [self_mem_nhdsWithin] with t ht
  have ht0 : t ≠ 0 := by simpa only [Set.mem_compl_iff, Set.mem_singleton_iff] using ht
  exact activeFamily_mem_gauge_orbit D a b c d t ht0 hab hbc hcd

end MAIS.ActiveIntervalFamily

/-- info: 'MAIS.ActiveIntervalFamily.splitActive_mem_closure_gauge_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalFamily.splitActive_mem_closure_gauge_orbit
end
-- ==================== end module O7.ActiveIntervalClosure ====================

-- ==================== begin module O7.LinkedSwitchDecomposition (formalization/O7/LinkedSwitchDecomposition.lean) ====================
section

set_option autoImplicit false
namespace MAIS.LinkedSwitchDecomposition

open MAIS.MatrixBlockProjection MAIS.IntervalPaddingOrder
variable {m : ℕ}

/-- Literal one-slot interval multiplicity array. -/
def cell (a k : Fin m) : Fin m → Fin m → ℕ := fun r s =>
  if a = r ∧ k = s then 1 else 0

lemma crossing_add (A B : Fin m → Fin m → ℕ) (i j : ℕ) :
    crossing (fun r s => A r s + B r s) i j = crossing A i j + crossing B i j := by
  unfold crossing
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro r _
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro s _
  dsimp only
  split_ifs <;> omega

lemma crossing_cell (a k : Fin m) (i j : ℕ) :
    crossing (cell a k) i j = if a.val < i ∧ j ≤ k.val then 1 else 0 := by
  classical
  unfold crossing cell
  calc
    _ = ∑ r, ∑ s, if a = r ∧ k = s then (if a.val < i ∧ j ≤ k.val then 1 else 0) else 0 := by
      apply Finset.sum_congr rfl
      intro r _
      apply Finset.sum_congr rfl
      intro s _
      by_cases h : a = r ∧ k = s
      · obtain ⟨rfl, rfl⟩ := h
        simp
      · by_cases hp : r.val < i ∧ j ≤ s.val <;> simp [h, hp]
    _ = ∑ r, if a = r then (if a.val < i ∧ j ≤ k.val then 1 else 0) else 0 := by
      apply Finset.sum_congr rfl
      intro r _
      by_cases hr : a = r <;> simp [hr]
    _ = _ := by simp

/-- The actual nonnegative spectator obtained by deleting the two actual old interval slots. -/
def spectator (M : Fin m → Fin m → ℕ) (a b c d : Fin m) : Fin m → Fin m → ℕ :=
  fun r s => M r s - cell a c r s - cell b d r s

lemma spectator_old (M : Fin m → Fin m → ℕ) (a b c d : Fin m)
    (hab : a < b) (h1 : 0 < M a c) (h2 : 0 < M b d) :
    M = fun r s => spectator M a b c d r s + cell a c r s + cell b d r s := by
  funext r s
  unfold spectator cell
  by_cases hac : a = r ∧ c = s
  · obtain ⟨rfl, rfl⟩ := hac
    have hba : b ≠ a := ne_of_gt hab
    simp only [and_self, ite_true, hba, false_and, ite_false]
    omega
  · by_cases hbd : b = r ∧ d = s
    · obtain ⟨rfl, rfl⟩ := hbd
      simp only [hac, ite_false, and_self, ite_true]
      omega
    · simp only [hac, hbd, ite_false, Nat.sub_zero, add_zero]

lemma spectator_new (M N : Fin m → Fin m → ℕ) (a b c d : Fin m)
    (hab : a < b) (h1 : 0 < M a c) (h2 : 0 < M b d)
    (hbalance : ∀ r s, N r s + cell a c r s + cell b d r s =
      M r s + cell a d r s + cell b c r s) :
    N = fun r s => spectator M a b c d r s + cell a d r s + cell b c r s := by
  have hold := spectator_old M a b c d hab h1 h2
  funext r s
  have h := hbalance r s
  have hm := congrFun (congrFun hold r) s
  omega

/-- Every positive linked switch is an actual two-interval replacement plus an actual
    nonnegative unchanged spectator array. -/
theorem linked_spectator_decomposition (M N : Fin m → Fin m → ℕ) (h : LinkedSwitch M N) :
    ∃ a b c d : Fin m, ∃ T : Fin m → Fin m → ℕ,
      a < b ∧ b ≤ c ∧ c < d ∧
      M = (fun r s => T r s + cell a c r s + cell b d r s) ∧
      N = (fun r s => T r s + cell a d r s + cell b c r s) := by
  obtain ⟨a, b, c, d, hab, hbc, hcd, h1, h2, hb⟩ := h
  refine ⟨a, b, c, d, spectator M a b c d, hab, hbc, hcd,
    spectator_old M a b c d hab h1 h2, ?_⟩
  exact spectator_new M N a b c d hab h1 h2 hb

/-- Linked interval replacement preserves every actual finite vertex coverage count. -/
theorem linked_coverage (M N : Fin m → Fin m → ℕ) (h : LinkedSwitch M N) (i : ℕ) :
    crossing M i i = crossing N i i := by
  obtain ⟨a, b, c, d, T, hab, hbc, hcd, hM, hN⟩ := linked_spectator_decomposition M N h
  rw [hM, hN, crossing_add, crossing_add, crossing_add, crossing_add,
    crossing_cell, crossing_cell, crossing_cell, crossing_cell]
  have hab' : a.val < b.val := hab
  have hbc' : b.val ≤ c.val := hbc
  have hcd' : c.val < d.val := hcd
  split_ifs <;> omega

end MAIS.LinkedSwitchDecomposition

/-- info: 'MAIS.LinkedSwitchDecomposition.linked_spectator_decomposition' depends on axioms: [propext, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinkedSwitchDecomposition.linked_spectator_decomposition
/-- info: 'MAIS.LinkedSwitchDecomposition.linked_coverage' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinkedSwitchDecomposition.linked_coverage
end
-- ==================== end module O7.LinkedSwitchDecomposition ====================

-- ==================== begin module O7.ElementaryActiveRanks (formalization/O7/ElementaryActiveRanks.lean) ====================
section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
namespace MAIS.ElementaryActiveRanks

open scoped Matrix
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.ActiveIntervalFamily MAIS.TypeARealFamily MAIS.TypeAIntervalMove
open MAIS.LinkedSwitchDecomposition MAIS.IntervalPaddingOrder

lemma active_vertex_card (D a c b d : ℕ) (i : Fin (D + 1)) :
    Fintype.card (ActiveIndex D a c b d i) =
      intervalRank a c i.val i.val + intervalRank b d i.val i.val := by
  rw [Fintype.card_subtype]
  simp only [Finset.card_eq_sum_ones, Finset.sum_filter, Fin.sum_univ_two]
  simp [active, intervalRank]

lemma split_path_rank_nat (D a b c d i len : ℕ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) (hbound : i + (len + 1) ≤ D) :
    (pathMatrix (splitActive D a c b d) ⟨i, by omega⟩ ⟨i + (len + 1), by omega⟩
      (by change i ≤ i + (len + 1); omega)).rank =
      intervalRank a c i (i + (len + 1)) + intervalRank b d i (i + (len + 1)) := by
  rw [← activeFamily_zero D a b c d]
  exact (active_path_rank D a b c d i len 0 hab hbc hcd hbound).trans
    (path_rank_zero a b c d i len)

lemma nonzero_path_rank_nat (D a b c d i len : ℕ) (t : ℝ) (ht : t ≠ 0)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d) (hbound : i + (len + 1) ≤ D) :
    (pathMatrix (activeFamily D a b c d t) ⟨i, by omega⟩ ⟨i + (len + 1), by omega⟩
      (by change i ≤ i + (len + 1); omega)).rank =
      intervalRank a d i (i + (len + 1)) + intervalRank b c i (i + (len + 1)) := by
  exact (active_path_rank_nonzero D a b c d i len t ht hab hbc hcd hbound).trans
    (interval_path_rank a d b c i len)

/-- All actual split active-space path ranks, including the zero-length vertex paths. -/
theorem split_path_rank (D a b c d : ℕ)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (splitActive D a c b d) i j hij).rank =
      intervalRank a c i.val j.val + intervalRank b d i.val j.val := by
  by_cases heq : i = j
  · subst j
    rw [pathMatrix_self, Matrix.rank_one, active_vertex_card]
  · have hij' : i.val ≤ j.val := hij
    have hne : i.val ≠ j.val := fun h => heq (Fin.ext h)
    obtain ⟨len, hv⟩ : ∃ len : ℕ, i.val + (len + 1) = j.val := by
      refine ⟨j.val - i.val - 1, ?_⟩
      omega
    have hb : i.val + (len + 1) ≤ D := by rw [hv]; exact Nat.le_of_lt_succ j.isLt
    have h := split_path_rank_nat D a b c d i.val len hab hbc hcd hb
    rcases j with ⟨jval, hjval⟩
    change i.val + (len + 1) = jval at hv
    subst jval
    simpa only [Fin.eta] using h

/-- All actual nonzero-family path ranks are the joined interval ranks, including vertices. -/
theorem nonzero_path_rank (D a b c d : ℕ) (t : ℝ) (ht : t ≠ 0)
    (hab : a < b) (hbc : b ≤ c + 1) (hcd : c + 1 ≤ d)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (activeFamily D a b c d t) i j hij).rank =
      intervalRank a d i.val j.val + intervalRank b c i.val j.val := by
  by_cases heq : i = j
  · subst j
    rw [pathMatrix_self, Matrix.rank_one, active_vertex_card]
    exact (vertex_dimension a b c d i.val hab hbc hcd).symm
  · have hij' : i.val ≤ j.val := hij
    have hne : i.val ≠ j.val := fun h => heq (Fin.ext h)
    obtain ⟨len, hv⟩ : ∃ len : ℕ, i.val + (len + 1) = j.val := by
      refine ⟨j.val - i.val - 1, ?_⟩
      omega
    have hb : i.val + (len + 1) ≤ D := by rw [hv]; exact Nat.le_of_lt_succ j.isLt
    have h := nonzero_path_rank_nat D a b c d i.val len t ht hab hbc hcd hb
    rcases j with ⟨jval, hjval⟩
    change i.val + (len + 1) = jval at hv
    subst jval
    simpa only [Fin.eta] using h

lemma intervalRank_exclusive (a c i j : ℕ) (hc : 0 < c) :
    intervalRank a (c - 1) i j = if a < i + 1 ∧ j + 1 ≤ c then 1 else 0 := by
  have hp : (a ≤ i ∧ j ≤ c - 1) ↔ (a < i + 1 ∧ j + 1 ≤ c) := by omega
  simp only [intervalRank, hp]

variable {m : ℕ}

/-- Actual split-family ranks equal the crossing counts of the literal two old interval cells. -/
theorem split_path_rank_cells (D : ℕ) (a b c d : Fin m)
    (hab : a < b) (hbc : b ≤ c) (hcd : c < d)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (splitActive D a.val (c.val - 1) b.val (d.val - 1)) i j hij).rank =
      crossing (fun r s => cell a c r s + cell b d r s) (i.val + 1) (j.val + 1) := by
  have hab' : a.val < b.val := hab
  have hbc' : b.val ≤ c.val := hbc
  have hcd' : c.val < d.val := hcd
  have hc : 0 < c.val := by omega
  have hd : 0 < d.val := by omega
  rw [split_path_rank D a.val b.val (c.val - 1) (d.val - 1) hab' (by omega) (by omega),
    crossing_add, crossing_cell, crossing_cell,
    intervalRank_exclusive _ _ _ _ hc, intervalRank_exclusive _ _ _ _ hd]

/-- Actual nonzero-family ranks equal crossing counts of the literal two joined interval cells. -/
theorem nonzero_path_rank_cells (D : ℕ) (a b c d : Fin m) (t : ℝ) (ht : t ≠ 0)
    (hab : a < b) (hbc : b ≤ c) (hcd : c < d)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (activeFamily D a.val b.val (c.val - 1) (d.val - 1) t) i j hij).rank =
      crossing (fun r s => cell a d r s + cell b c r s) (i.val + 1) (j.val + 1) := by
  have hab' : a.val < b.val := hab
  have hbc' : b.val ≤ c.val := hbc
  have hcd' : c.val < d.val := hcd
  have hc : 0 < c.val := by omega
  have hd : 0 < d.val := by omega
  rw [nonzero_path_rank D a.val b.val (c.val - 1) (d.val - 1) t ht hab' (by omega) (by omega),
    crossing_add, crossing_cell, crossing_cell,
    intervalRank_exclusive _ _ _ _ hd, intervalRank_exclusive _ _ _ _ hc]

end MAIS.ElementaryActiveRanks

/-- info: 'MAIS.ElementaryActiveRanks.split_path_rank_cells' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ElementaryActiveRanks.split_path_rank_cells
/-- info: 'MAIS.ElementaryActiveRanks.nonzero_path_rank_cells' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ElementaryActiveRanks.nonzero_path_rank_cells
end
-- ==================== end module O7.ElementaryActiveRanks ====================

-- ==================== begin module O7.GenericActiveRestriction (formalization/O7/GenericActiveRestriction.lean) ====================
section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
universe w
namespace MAIS.GenericActiveRestriction

open scoped Matrix
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.MatrixRestriction
variable {d : ℕ} {α : Type w} [Fintype α] [DecidableEq α]
variable (P : Fin (d + 1) → α → Prop) [∀ i, DecidablePred (P i)]

abbrev RestrictedIndex : Fin (d + 1) → Type w := fun i => {a : α // P i a}

def restrictRep (A : Rep (fun _ : Fin (d + 1) => α)) : Rep (RestrictedIndex P) :=
  fun e => (A e).submatrix Subtype.val Subtype.val

/-- Actual all-path products commute with restriction through supported middle spaces. -/
theorem path_restrict (A : Rep (fun _ : Fin (d + 1) => α))
    (hcol : ∀ e k, ¬ P e.castSucc k → ∀ r, A e r k = 0)
    (i j : Fin (d + 1)) (hij : i ≤ j) :
    pathMatrix (restrictRep P A) i j hij =
      (pathMatrix A i j hij).submatrix Subtype.val Subtype.val := by
  suffices h : ∀ j : Fin (d + 1), ∀ i (hij : i ≤ j),
      pathMatrix (restrictRep P A) i j hij =
        (pathMatrix A i j hij).submatrix Subtype.val Subtype.val from h j i hij
  intro j
  induction j using Fin.induction with
  | zero =>
    intro i hij
    have hi : i = 0 := le_antisymm hij (by exact Nat.zero_le i.val)
    subst i
    rw [pathMatrix_self, pathMatrix_self]
    ext r s
    simp [Matrix.one_apply, Subtype.ext_iff]
  | succ e ih =>
    intro i hij
    by_cases heq : i = e.succ
    · subst i
      rw [pathMatrix_self, pathMatrix_self]
      ext r s
      simp [Matrix.one_apply, Subtype.ext_iff]
    · have hne : i.val ≠ e.val + 1 := fun h => heq (Fin.ext h)
      have hij' : i ≤ e.castSucc := by
        change i.val ≤ e.val
        have hle : i.val ≤ e.val + 1 := hij
        omega
      rw [pathMatrix_step _ i e hij', pathMatrix_step _ i e hij', ih i hij']
      exact restrict_mul (A e) (pathMatrix A i e.castSucc hij') (P e.castSucc)
        Subtype.val Subtype.val (hcol e)

omit [∀ i, DecidablePred (P i)] in
/-- Every positive actual full path has zero rows outside its actual terminal active space. -/
theorem path_rows_zero (A : Rep (fun _ : Fin (d + 1) => α))
    (hrow : ∀ e r, ¬ P e.succ r → ∀ k, A e r k = 0)
    (i j : Fin (d + 1)) (hij : i < j) (r : α) (hr : ¬ P j r) (k : α) :
    pathMatrix A i j hij.le r k = 0 := by
  suffices h : ∀ j : Fin (d + 1), ∀ i (hij : i < j), ∀ r,
      ¬ P j r → ∀ k, pathMatrix A i j hij.le r k = 0 from h j i hij r hr k
  intro j
  induction j using Fin.induction with
  | zero => intro i hij; exact False.elim (by change i.val < 0 at hij; omega)
  | succ e _ih =>
    intro i hij r hr k
    have hij' : i ≤ e.castSucc := by
      change i.val ≤ e.val
      have hle : i.val < e.val + 1 := hij
      omega
    rw [pathMatrix_step A i e hij']
    simp only [Matrix.mul_apply]
    apply Finset.sum_eq_zero
    intro q _
    rw [hrow e r hr q, zero_mul]

omit [∀ i, DecidablePred (P i)] in
/-- Every positive actual full path has zero columns outside its actual initial active space. -/
theorem path_cols_zero (A : Rep (fun _ : Fin (d + 1) => α))
    (hcol : ∀ e k, ¬ P e.castSucc k → ∀ r, A e r k = 0)
    (i j : Fin (d + 1)) (hij : i < j) (k : α) (hk : ¬ P i k) (r : α) :
    pathMatrix A i j hij.le r k = 0 := by
  suffices h : ∀ j : Fin (d + 1), ∀ i (hij : i < j), ∀ k,
      ¬ P i k → ∀ r, pathMatrix A i j hij.le r k = 0 from h j i hij k hk r
  intro j
  induction j using Fin.induction with
  | zero => intro i hij; exact False.elim (by change i.val < 0 at hij; omega)
  | succ e ih =>
    intro i hij k hk r
    have hij' : i ≤ e.castSucc := by
      change i.val ≤ e.val
      have hle : i.val < e.val + 1 := hij
      omega
    by_cases heq : i = e.castSucc
    · subst i
      rw [pathMatrix_arrow]
      exact hcol e k hk r
    · have hlt : i < e.castSucc := lt_of_le_of_ne hij' heq
      rw [pathMatrix_step A i e hij']
      simp only [Matrix.mul_apply]
      apply Finset.sum_eq_zero
      intro q _
      rw [ih i hlt k hk q, mul_zero]

/-- Restriction to the genuine active spaces preserves every positive actual path rank. -/
theorem path_rank_restrict (A : Rep (fun _ : Fin (d + 1) => α))
    (hrow : ∀ e r, ¬ P e.succ r → ∀ k, A e r k = 0)
    (hcol : ∀ e k, ¬ P e.castSucc k → ∀ r, A e r k = 0)
    (i j : Fin (d + 1)) (hij : i < j) :
    (pathMatrix (restrictRep P A) i j hij.le).rank = (pathMatrix A i j hij.le).rank := by
  rw [path_restrict P A hcol]
  exact rank_restrict_eq _ (P j) (P i) (path_rows_zero P A hrow i j hij)
    (path_cols_zero P A hcol i j hij)

end MAIS.GenericActiveRestriction

/-- info: 'MAIS.GenericActiveRestriction.path_rank_restrict' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.GenericActiveRestriction.path_rank_restrict
end
-- ==================== end module O7.GenericActiveRestriction ====================

-- ==================== begin module O7.IntervalRepresentationRanks (formalization/O7/IntervalRepresentationRanks.lean) ====================
section

/-!
Canonical interval representations realized by actual diagonal real matrices.
Vertex-space dimensions and every nonempty consecutive product rank are
computed from the actual matrix rank.  Consequently actual matrix-rank order
implies the previously constructed finite linked-switch path.
-/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open scoped BigOperators

namespace MAIS.IntervalRepresentationRanks

open MAIS.CanonicalPermutation
open MAIS.IntervalPaddingOrder
open MAIS.MatrixRankGeneration

variable {m : ℕ}

abbrev SlotMat (M : Fin m → Fin m → ℕ) := Matrix (RowEvent M) (RowEvent M) ℝ

/-- The actual graded space is the image of this diagonal idempotent. -/
noncomputable def projector (M : Fin m → Fin m → ℕ) (v : ℕ) : SlotMat M :=
  Matrix.diagonal (fun e => if e.1.val ≤ v ∧ v < e.2.1.val then 1 else 0)

/-- An interval slot survives the arrow v→v+1 exactly when both vertices belong to it. -/
noncomputable def arrows (M : Fin m → Fin m → ℕ) (v : ℕ) : SlotMat M :=
  Matrix.diagonal (fun e => if e.1.val ≤ v ∧ v + 1 < e.2.1.val then 1 else 0)

noncomputable def path (M : Fin m → Fin m → ℕ) (i : ℕ) : ℕ → SlotMat M
  | 0 => 1
  | len + 1 => arrows M (i + len) * path M i len

lemma indicator_diagonal_rank {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : ι → Prop) [DecidablePred P] :
    (Matrix.diagonal (fun e => if P e then (1 : ℝ) else 0)).rank =
      ((Finset.univ : Finset ι).filter P).card := by
  classical
  rw [Matrix.rank_diagonal, Fintype.card_subtype]
  congr 1
  ext e
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  by_cases h : P e <;> simp [h]

/-- Actual arrow maps restrict to the actual graded projector images. -/
theorem arrows_supported (M : Fin m → Fin m → ℕ) (i : ℕ) :
    projector M (i + 1) * arrows M i * projector M i = arrows M i := by
  unfold projector arrows
  rw [Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul_diagonal]
  congr 1
  funext e
  split_ifs <;> norm_num at * <;> omega

/-- Vertex dimension is an actual matrix rank, equal to the finite interval coverage count. -/
theorem projector_rank (M : Fin m → Fin m → ℕ) (v : ℕ) :
    (projector M v).rank = crossing M (v + 1) (v + 1) := by
  rw [projector, indicator_diagonal_rank]
  have h := event_count M (fun a k => a.val ≤ v ∧ v < k.val)
  exact h.trans (by simp only [crossing, Nat.lt_succ_iff, Nat.succ_le_iff])

/-- Every nonempty matrix product is the literal diagonal indicator of surviving slots. -/
theorem path_formula (M : Fin m → Fin m → ℕ) (i len : ℕ) :
    path M i (len + 1) = Matrix.diagonal
      (fun e => if e.1.val ≤ i ∧ i + (len + 1) < e.2.1.val then 1 else 0) := by
  induction len with
  | zero => simp [path, arrows]
  | succ len ih =>
    change arrows M (i + (len + 1)) * path M i (len + 1) = _
    rw [ih]
    unfold arrows
    rw [Matrix.diagonal_mul_diagonal]
    congr 1
    funext e
    split_ifs <;> norm_num at * <;> omega

/-- The finite crossing-count formula is derived from actual matrix-product ranks. -/
theorem path_rank (M : Fin m → Fin m → ℕ) (i len : ℕ) :
    (path M i (len + 1)).rank = crossing M (i + 1) (i + (len + 1) + 1) := by
  rw [path_formula, indicator_diagonal_rank]
  have h := event_count M (fun a k => a.val ≤ i ∧ i + (len + 1) < k.val)
  exact h.trans (by simp only [crossing, Nat.lt_succ_iff, Nat.succ_le_iff])

lemma crossing_zero_start (M : Fin m → Fin m → ℕ) (j : ℕ) : crossing M 0 j = 0 := by
  simp only [crossing, Nat.not_lt_zero, false_and, ite_false, Finset.sum_const_zero]

/-- Actual equal vertex dimensions imply the coverage equalities used in padding. -/
theorem coverage_of_actual_dimensions (S R : Fin m → Fin m → ℕ)
    (hdim : ∀ v, (projector S v).rank = (projector R v).rank) :
    ∀ k, crossing S k k = crossing R k k := by
  intro k
  cases k with
  | zero => rw [crossing_zero_start, crossing_zero_start]
  | succ v => simpa only [projector_rank] using hdim v

/-- Actual matrix-product rank order implies every finite crossing-rank inequality. -/
theorem crossing_order_of_actual_ranks (S R : Fin m → Fin m → ℕ)
    (hdim : ∀ v, (projector S v).rank = (projector R v).rank)
    (hrank : ∀ i len, (path S i (len + 1)).rank ≤ (path R i (len + 1)).rank) :
    ∀ i j, i ≤ j → crossing S i j ≤ crossing R i j := by
  intro i j hij
  by_cases hi : i = 0
  · subst i
    rw [crossing_zero_start, crossing_zero_start]
  · by_cases heq : i = j
    · subst j
      exact le_of_eq (coverage_of_actual_dimensions S R hdim i)
    · have hij' : i < j := by omega
      have h := hrank (i - 1) (j - i - 1)
      rw [path_rank, path_rank] at h
      have hstart : i - 1 + 1 = i := by omega
      have hend : i - 1 + (j - i - 1 + 1) + 1 = j := by omega
      simpa only [hstart, hend] using h

/-- All intervals born at a vertex are included in that actual vertex-space dimension. -/
theorem starts_le_projector_rank (M : Fin m → Fin m → ℕ) (a : Fin m) :
    MAIS.TypeAPadding.starts M a ≤ (projector M a.val).rank := by
  rw [projector_rank]
  have hrow : (∑ k, if a.val < a.val + 1 ∧ a.val + 1 ≤ k.val then M a k else 0) =
      MAIS.TypeAPadding.starts M a := by
    simp only [Nat.lt_add_one, true_and, Nat.succ_le_iff,
      MAIS.TypeAPadding.starts, Finset.sum_filter, Fin.lt_def]
  rw [← hrow]
  unfold crossing
  exact Finset.single_le_sum (f := fun r : Fin m => ∑ k,
    if r.val < a.val + 1 ∧ a.val + 1 ≤ k.val then M r k else 0)
    (fun _ _ => Nat.zero_le _) (Finset.mem_univ a)

/-- A concrete common padding size, computed from actual vertex-space dimensions. -/
noncomputable def paddingBound (M : Fin m → Fin m → ℕ) : ℕ :=
  1 + ∑ v : Fin m, (projector M v.val).rank

lemma starts_le_paddingBound (M : Fin m → Fin m → ℕ) (a : Fin m) :
    MAIS.TypeAPadding.starts M a ≤ paddingBound M := by
  have h := starts_le_projector_rank M a
  have hs : (projector M a.val).rank ≤ ∑ v : Fin m, (projector M v.val).rank :=
    Finset.single_le_sum (f := fun v : Fin m => (projector M v.val).rank)
      (fun _ _ => Nat.zero_le _) (Finset.mem_univ a)
  unfold paddingBound
  omega

/-- Actual canonical interval matrix-rank order generates the full finite linked-switch path.
    No abstract rank-array formula is assumed: both dimension and product-rank hypotheses
    are hypotheses about actual real matrices, and the padding size is explicit. -/
theorem actual_rank_order_generates (S R : Fin m → Fin m → ℕ)
    (hdim : ∀ v, (projector S v).rank = (projector R v).rank)
    (hrank : ∀ i len, (path S i (len + 1)).rank ≤ (path R i (len + 1)).rank) :
    Relation.ReflTransGen
      (BoundedLinkedSwitch
        (MAIS.TypeAPadding.padding R (paddingBound S))
        (MAIS.TypeAPadding.padding S (paddingBound S)))
      (MAIS.TypeAPadding.padding S (paddingBound S))
      (MAIS.TypeAPadding.padding R (paddingBound S)) := by
  apply interval_rank_order_generated S R (paddingBound S)
  · exact starts_le_paddingBound S
  · intro a
    have h := starts_le_projector_rank R a
    rw [← hdim a.val] at h
    have hs : (projector S a.val).rank ≤ ∑ v : Fin m, (projector S v.val).rank :=
      Finset.single_le_sum (f := fun v : Fin m => (projector S v.val).rank)
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ a)
    unfold paddingBound
    omega
  · exact coverage_of_actual_dimensions S R hdim
  · exact crossing_order_of_actual_ranks S R hdim hrank

end MAIS.IntervalRepresentationRanks





/--
info: 'MAIS.IntervalRepresentationRanks.projector_rank' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.IntervalRepresentationRanks.projector_rank

/--
info: 'MAIS.IntervalRepresentationRanks.path_rank' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.IntervalRepresentationRanks.path_rank

/--
info: 'MAIS.IntervalRepresentationRanks.actual_rank_order_generates' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.IntervalRepresentationRanks.actual_rank_order_generates
end
-- ==================== end module O7.IntervalRepresentationRanks ====================

-- ==================== begin module O7.CanonicalActiveIntervals (formalization/O7/CanonicalActiveIntervals.lean) ====================
section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
namespace MAIS.CanonicalActiveIntervals

open scoped Matrix
open MAIS.CanonicalPermutation MAIS.IntervalPaddingOrder
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.GenericActiveRestriction

variable {m : ℕ}

noncomputable section

def active (M : Fin m → Fin m → ℕ) (D : ℕ) (v : Fin (D + 1)) (s : RowEvent M) : Prop :=
  s.1.val ≤ v.val ∧ v.val < s.2.1.val

instance active_decidable (M : Fin m → Fin m → ℕ) (D : ℕ) (v : Fin (D + 1)) (s : RowEvent M) :
    Decidable (active M D v s) := by unfold active; infer_instance

abbrev ActiveIndex (M : Fin m → Fin m → ℕ) (D : ℕ) : Fin (D + 1) → Type :=
  RestrictedIndex (active M D)

def fullRep (M : Fin m → Fin m → ℕ) (D : ℕ) : Rep (fun _ : Fin (D + 1) => RowEvent M) :=
  fun e => MAIS.IntervalRepresentationRanks.arrows M e.val

/-- Actual canonical interval maps on exactly their actual active coordinate spaces. -/
def canonicalRep (M : Fin m → Fin m → ℕ) (D : ℕ) : Rep (ActiveIndex M D) :=
  restrictRep (active M D) (fullRep M D)

lemma fullRep_rows_zero (M : Fin m → Fin m → ℕ) (D : ℕ) (e : Fin D)
    (r : RowEvent M) (hr : ¬ active M D e.succ r) (k : RowEvent M) :
    fullRep M D e r k = 0 := by
  by_cases heq : r = k
  · subst k
    have hn : ¬ (r.1.val ≤ e.val ∧ e.val + 1 < r.2.1.val) := by
      intro h
      apply hr
      change r.1.val ≤ e.val + 1 ∧ e.val + 1 < r.2.1.val
      exact ⟨by omega, h.2⟩
    simp [fullRep, MAIS.IntervalRepresentationRanks.arrows, hn]
  · simp [fullRep, MAIS.IntervalRepresentationRanks.arrows, heq]

lemma fullRep_cols_zero (M : Fin m → Fin m → ℕ) (D : ℕ) (e : Fin D)
    (k : RowEvent M) (hk : ¬ active M D e.castSucc k) (r : RowEvent M) :
    fullRep M D e r k = 0 := by
  by_cases heq : r = k
  · subst r
    have hn : ¬ (k.1.val ≤ e.val ∧ e.val + 1 < k.2.1.val) := by
      intro h
      apply hk
      change k.1.val ≤ e.val ∧ e.val < k.2.1.val
      exact ⟨h.1, by omega⟩
    simp [fullRep, MAIS.IntervalRepresentationRanks.arrows, hn]
  · simp [fullRep, MAIS.IntervalRepresentationRanks.arrows, heq]

/-- Actual canonical vertex dimensions are the original finite interval coverage counts. -/
theorem active_card (M : Fin m → Fin m → ℕ) (D : ℕ) (v : Fin (D + 1)) :
    Fintype.card (ActiveIndex M D v) = crossing M (v.val + 1) (v.val + 1) := by
  have h := MAIS.IntervalRepresentationRanks.projector_rank M v.val
  rw [MAIS.IntervalRepresentationRanks.projector,
    MAIS.IntervalRepresentationRanks.indicator_diagonal_rank] at h
  simpa only [ActiveIndex, RestrictedIndex, active, Fintype.card_subtype] using h

/-- The all-path construction is exactly the ordinary chronological product of the actual
    diagonal interval arrows. -/
theorem full_path_formula (M : Fin m → Fin m → ℕ) (D i len : ℕ) (hbound : i + len ≤ D) :
    pathMatrix (fullRep M D) ⟨i, by omega⟩ ⟨i + len, by omega⟩
      (by change i ≤ i + len; omega) = MAIS.IntervalRepresentationRanks.path M i len := by
  induction len with
  | zero =>
    change pathMatrix (fullRep M D) ⟨i, by omega⟩ ⟨i, by omega⟩ le_rfl = _
    rw [pathMatrix_self]
    rfl
  | succ len ih =>
    let e : Fin D := ⟨i + len, by omega⟩
    have hbound' : i + len ≤ D := by omega
    have hc := pathMatrix_comp (fullRep M D) (⟨i, by omega⟩ : Fin (D + 1))
      e.castSucc e.succ (by change i ≤ i + len; omega) (by exact Nat.le_succ e.val)
    change pathMatrix (fullRep M D) ⟨i, by omega⟩ e.succ _ = _
    rw [← hc, pathMatrix_arrow]
    erw [ih hbound']
    rfl

/-- Every positive actual canonical path rank is the finite interval crossing count. -/
theorem canonical_path_rank_nat (M : Fin m → Fin m → ℕ) (D i len : ℕ)
    (hbound : i + (len + 1) ≤ D) :
    (pathMatrix (canonicalRep M D) ⟨i, by omega⟩ ⟨i + (len + 1), by omega⟩
      (by change i ≤ i + (len + 1); omega)).rank =
        crossing M (i + 1) (i + (len + 1) + 1) := by
  rw [canonicalRep, path_rank_restrict (active M D) (fullRep M D)
    (fullRep_rows_zero M D) (fullRep_cols_zero M D) _ _
      (show (⟨i, by omega⟩ : Fin (D + 1)) < ⟨i + (len + 1), by omega⟩ by
        change i < i + (len + 1); omega)]
  rw [full_path_formula M D i (len + 1) hbound]
  exact MAIS.IntervalRepresentationRanks.path_rank M i len

/-- Actual arbitrary finite-vertex paths have exactly their original interval crossing ranks. -/
theorem canonical_path_rank (M : Fin m → Fin m → ℕ) (D : ℕ)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (canonicalRep M D) i j hij).rank =
      crossing M (i.val + 1) (j.val + 1) := by
  by_cases heq : i = j
  · subst j
    rw [pathMatrix_self, Matrix.rank_one, active_card]
  · have hij' : i.val ≤ j.val := hij
    have hne : i.val ≠ j.val := fun h => heq (Fin.ext h)
    obtain ⟨len, hv⟩ : ∃ len : ℕ, i.val + (len + 1) = j.val := by
      refine ⟨j.val - i.val - 1, ?_⟩
      omega
    have hb : i.val + (len + 1) ≤ D := by rw [hv]; exact Nat.le_of_lt_succ j.isLt
    have h := canonical_path_rank_nat M D i.val len hb
    rcases j with ⟨jval, hjval⟩
    change i.val + (len + 1) = jval at hv
    subst jval
    simpa only [Fin.eta] using h

end
end MAIS.CanonicalActiveIntervals

/-- info: 'MAIS.CanonicalActiveIntervals.canonical_path_rank' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.CanonicalActiveIntervals.canonical_path_rank
end
-- ==================== end module O7.CanonicalActiveIntervals ====================

-- ==================== begin module O7.CanonicalCoordinateRepresentatives (formalization/O7/CanonicalCoordinateRepresentatives.lean) ====================
section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
universe w
namespace MAIS.CanonicalCoordinateRepresentatives

open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.MatrixCoordinateTransport
open MAIS.CanonicalActiveIntervals MAIS.IntervalPaddingOrder
variable {D m : ℕ} {ι : Fin (D + 1) → Type w}
variable [∀ i, Fintype (ι i)] [∀ i, DecidableEq (ι i)]

noncomputable def vertexEquiv (M : Fin m → Fin m → ℕ)
    (hdim : ∀ i : Fin (D + 1), crossing M (i.val + 1) (i.val + 1) = Fintype.card (ι i))
    (i : Fin (D + 1)) : ActiveIndex M D i ≃ ι i :=
  Fintype.equivOfCardEq ((active_card M D i).trans (hdim i))

/-- An actual real matrix representative of the actual interval multiplicity array,
    in any prescribed coordinate spaces with the correct actual dimensions. -/
noncomputable def representative (M : Fin m → Fin m → ℕ)
    (hdim : ∀ i : Fin (D + 1), crossing M (i.val + 1) (i.val + 1) = Fintype.card (ι i)) : Rep ι :=
  transport (vertexEquiv M hdim) (canonicalRep M D)

/-- Every actual product rank of the transported representative is the derived crossing count. -/
theorem representative_path_rank (M : Fin m → Fin m → ℕ)
    (hdim : ∀ i : Fin (D + 1), crossing M (i.val + 1) (i.val + 1) = Fintype.card (ι i))
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (representative M hdim) i j hij).rank =
      crossing M (i.val + 1) (j.val + 1) := by
  rw [representative, path_rank_transport]
  exact canonical_path_rank M D i j hij

/-- Actual interval coverage supplies actual real matrices with all the desired actual ranks. -/
theorem exists_representative (M : Fin m → Fin m → ℕ)
    (hdim : ∀ i : Fin (D + 1), crossing M (i.val + 1) (i.val + 1) = Fintype.card (ι i)) :
    ∃ A : Rep ι, ∀ i j (hij : i ≤ j), (pathMatrix A i j hij).rank =
      crossing M (i.val + 1) (j.val + 1) :=
  ⟨representative M hdim, representative_path_rank M hdim⟩

end MAIS.CanonicalCoordinateRepresentatives

/-- info: 'MAIS.CanonicalCoordinateRepresentatives.exists_representative' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.CanonicalCoordinateRepresentatives.exists_representative
end
-- ==================== end module O7.CanonicalCoordinateRepresentatives ====================

-- ==================== begin module O7.LinkedSwitchOrbitClosure (formalization/O7/LinkedSwitchOrbitClosure.lean) ====================
section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
universe w
namespace MAIS.LinkedSwitchOrbitClosure

open scoped Matrix
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.MatrixCoordinateTransport
open MAIS.QuiverDirectSumRanks MAIS.MatrixBlockProjection MAIS.IntervalPaddingOrder
open MAIS.LinkedSwitchDecomposition MAIS.ElementaryActiveRanks MAIS.ActiveIntervalFamily
open MAIS.CanonicalActiveIntervals

variable {D m : ℕ} {ι : Fin (D + 1) → Type w}
variable [∀ i, Fintype (ι i)] [∀ i, DecidableEq (ι i)]

/-- Every actual linked interval switch gives the required ordinary real Euclidean
    orbit-closure inclusion for arbitrary actual matrices with the corresponding ranks. -/
theorem linked_switch_orbit_closure (M N : Fin m → Fin m → ℕ) (hswitch : LinkedSwitch M N)
    (A B : Rep ι)
    (hA : ∀ i j (hij : i ≤ j), (pathMatrix A i j hij).rank =
      crossing M (i.val + 1) (j.val + 1))
    (hB : ∀ i j (hij : i ≤ j), (pathMatrix B i j hij).rank =
      crossing N (i.val + 1) (j.val + 1)) :
    A ∈ closure (MulAction.orbit (Gauge ι) B) := by
  classical
  obtain ⟨a, b, c, d, T, hab, hbc, hcd, hM, hN⟩ :=
    linked_spectator_decomposition M N hswitch
  have hab' : a.val < b.val := hab
  have hbc' : b.val ≤ c.val := hbc
  have hcd' : c.val < d.val := hcd
  have hc : 0 < c.val := by omega
  have hd : 0 < d.val := by omega
  let K : Fin (D + 1) → Type := fun v =>
    MAIS.ActiveIntervalFamily.ActiveIndex D a.val (c.val - 1) b.val (d.val - 1) v ⊕
      MAIS.CanonicalActiveIntervals.ActiveIndex T D v
  let S0 : Rep K := directSum (splitActive D a.val (c.val - 1) b.val (d.val - 1))
    (canonicalRep T D)
  let S1 : Rep K := directSum (activeFamily D a.val b.val (c.val - 1) (d.val - 1) 1)
    (canonicalRep T D)
  have hR0 : ∀ i j (hij : i ≤ j), (pathMatrix S0 i j hij).rank =
      crossing M (i.val + 1) (j.val + 1) := by
    intro i j hij
    dsimp only [S0]
    rw [path_rank_directSum, split_path_rank_cells D a b c d hab hbc hcd,
      canonical_path_rank T D i j hij, crossing_add, hM, crossing_add, crossing_add]
    omega
  have hR1 : ∀ i j (hij : i ≤ j), (pathMatrix S1 i j hij).rank =
      crossing N (i.val + 1) (j.val + 1) := by
    intro i j hij
    dsimp only [S1]
    rw [path_rank_directSum, nonzero_path_rank_cells D a b c d 1 one_ne_zero hab hbc hcd,
      canonical_path_rank T D i j hij, crossing_add, hN, crossing_add, crossing_add]
    omega
  let e : ∀ v, K v ≃ ι v := fun v => Fintype.equivOfCardEq (by
    have h0 := hR0 v v le_rfl
    have ha := hA v v le_rfl
    rw [pathMatrix_self, Matrix.rank_one] at h0 ha
    exact h0.trans ha.symm)
  have hcl : S0 ∈ closure (MulAction.orbit (Gauge K) S1) := by
    exact add_spectator_mem_closure_orbit (canonicalRep T D)
      (splitActive_mem_closure_gauge_orbit D a.val b.val (c.val - 1) (d.val - 1)
        hab' (by omega) (by omega))
  have hcl' := transport_mem_closure_orbit e hcl
  apply closure_transfer_of_path_rank_eq hcl'
  · intro i j hij
    rw [path_rank_transport, hR0 i j hij, hA i j hij]
  · intro i j hij
    rw [path_rank_transport, hR1 i j hij, hB i j hij]

end MAIS.LinkedSwitchOrbitClosure

/-- info: 'MAIS.LinkedSwitchOrbitClosure.linked_switch_orbit_closure' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinkedSwitchOrbitClosure.linked_switch_orbit_closure
end
