-- ==================== begin module O7.ActiveIntervalGaussianCancellation (formalization/O7/ActiveIntervalGaussianCancellation.lean) ====================
section

/-! Actual reverse Gaussian elimination at every residual zero, using
literal global analytic Gaussian coordinates and actual Haar pairs. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
namespace MAIS.ActiveIntervalGaussianCancellation
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.AnalyticTransfer
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s≤D+1)

/-- A genuine normal-family pair at the actual Gaussian-eliminated point
proves existence of the local residual pair at any actual residual zero.
The regular dimension is derived from the actual direct coordinate set. -/
theorem residual_pair_of_normal_pair
    (muT:Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR:Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    (z:Residual D birth death) (hz:residualLoss D birth death hD z=0)
    {a:ℝ} {m:ℕ}
    (hp:HasMeasuredBandPair muT
      (Metric.ball (gaussianHomeomorph D birth death hD (z,0)))
      (normalSquaredLoss D birth death hD) (gaussianHomeomorph D birth death hD (z,0)) a m) :
    HasMeasuredBandPair muR (Metric.ball z) (residualLoss D birth death hD) z
      (a-(Fintype.card (DirectIndex D birth death):ℝ)/2) m := by
  let Q:=Regular D birth death
  let muQ:Measure Q:=addHaar
  let e:OpenPartialHomeomorph (Residual D birth death×Q) (NormalParams birth death):=
    (gaussianHomeomorph D birth death hD).toOpenPartialHomeomorph
  let f:Residual D birth death×Q→ℝ:=fun p=>residualLoss D birth death hD p.1+‖p.2‖^2
  have hf:Measurable f:=
    ((continuous_residualLoss D birth death hD).comp continuous_fst).measurable.add
      (continuous_snd.norm.pow 2).measurable
  have hchart:=MAIS.CrossCarrierChartTransfer.pair_iff_of_chart_local
    (muR.prod muQ) muT e (w:=(z,0)) (by trivial)
    (analyticAt_gaussianHomeomorph D birth death hD (z,0)).contDiffAt
    (analyticAt_gaussianHomeomorph_symm D birth death hD
      (gaussianHomeomorph D birth death hD (z,0))).contDiffAt
    hf (continuous_normalSquaredLoss D birth death hD).measurable
    (fun p _=>(normalSquaredLoss_gaussianHomeomorph D birth death hD p).symm)
    (lam:=a) (m:=m)
  have hsum:=hchart.mpr hp
  have hc:=MAIS.RegularSquareCancellation.pair_of_quadratic_sum muQ hsum
    zero_lt_one (fun x _=>by rw [hz,sub_zero];exact residualLoss_nonneg D birth death hD x)
  have hdim:Module.finrank ℝ Q=Fintype.card (DirectIndex D birth death):=
    finrank_regular D birth death
  simpa only [hdim] using hc

end MAIS.ActiveIntervalGaussianCancellation
end

/-- info: 'MAIS.ActiveIntervalGaussianCancellation.residual_pair_of_normal_pair' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalGaussianCancellation.residual_pair_of_normal_pair
end
