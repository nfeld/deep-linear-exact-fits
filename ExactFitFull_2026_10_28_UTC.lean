-- ==================== begin module O7.WeightedDyadicBandIdentity (formalization/O7/WeightedDyadicBandIdentity.lean) ====================
section

/-! Exact actual dyadic annulus-band series in a weighted coordinate box.
The origin is retained explicitly until an actual non-atomic hypothesis is
used; zero-dimensional Haar atoms are therefore handled honestly. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000
noncomputable section
open Set MeasureTheory
open scoped ENNReal Topology
namespace MAIS.WeightedDyadicBandIdentity
open MAIS.WeightedDyadicShells
variable {I:Type*} [Fintype I] [DecidableEq I]

def bandOn (mu:Measure (I→ℝ)) (U:Set (I→ℝ)) (f:(I→ℝ)→ℝ) (eps:ℝ) : ℝ≥0∞ :=
  mu {x|x∈U ∧ f x<eps}

omit [Fintype I] [DecidableEq I] in
theorem bandOn_monotone (mu:Measure (I→ℝ)) (U:Set (I→ℝ)) (f:(I→ℝ)→ℝ) :
    Monotone (bandOn mu U f) := by
  intro a b hab
  apply measure_mono
  intro x hx
  exact ⟨hx.1,hx.2.trans_le hab⟩

omit [Fintype I] [DecidableEq I] in
/-- Exact image identity for the literal sublevel portion of the actual
    fixed annulus, derived from actual homogeneous loss covariance. -/
theorem image_annulus_band (W:I→ℕ) (d:ℕ) (f:(I→ℝ)→ℝ)
    (hhom:∀ r:ℝ,0<r→∀ x,f (dilation W r x)=r^d*f x)
    (r:ℝ) (hr:0<r) (eps:ℝ) :
    dilation W r '' {x|x∈annulus W ∧ f x<eps/r^d}=
      {x|x∈dilation W r '' annulus W ∧ f x<eps} := by
  ext x
  constructor
  · rintro ⟨y,hy,rfl⟩
    refine ⟨⟨y,hy.1,rfl⟩,?_⟩
    rw [hhom r hr y]
    simpa only [mul_comm] using (lt_div_iff₀ (pow_pos hr d)).mp hy.2
  · rintro ⟨⟨y,hy,rfl⟩,hfy⟩
    refine ⟨y,⟨hy,?_⟩,rfl⟩
    apply (lt_div_iff₀ (pow_pos hr d)).mpr
    simpa only [hhom r hr y,mul_comm] using hfy

private theorem div_dyadic_power (eps:ℝ) (k d:ℕ) :
    eps/(((1/2:ℝ)^k)^d)=eps*(2^d)^k := by
  simp [div_eq_mul_inv,← pow_mul,Nat.mul_comm]

/-- The exact actual k-th shell contribution, including its derived Haar
    weight and its literal rescaled loss level. -/
theorem shell_band (mu:Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (W:I→ℕ) (d:ℕ) (f:(I→ℝ)→ℝ)
    (hhom:∀ r:ℝ,0<r→∀ x,f (dilation W r x)=r^d*f x)
    (k:ℕ) (eps:ℝ) :
    bandOn mu (shell W k) f eps=
      ENNReal.ofReal (((1/2:ℝ)^(∑ i,W i))^k)*
        bandOn mu (annulus W) f (eps*(2^d)^k) := by
  have hr:0<(1/2:ℝ)^k:=pow_pos (by norm_num) _
  have hi:=image_annulus_band W d f hhom ((1/2:ℝ)^k) hr eps
  rw [dyadic_shell_image] at hi
  unfold bandOn
  rw [← hi,measure_dilation_image mu W _ hr,div_dyadic_power]
  rw [← pow_mul,← pow_mul,Nat.mul_comm k]
  simp only [pow_mul]

/-- Literal box sublevel mass off the origin is exactly the actual disjoint
    shell series. No annulus pair or integration formula is supplied. -/
theorem box_band_off_origin (mu:Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (W:I→ℕ) (hW:∀ i,0<W i) (d:ℕ) (f:(I→ℝ)→ℝ) (hf:Measurable f)
    (hhom:∀ r:ℝ,0<r→∀ x,f (dilation W r x)=r^d*f x) (eps:ℝ) :
    mu {x|x∈box W 0 ∧ x≠0 ∧ f x<eps}=
      ∑' k:ℕ,ENNReal.ofReal (((1/2:ℝ)^(∑ i,W i))^k)*
        bandOn mu (annulus W) f (eps*(2^d)^k) := by
  have he:{x|x∈box W 0 ∧ x≠0 ∧ f x<eps}=
      ⋃ k:ℕ,{x|x∈shell W k ∧ f x<eps} := by
    ext x
    rw [Set.mem_ofPred_eq,Set.mem_iUnion]
    constructor
    · intro hx
      have hu:x∈⋃ k:ℕ,shell W k:=by
        rw [iUnion_shell W hW]
        exact ⟨hx.1,by simpa only [Set.mem_singleton_iff] using hx.2.1⟩
      obtain ⟨k,hk⟩:=Set.mem_iUnion.mp hu
      exact ⟨k,hk,hx.2.2⟩
    · rintro ⟨k,hk,hfx⟩
      have hu:x∈box W 0 \ {(0:I→ℝ)}:=by
        rw [← iUnion_shell W hW]
        exact Set.mem_iUnion.mpr ⟨k,hk⟩
      exact ⟨hu.1,by simpa only [Set.mem_singleton_iff] using hu.2,hfx⟩
  rw [he,measure_iUnion]
  · congr 1
    funext k
    exact shell_band mu W d f hhom k eps
  · intro k l hkl
    exact (shell_pairwise_disjoint W hkl).mono (fun x hx=>hx.1) (fun x hx=>hx.1)
  · intro k
    exact ((measurableSet_box W k).diff (measurableSet_box W (k+1))).inter
      (hf measurableSet_Iio)

/-- For a genuinely non-atomic ambient Haar measure the origin drops out
    by its proved zero mass, giving the complete literal box band series. -/
theorem box_band (mu:Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu] [NullSingletonClass mu]
    (W:I→ℕ) (hW:∀ i,0<W i) (d:ℕ) (f:(I→ℝ)→ℝ) (hf:Measurable f)
    (hhom:∀ r:ℝ,0<r→∀ x,f (dilation W r x)=r^d*f x) (eps:ℝ) :
    bandOn mu (box W 0) f eps=
      ∑' k:ℕ,ENNReal.ofReal (((1/2:ℝ)^(∑ i,W i))^k)*
        bandOn mu (annulus W) f (eps*(2^d)^k) := by
  rw [← box_band_off_origin mu W hW d f hf hhom eps]
  unfold bandOn
  have he:{x|x∈box W 0 ∧ x≠0 ∧ f x<eps}=
      {x|x∈box W 0 ∧ f x<eps} \ {(0:I→ℝ)} := by
    ext x
    simp only [Set.mem_ofPred_eq,Set.mem_sdiff,Set.mem_singleton_iff]
    tauto
  rw [he,measure_sdiff_null (measure_singleton (0:I→ℝ))]

end MAIS.WeightedDyadicBandIdentity
end

/-- info: 'MAIS.WeightedDyadicBandIdentity.image_annulus_band' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedDyadicBandIdentity.image_annulus_band

/-- info: 'MAIS.WeightedDyadicBandIdentity.shell_band' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedDyadicBandIdentity.shell_band

/-- info: 'MAIS.WeightedDyadicBandIdentity.box_band_off_origin' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedDyadicBandIdentity.box_band_off_origin

/-- info: 'MAIS.WeightedDyadicBandIdentity.box_band' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedDyadicBandIdentity.box_band
end
-- ==================== end module O7.WeightedDyadicBandIdentity ====================

-- ==================== begin module O7.WeightedCompactAnnulus (formalization/O7/WeightedCompactAnnulus.lean) ====================
section

/-! Actual compact weighted annulus and exact null-boundary comparison
with the half-open annulus used by the disjoint shell partition. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 500000
noncomputable section
open Set MeasureTheory
open scoped ENNReal Topology
namespace MAIS.WeightedCompactAnnulus
open MAIS.WeightedDyadicShells MAIS.WeightedDyadicBandIdentity
variable {I:Type*} [Fintype I] [DecidableEq I]

def openBox (W:I→ℕ) (k:ℕ) : Set (I→ℝ):={x|∀ i,|x i|<(1/2:ℝ)^(k*W i)}
def compactAnnulus (W:I→ℕ) : Set (I→ℝ):=box W 0 \ openBox W 1

omit [DecidableEq I] in
theorem isOpen_openBox (W:I→ℕ) (k:ℕ) : IsOpen (openBox W k) := by
  have he:openBox W k=⋂ i,{x:I→ℝ | |x i|<(1/2:ℝ)^(k*W i)}:=by
    ext x
    simp [openBox]
  rw [he]
  exact isOpen_iInter_of_finite (fun i=>isOpen_lt
    (continuous_apply i : Continuous (fun x:I→ℝ=>x i)).abs continuous_const)

omit [Fintype I] [DecidableEq I] in
theorem isCompact_box (W:I→ℕ) (k:ℕ) : IsCompact (box W k) := by
  have he:box W k=Set.pi Set.univ (fun i=>Set.Icc (-((1/2:ℝ)^(k*W i))) ((1/2:ℝ)^(k*W i))):=by
    ext x
    simp [box,abs_le,Pi.le_def,forall_and]
  rw [he]
  exact isCompact_univ_pi (fun _=>isCompact_Icc)

omit [DecidableEq I] in
theorem isCompact_compactAnnulus (W:I→ℕ) : IsCompact (compactAnnulus W) :=
  (isCompact_box W 0).diff (isOpen_openBox W 1)

omit [Fintype I] [DecidableEq I] in
theorem annulus_subset_compactAnnulus (W:I→ℕ) : annulus W⊆compactAnnulus W := by
  intro x hx
  refine ⟨hx.1,?_⟩
  intro ho
  apply hx.2
  intro i
  exact (ho i).le

/-- Every actual coordinate affine hyperplane has zero additive Haar measure. -/
theorem coordinate_hyperplane_null (mu:Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (i:I) (c:ℝ) : mu {x|x i=c}=0 := by
  let P:AffineSubspace ℝ (I→ℝ):=AffineSubspace.mk' (Pi.single i c)
    (LinearMap.ker (LinearMap.proj i))
  have he:(P:Set (I→ℝ))={x|x i=c}:=by
    ext x
    simp [P,AffineSubspace.mem_mk',LinearMap.mem_ker,sub_eq_zero]
  have hp:P≠⊤:=by
    intro h
    have hm:Pi.single i (c+1)∈P:=by rw [h];trivial
    change Pi.single i (c+1)∈(P:Set (I→ℝ)) at hm
    rw [he] at hm
    simp only [Set.mem_ofPred_eq,Pi.single_eq_same] at hm
    linarith
  rw [← he]
  exact mu.addHaar_affineSubspace P hp

/-- The compact annulus adds only actual coordinate faces of zero Haar
    measure to the half-open annulus used for disjoint shells. -/
theorem compactAnnulus_sdiff_annulus_null (mu:Measure (I→ℝ))
    [Measure.IsAddHaarMeasure mu] (W:I→ℕ) :
    mu (compactAnnulus W \ annulus W)=0 := by
  classical
  have hsub:compactAnnulus W \ annulus W⊆
      ⋃ i:I,({x:I→ℝ|x i=(1/2:ℝ)^(W i)}∪{x:I→ℝ|x i= -((1/2:ℝ)^(W i))}):=by
    intro x hx
    have hc:x∈box W 1:=by
      by_contra hn
      exact hx.2 ⟨hx.1.1,hn⟩
    have ho:¬∀ i,|x i|<(1/2:ℝ)^(W i):=by
      have hh:=hx.1.2
      change ¬∀ i,|x i|<(1/2:ℝ)^(1*W i) at hh
      simpa only [Nat.one_mul] using hh
    push Not at ho
    obtain ⟨i,hi⟩:=ho
    have he:|x i|=(1/2:ℝ)^(W i):=le_antisymm (by simpa only [box,Nat.one_mul] using hc i) hi
    apply Set.mem_iUnion.mpr
    refine ⟨i,?_⟩
    by_cases hxi:0≤x i
    · left
      simpa only [Set.mem_ofPred_eq,abs_of_nonneg hxi] using he
    · right
      have hn:x i<0:=lt_of_not_ge hxi
      rw [abs_of_neg hn] at he
      change x i= -((1/2:ℝ)^(W i))
      linarith
  apply measure_mono_null hsub
  apply measure_iUnion_null
  intro i
  exact measure_union_null (coordinate_hyperplane_null mu i _) (coordinate_hyperplane_null mu i _)

/-- Actual compact and half-open annulus bands have exactly equal measure,
    for every literal loss and every level; no pair assumption is used. -/
theorem bandOn_compactAnnulus (mu:Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (W:I→ℕ) (f:(I→ℝ)→ℝ) (eps:ℝ) :
    bandOn mu (compactAnnulus W) f eps=bandOn mu (annulus W) f eps := by
  unfold bandOn
  symm
  apply measure_eq_measure_of_null_sdiff
  · intro x hx
    exact ⟨annulus_subset_compactAnnulus W hx.1,hx.2⟩
  · apply measure_mono_null _ (compactAnnulus_sdiff_annulus_null mu W)
    intro x hx
    refine ⟨hx.1.1,?_⟩
    intro ha
    exact hx.2 ⟨ha,hx.1.2⟩

omit [Fintype I] [DecidableEq I] in
theorem zero_not_mem_compactAnnulus (W:I→ℕ) : (0:I→ℝ)∉compactAnnulus W := by
  intro h
  apply h.2
  intro i
  simp only [Pi.zero_apply,abs_zero]
  positivity

end MAIS.WeightedCompactAnnulus
end

/-- info: 'MAIS.WeightedCompactAnnulus.isCompact_compactAnnulus' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedCompactAnnulus.isCompact_compactAnnulus

/-- info: 'MAIS.WeightedCompactAnnulus.coordinate_hyperplane_null' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedCompactAnnulus.coordinate_hyperplane_null

/-- info: 'MAIS.WeightedCompactAnnulus.compactAnnulus_sdiff_annulus_null' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedCompactAnnulus.compactAnnulus_sdiff_annulus_null

/-- info: 'MAIS.WeightedCompactAnnulus.bandOn_compactAnnulus' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedCompactAnnulus.bandOn_compactAnnulus

/-- info: 'MAIS.WeightedCompactAnnulus.zero_not_mem_compactAnnulus' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedCompactAnnulus.zero_not_mem_compactAnnulus
end
