-- ==================== begin module O7.ActiveIntervalPivotRanks (formalization/O7/ActiveIntervalPivotRanks.lean) ====================
section

/-! Actual labelled interval-path rank and augmented pivot minor vanishing.
The rank counts literal labels spanning both path endpoints. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2500000
noncomputable section

namespace MAIS.ActiveIntervalPivotRanks
open Matrix MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalBasePaths MAIS.MatrixChainIsomorphism

variable {S : Type*} [Fintype S] [DecidableEq S]

abbrev Common (D : ℕ) (birth death : S → ℕ) (i j : Fin (D + 1)) :=
  {s : S // active D birth death i s ∧ active D birth death j s}

def commonRow (D : ℕ) (birth death : S → ℕ) (i j : Fin (D + 1))
    (s : Common D birth death i j) : Index D birth death j := ⟨s.val, s.property.2⟩

def commonCol (D : ℕ) (birth death : S → ℕ) (i j : Fin (D + 1))
    (s : Common D birth death i j) : Index D birth death i := ⟨s.val, s.property.1⟩

lemma common_submatrix_eq_one (D : ℕ) (birth death : S → ℕ)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (intervalRep D birth death) i j hij).submatrix
      (commonRow D birth death i j) (commonCol D birth death i j) = 1 := by
  classical
  ext r s
  rw [Matrix.submatrix_apply, pathMatrix_intervalRep_entry, Matrix.one_apply]
  simp only [commonRow, commonCol, Subtype.ext_iff]

/-- Literal path rank equals the number of actual labels surviving both
endpoints, with no supplied rank formula or barcode invariant. -/
theorem path_rank_eq_common_card (D : ℕ) (birth death : S → ℕ)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (intervalRep D birth death) i j hij).rank =
      Fintype.card (Common D birth death i j) := by
  classical
  let P := pathMatrix (intervalRep D birth death) i j hij
  have hlower : Fintype.card (Common D birth death i j) ≤ P.rank := by
    have h := Matrix.rank_submatrix_le P (commonRow D birth death i j) (commonCol D birth death i j)
    rw [common_submatrix_eq_one, Matrix.rank_one] at h
    exact h
  let rows : Finset (Index D birth death j) := Finset.univ.filter
    (fun r => active D birth death i r.val)
  have hsupport : Function.support P.row ⊆ rows := by
    intro r hr
    by_contra hnot
    have hni : ¬ active D birth death i r.val := by
      intro hi
      exact hnot (Finset.mem_filter.mpr ⟨Finset.mem_univ r, hi⟩)
    have hzero : P.row r = 0 := by
      funext s
      change pathMatrix (intervalRep D birth death) i j hij r s = 0
      rw [pathMatrix_intervalRep_entry]
      have hne : r.val ≠ s.val := by
        intro heq
        exact hni (heq.symm ▸ s.property)
      simp only [ite_eq_right hne]
    exact hr hzero
  let e : {r : Index D birth death j // r ∈ rows} ≃ Common D birth death i j :=
    { toFun r := ⟨r.val.val, (Finset.mem_filter.mp r.property).2, r.val.property⟩
      invFun s := ⟨commonRow D birth death i j s,
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, s.property.1⟩⟩
      left_inv := by intro r; apply Subtype.ext; rfl
      right_inv := by intro s; rfl }
  have hcard : rows.card = Fintype.card (Common D birth death i j) :=
    (Fintype.card_coe rows).symm.trans (Fintype.card_congr e)
  have hupper := Matrix.rank_le_card_of_support_subset P rows hsupport
  rw [hcard] at hupper
  exact le_antisymm hupper hlower

/-- Every augmented square minor of size card K + 1 vanishes at actual
rank at most card K. Row/column index maps need no injectivity assumption. -/
theorem det_option_submatrix_eq_zero_of_rank_le {R C K : Type*}
    [Fintype R] [Fintype C] [Fintype K] [DecidableEq K]
    (M : Matrix R C ℝ) (rows : Option K → R) (cols : Option K → C)
    (hRank : M.rank ≤ Fintype.card K) :
    (M.submatrix rows cols).det = 0 := by
  classical
  by_contra hdet
  have hfull := Matrix.rank_of_det_ne_zero hdet
  have hle := (Matrix.rank_submatrix_le M rows cols).trans hRank
  rw [hfull, Fintype.card_option] at hle
  omega

end MAIS.ActiveIntervalPivotRanks

/--
info: 'MAIS.ActiveIntervalPivotRanks.common_submatrix_eq_one' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalPivotRanks.common_submatrix_eq_one

/--
info: 'MAIS.ActiveIntervalPivotRanks.path_rank_eq_common_card' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalPivotRanks.path_rank_eq_common_card

/--
info: 'MAIS.ActiveIntervalPivotRanks.det_option_submatrix_eq_zero_of_rank_le' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalPivotRanks.det_option_submatrix_eq_zero_of_rank_le
end
end
