-- ==================== begin module O7.QuiverGaugeMeasuredPair (formalization/O7/QuiverGaugeMeasuredPair.lean) ====================
section

/-! Genuine zero-output measured-pair invariance under arbitrary actual
matrix-unit changes of basis, using actual Haar linear coordinates. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1400000
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.QuiverGaugeMeasuredPair
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open MAIS.OrbitSliceLoss MAIS.AnalyticTransfer
variable {D:ℕ} (ι:Fin (D+1)→Type*)
  [∀ v,Fintype (ι v)] [∀ v,DecidableEq (ι v)]

/-- The actual fixed gauge action is a genuine linear coordinate
isomorphism on all original matrix entries. -/
def gaugeLinearEquiv (g:Gauge ι) : Rep ι≃ₗ[ℝ] Rep ι where
  toFun A:=g • A
  invFun A:=g⁻¹ • A
  left_inv A:=inv_smul_smul g A
  right_inv A:=smul_inv_smul g A
  map_add' A B:=by
    funext e
    simp only [gauge_smul_apply,Pi.add_apply,Matrix.mul_add,Matrix.add_mul]
  map_smul' c A:=by
    funext e
    simp only [gauge_smul_apply,Pi.smul_apply,Matrix.mul_smul,Matrix.smul_mul,RingHom.id_apply]

/-- All-entry real finite-dimensional continuity is derived. -/
def gaugeContinuousEquiv (g:Gauge ι) : Rep ι≃L[ℝ] Rep ι:=
  (gaugeLinearEquiv ι g).toContinuousLinearEquiv

/-- The literal squared-Frobenius subpath loss has identical actual Haar
pairs at two zero-output points in the same actual gauge orbit. -/
theorem pair_iff_gauge_zero
    (mu nu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]
    (g:Gauge ι) (A:Rep ι) (i j:Fin (D+1)) (hij:i≤j)
    (hzero:pathMatrix A i j hij=0) (lam:ℝ) (m:ℕ) :
    HasMeasuredBandPair mu (Metric.ball A) (fun B=>‖pathMatrix B i j hij‖^2) A lam m ↔
      HasMeasuredBandPair nu (Metric.ball (g • A))
        (fun B=>‖pathMatrix B i j hij‖^2) (g • A) lam m := by
  let f:Rep ι→ℝ:=fun B=>‖pathMatrix B i j hij‖^2
  let F:Rep ι→ℝ:=fun B=>f (g • B)
  let K:ℝ:=‖(↑(g j):Matrix (ι j) (ι j) ℝ)‖*
    ‖(↑((g i)⁻¹):Matrix (ι i) (ι i) ℝ)‖+1
  let L:ℝ:=‖(↑((g j)⁻¹):Matrix (ι j) (ι j) ℝ)‖*
    ‖(↑(g i):Matrix (ι i) (ι i) ℝ)‖+1
  have hK:0<K:=by dsimp [K];positivity
  have hL:0<L:=by dsimp [L];positivity
  have hA:f A=0:=by simp only [f,hzero,norm_zero,zero_pow (by decide : (2:ℕ)≠0)]
  have hGA:F A=0:=by
    simp only [F,f,pathMatrix_gauge,hzero,Matrix.mul_zero,Matrix.zero_mul,norm_zero,
      zero_pow (by decide : (2:ℕ)≠0)]
  have hupper:∀ B,f (g • B)≤K^2*f B:=by
    intro B
    have hn:‖pathMatrix (g • B) i j hij‖≤K*‖pathMatrix B i j hij‖:=by
      exact (norm_pathMatrix_gauge_le ι g B i j hij).trans
        (mul_le_mul_of_nonneg_right (by dsimp [K];linarith) (norm_nonneg _))
    have hs:‖pathMatrix (g • B) i j hij‖^2≤(K*‖pathMatrix B i j hij‖)^2:=by
      simpa only [pow_two] using mul_self_le_mul_self (norm_nonneg _) hn
    simpa only [f,mul_pow] using hs
  have hlower:∀ B,f B≤L^2*f (g • B):=by
    intro B
    have hn:‖pathMatrix B i j hij‖≤L*‖pathMatrix (g • B) i j hij‖:=by
      exact (norm_pathMatrix_le_gauge ι g B i j hij).trans
        (mul_le_mul_of_nonneg_right (by dsimp [L];linarith) (norm_nonneg _))
    have hs:‖pathMatrix B i j hij‖^2≤(L*‖pathMatrix (g • B) i j hij‖)^2:=by
      simpa only [pow_two] using mul_self_le_mul_self (norm_nonneg _) hn
    simpa only [f,mul_pow] using hs
  have hcomp:∀ B∈Metric.ball A 1,
      (1/L^2)*|f B-f A|≤|F B-F A| ∧ |F B-F A|≤K^2*|f B-f A|:=by
    intro B _
    rw [hA,hGA,sub_zero,sub_zero,abs_of_nonneg (sq_nonneg _),abs_of_nonneg (sq_nonneg _)]
    constructor
    · have h:=hlower B
      have hh:f B/L^2≤F B:=(div_le_iff₀ (sq_pos_of_pos hL)).mpr
        (by simpa only [F,mul_comm] using h)
      simpa only [one_div,div_eq_mul_inv,mul_comm,one_mul,mul_one] using hh
    · exact hupper B
  have hcmp:=MAIS.AnalyticTransfer.pair_iff_of_local_comparison
    (mu:=mu) (windows:=Metric.ball A) (f:=f) (g:=F)
    (fun _ _ hab=>Metric.ball_subset_ball hab) zero_lt_one
    (one_div_pos.mpr (sq_pos_of_pos hL)) (sq_pos_of_pos hK) hcomp
    (lam:=lam) (m:=m)
  have hlin:=MAIS.LinearObservationTransfer.pair_iff_haar_linear mu nu
    (gaugeContinuousEquiv ι g) A
    ((continuous_pathMatrix i j hij).norm.pow 2).measurable (lam:=lam) (m:=m)
  exact hcmp.trans hlin

end MAIS.QuiverGaugeMeasuredPair
end

/-- info: 'MAIS.QuiverGaugeMeasuredPair.gaugeLinearEquiv' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverGaugeMeasuredPair.gaugeLinearEquiv

/-- info: 'MAIS.QuiverGaugeMeasuredPair.gaugeContinuousEquiv' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverGaugeMeasuredPair.gaugeContinuousEquiv

/-- info: 'MAIS.QuiverGaugeMeasuredPair.pair_iff_gauge_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverGaugeMeasuredPair.pair_iff_gauge_zero
end
