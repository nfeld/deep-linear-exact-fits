-- ==================== begin module O7.ActiveIntervalExistenceStep (formalization/O7/ActiveIntervalExistenceStep.lean) ====================
section

/-! The actual recursive existence step, including both empty and nonempty
residual carriers, stated on native full-matrix Haar balls. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped ENNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.ActiveIntervalExistenceStep
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalMeasuredSlice
open MAIS.ActiveIntervalRecursivePair MAIS.MatrixChainIsomorphism MAIS.QuiverRealOrbit
open MAIS.AnalyticTransfer
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s≤D+1)

/-- The actual native metric-ball squared loss follows from the literal
entry-Euclidean half loss with the constant positive prior one. -/
theorem native_pair_of_entry_half_one (mu:Measure (Ambient D birth death))
    {a:ℝ} {m:ℕ} (hp:ambientHalfPair D birth death mu (fun _=>1) a m) :
    HasMeasuredBandPair mu (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
      (intervalRep D birth death) a m := by
  have hhalf:HasMeasuredBandPair mu
      (MAIS.MatrixChainEntryWindows.entryBall (Index D birth death) (intervalRep D birth death))
      (fun A=>(1/2:ℝ)*ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D) A)
      (intervalRep D birth death) a m:=by
    have hd:(fun _ : Ambient D birth death=>ENNReal.ofReal (1:ℝ))=
        (1:Ambient D birth death→ℝ≥0∞):=by funext A;simp
    simpa only [ambientHalfPair,hd,withDensity_one] using hp
  have hmon:Monotone (MAIS.MatrixChainEntryWindows.entryBall
      (Index D birth death) (intervalRep D birth death)):=by
    intro R T hRT A hA
    exact hA.trans_le hRT
  have hscale:=MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_positive_scale mu _ hmon
    (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) (intervalRep D birth death)
    (1/2:ℝ) (by norm_num) a m
  exact (MAIS.MatrixChainEntryWindows.pair_iff_entryBall (Index D birth death) mu
    (intervalRep D birth death)).mpr (hscale.mpr hhalf)

include hD in
/-- Genuine pointwise higher full-matrix pair existence gives actual base
pair existence. Finiteness, measured labels and all residual cases are derived. -/
theorem exists_pair_of_pointwise_higher
    (hvalid:∀ s,birth s<death s)
    (muA:Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D)=0)
    (hexists:∀ A:Ambient D birth death,
      pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0→
      intervalRep D birth death∈closure (MulAction.orbit (Gauge (Index D birth death)) A)→
      A∉MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)→
      ∃ a:ℝ,∃ m:ℕ,HasMeasuredBandPair muA (Metric.ball A)
        (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) A a m) :
    ∃ a:ℝ,∃ m:ℕ,HasMeasuredBandPair muA (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) (intervalRep D birth death) a m := by
  let muT:Measure (NormalParams birth death):=addHaar
  let muR:Measure (Residual D birth death):=addHaar
  rcases isEmpty_or_nonempty (ResidualIndex D birth death) with hR|hR
  · let _ :IsEmpty (ResidualIndex D birth death):=hR
    let q:ℝ:=(Fintype.card (DirectIndex D birth death):ℝ)/2
    have hh:=MAIS.ActiveIntervalEmptyResidual.ambient_entry_half_pair_iff D birth death hD hvalid
      muA muT muR hzero (fun _=>1) continuousAt_const zero_lt_one q 1
    have hp:ambientHalfPair D birth death muA (fun _=>1) q 1:=hh.mpr ⟨rfl,rfl⟩
    exact ⟨q,1,native_pair_of_entry_half_one D birth death muA hp⟩
  · let _ :Nonempty (ResidualIndex D birth death):=hR
    obtain ⟨a,m,hcover⟩:=MAIS.ActiveIntervalFiniteHigherTable.exists_higher_table_of_pointwise_pairs
      D birth death muA hexists
    obtain ⟨lam,n,hp⟩:=ambient_pair_exists_of_higher_table D birth death hD a m hvalid
      muA muT muR hzero hcover (fun _=>1) continuousAt_const zero_lt_one
    exact ⟨lam,n,native_pair_of_entry_half_one D birth death muA hp⟩

end MAIS.ActiveIntervalExistenceStep
end

/-- info: 'MAIS.ActiveIntervalExistenceStep.native_pair_of_entry_half_one' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalExistenceStep.native_pair_of_entry_half_one

/-- info: 'MAIS.ActiveIntervalExistenceStep.exists_pair_of_pointwise_higher' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalExistenceStep.exists_pair_of_pointwise_higher
end
