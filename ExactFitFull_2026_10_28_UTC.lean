-- ==================== begin module O7.WeightedRadialPositive (formalization/O7/WeightedRadialPositive.lean) ====================
section

/-! The angular-dominant branch of the actual weighted radial integral. -/
set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.WeightedRadialOrder
open O77.Residual MAIS.WeightedRadialMoments

/-- A smaller angular exponent dominates the actual positive-exponent moment,
retaining exactly its original logarithmic degree. -/
theorem order_beta_lt_alpha {alpha beta D L : ℝ} (hD : 0<D) (hba : beta<alpha) (n : ℕ) :
    EThetaZeroPowerLog (fun eps => ENNReal.ofReal (model alpha beta D L n eps)) beta n := by
  let c := alpha-beta
  have hc : 0<c := sub_pos.mpr hba
  let lo : ℝ := Real.exp (c*(L-1))/(D*4^n)
  let hi : ℝ := 1+Real.exp (c*L)*2^n/(D*c)
  have hlo : 0<lo := by dsimp [lo]; positivity
  have hhi : 0<hi := by dsimp [hi]; positivity
  apply order_of_exp_bounds (c:=lo) (C:=hi) (T0:=2*|L|+4) hlo hhi
  intro t ht
  let T := L+t
  have ht4 : 4≤t := by have := abs_nonneg L; linarith
  have ht1 : 1≤t := by linarith
  have ht0 : 0≤t := by linarith
  have hTL : t/2≤T := by dsimp [T]; have := neg_abs_le L; linarith
  have hTU : T≤2*t := by dsimp [T]; have := le_abs_self L; linarith
  have hT2 : 2≤T := by linarith
  have hT0 : 0≤T := by linarith
  have hJlo := moment_positive_lower hc n hT2
  have hJhi := moment_positive_upper hc n hT0
  have hJ0 := moment_nonneg c n hT0
  have heT : Real.exp (-alpha*t)*Real.exp (c*T) =
      Real.exp (c*L)*Real.exp (-beta*t) := by
    rw [← Real.exp_add,← Real.exp_add]
    congr 1
    dsimp [c,T]
    ring
  have heT1 : Real.exp (-alpha*t)*Real.exp (c*(T-1)) =
      Real.exp (c*(L-1))*Real.exp (-beta*t) := by
    rw [← Real.exp_add,← Real.exp_add]
    congr 1
    dsimp [c,T]
    ring
  have hpL : (t/4)^n≤(T/2)^n :=
    pow_le_pow_left₀ (by positivity) (by linarith) n
  have hpU : T^n≤(2*t)^n := pow_le_pow_left₀ hT0 hTU n
  have hp1 : 1≤t^n := one_le_pow₀ ht1
  have hebase : Real.exp (-alpha*t)≤Real.exp (-beta*t) := by
    apply Real.exp_le_exp.mpr
    nlinarith
  rw [model_exp]
  change lo*(Real.exp (-beta*t)*t^n) ≤ Real.exp (-alpha*t)*(1+moment c n T/D) ∧
    Real.exp (-alpha*t)*(1+moment c n T/D) ≤ hi*(Real.exp (-beta*t)*t^n)
  constructor
  · calc
      lo*(Real.exp (-beta*t)*t^n) =
          (Real.exp (c*(L-1))*Real.exp (-beta*t))*(t/4)^n/D := by
        dsimp [lo]
        rw [div_pow]
        field_simp
      _ = (Real.exp (-alpha*t)*Real.exp (c*(T-1)))*(t/4)^n/D := by rw [heT1]
      _ = Real.exp (-alpha*t)*(Real.exp (c*(T-1))*(t/4)^n/D) := by ring

      _ ≤ Real.exp (-alpha*t)*(Real.exp (c*(T-1))*(T/2)^n/D) := by
        apply mul_le_mul_of_nonneg_left _ (Real.exp_nonneg _)
        apply div_le_div_of_nonneg_right _ hD.le
        exact mul_le_mul_of_nonneg_left hpL (Real.exp_nonneg _)
      _ ≤ Real.exp (-alpha*t)*(moment c n T/D) := by
        apply mul_le_mul_of_nonneg_left _ (Real.exp_nonneg _)
        exact div_le_div_of_nonneg_right hJlo hD.le
      _ ≤ _ := by
        apply mul_le_mul_of_nonneg_left _ (Real.exp_nonneg _)
        linarith
  · have he0 : Real.exp (-alpha*t)≤Real.exp (-beta*t)*t^n :=
      hebase.trans ((le_mul_iff_one_le_right (Real.exp_pos _)).mpr hp1)
    calc
      Real.exp (-alpha*t)*(1+moment c n T/D) ≤
          Real.exp (-alpha*t)*(1+(Real.exp (c*T)*T^n/c)/D) := by
        apply mul_le_mul_of_nonneg_left _ (Real.exp_nonneg _)
        have h := div_le_div_of_nonneg_right hJhi hD.le
        linarith
      _ ≤ Real.exp (-alpha*t)+
          Real.exp (-alpha*t)*(Real.exp (c*T)*(2*t)^n/c/D) := by
        rw [mul_add,mul_one]
        apply add_le_add le_rfl
        apply mul_le_mul_of_nonneg_left _ (Real.exp_nonneg _)
        apply div_le_div_of_nonneg_right _ hD.le
        apply div_le_div_of_nonneg_right _ hc.le
        exact mul_le_mul_of_nonneg_left hpU (Real.exp_nonneg _)
      _ ≤ Real.exp (-beta*t)*t^n+
          Real.exp (-alpha*t)*(Real.exp (c*T)*(2*t)^n/c/D) :=
        add_le_add he0 le_rfl
      _ = hi*(Real.exp (-beta*t)*t^n) := by
        rw [mul_div_assoc,mul_div_assoc,← mul_assoc,heT,mul_pow]
        dsimp [hi]
        field_simp

/-- All three actual log-coordinate radial orders, including the unique
extra-log equality branch. -/
theorem model_trichotomy {alpha beta D L : ℝ} (hD : 0<D) (n : ℕ) :
    (beta<alpha → EThetaZeroPowerLog
      (fun eps => ENNReal.ofReal (model alpha beta D L n eps)) beta n) ∧
    (beta=alpha → EThetaZeroPowerLog
      (fun eps => ENNReal.ofReal (model alpha beta D L n eps)) alpha (n+1)) ∧
    (alpha<beta → EThetaZeroPowerLog
      (fun eps => ENNReal.ofReal (model alpha beta D L n eps)) alpha 0) := by
  refine ⟨fun h => order_beta_lt_alpha hD h n,?_,fun h => order_beta_gt_alpha hD h n⟩
  intro h
  subst beta
  exact order_beta_eq_alpha alpha L hD n

end MAIS.WeightedRadialOrder
end

