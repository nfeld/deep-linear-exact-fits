theorem actual_fastOutputValues_eq (A : Rep ι) :
    fastOutputValues (M := dimensionSum ι) (architecture ι) (pathRankInput ι A) =
      enumeratedValues ι A :=
  fastOutputValues_eq _ _ le_rfl

theorem actual_fastOutputValues_nonempty (A : Rep ι)
    (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    (fastOutputValues (M := dimensionSum ι) (architecture ι) (pathRankInput ι A)).Nonempty := by
  rw [actual_fastOutputValues_eq]
  exact enumeratedValues_nonempty ι A hzero

/-- The executable fast minimum computes the actual independent attained
balanced-incidence optimum. -/
theorem actual_fastMinimum_eq (A : Rep ι)
    (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    fastMinimum (M := dimensionSum ι) (architecture ι) (pathRankInput ι A) =
      (MAIS.Run2PotentialBalancedMinimum.balancedOutputMinimum ι A : WithTop ℕ) := by
  rw [fastMinimum_eq _ _ le_rfl]
  exact executable_minimum_eq ι A hzero

theorem measured_exponent_eq_half_fast_minimum
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : MAIS.AnalyticTransfer.HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    lam = ((fastOutputValues (M := dimensionSum ι) (architecture ι) (pathRankInput ι A)).min'
      (actual_fastOutputValues_nonempty ι A hzero) : ℝ) / 2 := by
  simpa only [actual_fastOutputValues_eq] using
    measured_exponent_eq_half_computed_minimum ι mu A hzero hp

theorem entry_half_prior_exponent_eq_half_fast_minimum
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    {lam : ℝ} {m : ℕ}
    (hp : MAIS.AnalyticTransfer.HasMeasuredBandPair
      (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1 / 2 : ℝ) * ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2)
      A lam m) :
    lam = ((fastOutputValues (M := dimensionSum ι) (architecture ι) (pathRankInput ι A)).min'
      (actual_fastOutputValues_nonempty ι A hzero) : ℝ) / 2 := by
  simpa only [actual_fastOutputValues_eq] using
    entry_half_prior_exponent_eq_half_computed_minimum ι mu A hzero prior hprior hpos hp

end MAIS.Run2BarcodeFastEnumeration

