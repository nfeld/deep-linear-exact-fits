-- ==================== begin module O7.WeightedAnnulusPairTransport (formalization/O7/WeightedAnnulusPairTransport.lean) ====================
section

/-! Genuine measured-pair transport along positive weighted dilations,
and the actual relative-window identity at an interior point. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.WeightedAnnulusPairTransport
open MAIS.WeightedDyadicShells MAIS.WeightedCompactAnnulus
open MAIS.AnalyticTransfer MAIS.CofinalWindowTransfer
variable {I : Type*} [Fintype I] [DecidableEq I]

omit [DecidableEq I] in
/-- Actual Haar transport and positive loss scaling preserve the local pair
at every center along a genuine weighted homogeneous dilation orbit. -/
theorem pair_iff_dilation (mu : Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (W : I→ℕ) (d : ℕ) (f : (I→ℝ)→ℝ) (hf : Measurable f)
    (hhom : ∀ r:ℝ,0<r→∀ x,f (dilation W r x)=r^d*f x)
    (r : ℝ) (hr : 0<r) (x : I→ℝ) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball x) f x lam m ↔
      HasMeasuredBandPair mu (Metric.ball (dilation W r x)) f (dilation W r x) lam m := by
  let T := dilationEquiv W r hr.ne'
  have heq : (fun z=>f (T z))=(fun z=>r^d*f z) := by
    funext z
    exact hhom r hr z
  have ht := MAIS.LinearObservationTransfer.pair_iff_haar_linear mu mu T x hf
    (lam:=lam) (m:=m)
  rw [heq] at ht
  have hs : HasMeasuredBandPair mu (Metric.ball x) f x lam m ↔
      HasMeasuredBandPair mu (Metric.ball x) (fun z=>r^d*f z) x lam m := by
    apply pair_iff_of_local_comparison (fun a b hab=>Metric.ball_subset_ball hab)
      zero_lt_one (pow_pos hr d) (pow_pos hr d)
    intro z _
    rw [← mul_sub,abs_mul,abs_of_pos (pow_pos hr d)]
    exact ⟨le_rfl,le_rfl⟩
  exact hs.trans ht

/-- Intersecting balls with a genuine neighborhood of the center gives a
proved cofinal neighborhood system; this is not assumed at boundary points. -/
theorem intersection_neighborhood_windows {E : Type*} [PseudoMetricSpace E]
    {K : Set E} {x : E} (hx : x∈interior K) :
    NeighborhoodWindows (fun R=>K∩Metric.ball x R) x := by
  constructor
  · intro R hR
    exact inter_mem (mem_interior_iff_mem_nhds.mp hx) (Metric.ball_mem_nhds x hR)
  · intro U hU
    obtain ⟨delta,hd,hsub⟩ := Metric.mem_nhds_iff.mp hU
    refine ⟨delta,hd,fun R _ hsmall=>?_⟩
    intro z hz
    exact hsub ((Metric.ball_subset_ball hsmall.le) hz.2)

/-- At an actual interior point, the ambient and relative K-intersection
radius-first predicates are equivalent, with all radius choices derived. -/
theorem pair_iff_intersection {E : Type*} [PseudoMetricSpace E] [MeasurableSpace E]
    (mu : Measure E) {K : Set E} {x : E} (hx : x∈interior K)
    (f : E→ℝ) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball x) f x lam m ↔
      HasMeasuredBandPair mu (fun R=>K∩Metric.ball x R) f x lam m :=
  pair_iff_neighborhood_windows mu (metric_ball_windows x) (intersection_neighborhood_windows hx)

end MAIS.WeightedAnnulusPairTransport
end

