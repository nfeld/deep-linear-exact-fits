      (WithLp.toLp 2 : (Fin d → ℝ) → EuclideanSpace ℝ (Fin d))
      (coordinateLebesgue (Fin d)) volume := by
    simpa only [coordinateLebesgue_eq_volume] using PiLp.volume_preserving_toLp (Fin d)
