-- ==================== begin module O7.Run2SchurPositiveLossComparison (formalization/O7/Run2SchurPositiveLossComparison.lean) ====================
section

/-! Derived complete positive-target loss comparison for literal endpoint
matrix families. No loss-equivalence constant or Jacobian premise is supplied. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Matrix Filter
open scoped Matrix Matrix.Norms.Frobenius Topology
namespace MAIS.Run2SchurPositiveLossComparison
open MAIS.Run2SchurRectangular MAIS.Run2PositiveEndpointRegular
open MAIS.Run2SchurOutputCoordinates MAIS.Run2SchurProductNorm
open MAIS.Run2PositiveComparisonAlgebra
variable {R M N E : Type*} [Fintype R] [Fintype M] [Fintype N]
  [DecidableEq R] [DecidableEq M] [DecidableEq N] [TopologicalSpace E]

/-- Actual positive-target squared loss is uniformly comparable with the
sum of its actual regular-output square and the retained residual square.
Only literal continuous endpoint matrices and their identity base enter. -/
theorem exists_complete_loss_comparison
    (L : E → Matrix (R⊕M) (R⊕M) ℝ)
    (Z : E → Matrix (R⊕N) (R⊕N) ℝ) (S : E → Matrix M N ℝ) (w : E)
    (hL : ContinuousAt L w) (hZ : ContinuousAt Z w) (hS : ContinuousAt S w)
    (hL0 : L w = 1) (hZ0 : Z w = 1) (hS0 : S w = 0) :
    let Y := fun p => L p * fromBlocks (1 : Matrix R R ℝ) 0 0 (S p) * Z p
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ p in 𝓝 w,
      (‖regularBlocks (Y p-standardTarget)‖^2+‖S p‖^2)/C ≤ ‖Y p-standardTarget‖^2 ∧
      ‖Y p-standardTarget‖^2 ≤ C*(‖regularBlocks (Y p-standardTarget)‖^2+‖S p‖^2) := by
  let Y := fun p => L p * fromBlocks (1 : Matrix R R ℝ) 0 0 (S p) * Z p
  have hdiag : ContinuousAt (fun p => fromBlocks (1 : Matrix R R ℝ)
      (0 : Matrix R N ℝ) (0 : Matrix M R ℝ) (S p)) w := by
    change ContinuousAt (fun p => assemble (((1,(0,0)),S p) :
      Coordinate (R:=R) (M:=M) (N:=N))) w
    exact assemble.continuous.continuousAt.comp (continuousAt_const.prodMk hS)
  have hY : ContinuousAt Y w :=
    continuousAt_matrix_mul (continuousAt_matrix_mul hL hdiag) hZ
  have hY0 : Y w = standardTarget := by
    simp only [Y,hL0,hZ0,hS0,Matrix.one_mul,Matrix.mul_one,standardTarget]
  obtain ⟨C,hC,hout⟩ := exists_output_loss_comparison (R:=R) (M:=M) (N:=N)
  have houtY := hY.eventually (by simpa only [hY0] using hout)
  obtain ⟨D,hD,hschur⟩ := exists_schur_squared_comparison L Z S w hL hZ hS hL0 hZ0 hS0
  let K := max D 1
  have hK : 0 < K := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  refine ⟨K*C,mul_pos hK hC, ?_⟩
  filter_upwards [houtY,hschur] with p hp hs
  have hsum := sum_comparison (sq_nonneg ‖(coordinates (Y p)).1‖)
    (sq_nonneg ‖S p‖) (sq_nonneg ‖schur (Y p)‖) hD hs.1 hs.2
  have hc := compose_comparison hK hC hsum hp
  simpa only [coordinates_regular_eq] using hc

end MAIS.Run2SchurPositiveLossComparison

/-- info: 'MAIS.Run2SchurPositiveLossComparison.exists_complete_loss_comparison' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurPositiveLossComparison.exists_complete_loss_comparison
end
end
