-- ==================== begin module O7.Run2ParameterRetainingMeasured (formalization/O7/Run2ParameterRetainingMeasured.lean) ====================
section

/-! Actual nonlinear regular-coordinate suspension. A surjective actual partial
derivative gives a genuine retaining chart; actual Haar chart transport removes
its kernel spectators. No Jacobian or loss-factorization witness is assumed. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Topology ContDiff ENNReal
namespace MAIS.Run2ParameterRetainingMeasured
open MAIS.Run2ParameterRetainingLinear MAIS.Run2ParameterRetainingChart
open MAIS.Run2ParameterRetainingAnalytic MAIS.AnalyticTransfer

variable {G X Q : Type*}
  [NormedAddCommGroup G] [NormedSpace ℝ G]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]

/-- Literal surjective removal of the kernel coordinate, in the order X × Q. -/
def observe (d : (G × X) →L[ℝ] Q) : ((Q × Kernel d) × X) →L[ℝ] X × Q :=
  (ContinuousLinearMap.snd ℝ (Q × Kernel d) X).prod
    ((ContinuousLinearMap.fst ℝ Q (Kernel d)).comp
      (ContinuousLinearMap.fst ℝ (Q × Kernel d) X))

@[simp] theorem observe_apply (d : (G × X) →L[ℝ] Q) (y : (Q × Kernel d) × X) :
    observe d y = (y.2, y.1.1) := rfl

theorem observe_surjective (d : (G × X) →L[ℝ] Q) : Function.Surjective (observe d) := by
  rintro ⟨x,q⟩
  exact ⟨((q,0),x), rfl⟩

variable [FiniteDimensional ℝ G] [FiniteDimensional ℝ X] [FiniteDimensional ℝ Q]
  [MeasurableSpace G] [BorelSpace G]
  [MeasurableSpace X] [BorelSpace X]
  [MeasurableSpace Q] [BorelSpace Q]

/-- Exact actual Haar-pair equivalence from a nonlinear submersion and literal
retained loss. Exponents remain arbitrary: no residual pair is assumed here. -/
theorem pair_iff_independent_sum
    (mu : Measure (G × X)) [Measure.IsAddHaarMeasure mu]
    (nu : Measure (X × Q)) [Measure.IsAddHaarMeasure nu]
    (u : G × X → Q) (hu : ContDiff ℝ ω u) (hu0 : u 0 = 0)
    (hsurj : Function.Surjective (gaugeDerivative (fderiv ℝ u 0)))
    (f : X → ℝ) (hf : Measurable f) (a : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball (0 : G × X))
      (fun p => ‖u p‖^2 + f p.2) 0 a m ↔
    HasMeasuredBandPair nu (Metric.ball (0 : X × Q))
      (fun p => f p.1 + ‖p.2‖^2) 0 a m := by
  obtain ⟨s,hs,e,he,hsource,htarget,ha,hinv,U,hU,h0U,hUtarget,hUanalytic⟩ :=
    exists_retained_analytic_chart u hu hu0 hsurj
  let muY : Measure ((Q × Kernel (fderiv ℝ u 0)) × X) := addHaar
  let g : ((Q × Kernel (fderiv ℝ u 0)) × X) → ℝ :=
    fun y => ‖y.1.1‖^2 + f y.2
  have he0 : e 0 = 0 := by
    rw [he]
    simp only [coordinateMap_zero,hu0]
    ext <;> simp
  have hm : Measurable (fun p : G × X => ‖u p‖^2 + f p.2) :=
    (hu.continuous.norm.pow 2).measurable.add (hf.comp measurable_snd)
  have hg : Measurable g := by
    exact ((continuous_fst.comp continuous_fst).norm.pow 2).measurable.add
      (hf.comp measurable_snd)
  have hmatch : ∀ p ∈ e.source, (‖u p‖^2 + f p.2) = g (e p) := by
    intro p _
    rw [he]
    rfl
  have hei : ContDiffAt ℝ 1 e.symm (e 0) := by
    rw [he0]
    exact (hUanalytic 0 h0U).contDiffAt
  have hc := MAIS.CrossCarrierChartTransfer.pair_iff_of_chart_local mu muY e hsource
    (ha 0).contDiffAt hei hm hg hmatch (lam := a) (m := m)
  rw [he0] at hc
  have hob : Measurable (fun p : X × Q => f p.1 + ‖p.2‖^2) :=
    (hf.comp measurable_fst).add (continuous_snd.norm.pow 2).measurable
  have ho := MAIS.LinearObservationTransfer.pair_iff_surjective_observation
    muY nu (observe (fderiv ℝ u 0)) (observe_surjective _) 0 hob (lam := a) (m := m)
  have heq : (fun y : (Q × Kernel (fderiv ℝ u 0)) × X =>
      f (observe (fderiv ℝ u 0) y).1 + ‖(observe (fderiv ℝ u 0) y).2‖^2) = g := by
    funext y
    exact add_comm _ _
  rw [heq, map_zero] at ho
  exact hc.trans ho

/-- A genuine actual residual pair gives the derived nonlinear Gaussian shift.
The theorem also covers Q of dimension zero and identically-zero residual loss. -/
theorem pair_of_residual_pair
    (mu : Measure (G × X)) [Measure.IsAddHaarMeasure mu]
    (muX : Measure X) [Measure.IsAddHaarMeasure muX]
    (muQ : Measure Q) [Measure.IsAddHaarMeasure muQ]
    (u : G × X → Q) (hu : ContDiff ℝ ω u) (hu0 : u 0 = 0)
    (hsurj : Function.Surjective (gaugeDerivative (fderiv ℝ u 0)))
    (f : X → ℝ) (hf : Measurable f) (hf0 : f 0 = 0)
    (hnonneg : ∀ x, 0 ≤ f x) {a : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair muX (Metric.ball (0 : X)) f 0 a m) :
    HasMeasuredBandPair mu (Metric.ball (0 : G × X))
      (fun p => ‖u p‖^2 + f p.2) 0
      (a + (Module.finrank ℝ Q : ℝ)/2) m := by
  have hs := MAIS.RegularSquareSuspension.pair_of_quadratic_suspension muQ hp
    zero_lt_one (fun x _ => by simpa only [hf0,sub_zero] using hnonneg x)
  apply (pair_iff_independent_sum mu (muX.prod muQ) u hu hu0 hsurj f hf _ _).mpr
  have h0 : ((0 : X),(0 : Q)) = (0 : X × Q) := by ext <;> simp
  simpa only [h0] using hs

/-- Arbitrary continuous positive source priors need not factor across the
actual retained chart, kernel, or regular variables. -/
theorem pair_of_residual_pair_prior
    (mu : Measure (G × X)) [Measure.IsAddHaarMeasure mu]
    (muX : Measure X) [Measure.IsAddHaarMeasure muX]
    (muQ : Measure Q) [Measure.IsAddHaarMeasure muQ]
    (u : G × X → Q) (hu : ContDiff ℝ ω u) (hu0 : u 0 = 0)
    (hsurj : Function.Surjective (gaugeDerivative (fderiv ℝ u 0)))
    (f : X → ℝ) (hf : Measurable f) (hf0 : f 0 = 0)
    (hnonneg : ∀ x, 0 ≤ f x) {a : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair muX (Metric.ball (0 : X)) f 0 a m)
    (prior : G × X → ℝ) (hprior : ContinuousAt prior 0) (hpos : 0 < prior 0) :
    HasMeasuredBandPair (mu.withDensity (fun p => ENNReal.ofReal (prior p)))
      (Metric.ball (0 : G × X)) (fun p => ‖u p‖^2 + f p.2) 0
      (a + (Module.finrank ℝ Q : ℝ)/2) m := by
  have hm : Measurable (fun p : G × X => ‖u p‖^2 + f p.2) :=
    (hu.continuous.norm.pow 2).measurable.add (hf.comp measurable_snd)
  exact (MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior
    mu hm hprior hpos).mp
    (pair_of_residual_pair mu muX muQ u hu hu0 hsurj f hf hf0 hnonneg hp)

end MAIS.Run2ParameterRetainingMeasured

/-- info: 'MAIS.Run2ParameterRetainingMeasured.pair_iff_independent_sum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingMeasured.pair_iff_independent_sum

/-- info: 'MAIS.Run2ParameterRetainingMeasured.pair_of_residual_pair' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingMeasured.pair_of_residual_pair

/-- info: 'MAIS.Run2ParameterRetainingMeasured.pair_of_residual_pair_prior' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingMeasured.pair_of_residual_pair_prior
end
end
-- ==================== end module O7.Run2ParameterRetainingMeasured ====================

-- ==================== begin module O7.Run2PositiveNetworkMeasured (formalization/O7/Run2PositiveNetworkMeasured.lean) ====================
section

/-! Actual Haar positive-target reconstruction in a genuine full ambient slice.
The only remaining structural premise is the literal full-span normal product
split, and the residual input (when used) is an actual measured pair. -/
set_option autoImplicit false
set_option maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius Topology ContDiff
namespace MAIS.Run2PositiveNetworkMeasured
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.OrbitSliceChart MAIS.OrbitSliceAnalytic MAIS.Run2PositivePathDerivative
open MAIS.Run2PositiveEndpointRegular MAIS.Run2PositiveRegularChart MAIS.Run2PositiveNetworkLoss
open MAIS.Run2ParameterRetainingMeasured MAIS.AnalyticTransfer
variable {D : ℕ} {R : Type*} [Fintype R] [DecidableEq R]
  (κ : Fin (D+1) → Type*) [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

/-- Finite Frobenius matrices carry the ordinary finite entry topology. -/
local instance matrixSecondCountable (I J : Type*) [Fintype I] [Fintype J] :
    SecondCountableTopology (Matrix I J ℝ) :=
  inferInstanceAs (SecondCountableTopology (I → J → ℝ))

/-- Actual full ambient pointed loss is equivalent to the independent
retained residual plus actual regular-coordinate quadratic loss. -/
theorem pair_iff_regular_sum
    (hD : 0 < D) (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (Carrier (R:=R) κ) A).range N)
    (hsplit : ∀ x : N, pathMatrix (A+(x : Rep (Carrier (R:=R) κ)))
      0 (Fin.last D) (Fin.zero_le _) = Matrix.fromBlocks (1 : Matrix R R ℝ)
        0 0 (normalResidual κ A N x))
    (muA : Measure (Rep (Carrier (R:=R) κ))) [Measure.IsAddHaarMeasure muA]
    (nu : Measure (N × MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0)))
      [Measure.IsAddHaarMeasure nu] (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair muA (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Fin.zero_le _)-standardTarget‖^2) A lam m ↔
    HasMeasuredBandPair nu (Metric.ball 0)
      (fun p => ‖normalResidual κ A N p.1‖^2+‖p.2‖^2) 0 lam m := by
  let _ : ProperSpace H := FiniteDimensional.proper ℝ H
  let _ : SecondCountableTopology H := secondCountable_of_proper
  let _ : ProperSpace N := FiniteDimensional.proper ℝ N
  let _ : SecondCountableTopology N := secondCountable_of_proper
  let muP : Measure (H × N) := addHaar
  let e := sliceChart (Carrier (R:=R) κ) A H N hH hN
  let g : Rep (Carrier (R:=R) κ) → ℝ :=
    fun B => ‖pathMatrix B 0 (Fin.last D) (Fin.zero_le _)-standardTarget‖^2
  let f : H × N → ℝ := fun p => g (e p)
  let model : H × N → ℝ :=
    fun p => ‖regularMap κ A H N p‖^2+‖normalResidual κ A N p.2‖^2
  have he0 : e 0 = A := sliceMap_zero _ _ _ _
  have hg : Continuous g :=
    ((contDiff_pathMatrix (Carrier (R:=R) κ) 0 (Fin.last D) (Fin.zero_le _)).continuous.sub continuous_const).norm.pow 2
  have hf : Measurable f := hg.measurable.comp (contDiff_sliceMap _ A H N).continuous.measurable
  have hchart := MAIS.CrossCarrierChartTransfer.pair_iff_of_chart_local muP muA e
    (zero_mem_sliceChart_source _ A H N hH hN) (analyticAt_sliceMap _ A H N 0).contDiffAt
    (by simpa only [he0] using (analyticAt_sliceChart_symm _ A H N hH hN).contDiffAt)
    hf hg.measurable (fun _ _ => rfl) (lam:=lam) (m:=m)
  rw [he0] at hchart
  have hg0 : g A = 0 := by simp [g,hA]
  have hf0 : f 0 = 0 := by change g (e 0)=0; rw [he0,hg0]
  have hm0 : model 0 = 0 := by
    simp only [model,regularMap_zero κ A hA H N,normalResidual_zero κ A hA N,
      Prod.snd_zero,norm_zero,zero_pow (by decide : (2:ℕ)≠0),add_zero]
  obtain ⟨C,hC,hcmp⟩ := exists_network_loss_comparison κ A hA H N hsplit
  obtain ⟨rho,hrho,hball⟩ := Metric.eventually_nhds_iff.mp hcmp
  have hlocal : ∀ p ∈ Metric.ball (0 : H × N) rho,
      (1/C)*|model p-model 0| ≤ |f p-f 0| ∧ |f p-f 0| ≤ C*|model p-model 0| := by
    intro p hp
    have hmpos : 0 ≤ model p := add_nonneg (sq_nonneg _) (sq_nonneg _)
    have hfpos : 0 ≤ f p := sq_nonneg _
    rw [hm0,hf0,sub_zero,sub_zero,abs_of_nonneg hmpos,abs_of_nonneg hfpos]
    have h := hball hp
    constructor
    · simpa only [model,f,g,e,sliceChart_coe,one_div,div_eq_mul_inv,mul_comm,mul_one,one_mul] using h.1
    · exact h.2
  have hc := MAIS.AnalyticTransfer.pair_iff_of_local_comparison
    (mu:=muP) (windows:=Metric.ball (0 : H × N)) (f:=model) (g:=f)
    (fun _ _ hab => Metric.ball_subset_ball hab) hrho (one_div_pos.mpr hC) hC hlocal
      (lam:=lam) (m:=m)
  have hm := pair_iff_independent_sum muP nu (regularMap κ A H N)
    (contDiff_regularMap κ A H N) (regularMap_zero κ A hA H N)
    (gaugeDerivative_regularMap_surjective κ hD A hA H N hH hN)
    (fun x => ‖normalResidual κ A N x‖^2)
    ((continuous_normalResidual κ A N).norm.pow 2).measurable lam m
  exact hchart.symm.trans (hc.symm.trans hm)

/-- The actual retained residual Haar pair yields the actual full ambient
positive-target Gaussian shift. The residual pair is a literal measured
predicate, not a guessed exponent, and regular dimension is genuine finrank. -/
theorem pair_of_normal_residual_pair
    (hD : 0 < D) (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (Carrier (R:=R) κ) A).range N)
    (hsplit : ∀ x : N, pathMatrix (A+(x : Rep (Carrier (R:=R) κ)))
      0 (Fin.last D) (Fin.zero_le _) = Matrix.fromBlocks (1 : Matrix R R ℝ)
        0 0 (normalResidual κ A N x))
    (muA : Measure (Rep (Carrier (R:=R) κ))) [Measure.IsAddHaarMeasure muA]
    (muN : Measure N) [Measure.IsAddHaarMeasure muN]
    (muQ : Measure (MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0)))
      [Measure.IsAddHaarMeasure muQ]
    {a : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair muN (Metric.ball (0:N))
      (fun x => ‖normalResidual κ A N x‖^2) 0 a m) :
    HasMeasuredBandPair muA (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Fin.zero_le _)-standardTarget‖^2) A
      (a+(Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0)) : ℝ)/2) m := by
  let _ : ProperSpace H := FiniteDimensional.proper ℝ H
  let _ : SecondCountableTopology H := secondCountable_of_proper
  let _ : ProperSpace N := FiniteDimensional.proper ℝ N
  let _ : SecondCountableTopology N := secondCountable_of_proper
  let _ : ProperSpace (MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0)) :=
    FiniteDimensional.proper ℝ _
  let _ : SecondCountableTopology (MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0)) :=
    secondCountable_of_proper
  have hz : (fun x : N => ‖normalResidual κ A N x‖^2) 0 = 0 := by
    simp only [normalResidual_zero κ A hA N,norm_zero,zero_pow (by decide : (2:ℕ)≠0)]
  let muP : Measure (H × N) := addHaar
  let nu : Measure (N × MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0)) := addHaar
  have hmodel := MAIS.Run2ParameterRetainingMeasured.pair_of_residual_pair muP muN muQ
    (regularMap κ A H N) (contDiff_regularMap κ A H N) (regularMap_zero κ A hA H N)
    (gaugeDerivative_regularMap_surjective κ hD A hA H N hH hN)
    (fun x => ‖normalResidual κ A N x‖^2)
    ((continuous_normalResidual κ A N).norm.pow 2).measurable hz (fun _ => sq_nonneg _) hp
  have hsum := (pair_iff_independent_sum muP nu (regularMap κ A H N)
    (contDiff_regularMap κ A H N) (regularMap_zero κ A hA H N)
    (gaugeDerivative_regularMap_surjective κ hD A hA H N hH hN)
    (fun x => ‖normalResidual κ A N x‖^2)
    ((continuous_normalResidual κ A N).norm.pow 2).measurable _ _).mp hmodel
  exact (pair_iff_regular_sum κ hD A hA H N hH hN hsplit muA nu _ _).mpr hsum

/-- Any coupled original ambient prior continuous and positive at the actual
fit preserves the derived positive-target suspension. -/
theorem pair_of_normal_residual_pair_prior
    (hD : 0 < D) (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (Carrier (R:=R) κ) A).range N)
    (hsplit : ∀ x : N, pathMatrix (A+(x : Rep (Carrier (R:=R) κ)))
      0 (Fin.last D) (Fin.zero_le _) = Matrix.fromBlocks (1 : Matrix R R ℝ)
        0 0 (normalResidual κ A N x))
    (muA : Measure (Rep (Carrier (R:=R) κ))) [Measure.IsAddHaarMeasure muA]
    (muN : Measure N) [Measure.IsAddHaarMeasure muN]
    (muQ : Measure (MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0)))
      [Measure.IsAddHaarMeasure muQ]
    {a : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair muN (Metric.ball (0:N))
      (fun x => ‖normalResidual κ A N x‖^2) 0 a m)
    (prior : Rep (Carrier (R:=R) κ) → ℝ) (hprior : ContinuousAt prior A)
    (hpos : 0 < prior A) :
    HasMeasuredBandPair (muA.withDensity (fun B => ENNReal.ofReal (prior B))) (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Fin.zero_le _)-standardTarget‖^2) A
      (a+(Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0)) : ℝ)/2) m := by
  have hg : Measurable (fun B : Rep (Carrier (R:=R) κ) =>
      ‖pathMatrix B 0 (Fin.last D) (Fin.zero_le _)-standardTarget‖^2) :=
    (((contDiff_pathMatrix (Carrier (R:=R) κ) 0 (Fin.last D) (Fin.zero_le _)).continuous.sub
      continuous_const).norm.pow 2).measurable
  exact (MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior muA hg hprior hpos).mp
    (pair_of_normal_residual_pair κ hD A hA H N hH hN hsplit muA muN muQ hp)

end MAIS.Run2PositiveNetworkMeasured

/-- info: 'MAIS.Run2PositiveNetworkMeasured.pair_iff_regular_sum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveNetworkMeasured.pair_iff_regular_sum

/-- info: 'MAIS.Run2PositiveNetworkMeasured.pair_of_normal_residual_pair' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveNetworkMeasured.pair_of_normal_residual_pair

/-- info: 'MAIS.Run2PositiveNetworkMeasured.pair_of_normal_residual_pair_prior' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveNetworkMeasured.pair_of_normal_residual_pair_prior
end
