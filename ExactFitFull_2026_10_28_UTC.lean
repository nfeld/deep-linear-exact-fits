-- ==================== begin module O7.Run2ArithmeticPositiveResidualCarrier (formalization/O7/Run2ArithmeticPositiveResidualCarrier.lean) ====================
section

/-! A genuine residual zero-output chain on canonical finite entry carriers.
Its dimensions and ALL path ranks are derived from the original integer
dimension/rank table by subtraction of the actual complete-product rank. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2ArithmeticPositiveResidualCarrier
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.BarcodeActiveNormalForm
open MAIS.Run2BarcodeEnumeration MAIS.QuiverOrbitFiniteHeight
open MAIS.Run2ArithmeticPositiveData MAIS.Run2ArithmeticPositiveResidualCounts
open MAIS.Run2PositivePairFormula MAIS.Run2FullSpanProduct
open MAIS.MatrixCoordinateTransport MAIS.Run2ArithmeticCriticalPathData
variable {D : ℕ} {ι : Fin (D + 1) → Type*}
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

def originalRank (A : Rep ι) : ℕ := pathRankInput ι A 0 (Fin.last D)

theorem originalRank_eq (A : Rep ι) : originalRank A =
    (pathMatrix A 0 (Fin.last D) (Nat.zero_le D)).rank := by
  simp only [originalRank, pathRankInput, dite_eq_left (Fin.zero_le (Fin.last D))]

abbrev CanonicalCarrier (A : Rep ι) :=
  ResidualCarrier (architecture ι) (originalRank A)

def residualCoordinates {A : Rep ι} (N : ActiveNormalForm A) (v : Fin (D + 1)) :
    ReducedCarrier N v ≃ CanonicalCarrier A v :=
  Fintype.equivOfCardEq (by
    rw [Fintype.card_fin]
    simpa only [residualDimensions, architecture, originalRank_eq] using residual_dimension N v)

def residualPoint {A : Rep ι} (N : ActiveNormalForm A) : Rep (CanonicalCarrier A) :=
  transport (residualCoordinates N) (reducedBase N)

theorem residualPoint_zero {A : Rep ι} (N : ActiveNormalForm A) :
    pathMatrix (residualPoint N) 0 (Fin.last D) (Nat.zero_le D) = 0 := by
  have hz : pathMatrix (reducedBase N) 0 (Fin.last D) (Nat.zero_le D) = 0 :=
    reduced_base_completeProduct_zero D N.birth N.death N.bounded
  rw [residualPoint, path_transport, hz]
  rfl

theorem residualPoint_rankInput {A : Rep ι} (N : ActiveNormalForm A) :
    pathRankInput (CanonicalCarrier A) (residualPoint N) =
      residualRanks (pathRankInput ι A) (originalRank A) := by
  funext i j
  by_cases hij : i ≤ j
  · simp only [pathRankInput, dite_eq_left hij, residualRanks, originalRank_eq]
    rw [residualPoint, path_rank_transport]
    exact residual_path_rank N i j hij
  · simp only [pathRankInput, dite_eq_right hij, residualRanks, Nat.zero_sub]

theorem canonical_nodes (A : Rep ι) :
    MAIS.Run2ArithmeticCriticalPathFast.nodes (CanonicalCarrier A) =
      residualNodes (architecture ι) (originalRank A) := rfl

theorem canonical_computedPairs {A : Rep ι} (N : ActiveNormalForm A) :
    computedPairs (MAIS.Run2ArithmeticCriticalPathFast.nodes (CanonicalCarrier A))
      (pathRankInput (CanonicalCarrier A) (residualPoint N)) =
      residualPairs (architecture ι) (pathRankInput ι A) (originalRank A) := by
  rw [canonical_nodes, residualPoint_rankInput]
  rfl

end MAIS.Run2ArithmeticPositiveResidualCarrier

