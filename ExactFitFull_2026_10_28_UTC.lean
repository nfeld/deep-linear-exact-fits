-- ==================== begin module O7.Run2PositiveRegularChart (formalization/O7/Run2PositiveRegularChart.lean) ====================
section

/-! The generic retaining chart is instantiated by the actual complete product
in the actual full ambient orbit/normal chart. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace MAIS.Run2PositiveRegularChart
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.OrbitSliceChart MAIS.OrbitSliceAnalytic MAIS.Run2PositivePathDerivative
open MAIS.Run2PositiveEndpointRegular MAIS.Run2ParameterRetainingLinear
open MAIS.Run2ParameterRetainingAnalytic
open scoped Matrix Matrix.Norms.Frobenius ContDiff Topology
variable {D : ℕ} {R : Type*} [Fintype R] [DecidableEq R]
  (κ : Fin (D+1) → Type*) [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

/-- Literal regular blocks of the complete matrix product minus the fixed
rank-r target, expressed in the actual orbit/normal coordinates. -/
def regularMap (A : Rep (Carrier (R:=R) κ))
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ))) (p : H × N) :
    RegularSpace R (κ (Fin.last D)) (κ 0) :=
  regularBlocks (pathMatrix (sliceMap (Carrier (R:=R) κ) A H N p)
    0 (Fin.last D) (Fin.zero_le _) - standardTarget)

theorem contDiff_regularMap (A : Rep (Carrier (R:=R) κ))
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ))) :
    ContDiff ℝ ω (regularMap κ A H N) := by
  exact regularBlocks.contDiff.comp
    (((contDiff_pathMatrix (Carrier (R:=R) κ) 0 (Fin.last D) (Fin.zero_le _)).comp
      (contDiff_sliceMap (Carrier (R:=R) κ) A H N)).sub contDiff_const)

@[simp] theorem regularMap_zero (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ))) : regularMap κ A H N 0 = 0 := by
  unfold regularMap
  rw [sliceMap_zero,hA,sub_self,map_zero]

/-- The actual first partial derivative of the actual regular map is onto.
Only genuine complementary subspaces of the actual orbit differential enter. -/
theorem gaugeDerivative_regularMap_surjective
    (hD : 0 < D) (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (Carrier (R:=R) κ) A).range N) :
    Function.Surjective (gaugeDerivative (fderiv ℝ (regularMap κ A H N) 0)) := by
  let F : Rep (Carrier (R:=R) κ) → Matrix (R ⊕ κ (Fin.last D)) (R ⊕ κ 0) ℝ :=
    fun B => pathMatrix B 0 (Fin.last D) (Fin.zero_le _)
  have hF := (contDiff_pathMatrix (Carrier (R:=R) κ) 0 (Fin.last D) (Fin.zero_le _)).differentiable (by simp)
  have hfA : HasFDerivAt F (fderiv ℝ F A)
      (sliceMap (Carrier (R:=R) κ) A H N 0) := by
    simpa only [sliceMap_zero] using (hF A).hasFDerivAt
  have hd := regularBlocks.hasFDerivAt.comp 0
    ((hfA.comp 0 (hasStrictFDerivAt_sliceMap (Carrier (R:=R) κ) A H N hH hN).hasFDerivAt).sub_const
      (standardTarget : Matrix (R ⊕ κ (Fin.last D)) (R ⊕ κ 0) ℝ))
  have hder : fderiv ℝ (regularMap κ A H N) 0 =
      regularBlocks.comp ((fderiv ℝ F A).comp
        (sliceDerivativeEquiv (Carrier (R:=R) κ) A H N hH hN :
          H × N →L[ℝ] Rep (Carrier (R:=R) κ))) := by
    apply HasFDerivAt.fderiv
    convert hd using 1 <;> rfl
  intro q
  obtain ⟨h,hh⟩ := regular_path_derivative_surjective κ hD A hA H hH q
  refine ⟨h, ?_⟩
  rw [gaugeDerivative,hder]
  change regularBlocks ((fderiv ℝ F A)
    (orbitDifferential (Carrier (R:=R) κ) A (h : Lie _) + (0 : Rep (Carrier (R:=R) κ)))) = q
  simpa only [add_zero,F] using hh

end MAIS.Run2PositiveRegularChart

