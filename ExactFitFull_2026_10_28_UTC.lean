-- ==================== begin module O7.RealTypeAClosure (formalization/O7/RealTypeAClosure.lean) ====================
section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
universe w
namespace MAIS.RealTypeAClosure

open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.LinkedSwitchOrbitClosure MAIS.CanonicalCoordinateRepresentatives
open MAIS.LinkedSwitchDecomposition MAIS.MatrixBlockProjection MAIS.IntervalPaddingOrder
open MAIS.MatrixRankGeneration MAIS.LinearChain MAIS.TypeAPadding

variable {D m : ℕ} {ι : Fin (D + 1) → Type w}
variable [∀ i, Fintype (ι i)] [∀ i, DecidableEq (ι i)]

/-- A genuine finite linked-switch path composes to an actual ordinary real Euclidean
    orbit-closure inclusion on arbitrary fixed real matrix coordinate spaces. -/
theorem orbit_closure_of_linked_path (M N : Fin m → Fin m → ℕ)
    (hpath : Relation.ReflTransGen LinkedSwitch M N) (A B : Rep ι)
    (hA : ∀ i j (hij : i ≤ j), (pathMatrix A i j hij).rank =
      crossing M (i.val + 1) (j.val + 1))
    (hB : ∀ i j (hij : i ≤ j), (pathMatrix B i j hij).rank =
      crossing N (i.val + 1) (j.val + 1)) :
    A ∈ closure (MulAction.orbit (Gauge ι) B) := by
  induction hpath generalizing B with
  | refl =>
    apply subset_closure
    exact mem_gauge_orbit_of_path_rank_eq B A (by intro i j hij; rw [hB, hA])
  | @tail P Q hpath hPQ ih =>
    have hdimP : ∀ v : Fin (D + 1), crossing P (v.val + 1) (v.val + 1) = Fintype.card (ι v) := by
      intro v
      have hb := hB v v le_rfl
      rw [pathMatrix_self, Matrix.rank_one] at hb
      exact (linked_coverage P Q hPQ (v.val + 1)).trans hb.symm
    obtain ⟨C, hC⟩ := exists_representative (ι := ι) P hdimP
    exact closure_orbit_trans (ih C hC) (linked_switch_orbit_closure P Q hPQ C B hC hB)

/-- Actual path-product rank order implies actual ordinary real Euclidean orbit closure.
    This uses the proved arbitrary-field interval classification, the genuine terminating
    finite linked-switch construction, and the actual real active-space matrix families. -/
theorem mem_closure_orbit_of_path_rank_le (A B : Rep ι)
    (hrank : ∀ i j (hij : i ≤ j), (pathMatrix A i j hij).rank ≤ (pathMatrix B i j hij).rank) :
    A ∈ closure (MulAction.orbit (Gauge ι) B) := by
  classical
  obtain ⟨p⟩ := exists_barcode (matrixChain A)
  obtain ⟨q⟩ := exists_barcode (matrixChain B)
  have hlinear : ∀ i j (hij : i ≤ j),
      Module.finrank ℝ (LinearMap.range ((matrixChain A).map i j hij)) ≤
      Module.finrank ℝ (LinearMap.range ((matrixChain B).map i j hij)) := by
    intro i j hij
    simpa only [pathMatrix_rank] using hrank i j hij
  let Npad := Fintype.card p.Index + Fintype.card q.Index
  have hbounded := p.actual_rank_order_generated q (fun _ => rfl) hlinear
  have hpath : Relation.ReflTransGen LinkedSwitch (padding p.multiplicity Npad)
      (padding q.multiplicity Npad) :=
    (Relation.ReflTransGen.mono
      (r := BoundedLinkedSwitch (padding q.multiplicity Npad) (padding p.multiplicity Npad))
      (p := LinkedSwitch) (fun _ _ h => h.1)) _ _ hbounded
  apply orbit_closure_of_linked_path _ _ hpath A B
  · intro i j hij
    rw [padding_crossing _ _ _ _ (by exact Nat.add_le_add_right (show i.val ≤ j.val from hij) 1),
      p.crossing_multiplicity_interior i j hij]
    exact pathMatrix_rank A i j hij
  · intro i j hij
    rw [padding_crossing _ _ _ _ (by exact Nat.add_le_add_right (show i.val ≤ j.val from hij) 1),
      q.crossing_multiplicity_interior i j hij]
    exact pathMatrix_rank B i j hij

/-- The full real type-A orbit-closure rank criterion for actual rectangular matrix chains
    and the ordinary Euclidean topology, including arbitrary zero-dimensional vertices. -/
theorem mem_closure_orbit_iff_path_rank_le (A B : Rep ι) :
    A ∈ closure (MulAction.orbit (Gauge ι) B) ↔
      ∀ i j (hij : i ≤ j), (pathMatrix A i j hij).rank ≤ (pathMatrix B i j hij).rank := by
  exact ⟨fun h i j hij => MAIS.QuiverOrbitRank.path_rank_le_of_mem_closure_orbit h i j hij,
    mem_closure_orbit_of_path_rank_le A B⟩

end MAIS.RealTypeAClosure

/-- info: 'MAIS.RealTypeAClosure.mem_closure_orbit_iff_path_rank_le' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.RealTypeAClosure.mem_closure_orbit_iff_path_rank_le
end
