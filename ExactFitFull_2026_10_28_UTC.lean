-- ==================== begin module O7.LinearObservationTransfer (formalization/O7/LinearObservationTransfer.lean) ====================
section

/-! Actual measured local-band invariance under a finite-dimensional
surjective linear observation. Haar scaling and spectator integration
are derived; they are not assumptions in the measured endpoint. -/

set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section

open Set MeasureTheory MeasureTheory.Measure Filter
open scoped NNReal ENNReal Topology

namespace MAIS.LinearObservationTransfer

open MAIS.AnalyticTransfer

lemma bandMass_smul {E : Type*} [MeasurableSpace E] (mu : Measure E)
    (c : ℝ≥0) (windows : ℝ → Set E) (f : E → ℝ) (w : E) (R eps : ℝ) :
    bandMass (c • mu) windows f w R eps =
      (c : ℝ≥0∞) * bandMass mu windows f w R eps := by
  simp [bandMass, Measure.smul_apply]

theorem pair_of_smul_measure {E : Type*} [MeasurableSpace E] (mu : Measure E)
    (c : ℝ≥0) (hc : 0 < c) {windows : ℝ → Set E} {f : E → ℝ} {w : E}
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu windows f w lam m) :
    HasMeasuredBandPair (c • mu) windows f w lam m := by
  rcases hp with ⟨hlam, hm, rho, hrho, hp⟩
  refine ⟨hlam, hm, rho, hrho, ?_⟩
  intro R hR hsmall
  have hcR : 0 < (c : ℝ) := hc
  apply O77.Transport0906.order_of_two_window_bounds
    (hp R hR hsmall) (hp R hR hsmall) hcR hcR
  intro eps _
  rw [bandMass_smul]
  simp only [ENNReal.ofReal_coe_nnreal]
  exact ⟨le_rfl, le_rfl⟩

theorem pair_iff_smul_measure {E : Type*} [MeasurableSpace E] (mu : Measure E)
    (c : ℝ≥0) (hc : 0 < c) {windows : ℝ → Set E} {f : E → ℝ} {w : E}
    {lam : ℝ} {m : ℕ} :
    HasMeasuredBandPair mu windows f w lam m ↔
      HasMeasuredBandPair (c • mu) windows f w lam m := by
  constructor
  · exact pair_of_smul_measure mu c hc
  · intro hp
    have hh := pair_of_smul_measure (c • mu) c⁻¹ (inv_pos.mpr hc) hp
    simpa only [smul_smul, inv_mul_cancel₀ hc.ne', one_smul] using hh

theorem bandMass_add_const {E : Type*} [MeasurableSpace E] (mu : Measure E)
    (windows : ℝ → Set E) (f : E → ℝ) (w : E) (c : ℝ) :
    bandMass mu windows (fun x => f x + c) w = bandMass mu windows f w := by
  funext R eps
  simp only [bandMass, add_sub_add_right_eq_sub]

/-- A literal additive irreducible residual cancels at every center and
every level, without any fit or criticality assumption. -/
theorem pair_iff_add_const {E : Type*} [MeasurableSpace E] (mu : Measure E)
    (windows : ℝ → Set E) (f : E → ℝ) (w : E) (c : ℝ)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu windows (fun x => f x + c) w lam m ↔
      HasMeasuredBandPair mu windows f w lam m := by
  unfold HasMeasuredBandPair
  rw [bandMass_add_const]

section HaarLinear

variable {E F : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E] [BorelSpace E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  [MeasurableSpace F] [BorelSpace F]
  (mu : Measure E) (nu : Measure F)
  [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]

omit [FiniteDimensional ℝ E] in
/-- Arbitrary finite-dimensional continuous linear coordinates preserve
actual Haar local-band pairs. The positive measure factor is derived from
Haar uniqueness, not postulated as a volume-comparison hypothesis. -/
theorem pair_iff_haar_linear (T : E ≃L[ℝ] F) (w : E) {g : F → ℝ}
    (hg : Measurable g) {lam : ℝ} {m : ℕ} :
    HasMeasuredBandPair mu (Metric.ball w) (fun x => g (T x)) w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (T w)) g (T w) lam m := by
  have : Measure.IsAddHaarMeasure (mu.map T) := T.isAddHaarMeasure_map mu
  let c : ℝ≥0 := addHaarScalarFactor (mu.map T) nu
  have hc : 0 < c := addHaarScalarFactor_pos_of_isAddHaarMeasure (mu.map T) nu
  have hmap : mu.map T = c • nu := isAddLeftInvariant_eq_smul _ _
  have hT : MeasurePreserving T mu (mu.map T) := ⟨T.continuous.measurable, rfl⟩
  have hp := MAIS.LinearWindowTransfer.pair_iff_measured_linear mu (mu.map T)
    T hT w hg (lam := lam) (m := m)
  rw [hmap] at hp
  exact hp.trans (pair_iff_smul_measure nu c hc).symm

omit [BorelSpace E] in
/-- Constant centered germs have the literal neutral measured pair,
including on zero-dimensional carriers. -/
theorem constant_pair (w : E) (c : ℝ) :
    HasMeasuredBandPair mu (Metric.ball w) (fun _ => c) w 0 1 := by
  refine ⟨le_rfl, le_rfl, 1, zero_lt_one, ?_⟩
  intro R hR _
  have hpos : 0 < mu (Metric.ball w R) := Metric.measure_ball_pos mu w hR
  have hfin : mu (Metric.ball w R) < ⊤ :=
    (measure_mono Metric.ball_subset_closedBall).trans_lt
      (isCompact_closedBall w R).measure_lt_top
  apply O77.NormalForm0906.order_of_exact_powerLog hpos hfin zero_lt_one
  intro eps heps _
  simp [bandMass, heps, Metric.ball, O77.Residual.powerLogZero_zero_zero]

end HaarLinear

section Observation

variable {E F : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]

/-- An explicit actual split into observed coordinates and the true kernel.
The first component is literally q, not an abstract conjugate of q. -/
def splitOfRightInverse (q : E →L[ℝ] F) (R : F →L[ℝ] E)
    (hR : q.comp R = ContinuousLinearMap.id ℝ F) : E ≃L[ℝ] F × q.ker :=
  ({ toFun := fun x => (q x, ⟨x - R (q x), by
        have h := congrArg (fun f : F →L[ℝ] F => f (q x)) hR
        change q (x - R (q x)) = 0
        rw [map_sub]
        simpa using sub_eq_zero.mpr h.symm⟩)
     invFun := fun p => R p.1 + p.2
     left_inv := by
       intro x
       change R (q x) + (x - R (q x)) = x
       abel
     right_inv := by
       rintro ⟨y, k⟩
       have h := congrArg (fun f : F →L[ℝ] F => f y) hR
       have hqy : q (R y + k) = y := by
         rw [map_add]
         have hk : q k = 0 := k.property
         simpa only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply,
           hk, add_zero] using h
       apply Prod.ext
       · exact hqy
       · apply Subtype.ext
         change R y + k - R (q (R y + k)) = k
         rw [hqy]
         abel
     map_add' := by
       intro x y
       apply Prod.ext
       · exact q.map_add x y
       · apply Subtype.ext
         change x + y - R (q (x + y)) = (x - R (q x)) + (y - R (q y))
         rw [map_add, map_add]
         abel
     map_smul' := by
       intro a x
       apply Prod.ext
       · exact q.map_smul a x
       · apply Subtype.ext
         change a • x - R (q (a • x)) = a • (x - R (q x))
         rw [map_smul, map_smul, smul_sub] } : E ≃ₗ[ℝ] F × q.ker).toContinuousLinearEquiv

omit [FiniteDimensional ℝ F] in
theorem split_fst (q : E →L[ℝ] F) (R : F →L[ℝ] E)
    (hR : q.comp R = ContinuousLinearMap.id ℝ F) (x : E) :
    (splitOfRightInverse q R hR x).1 = q x := rfl

variable [MeasurableSpace E] [BorelSpace E] [MeasurableSpace F] [BorelSpace F]
  (mu : Measure E) (nu : Measure F)
  [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]

/-- The actual measured surjective-observation theorem. Unobserved
coordinates are derived as ker q and integrated as genuine spectators. -/
theorem pair_iff_surjective_observation (q : E →L[ℝ] F)
    (hq : Function.Surjective q) (w : E) {g : F → ℝ} (hg : Measurable g)
    {lam : ℝ} {m : ℕ} :
    HasMeasuredBandPair mu (Metric.ball w) (fun x => g (q x)) w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (q w)) g (q w) lam m := by
  have hqtop : q.range = ⊤ := LinearMap.range_eq_top.mpr hq
  obtain ⟨R, hR⟩ := q.exists_rightInverse_of_surjective hqtop
  let T := splitOfRightInverse q R hR
  let kappa : Measure q.ker := addHaar
  have hp := pair_iff_haar_linear mu (nu.prod kappa) T w
    (g := fun z : F × q.ker => g z.1) (hg.comp measurable_fst)
    (lam := lam) (m := m)
  have hs := MAIS.SpectatorTransfer.pair_iff_spectators nu kappa
    (f := g) (w := q w) (v := (T w).2) (lam := lam) (m := m)
  exact hp.trans hs.symm

/-- Empirical irreducible constants are allowed at arbitrary levels. -/
theorem pair_iff_observation_add_const (q : E →L[ℝ] F)
    (hq : Function.Surjective q) (w : E) {g : F → ℝ} (hg : Measurable g)
    (c lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball w) (fun x => g (q x) + c) w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (q w)) g (q w) lam m := by
  exact (pair_iff_add_const mu _ _ w c lam m).trans
    (pair_iff_surjective_observation mu nu q hq w hg)

/-- The original source prior need only be continuous and positive at the
center. It is not assumed to factor across observed and kernel coordinates. -/
theorem pair_iff_observation_prior_add_const (q : E →L[ℝ] F)
    (hq : Function.Surjective q) (w : E) {g : F → ℝ} (hg : Measurable g)
    {prior : E → ℝ} (hprior : ContinuousAt prior w) (hpos : 0 < prior w)
    (c lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair
      (mu.withDensity (fun x => ENNReal.ofReal (prior x)))
      (Metric.ball w) (fun x => g (q x) + c) w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (q w)) g (q w) lam m := by
  have hf : Measurable (fun x => g (q x) + c) :=
    (hg.comp q.continuous.measurable).add_const c
  exact (MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior
    mu hf hprior hpos).symm.trans
      (pair_iff_observation_add_const mu nu q hq w hg c lam m)

end Observation

end MAIS.LinearObservationTransfer
end

