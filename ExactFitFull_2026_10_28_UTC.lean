-- ==================== begin module O7.ActiveIntervalRadialPair (formalization/O7/ActiveIntervalRadialPair.lean) ====================
section

/-! Full actual radius-first residual measured pair iff a literal actual
compact-annulus radial integral has the corresponding order. The Haar
singleton condition is derived from actual nonempty residual coordinates. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 400000
noncomputable section
open Set MeasureTheory
open scoped ENNReal Topology
namespace MAIS.ActiveIntervalRadialPair
open MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalGaussianCoordinates
open MAIS.ActiveIntervalGaussianChart MAIS.ActiveIntervalAnnulusRecurrence
open MAIS.ActiveIntervalWeightedResidual MAIS.IntervalIntegerPotentials
open MAIS.ActiveIntervalRadialBand MAIS.WeightedCompactAnnulus
open MAIS.WeightedHomogeneousBoxOrder MAIS.MatrixChainIsomorphism
open MAIS.AnalyticTransfer O77.Residual
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s≤D+1)

/-- Positive residual dimension makes the actual ambient Haar measure
    non-atomic, via a genuine coordinate hyperplane containing each point. -/
theorem residual_haar_null_singletons (mu:Measure (Residual D birth death))
    [Measure.IsAddHaarMeasure mu] [Nonempty (ResidualIndex D birth death)] :
    NullSingletonClass mu := by
  constructor
  intro z
  obtain ⟨p⟩:=‹Nonempty (ResidualIndex D birth death)›
  apply measure_mono_null _ (coordinate_hyperplane_null mu p (z p))
  intro x hx
  have he:x=z:=Set.mem_singleton_iff.mp hx
  simp only [Set.mem_ofPred_eq,he]

/-- The actual radius-first ordinary-ball pair is exactly the actual
    compact-annulus radial-integral order, with all weights, degree,
    cofinal windows, scaling constants and nonatomicity derived. -/
theorem pair_iff_radial_integral (mu:Measure (Residual D birth death))
    [Measure.IsAddHaarMeasure mu] [Nonempty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (lam:ℝ) (m:ℕ) :
    HasMeasuredBandPair mu (Metric.ball (0:Residual D birth death))
      (residualLoss D birth death hD) 0 lam m ↔
    0 ≤ lam ∧ 1 ≤ m ∧ EThetaZeroPowerLog
      (fun eps=>MAIS.DyadicRadialComparison.weightedIntegral
        (∑ p:ResidualIndex D birth death,integerWeights D birth death p)
        (2*commonDenominator D birth death) (annularBand D birth death hD mu) eps)
      lam (m-1) := by
  let _ : NullSingletonClass mu:=residual_haar_null_singletons D birth death mu
  have hW:∀ p:ResidualIndex D birth death,0 < integerWeights D birth death p:=
    fun p=>((zero_base_weight_data D birth death hD hzero).2 p).1
  have hhom:∀ r:ℝ,0<r→∀ z:Residual D birth death,
      residualLoss D birth death hD
        (MAIS.WeightedDyadicShells.dilation (integerWeights D birth death) r z)=
        r^(2*commonDenominator D birth death)*residualLoss D birth death hD z:=by
    intro r hr z
    exact zero_base_residualLoss_integerDilation D birth death hD hzero r hr z
  rw [pair_iff_unit_box mu (integerWeights D birth death) hW
    (2*commonDenominator D birth death) (residualLoss D birth death hD) hhom
    (residualLoss_nonneg D birth death hD) (residualLoss_zero D birth death hD hzero) lam m]
  exact and_congr Iff.rfl (and_congr Iff.rfl
    (box_order_iff_radial_integral D birth death hD mu hzero lam (m-1)))

end MAIS.ActiveIntervalRadialPair
end

