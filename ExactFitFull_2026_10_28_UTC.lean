    simpa only [mul_comm] using (lt_div_iff₀ hLp).1 hds
  have hsmall : delta/L < r := by
    exact (div_le_self hd.le hL).trans_lt
      ((le_mul_of_one_le_left hd.le hL).trans_lt hlarge)
