#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedAnnulusPairTransport.pair_iff_dilation

/-- info: 'MAIS.WeightedAnnulusPairTransport.intersection_neighborhood_windows' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedAnnulusPairTransport.intersection_neighborhood_windows

/-- info: 'MAIS.WeightedAnnulusPairTransport.pair_iff_intersection' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedAnnulusPairTransport.pair_iff_intersection
end
