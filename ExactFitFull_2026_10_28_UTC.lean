-- ==================== begin module O7.QuiverOrbitFiniteHeight (formalization/O7/QuiverOrbitFiniteHeight.lean) ====================
section

/-! Actual bounded path-rank codes give finitely many genuine real gauge
orbits and a strictly decreasing finite defect for strict generization. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.QuiverOrbitFiniteHeight
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
variable {D:ℕ} (ι:Fin (D+1)→Type*)
  [∀ v,Fintype (ι v)] [∀ v,DecidableEq (ι v)]

abbrev PathIndex (D:ℕ):={p:Fin (D+1)×Fin (D+1) // p.1≤p.2}
def dimensionSum:ℕ:=∑ v:Fin (D+1),Fintype.card (ι v)

theorem path_rank_le_dimensionSum (A:Rep ι) (p:PathIndex D) :
    (pathMatrix A p.val.1 p.val.2 p.property).rank≤dimensionSum ι := by
  apply (Matrix.rank_le_card_width _).trans
  exact Finset.single_le_sum (fun v _=>Nat.zero_le (Fintype.card (ι v)))
    (Finset.mem_univ p.val.1)

/-- Literal finite code of every actual consecutive path-product rank. -/
def rankCode (A:Rep ι) : PathIndex D→Fin (dimensionSum ι+1):=fun p=>
  ⟨(pathMatrix A p.val.1 p.val.2 p.property).rank,
    Nat.lt_succ_of_le (path_rank_le_dimensionSum ι A p)⟩

/-- Actual rank codes classify the genuine real matrix-unit gauge orbits. -/
theorem rankCode_eq_iff_mem_orbit (A B:Rep ι) :
    rankCode ι A=rankCode ι B ↔ A∈MulAction.orbit (Gauge ι) B := by
  constructor
  · intro h
    apply mem_gauge_orbit_of_path_rank_eq B A
    intro i j hij
    exact (congrArg Fin.val (congrFun h (⟨(i,j),hij⟩:PathIndex D))).symm
  · intro h
    obtain ⟨g,hg⟩:=MulAction.mem_orbit_iff.mp h
    subst A
    funext p
    apply Fin.ext
    exact path_rank_gauge g B p.val.1 p.val.2 p.property

/-- The code descends to actual Mathlib orbit-equivalence classes. -/
def orbitRankCode : MulAction.orbitRel.Quotient (Gauge ι) (Rep ι)→
    (PathIndex D→Fin (dimensionSum ι+1)):=
  Quotient.lift (rankCode ι) (fun A B h=>(rankCode_eq_iff_mem_orbit ι A B).mpr h)

theorem orbitRankCode_injective:Function.Injective (orbitRankCode ι) := by
  intro x y
  refine Quotient.inductionOn₂ x y ?_
  intro A B h
  apply Quotient.sound
  exact (rankCode_eq_iff_mem_orbit ι A B).mp h

/-- Finiteness of the ACTUAL real gauge-orbit quotient, derived from the
actual finite rank code and proved real interval classification. -/
instance finite_orbit_quotient:Finite (MulAction.orbitRel.Quotient (Gauge ι) (Rep ι)):=
  Finite.of_injective (orbitRankCode ι) (orbitRankCode_injective ι)

/-- A literal sum of actual matrix path ranks. -/
def rankHeight (A:Rep ι):ℕ:=∑ p:PathIndex D,(pathMatrix A p.val.1 p.val.2 p.property).rank

theorem rankHeight_le (A:Rep ι) :
    rankHeight ι A≤Fintype.card (PathIndex D)*dimensionSum ι := by
  calc
    _ ≤ ∑ _p:PathIndex D,dimensionSum ι:=
      Finset.sum_le_sum (fun p _=>path_rank_le_dimensionSum ι A p)
    _ = _:=by simp

/-- Genuine strict ordinary real orbit generization increases actual rank
height; no abstract surrogate relation or rank-progress premise is supplied. -/
theorem rankHeight_lt_of_strict_generization (A B:Rep ι)
    (hcl:A∈closure (MulAction.orbit (Gauge ι) B))
    (hnot:B∉MulAction.orbit (Gauge ι) A) : rankHeight ι A<rankHeight ι B := by
  have hle:∀ p:PathIndex D,(pathMatrix A p.val.1 p.val.2 p.property).rank≤
      (pathMatrix B p.val.1 p.val.2 p.property).rank:=fun p=>
    path_rank_le_of_mem_closure_orbit hcl p.val.1 p.val.2 p.property
  have hlt:∃ p:PathIndex D,(pathMatrix A p.val.1 p.val.2 p.property).rank<
      (pathMatrix B p.val.1 p.val.2 p.property).rank:=by
    by_contra! hn
    apply hnot
    apply mem_gauge_orbit_of_path_rank_eq A B
    intro i j hij
    exact le_antisymm (hle ⟨(i,j),hij⟩) (hn ⟨(i,j),hij⟩)
  apply Finset.sum_lt_sum (fun p _=>hle p)
  obtain ⟨p,hp⟩:=hlt
  exact ⟨p,Finset.mem_univ p,hp⟩

def rankDefect (A:Rep ι):ℕ:=Fintype.card (PathIndex D)*dimensionSum ι-rankHeight ι A

/-- The actual finite defect strictly decreases toward higher orbits. -/
theorem rankDefect_lt_of_strict_generization (A B:Rep ι)
    (hcl:A∈closure (MulAction.orbit (Gauge ι) B))
    (hnot:B∉MulAction.orbit (Gauge ι) A) : rankDefect ι B<rankDefect ι A := by
  have hA:=rankHeight_le ι A
  have hB:=rankHeight_le ι B
  have hlt:=rankHeight_lt_of_strict_generization ι A B hcl hnot
  unfold rankDefect
  omega

/-- Reverse induction over genuine strict orbit generizations terminates.
The relation is literal ordinary Euclidean closure and actual gauge orbit. -/
theorem wellFounded_strict_generization :
    WellFounded (fun B A:Rep ι=>A∈closure (MulAction.orbit (Gauge ι) B) ∧
      B∉MulAction.orbit (Gauge ι) A) := by
  have hacc:∀ n:ℕ,∀ A:Rep ι,rankDefect ι A=n→
      Acc (fun B A:Rep ι=>A∈closure (MulAction.orbit (Gauge ι) B) ∧
        B∉MulAction.orbit (Gauge ι) A) A:=by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih=>
      intro A hA
      constructor
      intro B hBA
      apply ih (rankDefect ι B) ?_ B rfl
      rw [← hA]
      exact rankDefect_lt_of_strict_generization ι A B hBA.1 hBA.2
  exact ⟨fun A=>hacc (rankDefect ι A) A rfl⟩

end MAIS.QuiverOrbitFiniteHeight
end

