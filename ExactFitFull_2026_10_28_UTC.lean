-- ==================== begin module O7.WeightedRadialIntegral (formalization/O7/WeightedRadialIntegral.lean) ====================
section

/-! The literal positive-radius weighted power-log integral and its exact
logarithmic substitution to the already estimated actual finite moments. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.WeightedRadialIntegral
open MAIS.WeightedRadialMoments MAIS.WeightedRadialOrder O77.Residual

def logCoordinate (D eps r : ℝ) := D*Real.log r-Real.log eps

def integrand (A D beta : ℝ) (n : ℕ) (eps r : ℝ) : ℝ :=
  r^(A-1)*(eps/r^D)^beta*(Real.log (r^D/eps))^n

/-- The actual radial integral, with its genuine finite radius cutoff. -/
def radialIntegral (A D beta delta : ℝ) (n : ℕ) (eps : ℝ) : ℝ :=
  eps^(A/D) + ∫ r in (eps^(1/D))..delta, integrand A D beta n eps r

private theorem log_ratio_rpow {D eps r : ℝ} (heps : 0<eps) (hr : 0<r) :
    Real.log (r^D/eps) = logCoordinate D eps r := by
  rw [Real.log_div (Real.rpow_pos_of_pos hr D).ne' heps.ne',Real.log_rpow hr]
  rfl

/-- Literal pointwise change-of-variables identity, including the actual
Jacobian D/r. No transformed integral is assumed. -/
theorem integrand_eq_pullback {A D beta eps r : ℝ} (hD : 0<D) (heps : 0<eps)
    (hr : 0<r) (n : ℕ) :
    integrand A D beta n eps r = eps^(A/D)/D *
      (Real.exp ((A/D-beta)*logCoordinate D eps r)*(logCoordinate D eps r)^n) * (D/r) := by
  have hlog := log_ratio_rpow (D:=D) heps hr
  have hcoef : r^(A-1)*(eps/r^D)^beta =
      eps^(A/D)*Real.exp ((A/D-beta)*logCoordinate D eps r)/r := by
    calc
      r^(A-1)*(eps/r^D)^beta =
          Real.exp ((A-1)*Real.log r+beta*(Real.log eps-D*Real.log r)) := by
        rw [Real.rpow_def_of_pos hr,
          Real.rpow_def_of_pos (div_pos heps (Real.rpow_pos_of_pos hr D)),
          Real.log_div heps.ne' (Real.rpow_pos_of_pos hr D).ne',Real.log_rpow hr,
          ← Real.exp_add]
        congr 1
        ring
      _ = Real.exp ((A/D)*Real.log eps+(A/D-beta)*logCoordinate D eps r-Real.log r) := by
        congr 1
        unfold logCoordinate
        field_simp
        ring
      _ = _ := by
        rw [Real.exp_sub,Real.exp_add,Real.exp_log hr,Real.rpow_def_of_pos heps]
        rw [mul_comm (Real.log eps) (A/D)]
  rw [integrand,hlog,hcoef]
  field_simp

/-- The original radius integral equals the actual finite exponential moment
for every positive epsilon and radius, with no asymptotic substitution premise. -/
theorem radialIntegral_eq_model {A D beta delta eps : ℝ}
    (hD : 0<D) (hdelta : 0<delta) (heps : 0<eps) (n : ℕ) :
    radialIntegral A D beta delta n eps = model (A/D) beta D (D*Real.log delta) n eps := by
  let low : ℝ := eps^(1/D)
  have hlow : 0<low := Real.rpow_pos_of_pos heps _
  have hrpos : ∀ r ∈ uIcc low delta, 0<r := by
    intro r hr
    exact lt_of_lt_of_le (lt_min hlow hdelta) hr.1
  have hd : ∀ r ∈ uIcc low delta,
      HasDerivAt (logCoordinate D eps) (D/r) r := by
    intro r hr
    have h := (((hasDerivAt_id r).log (hrpos r hr).ne').const_mul D).sub_const (Real.log eps)
    convert! h using 1
    simp only [div_eq_mul_inv,one_mul,id_eq]
  have hc : ContinuousOn (fun r : ℝ => D/r) (uIcc low delta) := by
    intro r hr
    exact (continuousAt_const.div continuousAt_id (hrpos r hr).ne').continuousWithinAt
  have hcv := intervalIntegral.integral_comp_mul_deriv hd hc
    (continuous_integrand (A/D-beta) n)
  have hlow0 : logCoordinate D eps low = 0 := by
    unfold logCoordinate low
    rw [Real.log_rpow heps]
    field_simp
    ring
  rw [hlow0] at hcv
  have hint : (∫ r in low..delta, integrand A D beta n eps r) =
      eps^(A/D)/D * moment (A/D-beta) n (D*Real.log delta-Real.log eps) := by
    calc
      _ = ∫ r in low..delta, eps^(A/D)/D *
          ((Real.exp ((A/D-beta)*logCoordinate D eps r)*(logCoordinate D eps r)^n)*(D/r)) := by
        apply intervalIntegral.integral_congr
        intro r hr
        rw [integrand_eq_pullback hD heps (hrpos r hr) n]
        ring
      _ = eps^(A/D)/D * ∫ r in low..delta,
          (Real.exp ((A/D-beta)*logCoordinate D eps r)*(logCoordinate D eps r)^n)*(D/r) :=
        intervalIntegral.integral_const_mul _ _
      _ = _ := by
        rw [show (fun r => (Real.exp ((A/D-beta)*logCoordinate D eps r)*
            (logCoordinate D eps r)^n)*(D/r)) =
            (fun r => ((fun u : ℝ => Real.exp ((A/D-beta)*u)*u^n) ∘
              logCoordinate D eps) r*(D/r)) by rfl,hcv]
        rfl
  unfold radialIntegral
  change eps^(A/D)+(∫ r in low..delta, integrand A D beta n eps r) = _
  rw [hint,model]
  ring

/-- On its genuine small-epsilon interval the actual radial integral term
is nonnegative; the assertion is derived from the exact substitution. -/
theorem radial_integral_term_nonneg {A D beta delta eps : ℝ}
    (hD : 0<D) (hdelta : 0<delta) (heps : 0<eps) (hsmall : eps≤delta^D) (n : ℕ) :
    0 ≤ ∫ r in (eps^(1/D))..delta, integrand A D beta n eps r := by
  have hlog := Real.log_le_log heps hsmall
  rw [Real.log_rpow hdelta] at hlog
  have hm := moment_nonneg (A/D-beta) n (sub_nonneg.mpr hlog)
  have hp := mul_nonneg (Real.rpow_nonneg heps.le (A/D)) (div_nonneg hm hD.le)
  have heq := radialIntegral_eq_model (A:=A) (beta:=beta) hD hdelta heps n
  unfold radialIntegral model at heq
  nlinarith

/-- The full actual model is strictly positive throughout that interval. -/
theorem radialIntegral_pos {A D beta delta eps : ℝ}
    (hD : 0<D) (hdelta : 0<delta) (heps : 0<eps) (hsmall : eps≤delta^D) (n : ℕ) :
    0 < radialIntegral A D beta delta n eps := by
  unfold radialIntegral
  exact add_pos_of_pos_of_nonneg (Real.rpow_pos_of_pos heps _)
    (radial_integral_term_nonneg hD hdelta heps hsmall n)

/-- Actual small-parameter orders of the original finite-radius integral. -/
theorem radialIntegral_trichotomy {A D beta delta : ℝ}
    (hD : 0<D) (hdelta : 0<delta) (n : ℕ) :
    (beta<A/D → EThetaZeroPowerLog
      (fun eps => ENNReal.ofReal (radialIntegral A D beta delta n eps)) beta n) ∧
    (beta=A/D → EThetaZeroPowerLog
      (fun eps => ENNReal.ofReal (radialIntegral A D beta delta n eps)) (A/D) (n+1)) ∧
    (A/D<beta → EThetaZeroPowerLog
      (fun eps => ENNReal.ofReal (radialIntegral A D beta delta n eps)) (A/D) 0) := by
  have htransfer : ∀ lam k,
      EThetaZeroPowerLog
        (fun eps => ENNReal.ofReal (model (A/D) beta D (D*Real.log delta) n eps)) lam k →
      EThetaZeroPowerLog
        (fun eps => ENNReal.ofReal (radialIntegral A D beta delta n eps)) lam k := by
    intro lam k hp
    obtain ⟨c,C,e,hc,hcC,he,heExp,hb⟩ := hp
    refine ⟨c,C,e,hc,hcC,he,heExp,?_⟩
    intro eps heps hsmall
    dsimp only
    rw [radialIntegral_eq_model hD hdelta heps n]
    exact hb eps heps hsmall
  obtain ⟨hlt,heq,hgt⟩ := model_trichotomy (alpha:=A/D) (beta:=beta) (L:=D*Real.log delta) hD n
  exact ⟨fun h => htransfer _ _ (hlt h),fun h => htransfer _ _ (heq h),
    fun h => htransfer _ _ (hgt h)⟩

/-- The conventional angular multiplicity m>=1 formulation of the actual
integral trichotomy, with no truncated natural subtraction ambiguity. -/
theorem radialIntegral_multiplicity_trichotomy {A D beta delta : ℝ}
    (hD : 0<D) (hdelta : 0<delta) (m : ℕ) (hm : 1 ≤ m) :
    (beta<A/D → EThetaZeroPowerLog
      (fun eps => ENNReal.ofReal (radialIntegral A D beta delta (m-1) eps)) beta (m-1)) ∧
    (beta=A/D → EThetaZeroPowerLog
      (fun eps => ENNReal.ofReal (radialIntegral A D beta delta (m-1) eps)) (A/D) m) ∧
    (A/D<beta → EThetaZeroPowerLog
      (fun eps => ENNReal.ofReal (radialIntegral A D beta delta (m-1) eps)) (A/D) 0) := by
  simpa only [Nat.sub_add_cancel hm] using radialIntegral_trichotomy
    (A:=A) (beta:=beta) hD hdelta (m-1)

end MAIS.WeightedRadialIntegral
end

