-- ==================== begin module O7.Run2PotentialAllHigherLabels (formalization/O7/Run2PotentialAllHigherLabels.lean) ====================
section

/-! Actual measured labels for ALL strict higher zero-output orbits are
attained on the genuine residual annulus. Geometric same-orbit witnesses are
converted using the actual nearby full slice, Gaussian cancellation, Haar
gauge invariance and exact weighted dilation transport. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Topology ENNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialAllHigherLabels
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.ActiveIntervalMeasuredSlice MAIS.ActiveIntervalAnnulusRecurrence
open MAIS.ActiveIntervalWeightedResidual MAIS.ActiveIntervalRecursivePair
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverGaugeMeasuredPair
open MAIS.WeightedDyadicShells MAIS.WeightedCompactAnnulus MAIS.AnalyticTransfer
open MAIS.QuiverFinitePairTable
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- Every genuine higher ambient measured pair is attained by an actual
annular residual pair with the derived Gaussian exponent subtraction. -/
theorem annular_pair_of_higher_ambient_pair
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muT : Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR : Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0)
    (A : Ambient D birth death)
    (hA : IsHigherZero (Index D birth death) (intervalRep D birth death) A)
    {a : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair muA (Metric.ball A)
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) A a m) :
    ∃ z ∈ compactAnnulus (integerWeights D birth death),
      residualLoss D birth death hD z = 0 ∧
      HasMeasuredBandPair muR (Metric.ball z) (residualLoss D birth death hD) z
        (a - (Fintype.card (DirectIndex D birth death) : ℝ) / 2) m := by
  obtain ⟨V, hVo, h0V, hnear⟩ :=
    MAIS.ActiveIntervalNearbyResidual.exists_open_residual_pair_of_ambient_pair
      D birth death hD hvalid muA muT muR
  obtain ⟨z, hzK, hzH, r, hr, hrV, hrO⟩ :=
    (MAIS.Run2AllHigherAttainment.strict_higher_zero_iff_attained
      D birth death hD hvalid hzero V (hVo.mem_nhds h0V) A).mp hA
  let y := dilation (integerWeights D birth death) r z
  have hhom : ∀ s : ℝ, 0 < s → ∀ x : Residual D birth death,
      residualLoss D birth death hD (dilation (integerWeights D birth death) s x) =
      s ^ (2 * MAIS.IntervalIntegerPotentials.commonDenominator D birth death) *
        residualLoss D birth death hD x := by
    intro s hs x
    exact zero_base_residualLoss_integerDilation D birth death hD hzero s hs x
  have hyH : residualLoss D birth death hD y = 0 := by
    rw [hhom r hr z, hzH, mul_zero]
  obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp hrO
  have hyP : HasMeasuredBandPair muA (Metric.ball (zeroDirectRep D birth death hD y))
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
      (zeroDirectRep D birth death hD y) a m := by
    rw [← hg]
    exact (pair_iff_gauge_zero (Index D birth death) muA muA g A
      0 (Fin.last D) (Nat.zero_le D) hA.1 a m).mp hp
  have hyr := hnear y hrV hyH a m hyP
  refine ⟨z, hzK, hzH, ?_⟩
  exact (MAIS.WeightedAnnulusPairTransport.pair_iff_dilation muR
    (integerWeights D birth death) (2 * MAIS.IntervalIntegerPotentials.commonDenominator D birth death)
    (residualLoss D birth death hD) (continuous_residualLoss D birth death hD).measurable
    hhom r hr z _ _).mpr hyr

/-- The actual finite higher-orbit table can be chosen so EVERY label is
attained. Coverage and label values are genuine ambient measured witnesses;
actual pair existence and actual geometric exhaustion are proved inputs. -/
theorem exists_all_attained_higher_table
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muT : Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR : Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0) :
    ∃ a : HigherOrbitIndex (Index D birth death) (intervalRep D birth death) → ℝ,
      ∃ m : HigherOrbitIndex (Index D birth death) (intervalRep D birth death) → ℕ,
        HigherTable D birth death a m muA ∧
        (∀ j, Attained D birth death hD a m muR j) ∧
        (∀ j, HasMeasuredBandPair muA
          (Metric.ball (representative (Index D birth death) (intervalRep D birth death) j))
          (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
          (representative (Index D birth death) (intervalRep D birth death) j) (a j) (m j)) := by
  classical
  let ι := Index D birth death
  let base := intervalRep D birth death
  have hp : ∀ j : HigherOrbitIndex ι base, ∃ a : ℝ, ∃ m : ℕ,
      HasMeasuredBandPair muA (Metric.ball (representative ι base j))
        (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
        (representative ι base j) a m := by
    intro j
    exact MAIS.QuiverZeroPairExistence.exists_pair_zero_output ι muA
      (representative ι base j) (representative_spec ι base j).1.1
  choose a m hm using hp
  refine ⟨a, m, ?_, ?_, hm⟩
  · intro A hz hcl hnot
    let j : HigherOrbitIndex ι base := ⟨Quotient.mk'' A, A, ⟨hz, hcl, hnot⟩, rfl⟩
    have hq : Quotient.mk'' A = Quotient.mk'' (representative ι base j) :=
      (representative_spec ι base j).2.symm
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp (Quotient.exact hq)
    refine ⟨j, ?_⟩
    rw [← hg]
    exact (pair_iff_gauge_zero ι muA muA g (representative ι base j)
      0 (Fin.last D) (Nat.zero_le D) (representative_spec ι base j).1.1
      (a j) (m j)).mp (hm j)
  · intro j
    exact annular_pair_of_higher_ambient_pair D birth death hD hvalid muA muT muR
      hzero (representative ι base j) (representative_spec ι base j).1 (hm j)

end MAIS.Run2PotentialAllHigherLabels

/-- info: 'MAIS.Run2PotentialAllHigherLabels.annular_pair_of_higher_ambient_pair' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialAllHigherLabels.annular_pair_of_higher_ambient_pair

/-- info: 'MAIS.Run2PotentialAllHigherLabels.exists_all_attained_higher_table' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialAllHigherLabels.exists_all_attained_higher_table
end
