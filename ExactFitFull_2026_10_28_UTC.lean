-- ==================== begin module O7.Run2PositivePairFormula (formalization/O7/Run2PositivePairFormula.lean) ====================
section

/-! An actual arbitrary-rank exact-fit pair formula. Its coefficients use
only actual target rank and the independently defined balanced-incidence
minimum / finite weighted-path maximum of the true reduced zero chain. -/
set_option autoImplicit false
set_option maxHeartbeats 1800000
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PositivePairFormula
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.ActiveIntervalDifferential
open MAIS.Run2FullSpanCoordinates MAIS.Run2FullSpanProduct MAIS.BarcodeActiveNormalForm
open MAIS.Run2PositiveNormalFormCounts MAIS.AnalyticTransfer
variable {D : ℕ} {ι : Fin (D+1) → Type*}
  [∀ v,Fintype (ι v)] [∀ v,DecidableEq (ι v)]

local instance matrixSecondCountable (I J : Type*) [Fintype I] [Fintype J] :
    SecondCountableTopology (Matrix I J ℝ) :=
  inferInstanceAs (SecondCountableTopology (I → J → ℝ))

abbrev ReducedCarrier {A : Rep ι} (N : ActiveNormalForm A) := ReducedIndex D N.birth N.death

def reducedBase {A : Rep ι} (N : ActiveNormalForm A) : Rep (ReducedCarrier N) :=
  intervalRep D (reducedBirth D N.birth N.death) (reducedDeath D N.birth N.death)

/-- This integer is an actual balanced-incidence minimum, containing no
measured exponent, pair value or proposed answer in its definition. -/
def residualMinimum {A : Rep ι} (N : ActiveNormalForm A) : ℕ :=
  MAIS.Run2PotentialBalancedMinimum.balancedOutputMinimum (ReducedCarrier N) (reducedBase N)

/-- This integer is an attained finite weighted-path maximum on the actual
reduced zero-output orbit graph, independent of measured multiplicities. -/
def residualCriticalDepth {A : Rep ι} (N : ActiveNormalForm A) : ℕ :=
  MAIS.Run2PotentialCriticalPath.criticalDepth (ReducedCarrier N)
    (MAIS.Run2PotentialOrbitGraph.indexOf (ReducedCarrier N) (reducedBase N)
      (reduced_base_completeProduct_zero D N.birth N.death N.bounded))

/-- The full pointed actual pair is exactly the independent reduced incidence
minimum plus the actual original target-rank count, with the unchanged true
critical-path multiplicity. Every normalization datum is an actual normal form. -/
theorem pair_iff_formula (hD : 0 < D) {A : Rep ι} (N : ActiveNormalForm A)
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-
        pathMatrix A 0 (Fin.last D) (Nat.zero_le D)‖^2) A lam m ↔
      lam = ((regularCount A+residualMinimum N : ℕ) : ℝ)/2 ∧
      m = 1+residualCriticalDepth N := by
  let muC : Measure (Rep (Index D N.birth N.death)) := addHaar
  let muRed : Measure (Rep (ReducedCarrier N)) := addHaar
  have hc := MAIS.Run2PositiveMeasuredNormalForm.pair_iff_normal_form_pointed
    N mu muC 0 (Fin.last D) (Nat.zero_le D) lam m
  have hr := MAIS.Run2PositiveIntervalReduction.pair_iff_reduced_pair
    D N.birth N.death N.bounded hD N.valid muC muRed lam m
  have hf := MAIS.Run2PotentialCriticalPath.actual_pair_iff (ReducedCarrier N) muRed
    (reducedBase N) (reduced_base_completeProduct_zero D N.birth N.death N.bounded)
    (lam-(Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace
      (FullSlot D N.birth N.death) (ReducedIndex D N.birth N.death (Fin.last D))
      (ReducedIndex D N.birth N.death 0)) : ℝ)/2) m
  have he := hc.trans (hr.trans hf)
  rw [finrank_regular_eq_actual_count N] at he
  change _ ↔ lam-(regularCount A:ℝ)/2=(residualMinimum N:ℝ)/2 ∧
    m=1+residualCriticalDepth N at he
  rw [he]
  constructor
  · rintro ⟨ha,hm⟩
    refine ⟨?_,hm⟩
    push_cast
    linarith
  · rintro ⟨ha,hm⟩
    refine ⟨?_,hm⟩
    push_cast at ha
    linarith

/-- At a prescribed actual exact fit, the explicit coefficient uses the
literal target rank r and the actual endpoint dimensions n0,nD. -/
theorem pair_iff_exact_fit_formula (hD : 0 < D) {A : Rep ι} (N : ActiveNormalForm A)
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=target)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2) A lam m ↔
      lam = ((target.rank*(Fintype.card (ι 0)+Fintype.card (ι (Fin.last D))-target.rank)+
        residualMinimum N : ℕ) : ℝ)/2 ∧ m=1+residualCriticalDepth N := by
  simpa only [hfit,regularCount_eq_target target hfit] using pair_iff_formula hD N mu lam m

/-- The same exact independent formula holds for literal half loss, any
positive continuous ambient prior and true all-original-entry Euclidean balls. -/
theorem entry_half_prior_pair_iff_formula (hD : 0 < D) {A : Rep ι} (N : ActiveNormalForm A)
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=target)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2)
      A lam m ↔
      lam = ((target.rank*(Fintype.card (ι 0)+Fintype.card (ι (Fin.last D))-target.rank)+
        residualMinimum N : ℕ) : ℝ)/2 ∧ m=1+residualCriticalDepth N := by
  let f : Rep ι → ℝ := fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2
  have hs := MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_positive_scale mu
    (Metric.ball A) (fun _ _ h => Metric.ball_subset_ball h) f A (1/2:ℝ) (by norm_num) lam m
  have hf : Measurable (fun B : Rep ι => (1/2:ℝ)*f B) :=
    measurable_const.mul (((continuous_pathMatrix 0 (Fin.last D) (Nat.zero_le D)).sub
      continuous_const).norm.pow 2).measurable
  have hp := MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior mu hf hprior hpos
    (lam:=lam) (m:=m)
  have hw := MAIS.MatrixChainEntryWindows.pair_iff_entryBall ι
    (mu.withDensity (fun B => ENNReal.ofReal (prior B))) A
    (f:=fun B => (1/2:ℝ)*f B) (lam:=lam) (m:=m)
  exact ((hs.trans hp).trans hw).symm.trans (pair_iff_exact_fit_formula hD N mu target hfit lam m)

end MAIS.Run2PositivePairFormula

/-- info: 'MAIS.Run2PositivePairFormula.pair_iff_formula' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositivePairFormula.pair_iff_formula

/-- info: 'MAIS.Run2PositivePairFormula.pair_iff_exact_fit_formula' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositivePairFormula.pair_iff_exact_fit_formula

/-- info: 'MAIS.Run2PositivePairFormula.entry_half_prior_pair_iff_formula' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositivePairFormula.entry_half_prior_pair_iff_formula
end
end
-- ==================== end module O7.Run2PositivePairFormula ====================

-- ==================== begin module O7.Run2ArithmeticPositiveResidualCounts (formalization/O7/Run2ArithmeticPositiveResidualCounts.lean) ====================
section

/-! The residual dimensions and consecutive path ranks are DERIVED by
deleting literal full-span labels. They are not supplied as numerical
normalization inputs. All ranks refer to actual composed matrices. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
namespace MAIS.Run2ArithmeticPositiveResidualCounts
open MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalPivotRanks
open MAIS.Run2FullSpanCoordinates MAIS.Run2FullSpanProduct
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.BarcodeActiveNormalForm
open MAIS.Run2PositivePairFormula
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ)

/-- Actual path-surviving labels split into all full-span labels and the
remaining path-surviving labels. -/
def commonEquiv (i j : Fin (D + 1)) :
    Common D birth death i j ≃ FullSlot D birth death ⊕
      Common D (reducedBirth D birth death) (reducedDeath D birth death) i j := by
  classical
  exact {
    toFun := fun s => if h : IsFull D birth death s.val then
      Sum.inl ⟨s.val, h⟩ else Sum.inr ⟨⟨s.val, h⟩, s.property⟩
    invFun := fun s => match s with
      | Sum.inl f => ⟨f.val, full_active D birth death f i, full_active D birth death f j⟩
      | Sum.inr r => ⟨r.val.val, r.property⟩
    left_inv := by
      intro s
      by_cases h : IsFull D birth death s.val <;> simp [h]
    right_inv := by
      intro s
      cases s with
      | inl f => simp [f.property]
      | inr r => simp [r.val.property]
  }

theorem interval_path_rank_split (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (intervalRep D birth death) i j hij).rank =
      Fintype.card (FullSlot D birth death) +
        (pathMatrix (intervalRep D (reducedBirth D birth death)
          (reducedDeath D birth death)) i j hij).rank := by
  rw [path_rank_eq_common_card, path_rank_eq_common_card]
  exact (Fintype.card_congr (commonEquiv D birth death i j)).trans Fintype.card_sum

def fullCommonEquiv (hD : ∀ s, death s ≤ D + 1) :
    Common D birth death 0 (Fin.last D) ≃ FullSlot D birth death where
  toFun s := ⟨s.val, by
    have hb := s.property.1.1
    have hd := s.property.2.2
    have hh := hD s.val
    change birth s.val ≤ 0 at hb
    change D < death s.val at hd
    exact ⟨by omega, by omega⟩⟩
  invFun s := ⟨s.val, full_active D birth death s 0, full_active D birth death s (Fin.last D)⟩
  left_inv _ := rfl
  right_inv _ := rfl

theorem interval_full_rank (hD : ∀ s, death s ≤ D + 1) :
    (pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D)).rank =
      Fintype.card (FullSlot D birth death) := by
  rw [path_rank_eq_common_card]
  exact Fintype.card_congr (fullCommonEquiv D birth death hD)

variable {D} {ι : Fin (D + 1) → Type*}
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

theorem full_card_eq_original_rank {A : Rep ι} (N : ActiveNormalForm A) :
    Fintype.card (FullSlot D N.birth N.death) =
      (pathMatrix A 0 (Fin.last D) (Nat.zero_le D)).rank :=
  (interval_full_rank D N.birth N.death N.bounded).symm.trans
    (N.rank_eq 0 (Fin.last D) (Nat.zero_le D))

/-- At every vertex the true residual dimension is the original dimension
minus the actual complete-product rank. -/
theorem residual_dimension {A : Rep ι} (N : ActiveNormalForm A) (v : Fin (D + 1)) :
    Fintype.card (ReducedCarrier N v) = Fintype.card (ι v) -
      (pathMatrix A 0 (Fin.last D) (Nat.zero_le D)).rank := by
  have he := Fintype.card_congr (vertexEquiv D N.birth N.death v)
  rw [Fintype.card_sum, full_card_eq_original_rank N] at he
  have hc := Fintype.card_congr (N.coordinates v)
  change Fintype.card (ReducedIndex D N.birth N.death v) = _
  omega

/-- Every true residual consecutive rank is the original consecutive rank
minus the complete-product rank, including the diagonal vertex paths. -/
theorem residual_path_rank {A : Rep ι} (N : ActiveNormalForm A)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (reducedBase N) i j hij).rank = (pathMatrix A i j hij).rank -
      (pathMatrix A 0 (Fin.last D) (Nat.zero_le D)).rank := by
  have he := interval_path_rank_split D N.birth N.death i j hij
  rw [N.rank_eq i j hij, full_card_eq_original_rank N] at he
  change (pathMatrix (reducedBase N) i j hij).rank = _
  change (pathMatrix A i j hij).rank =
    (pathMatrix A 0 (Fin.last D) (Nat.zero_le D)).rank +
      (pathMatrix (reducedBase N) i j hij).rank at he
  omega

end MAIS.Run2ArithmeticPositiveResidualCounts

/-- info: 'MAIS.Run2ArithmeticPositiveResidualCounts.interval_path_rank_split' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositiveResidualCounts.interval_path_rank_split

/-- info: 'MAIS.Run2ArithmeticPositiveResidualCounts.full_card_eq_original_rank' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositiveResidualCounts.full_card_eq_original_rank

/-- info: 'MAIS.Run2ArithmeticPositiveResidualCounts.residual_dimension' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositiveResidualCounts.residual_dimension

/-- info: 'MAIS.Run2ArithmeticPositiveResidualCounts.residual_path_rank' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositiveResidualCounts.residual_path_rank
end
end
