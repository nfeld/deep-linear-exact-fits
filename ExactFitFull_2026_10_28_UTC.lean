-- ==================== begin module O7.Run2SchurProductNorm (formalization/O7/Run2SchurProductNorm.lean) ====================
section

/-! Uniform actual Schur-unit comparison for genuine endpoint matrix families.
All unit and boundedness neighborhoods are derived from the identity base. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Matrix Filter
open scoped Matrix Matrix.Norms.Frobenius Topology
namespace MAIS.Run2SchurProductNorm
open MAIS.Run2SchurRectangular MAIS.Run2SchurPositiveProduct MAIS.Run2SchurOutputCoordinates
variable {R M N E : Type*} [Fintype R] [Fintype M] [Fintype N]
  [DecidableEq R] [DecidableEq M] [DecidableEq N] [TopologicalSpace E]

/-- The actual nonsingular inverse is continuous at any actual unit. -/
theorem continuousAt_inverse_family {K : Type*} [Fintype K] [DecidableEq K]
    (F : E → Matrix K K ℝ) (w : E) (hF : ContinuousAt F w) (hunit : IsUnit (F w)) :
    ContinuousAt (fun p => (F p)⁻¹) w :=
  (contDiffAt_matrix_inverse (F w) hunit).continuousAt.comp hF

/-- Continuity of the literal rectangular product in arbitrary parameter spaces. -/
theorem continuousAt_matrix_mul {I J K : Type*} [Fintype I] [Fintype J] [Fintype K]
    {F : E → Matrix I J ℝ} {G : E → Matrix J K ℝ} {w : E}
    (hF : ContinuousAt F w) (hG : ContinuousAt G w) :
    ContinuousAt (fun p => F p * G p) w := by
  exact ((MAIS.MatrixSmoothMul.mulCLM (l:=I) (m:=J) (n:=K)).continuous.continuousAt.comp hF).clm_apply hG

/-- Actual units persist near a continuous family with unit base. -/
theorem eventually_isUnit {K : Type*} [Fintype K] [DecidableEq K]
    (F : E → Matrix K K ℝ) (w : E) (hF : ContinuousAt F w) (hunit : IsUnit (F w)) :
    ∀ᶠ p in 𝓝 w, IsUnit (F p) :=
  hF.eventually (Units.isOpen.mem_nhds hunit)

/-- The upper Frobenius estimate for a literal rectangular triple product. -/
theorem norm_triple_le (L : Matrix M M ℝ) (S : Matrix M N ℝ) (Z : Matrix N N ℝ) :
    ‖L*S*Z‖ ≤ (‖L‖*‖Z‖)*‖S‖ := by
  calc
    _ ≤ (‖L‖*‖S‖)*‖Z‖ := (Matrix.frobenius_norm_mul _ _).trans
      (mul_le_mul_of_nonneg_right (Matrix.frobenius_norm_mul _ _) (norm_nonneg _))
    _ = _ := by ring

/-- Both uniform comparison constants are derived from actual continuous
endpoint families. All four blocks and both central inverses are literal. -/
theorem exists_schur_squared_comparison
    (L : E → Matrix (R⊕M) (R⊕M) ℝ)
    (Z : E → Matrix (R⊕N) (R⊕N) ℝ) (S : E → Matrix M N ℝ) (w : E)
    (hL : ContinuousAt L w) (hZ : ContinuousAt Z w) (hS : ContinuousAt S w)
    (hL0 : L w = 1) (hZ0 : Z w = 1) (hS0 : S w = 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ p in 𝓝 w,
      ‖S p‖^2/C ≤ ‖schur (L p * fromBlocks (1 : Matrix R R ℝ) 0 0 (S p) * Z p)‖^2 ∧
      ‖schur (L p * fromBlocks (1 : Matrix R R ℝ) 0 0 (S p) * Z p)‖^2 ≤ C*‖S p‖^2 := by
  let A := fun p => (L p).toBlocks₁₁
  let B := fun p => (L p).toBlocks₁₂
  let Cb := fun p => (L p).toBlocks₂₁
  let D := fun p => (L p).toBlocks₂₂
  let E1 := fun p => (Z p).toBlocks₁₁
  let F := fun p => (Z p).toBlocks₁₂
  let G := fun p => (Z p).toBlocks₂₁
  let H := fun p => (Z p).toBlocks₂₂
  have hA : ContinuousAt A w :=
    (submatrixCLM (I:=R⊕M) (J:=R⊕M) (K:=R) (L:=R) Sum.inl Sum.inl).continuous.continuousAt.comp hL
  have hB : ContinuousAt B w :=
    (submatrixCLM (I:=R⊕M) (J:=R⊕M) (K:=R) (L:=M) Sum.inl Sum.inr).continuous.continuousAt.comp hL
  have hCb : ContinuousAt Cb w :=
    (submatrixCLM (I:=R⊕M) (J:=R⊕M) (K:=M) (L:=R) Sum.inr Sum.inl).continuous.continuousAt.comp hL
  have hD : ContinuousAt D w :=
    (submatrixCLM (I:=R⊕M) (J:=R⊕M) (K:=M) (L:=M) Sum.inr Sum.inr).continuous.continuousAt.comp hL
  have hE : ContinuousAt E1 w :=
    (submatrixCLM (I:=R⊕N) (J:=R⊕N) (K:=R) (L:=R) Sum.inl Sum.inl).continuous.continuousAt.comp hZ
  have hF : ContinuousAt F w :=
    (submatrixCLM (I:=R⊕N) (J:=R⊕N) (K:=R) (L:=N) Sum.inl Sum.inr).continuous.continuousAt.comp hZ
  have hG : ContinuousAt G w :=
    (submatrixCLM (I:=R⊕N) (J:=R⊕N) (K:=N) (L:=R) Sum.inr Sum.inl).continuous.continuousAt.comp hZ
  have hH : ContinuousAt H w :=
    (submatrixCLM (I:=R⊕N) (J:=R⊕N) (K:=N) (L:=N) Sum.inr Sum.inr).continuous.continuousAt.comp hZ
  have hA0 : A w = 1 := by ext i j; simp [A,hL0,Matrix.one_apply,Matrix.toBlocks₁₁]
  have hE0 : E1 w = 1 := by ext i j; simp [E1,hZ0,Matrix.one_apply,Matrix.toBlocks₁₁]
  have hAi := continuousAt_inverse_family A w hA (hA0.symm ▸ isUnit_one)
  have hEi := continuousAt_inverse_family E1 w hE (hE0.symm ▸ isUnit_one)
  let U := fun p => (A p)⁻¹ * B p
  let V := fun p => G p * (E1 p)⁻¹
  let Ls := fun p => D p-Cb p*(A p)⁻¹*B p
  let Zs := fun p => H p-G p*(E1 p)⁻¹*F p
  let T := fun p => (1 : Matrix R R ℝ)+U p*S p*V p
  let K := fun p => (1 : Matrix N N ℝ)+V p*U p*S p
  have hU : ContinuousAt U w := continuousAt_matrix_mul hAi hB
  have hV : ContinuousAt V w := continuousAt_matrix_mul hG hEi
  have hLs : ContinuousAt Ls w := hD.sub (continuousAt_matrix_mul (continuousAt_matrix_mul hCb hAi) hB)
  have hZs : ContinuousAt Zs w := hH.sub (continuousAt_matrix_mul (continuousAt_matrix_mul hG hEi) hF)
  have hT : ContinuousAt T w := continuousAt_const.add (continuousAt_matrix_mul (continuousAt_matrix_mul hU hS) hV)
  have hK : ContinuousAt K w := continuousAt_const.add (continuousAt_matrix_mul (continuousAt_matrix_mul hV hU) hS)
  have hB0 : B w = 0 := by ext i j; simp [B,hL0,Matrix.toBlocks₁₂]
  have hCb0 : Cb w = 0 := by ext i j; simp [Cb,hL0,Matrix.toBlocks₂₁]
  have hD0 : D w = 1 := by ext i j; simp [D,hL0,Matrix.toBlocks₂₂,Matrix.one_apply]
  have hF0 : F w = 0 := by ext i j; simp [F,hZ0,Matrix.toBlocks₁₂]
  have hG0 : G w = 0 := by ext i j; simp [G,hZ0,Matrix.toBlocks₂₁]
  have hH0 : H w = 1 := by ext i j; simp [H,hZ0,Matrix.toBlocks₂₂,Matrix.one_apply]
  have hLs0 : Ls w = 1 := by simp only [Ls,hD0,hCb0,Matrix.zero_mul,sub_zero]
  have hZs0 : Zs w = 1 := by simp only [Zs,hH0,hG0,Matrix.zero_mul,sub_zero]
  have hT0 : T w = 1 := by simp [T,hS0]
  have hK0 : K w = 1 := by simp [K,hS0]
  have hLsi := continuousAt_inverse_family Ls w hLs (hLs0.symm ▸ isUnit_one)
  have hZsi := continuousAt_inverse_family Zs w hZs (hZs0.symm ▸ isUnit_one)
  have hKi := continuousAt_inverse_family K w hK (hK0.symm ▸ isUnit_one)
  let upper := fun p => (‖Ls p‖*‖(K p)⁻¹‖)*‖Zs p‖
  let lower := fun p => (‖(Ls p)⁻¹‖*‖(Zs p)⁻¹‖)*‖K p‖
  have hup : ContinuousAt upper w := (hLs.norm.mul hKi.norm).mul hZs.norm
  have hlo : ContinuousAt lower w := (hLsi.norm.mul hZsi.norm).mul hK.norm
  let bound := max (upper w) (lower w)+1
  have hbound : 0 < bound := by
    have hu0 : 0 ≤ upper w := by dsimp [upper]; positivity
    dsimp [bound]
    linarith [le_max_left (upper w) (lower w)]
  have heupper : ∀ᶠ p in 𝓝 w, upper p < bound :=
    hup.eventually_lt_const (by dsimp [bound]; linarith [le_max_left (upper w) (lower w)])
  have helower : ∀ᶠ p in 𝓝 w, lower p < bound :=
    hlo.eventually_lt_const (by dsimp [bound]; linarith [le_max_right (upper w) (lower w)])
  refine ⟨bound^2,sq_pos_of_pos hbound, ?_⟩
  filter_upwards [heupper,helower,eventually_isUnit A w hA (hA0.symm ▸ isUnit_one),
    eventually_isUnit E1 w hE (hE0.symm ▸ isUnit_one),
    eventually_isUnit Ls w hLs (hLs0.symm ▸ isUnit_one),
    eventually_isUnit Zs w hZs (hZs0.symm ▸ isUnit_one),
    eventually_isUnit T w hT (hT0.symm ▸ isUnit_one),
    eventually_isUnit K w hK (hK0.symm ▸ isUnit_one)] with p hup hlo hAu hEu hLu hZu hTu hKu
  let _ := hAu.nonempty_invertible.some
  let _ := hEu.nonempty_invertible.some
  let _ := hLu.nonempty_invertible.some
  let _ := hZu.nonempty_invertible.some
  let _ := hTu.nonempty_invertible.some
  let _ := hKu.nonempty_invertible.some
  let Y := L p * fromBlocks (1 : Matrix R R ℝ) 0 0 (S p) * Z p
  have hformula : schur Y = Ls p*S p*(K p)⁻¹*Zs p := by
    have hh := schur_positive_product (A p) (B p) (Cb p) (D p)
      (E1 p) (F p) (G p) (H p) (S p)
    simpa only [A,B,Cb,D,E1,F,G,H,fromBlocks_toBlocks] using hh
  have hreconstruct : S p = (Ls p)⁻¹ * schur Y * (Zs p)⁻¹ * K p := by
    rw [hformula]
    simp only [Matrix.mul_assoc,Matrix.inv_mul_cancel_left_of_invertible,
      Matrix.mul_inv_cancel_left_of_invertible,Matrix.inv_mul_of_invertible,Matrix.mul_one]
  have hupper : ‖schur Y‖ ≤ bound*‖S p‖ := by
    rw [hformula]
    calc
      _ ≤ ((‖Ls p‖*‖S p‖)*‖(K p)⁻¹‖)*‖Zs p‖ :=
        (Matrix.frobenius_norm_mul _ _).trans
          (mul_le_mul_of_nonneg_right ((Matrix.frobenius_norm_mul _ _).trans
            (mul_le_mul_of_nonneg_right (Matrix.frobenius_norm_mul _ _) (norm_nonneg _))) (norm_nonneg _))
      _ = upper p*‖S p‖ := by dsimp [upper]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_right hup.le (norm_nonneg _)
  have hlower : ‖S p‖ ≤ bound*‖schur Y‖ := by
    calc
      _ = ‖(Ls p)⁻¹ * schur Y * (Zs p)⁻¹ * K p‖ := congrArg norm hreconstruct
      _ ≤ ((‖(Ls p)⁻¹‖*‖schur Y‖)*‖(Zs p)⁻¹‖)*‖K p‖ :=
        (Matrix.frobenius_norm_mul _ _).trans
          (mul_le_mul_of_nonneg_right ((Matrix.frobenius_norm_mul _ _).trans
            (mul_le_mul_of_nonneg_right (Matrix.frobenius_norm_mul _ _) (norm_nonneg _))) (norm_nonneg _))
      _ = lower p*‖schur Y‖ := by dsimp [lower]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_right hlo.le (norm_nonneg _)
  have hu2 := (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hbound.le (norm_nonneg _))).mpr hupper
  have hl2 := (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hbound.le (norm_nonneg _))).mpr hlower
  rw [mul_pow] at hu2 hl2
  exact ⟨(div_le_iff₀ (sq_pos_of_pos hbound)).mpr (by simpa only [mul_comm] using hl2),hu2⟩

end MAIS.Run2SchurProductNorm

/-- info: 'MAIS.Run2SchurProductNorm.continuousAt_inverse_family' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurProductNorm.continuousAt_inverse_family

/-- info: 'MAIS.Run2SchurProductNorm.eventually_isUnit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurProductNorm.eventually_isUnit

/-- info: 'MAIS.Run2SchurProductNorm.exists_schur_squared_comparison' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurProductNorm.exists_schur_squared_comparison
end
end
