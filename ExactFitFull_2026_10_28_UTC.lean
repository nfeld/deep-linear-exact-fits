-- ==================== begin module O7.WeightedCoordinateSlice (formalization/O7/WeightedCoordinateSlice.lean) ====================
section

/-! An explicit actual weighted radial/coordinate slice at every nonzero
coordinate of a finite real vector, with derived inverse and C1 regularity. -/
set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section
open Set
open scoped Topology
namespace MAIS.WeightedCoordinateSlice
variable {I : Type*} [Fintype I] [DecidableEq I]

abbrev Other (p : I) := {i : I // i ≠ p} → ℝ
abbrev Parameters (p : I) := ℝ × Other p

/-- The actual affine cross section x_p=b, with all other entries independent. -/
def lift (p : I) (b : ℝ) (z : Other p) : I → ℝ := fun i =>
  if h : i=p then b else z ⟨i,h⟩

omit [Fintype I] in
@[simp] theorem lift_same (p : I) (b : ℝ) (z : Other p) : lift p b z p = b := by simp [lift]
omit [Fintype I] in
@[simp] theorem lift_other (p : I) (b : ℝ) (z : Other p) (i : {i : I // i ≠ p}) :
    lift p b z i.val = z i := by simp only [lift, dite_eq_right i.property]

/-- Actual diagonal weighted dilation, with arbitrary supplied real weights. -/
def dilate (a : I → ℝ) (s : ℝ) (x : I → ℝ) : I → ℝ := fun i => Real.exp (s*a i)*x i

def forward (a : I → ℝ) (p : I) (b : ℝ) (u : Parameters p) : I → ℝ :=
  dilate a u.1 (lift p b u.2)

def sector (p : I) (b : ℝ) : Set (I → ℝ) := {x | 0 < x p/b}

def radial (a : I → ℝ) (p : I) (b : ℝ) (x : I → ℝ) : ℝ := Real.log (x p/b)/a p

def inverse (a : I → ℝ) (p : I) (b : ℝ) (x : I → ℝ) : Parameters p :=
  (radial a p b x, fun i => Real.exp (-(radial a p b x*a i.val))*x i.val)

omit [Fintype I] in
theorem forward_ratio (a : I → ℝ) (p : I) {b : ℝ} (hb : b≠0) (u : Parameters p) :
    forward a p b u p/b = Real.exp (u.1*a p) := by
  change (Real.exp (u.1*a p)*lift p b u.2 p)/b = _
  rw [lift_same]
  field_simp

omit [Fintype I] in
theorem radial_forward (a : I → ℝ) (p : I) {b : ℝ} (hb : b≠0) (ha : a p≠0)
    (u : Parameters p) : radial a p b (forward a p b u) = u.1 := by
  unfold radial
  rw [forward_ratio a p hb, Real.log_exp]
  field_simp

omit [Fintype I] in
theorem inverse_forward (a : I → ℝ) (p : I) {b : ℝ} (hb : b≠0) (ha : a p≠0)
    (u : Parameters p) : inverse a p b (forward a p b u) = u := by
  apply Prod.ext
  · exact radial_forward a p hb ha u
  · funext i
    change Real.exp (-(radial a p b (forward a p b u)*a i.val))*
      (Real.exp (u.1*a i.val)*lift p b u.2 i.val) = u.2 i
    rw [radial_forward a p hb ha, lift_other]
    rw [← mul_assoc, ← Real.exp_add]
    simp

omit [Fintype I] in
theorem forward_inverse (a : I → ℝ) (p : I) {b : ℝ} (hb : b≠0) (ha : a p≠0)
    {x : I → ℝ} (hx : x ∈ sector p b) : forward a p b (inverse a p b x) = x := by
  funext i
  by_cases hi : i=p
  · subst i
    change Real.exp (radial a p b x*a p)*lift p b _ p = x p
    rw [lift_same]
    have hs : radial a p b x*a p = Real.log (x p/b) := by
      unfold radial
      field_simp
    rw [hs, Real.exp_log hx]
    field_simp
  · change Real.exp (radial a p b x*a i)*lift p b
      (fun j => Real.exp (-(radial a p b x*a j.val))*x j.val) i = x i
    rw [lift, dite_eq_right hi]
    rw [← mul_assoc, ← Real.exp_add]
    simp

theorem contDiff_lift (p : I) (b : ℝ) {n : WithTop ℕ∞} : ContDiff ℝ n (lift p b) := by
  apply contDiff_pi.mpr
  intro i
  by_cases hi : i=p
  · simp only [lift, dite_eq_left hi]
    exact contDiff_const
  · simp only [lift, dite_eq_right hi]
    exact contDiff_apply ℝ ℝ (⟨i,hi⟩ : {i : I // i ≠ p})

theorem contDiff_forward (a : I → ℝ) (p : I) (b : ℝ) {n : WithTop ℕ∞} :
    ContDiff ℝ n (forward a p b) := by
  apply contDiff_pi.mpr
  intro i
  have hl : ContDiff ℝ n (fun u : Parameters p => lift p b u.2) :=
    (contDiff_lift p b (n := n)).comp contDiff_snd
  have hf : ContDiff ℝ n (fun u : Parameters p => u.1) := contDiff_fst
  exact ((hf.mul contDiff_const).exp).mul ((contDiff_pi.mp hl) i)

omit [DecidableEq I] in
theorem contDiffAt_radial (a : I → ℝ) (p : I) (b : ℝ) {x : I → ℝ}
    (hx : x ∈ sector p b) {n : WithTop ℕ∞} : ContDiffAt ℝ n (radial a p b) x := by
  have hp : ContDiffAt ℝ n (fun y : I → ℝ => y p) x :=
    (contDiff_apply ℝ ℝ p).contDiffAt
  exact (((hp.div_const b).log (ne_of_gt hx)).div_const (a p))

theorem contDiffAt_inverse (a : I → ℝ) (p : I) (b : ℝ) {x : I → ℝ}
    (hx : x ∈ sector p b) {n : WithTop ℕ∞} : ContDiffAt ℝ n (inverse a p b) x := by
  have hs : ContDiffAt ℝ n (radial a p b) x := contDiffAt_radial a p b hx (n := n)
  apply hs.prodMk
  apply contDiffAt_pi.mpr
  intro i
  have hp : ContDiffAt ℝ n (fun y : I → ℝ => y i.val) x :=
    (contDiff_apply ℝ ℝ i.val).contDiffAt
  exact ((hs.mul contDiffAt_const).neg.exp).mul hp

/-- A genuine global chart of the sign-sector, not a postulated coordinate map. -/
def chart (a : I → ℝ) (p : I) {b : ℝ} (hb : b≠0) (ha : a p≠0) :
    OpenPartialHomeomorph (Parameters p) (I → ℝ) where
  toFun := forward a p b
  invFun := inverse a p b
  source := univ
  target := sector p b
  map_source' := by intro u _; change 0 < forward a p b u p/b; rw [forward_ratio a p hb]; positivity
  map_target' := by intro x _; trivial
  left_inv' := by intro u _; exact inverse_forward a p hb ha u
  right_inv' := by intro x hx; exact forward_inverse a p hb ha hx
  continuousOn_toFun := (contDiff_forward a p b (n := 1)).continuous.continuousOn
  continuousOn_invFun := fun x hx => (contDiffAt_inverse a p b hx (n := 1)).continuousAt.continuousWithinAt
  open_source := isOpen_univ
  open_target := isOpen_lt continuous_const
    ((continuous_apply p : Continuous (fun x : I → ℝ => x p)).div_const b)

/-- Coordinates of a supplied punctured point on its actual affine section. -/
def base (p : I) (w : I → ℝ) : Parameters p := (0, fun i => w i.val)

omit [Fintype I] in
theorem forward_base (a : I → ℝ) (p : I) (w : I → ℝ) :
    forward a p (w p) (base p w) = w := by
  funext i
  change Real.exp (0*a i)*lift p (w p) (fun j => w j.val) i = w i
  simp only [zero_mul, Real.exp_zero, one_mul]
  by_cases hi : i=p
  · subst i
    simp [lift]
  · simp only [lift, dite_eq_right hi]

omit [Fintype I] in
/-- The section through a supplied point is an actual coordinate restriction. -/
theorem lift_restrict (p : I) (w : I → ℝ) :
    lift p (w p) (fun i => w i.val) = w := by
  funext i
  by_cases hi : i = p
  · subst i
    simp [lift]
  · simp [lift, hi]

@[simp] theorem chart_apply (a : I → ℝ) (p : I) {b : ℝ}
    (hb : b ≠ 0) (ha : a p ≠ 0) (u : Parameters p) :
    chart a p hb ha u = forward a p b u := rfl

@[simp] theorem chart_symm_apply (a : I → ℝ) (p : I) {b : ℝ}
    (hb : b ≠ 0) (ha : a p ≠ 0) (x : I → ℝ) :
    (chart a p hb ha).symm x = inverse a p b x := rfl

@[simp] theorem chart_source (a : I → ℝ) (p : I) {b : ℝ}
    (hb : b ≠ 0) (ha : a p ≠ 0) : (chart a p hb ha).source = univ := rfl

@[simp] theorem chart_target (a : I → ℝ) (p : I) {b : ℝ}
    (hb : b ≠ 0) (ha : a p ≠ 0) : (chart a p hb ha).target = sector p b := rfl

end MAIS.WeightedCoordinateSlice
end

