-- ==================== begin module O7.Run2GeometricRetainedCoordinates (formalization/O7/Run2GeometricRetainedCoordinates.lean) ====================
section

/-! Literal regrouping of retained regular, reduced-orbit and free spectator
coordinates. All maps are actual continuous linear equivalences. -/
set_option autoImplicit false
noncomputable section
namespace MAIS.Run2GeometricRetainedCoordinates
variable {Q K N H M X : Type*}
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  [NormedAddCommGroup K] [NormedSpace ℝ K]
  [NormedAddCommGroup N] [NormedSpace ℝ N]
  [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup M] [NormedSpace ℝ M]
  [NormedAddCommGroup X] [NormedSpace ℝ X]

def regroup (eK : K ≃L[ℝ] H × X) (eN : N ≃L[ℝ] M) :
    (X × (Q × (H × M))) ≃L[ℝ] ((Q × K) × N) where
  toFun p := ((p.2.1,eK.symm (p.2.2.1,p.1)),eN.symm p.2.2.2)
  invFun p := ((eK p.1.2).2,(p.1.1,((eK p.1.2).1,eN p.2)))
  left_inv p := by simp only [ContinuousLinearEquiv.apply_symm_apply]
  right_inv p := by simp only [Prod.mk.eta,ContinuousLinearEquiv.symm_apply_apply]
  map_add' p q := by
    change ((p.2.1+q.2.1,eK.symm ((p.2.2.1,p.1)+(q.2.2.1,q.1))),
      eN.symm (p.2.2.2+q.2.2.2)) = _
    rw [eK.symm.map_add,eN.symm.map_add]
    rfl
  map_smul' r p := by
    change ((r • p.2.1,eK.symm (r • (p.2.2.1,p.1))),eN.symm (r • p.2.2.2)) = _
    rw [eK.symm.map_smul,eN.symm.map_smul]
    rfl
  continuous_toFun := by fun_prop
  continuous_invFun := by fun_prop

@[simp] theorem regroup_zero (eK : K ≃L[ℝ] H × X) (eN : N ≃L[ℝ] M) :
    regroup (Q:=Q) eK eN 0 = 0 := map_zero _

@[simp] theorem regroup_regular (eK : K ≃L[ℝ] H × X) (eN : N ≃L[ℝ] M)
    (p : X × (Q × (H × M))) : (regroup eK eN p).1.1 = p.2.1 := rfl

@[simp] theorem regroup_normal (eK : K ≃L[ℝ] H × X) (eN : N ≃L[ℝ] M)
    (p : X × (Q × (H × M))) : (regroup eK eN p).2 = eN.symm p.2.2.2 := rfl
end MAIS.Run2GeometricRetainedCoordinates

/-- info: 'MAIS.Run2GeometricRetainedCoordinates.regroup_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricRetainedCoordinates.regroup_zero

/-- info: 'MAIS.Run2GeometricRetainedCoordinates.regroup_regular' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricRetainedCoordinates.regroup_regular

/-- info: 'MAIS.Run2GeometricRetainedCoordinates.regroup_normal' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricRetainedCoordinates.regroup_normal
end
end
-- ==================== end module O7.Run2GeometricRetainedCoordinates ====================

-- ==================== begin module O7.Run2GeometricLocal (formalization/O7/Run2GeometricLocal.lean) ====================
section

/-! Local Hausdorff dimension of finite unions of genuine geometric pieces.
The dimensions of pieces below are established by actual dimensions of
their ball intersections, not assigned as an orbit-index function. -/
set_option autoImplicit false
set_option maxHeartbeats 1200000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal

namespace MAIS.Run2GeometricLocal
open MAIS.Run2GeometricCharts

variable {E : Type*} [NormedAddCommGroup E]

/-- A uniform bound on actual local ball dimensions gives the same global bound.
The argument uses second countability, rather than an uncountable-union rule. -/
theorem dimH_le_of_local [SecondCountableTopology E] {s : Set E} {d : ℝ≥0∞}
    (h : ∀ x ∈ s, ∃ r : ℝ, 0 < r ∧ dimH (s ∩ Metric.ball x r) ≤ d) :
    dimH s ≤ d := by
  by_contra hn
  obtain ⟨x, hxs, hx⟩ := exists_mem_nhdsWithin_lt_dimH_of_lt_dimH
    (lt_of_not_ge hn)
  obtain ⟨r, hr, hd⟩ := h x hxs
  exact (hx _ (inter_mem_nhdsWithin s (Metric.ball_mem_nhds x hr))).not_ge hd

/-- Actual pure local dimension passes to every point of the ordinary closure.
In particular, approaching a stratum does not replace its dimension by that
of the boundary stratum. -/
theorem dimH_inter_ball_of_mem_closure [SecondCountableTopology E]
    {s : Set E} {d : ℝ≥0∞}
    (h : ∀ x ∈ s, ∀ r : ℝ, 0 < r → dimH (s ∩ Metric.ball x r) = d)
    {a : E} (ha : a ∈ closure s) {r : ℝ} (hr : 0 < r) :
    dimH (s ∩ Metric.ball a r) = d := by
  apply le_antisymm
  · exact (dimH_mono inter_subset_left).trans
      (dimH_le_of_local fun x hx => ⟨1, by norm_num, (h x hx 1 (by norm_num)).le⟩)
  · obtain ⟨x, hxs, hax⟩ := Metric.mem_closure_iff.mp ha (r / 2) (by positivity)
    have hsub : s ∩ Metric.ball x (r / 2) ⊆ s ∩ Metric.ball a r := by
      intro y hy
      refine ⟨hy.1, ?_⟩
      rw [Metric.mem_ball]
      calc
        dist y a ≤ dist y x + dist x a := dist_triangle _ _ _
        _ < r := by rw [dist_comm x a]; linarith [Metric.mem_ball.mp hy.2]
    rw [← h x hxs (r / 2) (by positivity)]
    exact dimH_mono hsub

/-- A finite family has one genuine neighborhood avoiding all pieces whose
ordinary closures miss the chosen center. -/
theorem exists_ball_avoiding_nonclosures {I : Type*} [Finite I]
    (s : I → Set E) (a : E) :
    ∃ r : ℝ, 0 < r ∧ ∀ i : I, a ∉ closure (s i) →
      s i ∩ Metric.ball a r = ∅ := by
  classical
  let U := ⋂ i : I, if a ∈ closure (s i) then Set.univ else (closure (s i))ᶜ
  have hU : IsOpen U := isOpen_iInter_of_finite fun i => by
    split_ifs
    · exact isOpen_univ
    · exact isClosed_closure.isOpen_compl
  have haU : a ∈ U := by
    simp only [U, mem_iInter]
    intro i
    split_ifs with hi
    · trivial
    · exact hi
  obtain ⟨r, hr, hrU⟩ := Metric.mem_nhds_iff.mp (hU.mem_nhds haU)
  refine ⟨r, hr, fun i hi => ?_⟩
  apply Set.eq_empty_iff_forall_notMem.mpr
  intro x hx
  have hxU : x ∈ U := hrU hx.2
  have hxi := Set.mem_iInter.mp hxU i
  rw [ite_eq_right hi] at hxi
  exact hxi (subset_closure hx.1)

/-- The true local Hausdorff dimension of a finite union is the supremum
of the dimensions of exactly those pieces whose ordinary closures contain
the center. All component hypotheses refer to literal measured dimensions. -/
theorem localDimH_finite_union [SecondCountableTopology E]
    {I : Type*} [Finite I] (s : I → Set E) (d : I → ℝ≥0∞)
    (h : ∀ i : I, ∀ x ∈ s i, ∀ r : ℝ, 0 < r →
      dimH (s i ∩ Metric.ball x r) = d i) (a : E) :
    localDimH (⋃ i : I, s i) a =
      ⨆ (i : I) (_ : a ∈ closure (s i)), d i := by
  classical
  apply le_antisymm
  · obtain ⟨r, hr, hav⟩ := exists_ball_avoiding_nonclosures s a
    apply (localDimH_le _ _ hr).trans
    have he : (⋃ i : I, s i) ∩ Metric.ball a r =
        ⋃ i : I, s i ∩ Metric.ball a r := by
      ext x
      simp
    rw [he, dimH_iUnion]
    apply iSup_le
    intro i
    by_cases hi : a ∈ closure (s i)
    · rw [dimH_inter_ball_of_mem_closure (h i) hi hr]
      exact le_iSup_of_le i (le_iSup_of_le hi le_rfl)
    · rw [hav i hi, dimH_empty]
      exact bot_le
  · apply iSup_le
    intro i
    apply iSup_le
    intro hi
    apply le_localDimH
    intro r hr
    rw [← dimH_inter_ball_of_mem_closure (h i) hi hr]
    exact dimH_mono (inter_subset_inter_left _ (subset_iUnion s i))

end MAIS.Run2GeometricLocal

/-- info: 'MAIS.Run2GeometricLocal.dimH_le_of_local' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricLocal.dimH_le_of_local

/-- info: 'MAIS.Run2GeometricLocal.dimH_inter_ball_of_mem_closure' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricLocal.dimH_inter_ball_of_mem_closure

/-- info: 'MAIS.Run2GeometricLocal.exists_ball_avoiding_nonclosures' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricLocal.exists_ball_avoiding_nonclosures

/-- info: 'MAIS.Run2GeometricLocal.localDimH_finite_union' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricLocal.localDimH_finite_union
end
end
-- ==================== end module O7.Run2GeometricLocal ====================

-- ==================== begin module O7.Run2GeometricPatch (formalization/O7/Run2GeometricPatch.lean) ====================
section

/-! Literal dimensions of a geometric set cut out by zero normal coordinates
inside a genuine differentiable ambient chart. -/
set_option autoImplicit false
set_option maxHeartbeats 1500000
noncomputable section
open Set MeasureTheory Filter
open scoped Topology ENNReal NNReal

namespace MAIS.Run2GeometricPatch
open MAIS.Run2GeometricCharts MAIS.Run2GeometricLocal

variable {P N E : Type*}
  [NormedAddCommGroup P] [NormedSpace ℝ P] [FiniteDimensional ℝ P]
  [NormedAddCommGroup N] [NormedSpace ℝ N]
  [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Every regular parameter remains free. The inverse is required to be
differentiable on the actual open target neighborhood used in the proof. -/
theorem dimH_inter_eq_finrank_of_chart
    (e : OpenPartialHomeomorph (P × N) E)
    (he : DifferentiableOn ℝ e e.source)
    (s U : Set E) (hU : IsOpen U) (hUt : U ⊆ e.target)
    (hi : DifferentiableOn ℝ e.symm U)
    (p₀ : P) (hp : (p₀, (0 : N)) ∈ e.source)
    (hpU : e (p₀, (0 : N)) ∈ U)
    (hcut : ∀ p ∈ e.source, e p ∈ s ↔ p.2 = 0) :
    dimH (s ∩ U) = Module.finrank ℝ P := by
  let j : P → P × N := fun p => (p, 0)
  let v : Set (P × N) := e.source ∩ e ⁻¹' U
  let u : Set P := j ⁻¹' v
  have hj : Continuous j := continuous_id.prodMk continuous_const
  have heAt : ContinuousAt e (p₀, (0 : N)) :=
    e.continuousOn.continuousAt (e.open_source.mem_nhds hp)
  have hv : v ∈ 𝓝 (p₀, (0 : N)) :=
    inter_mem (e.open_source.mem_nhds hp)
      (heAt.preimage_mem_nhds (hU.mem_nhds hpU))
  have hu : u ∈ 𝓝 p₀ := hj.continuousAt.preimage_mem_nhds hv
  have hjs : j '' u ⊆ e.source := by
    rintro _ ⟨p, hp, rfl⟩
    exact hp.1
  have heU : e '' (j '' u) ⊆ U := by
    rintro _ ⟨_, ⟨p, hp, rfl⟩, rfl⟩
    exact hp.2
  have hd : dimH (e '' (j '' u)) = Module.finrank ℝ P := by
    calc
      dimH (e '' (j '' u)) = dimH (j '' u) := by
        exact dimH_image_eq_of_left_inverse (he.mono hjs)
          (hi.mono heU) (fun p hp => e.left_inv (hjs hp))
      _ = Module.finrank ℝ P := dimH_coordinate_patch hu
  have hset : e '' (j '' u) = s ∩ U := by
    ext x
    constructor
    · rintro ⟨_, ⟨p, hp, rfl⟩, rfl⟩
      exact ⟨(hcut _ hp.1).mpr rfl, hp.2⟩
    · intro hx
      let p := e.symm x
      have hps : p ∈ e.source := e.map_target (hUt hx.2)
      have hep : e p = x := e.right_inv (hUt hx.2)
      have hp0 : p.2 = 0 := (hcut p hps).mp (hep.symm ▸ hx.1)
      have hpj : j p.1 = p := by
        ext
        · rfl
        · exact hp0.symm
      refine ⟨p, ⟨p.1, ?_, hpj⟩, hep⟩
      change j p.1 ∈ e.source ∩ e ⁻¹' U
      rw [hpj]
      refine ⟨hps, ?_⟩
      change e p ∈ U
      rw [hep]
      exact hx.2
  simpa only [hset] using hd

/-- Restricting an actual target neighborhood to an arbitrarily small ball
retains all regular coordinates and therefore retains their full dimension. -/
theorem dimH_ball_lower_of_chart
    (e : OpenPartialHomeomorph (P × N) E)
    (he : DifferentiableOn ℝ e e.source)
    (s U : Set E) (hU : IsOpen U) (hUt : U ⊆ e.target)
    (hi : DifferentiableOn ℝ e.symm U)
    (p₀ : P) (hp : (p₀, (0 : N)) ∈ e.source)
    (hpU : e (p₀, (0 : N)) ∈ U)
    (hcut : ∀ p ∈ e.source, e p ∈ s ↔ p.2 = 0)
    {r : ℝ} (hr : 0 < r) :
    (Module.finrank ℝ P : ℝ≥0∞) ≤
      dimH (s ∩ Metric.ball (e (p₀, (0 : N))) r) := by
  have ha : e (p₀, (0 : N)) ∈ Metric.ball (e (p₀, (0 : N))) r :=
    Metric.mem_ball_self hr
  have hd := dimH_inter_eq_finrank_of_chart e he s
    (U ∩ Metric.ball (e (p₀, (0 : N))) r)
    (hU.inter Metric.isOpen_ball) (fun _ hx => hUt hx.1)
    (hi.mono inter_subset_left) p₀ hp ⟨hpU, ha⟩ hcut
  rw [← hd]
  exact dimH_mono (fun _ hx => ⟨hx.1, hx.2.2⟩)

end MAIS.Run2GeometricPatch

/-- info: 'MAIS.Run2GeometricPatch.dimH_inter_eq_finrank_of_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricPatch.dimH_inter_eq_finrank_of_chart

/-- info: 'MAIS.Run2GeometricPatch.dimH_ball_lower_of_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricPatch.dimH_ball_lower_of_chart
end
end
-- ==================== end module O7.Run2GeometricPatch ====================

-- ==================== begin module O7.Run2GeometricIntervalOrbit (formalization/O7/Run2GeometricIntervalOrbit.lean) ====================
section

/-! Actual smooth gauge-orbit germs of interval chains.  The zero-normal
condition is proved from physical rank minors, not assumed as a dimension
formula. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricIntervalOrbit
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalSliceChart MAIS.ActiveIntervalEndpointRows
open MAIS.ActiveIntervalStrictGenerization MAIS.Run2AllHigherAttainment
open MAIS.QuiverRealOrbit MAIS.Run2GeometricPatch

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

theorem parameterChart_mem_base_orbit_iff
    (hvalid : ∀ s, birth s < death s)
    (p : TangentParameters D birth death × NormalParams birth death) :
    parameterChart D birth death hD hvalid p ∈
      MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death) ↔
      p.2 = 0 := by
  let g := MAIS.OrbitSliceChart.expGauge (Index D birth death)
    (p.1 : MAIS.OrbitSliceLinear.Lie (Index D birth death))
  have he : parameterChart D birth death hD hvalid p =
      g • normalFamily D birth death hD p.2 :=
    parameterChart_eq_gauge D birth death hD hvalid p
  constructor
  · intro hp
    have hn : normalFamily D birth death hD p.2 ∈
        MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death) := by
      apply MulAction.mem_orbit_trans _ hp
      apply MulAction.mem_orbit_iff.mpr
      refine ⟨g⁻¹, ?_⟩
      rw [he, inv_smul_smul]
    exact (mem_base_orbit_iff D birth death hD p.2).mp hn
  · intro hp
    rw [he, hp, MAIS.ActiveIntervalPathDerivative.normalFamily_zero]
    exact MulAction.mem_orbit_iff.mpr ⟨g, rfl⟩

include hD in
/-- A full actual open orbit patch has the real retained-parameter dimension.
Every small ambient ball also contains a patch of at least that dimension. -/
theorem exists_open_orbit_patch
    (hvalid : ∀ s, birth s < death s) :
    ∃ U : Set (Rep (Index D birth death)),
      IsOpen U ∧ intervalRep D birth death ∈ U ∧
      dimH (MulAction.orbit (Gauge (Index D birth death))
        (intervalRep D birth death) ∩ U) =
        Module.finrank ℝ (TangentParameters D birth death) ∧
      ∀ r : ℝ, 0 < r →
        (Module.finrank ℝ (TangentParameters D birth death) : ℝ≥0∞) ≤
          dimH (MulAction.orbit (Gauge (Index D birth death))
            (intervalRep D birth death) ∩ Metric.ball (intervalRep D birth death) r) := by
  let e := parameterChart D birth death hD hvalid
  let O := MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)
  obtain ⟨U, hU, hbU, hUt, hi⟩ :=
    exists_open_inverse_neighborhood D birth death hD hvalid
  have hf : DifferentiableOn ℝ e e.source := by
    intro p _
    exact (analyticAt_parameterChart D birth death hD hvalid p).differentiableAt.differentiableWithinAt
  have hInv : DifferentiableOn ℝ e.symm U := by
    intro A hA
    exact (hi A hA).differentiableAt.differentiableWithinAt
  have hp : ((0 : TangentParameters D birth death),
      (0 : NormalParams birth death)) ∈ e.source :=
    zero_mem_parameterChart_source D birth death hD hvalid
  have he0 : e ((0 : TangentParameters D birth death), (0 : NormalParams birth death)) =
      intervalRep D birth death := by
    change parameterChart D birth death hD hvalid (0, 0) = _
    rw [parameterChart_normal, map_zero, add_zero]
  have hcut : ∀ p ∈ e.source, e p ∈ O ↔ p.2 = 0 :=
    fun p _ => parameterChart_mem_base_orbit_iff D birth death hD hvalid p
  refine ⟨U, hU, hbU, ?_, ?_⟩
  · exact dimH_inter_eq_finrank_of_chart e hf O U hU hUt hInv 0 hp
      (he0.symm ▸ hbU) hcut
  · intro r hr
    have hd := dimH_ball_lower_of_chart e hf O U hU hUt hInv 0 hp
      (he0.symm ▸ hbU) hcut hr
    simpa only [he0] using hd

end MAIS.Run2GeometricIntervalOrbit

/-- info: 'MAIS.Run2GeometricIntervalOrbit.parameterChart_mem_base_orbit_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricIntervalOrbit.parameterChart_mem_base_orbit_iff

/-- info: 'MAIS.Run2GeometricIntervalOrbit.exists_open_orbit_patch' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricIntervalOrbit.exists_open_orbit_patch
end
end
-- ==================== end module O7.Run2GeometricIntervalOrbit ====================

-- ==================== begin module O7.Run2GeometricHomogeneous (formalization/O7/Run2GeometricHomogeneous.lean) ====================
section

/-! A genuine homogeneous set with one actual coordinate patch has constant
Hausdorff dimension in every nonempty relative ball. -/
set_option autoImplicit false
set_option maxHeartbeats 1500000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal

namespace MAIS.Run2GeometricHomogeneous
open MAIS.Run2GeometricLocal

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [SecondCountableTopology E]

theorem dimH_inter_ball_of_transitive_linear
    (s : Set E) (a : E) (d : ℝ≥0∞)
    (htrans : ∀ x ∈ s, ∃ e : E ≃L[ℝ] E, e a = x ∧ e '' s = s)
    (U : Set E) (hU : IsOpen U) (haU : a ∈ U)
    (hpatch : dimH (s ∩ U) = d)
    (hlower : ∀ r : ℝ, 0 < r → d ≤ dimH (s ∩ Metric.ball a r)) :
    ∀ x ∈ s, ∀ r : ℝ, 0 < r → dimH (s ∩ Metric.ball x r) = d := by
  have hglobal : dimH s ≤ d := by
    apply dimH_le_of_local
    intro x hx
    obtain ⟨e, hea, hes⟩ := htrans x hx
    have hV : IsOpen (e '' U) := e.toHomeomorph.isOpenMap U hU
    have hxV : x ∈ e '' U := ⟨a, haU, hea⟩
    obtain ⟨r, hr, hrV⟩ := Metric.mem_nhds_iff.mp (hV.mem_nhds hxV)
    have himage : e '' (s ∩ U) = s ∩ (e '' U) := by
      rw [Set.image_inter e.injective, hes]
    refine ⟨r, hr, ?_⟩
    calc
      dimH (s ∩ Metric.ball x r) ≤ dimH (s ∩ (e '' U)) :=
        dimH_mono (inter_subset_inter_right _ hrV)
      _ = dimH (e '' (s ∩ U)) := by rw [himage]
      _ = dimH (s ∩ U) := e.dimH_image _
      _ = d := hpatch
  intro x hx r hr
  apply le_antisymm ((dimH_mono inter_subset_left).trans hglobal)
  obtain ⟨e, hea, hes⟩ := htrans x hx
  have hpre : e ⁻¹' Metric.ball x r ∈ 𝓝 a :=
    e.continuous.continuousAt.preimage_mem_nhds
      (hea.symm ▸ Metric.ball_mem_nhds x hr)
  obtain ⟨ρ, hρ, hρpre⟩ := Metric.mem_nhds_iff.mp hpre
  calc
    d ≤ dimH (s ∩ Metric.ball a ρ) := hlower ρ hρ
    _ = dimH (e '' (s ∩ Metric.ball a ρ)) := (e.dimH_image _).symm
    _ ≤ dimH (s ∩ Metric.ball x r) := by
      apply dimH_mono
      rintro _ ⟨y, hy, rfl⟩
      refine ⟨?_, hρpre hy.2⟩
      rw [← hes]
      exact ⟨y, hy.1, rfl⟩

end MAIS.Run2GeometricHomogeneous

/-- info: 'MAIS.Run2GeometricHomogeneous.dimH_inter_ball_of_transitive_linear' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricHomogeneous.dimH_inter_ball_of_transitive_linear
end
end
-- ==================== end module O7.Run2GeometricHomogeneous ====================

-- ==================== begin module O7.Run2GeometricTransport (formalization/O7/Run2GeometricTransport.lean) ====================
section

/-! Actual pure local Hausdorff dimension is invariant under a genuine
continuous linear equivalence, with arbitrary norms and all small balls. -/
set_option autoImplicit false
set_option maxHeartbeats 1200000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal

namespace MAIS.Run2GeometricTransport
open MAIS.Run2GeometricLocal

variable {E F : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [SecondCountableTopology E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

theorem dimH_image_inter_ball
    (e : E ≃L[ℝ] F) (s : Set E) (d : ℝ≥0∞)
    (h : ∀ x ∈ s, ∀ r : ℝ, 0 < r → dimH (s ∩ Metric.ball x r) = d) :
    ∀ y ∈ e '' s, ∀ r : ℝ, 0 < r →
      dimH ((e '' s) ∩ Metric.ball y r) = d := by
  have hglobal : dimH s ≤ d :=
    dimH_le_of_local (fun x hx => ⟨1, by norm_num, (h x hx 1 (by norm_num)).le⟩)
  rintro y ⟨x, hx, rfl⟩ r hr
  apply le_antisymm
  · exact (dimH_mono inter_subset_left).trans ((e.dimH_image s).le.trans hglobal)
  · have hpre : e ⁻¹' Metric.ball (e x) r ∈ 𝓝 x :=
      e.continuous.continuousAt.preimage_mem_nhds (Metric.ball_mem_nhds (e x) hr)
    obtain ⟨ρ, hρ, hρpre⟩ := Metric.mem_nhds_iff.mp hpre
    calc
      d = dimH (s ∩ Metric.ball x ρ) := (h x hx ρ hρ).symm
      _ = dimH (e '' (s ∩ Metric.ball x ρ)) := (e.dimH_image _).symm
      _ ≤ dimH ((e '' s) ∩ Metric.ball (e x) r) := by
        apply dimH_mono
        rintro _ ⟨z, hz, rfl⟩
        exact ⟨⟨z, hz.1, rfl⟩, hρpre hz.2⟩

end MAIS.Run2GeometricTransport

/-- info: 'MAIS.Run2GeometricTransport.dimH_image_inter_ball' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricTransport.dimH_image_inter_ball
end
end
