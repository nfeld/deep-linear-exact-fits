  congr 1
  unfold Model.integral
  apply setIntegral_congr_fun measurableSet_Ioi
  intro s hs
  unfold Model.integrand gramTest
  ring

lemma leftGram_one_eq_vector (d : ℕ) (rho T : ℝ) :
    leftGramLaplaceLIntegral 1 d rho T =
