#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalRankMinors.rankMinor_eq_zero_of_path_rank_le

/-- info: 'MAIS.ActiveIntervalRankMinors.hasFDerivAt_rankMinor' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalRankMinors.hasFDerivAt_rankMinor

