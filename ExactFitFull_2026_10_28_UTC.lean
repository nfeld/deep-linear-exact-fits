-- ==================== begin module O7.Run2GeometricIntegralCodim (formalization/O7/Run2GeometricIntegralCodim.lean) ====================
section

/-! True ambient-minus-Hausdorff codimension and its natural presentation agree
once actual integral local dimension has been proved independently. -/
set_option autoImplicit false
noncomputable section
open Set MeasureTheory
open scoped ENNReal NNReal
namespace MAIS.Run2GeometricIntegralCodim
open MAIS.Run2GeometricCharts MAIS.Run2GeometricCodimCharts
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

def geometricCodimH (s : Set E) (a : E) : ℝ≥0∞ :=
  (Module.finrank ℝ E : ℝ≥0∞)-localDimH s a

theorem localDimH_le_ambient (s : Set E) (a : E) :
    localDimH s a≤(Module.finrank ℝ E:ℝ≥0∞) :=
  (localDimH_le_dimH _ _).trans
    ((dimH_mono (subset_univ _)).trans_eq (Real.dimH_univ_eq_finrank _))

theorem localDimH_lt_top (s : Set E) (a : E) : localDimH s a<⊤ :=
  (localDimH_le_ambient s a).trans_lt (by simp)

theorem geometricCodimH_eq_nat (s : Set E) (a : E)
    (hint : ∃ n : ℕ,localDimH s a=(n:ℝ≥0∞)) :
    geometricCodimH s a=(geometricCodimNat s a:ℝ≥0∞) := by
  obtain ⟨d,hdim⟩ := hint
  let N := Module.finrank ℝ E
  have hd : d≤N := by
    have h:=localDimH_le_ambient s a
    rw [hdim] at h
    exact_mod_cast h
  have hcast : ((N-d:ℕ):ℝ≥0∞)=(N:ℝ≥0∞)-(d:ℝ≥0∞) := by
    calc
      ((N-d:ℕ):ℝ≥0∞)=ENNReal.ofReal ((N-d:ℕ):ℝ) := by simp
      _=ENNReal.ofReal ((N:ℝ)-(d:ℝ)) := by rw [Nat.cast_sub hd]
      _=(N:ℝ≥0∞)-(d:ℝ≥0∞) := by
        rw [ENNReal.ofReal_sub _ (Nat.cast_nonneg d)]
        simp
  simp only [geometricCodimH,geometricCodimNat,hdim,ENNReal.toReal_natCast,Nat.floor_natCast]
  exact hcast.symm
end MAIS.Run2GeometricIntegralCodim

/-- info: 'MAIS.Run2GeometricIntegralCodim.localDimH_le_ambient' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricIntegralCodim.localDimH_le_ambient

/-- info: 'MAIS.Run2GeometricIntegralCodim.localDimH_lt_top' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricIntegralCodim.localDimH_lt_top

/-- info: 'MAIS.Run2GeometricIntegralCodim.geometricCodimH_eq_nat' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricIntegralCodim.geometricCodimH_eq_nat
end
end
