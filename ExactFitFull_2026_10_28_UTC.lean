-- ==================== begin module O7.GammaTail (formalization/O7/GammaTail.lean) ====================
section

/-!
# Integer gamma tails

An exact, recursively specified antiderivative and half-line integral for the
integer-shape gamma density. This file uses literal Lebesgue integrals, with no
assumed asymptotic or integration formula.
-/

set_option autoImplicit false
noncomputable section

open Set Filter MeasureTheory
open scoped Topology

namespace MAIS.GammaTail

/-- The unnormalized upper incomplete gamma function at integer shape `n+1`. -/
def tail : ℕ → ℝ → ℝ
  | 0, x => Real.exp (-x)
  | n + 1, x => x ^ (n + 1) * Real.exp (-x) + (n + 1 : ℝ) * tail n x

theorem hasDerivAt_tail (n : ℕ) (x : ℝ) :
    HasDerivAt (tail n) (-(x ^ n * Real.exp (-x))) x := by
  induction n with
  | zero =>
      simpa [tail] using ((hasDerivAt_id x).neg.exp)
  | succ n ih =>
      have hp := (hasDerivAt_id x).pow (n + 1)
      have he := (hasDerivAt_id x).neg.exp
      have h := (hp.mul he).add (ih.const_mul (n + 1 : ℝ))
      convert! h using 1
      simp only [Nat.cast_add, Nat.cast_one, Nat.add_sub_cancel, mul_one,
        Pi.pow_apply, Pi.neg_apply, id_eq]
      ring

theorem tendsto_tail (n : ℕ) : Tendsto (tail n) atTop (nhds 0) := by
  induction n with
  | zero =>
      simpa [tail] using Real.tendsto_pow_mul_exp_neg_atTop_nhds_zero 0
  | succ n ih =>
      simpa [tail] using
        (Real.tendsto_pow_mul_exp_neg_atTop_nhds_zero (n + 1)).add
          (ih.const_mul (n + 1 : ℝ))

/-- The integer gamma tail is a finite polynomial times the exponential. -/
theorem tail_eq_sum (n : ℕ) (x : ℝ) :
    tail n x = (n.factorial : ℝ) * Real.exp (-x) *
      ∑ j ∈ Finset.range (n + 1), x ^ j / (j.factorial : ℝ) := by
  induction n with
  | zero => simp [tail]
  | succ n ih =>
      rw [tail, ih, Finset.sum_range_succ (n := n + 1)]
      simp only [Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
      have hn : (n.factorial : ℝ) ≠ 0 := by exact_mod_cast n.factorial_ne_zero
      have hn1 : (n + 1 : ℝ) ≠ 0 := by positivity
      field_simp
      ring

theorem tail_zero (n : ℕ) : tail n 0 = (n.factorial : ℝ) := by
  induction n with
  | zero => simp [tail]
  | succ n ih => simp [tail, ih, Nat.factorial_succ]

theorem tail_nonneg (n : ℕ) {T : ℝ} (hT : 0 ≤ T) : 0 ≤ tail n T := by
  induction n with
  | zero => exact Real.exp_nonneg _
  | succ n ih =>
      exact add_nonneg (mul_nonneg (pow_nonneg hT _) (Real.exp_nonneg _))
        (mul_nonneg (by positivity) ih)

/-- A lower bound with the exact leading monomial, valid already at `T = 0`. -/
theorem leading_le_tail (n : ℕ) {T : ℝ} (hT : 0 ≤ T) :
    T ^ n * Real.exp (-T) ≤ tail n T := by
  cases n with
  | zero => simp [tail]
  | succ n =>
      rw [tail]
      exact le_add_of_nonneg_right (mul_nonneg (by positivity) (tail_nonneg n hT))

/-- A uniform upper bound sufficient for the power/log order of scalar products. -/
theorem tail_le_factorial_mul_leading (n : ℕ) {T : ℝ} (hT : 1 ≤ T) :
    tail n T ≤ ((n + 1).factorial : ℝ) * T ^ n * Real.exp (-T) := by
  have hT0 : 0 ≤ T := le_trans zero_le_one hT
  have hsum : (∑ j ∈ Finset.range (n + 1), T ^ j / (j.factorial : ℝ)) ≤
      (n + 1 : ℝ) * T ^ n := by
    calc
      _ ≤ ∑ _j ∈ Finset.range (n + 1), T ^ n := by
        apply Finset.sum_le_sum
        intro j hj
        have hjn : j ≤ n := Nat.le_of_lt_succ (Finset.mem_range.mp hj)
        have hfac : (1 : ℝ) ≤ (j.factorial : ℝ) := by
          exact_mod_cast Nat.succ_le_of_lt (Nat.factorial_pos j)
        exact (div_le_self (pow_nonneg hT0 _) hfac).trans (pow_le_pow_right₀ hT hjn)
      _ = _ := by simp
  rw [tail_eq_sum]
  calc
    _ ≤ (n.factorial : ℝ) * Real.exp (-T) * ((n + 1 : ℝ) * T ^ n) :=
      mul_le_mul_of_nonneg_left hsum (mul_nonneg (by positivity) (Real.exp_nonneg _))
    _ = _ := by simp only [Nat.factorial_succ, Nat.cast_mul, Nat.cast_add,
      Nat.cast_one]; ring

theorem integrableOn_gammaTail (n : ℕ) {T : ℝ} (hT : 0 ≤ T) :
    IntegrableOn (fun x : ℝ => x ^ n * Real.exp (-x)) (Ioi T) := by
  apply integrableOn_Ioi_deriv_of_nonneg'
    (g := fun x => -tail n x) (l := 0)
  · intro x _hx
    convert! (hasDerivAt_tail n x).neg using 1
    simp
  · intro x hx
    exact mul_nonneg (pow_nonneg (hT.trans hx.le) n) (Real.exp_nonneg _)
  · simpa using (tendsto_tail n).neg

/-- Exact upper-tail formula, with a recursion that terminates at `exp (-T)`. -/
theorem integral_Ioi_gammaTail (n : ℕ) {T : ℝ} (hT : 0 ≤ T) :
    ∫ x in Ioi T, x ^ n * Real.exp (-x) = tail n T := by
  have h := integral_Ioi_of_hasDerivAt_of_nonneg'
    (g := fun x => -tail n x) (g' := fun x => x ^ n * Real.exp (-x))
    (a := T) (l := 0)
    (fun x _hx => by convert! (hasDerivAt_tail n x).neg using 1; simp)
    (fun x hx => mul_nonneg (pow_nonneg (hT.trans hx.le) n) (Real.exp_nonneg _))
    (by simpa using (tendsto_tail n).neg)
  simpa using h

/-- Explicit finite-sum evaluation of the literal Lebesgue upper-tail integral. -/
theorem integral_Ioi_gammaTail_sum (n : ℕ) {T : ℝ} (hT : 0 ≤ T) :
    ∫ x in Ioi T, x ^ n * Real.exp (-x) =
      (n.factorial : ℝ) * Real.exp (-T) *
        ∑ j ∈ Finset.range (n + 1), T ^ j / (j.factorial : ℝ) := by
  rw [integral_Ioi_gammaTail n hT, tail_eq_sum]

theorem integral_Ioi_gammaTail_bounds (n : ℕ) {T : ℝ} (hT : 1 ≤ T) :
    T ^ n * Real.exp (-T) ≤ (∫ x in Ioi T, x ^ n * Real.exp (-x)) ∧
      (∫ x in Ioi T, x ^ n * Real.exp (-x)) ≤
        ((n + 1).factorial : ℝ) * T ^ n * Real.exp (-T) := by
  rw [integral_Ioi_gammaTail n (le_trans zero_le_one hT)]
  exact ⟨leading_le_tail n (le_trans zero_le_one hT), tail_le_factorial_mul_leading n hT⟩

/-- info: 'MAIS.GammaTail.integral_Ioi_gammaTail' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms integral_Ioi_gammaTail
/-- info: 'MAIS.GammaTail.integral_Ioi_gammaTail_sum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms integral_Ioi_gammaTail_sum
/-- info: 'MAIS.GammaTail.integral_Ioi_gammaTail_bounds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms integral_Ioi_gammaTail_bounds

end MAIS.GammaTail
end
end
