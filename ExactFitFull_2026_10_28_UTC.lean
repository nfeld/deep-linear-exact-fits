-- ==================== begin module O7.CompactBandFiniteTypes (formalization/O7/CompactBandFiniteTypes.lean) ====================
section

/-! Finite attained pair tables give an actual global compact band order. -/
set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.CompactBandFiniteTypes
open MAIS.AnalyticTransfer O77.Residual O77.PowerLogUniqueness

private theorem gauge_dominates_of_ratio {a b : ℝ} {k l : ℕ}
    (htend : Tendsto (fun t : ℝ =>
      powerLogZeroReal b l (Real.exp (-t)) / powerLogZeroReal a k (Real.exp (-t)))
        atTop (nhds 0)) :
    ∃ eta : ℝ, 0 < eta ∧ ∀ eps, 0 < eps → eps < eta →
      powerLogZero b l eps ≤ powerLogZero a k eps := by
  obtain ⟨T,hT⟩ := eventually_atTop.mp (htend.eventually (gt_mem_nhds zero_lt_one))
  let S := max 1 T
  refine ⟨Real.exp (-S), Real.exp_pos _, ?_⟩
  intro eps heps hsmall
  let t := -Real.log eps
  have hlog := Real.log_lt_log heps hsmall
  rw [Real.log_exp] at hlog
  have htS : S < t := by dsimp [t]; linarith
  have ht : 0 < t := (lt_of_lt_of_le zero_lt_one (le_max_left 1 T)).trans htS
  have htexp : Real.exp (-t) = eps := by simp [t, Real.exp_log heps]
  have hratio := hT t ((le_max_right 1 T).trans htS.le)
  have hd := gauge_exp_pos a k ht
  have hg : powerLogZeroReal b l (Real.exp (-t)) ≤
      powerLogZeroReal a k (Real.exp (-t)) := (div_lt_one hd).mp hratio |>.le
  rw [htexp] at hg
  exact ENNReal.ofReal_le_ofReal hg

/-- The actual gauges have their expected ordered dominance, with a derived
small-parameter cutoff. Smaller lambda wins; at equality larger log degree wins. -/
theorem gauge_dominates {a b : ℝ} {k l : ℕ}
    (h : a < b ∨ a = b ∧ l ≤ k) :
    ∃ eta : ℝ, 0 < eta ∧ ∀ eps, 0 < eps → eps < eta →
      powerLogZero b l eps ≤ powerLogZero a k eps := by
  rcases h with hab | ⟨rfl,hlk⟩
  · exact gauge_dominates_of_ratio (ratio_tendsto_zero_threshold hab l k)
  · rcases lt_or_eq_of_le hlk with hlt | heq
    · exact gauge_dominates_of_ratio (ratio_tendsto_zero_degree a hlt)
    · subst l
      exact ⟨1,zero_lt_one,fun _ _ _ => le_rfl⟩

/-- The extremal pair index is selected from an actual finite nonempty table. -/
theorem exists_dominant_index {J : Type*} [Fintype J] [Nonempty J]
    (a : J → ℝ) (k : J → ℕ) :
    ∃ j : J, ∀ i, a j < a i ∨ a j = a i ∧ k i ≤ k j := by
  classical
  obtain ⟨j,hj,hmin⟩ := Finset.exists_min_image Finset.univ a Finset.univ_nonempty
  let S := Finset.univ.filter (fun i => a i = a j)
  have hS : S.Nonempty := ⟨j, by simp [S]⟩
  obtain ⟨q,hq,hmax⟩ := Finset.exists_max_image S k hS
  have hqj : a q = a j := (Finset.mem_filter.mp hq).2
  refine ⟨q,fun i => ?_⟩
  have hji := hmin i (Finset.mem_univ i)
  rcases lt_or_eq_of_le hji with hlt | heq
  · exact Or.inl (hqj.trans_lt hlt)
  · exact Or.inr ⟨hqj.trans heq, hmax i (by simp [S,heq])⟩

variable {E : Type*} [MetricSpace E] [MeasurableSpace E]

/-- A finite table of genuinely attained local orders gives the compact global
order at its actual minimum exponent and maximum tied log degree. Every local
hypothesis concerns the literal measure in K intersected with metric balls. -/
theorem compact_order_of_finite_attained_types
    {J : Type*} [Fintype J] [Nonempty J] (a : J → ℝ) (m : J → ℕ)
    (mu : Measure E) {K : Set E} (hK : IsCompact K) {f : E → ℝ} (hf : Continuous f)
    (hlocal : ∀ x, x ∈ K → f x = 0 → ∃ j,
      HasMeasuredBandPair mu (fun R => K ∩ Metric.ball x R) f x (a j) (m j))
    (hattained : ∀ j, ∃ x, x ∈ K ∧ f x = 0 ∧
      HasMeasuredBandPair mu (fun R => K ∩ Metric.ball x R) f x (a j) (m j)) :
    ∃ j, (∀ i, a j < a i ∨ a j = a i ∧ m i ≤ m j) ∧
      EThetaZeroPowerLog (fun eps => mu {x | x ∈ K ∧ |f x| < eps}) (a j) (m j - 1) := by
  obtain ⟨j,hbest⟩ := exists_dominant_index a (fun i => m i - 1)
  obtain ⟨x0,hx0,hfx0,hp0⟩ := hattained j
  have hmj : 1 ≤ m j := hp0.2.1
  have hbest' : ∀ i, a j < a i ∨ a j = a i ∧ m i ≤ m j := by
    intro i
    rcases hbest i with hlt | ⟨heq,hdeg⟩
    · exact Or.inl hlt
    · have hmi := (hattained i).choose_spec.2.2.2.1
      exact Or.inr ⟨heq, by omega⟩
  refine ⟨j,hbest',?_⟩
  apply MAIS.CompactBandLocalization.compact_order_of_local_upper mu hK hf
  · intro x hx hfx
    obtain ⟨i,hp⟩ := hlocal x hx hfx
    obtain ⟨_,_,R,hR,hpair⟩ := hp
    obtain ⟨c,C,e,hc,hcC,he,_,hb⟩ := hpair (R/2) (half_pos hR) (by linarith)
    obtain ⟨eta,heta,hdom⟩ := gauge_dominates (hbest i)
    refine ⟨R/2,C,min e eta,half_pos hR,hc.trans_le hcC,lt_min he heta,?_⟩
    intro eps heps hsmall
    have hu := (hb eps heps (hsmall.trans_le (min_le_left _ _))).2
    have hd := hdom eps heps (hsmall.trans_le (min_le_right _ _))
    change mu {y | y ∈ K ∧ y ∈ Metric.ball x (R/2) ∧ |f y| < eps} ≤ _
    have hmass : bandMass mu (fun R => K ∩ Metric.ball x R) f x (R/2) eps =
        mu {y | y ∈ K ∧ y ∈ Metric.ball x (R/2) ∧ |f y| < eps} := by
      unfold bandMass
      simp only [hfx,sub_zero]
      congr 1
      ext y
      simp only [mem_ofPred_eq,mem_inter_iff,and_assoc]
    rw [hmass] at hu
    exact hu.trans (mul_le_mul_of_nonneg_left hd bot_le)
  · obtain ⟨_,_,R,hR,hpair⟩ := hp0
    refine ⟨x0,R/2,hx0,hfx0,half_pos hR,?_⟩
    have h := hpair (R/2) (half_pos hR) (by linarith)
    have hm : bandMass mu (fun R => K ∩ Metric.ball x0 R) f x0 (R/2) =
        (fun eps => mu {y | y ∈ K ∧ y ∈ Metric.ball x0 (R/2) ∧ |f y| < eps}) := by
      funext eps
      unfold bandMass
      simp only [hfx0,sub_zero]
      congr 1
      ext y
      simp only [mem_ofPred_eq,mem_inter_iff,and_assoc]
    rw [hm] at h
    exact h

end MAIS.CompactBandFiniteTypes
end

/--
info: 'MAIS.CompactBandFiniteTypes.gauge_dominates' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.CompactBandFiniteTypes.gauge_dominates

/--
info: 'MAIS.CompactBandFiniteTypes.exists_dominant_index' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.CompactBandFiniteTypes.exists_dominant_index

/--
info: 'MAIS.CompactBandFiniteTypes.compact_order_of_finite_attained_types' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.CompactBandFiniteTypes.compact_order_of_finite_attained_types
end
-- ==================== end module O7.CompactBandFiniteTypes ====================

-- ==================== begin module O7.CompactAmbientBandTable (formalization/O7/CompactAmbientBandTable.lean) ====================
section

/-! Finite tables of actual AMBIENT local pairs aggregate on a compact set
using upper patches everywhere and genuine attained interior lower patches. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.CompactAmbientBandTable
open MAIS.AnalyticTransfer O77.Residual
open MAIS.CompactBandFiniteTypes MAIS.WeightedAnnulusPairTransport
variable {E : Type*} [MetricSpace E] [MeasurableSpace E]

/-- No relative pair is postulated at boundary points. Ambient local pairs
supply all upper estimates; genuinely attained interior points supply the
lower patches. The finite extremal index and global cutoff are derived. -/
theorem compact_order_of_ambient_types
    {J : Type*} [Fintype J] [Nonempty J] (a : J→ℝ) (m : J→ℕ)
    (mu : Measure E) {K : Set E} (hK : IsCompact K) {f : E→ℝ} (hf : Continuous f)
    (hlocal : ∀ x,x∈K→f x=0→∃ j,
      HasMeasuredBandPair mu (Metric.ball x) f x (a j) (m j))
    (hattained : ∀ j,∃ x,x∈interior K ∧ f x=0 ∧
      HasMeasuredBandPair mu (Metric.ball x) f x (a j) (m j)) :
    ∃ j,(∀ i,a j<a i ∨ a j=a i ∧ m i ≤ m j) ∧
      EThetaZeroPowerLog (fun eps=>mu {x | x∈K ∧ |f x|<eps}) (a j) (m j-1) := by
  obtain ⟨j,hbest⟩ := exists_dominant_index a (fun i=>m i-1)
  obtain ⟨x0,hx0,hfx0,hp0⟩ := hattained j
  have hmj : 1 ≤ m j := hp0.2.1
  have hbest' : ∀ i,a j<a i ∨ a j=a i ∧ m i ≤ m j := by
    intro i
    rcases hbest i with hlt|⟨heq,hdeg⟩
    · exact Or.inl hlt
    · obtain ⟨x,hx,hfx,hp⟩ := hattained i
      have hmi := hp.2.1
      exact Or.inr ⟨heq,by omega⟩
  refine ⟨j,hbest',?_⟩
  apply MAIS.CompactBandLocalization.compact_order_of_local_upper mu hK hf
  · intro x hx hfx
    obtain ⟨i,hp⟩ := hlocal x hx hfx
    obtain ⟨_,_,R,hR,hpair⟩ := hp
    obtain ⟨c,C,e,hc,hcC,he,_,hb⟩ := hpair (R/2) (half_pos hR) (by linarith)
    obtain ⟨eta,heta,hdom⟩ := gauge_dominates (hbest i)
    refine ⟨R/2,C,min e eta,half_pos hR,hc.trans_le hcC,lt_min he heta,?_⟩
    intro eps heps hsmall
    have hu := (hb eps heps (hsmall.trans_le (min_le_left _ _))).2
    have hd := hdom eps heps (hsmall.trans_le (min_le_right _ _))
    have hinc : mu {y | y∈K ∧ y∈Metric.ball x (R/2) ∧ |f y|<eps} ≤
        bandMass mu (Metric.ball x) f x (R/2) eps := by
      apply measure_mono
      intro y hy
      exact ⟨hy.2.1,by simpa only [hfx,sub_zero] using hy.2.2⟩
    exact hinc.trans (hu.trans (mul_le_mul_of_nonneg_left hd bot_le))
  · have hprel := (pair_iff_intersection mu hx0 f (a j) (m j)).mp hp0
    obtain ⟨_,_,R,hR,hpair⟩ := hprel
    refine ⟨x0,R/2,interior_subset hx0,hfx0,half_pos hR,?_⟩
    have he := hpair (R/2) (half_pos hR) (by linarith)
    have hmass : bandMass mu (fun R=>K∩Metric.ball x0 R) f x0 (R/2)=
        (fun eps=>mu {y | y∈K ∧ y∈Metric.ball x0 (R/2) ∧ |f y|<eps}) := by
      funext eps
      unfold bandMass
      simp only [hfx0,sub_zero]
      congr 1
      ext y
      simp only [mem_ofPred_eq,mem_inter_iff,and_assoc]
    rw [hmass] at he
    exact he

end MAIS.CompactAmbientBandTable
end

/-- info: 'MAIS.CompactAmbientBandTable.compact_order_of_ambient_types' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.CompactAmbientBandTable.compact_order_of_ambient_types
end
-- ==================== end module O7.CompactAmbientBandTable ====================

-- ==================== begin module O7.WeightedAnnulusInterior (formalization/O7/WeightedAnnulusInterior.lean) ====================
section

/-! Every actual point of a compact weighted annulus has a positive
weighted dilation in its actual ambient interior. No measured pair,
homogeneity, or volume assumption is used. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1200000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology
namespace MAIS.WeightedAnnulusInterior
open MAIS.WeightedDyadicShells MAIS.WeightedCompactAnnulus

variable {I : Type*} [Fintype I] [DecidableEq I]

omit [DecidableEq I] in
theorem mem_interior_of_bounds (W : I → ℕ) (x : I → ℝ)
    (houter : ∀ i, |x i| < 1)
    (hinner : ∃ i, (1 / 2 : ℝ) ^ W i < |x i|) :
    x ∈ interior (compactAnnulus W) := by
  have hclosed : IsClosed (box W 1) := by
    have he : box W 1 = ⋂ i, {y : I → ℝ | |y i| ≤ (1 / 2 : ℝ) ^ W i} := by
      ext y
      simp [box]
    rw [he]
    exact isClosed_iInter (fun i => isClosed_le (continuous_apply i).abs continuous_const)
  have hopen : IsOpen (openBox W 0 \ box W 1) :=
    (isOpen_openBox W 0).sdiff hclosed
  have hsub : openBox W 0 \ box W 1 ⊆ compactAnnulus W := by
    intro y hy
    constructor
    · intro i
      simpa only [openBox,box,Nat.zero_mul,pow_zero] using (hy.1 i).le
    · intro h
      apply hy.2
      intro i
      exact (h i).le
  apply interior_maximal hsub hopen
  constructor
  · intro i
    simpa only [Nat.zero_mul,pow_zero] using houter i
  · intro h
    obtain ⟨i,hi⟩ := hinner
    have hh := h i
    simp only [Nat.one_mul] at hh
    exact (not_lt_of_ge hh) hi

omit [DecidableEq I] in
theorem exists_positive_dilation_mem_interior
    (W : I → ℕ) (hW : ∀ i, 0 < W i) (x : I → ℝ)
    (hx : x ∈ compactAnnulus W) :
    ∃ r : ℝ, 0 < r ∧ dilation W r x ∈ interior (compactAnnulus W) := by
  classical
  have houter : ∀ i, |x i| ≤ 1 := by
    intro i
    simpa only [box,Nat.zero_mul,pow_zero] using hx.1 i
  by_cases hsmall : x ∈ box W 1
  · have hwitness : ∃ i, (1 / 2 : ℝ) ^ W i ≤ |x i| := by
      have hn := hx.2
      change ¬∀ i, |x i| < (1 / 2 : ℝ) ^ (1 * W i) at hn
      simp only [Nat.one_mul] at hn
      push Not at hn
      exact hn
    refine ⟨3 / 2, by norm_num, mem_interior_of_bounds W _ ?_ ?_⟩
    · intro i
      have hxi : |x i| ≤ (1 / 2 : ℝ) ^ W i := by
        simpa only [Nat.one_mul] using hsmall i
      calc
        |dilation W (3 / 2) x i| = (3 / 2 : ℝ) ^ W i * |x i| := by
          simp only [dilation,abs_mul,abs_of_pos (pow_pos (by norm_num : (0:ℝ)<3/2) _)]
        _ ≤ (3 / 2 : ℝ) ^ W i * (1 / 2 : ℝ) ^ W i :=
          mul_le_mul_of_nonneg_left hxi (by positivity)
        _ = (3 / 4 : ℝ) ^ W i := by rw [← mul_pow]; norm_num
        _ < 1 := pow_lt_one₀ (by norm_num) (by norm_num) (Nat.ne_of_gt (hW i))
    · obtain ⟨i,hi⟩ := hwitness
      refine ⟨i,?_⟩
      calc
        (1 / 2 : ℝ) ^ W i < (3 / 4 : ℝ) ^ W i :=
          pow_lt_pow_left₀ (by norm_num) (by norm_num) (Nat.ne_of_gt (hW i))
        _ = (3 / 2 : ℝ) ^ W i * (1 / 2 : ℝ) ^ W i := by rw [← mul_pow]; norm_num
        _ ≤ (3 / 2 : ℝ) ^ W i * |x i| := mul_le_mul_of_nonneg_left hi (by positivity)
        _ = |dilation W (3 / 2) x i| := by
          simp only [dilation,abs_mul,abs_of_pos (pow_pos (by norm_num : (0:ℝ)<3/2) _)]
  · have hwitness : ∃ i, (1 / 2 : ℝ) ^ W i < |x i| := by
      change ¬∀ i, |x i| ≤ (1 / 2 : ℝ) ^ (1 * W i) at hsmall
      simp only [Nat.one_mul] at hsmall
      push Not at hsmall
      exact hsmall
    obtain ⟨i,hi⟩ := hwitness
    have hopen : IsOpen {r : ℝ | (1 / 2 : ℝ) ^ W i < |r ^ W i * x i|} :=
      isOpen_lt continuous_const (by fun_prop)
    have h1 : (1 : ℝ) ∈ {r : ℝ | (1 / 2 : ℝ) ^ W i < |r ^ W i * x i|} := by
      simpa using hi
    obtain ⟨eta,heta,hball⟩ := Metric.mem_nhds_iff.mp (hopen.mem_nhds h1)
    let r : ℝ := 1 - min eta 1 / 2
    have hmin : 0 < min eta 1 := lt_min heta zero_lt_one
    have hr0 : 0 < r := by dsimp [r]; linarith [min_le_right eta 1]
    have hr1 : r < 1 := by dsimp [r]; linarith
    have hdist : r ∈ Metric.ball (1 : ℝ) eta := by
      rw [Metric.mem_ball,Real.dist_eq,abs_of_neg (by linarith : r-1<0)]
      dsimp [r]
      linarith [min_le_left eta 1]
    have hretained := hball hdist
    refine ⟨r,hr0,mem_interior_of_bounds W _ ?_ ?_⟩
    · intro j
      calc
        |dilation W r x j| = r ^ W j * |x j| := by
          simp only [dilation,abs_mul,abs_of_pos (pow_pos hr0 _)]
        _ ≤ r ^ W j * 1 := mul_le_mul_of_nonneg_left (houter j) (by positivity)
        _ = r ^ W j := mul_one _
        _ < 1 := pow_lt_one₀ hr0.le hr1 (Nat.ne_of_gt (hW j))
    · exact ⟨i,hretained⟩

end MAIS.WeightedAnnulusInterior
end

/-- info: 'MAIS.WeightedAnnulusInterior.mem_interior_of_bounds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedAnnulusInterior.mem_interior_of_bounds

/-- info: 'MAIS.WeightedAnnulusInterior.exists_positive_dilation_mem_interior' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedAnnulusInterior.exists_positive_dilation_mem_interior
end
