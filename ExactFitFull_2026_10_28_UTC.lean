-- ==================== begin module O7.ActiveIntervalNumericRecurrence (formalization/O7/ActiveIntervalNumericRecurrence.lean) ====================
section

/-! Actual measured numerical recurrence from an actual compact-annulus
band order. All weights, degrees, compactness, radial integration, ball
windows, Gaussian dimensions and original-entry transport are derived. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set MeasureTheory
open scoped ENNReal Topology
namespace MAIS.ActiveIntervalNumericRecurrence
open MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalGaussianCoordinates
open MAIS.ActiveIntervalGaussianChart MAIS.ActiveIntervalAnnulusRecurrence
open MAIS.ActiveIntervalWeightedResidual MAIS.IntervalIntegerPotentials
open MAIS.ActiveIntervalRadialBand MAIS.WeightedCompactAnnulus
open MAIS.ActiveIntervalRadialPair MAIS.MatrixChainIsomorphism
open MAIS.AnalyticTransfer MAIS.IntervalCochainProduct O77.Residual
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s≤D+1)

/-- The genuine ratio of actual volume weight to actual residual degree. -/
def radialRatio : ℝ :=
  (∑ p:ResidualIndex D birth death,integerWeights D birth death p : ℕ) /
    (2*commonDenominator D birth death : ℕ)

include hD in
/-- Positivity is derived from a nonempty actual residual carrier and the
    actual zero-output interval base; it is not a supplied pole. -/
theorem radialRatio_pos [Nonempty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0) :
    0 < radialRatio D birth death := by
  apply div_pos
  · exact_mod_cast totalIntegerWeight_pos D birth death hD hzero
  · exact_mod_cast Nat.mul_pos (by decide : 0<2)
      (zero_base_weight_data D birth death hD hzero).1

/-- Full residual-pair trichotomy from the actual compact annulus band.
    The boundary equality adds exactly one logarithmic power. -/
theorem residual_pair_trichotomy_of_annulus_order
    (mu:Measure (Residual D birth death)) [Measure.IsAddHaarMeasure mu]
    [Nonempty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    {beta:ℝ} (hbeta:0≤beta) {n:ℕ}
    (hp:EThetaZeroPowerLog (annularBand D birth death hD mu) beta n) :
    (beta < radialRatio D birth death →
      HasMeasuredBandPair mu (Metric.ball (0:Residual D birth death))
        (residualLoss D birth death hD) 0 beta (n+1)) ∧
    (beta = radialRatio D birth death →
      HasMeasuredBandPair mu (Metric.ball (0:Residual D birth death))
        (residualLoss D birth death hD) 0 (radialRatio D birth death) (n+2)) ∧
    (radialRatio D birth death < beta →
      HasMeasuredBandPair mu (Metric.ball (0:Residual D birth death))
        (residualLoss D birth death hD) 0 (radialRatio D birth death) 1) := by
  have hA:=totalIntegerWeight_pos D birth death hD hzero
  have hd:0<2*commonDenominator D birth death:=
    Nat.mul_pos (by decide) (zero_base_weight_data D birth death hD hzero).1
  have hK:mu (compactAnnulus (integerWeights D birth death))≠⊤:=
    (isCompact_compactAnnulus (integerWeights D birth death)).measure_lt_top.ne
  have hh:=MAIS.ActualAnnulusRadialOrder.finite_annulus_radial_trichotomy
    mu (compactAnnulus (integerWeights D birth death)) (residualLoss D birth death hD)
    hK hA hd hp
  have hB:(fun e:ℝ=>mu {x | x∈compactAnnulus (integerWeights D birth death) ∧
      residualLoss D birth death hD x<e})=annularBand D birth death hD mu:=by rfl
  rw [hB] at hh
  have hsub:n+2-1=n+1:=by omega
  have ha:0≤radialRatio D birth death:=(radialRatio_pos D birth death hD hzero).le
  refine ⟨?_,?_,?_⟩
  · intro h
    apply (pair_iff_radial_integral D birth death hD mu hzero beta (n+1)).mpr
    exact ⟨hbeta,by omega,by simpa only [Nat.add_sub_cancel] using hh.1 h⟩
  · intro h
    apply (pair_iff_radial_integral D birth death hD mu hzero (radialRatio D birth death) (n+2)).mpr
    exact ⟨ha,by omega,by simpa only [radialRatio,hsub] using hh.2.1 h⟩
  · intro h
    apply (pair_iff_radial_integral D birth death hD mu hzero (radialRatio D birth death) 1).mpr
    exact ⟨ha,by decide,by simpa only [radialRatio,Nat.sub_self] using hh.2.2 h⟩

/-- A numerical annulus order yields the literal full original-entry
half-squared-loss recurrence, for any ambient continuous positive prior.
No residual pair, assigned Jacobian or prescribed exponent is a premise. -/
theorem ambient_entry_half_pair_trichotomy_of_annulus_order
    (hvalid:∀ s,birth s<death s)
    (muA:Measure (MAIS.ActiveIntervalMeasuredSlice.Ambient D birth death))
    [Measure.IsAddHaarMeasure muA]
    (muT:Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR:Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    [Nonempty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (prior:MAIS.ActiveIntervalMeasuredSlice.Ambient D birth death→ℝ)
    (hprior:ContinuousAt prior (intervalRep D birth death))
    (hpos:0<prior (intervalRep D birth death))
    {beta:ℝ} (hbeta:0≤beta) {n:ℕ}
    (hp:EThetaZeroPowerLog (annularBand D birth death hD muR) beta n)
    (lam:ℝ) (m:ℕ) :
    let P:=HasMeasuredBandPair (muA.withDensity (fun A=>ENNReal.ofReal (prior A)))
      (MAIS.MatrixChainEntryWindows.entryBall (Index D birth death) (intervalRep D birth death))
      (fun A=>(1/2:ℝ)*MAIS.ActiveIntervalMeasuredSlice.ambientLoss D birth death
        0 (Fin.last D) (by exact Nat.zero_le D) A) (intervalRep D birth death) lam m
    let q:ℝ:=(Fintype.card (DirectIndex D birth death):ℝ)/2
    (beta<radialRatio D birth death → (P ↔ lam=beta+q ∧ m=n+1)) ∧
    (beta=radialRatio D birth death → (P ↔ lam=radialRatio D birth death+q ∧ m=n+2)) ∧
    (radialRatio D birth death<beta → (P ↔ lam=radialRatio D birth death+q ∧ m=1)) := by
  obtain ⟨hlt,heq,hgt⟩:=residual_pair_trichotomy_of_annulus_order
    D birth death hD muR hzero hbeta hp
  exact ⟨fun h=>MAIS.ActiveIntervalMeasuredSuspension.ambient_entry_half_pair_iff_of_residual_pair
      D birth death hD hvalid muA muT muR hzero prior hprior hpos (hlt h) lam m,
    fun h=>MAIS.ActiveIntervalMeasuredSuspension.ambient_entry_half_pair_iff_of_residual_pair
      D birth death hD hvalid muA muT muR hzero prior hprior hpos (heq h) lam m,
    fun h=>MAIS.ActiveIntervalMeasuredSuspension.ambient_entry_half_pair_iff_of_residual_pair
      D birth death hD hvalid muA muT muR hzero prior hprior hpos (hgt h) lam m⟩

end MAIS.ActiveIntervalNumericRecurrence
end

/-- info: 'MAIS.ActiveIntervalNumericRecurrence.radialRatio_pos' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalNumericRecurrence.radialRatio_pos

/-- info: 'MAIS.ActiveIntervalNumericRecurrence.residual_pair_trichotomy_of_annulus_order' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalNumericRecurrence.residual_pair_trichotomy_of_annulus_order

/-- info: 'MAIS.ActiveIntervalNumericRecurrence.ambient_entry_half_pair_trichotomy_of_annulus_order' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalNumericRecurrence.ambient_entry_half_pair_trichotomy_of_annulus_order
end
