-- ==================== begin module O7.ActiveIntervalAnnulusRecurrence (formalization/O7/ActiveIntervalAnnulusRecurrence.lean) ====================
section

/-! Actual compact-annulus residual band series and the actual strict
zero-output representations associated to its nonzero residual zeros. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000
noncomputable section
open Set MeasureTheory
open scoped ENNReal Topology Matrix Matrix.Norms.Frobenius
namespace MAIS.ActiveIntervalAnnulusRecurrence
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.ActiveIntervalWeightedResidual MAIS.IntervalIntegerPotentials
open MAIS.WeightedDyadicShells MAIS.WeightedDyadicBandIdentity MAIS.WeightedCompactAnnulus
open MAIS.ActiveIntervalEndpointRows MAIS.MatrixChainIsomorphism
open MAIS.ActiveIntervalStrictGenerization MAIS.QuiverRealOrbit
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s≤D+1)

def integerWeights (p:ResidualIndex D birth death) : ℕ:=integerWeight D birth death p.val

/-- Exact actual residual sublevel series with the actual compact weighted
    annulus, and every weight and loss degree derived from the base. -/
theorem residual_band_series_compact (mu:Measure (Residual D birth death))
    [Measure.IsAddHaarMeasure mu] [NullSingletonClass mu]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (eps:ℝ) :
    bandOn mu (box (integerWeights D birth death) 0) (residualLoss D birth death hD) eps=
      ∑' k:ℕ,ENNReal.ofReal (((1/2:ℝ)^(∑ p:ResidualIndex D birth death,
        integerWeights D birth death p))^k)*
        bandOn mu (compactAnnulus (integerWeights D birth death))
          (residualLoss D birth death hD) (eps*(2^(2*commonDenominator D birth death))^k) := by
  have hW:∀ p:ResidualIndex D birth death,0 < integerWeights D birth death p:=
    fun p=>(zero_base_weight_data D birth death hD hzero).2 p |>.1
  have hhom:∀ r:ℝ,0<r→∀ z:Residual D birth death,
      residualLoss D birth death hD (dilation (integerWeights D birth death) r z)=
        r^(2*commonDenominator D birth death)*residualLoss D birth death hD z:=by
    intro r hr z
    exact zero_base_residualLoss_integerDilation D birth death hD hzero r hr z
  rw [box_band mu (integerWeights D birth death) hW _ _
    (continuous_residualLoss D birth death hD).measurable hhom]
  apply tsum_congr
  intro k
  rw [bandOn_compactAnnulus]

/-- The genuine normal parameter giving zero direct output and the supplied
    residual coordinates, including the exact nonlinear elimination correction. -/
def zeroDirectParameter (z:Residual D birth death) : NormalParams birth death :=
  gaussianHomeomorph D birth death hD (z,0)

def zeroDirectRep (z:Residual D birth death) : Rep (Index D birth death) :=
  normalFamily D birth death hD (zeroDirectParameter D birth death hD z)

/-- A residual zero gives an actual zero full matrix product only AFTER the
    actual direct-coordinate elimination, as represented here. -/
theorem fullProduct_zeroDirectRep_eq_zero (z:Residual D birth death)
    (hz:residualLoss D birth death hD z=0) :
    pathMatrix (zeroDirectRep D birth death hD z) 0 (Fin.last D) (by exact Nat.zero_le D)=0 := by
  have he:=normalSquaredLoss_gaussianHomeomorph D birth death hD (z,0)
  rw [hz,norm_zero,zero_pow (by decide:2≠0),add_zero] at he
  change ‖pathMatrix (zeroDirectRep D birth death hD z) 0 (Fin.last D) (by exact Nat.zero_le D)‖^2=0 at he
  exact norm_eq_zero.mp (sq_eq_zero_iff.mp he)

/-- A genuine compact-annulus point stays nonzero through the actual global
    Gaussian/elimination homeomorphism. -/
theorem zeroDirectParameter_ne_zero_of_mem_annulus (z:Residual D birth death)
    (hz:z∈compactAnnulus (integerWeights D birth death)) :
    zeroDirectParameter D birth death hD z≠0 := by
  intro h
  have hh:(z,(0:Regular D birth death))=0:=
    (gaussianHomeomorph D birth death hD).injective
      (h.trans (gaussianHomeomorph_zero D birth death hD).symm)
  have hz0:z=0:=congrArg Prod.fst hh
  subst z
  exact zero_not_mem_compactAnnulus _ hz

/-- Every actual compact-annulus residual zero yields an actual zero-output
    strict real orbit generization, with some actual path rank increased. -/
theorem annulus_zero_strict_generization (z:Residual D birth death)
    (hAnn:z∈compactAnnulus (integerWeights D birth death))
    (hz:residualLoss D birth death hD z=0) :
    pathMatrix (zeroDirectRep D birth death hD z) 0 (Fin.last D) (by exact Nat.zero_le D)=0 ∧
    intervalRep D birth death∈closure
      (MulAction.orbit (Gauge (Index D birth death)) (zeroDirectRep D birth death hD z)) ∧
    zeroDirectRep D birth death hD z∉MulAction.orbit (Gauge (Index D birth death))
      (intervalRep D birth death) ∧
    (∃ i j,∃ hij:i≤j,
      (pathMatrix (intervalRep D birth death) i j hij).rank<
      (pathMatrix (zeroDirectRep D birth death hD z) i j hij).rank) := by
  have he:=strict_generization D birth death hD (zeroDirectParameter D birth death hD z)
    (zeroDirectParameter_ne_zero_of_mem_annulus D birth death hD z hAnn)
  exact ⟨fullProduct_zeroDirectRep_eq_zero D birth death hD z hz,he.1,he.2.1,he.2.2.2⟩

end MAIS.ActiveIntervalAnnulusRecurrence
end

/-- info: 'MAIS.ActiveIntervalAnnulusRecurrence.residual_band_series_compact' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalAnnulusRecurrence.residual_band_series_compact

/-- info: 'MAIS.ActiveIntervalAnnulusRecurrence.fullProduct_zeroDirectRep_eq_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalAnnulusRecurrence.fullProduct_zeroDirectRep_eq_zero

/-- info: 'MAIS.ActiveIntervalAnnulusRecurrence.zeroDirectParameter_ne_zero_of_mem_annulus' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalAnnulusRecurrence.zeroDirectParameter_ne_zero_of_mem_annulus

/-- info: 'MAIS.ActiveIntervalAnnulusRecurrence.annulus_zero_strict_generization' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalAnnulusRecurrence.annulus_zero_strict_generization
end
