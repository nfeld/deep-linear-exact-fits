-- ==================== begin module O7.ActiveIntervalRankMinors (formalization/O7/ActiveIntervalRankMinors.lean) ====================
section

/-! Actual rank-obstruction minors on the physical independent normal slice. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000
noncomputable section
namespace MAIS.ActiveIntervalRankMinors
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalEndpointRows MAIS.ActiveIntervalPathDerivative
open MAIS.ActiveIntervalBasePaths MAIS.MatrixChainIsomorphism
open MAIS.ActiveIntervalPivotRanks
open scoped Matrix Matrix.Norms.Elementwise Topology
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D+1)

abbrev Pivot (p : NormalIndex birth death) :=
  Common D birth death (startVertex D birth death hD p) (endVertex D birth death hD p)

def pivotRow (p : NormalIndex birth death) : Option (Pivot D birth death hD p) →
    Index D birth death (endVertex D birth death hD p)
  | none => targetSlot D birth death hD p
  | some k => ⟨k.val,k.property.2⟩
def pivotCol (p : NormalIndex birth death) : Option (Pivot D birth death hD p) →
    Index D birth death (startVertex D birth death hD p)
  | none => sourceSlot D birth death hD p
  | some k => ⟨k.val,k.property.1⟩

def minorMatrix (p : NormalIndex birth death) (t : NormalParams birth death) :
    Matrix (Option (Pivot D birth death hD p)) (Option (Pivot D birth death hD p)) ℝ :=
  (pathMatrix (normalFamily D birth death hD t)
    (startVertex D birth death hD p) (endVertex D birth death hD p)
    (start_le_end D birth death hD p)).submatrix
      (pivotRow D birth death hD p) (pivotCol D birth death hD p)

def rankMinor (p : NormalIndex birth death) (t : NormalParams birth death) : ℝ :=
  (minorMatrix D birth death hD p t).det

def rankMinorMap (t : NormalParams birth death) : NormalParams birth death :=
  fun p => rankMinor D birth death hD p t

theorem minorMatrix_zero (p : NormalIndex birth death) :
    minorMatrix D birth death hD p 0 = MAIS.OptionPivotDeterminant.pivotBase := by
  ext r s
  change pathMatrix (normalFamily D birth death hD 0)
    (startVertex D birth death hD p) (endVertex D birth death hD p)
    (start_le_end D birth death hD p)
    (pivotRow D birth death hD p r) (pivotCol D birth death hD p s) = _
  rw [normalFamily_zero,pathMatrix_intervalRep_entry]
  have hp:=p.property
  change birth p.val.2 < birth p.val.1 ∧ birth p.val.1 ≤ death p.val.2 ∧
    death p.val.2 < death p.val.1 at hp
  cases r with
  | none =>
    cases s with
    | none =>
      have hn : p.val.1≠p.val.2 := by intro h; rw [h] at hp; omega
      simp [pivotRow,pivotCol,MAIS.OptionPivotDeterminant.pivotBase,
        targetSlot,sourceSlot,hn]
    | some k =>
      have hn : p.val.1≠k.val := by
        intro h
        have hh:=k.property.1.1
        change birth k.val ≤ birth p.val.2 at hh
        rw [← h] at hh
        omega
      simp [pivotRow,pivotCol,MAIS.OptionPivotDeterminant.pivotBase,targetSlot,hn]
  | some k =>
    cases s with
    | none =>
      have hn : k.val≠p.val.2 := by
        intro h
        have hh:=k.property.2.2
        change death p.val.1-1 < death k.val at hh
        rw [h] at hh
        omega
      simp [pivotRow,pivotCol,MAIS.OptionPivotDeterminant.pivotBase,sourceSlot,hn]
    | some l =>
      simp [pivotRow,pivotCol,MAIS.OptionPivotDeterminant.pivotBase,Matrix.diagonal_apply,Subtype.ext_iff]

theorem analyticAt_minorMatrix (p : NormalIndex birth death) (t : NormalParams birth death) :
    AnalyticAt ℝ (minorMatrix D birth death hD p) t := by
  apply AnalyticAt.pi
  intro r
  apply AnalyticAt.pi
  intro s
  exact analyticAt_path_entry D birth death hD _ _ _ _ _ t

theorem rankMinor_eq_zero_of_path_rank_le (p : NormalIndex birth death)
    (t : NormalParams birth death)
    (hrank : (pathMatrix (normalFamily D birth death hD t)
      (startVertex D birth death hD p) (endVertex D birth death hD p)
      (start_le_end D birth death hD p)).rank ≤
      (pathMatrix (intervalRep D birth death)
      (startVertex D birth death hD p) (endVertex D birth death hD p)
      (start_le_end D birth death hD p)).rank) : rankMinor D birth death hD p t=0 := by
  unfold rankMinor minorMatrix
  apply det_option_submatrix_eq_zero_of_rank_le
  rw [path_rank_eq_common_card] at hrank
  exact hrank

/-- The complete vector of actual rank-obstruction minors has derivative
    the identity on the actual independent normal coordinate carrier. -/
theorem hasFDerivAt_rankMinor (p : NormalIndex birth death) :
    HasFDerivAt (rankMinor D birth death hD p)
      (ContinuousLinearMap.proj (R:=ℝ) p) 0 := by
  let M := minorMatrix D birth death hD p
  have hM : DifferentiableAt ℝ M 0 :=
    (analyticAt_minorMatrix D birth death hD p 0).differentiableAt
  have hbase : M 0=MAIS.OptionPivotDeterminant.pivotBase := minorMatrix_zero D birth death hD p
  have hdet : HasFDerivAt (fun t => (M t).det)
      (MAIS.OptionPivotDeterminant.pivotEntry.comp (fderiv ℝ M 0)) 0 := by
    have hd := MAIS.OptionPivotDeterminant.hasFDerivAt_det_pivot (K:=Pivot D birth death hD p)
    rw [← hbase] at hd
    exact hd.comp 0 hM.hasFDerivAt
  have hc : HasFDerivAt (fun t => M t none none)
      (MAIS.OptionPivotDeterminant.pivotEntry.comp (fderiv ℝ M 0)) 0 := by
    convert MAIS.OptionPivotDeterminant.pivotEntry.hasFDerivAt.comp 0 hM.hasFDerivAt using 1 <;> rfl
  have hentry : HasFDerivAt (fun t => M t none none)
      (ContinuousLinearMap.proj (R:=ℝ) p) 0 :=
    hasFDerivAt_selectedPathEntry D birth death hD p
  rw [hc.unique hentry] at hdet
  exact hdet

theorem analyticAt_rankMinor (p : NormalIndex birth death) (t : NormalParams birth death) :
    AnalyticAt ℝ (rankMinor D birth death hD p) t :=
  (MAIS.OptionPivotDeterminant.analyticAt_det _).comp
    (analyticAt_minorMatrix D birth death hD p t)

theorem hasFDerivAt_rankMinorMap :
    HasFDerivAt (rankMinorMap D birth death hD)
      ((ContinuousLinearEquiv.refl ℝ (NormalParams birth death)) :
        NormalParams birth death →L[ℝ] NormalParams birth death) 0 := by
  convert hasFDerivAt_pi.mpr (fun p => hasFDerivAt_rankMinor D birth death hD p) using 1 <;> rfl

theorem hasStrictFDerivAt_rankMinorMap :
    HasStrictFDerivAt (rankMinorMap D birth death hD)
      ((ContinuousLinearEquiv.refl ℝ (NormalParams birth death)) :
        NormalParams birth death →L[ℝ] NormalParams birth death) 0 := by
  have ha : AnalyticAt ℝ (rankMinorMap D birth death hD) 0 :=
    AnalyticAt.pi (fun p => analyticAt_rankMinor D birth death hD p 0)
  exact (ha.contDiffAt (n:=1)).hasStrictFDerivAt'
    (hasFDerivAt_rankMinorMap D birth death hD) (by simp)

/-- The actual minors define a genuine local ambient coordinate chart of
    the independent normal parameter space. -/
def minorChart : OpenPartialHomeomorph (NormalParams birth death) (NormalParams birth death) :=
  (hasStrictFDerivAt_rankMinorMap D birth death hD).toOpenPartialHomeomorph
    (rankMinorMap D birth death hD)

theorem zero_mem_minorChart_source :
    (0:NormalParams birth death)∈(minorChart D birth death hD).source :=
  (hasStrictFDerivAt_rankMinorMap D birth death hD).mem_toOpenPartialHomeomorph_source

theorem rankMinorMap_zero : rankMinorMap D birth death hD 0=0 := by
  funext p
  change rankMinor D birth death hD p 0=0
  apply rankMinor_eq_zero_of_path_rank_le D birth death hD p 0
  rw [normalFamily_zero]

/-- In an actual neighborhood, non-increasing actual path ranks isolate
    the origin in the literal affine normal slice. -/
theorem local_eq_zero_of_path_rank_le :
    ∃ U∈𝓝 (0:NormalParams birth death), ∀ t∈U,
      (∀ i j (hij:i≤j),
        (pathMatrix (normalFamily D birth death hD t) i j hij).rank ≤
        (pathMatrix (intervalRep D birth death) i j hij).rank) → t=0 := by
  refine ⟨(minorChart D birth death hD).source,?_,?_⟩
  · exact (minorChart D birth death hD).open_source.mem_nhds
      (zero_mem_minorChart_source D birth death hD)
  · intro t ht hrank
    apply (minorChart D birth death hD).injOn ht (zero_mem_minorChart_source D birth death hD)
    change rankMinorMap D birth death hD t=rankMinorMap D birth death hD 0
    rw [rankMinorMap_zero]
    funext p
    exact rankMinor_eq_zero_of_path_rank_le D birth death hD p t (hrank _ _ _)

end MAIS.ActiveIntervalRankMinors
end

