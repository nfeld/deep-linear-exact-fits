        ∫⁻ s in S, F s ∂coordinateLebesgue (Fin k) := by
  let : SigmaFinite (angularLebesgue k) := by
    unfold angularLebesgue
    infer_instance
  let : SigmaFinite (coordinateLebesgue (Fin k)) := by
    unfold coordinateLebesgue
    infer_instance
