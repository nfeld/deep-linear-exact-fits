-- ==================== begin module O7.Run2GeometricSliceZeroFiber (formalization/O7/Run2GeometricSliceZeroFiber.lean) ====================
section

/-! Zero complete product in an actual orbit slice is exactly zero complete
product on its actual normal coordinate; invertible endpoint gauges prove both
directions, including zero-dimensional endpoint spaces and depth zero. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2GeometricSliceZeroFiber
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.OrbitSliceChart MAIS.Run2GeometricZeroFiber
variable {D : ℕ} (ι : Fin (D+1) → Type*)
  [∀ v,Fintype (ι v)] [∀ v,DecidableEq (ι v)]

theorem sliceMap_mem_zeroFiber_iff (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι)) (p : H × N) :
    sliceMap ι A H N p ∈ zeroFiber ι ↔ A+(p.2:Rep ι) ∈ zeroFiber ι := by
  rw [sliceMap_eq_expGauge_smul]
  constructor
  · intro hp
    have hmem : A+(p.2:Rep ι) ∈ MulAction.orbit (Gauge ι)
        ((expGauge ι (p.1:Lie ι)) • (A+(p.2:Rep ι))) :=
      MulAction.mem_orbit_iff.mpr ⟨(expGauge ι (p.1:Lie ι))⁻¹,inv_smul_smul _ _⟩
    exact mem_zeroFiber_of_mem_orbit ι hmem hp
  · intro hp
    exact mem_zeroFiber_of_mem_orbit ι
      (MulAction.mem_orbit_iff.mpr ⟨expGauge ι (p.1:Lie ι),rfl⟩) hp
end MAIS.Run2GeometricSliceZeroFiber

/-- info: 'MAIS.Run2GeometricSliceZeroFiber.sliceMap_mem_zeroFiber_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricSliceZeroFiber.sliceMap_mem_zeroFiber_iff
end
end
