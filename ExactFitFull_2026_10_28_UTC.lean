-- ==================== begin module O7.Run2StrictOrbitLinear (formalization/O7/Run2StrictOrbitLinear.lean) ====================
section

/-! A nonzero normal radial direction is an actual orbit direction at the
normal point. Actual transverse linear maps remain injective near the base,
forcing a strict increase of the actual orbit-differential range dimension. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
noncomputable section
open Set Filter
open scoped Topology Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2StrictOrbitLinear
open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.MatrixSmoothMul
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalSliceChart MAIS.ActiveIntervalEndpointRows
open MAIS.ActiveIntervalNormalContraction MAIS.Run2LinearRankGain

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

def sliceLinear (t : NormalParams birth death) :
    (TangentParameters D birth death × NormalParams birth death) →ₗ[ℝ]
      Rep (Index D birth death) :=
  ((orbitDifferential (Index D birth death) (normalFamily D birth death hD t)).comp
    (TangentParameters D birth death).subtype).coprod
      (MAIS.ActiveIntervalNormal.normalInjection D birth death hD)

theorem continuous_sliceLinear_apply
    (p : TangentParameters D birth death × NormalParams birth death) :
    Continuous (fun t => sliceLinear D birth death hD t p) := by
  apply continuous_pi
  intro e
  have hc := (continuous_apply e).comp (continuous_normalFamily birth death D hD)
  change Continuous (fun t =>
    (p.1 : Lie (Index D birth death)) e.succ * normalFamily D birth death hD t e -
      normalFamily D birth death hD t e * (p.1 : Lie (Index D birth death)) e.castSucc +
        MAIS.ActiveIntervalNormal.normalInjection D birth death hD p.2 e)
  exact (((mulCLM ((p.1 : Lie (Index D birth death)) e.succ)).continuous.comp hc).sub
    (((mulCLM).flip ((p.1 : Lie (Index D birth death)) e.castSucc)).continuous.comp hc)).add
      continuous_const

theorem sliceLinear_zero_injective (hvalid : ∀ s, birth s < death s) :
    Function.Injective (sliceLinear D birth death hD 0) := by
  let e := (parameterEquiv D birth death hD).trans
    (sliceDerivativeEquiv (Index D birth death) (intervalRep D birth death)
      (TangentParameters D birth death) (MAIS.ActiveIntervalNormal.normalSpace D birth death hD)
      (orbitDirections_isCompl _ _)
      (MAIS.ActiveIntervalNormal.orbitDifferential_normalSpace_isCompl D birth death hD hvalid))
  have he : ∀ p, e p = sliceLinear D birth death hD 0 p := by
    intro p
    change orbitDifferential (Index D birth death) (intervalRep D birth death)
        (p.1 : Lie (Index D birth death)) +
          MAIS.ActiveIntervalNormal.normalInjection D birth death hD p.2 =
      orbitDifferential (Index D birth death) (normalFamily D birth death hD 0)
        (p.1 : Lie (Index D birth death)) +
          MAIS.ActiveIntervalNormal.normalInjection D birth death hD p.2
    simp only [normalFamily, map_zero, add_zero]
  intro p q hpq
  exact e.injective ((he p).trans (hpq.trans (he q).symm))

theorem eventually_sliceLinear_injective (hvalid : ∀ s, birth s < death s) :
    ∀ᶠ t : NormalParams birth death in nhds 0,
      Function.Injective (sliceLinear D birth death hD t) :=
  eventually_injective (sliceLinear D birth death hD)
    (fun p => (continuous_sliceLinear_apply D birth death hD p).continuousAt)
    (sliceLinear_zero_injective D birth death hD hvalid)

def potentialLie (q : S → ℝ) : Lie (Index D birth death) :=
  fun v => Matrix.diagonal (fun s : Index D birth death v => q s.val)

def potentialVelocity (q : S → ℝ) (t : NormalParams birth death) : NormalParams birth death :=
  fun p => (q p.val.1 - q p.val.2) * t p

omit [Fintype S] [DecidableEq S] in
theorem normalInjection_potentialVelocity_entry (q : S → ℝ)
    (t : NormalParams birth death) (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    MAIS.ActiveIntervalNormal.normalInjection D birth death hD
        (potentialVelocity birth death q t) e r s =
      (q r.val - q s.val) *
        MAIS.ActiveIntervalNormal.normalInjection D birth death hD t e r s := by
  simp only [MAIS.ActiveIntervalNormal.normalInjection_apply]
  by_cases hp : Linked birth death r.val s.val
  · simp only [dite_eq_left hp, potentialVelocity]
    ring
  · simp only [dite_eq_right hp, mul_zero]

theorem orbitDifferential_potentialLie (q : S → ℝ) (t : NormalParams birth death) :
    orbitDifferential (Index D birth death) (normalFamily D birth death hD t)
        (potentialLie D birth death q) =
      MAIS.ActiveIntervalNormal.normalInjection D birth death hD (potentialVelocity birth death q t) := by
  funext e r s
  simp only [orbitDifferential_apply, potentialLie, Matrix.sub_apply, Matrix.diagonal_mul, Matrix.mul_diagonal,
    normalFamily, Pi.add_apply, Matrix.add_apply]
  rw [normalInjection_potentialVelocity_entry]
  by_cases hrs : r.val = s.val
  · have hq := congrArg q hrs
    rw [hq]
    ring
  · rw [intervalRep, ite_eq_right hrs]
    ring

omit [Fintype S] [DecidableEq S] in
theorem heightVelocity_ne_zero (t : NormalParams birth death) (ht : t ≠ 0) :
    potentialVelocity birth death (fun s => (height birth death s : ℝ)) t ≠ 0 := by
  intro he
  apply ht
  funext p
  have hp : (0 : ℝ) < (height birth death p.val.1 : ℝ) - height birth death p.val.2 := by
    apply sub_pos.mpr
    exact_mod_cast height_lt_of_linked birth death p.val.1 p.val.2 p.property
  exact (mul_eq_zero.mp (congrFun he p)).resolve_left hp.ne'

theorem finrank_tangentParameters :
    Module.finrank ℝ (TangentParameters D birth death) =
      Module.finrank ℝ (orbitDifferential (Index D birth death) (intervalRep D birth death)).range :=
  ((orbitDifferential (Index D birth death) (intervalRep D birth death)).kerComplementEquivRange
    (orbitDirections_isCompl _ _)).finrank_eq

/-- A genuine nearby nonzero physical normal point has a strictly larger
actual orbit tangent range. No geometric dimension convention is assumed. -/
theorem nearby_finrank_range_strict (t : NormalParams birth death) (ht : t ≠ 0)
    (hinj : Function.Injective (sliceLinear D birth death hD t)) :
    Module.finrank ℝ (orbitDifferential (Index D birth death) (intervalRep D birth death)).range <
      Module.finrank ℝ (orbitDifferential (Index D birth death) (normalFamily D birth death hD t)).range := by
  have hg := finrank_range_ge_add_one
    (orbitDifferential (Index D birth death) (normalFamily D birth death hD t))
    (TangentParameters D birth death).subtype
    (MAIS.ActiveIntervalNormal.normalInjection D birth death hD) hinj
    (potentialVelocity birth death (fun s => (height birth death s : ℝ)) t)
    (heightVelocity_ne_zero birth death t ht)
    ⟨potentialLie D birth death (fun s => (height birth death s : ℝ)),
      orbitDifferential_potentialLie D birth death hD _ t⟩
  rw [finrank_tangentParameters] at hg
  omega

end MAIS.Run2StrictOrbitLinear

/-- info: 'MAIS.Run2StrictOrbitLinear.continuous_sliceLinear_apply' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2StrictOrbitLinear.continuous_sliceLinear_apply

/-- info: 'MAIS.Run2StrictOrbitLinear.sliceLinear_zero_injective' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2StrictOrbitLinear.sliceLinear_zero_injective

/-- info: 'MAIS.Run2StrictOrbitLinear.eventually_sliceLinear_injective' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2StrictOrbitLinear.eventually_sliceLinear_injective

/-- info: 'MAIS.Run2StrictOrbitLinear.normalInjection_potentialVelocity_entry' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2StrictOrbitLinear.normalInjection_potentialVelocity_entry

/-- info: 'MAIS.Run2StrictOrbitLinear.orbitDifferential_potentialLie' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2StrictOrbitLinear.orbitDifferential_potentialLie

/-- info: 'MAIS.Run2StrictOrbitLinear.heightVelocity_ne_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2StrictOrbitLinear.heightVelocity_ne_zero

/-- info: 'MAIS.Run2StrictOrbitLinear.finrank_tangentParameters' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2StrictOrbitLinear.finrank_tangentParameters

/-- info: 'MAIS.Run2StrictOrbitLinear.nearby_finrank_range_strict' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2StrictOrbitLinear.nearby_finrank_range_strict
end
end
