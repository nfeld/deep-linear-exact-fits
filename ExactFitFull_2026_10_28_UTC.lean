#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActualAnnulusRadialOrder.finite_annulus_radial_trichotomy

/-- info: 'MAIS.ActualAnnulusRadialOrder.finite_annulus_series_trichotomy' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActualAnnulusRadialOrder.finite_annulus_series_trichotomy
