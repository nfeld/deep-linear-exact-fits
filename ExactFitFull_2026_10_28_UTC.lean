-- ==================== begin module O7.Run2BarcodeFastEnumerationComplete (formalization/O7/Run2BarcodeFastEnumerationComplete.lean) ====================
section

/-! The fast integer-slot generator is exhaustive: validity and the original
dimension equations bound the actual number of slots by the dimension sum.
An actual finite embedding then provides a padded assignment with exactly
the original endpoint multiplicities. This is a finite-search
correctness proof, not an assumed generator-completeness oracle. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
namespace MAIS.Run2BarcodeFastEnumerationComplete
open MAIS.Run2BarcodeEnumerationData MAIS.Run2BarcodeFastEnumerationData
variable {D M : ℕ} (h : Multiplicities D M)

def birthVertex (hv : Valid h) (s : Slot h) : Fin (D + 1) :=
  ⟨birth s, by have hd := s.1.2.isLt; have hb := hv s; unfold birth death at *; omega⟩

def birthSlot (hv : Valid h) (s : Slot h) :
    Σ v : Fin (D + 1), {t : Slot h // birth t ≤ v.val ∧ v.val < death t} :=
  ⟨birthVertex h hv s, ⟨s, le_rfl, hv s⟩⟩

/-- The label budget follows from validity and actual dimension equations;
it is not a further restriction imposed on the fast generator's output. -/
theorem card_slots_le_dimension_sum (hv : Valid h) :
    Fintype.card (Slot h) ≤ ∑ v : Fin (D + 1), vertexCount h v := by
  have hi : Function.Injective (birthSlot h hv) := by
    intro s t he
    exact congrArg (fun p : Σ v : Fin (D + 1),
      {t : Slot h // birth t ≤ v.val ∧ v.val < death t} => p.2.val) he
  simpa only [Fintype.card_sigma, vertexCount] using
    Fintype.card_le_of_injective (birthSlot h hv) hi

def slotFiberEquiv (p : IntervalKey D) : {s : Slot h // s.1 = p} ≃ Fin (h p).val where
  toFun s := by
    rcases s with ⟨⟨q, x⟩, hq⟩
    dsimp only at hq
    subst q
    exact x
  invFun x := ⟨⟨p, x⟩, rfl⟩
  left_inv := by
    rintro ⟨⟨q, x⟩, hq⟩
    dsimp only at hq
    subst q
    rfl
  right_inv _ := rfl

def indexEmbedding (hc : Fintype.card (Slot h) ≤ M) : Slot h ↪ Fin M where
  toFun s := ⟨(Fintype.equivFin (Slot h) s).val,
    lt_of_lt_of_le (Fintype.equivFin (Slot h) s).isLt hc⟩
  inj' s t he := by
    have hv : (Fintype.equivFin (Slot h) s).val = (Fintype.equivFin (Slot h) t).val :=
      congrArg (fun z : Fin M => z.val) he
    exact (Fintype.equivFin (Slot h)).injective (Fin.ext hv)

def assignmentWitness (hv : Valid h) (e : Slot h ↪ Fin M) : Assignment D M := fun i =>
  if hi : ∃ s, e s = i then some ⟨(Classical.choose hi).1, hv (Classical.choose hi)⟩ else none

theorem assignmentWitness_key_iff (hv : Valid h) (e : Slot h ↪ Fin M)
    (i : Fin M) (p : IntervalKey D) :
    Option.map Subtype.val (assignmentWitness h hv e i) = some p ↔
      ∃ s : Slot h, e s = i ∧ s.1 = p := by
  classical
  by_cases hi : ∃ s, e s = i
  · have he := Classical.choose_spec hi
    simp only [assignmentWitness, dite_eq_left hi, Option.map_some, Option.some.injEq]
    constructor
    · intro hp
      exact ⟨Classical.choose hi, he, hp⟩
    · rintro ⟨s, hs, hp⟩
      have hcs : Classical.choose hi = s := e.injective (he.trans hs.symm)
      simpa only [hcs] using hp
  · simp only [assignmentWitness, dite_eq_right hi, Option.map_none, reduceCtorEq, false_iff]
    rintro ⟨s, hs, _⟩
    exact hi ⟨s, hs⟩

/-- Every valid array with at most M labels is the exact histogram of an
actual M-slot assignment padded by None. -/
theorem exists_histogram_eq (hv : Valid h) (hc : Fintype.card (Slot h) ≤ M) :
    ∃ f : Assignment D M, histogram f = h := by
  classical
  let e := indexEmbedding h hc
  let f := assignmentWitness h hv e
  refine ⟨f, ?_⟩
  funext p
  apply Fin.ext
  change Fintype.card {i : Fin M // Option.map Subtype.val (f i) = some p} = (h p).val
  let map : {s : Slot h // s.1 = p} →
      {i : Fin M // Option.map Subtype.val (f i) = some p} := fun s =>
    ⟨e s.val, (assignmentWitness_key_iff h hv e _ _).mpr ⟨s.val, rfl, s.property⟩⟩
  have hm : Function.Bijective map := by
    constructor
    · intro s t he
      apply Subtype.ext
      exact e.injective (congrArg Subtype.val he)
    · intro i
      obtain ⟨s, hs, hp⟩ := (assignmentWitness_key_iff h hv e i.val p).mp i.property
      exact ⟨⟨s, hp⟩, Subtype.ext hs⟩
  calc
    _ = Fintype.card {s : Slot h // s.1 = p} :=
      (Fintype.card_congr (Equiv.ofBijective map hm)).symm
    _ = Fintype.card (Fin (h p).val) := Fintype.card_congr (slotFiberEquiv h p)
    _ = _ := Fintype.card_fin _

/-- The fast finite list equals the original exhaustive arithmetic list,
provided the slot budget contains the original total vertex dimension. -/
theorem fastCandidates_eq (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ)
    (hbudget : (∑ v, dims v) ≤ M) :
    fastCandidates (M := M) dims ranks = candidates (M := M) dims ranks := by
  classical
  ext h
  rw [mem_fastCandidates, mem_candidates]
  constructor
  · exact And.right
  · intro hf
    refine ⟨?_, hf⟩
    have hc : Fintype.card (Slot h) ≤ M := by
      calc
        _ ≤ ∑ v : Fin (D + 1), vertexCount h v := card_slots_le_dimension_sum h hf.1
        _ = ∑ v : Fin (D + 1), dims v := Finset.sum_congr rfl (fun v _ => hf.2.1 v)
        _ ≤ M := hbudget
    obtain ⟨f, hf⟩ := exists_histogram_eq h hf.1 hc
    exact Finset.mem_image.mpr ⟨f, Finset.mem_univ _, hf⟩

theorem fastBalancedCandidates_eq (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) (hbudget : (∑ v, dims v) ≤ M) :
    fastBalancedCandidates (M := M) dims ranks = balancedCandidates (M := M) dims ranks := by
  rw [fastBalancedCandidates, balancedCandidates, fastCandidates_eq dims ranks hbudget]

theorem fastOutputValues_eq (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) (hbudget : (∑ v, dims v) ≤ M) :
    fastOutputValues (M := M) dims ranks = outputValues (M := M) dims ranks := by
  rw [fastOutputValues, outputValues, fastBalancedCandidates_eq dims ranks hbudget]

theorem fastMinimum_eq (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) (hbudget : (∑ v, dims v) ≤ M) :
    fastMinimum (M := M) dims ranks = minimum (M := M) dims ranks := by
  rw [fastMinimum, minimum, fastOutputValues_eq dims ranks hbudget]

end MAIS.Run2BarcodeFastEnumerationComplete

