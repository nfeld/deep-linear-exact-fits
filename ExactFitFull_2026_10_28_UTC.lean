-- ==================== begin module O7.ActiveIntervalWeightedAction (formalization/O7/ActiveIntervalWeightedAction.lean) ====================
section

/-! Genuine exponential vertex gauge action on the complete actual interval
normal family. All higher path terms satisfy the resulting weight identity. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open scoped Matrix
namespace MAIS.ActiveIntervalWeightedAction
open MAIS.QuiverRealOrbit MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalEndpointRows MAIS.ActiveIntervalDirectElimination
open MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank

/-- A genuine invertible diagonal matrix, with its actual explicit inverse. -/
def diagonalExpUnit {I : Type*} [Fintype I] [DecidableEq I]
    (q : I → ℝ) (lam : ℝ) : (Matrix I I ℝ)ˣ where
  val := Matrix.diagonal (fun i => Real.exp (lam * q i))
  inv := Matrix.diagonal (fun i => Real.exp (-(lam * q i)))
  val_inv := by
    ext i j
    rw [Matrix.diagonal_mul_diagonal]
    simp only [Matrix.diagonal_apply, Matrix.one_apply]
    split_ifs <;> simp [← Real.exp_add]
  inv_val := by
    ext i j
    rw [Matrix.diagonal_mul_diagonal]
    simp only [Matrix.diagonal_apply, Matrix.one_apply]
    split_ifs <;> simp [← Real.exp_add]

/-- Literal diagonal sandwich entry formula with arbitrary supplied potentials. -/
theorem diagonalExpUnit_sandwich {I J : Type*} [Fintype I] [DecidableEq I]
    [Fintype J] [DecidableEq J] (qi : I → ℝ) (qj : J → ℝ) (lam : ℝ)
    (A : Matrix I J ℝ) (i : I) (j : J) :
    ((diagonalExpUnit qi lam : Matrix I I ℝ) * A *
      (↑((diagonalExpUnit qj lam)⁻¹) : Matrix J J ℝ)) i j =
      Real.exp (lam * (qi i - qj j)) * A i j := by
  change (Matrix.diagonal (fun i => Real.exp (lam * qi i)) * A *
    Matrix.diagonal (fun j => Real.exp (-(lam * qj j)))) i j = _
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul]
  rw [show lam * (qi i - qj j) = lam * qi i + -(lam * qj j) by ring, Real.exp_add]
  ring

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D+1)

/-- The actual exponential weighted action on every independent normal scalar. -/
def scaleExp (q : S → ℝ) (lam : ℝ) (t : NormalParams birth death) : NormalParams birth death :=
  fun p => Real.exp (lam * (q p.val.1 - q p.val.2)) * t p

omit [Fintype S] [DecidableEq S] in
@[simp]
theorem scaleExp_apply (q : S → ℝ) (lam : ℝ) (t : NormalParams birth death)
    (p : NormalIndex birth death) :
    scaleExp birth death q lam t p = Real.exp (lam * (q p.val.1 - q p.val.2)) * t p := rfl

omit [Fintype S] [DecidableEq S] in
@[simp]
theorem scaleExp_zero_time (q : S → ℝ) (t : NormalParams birth death) :
    scaleExp birth death q 0 t = t := by
  funext p
  simp only [scaleExp, zero_mul, Real.exp_zero, one_mul]

omit [Fintype S] [DecidableEq S] in
/-- The supplied potential gives an actual additive-parameter action. -/
theorem scaleExp_add (q : S → ℝ) (lam mu : ℝ) (t : NormalParams birth death) :
    scaleExp birth death q lam (scaleExp birth death q mu t) =
      scaleExp birth death q (lam+mu) t := by
  funext p
  simp only [scaleExp, add_mul, Real.exp_add]
  ring

/-- Every fixed dilation is a genuine continuous linear equivalence; its
inverse is the actual dilation at the negative parameter. -/
def scaleExpEquiv (q : S → ℝ) (lam : ℝ) :
    NormalParams birth death ≃L[ℝ] NormalParams birth death :=
  ({ toFun := scaleExp birth death q lam
     invFun := scaleExp birth death q (-lam)
     left_inv := by intro t; rw [scaleExp_add]; simp only [neg_add_cancel, scaleExp_zero_time]
     right_inv := by intro t; rw [scaleExp_add]; simp only [add_neg_cancel, scaleExp_zero_time]
     map_add' := by intro t u; funext p; simp only [scaleExp, Pi.add_apply]; ring
     map_smul' := by intro c t; funext p; simp only [scaleExp, Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; ring } :
      NormalParams birth death ≃ₗ[ℝ] NormalParams birth death).toContinuousLinearEquiv

omit [DecidableEq S] in
@[simp]
theorem scaleExpEquiv_apply (q : S → ℝ) (lam : ℝ) (t : NormalParams birth death) :
    scaleExpEquiv birth death q lam t = scaleExp birth death q lam t := rfl

omit [DecidableEq S] in
@[simp]
theorem scaleExpEquiv_symm_apply (q : S → ℝ) (lam : ℝ) (t : NormalParams birth death) :
    (scaleExpEquiv birth death q lam).symm t = scaleExp birth death q (-lam) t := rfl

/-- Actual diagonal matrix units at every changing active vertex space. -/
def gaugeExp (q : S → ℝ) (lam : ℝ) : Gauge (Index D birth death) := fun v =>
  diagonalExpUnit (fun s : Index D birth death v => q s.val) lam

/-- The actual gauge action on every literal original arrow entry. -/
theorem gaugeExp_smul_entry (q : S → ℝ) (lam : ℝ)
    (A : Rep (Index D birth death)) (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    (gaugeExp D birth death q lam • A) e r s =
      Real.exp (lam * (q r.val - q s.val)) * A e r s := by
  rw [gauge_smul_apply]
  exact diagonalExpUnit_sandwich _ _ lam (A e) r s

omit [Fintype S] [DecidableEq S] in
/-- The physical normal injection has the literal exponential edge weights. -/
theorem normalInjection_scaleExp_entry (q : S → ℝ) (lam : ℝ)
    (t : NormalParams birth death) (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    MAIS.ActiveIntervalNormal.normalInjection D birth death hD (scaleExp birth death q lam t) e r s =
      Real.exp (lam * (q r.val - q s.val)) *
        MAIS.ActiveIntervalNormal.normalInjection D birth death hD t e r s := by
  simp only [MAIS.ActiveIntervalNormal.normalInjection_apply]
  by_cases hp : Linked birth death r.val s.val
  · simp only [dite_eq_left hp, scaleExp_apply]
    ring
  · simp only [dite_eq_right hp, mul_zero]

omit [Fintype S] in
/-- The base interval arrows are fixed by the actual vertex potential gauge. -/
theorem intervalRep_weight_entry (q : S → ℝ) (lam : ℝ) (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    intervalRep D birth death e r s =
      Real.exp (lam * (q r.val - q s.val)) * intervalRep D birth death e r s := by
  by_cases hrs : r.val = s.val
  · have hq : q r.val = q s.val := congrArg q hrs
    simp only [intervalRep, ite_eq_left hrs, hq, sub_self, mul_zero, Real.exp_zero, mul_one]
  · simp only [intervalRep, ite_eq_right hrs, mul_zero]

omit [Fintype S] in
/-- Literal entry equivariance of the COMPLETE affine normal family. -/
theorem normalFamily_scaleExp_entry (q : S → ℝ) (lam : ℝ)
    (t : NormalParams birth death) (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    normalFamily D birth death hD (scaleExp birth death q lam t) e r s =
      Real.exp (lam * (q r.val - q s.val)) * normalFamily D birth death hD t e r s := by
  simp only [normalFamily, Pi.add_apply, Matrix.add_apply]
  rw [normalInjection_scaleExp_entry, mul_add]
  exact congrArg (fun x => x + Real.exp (lam * (q r.val - q s.val)) *
    MAIS.ActiveIntervalNormal.normalInjection D birth death hD t e r s)
    (intervalRep_weight_entry D birth death q lam e r s)

/-- A genuine gauge identity on the actual changing rectangular matrix spaces. -/
theorem normalFamily_scaleExp (q : S → ℝ) (lam : ℝ) (t : NormalParams birth death) :
    normalFamily D birth death hD (scaleExp birth death q lam t) =
      gaugeExp D birth death q lam • normalFamily D birth death hD t := by
  funext e r s
  rw [gaugeExp_smul_entry]
  exact normalFamily_scaleExp_entry D birth death hD q lam t e r s

/-- Every actual subpath transforms by its two actual endpoint diagonal units. -/
theorem pathMatrix_scaleExp (q : S → ℝ) (lam : ℝ) (t : NormalParams birth death)
    (i j : Fin (D+1)) (hij : i ≤ j) :
    pathMatrix (normalFamily D birth death hD (scaleExp birth death q lam t)) i j hij =
      (↑(gaugeExp D birth death q lam j) : Matrix (Index D birth death j) (Index D birth death j) ℝ) *
        pathMatrix (normalFamily D birth death hD t) i j hij *
      (↑((gaugeExp D birth death q lam i)⁻¹) : Matrix (Index D birth death i) (Index D birth death i) ℝ) := by
  rw [normalFamily_scaleExp, pathMatrix_gauge]

/-- Exact weight of EACH actual full subpath entry, including every path degree. -/
theorem pathMatrix_scaleExp_entry (q : S → ℝ) (lam : ℝ) (t : NormalParams birth death)
    (i j : Fin (D+1)) (hij : i ≤ j)
    (r : Index D birth death j) (s : Index D birth death i) :
    pathMatrix (normalFamily D birth death hD (scaleExp birth death q lam t)) i j hij r s =
      Real.exp (lam * (q r.val - q s.val)) *
        pathMatrix (normalFamily D birth death hD t) i j hij r s := by
  rw [pathMatrix_scaleExp]
  exact diagonalExpUnit_sandwich _ _ lam _ r s

/-- With potential0 at actual input slots and potential1 at actual output
slots, the full COMPLETE path map has exact weight1, globally in all parameters. -/
theorem fullProduct_scaleExp (q : S → ℝ) (lam : ℝ) (t : NormalParams birth death)
    (hin : ∀ s, birth s = 0 → q s = 0)
    (hout : ∀ s, death s = D+1 → q s = 1) :
    fullProduct D birth death hD (scaleExp birth death q lam t) =
      Real.exp lam • fullProduct D birth death hD t := by
  ext r s
  have hs : birth s.val = 0 := by have h := s.property.1; change birth s.val ≤ 0 at h; omega
  have hr : death r.val = D+1 := by
    have h := r.property.2
    have hh := hD r.val
    change D < death r.val at h
    omega
  have h := pathMatrix_scaleExp_entry D birth death hD q lam t 0 (Fin.last D)
    (by exact Nat.zero_le D) r s
  simpa only [fullProduct, hin s.val hs, hout r.val hr, sub_zero, mul_one,
    Matrix.smul_apply, smul_eq_mul] using h

end MAIS.ActiveIntervalWeightedAction
end

