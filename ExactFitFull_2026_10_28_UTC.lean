info: 'MAIS.WeightedRadialIntegral.integrand_eq_pullback' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedRadialIntegral.integrand_eq_pullback

