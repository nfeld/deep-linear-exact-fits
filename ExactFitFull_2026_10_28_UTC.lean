  have hlow : 0 < low := lt_min (mul_pos hlo ha) (mul_pos hhi hC0)
  have hlowhigh : low ≤ high := min_le_right _ _
  have he0 : 0 < e0 := lt_min hea hec
  have he0exp : e0 < Real.exp (-1) :=
    (min_le_left ea ec).trans_lt heaexp
