-- ==================== begin module O7.Run2GeometricSpectatorSplit (formalization/O7/Run2GeometricSpectatorSplit.lean) ====================
section

/-! An actual finite-dimensional linear embedding supplies genuine free
spectator coordinates, without an assumed dimension inequality. -/
set_option autoImplicit false
noncomputable section
namespace MAIS.Run2GeometricSpectatorSplit
variable {H K : Type*}
  [NormedAddCommGroup H] [NormedSpace ℝ H] [FiniteDimensional ℝ H]
  [NormedAddCommGroup K] [NormedSpace ℝ K] [FiniteDimensional ℝ K]

def extra (f : H →L[ℝ] K) : Submodule ℝ K :=
  Classical.choose (f.toLinearMap.range.exists_isCompl)

omit [FiniteDimensional ℝ H] [FiniteDimensional ℝ K] in
theorem extra_isCompl (f : H →L[ℝ] K) : IsCompl f.toLinearMap.range (extra f) :=
  Classical.choose_spec (f.toLinearMap.range.exists_isCompl)

def split (f : H →L[ℝ] K) (hf : Function.Injective f) :
    K ≃L[ℝ] H × extra f :=
  ((f.toLinearMap.range.prodEquivOfIsCompl (extra f) (extra_isCompl f)).symm.trans
    ((LinearEquiv.ofInjective f.toLinearMap hf).symm.prodCongr
      (LinearEquiv.refl ℝ (extra f)))).toContinuousLinearEquiv

omit [FiniteDimensional ℝ H] in
@[simp] theorem split_zero (f : H →L[ℝ] K) (hf : Function.Injective f) :
    split f hf 0 = 0 := map_zero _

omit [FiniteDimensional ℝ H] in
theorem finrank_le_of_embedding (f : H →L[ℝ] K) (hf : Function.Injective f) :
    Module.finrank ℝ H ≤ Module.finrank ℝ K :=
  LinearMap.finrank_le_finrank_of_injective hf
end MAIS.Run2GeometricSpectatorSplit

/-- info: 'MAIS.Run2GeometricSpectatorSplit.extra_isCompl' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricSpectatorSplit.extra_isCompl

/-- info: 'MAIS.Run2GeometricSpectatorSplit.split_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricSpectatorSplit.split_zero

/-- info: 'MAIS.Run2GeometricSpectatorSplit.finrank_le_of_embedding' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricSpectatorSplit.finrank_le_of_embedding

/-- info: 'MAIS.Run2GeometricSpectatorSplit.split' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricSpectatorSplit.split
end
end
