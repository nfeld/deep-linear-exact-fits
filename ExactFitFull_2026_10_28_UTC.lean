-- ==================== begin module O7.IntervalBlockRank (formalization/O7/IntervalBlockRank.lean) ====================
section

/-! Actual ranks for the finite scalar incidence matrices obtained between two
interval summands.  The source/target interval endpoints are half open. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace MAIS.IntervalBlockRank

open scoped Matrix
open MAIS.IntervalIncidence

variable (K : Type*) [Field K]

/-- Rows denote physical arrow output vertices r+i, columns denote physical
    overlap vertices c+j.  This is the literal scalar difference matrix. -/
def shiftedDifference (r c nr nc : ℕ) : Matrix (Fin nr) (Fin nc) K := fun i j =>
  (if c + j.val = r + i.val then 1 else 0) -
    (if c + j.val + 1 = r + i.val then 1 else 0)

theorem shifted_boundary (c n : ℕ) :
    shiftedDifference K c c (n + 1) n = boundaryMatrix K n := by
  ext i j
  have hp : c + j.val = c + i.val ↔ i = j.castSucc := by
    constructor
    · intro h; apply Fin.ext; simp; omega
    · intro h; have := congrArg Fin.val h; simp at this; omega
  have hn : c + j.val + 1 = c + i.val ↔ i = j.succ := by
    constructor
    · intro h; apply Fin.ext; simp; omega
    · intro h; have := congrArg Fin.val h; simp at this; omega
  simp only [shiftedDifference, hp, hn, boundaryMatrix]

theorem shifted_lower (c n : ℕ) :
    shiftedDifference K c c n n = (boundaryMatrix K n).submatrix Fin.castSucc id := by
  ext i j
  have hp : c + j.val = c + i.val ↔ i.castSucc = j.castSucc := by
    constructor
    · intro h; apply Fin.ext; simp; omega
    · intro h; have := congrArg Fin.val h; simp at this; omega
  have hn : c + j.val + 1 = c + i.val ↔ i.castSucc = j.succ := by
    constructor
    · intro h; apply Fin.ext; simp; omega
    · intro h; have := congrArg Fin.val h; simp at this; omega
  simp only [shiftedDifference, hp, hn, boundaryMatrix, Matrix.submatrix_apply, id_eq]

theorem shifted_upper (c n : ℕ) :
    (shiftedDifference K (c + 1) c n n).IsUpperTriangular := by
  intro i j hij
  have h : j.val < i.val := hij
  have hp : c + j.val ≠ c + 1 + i.val := by omega
  have hn : c + j.val + 1 ≠ c + 1 + i.val := by omega
  simp [shiftedDifference, hp, hn]

@[simp]
theorem shifted_upper_diag (c n : ℕ) (i : Fin n) :
    shiftedDifference K (c + 1) c n n i i = -1 := by
  have hp : c + i.val ≠ c + 1 + i.val := by omega
  have hn : c + i.val + 1 = c + 1 + i.val := by omega
  simp only [shiftedDifference, ite_eq_right hp, ite_eq_left hn, zero_sub]

theorem shifted_coboundary (c n : ℕ) :
    shiftedDifference K (c + 1) c n (n + 1) = -(boundaryMatrix K n).transpose := by
  ext i j
  have hp : c + j.val = c + 1 + i.val ↔ j = i.succ := by
    constructor
    · intro h; apply Fin.ext; simp; omega
    · intro h; have := congrArg Fin.val h; simp at this; omega
  have hn : c + j.val + 1 = c + 1 + i.val ↔ j = i.castSucc := by
    constructor
    · intro h; apply Fin.ext; simp; omega
    · intro h; have := congrArg Fin.val h; simp at this; omega
  simp [shiftedDifference, boundaryMatrix, Matrix.transpose_apply, hp, hn]

@[simp]
theorem shifted_lower_rank (c n : ℕ) : (shiftedDifference K c c n n).rank = n := by
  rw [shifted_lower]
  simpa using Matrix.rank_of_det_ne_zero
    (A := (boundaryMatrix K n).submatrix Fin.castSucc id)
    (by rw [boundary_minor_det]; exact one_ne_zero)

@[simp]
theorem shifted_upper_rank (c n : ℕ) :
    (shiftedDifference K (c + 1) c n n).rank = n := by
  have hd : (shiftedDifference K (c + 1) c n n).det ≠ 0 := by
    rw [Matrix.det_of_isUpperTriangular (shifted_upper K c n)]
    apply Finset.prod_ne_zero_iff.mpr
    intro i _
    simpa only [Matrix.diag_apply, shifted_upper_diag, neg_ne_zero] using (one_ne_zero : (1 : K) ≠ 0)
  simpa using Matrix.rank_of_det_ne_zero hd

@[simp]
theorem shifted_boundary_rank (c n : ℕ) :
    (shiftedDifference K c c (n + 1) n).rank = n := by
  rw [shifted_boundary, boundary_rank]

@[simp]
theorem shifted_coboundary_rank (c n : ℕ) :
    (shiftedDifference K (c + 1) c n (n + 1)).rank = n := by
  rw [shifted_coboundary]
  simpa only [neg_one_smul, Matrix.rank_transpose, boundary_rank] using
    Matrix.rank_smul_of_mem_nonZeroDivisors (c := (-1 : K)) (boundaryMatrix K n).transpose
      (mem_nonZeroDivisors_of_ne_zero (neg_ne_zero.mpr one_ne_zero))

@[simp]
theorem shifted_empty_rank (r c : ℕ) : (shiftedDifference K r c 0 0).rank = 0 := by
  have h := Matrix.rank_le_card_width (shiftedDifference K r c 0 0)
  simpa using Nat.eq_zero_of_le_zero h

/-- Actual matrix rank, bundled as a Nat-valued function so that rewriting
    its dimension arguments does not create dependent Fintype casts. -/
noncomputable def shiftedRank (r c nr nc : ℕ) : ℕ :=
  (shiftedDifference K r c nr nc).rank

@[simp] theorem shiftedRank_lower (c n : ℕ) : shiftedRank K c c n n = n :=
  shifted_lower_rank K c n
@[simp] theorem shiftedRank_upper (c n : ℕ) : shiftedRank K (c + 1) c n n = n :=
  shifted_upper_rank K c n
@[simp] theorem shiftedRank_boundary (c n : ℕ) : shiftedRank K c c (n + 1) n = n :=
  shifted_boundary_rank K c n
@[simp] theorem shiftedRank_coboundary (c n : ℕ) : shiftedRank K (c + 1) c n (n + 1) = n :=
  shifted_coboundary_rank K c n
@[simp] theorem shiftedRank_empty (r c : ℕ) : shiftedRank K r c 0 0 = 0 :=
  shifted_empty_rank K r c

/-- Four-corner overlap vertex and arrow counts are finite matrix dimensions. -/
abbrev vertexCount (a b c d : ℕ) : ℕ := min b d - max a c
abbrev arrowCount (a b c d : ℕ) : ℕ := min (b + 1) d - max (a + 1) c

/-- The literal finite matrix of scalar interval cochain equations. -/
def intervalDifferential (a b c d : ℕ) :
    Matrix (Fin (arrowCount a b c d)) (Fin (vertexCount a b c d)) K :=
  shiftedDifference K (max (a + 1) c) (max a c)
    (arrowCount a b c d) (vertexCount a b c d)

/-- Its actual rank is the smaller of its two actual coordinate dimensions. -/
theorem intervalDifferential_rank_min (a b c d : ℕ)
    (hab : a < b) (_hcd : c < d) :
    (intervalDifferential K a b c d).rank =
      min (vertexCount a b c d) (arrowCount a b c d) := by
  change shiftedRank K (max (a + 1) c) (max a c)
    (min (b + 1) d - max (a + 1) c) (min b d - max a c) =
      min (min b d - max a c) (min (b + 1) d - max (a + 1) c)
  by_cases hac : a < c
  · have ha1 : a + 1 ≤ c := hac
    by_cases hbd : b < d
    · have hb1 : b + 1 ≤ d := hbd
      by_cases hcb : c ≤ b
      · have hn : b + 1 - c = (b - c) + 1 := by omega
        simp only [max_eq_right hac.le, max_eq_right ha1, min_eq_left hbd.le, min_eq_left hb1]
        rw [hn, shiftedRank_boundary, min_eq_left (by omega)]
      · have hn0 : b - c = 0 := by omega
        have hn1 : b + 1 - c = 0 := by omega
        simp only [max_eq_right hac.le, max_eq_right ha1, min_eq_left hbd.le, min_eq_left hb1,
          hn0, hn1, shiftedRank_empty, min_self]
    · have hdb : d ≤ b := by omega
      simp only [max_eq_right hac.le, max_eq_right ha1, min_eq_right hdb,
        min_eq_right (show d ≤ b + 1 by omega), shiftedRank_lower, min_self]
  · have hca : c ≤ a := by omega
    have hca1 : c ≤ a + 1 := by omega
    by_cases hbd : b < d
    · have hb1 : b + 1 ≤ d := hbd
      have hn : b + 1 - (a + 1) = b - a := by omega
      simp only [max_eq_left hca, max_eq_left hca1, min_eq_left hbd.le, min_eq_left hb1,
        hn, shiftedRank_upper, min_self]
    · have hdb : d ≤ b := by omega
      by_cases had : a < d
      · have hn : d - a = (d - (a + 1)) + 1 := by omega
        simp only [max_eq_left hca, max_eq_left hca1, min_eq_right hdb,
          min_eq_right (show d ≤ b + 1 by omega)]
        rw [hn, shiftedRank_coboundary, min_eq_right (by omega)]
      · have hn0 : d - a = 0 := by omega
        have hn1 : d - (a + 1) = 0 := by omega
        simp only [max_eq_left hca, max_eq_left hca1, min_eq_right hdb,
          min_eq_right (show d ≤ b + 1 by omega), hn0, hn1,
          shiftedRank_empty, min_self]

/-- The literal scalar cochain cokernel has the exact linked-interval
    Ext indicator, including the adjacent case c=b. -/
theorem interval_cokernel_dimension (a b c d : ℕ) (hab : a < b) (hcd : c < d) :
    arrowCount a b c d - (intervalDifferential K a b c d).rank =
      if a < c ∧ c ≤ b ∧ b < d then 1 else 0 := by
  rw [intervalDifferential_rank_min K a b c d hab hcd]
  unfold vertexCount arrowCount
  split_ifs <;> omega

/-- The actual scalar cochain kernel has the exact Hom indicator. -/
theorem interval_kernel_dimension (a b c d : ℕ) (hab : a < b) (hcd : c < d) :
    vertexCount a b c d - (intervalDifferential K a b c d).rank =
      if c ≤ a ∧ a < d ∧ d ≤ b then 1 else 0 := by
  rw [intervalDifferential_rank_min K a b c d hab hcd]
  unfold vertexCount arrowCount
  split_ifs <;> omega

/-- Actual finite-dimensional kernel of the literal scalar cochain matrix. -/
theorem finrank_interval_kernel (a b c d : ℕ) (hab : a < b) (hcd : c < d) :
    Module.finrank K (Matrix.toLin' (intervalDifferential K a b c d)).ker =
      if c ≤ a ∧ a < d ∧ d ≤ b then 1 else 0 := by
  have hdim := (Matrix.toLin' (intervalDifferential K a b c d)).finrank_range_add_finrank_ker
  change (intervalDifferential K a b c d).rank +
    Module.finrank K (Matrix.toLin' (intervalDifferential K a b c d)).ker =
      Module.finrank K (Fin (vertexCount a b c d) → K) at hdim
  simp only [Module.finrank_pi, Fintype.card_fin] at hdim
  have hnum := interval_kernel_dimension K a b c d hab hcd
  omega

/-- Actual quotient by the actual matrix image, rather than a declared formula. -/
theorem finrank_interval_cokernel (a b c d : ℕ) (hab : a < b) (hcd : c < d) :
    Module.finrank K ((Fin (arrowCount a b c d) → K) ⧸
      (Matrix.toLin' (intervalDifferential K a b c d)).range) =
      if a < c ∧ c ≤ b ∧ b < d then 1 else 0 := by
  have hdim := Submodule.finrank_quotient_add_finrank
    (Matrix.toLin' (intervalDifferential K a b c d)).range
  change Module.finrank K ((Fin (arrowCount a b c d) → K) ⧸
      (Matrix.toLin' (intervalDifferential K a b c d)).range) +
    (intervalDifferential K a b c d).rank =
      Module.finrank K (Fin (arrowCount a b c d) → K) at hdim
  simp only [Module.finrank_pi, Fintype.card_fin] at hdim
  have hnum := interval_cokernel_dimension K a b c d hab hcd
  omega

end MAIS.IntervalBlockRank
end
-- ==================== end module O7.IntervalBlockRank ====================

-- ==================== begin module O7.QuiverRealOrbit (formalization/O7/QuiverRealOrbit.lean) ====================
section

/-!
The actual real gauge-group action on a finite chain of rectangular matrices.
Every gauge is a tuple of genuine matrix units.  The topology is the ordinary
finite-dimensional matrix topology.  Closure composition is proved for actual
Mathlib group-action orbits and ordinary topological closures.
-/
set_option autoImplicit false

namespace MAIS.QuiverRealOrbit

open scoped Matrix

variable {D : ℕ}

abbrev Rep (ι : Fin (D + 1) → Type*) :=
  (e : Fin D) → Matrix (ι e.succ) (ι e.castSucc) ℝ

abbrev Gauge (ι : Fin (D + 1) → Type*)
    [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)] :=
  (v : Fin (D + 1)) → (Matrix (ι v) (ι v) ℝ)ˣ

variable (ι : Fin (D + 1) → Type*)
variable [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

def gaugeAct (g : Gauge ι) (A : Rep ι) : Rep ι := fun e =>
  (↑(g e.succ) : Matrix (ι e.succ) (ι e.succ) ℝ) * A e *
    (↑((g e.castSucc)⁻¹) : Matrix (ι e.castSucc) (ι e.castSucc) ℝ)

instance gaugeMulAction : MulAction (Gauge ι) (Rep ι) where
  smul := gaugeAct ι
  one_smul A := by
    change gaugeAct ι 1 A = A
    funext e
    simp [gaugeAct]
  mul_smul g h A := by
    change gaugeAct ι (g * h) A = gaugeAct ι g (gaugeAct ι h A)
    funext e
    simp [gaugeAct, mul_inv_rev, Matrix.mul_assoc]

@[simp]
lemma gauge_smul_apply (g : Gauge ι) (A : Rep ι) (e : Fin D) :
    (g • A) e = (↑(g e.succ) : Matrix (ι e.succ) (ι e.succ) ℝ) * A e *
      (↑((g e.castSucc)⁻¹) : Matrix (ι e.castSucc) (ι e.castSucc) ℝ) := rfl

/-- A fixed real change of basis acts continuously on the actual matrix representation space. -/
instance gaugeContinuousConstSMul : ContinuousConstSMul (Gauge ι) (Rep ι) where
  continuous_const_smul g := by
    apply continuous_pi
    intro e
    exact (continuous_const.matrix_mul (continuous_apply e)).matrix_mul continuous_const

/-- Each real change of basis is an actual homeomorphism of the matrix representation space. -/
noncomputable def gaugeHomeomorph (g : Gauge ι) : Rep ι ≃ₜ Rep ι := Homeomorph.smul g

section GeneralClosure

variable {G X : Type*} [Monoid G] [MulAction G X] [TopologicalSpace X]
variable [ContinuousConstSMul G X]

/-- Orbit-closure containment composes for actual continuous monoid actions. -/
theorem closure_orbit_trans {x y z : X}
    (hxy : x ∈ closure (MulAction.orbit G y))
    (hyz : y ∈ closure (MulAction.orbit G z)) :
    x ∈ closure (MulAction.orbit G z) := by
  have horbit : MulAction.orbit G y ⊆ closure (MulAction.orbit G z) := by
    intro a ha
    obtain ⟨g, rfl⟩ := MulAction.mem_orbit_iff.mp ha
    exact map_mem_closure (continuous_const_smul g) hyz
      (fun b hb => MulAction.mem_orbit_of_mem_orbit g hb)
  have hcl := closure_mono horbit
  simpa only [closure_closure] using hcl hxy

/-- A genuine finite relation path of actual orbit-closure inclusions composes to one
    actual orbit-closure inclusion. -/
theorem closure_orbit_of_relation_path {T : Type*} (R : T → T → Prop) (f : T → X)
    (hstep : ∀ a b, R a b → f a ∈ closure (MulAction.orbit G (f b)))
    {a b : T} (hpath : Relation.ReflTransGen R a b) :
    f a ∈ closure (MulAction.orbit G (f b)) := by
  induction hpath with
  | refl => exact subset_closure (MulAction.mem_orbit_self _)
  | @tail b c hpath hbc ih =>
    exact closure_orbit_trans ih (hstep b c hbc)

end GeneralClosure

/-- Composition specialized to the actual finite real quiver gauge group and Euclidean topology. -/
theorem quiver_orbit_closure_trans {A B C : Rep ι}
    (hAB : A ∈ closure (MulAction.orbit (Gauge ι) B))
    (hBC : B ∈ closure (MulAction.orbit (Gauge ι) C)) :
    A ∈ closure (MulAction.orbit (Gauge ι) C) := closure_orbit_trans hAB hBC

end MAIS.QuiverRealOrbit

/-- info: 'MAIS.QuiverRealOrbit.quiver_orbit_closure_trans' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverRealOrbit.quiver_orbit_closure_trans
end
-- ==================== end module O7.QuiverRealOrbit ====================

-- ==================== begin module O7.OrbitSliceLinear (formalization/O7/OrbitSliceLinear.lean) ====================
section

/-!
The actual orbit differential on finite real chain-matrix entry spaces, and
honest linear complements for an ambient normal-slice chart.  The complements
are subspaces of the literal entry spaces, not a model invariant.
-/
set_option autoImplicit false

namespace MAIS.OrbitSliceLinear

open MAIS.QuiverRealOrbit
open scoped Matrix Matrix.Norms.Frobenius

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
variable [∀ v, Fintype (ι v)]

abbrev Lie := (v : Fin (D + 1)) → Matrix (ι v) (ι v) ℝ

/-- The genuine derivative of change of basis, entry by entry. -/
def orbitDifferential (A : Rep ι) : Lie ι →ₗ[ℝ] Rep ι where
  toFun X e := X e.succ * A e - A e * X e.castSucc
  map_add' X Y := by
    funext e
    simp only [Pi.add_apply, Matrix.add_mul, Matrix.mul_add]
    abel
  map_smul' r X := by
    funext e
    simp only [Pi.smul_apply, Matrix.smul_mul, Matrix.mul_smul, smul_sub, RingHom.id_apply]

@[simp]
theorem orbitDifferential_apply (A : Rep ι) (X : Lie ι) (e : Fin D) :
    orbitDifferential ι A X e = X e.succ * A e - A e * X e.castSucc := rfl

/-- Its kernel is exactly the actual endomorphism space of the representation. -/
theorem mem_ker_orbitDifferential_iff (A : Rep ι) (X : Lie ι) :
    X ∈ (orbitDifferential ι A).ker ↔
      ∀ e : Fin D, X e.succ * A e = A e * X e.castSucc := by
  simp only [LinearMap.mem_ker, funext_iff, orbitDifferential_apply,
    Pi.zero_apply, sub_eq_zero]

/-- A complement to the stabilizer directions, inside the actual gauge Lie algebra. -/
noncomputable def orbitDirections (A : Rep ι) : Submodule ℝ (Lie ι) :=
  Classical.choose (Submodule.exists_isCompl (orbitDifferential ι A).ker)

theorem orbitDirections_isCompl (A : Rep ι) :
    IsCompl (orbitDirections ι A) (orbitDifferential ι A).ker :=
  (Classical.choose_spec (Submodule.exists_isCompl (orbitDifferential ι A).ker)).symm

/-- A genuine linear normal space in the actual ambient arrow-entry space. -/
noncomputable def normalSpace (A : Rep ι) : Submodule ℝ (Rep ι) :=
  Classical.choose (Submodule.exists_isCompl (orbitDifferential ι A).range)

theorem normalSpace_isCompl (A : Rep ι) :
    IsCompl (orbitDifferential ι A).range (normalSpace ι A) :=
  Classical.choose_spec (Submodule.exists_isCompl (orbitDifferential ι A).range)

/-- For any actual chosen complements, the orbit directions plus normal
    directions identify with the entire ambient entry space. -/
noncomputable def sliceDerivativeEquiv (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (hH : IsCompl H (orbitDifferential ι A).ker)
    (hN : IsCompl (orbitDifferential ι A).range N) :
    (H × N) ≃L[ℝ] Rep ι :=
  ((LinearEquiv.prodCongr ((orbitDifferential ι A).kerComplementEquivRange hH)
      (LinearEquiv.refl ℝ N)).trans
    ((orbitDifferential ι A).range.prodEquivOfIsCompl N hN)).toContinuousLinearEquiv

@[simp]
theorem sliceDerivativeEquiv_apply (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (hH : IsCompl H (orbitDifferential ι A).ker)
    (hN : IsCompl (orbitDifferential ι A).range N) (p : H × N) :
    sliceDerivativeEquiv ι A H N hH hN p =
      orbitDifferential ι A (p.1 : Lie ι) + (p.2 : Rep ι) := rfl

/-- The dimension of a genuine linear normal space equals the dimension of the
    cokernel of the actual orbit derivative. -/
theorem finrank_normalSpace (A : Rep ι) :
    Module.finrank ℝ (normalSpace ι A) +
      Module.finrank ℝ (orbitDifferential ι A).range = Module.finrank ℝ (Rep ι) := by
  have h := Submodule.finrank_add_eq_of_isCompl (normalSpace_isCompl ι A)
  omega

end MAIS.OrbitSliceLinear
end
-- ==================== end module O7.OrbitSliceLinear ====================

-- ==================== begin module O7.IntervalBlockDifferential (formalization/O7/IntervalBlockDifferential.lean) ====================
section

/-! The finite scalar interval difference matrix is linked to literal entries
of the actual matrix-chain orbit differential, not assumed as an invariant. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000

namespace MAIS.IntervalBlockDifferential

open MAIS.IntervalBlockRank MAIS.OrbitSliceLinear MAIS.QuiverRealOrbit
open scoped Matrix

/-- Extend actual interval-coordinate values to physical integer vertices,
    with zero values away from their finite coordinate support. -/
def physicalValue {K : Type*} [Field K] (c n : ℕ) (x : Fin n → K) (v : ℕ) : K :=
  ∑ j, if c + j.val = v then x j else 0

@[simp]
theorem physicalValue_own {K : Type*} [Field K] (c n : ℕ) (x : Fin n → K) (j : Fin n) :
    physicalValue c n x (c + j.val) = x j := by
  simp [physicalValue, ← Fin.ext_iff]

/-- The literal finite matrix product is a difference of two physical values. -/
theorem shiftedDifference_mulVec {K : Type*} [Field K]
    (r c nr nc : ℕ) (hr : 0 < r) (x : Fin nc → K) (i : Fin nr) :
    (shiftedDifference K r c nr nc).mulVec x i =
      physicalValue c nc x (r + i.val) - physicalValue c nc x (r + i.val - 1) := by
  change (∑ j, shiftedDifference K r c nr nc i j * x j) = _
  simp only [shiftedDifference, sub_mul, ite_mul, one_mul, zero_mul, Finset.sum_sub_distrib]
  congr 1
  apply Finset.sum_congr rfl
  intro j _
  have h : c + j.val + 1 = r + i.val ↔ c + j.val = r + i.val - 1 := by omega
  simp only [h]

/-- Every finite overlap vertex is physically active in both intervals. -/
theorem overlap_vertex_active (a b c d : ℕ) (j : Fin (vertexCount a b c d)) :
    a ≤ max a c + j.val ∧ max a c + j.val < b ∧
      c ≤ max a c + j.val ∧ max a c + j.val < d := by
  have hj := j.isLt
  dsimp [vertexCount] at hj
  omega

/-- Physical extension vanishes at a vertex outside the actual overlap. -/
theorem physicalValue_zero_of_not_active {K : Type*} [Field K]
    (a b c d : ℕ) (x : Fin (vertexCount a b c d) → K) (v : ℕ)
    (hv : ¬(a ≤ v ∧ v < b ∧ c ≤ v ∧ v < d)) :
    physicalValue (max a c) (vertexCount a b c d) x v = 0 := by
  unfold physicalValue
  apply Finset.sum_eq_zero
  intro j _
  have hne : max a c + j.val ≠ v := by
    intro h
    exact hv (h ▸ overlap_vertex_active a b c d j)
  simp only [ite_eq_right hne]

/-- An actual two-interval chain, with literal diagonal arrow matrices.  The
    surrounding Fin 2 spaces are used only to expose the physical matrix entry. -/
def intervalRep (D a b c d : ℕ) : Rep (fun _ : Fin (D + 1) => Fin 2) :=
  fun e => Matrix.diagonal ![if a ≤ e.val ∧ e.val + 1 < b then 1 else 0,
    if c ≤ e.val ∧ e.val + 1 < d then 1 else 0]

/-- Actual Lie-algebra entries supported on the source-to-target interval block. -/
noncomputable def vertexInjection (D a b c d : ℕ)
    (x : Fin (vertexCount a b c d) → ℝ) : Lie (fun _ : Fin (D + 1) => Fin 2) :=
  fun v => !![0,0; physicalValue (max a c) (vertexCount a b c d) x v.val,0]

/-- Direct calculation of the actual orbit derivative's physical lower entry. -/
theorem actual_orbitDifferential_lower (D a b c d : ℕ)
    (x : Fin (vertexCount a b c d) → ℝ) (e : Fin D) :
    orbitDifferential (fun _ : Fin (D + 1) => Fin 2) (intervalRep D a b c d)
        (vertexInjection D a b c d x) e 1 0 =
      physicalValue (max a c) (vertexCount a b c d) x (e.val + 1) *
        (if a ≤ e.val ∧ e.val + 1 < b then 1 else 0) -
      (if c ≤ e.val ∧ e.val + 1 < d then 1 else 0) *
        physicalValue (max a c) (vertexCount a b c d) x e.val := by
  change (∑ k : Fin 2, vertexInjection D a b c d x e.succ 1 k * intervalRep D a b c d e k 0) -
    (∑ k : Fin 2, intervalRep D a b c d e 1 k * vertexInjection D a b c d x e.castSucc k 0) = _
  simp [intervalRep, vertexInjection, Matrix.diagonal_apply]

/-- The actual physical arrow corresponding to a scalar row coordinate.
    Its existence follows from the target interval's actual depth bound. -/
def physicalArrow (D a b c d : ℕ) (hdD : d ≤ D + 1)
    (i : Fin (arrowCount a b c d)) : Fin D :=
  ⟨max (a + 1) c + i.val - 1, by
    have hi := i.isLt
    dsimp [arrowCount] at hi
    omega⟩

theorem physicalArrow_properties (D a b c d : ℕ) (hdD : d ≤ D + 1)
    (i : Fin (arrowCount a b c d)) :
    a ≤ (physicalArrow D a b c d hdD i).val ∧
      (physicalArrow D a b c d hdD i).val < b ∧
      c ≤ (physicalArrow D a b c d hdD i).val + 1 ∧
      (physicalArrow D a b c d hdD i).val + 1 < d ∧
      (physicalArrow D a b c d hdD i).val + 1 = max (a + 1) c + i.val := by
  have hi := i.isLt
  dsimp [arrowCount] at hi
  dsimp [physicalArrow]
  omega

/-- The literal finite cochain matrix is proved to equal a block of the actual
    orbit derivative, on actual physical arrows. -/
theorem intervalDifferential_actual_block (D a b c d : ℕ) (hdD : d ≤ D + 1)
    (x : Fin (vertexCount a b c d) → ℝ) (i : Fin (arrowCount a b c d)) :
    orbitDifferential (fun _ : Fin (D + 1) => Fin 2) (intervalRep D a b c d)
      (vertexInjection D a b c d x) (physicalArrow D a b c d hdD i) 1 0 =
        (intervalDifferential ℝ a b c d).mulVec x i := by
  let e := physicalArrow D a b c d hdD i
  obtain ⟨ha, hb, hc, hd, hq⟩ := physicalArrow_properties D a b c d hdD i
  change a ≤ e.val at ha
  change e.val < b at hb
  change c ≤ e.val + 1 at hc
  change e.val + 1 < d at hd
  change e.val + 1 = max (a + 1) c + i.val at hq
  rw [actual_orbitDifferential_lower]
  change physicalValue (max a c) (vertexCount a b c d) x (e.val + 1) *
      (if a ≤ e.val ∧ e.val + 1 < b then 1 else 0) -
    (if c ≤ e.val ∧ e.val + 1 < d then 1 else 0) *
      physicalValue (max a c) (vertexCount a b c d) x e.val = _
  have hs : physicalValue (max a c) (vertexCount a b c d) x (e.val + 1) *
      (if a ≤ e.val ∧ e.val + 1 < b then 1 else 0) =
      physicalValue (max a c) (vertexCount a b c d) x (e.val + 1) := by
    by_cases h : e.val + 1 < b
    · have hf : a ≤ e.val ∧ e.val + 1 < b := ⟨ha, h⟩
      simp only [ite_eq_left hf, mul_one]
    · have hz := physicalValue_zero_of_not_active a b c d x (e.val + 1)
        (by intro hv; exact h hv.2.1)
      simp only [hz, zero_mul]
  have ht : (if c ≤ e.val ∧ e.val + 1 < d then 1 else 0) *
      physicalValue (max a c) (vertexCount a b c d) x e.val =
      physicalValue (max a c) (vertexCount a b c d) x e.val := by
    by_cases h : c ≤ e.val
    · have hf : c ≤ e.val ∧ e.val + 1 < d := ⟨h, hd⟩
      simp only [ite_eq_left hf, one_mul]
    · have hz := physicalValue_zero_of_not_active a b c d x e.val
        (by intro hv; exact h hv.2.2.1)
      simp only [hz, mul_zero]
  rw [hs, ht]
  have hm := shiftedDifference_mulVec (max (a + 1) c) (max a c)
    (arrowCount a b c d) (vertexCount a b c d) (by omega) x i
  rw [← hq] at hm
  exact hm.symm.trans (by simp only [intervalDifferential])

end MAIS.IntervalBlockDifferential
end
-- ==================== end module O7.IntervalBlockDifferential ====================

-- ==================== begin module O7.IntervalBlockGeometry (formalization/O7/IntervalBlockGeometry.lean) ====================
section

/-! The linked scalar interval block has an honest physical entrance-coordinate
normal space, proved by its actual image and a nonzero actual scalar functional. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace MAIS.IntervalBlockGeometry

open scoped Matrix
open MAIS.IntervalIncidence MAIS.IntervalBlockRank

variable (K : Type*) [Field K]

def sumFunctional (n : ℕ) : (Fin n → K) →ₗ[K] K where
  toFun y := ∑ i, y i
  map_add' _ _ := Finset.sum_add_distrib
  map_smul' r y := by simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]

/-- The literal first physical arrow coordinate, with no index-positivity cast. -/
def firstVector (n : ℕ) : Fin n → K := fun i => if i.val = 0 then 1 else 0

theorem sum_firstVector (n : ℕ) (hn : 0 < n) :
    sumFunctional K n (firstVector K n) = 1 := by
  let i0 : Fin n := ⟨0, hn⟩
  have he (i : Fin n) : i.val = 0 ↔ i = i0 := by
    constructor
    · intro h; apply Fin.ext; exact h
    · intro h; subst i; rfl
  change (∑ i : Fin n, if i.val = 0 then (1 : K) else 0) = 1
  simp only [he]
  simp

theorem sumFunctional_ne_zero (n : ℕ) (hn : 0 < n) : sumFunctional K n ≠ 0 := by
  intro h
  have he := congrArg (fun f : (Fin n → K) →ₗ[K] K => f (firstVector K n)) h
  exact one_ne_zero (by simpa only [sum_firstVector K n hn, LinearMap.zero_apply] using he)

theorem sum_shifted_boundary (c nr nc : ℕ) (hn : nr = nc + 1) (x : Fin nc → K) :
    sumFunctional K nr ((shiftedDifference K c c nr nc).mulVec x) = 0 := by
  subst nr
  change total K nc ((shiftedDifference K c c (nc + 1) nc).mulVec x) = 0
  rw [shifted_boundary]
  exact sum_boundary_mulVec K nc x

/-- The full sum obstruction vanishes on every actual linked cochain image. -/
theorem sum_intervalDifferential (a b c d : ℕ)
    (hac : a < c) (hcb : c ≤ b) (hbd : b < d)
    (x : Fin (vertexCount a b c d) → K) :
    sumFunctional K (arrowCount a b c d) ((intervalDifferential K a b c d).mulVec x) = 0 := by
  have hr : max (a + 1) c = c := max_eq_right (by omega)
  have hc : max a c = c := max_eq_right hac.le
  have hn : arrowCount a b c d = vertexCount a b c d + 1 := by
    unfold arrowCount vertexCount
    omega
  simpa only [intervalDifferential, hr, hc] using
    sum_shifted_boundary K c (arrowCount a b c d) (vertexCount a b c d) hn x

/-- Exactly the zero-sum hyperplane is reached by the actual linked scalar
    interval difference matrix. -/
theorem linked_range_eq_ker_sum (a b c d : ℕ)
    (hac : a < c) (hcb : c ≤ b) (hbd : b < d) :
    (Matrix.toLin' (intervalDifferential K a b c d)).range =
      (sumFunctional K (arrowCount a b c d)).ker := by
  have hn : 0 < arrowCount a b c d := by unfold arrowCount; omega
  have hle : (Matrix.toLin' (intervalDifferential K a b c d)).range ≤
      (sumFunctional K (arrowCount a b c d)).ker := by
    rintro y ⟨x, rfl⟩
    exact sum_intervalDifferential K a b c d hac hcb hbd x
  have hrank := interval_cokernel_dimension K a b c d (by omega) (by omega)
  rw [ite_eq_left ⟨hac, hcb, hbd⟩] at hrank
  have hker := Module.Dual.finrank_ker_add_one_of_ne_zero
    (sumFunctional_ne_zero K (arrowCount a b c d) hn)
  simp only [Module.finrank_pi, Fintype.card_fin] at hker
  apply Submodule.eq_of_le_of_finrank_eq hle
  change (intervalDifferential K a b c d).rank = _
  omega

/-- The actual first arrow coordinate is an honest normal complement.  Here
    that coordinate has output vertex c, hence physical arrow c−1 → c. -/
theorem linked_entrance_isCompl (a b c d : ℕ)
    (hac : a < c) (hcb : c ≤ b) (hbd : b < d) :
    IsCompl (Matrix.toLin' (intervalDifferential K a b c d)).range
      (Submodule.span K {firstVector K (arrowCount a b c d)}) := by
  have hn : 0 < arrowCount a b c d := by unfold arrowCount; omega
  rw [linked_range_eq_ker_sum K a b c d hac hcb hbd]
  have he := sum_firstVector K (arrowCount a b c d) hn
  refine ⟨Submodule.disjoint_span_singleton_of_notMem ?_, ?_⟩
  · simp only [LinearMap.mem_ker, he]
    exact one_ne_zero
  · exact codisjoint_iff.mpr (by
      rw [sup_comm]
      exact LinearMap.span_singleton_sup_ker_eq_top _ (by rw [he]; exact one_ne_zero))

end MAIS.IntervalBlockGeometry
end
-- ==================== end module O7.IntervalBlockGeometry ====================

-- ==================== begin module O7.ActiveIntervalDifferential (formalization/O7/ActiveIntervalDifferential.lean) ====================
section

/-! Literal interval representations on their actual active vertex spaces.
The entrywise orbit derivative separates into actual finite scalar cochain
blocks; no fixed ambient padding is used in these representations. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000

namespace MAIS.ActiveIntervalDifferential

open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.IntervalBlockRank
open MAIS.IntervalBlockDifferential MAIS.IntervalBlockGeometry
open scoped Matrix

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ)

def active (v : Fin (D + 1)) (s : S) : Prop := birth s ≤ v.val ∧ v.val < death s

instance active_decidable (v : Fin (D + 1)) (s : S) : Decidable (active D birth death v s) := by
  unfold active
  infer_instance

abbrev Index (v : Fin (D + 1)) := {s : S // active D birth death v s}

/-- Actual interval arrows between exactly the active coordinate spaces. -/
def intervalRep : Rep (Index D birth death) := fun _ r s => if r.val = s.val then 1 else 0

/-- A subtype-coordinate sum collapses to the single actual matching coordinate. -/
theorem sum_subtype_mul_indicator {T : Type*} [Fintype T] [DecidableEq T]
    (P : T → Prop) [DecidablePred P] (f : {t : T // P t} → ℝ) (s : T) :
    (∑ k, f k * (if k.val = s then 1 else 0)) = if h : P s then f ⟨s, h⟩ else 0 := by
  by_cases hs : P s
  · rw [dite_eq_left hs]
    let k0 : {t : T // P t} := ⟨s, hs⟩
    rw [Finset.sum_eq_single k0]
    · simp [k0]
    · intro k _ hne
      have hval : k.val ≠ s := by intro h; exact hne (Subtype.ext h)
      simp [hval]
    · simp
  · rw [dite_eq_right hs]
    apply Finset.sum_eq_zero
    intro k _
    have hval : k.val ≠ s := by intro h; exact hs (h ▸ k.property)
    simp [hval]

/-- Direct calculation in the actual active matrix spaces. -/
theorem orbitDifferential_entry
    (X : Lie (Index D birth death)) (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    orbitDifferential (Index D birth death) (intervalRep D birth death) X e r s =
      (if hs : active D birth death e.succ s.val then X e.succ r ⟨s.val, hs⟩ else 0) -
      (if hr : active D birth death e.castSucc r.val then X e.castSucc ⟨r.val, hr⟩ s else 0) := by
  change (∑ k, X e.succ r k * (if k.val = s.val then 1 else 0)) -
    (∑ k, (if r.val = k.val then 1 else 0) * X e.castSucc k s) = _
  rw [sum_subtype_mul_indicator]
  congr 1
  rw [show (∑ k : Index D birth death e.castSucc,
      (if r.val = k.val then (1 : ℝ) else 0) * X e.castSucc k s) =
      ∑ k : Index D birth death e.castSucc, X e.castSucc k s *
        (if k.val = r.val then 1 else 0) by
          apply Finset.sum_congr rfl
          intro k _
          simp only [eq_comm, mul_comm]]
  exact sum_subtype_mul_indicator _ _ _

end MAIS.ActiveIntervalDifferential
end
-- ==================== end module O7.ActiveIntervalDifferential ====================

-- ==================== begin module O7.LinearChainSplit (formalization/O7/LinearChainSplit.lean) ====================
section

/-!
Actual finite-dimensional persistence chains over an arbitrary field.
The first construction splits off a genuine interval summand, using a surviving
vector at the first nonzero vertex and a dual functional at its last survivor.
All objects are actual vector spaces and linear maps.
-/
set_option autoImplicit false

universe u v w
namespace MAIS.LinearChain

variable (K : Type u) [Field K]
variable (I : Type v) [Fintype I] [LinearOrder I]
variable (V : I → Type w) [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)]

/-- A finite linearly ordered diagram of actual vector spaces and actual linear maps. -/
structure Chain where
  map : ∀ i j, i ≤ j → (V i →ₗ[K] V j)
  map_id : ∀ i, map i i le_rfl = LinearMap.id
  map_comp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k),
    (map j k hjk).comp (map i j hij) = map i k (hij.trans hjk)

variable {K I V}

omit [Fintype I] in
@[simp] lemma Chain.map_self (C : Chain K I V) (i : I) (h : i ≤ i) (x : V i) :
    C.map i i h x = x := by rw [C.map_id]; rfl

omit [Fintype I] in
lemma Chain.map_map (C : Chain K I V) (i j k : I) (hij : i ≤ j) (hjk : j ≤ k)
    (x : V i) : C.map j k hjk (C.map i j hij x) = C.map i k (hij.trans hjk) x := by
  exact congrArg (fun f => f x) (C.map_comp i j k hij hjk)

/-- Concrete injection/projection data for a single interval direct summand. -/
structure IntervalSummand (C : Chain K I V) where
  birth : I
  death : I
  birth_le_death : birth ≤ death
  vector : ∀ i, V i
  covector : ∀ i, V i →ₗ[K] K
  vector_zero : ∀ i, ¬ (birth ≤ i ∧ i ≤ death) → vector i = 0
  covector_zero : ∀ i, ¬ (birth ≤ i ∧ i ≤ death) → covector i = 0
  pairing : ∀ i, birth ≤ i ∧ i ≤ death → covector i (vector i) = 1
  map_vector : ∀ i j (hij : i ≤ j),
    C.map i j hij (vector i) = if birth ≤ i ∧ i ≤ death then vector j else 0
  covector_map : ∀ i j (hij : i ≤ j),
    (covector j).comp (C.map i j hij) =
      if birth ≤ j ∧ j ≤ death then covector i else 0

variable [∀ i, FiniteDimensional K (V i)]

/-- A nonzero finite chain has a genuine interval summand; no algebraic closure is used. -/
theorem exists_interval_summand (C : Chain K I V)
    (hnonzero : ∃ i, 0 < Module.finrank K (V i)) : Nonempty (IntervalSummand C) := by
  classical
  let nz : Finset I := Finset.univ.filter (fun i => 0 < Module.finrank K (V i))
  have hnz : nz.Nonempty := by
    obtain ⟨i, hi⟩ := hnonzero
    exact ⟨i, by simp [nz, hi]⟩
  let a := nz.min' hnz
  have ha : 0 < Module.finrank K (V a) := (Finset.mem_filter.mp (Finset.min'_mem nz hnz)).2
  have hbefore : ∀ i, i < a → ∀ x : V i, x = 0 := by
    intro i hi
    have hdim : Module.finrank K (V i) = 0 := by
      by_contra h
      have himem : i ∈ nz := by simp [nz, Nat.pos_of_ne_zero h]
      have := Finset.min'_le nz i himem
      exact (not_le_of_gt hi) this
    have : Subsingleton (V i) := Module.finrank_zero_iff.mp hdim
    exact fun x => Subsingleton.elim x 0
  have : Nontrivial (V a) := Module.finrank_pos_iff.mp ha
  let live : Finset I := Finset.univ.filter (fun j => ∃ h : a ≤ j, C.map a j h ≠ 0)
  have ha_live : a ∈ live := by
    simp only [live, Finset.mem_filter, Finset.mem_univ, true_and]
    refine ⟨le_rfl, ?_⟩
    rw [C.map_id]
    intro hid
    obtain ⟨y, hy⟩ := exists_ne (0 : V a)
    exact hy (by simpa using congrArg (fun f : V a →ₗ[K] V a => f y) hid)
  have hlive : live.Nonempty := ⟨a, ha_live⟩
  let c := live.max' hlive
  obtain ⟨hac, hmap⟩ := (Finset.mem_filter.mp (Finset.max'_mem live hlive)).2
  have hafter : ∀ j (haj : a ≤ j), c < j → C.map a j haj = 0 := by
    intro j haj hcj
    by_contra h
    have hjmem : j ∈ live := by simp only [live, Finset.mem_filter, Finset.mem_univ, true_and]; exact ⟨haj, h⟩
    exact (not_le_of_gt hcj) (Finset.le_max' live j hjmem)
  have hx : ∃ x : V a, C.map a c hac x ≠ 0 := by
    by_contra h
    push Not at h
    apply hmap
    ext x
    exact h x
  obtain ⟨x, hx⟩ := hx
  obtain ⟨φ, hφ⟩ := Module.Projective.exists_dual_eq_one K hx
  let vec : ∀ i, V i := fun i => if h : a ≤ i then C.map a i h x else 0
  let cov : ∀ i, V i →ₗ[K] K := fun i =>
    if h : a ≤ i ∧ i ≤ c then φ.comp (C.map i c h.2) else 0
  refine ⟨{
    birth := a
    death := c
    birth_le_death := hac
    vector := vec
    covector := cov
    vector_zero := ?_
    covector_zero := ?_
    pairing := ?_
    map_vector := ?_
    covector_map := ?_ }⟩
  · intro i hi
    dsimp [vec]
    split_ifs with hai
    · have hci : c < i := lt_of_not_ge (fun hic => hi ⟨hai, hic⟩)
      rw [hafter i hai hci]
      rfl
    · rfl
  · intro i hi
    simp [cov, hi]
  · intro i hi
    simp only [cov, vec, dite_eq_left hi, dite_eq_left hi.1, LinearMap.comp_apply]
    rw [C.map_map a i c hi.1 hi.2]
    exact hφ
  · intro i j hij
    by_cases hai : a ≤ i
    · by_cases hic : i ≤ c
      · have hi : a ≤ i ∧ i ≤ c := ⟨hai, hic⟩
        simp only [vec, dite_eq_left hai, dite_eq_left (hai.trans hij), ite_eq_left hi]
        exact C.map_map a i j hai hij x
      · have hci : c < i := lt_of_not_ge hic
        have hcj : c < j := hci.trans_le hij
        simp [vec, hai, hic, hafter i hai hci]
    · simp [vec, hai]
  · intro i j hij
    by_cases hj : a ≤ j ∧ j ≤ c
    · simp only [cov, dite_eq_left hj, ite_eq_left hj]
      by_cases hai : a ≤ i
      · have hi : a ≤ i ∧ i ≤ c := ⟨hai, hij.trans hj.2⟩
        simp only [dite_eq_left hi]
        rw [LinearMap.comp_assoc, C.map_comp i j c hij hj.2]
      · have hia : i < a := lt_of_not_ge hai
        simp only [dite_eq_right (show ¬ (a ≤ i ∧ i ≤ c) from fun h => hai h.1)]
        ext y
        rw [hbefore i hia y]
        simp
    · simp [cov, hj]

end MAIS.LinearChain

/-- info: 'MAIS.LinearChain.exists_interval_summand' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.exists_interval_summand
end
-- ==================== end module O7.LinearChainSplit ====================

-- ==================== begin module O7.LinearChainKernel (formalization/O7/LinearChainKernel.lean) ====================
section

set_option autoImplicit false
universe u v w
namespace MAIS.LinearChain

variable {K : Type u} [Field K]
variable {I : Type v} [Fintype I] [LinearOrder I]
variable {V : I → Type w} [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)]
variable {C : Chain K I V} (S : IntervalSummand C)

omit [Fintype I] in
lemma IntervalSummand.covector_map_apply (i j : I) (hij : i ≤ j) (x : V i) :
    S.covector j (C.map i j hij x) =
      if S.birth ≤ j ∧ j ≤ S.death then S.covector i x else 0 := by
  have h := congrArg (fun f : V i →ₗ[K] K => f x) (S.covector_map i j hij)
  split_ifs at h ⊢ <;> exact h

abbrev IntervalSummand.Kernel (i : I) := LinearMap.ker (S.covector i)

/-- The complementary kernels are an actual subrepresentation. -/
def IntervalSummand.kernelMap (i j : I) (hij : i ≤ j) :
    S.Kernel i →ₗ[K] S.Kernel j where
  toFun x := ⟨C.map i j hij x, by
    change S.covector j (C.map i j hij x) = 0
    rw [S.covector_map_apply]
    split_ifs <;> simp [LinearMap.mem_ker.mp x.property]⟩
  map_add' x y := by ext; simp
  map_smul' r x := by ext; simp

omit [Fintype I] in
@[simp] lemma IntervalSummand.kernelMap_val (i j : I) (hij : i ≤ j) (x : S.Kernel i) :
    (S.kernelMap i j hij x : V j) = C.map i j hij x := rfl

/-- The actual chain carried by the complementary kernels. -/
def IntervalSummand.kernelChain : Chain K I (fun i => S.Kernel i) where
  map := S.kernelMap
  map_id i := by ext x; simp
  map_comp i j k hij hjk := by ext x; simp [C.map_map]

variable [∀ i, FiniteDimensional K (V i)]

/-- Splitting the genuine interval strictly reduces the sum of actual vertex dimensions. -/
theorem IntervalSummand.kernel_total_dimension_lt :
    (∑ i, Module.finrank K (S.Kernel i)) < ∑ i, Module.finrank K (V i) := by
  classical
  apply Finset.sum_lt_sum
  · intro i _
    exact Submodule.finrank_le _
  · refine ⟨S.birth, Finset.mem_univ _, ?_⟩
    apply Submodule.finrank_lt
    intro hker
    have hcov : S.covector S.birth = 0 := LinearMap.ker_eq_top.mp hker
    have hp := S.pairing S.birth ⟨le_rfl, S.birth_le_death⟩
    rw [hcov] at hp
    exact zero_ne_one hp

end MAIS.LinearChain

/-- info: 'MAIS.LinearChain.IntervalSummand.kernel_total_dimension_lt' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.IntervalSummand.kernel_total_dimension_lt
end
-- ==================== end module O7.LinearChainKernel ====================

-- ==================== begin module O7.LinearChainHead (formalization/O7/LinearChainHead.lean) ====================
section

set_option autoImplicit false
universe u v w
namespace MAIS.LinearChain

variable {K : Type u} [Field K]
variable {I : Type v} [Fintype I] [LinearOrder I]
variable {V : I → Type w} [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)]
variable {C : Chain K I V} (S : IntervalSummand C)

/-- The scalar space of an actual interval: one-dimensional inside and zero outside. -/
def intervalScalar (a c i : I) : Submodule K K := if a ≤ i ∧ i ≤ c then ⊤ else ⊥

omit [Fintype I] in
lemma IntervalSummand.covector_vector (i : I) :
    S.covector i (S.vector i) = if S.birth ≤ i ∧ i ≤ S.death then 1 else 0 := by
  classical
  split_ifs with h
  · exact S.pairing i h
  · rw [S.covector_zero i h]
    rfl

omit [Fintype I] in
lemma IntervalSummand.covector_mem_intervalScalar (i : I) (x : V i) :
    S.covector i x ∈ intervalScalar (K := K) S.birth S.death i := by
  classical
  by_cases h : S.birth ≤ i ∧ i ≤ S.death
  · rw [intervalScalar, ite_eq_left h]
    trivial
  · rw [intervalScalar, ite_eq_right h]
    change S.covector i x = 0
    rw [S.covector_zero i h]
    rfl

omit [Fintype I] in
lemma intervalScalar_val_zero (a c i : I) (h : ¬ (a ≤ i ∧ i ≤ c))
    (r : intervalScalar (K := K) a c i) : (r : K) = 0 := by
  simpa [intervalScalar, h] using r.property

/-- Actual vertexwise linear splitting into the interval scalar and the complementary kernel. -/
def IntervalSummand.splitEquiv (i : I) :
    V i ≃ₗ[K] intervalScalar (K := K) S.birth S.death i × S.Kernel i where
  toFun x := (⟨S.covector i x, S.covector_mem_intervalScalar i x⟩,
    ⟨x - S.covector i x • S.vector i, by
      change S.covector i (x - S.covector i x • S.vector i) = 0
      rw [map_sub, map_smul, S.covector_vector]
      split_ifs with h
      · simp
      · simp [S.covector_zero i h]⟩)
  invFun p := (p.1 : K) • S.vector i + (p.2 : V i)
  left_inv x := by dsimp; abel
  right_inv p := by
    have hc : S.covector i ((p.1 : K) • S.vector i + (p.2 : V i)) = (p.1 : K) := by
      rw [map_add, map_smul, S.covector_vector, LinearMap.mem_ker.mp p.2.property]
      by_cases h : S.birth ≤ i ∧ i ≤ S.death
      · simp [h]
      · simp [h, intervalScalar_val_zero S.birth S.death i h p.1]
    apply Prod.ext
    · apply Subtype.ext
      exact hc
    · apply Subtype.ext
      dsimp
      rw [hc]
      abel
  map_add' x y := by
    apply Prod.ext <;> apply Subtype.ext
    · simp
    · dsimp
      rw [map_add, add_smul]
      abel
  map_smul' r x := by
    apply Prod.ext <;> apply Subtype.ext
    · simp
    · dsimp
      simp only [map_smul, smul_sub, smul_smul, smul_eq_mul]

omit [Fintype I] in
@[simp] lemma IntervalSummand.splitEquiv_fst_val (i : I) (x : V i) :
    ((S.splitEquiv i x).1 : K) = S.covector i x := rfl

omit [Fintype I] in
@[simp] lemma IntervalSummand.splitEquiv_symm_apply (i : I)
    (p : intervalScalar (K := K) S.birth S.death i × S.Kernel i) :
    (S.splitEquiv i).symm p = (p.1 : K) • S.vector i + (p.2 : V i) := rfl

end MAIS.LinearChain

/-- info: 'MAIS.LinearChain.IntervalSummand.splitEquiv' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.IntervalSummand.splitEquiv
end
-- ==================== end module O7.LinearChainHead ====================

-- ==================== begin module O7.LinearChainBarcode (formalization/O7/LinearChainBarcode.lean) ====================
section

set_option autoImplicit false
universe u v w
namespace MAIS.LinearChain

open Module
variable {K : Type u} [Field K]
variable {I : Type v} [Fintype I] [LinearOrder I]
variable {V : I → Type w} [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)]

/-- A genuine simultaneous interval basis of the actual vector spaces and actual maps. -/
structure Barcode (C : Chain K I V) where
  Index : Type
  finiteIndex : Fintype Index
  birth : Index → I
  death : Index → I
  valid : ∀ s, birth s ≤ death s
  basis : ∀ i, Basis {s : Index // birth s ≤ i ∧ i ≤ death s} K (V i)
  map_basis : ∀ i j (hij : i ≤ j) (s : Index) (hs : birth s ≤ i ∧ i ≤ death s),
    C.map i j hij (basis i ⟨s, hs⟩) =
      if hj : j ≤ death s then basis j ⟨s, hs.1.trans hij, hj⟩ else 0

attribute [instance] Barcode.finiteIndex

variable {C : Chain K I V} (S : IntervalSummand C)

/-- On an active vertex the actual interval scalar is linearly equivalent to the field. -/
def intervalScalarEquiv (a c i : I) (h : a ≤ i ∧ i ≤ c) :
    intervalScalar (K := K) a c i ≃ₗ[K] K where
  toFun := Subtype.val
  invFun r := ⟨r, by simp [intervalScalar, h]⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The actual interval scalar has its expected one-element or empty basis. -/
noncomputable def intervalScalarBasis (a c i : I) :
    Basis {_s : Unit // a ≤ i ∧ i ≤ c} K (intervalScalar (K := K) a c i) := by
  classical
  by_cases h : a ≤ i ∧ i ≤ c
  · letI : Unique {_s : Unit // a ≤ i ∧ i ≤ c} :=
      { default := ⟨(), h⟩, uniq := fun x => Subtype.ext (Subsingleton.elim _ _) }
    exact (Basis.singleton {_s : Unit // a ≤ i ∧ i ≤ c} K).map
      (intervalScalarEquiv a c i h).symm
  · letI : IsEmpty {_s : Unit // a ≤ i ∧ i ≤ c} := ⟨fun x => h x.property⟩
    letI : Subsingleton (intervalScalar (K := K) a c i) :=
      ⟨fun x y => Subtype.ext ((intervalScalar_val_zero a c i h x).trans
        (intervalScalar_val_zero a c i h y).symm)⟩
    exact Basis.empty _

omit [Fintype I] in
@[simp] lemma intervalScalarBasis_val (a c i : I) (h : a ≤ i ∧ i ≤ c)
    (s : {_s : Unit // a ≤ i ∧ i ≤ c}) :
    (intervalScalarBasis (K := K) a c i s : K) = 1 := by
  classical
  simp only [intervalScalarBasis, dite_eq_left h, Basis.map_apply, Basis.singleton_apply]
  rfl

variable (B : Barcode S.kernelChain)

def extendedBirth : Unit ⊕ B.Index → I := Sum.elim (fun _ => S.birth) B.birth

def extendedDeath : Unit ⊕ B.Index → I := Sum.elim (fun _ => S.death) B.death

/-- The actual simultaneous basis obtained by adjoining the split interval to the kernel basis. -/
noncomputable def extendedBasis (i : I) :
    Basis {s : Unit ⊕ B.Index // extendedBirth S B s ≤ i ∧ i ≤ extendedDeath S B s}
      K (V i) :=
  ((((intervalScalarBasis (K := K) S.birth S.death i).prod (B.basis i)).map
    (S.splitEquiv i).symm).reindex (Equiv.subtypeSum (p := fun s : Unit ⊕ B.Index =>
      extendedBirth S B s ≤ i ∧ i ≤ extendedDeath S B s)).symm)

omit [Fintype I] in
lemma extendedBasis_inl (i : I) (h : S.birth ≤ i ∧ i ≤ S.death) :
    extendedBasis S B i ⟨Sum.inl (), h⟩ = S.vector i := by
  unfold extendedBasis
  erw [Basis.reindex_apply, Basis.map_apply]
  change (S.splitEquiv i).symm
    (((intervalScalarBasis (K := K) S.birth S.death i).prod (B.basis i))
      (Sum.inl ⟨(), h⟩)) = _
  simp [Basis.prod_apply, S.splitEquiv_symm_apply, intervalScalarBasis_val _ _ _ h]

omit [Fintype I] in
lemma extendedBasis_inr (i : I) (s : B.Index) (h : B.birth s ≤ i ∧ i ≤ B.death s) :
    extendedBasis S B i ⟨Sum.inr s, h⟩ = (B.basis i ⟨s, h⟩ : V i) := by
  unfold extendedBasis
  erw [Basis.reindex_apply, Basis.map_apply]
  change (S.splitEquiv i).symm
    (((intervalScalarBasis (K := K) S.birth S.death i).prod (B.basis i))
      (Sum.inr ⟨s, h⟩)) = _
  simp [Basis.prod_apply, S.splitEquiv_symm_apply]

/-- A genuine interval summand and a genuine kernel barcode give a genuine barcode. -/
noncomputable def Barcode.extend : Barcode C where
  Index := Unit ⊕ B.Index
  finiteIndex := inferInstance
  birth := extendedBirth S B
  death := extendedDeath S B
  valid := by rintro (_ | s); exact S.birth_le_death; exact B.valid s
  basis := extendedBasis S B
  map_basis := by
    intro i j hij s hs
    cases s with
    | inl u =>
      cases u
      change S.birth ≤ i ∧ i ≤ S.death at hs
      rw [extendedBasis_inl S B i hs, S.map_vector i j hij, ite_eq_left hs]
      split_ifs with hj
      · exact (extendedBasis_inl S B j ⟨hs.1.trans hij, hj⟩).symm
      · exact S.vector_zero j (fun h => hj h.2)
    | inr s =>
      change B.birth s ≤ i ∧ i ≤ B.death s at hs
      rw [extendedBasis_inr S B i s hs]
      have h := congrArg (fun x : S.Kernel j => (x : V j)) (B.map_basis i j hij s hs)
      change C.map i j hij (B.basis i ⟨s, hs⟩) = _ at h
      change C.map i j hij (B.basis i ⟨s, hs⟩) =
        (if hj : j ≤ B.death s then
          extendedBasis S B j ⟨Sum.inr s, hs.1.trans hij, hj⟩ else 0)
      by_cases hj : j ≤ B.death s
      · rw [dite_eq_left hj] at h ⊢
        exact h.trans (extendedBasis_inr S B j s ⟨hs.1.trans hij, hj⟩).symm
      · simpa only [dite_eq_right hj, Submodule.coe_zero] using h

end MAIS.LinearChain

/-- info: 'MAIS.LinearChain.Barcode.extend' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.Barcode.extend
end
-- ==================== end module O7.LinearChainBarcode ====================

-- ==================== begin module O7.LinearChainClassification (formalization/O7/LinearChainClassification.lean) ====================
section

set_option autoImplicit false
universe u v w
namespace MAIS.LinearChain

open Module
variable {K : Type u} [Field K]
variable {I : Type v} [Fintype I] [LinearOrder I]
variable {V : I → Type w} [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)]
variable [∀ i, FiniteDimensional K (V i)]

/-- A zero-dimensional actual chain has the empty simultaneous interval basis. -/
noncomputable def Barcode.of_zero (C : Chain K I V)
    (hzero : ∀ i, finrank K (V i) = 0) : Barcode C where
  Index := Empty
  finiteIndex := inferInstance
  birth := Empty.elim
  death := Empty.elim
  valid := by intro s; exact s.elim
  basis i := by
    have : Subsingleton (V i) := finrank_zero_iff.mp (hzero i)
    exact Basis.empty _
  map_basis := by intro _ _ _ s; exact s.elim

/-- Every finite-dimensional chain over an arbitrary field admits a genuine simultaneous
    interval basis.  The induction measure is the sum of actual vertex dimensions. -/
theorem exists_barcode_of_dimension (n : ℕ) (C : Chain K I V)
    (hdim : (∑ i, finrank K (V i)) = n) : Nonempty (Barcode C) := by
  classical
  induction n using Nat.strong_induction_on generalizing V with
  | h n ih =>
    by_cases hn : n = 0
    · have hzero : ∀ i, finrank K (V i) = 0 := by
        have hz : (∑ i, finrank K (V i)) = 0 := hdim.trans hn
        intro i
        exact (Finset.sum_eq_zero_iff.mp hz) i (Finset.mem_univ i)
      exact ⟨Barcode.of_zero C hzero⟩
    · have hnonzero : ∃ i, 0 < finrank K (V i) := by
        by_contra h
        push Not at h
        have hz : (∑ i, finrank K (V i)) = 0 := by
          apply Finset.sum_eq_zero
          intro i _
          exact Nat.eq_zero_of_not_pos (fun hi => not_le_of_gt hi (h i))
        exact hn (hdim.symm.trans hz)
      obtain ⟨S⟩ := exists_interval_summand C hnonzero
      have hlt : (∑ i, finrank K (S.Kernel i)) < n := by
        rw [← hdim]
        exact S.kernel_total_dimension_lt
      obtain ⟨B⟩ := ih (∑ i, finrank K (S.Kernel i)) hlt S.kernelChain rfl
      exact ⟨Barcode.extend S B⟩

/-- The actual interval-decomposition existence theorem, with no rank formula assumed. -/
theorem exists_barcode (C : Chain K I V) : Nonempty (Barcode C) :=
  exists_barcode_of_dimension _ C rfl

end MAIS.LinearChain

/-- info: 'MAIS.LinearChain.exists_barcode' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.exists_barcode
end
-- ==================== end module O7.LinearChainClassification ====================

-- ==================== begin module O7.LinearChainRank (formalization/O7/LinearChainRank.lean) ====================
section

set_option autoImplicit false
universe u v w
namespace MAIS.LinearChain

open Module
variable {K : Type u} [Field K]
variable {I : Type v} [Fintype I] [LinearOrder I]
variable {V : I → Type w} [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)]
variable {C : Chain K I V} (B : Barcode C)

abbrev Barcode.Survivor (i j : I) := {s : B.Index // B.birth s ≤ i ∧ j ≤ B.death s}

noncomputable def Barcode.survivorVector (i j : I) (hij : i ≤ j) (s : B.Survivor i j) : V j :=
  B.basis j ⟨s.val, s.property.1.trans hij, s.property.2⟩

omit [Fintype I] in
lemma Barcode.survivorVector_independent (i j : I) (hij : i ≤ j) :
    LinearIndependent K (B.survivorVector i j hij) := by
  apply (B.basis j).linearIndependent.comp
    (fun s : B.Survivor i j =>
      (⟨s.val, s.property.1.trans hij, s.property.2⟩ :
        {s : B.Index // B.birth s ≤ j ∧ j ≤ B.death s}))
  intro s t h
  apply Subtype.ext
  exact congrArg (fun q : {s : B.Index // B.birth s ≤ j ∧ j ≤ B.death s} => q.val) h

omit [Fintype I] in
/-- The actual range of a persistence map is precisely the span of the surviving intervals. -/
theorem Barcode.range_eq_span_survivor (i j : I) (hij : i ≤ j) :
    LinearMap.range (C.map i j hij) =
      Submodule.span K (Set.range (B.survivorVector i j hij)) := by
  classical
  apply le_antisymm
  · have hspan : Submodule.map (C.map i j hij)
        (Submodule.span K (Set.range (B.basis i))) = LinearMap.range (C.map i j hij) := by
      rw [(B.basis i).span_eq, Submodule.map_top]
    rw [← hspan, Submodule.map_span]
    apply Submodule.span_le.mpr
    rintro y ⟨x, ⟨s, rfl⟩, rfl⟩
    rw [B.map_basis i j hij s.val s.property]
    by_cases hj : j ≤ B.death s.val
    · rw [dite_eq_left hj]
      exact Submodule.subset_span ⟨⟨s.val, s.property.1, hj⟩, rfl⟩
    · rw [dite_eq_right hj]
      exact Submodule.zero_mem _
  · apply Submodule.span_le.mpr
    rintro y ⟨s, rfl⟩
    refine ⟨B.basis i ⟨s.val, s.property.1, hij.trans s.property.2⟩, ?_⟩
    rw [B.map_basis i j hij s.val ⟨s.property.1, hij.trans s.property.2⟩,
      dite_eq_left s.property.2]
    rfl

omit [Fintype I] in
/-- The actual linear-map rank is the number of intervals crossing the two vertices.
    This is derived from the actual simultaneous basis, rather than postulated. -/
theorem Barcode.finrank_range (i j : I) (hij : i ≤ j) :
    Module.finrank K (LinearMap.range (C.map i j hij)) =
      Fintype.card (B.Survivor i j) := by
  classical
  rw [B.range_eq_span_survivor i j hij]
  exact finrank_span_eq_card (B.survivorVector_independent i j hij)

omit [Fintype I] in
/-- Actual vertex dimension is the number of active barcode intervals. -/
theorem Barcode.finrank_vertex (i : I) :
    Module.finrank K (V i) =
      Fintype.card {s : B.Index // B.birth s ≤ i ∧ i ≤ B.death s} :=
  Module.finrank_eq_card_basis (B.basis i)

end MAIS.LinearChain

/-- info: 'MAIS.LinearChain.Barcode.finrank_range' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.Barcode.finrank_range
end
-- ==================== end module O7.LinearChainRank ====================

-- ==================== begin module O7.PermutationRankOrder (formalization/O7/PermutationRankOrder.lean) ====================
section

/-!
Finite permutation prefix-rank order generated by increasing swaps.
The proof uses actual Finset prefix cardinalities, a least-index improvement,
and a strictly decreasing finite sum of ranks to construct a finite List path.
No quiver geometry or termination claim is assumed.
-/
set_option autoImplicit false

namespace MAIS.PermutationRankOrder

/-- Number of entries at most `l` in the prefix of length `k`. -/
def prefixCount (v : ℕ → ℕ) (k l : ℕ) : ℕ :=
  ((Finset.range k).filter (fun p => v p ≤ l)).card

lemma prefixCount_eq_sum (v : ℕ → ℕ) (k l : ℕ) :
    prefixCount v k l = ∑ p ∈ Finset.range k, if v p ≤ l then 1 else 0 := by
  unfold prefixCount
  rw [Finset.card_eq_sum_ones, Finset.sum_filter]

/-- The first differing value is smaller when all prefix ranks dominate. -/
theorem first_difference_lt (v w : ℕ → ℕ) (i : ℕ)
    (hprefix : ∀ p < i, v p = w p)
    (hrank : ∀ k l, prefixCount w k l ≤ prefixCount v k l)
    (hne : v i ≠ w i) : v i < w i := by
  by_contra hnot
  have hwi : w i < v i := by omega
  have hsum := hrank (i + 1) (w i)
  have heq : prefixCount w i (w i) = prefixCount v i (w i) := by
    unfold prefixCount
    congr 1
    apply Finset.filter_congr
    intro p hp
    simp only [Finset.mem_range] at hp
    rw [hprefix p hp]
  have hw : prefixCount w (i + 1) (w i) = prefixCount w i (w i) + 1 := by
    simp only [prefixCount_eq_sum, Finset.sum_range_succ, le_refl, ite_true]
  have hv : prefixCount v (i + 1) (w i) = prefixCount v i (w i) := by
    simp only [prefixCount_eq_sum, Finset.sum_range_succ, Nat.not_le.mpr hwi,
      ite_false, Nat.add_zero]
  omega

/-- The minimal admissible later entry supplies one unit of slack on its swap rectangle. -/
theorem minimal_index_slack (v w : ℕ → ℕ) (i j k l : ℕ)
    (hprefix : ∀ p < i, v p = w p)
    (hrank : ∀ a b, prefixCount w a b ≤ prefixCount v a b)
    (hik : i < k) (hkj : k ≤ j)
    (hvl : v i ≤ l) (hlw : l < w i)
    (hminimal : ∀ p, i < p → p < j → ¬ (v i < v p ∧ v p ≤ w i)) :
    prefixCount w k l + 1 ≤ prefixCount v k l := by
  have hpoint (p : ℕ) (hp : p ∈ Finset.range k) :
      (if v p ≤ w i then 1 else 0) + (if w p ≤ l then 1 else 0) +
          (if p = i then 1 else 0) ≤
        (if v p ≤ l then 1 else 0) + (if w p ≤ w i then 1 else 0) := by
    have hpk : p < k := Finset.mem_range.mp hp
    by_cases hpi : p < i
    · have hpne : p ≠ i := by omega
      rw [hprefix p hpi]
      simp [hpne, Nat.add_comm]
    · by_cases heq : p = i
      · subst p
        have hviwi : v i ≤ w i := by omega
        simp [hviwi, hvl, Nat.not_le.mpr hlw]
      · have hip : i < p := by omega
        have hpj : p < j := by omega
        have hgap := hminimal p hip hpj
        split_ifs <;> omega
  have hsum := Finset.sum_le_sum hpoint
  simp only [Finset.sum_add_distrib] at hsum
  have hsingle : (∑ p ∈ Finset.range k, if p = i then 1 else 0) = 1 := by
    simp [hik]
  rw [hsingle] at hsum
  simp only [← prefixCount_eq_sum] at hsum
  have ht := hrank k (w i)
  omega

/-- Swap two entries, leaving every other entry unchanged. -/
def swapEntries (v : ℕ → ℕ) (i j : ℕ) : ℕ → ℕ :=
  fun p => if p = i then v j else if p = j then v i else v p

/-- On the affected rectangle, the actual finite-prefix rank drops by exactly one. -/
theorem swap_rectangle (v : ℕ → ℕ) (i j k l : ℕ)
    (hik : i < k) (hkj : k ≤ j) (hvl : v i ≤ l) (hlv : l < v j) :
    prefixCount (swapEntries v i j) k l + 1 = prefixCount v k l := by
  have hpoint (p : ℕ) (hp : p ∈ Finset.range k) :
      (if swapEntries v i j p ≤ l then 1 else 0) + (if p = i then 1 else 0) =
        (if v p ≤ l then 1 else 0) := by
    have hpk : p < k := Finset.mem_range.mp hp
    have hpj : p ≠ j := by omega
    by_cases hpi : p = i
    · subst p
      simp [swapEntries, hvl, Nat.not_le.mpr hlv]
    · simp [swapEntries, hpi, hpj]
  have hsum := Finset.sum_congr rfl hpoint
  simp only [Finset.sum_add_distrib] at hsum
  have hsingle : (∑ p ∈ Finset.range k, if p = i then 1 else 0) = 1 := by
    simp [hik]
  rw [hsingle] at hsum
  simpa only [← prefixCount_eq_sum] using hsum

/-- Globally, an increasing swap removes exactly its prefix-rank rectangle. -/
theorem swap_rank_formula (v : ℕ → ℕ) (i j k l : ℕ)
    (hij : i < j) (hvij : v i < v j) :
    prefixCount (swapEntries v i j) k l +
        (if i < k ∧ k ≤ j ∧ v i ≤ l ∧ l < v j then 1 else 0) =
      prefixCount v k l := by
  have hpoint (p : ℕ) (_hp : p ∈ Finset.range k) :
      (if v p ≤ l then 1 else 0) +
          (if p = i then (if v j ≤ l then 1 else 0) else 0) +
          (if p = j then (if v i ≤ l then 1 else 0) else 0) =
        (if swapEntries v i j p ≤ l then 1 else 0) +
          (if p = i then (if v i ≤ l then 1 else 0) else 0) +
          (if p = j then (if v j ≤ l then 1 else 0) else 0) := by
    have hne : i ≠ j := by omega
    by_cases hpi : p = i
    · subst p
      simp [swapEntries, hne, Nat.add_comm]
    · by_cases hpj : p = j
      · subst p
        simp [swapEntries, hpi, Nat.add_comm]
      · simp [swapEntries, hpi, hpj]
  have hsum := Finset.sum_congr rfl hpoint
  simp only [Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_range,
    ← prefixCount_eq_sum] at hsum
  split_ifs at hsum ⊢ <;> omega

/-- Every target inequality survives the first-difference/minimal-index swap. -/
theorem minimal_swap_preserves_rank (v w : ℕ → ℕ) (i j : ℕ)
    (hprefix : ∀ p < i, v p = w p)
    (hrank : ∀ k l, prefixCount w k l ≤ prefixCount v k l)
    (hij : i < j) (hvij : v i < v j) (hvjwi : v j ≤ w i)
    (hminimal : ∀ p, i < p → p < j → ¬ (v i < v p ∧ v p ≤ w i)) :
    ∀ k l, prefixCount w k l ≤ prefixCount (swapEntries v i j) k l := by
  intro k l
  have hformula := swap_rank_formula v i j k l hij hvij
  by_cases hrect : i < k ∧ k ≤ j ∧ v i ≤ l ∧ l < v j
  · have hslack := minimal_index_slack v w i j k l hprefix hrank
      hrect.1 hrect.2.1 hrect.2.2.1 (by omega) hminimal
    simp only [ite_eq_left hrect] at hformula
    omega
  · simp only [ite_eq_right hrect, Nat.add_zero] at hformula
    rw [hformula]
    exact hrank k l

/-- A permutation supplies a later admissible value; taking the least such index gives the
    precise hypothesis used by the target-preservation lemma. -/
theorem exists_minimal_swap_index (v w : ℕ → ℕ) (N i : ℕ)
    (hi : i < N)
    (hprefix : ∀ p < i, v p = w p)
    (hrank : ∀ k l, prefixCount w k l ≤ prefixCount v k l)
    (hne : v i ≠ w i)
    (hinjw : ∀ a < N, ∀ b < N, w a = w b → a = b)
    (hoccurs : ∃ j < N, v j = w i) :
    ∃ j, i < j ∧ j < N ∧ v i < v j ∧ v j ≤ w i ∧
      (∀ p, i < p → p < j → ¬ (v i < v p ∧ v p ≤ w i)) ∧
      (∀ k l, prefixCount w k l ≤ prefixCount (swapEntries v i j) k l) := by
  have hvi := first_difference_lt v w i hprefix hrank hne
  have hex : ∃ j, i < j ∧ v i < v j ∧ v j ≤ w i := by
    obtain ⟨j, hj, hjval⟩ := hoccurs
    have hij : i < j := by
      by_contra hnot
      by_cases hji : j < i
      · have hsame : w j = w i := by rw [← hprefix j hji, hjval]
        have heq := hinjw j hj i hi hsame
        omega
      · have heq : j = i := by omega
        subst j
        exact hne hjval
    exact ⟨j, hij, by omega, by omega⟩
  let j := Nat.find hex
  have hj := Nat.find_spec hex
  have hjN : j < N := by
    obtain ⟨p, hp, hpval⟩ := hoccurs
    have hip : i < p := by
      by_contra hnot
      by_cases hpi : p < i
      · have hsame : w p = w i := by rw [← hprefix p hpi, hpval]
        have heq := hinjw p hp i hi hsame
        omega
      · have heq : p = i := by omega
        subst p
        exact hne hpval
    have hle : j ≤ p := Nat.find_min' hex ⟨hip, by omega, by omega⟩
    omega
  have hminimal : ∀ p, i < p → p < j → ¬ (v i < v p ∧ v p ≤ w i) := by
    intro p hip hpj hvals
    have hle : j ≤ p := Nat.find_min' hex ⟨hip, hvals.1, hvals.2⟩
    omega
  exact ⟨j, hj.1, hjN, hj.2.1, hj.2.2, hminimal,
    minimal_swap_preserves_rank v w i j hprefix hrank hj.1 hj.2.1 hj.2.2 hminimal⟩

/-- Extend a genuine finite permutation by the identity outside its finite domain. -/
def liftPermutation {N : ℕ} (v : Equiv.Perm (Fin N)) (p : ℕ) : ℕ :=
  if hp : p < N then (v ⟨p, hp⟩).val else p

lemma liftPermutation_at {N : ℕ} (v : Equiv.Perm (Fin N)) (i : Fin N) :
    liftPermutation v i.val = (v i).val := by
  simp [liftPermutation, i.isLt]

/-- The natural-number swap used above is the genuine position swap of the finite permutation. -/
lemma liftPermutation_swap {N : ℕ} (v : Equiv.Perm (Fin N)) (i j : Fin N) :
    liftPermutation (v * Equiv.swap i j) =
      swapEntries (liftPermutation v) i.val j.val := by
  funext p
  by_cases hp : p < N
  · simp [liftPermutation, hp, swapEntries, Equiv.Perm.mul_apply,
      Equiv.swap_apply_def, Fin.ext_iff]
    split_ifs <;> rfl
  · have hpi : p ≠ i.val := by omega
    have hpj : p ≠ j.val := by omega
    simp [liftPermutation, hp, swapEntries, hpi, hpj]

/-- The local improvement theorem for actual finite permutations, using actual finite-prefix
    cardinalities rather than an abstract rank-array interface. -/
theorem finite_permutation_minimal_step {N : ℕ} (v w : Equiv.Perm (Fin N)) (i : Fin N)
    (hprefix : ∀ p < i.val, liftPermutation v p = liftPermutation w p)
    (hrank : ∀ k l, prefixCount (liftPermutation w) k l ≤
      prefixCount (liftPermutation v) k l)
    (hne : v i ≠ w i) :
    ∃ j : Fin N, i < j ∧ (v i).val < (v j).val ∧ (v j).val ≤ (w i).val ∧
      (∀ p, i.val < p → p < j.val →
        ¬ (liftPermutation v i.val < liftPermutation v p ∧
          liftPermutation v p ≤ liftPermutation w i.val)) ∧
      (∀ k l, prefixCount (liftPermutation w) k l ≤
        prefixCount (swapEntries (liftPermutation v) i.val j.val) k l) := by
  have hinjw : ∀ a < N, ∀ b < N,
      liftPermutation w a = liftPermutation w b → a = b := by
    intro a ha b hb hab
    have hfin : w ⟨a, ha⟩ = w ⟨b, hb⟩ := by
      apply Fin.ext
      simpa only [liftPermutation, dite_eq_left ha, dite_eq_left hb] using hab
    exact congrArg Fin.val (w.injective hfin)
  have hoccurs : ∃ j < N, liftPermutation v j = liftPermutation w i.val := by
    refine ⟨(v.symm (w i)).val, (v.symm (w i)).isLt, ?_⟩
    rw [liftPermutation_at, liftPermutation_at, v.apply_symm_apply]
  have hneval : liftPermutation v i.val ≠ liftPermutation w i.val := by
    intro heq
    apply hne
    apply Fin.ext
    simpa only [liftPermutation_at] using heq
  obtain ⟨j, hij, hjN, hvij, hvjwi, hminimal, hkeep⟩ :=
    exists_minimal_swap_index (liftPermutation v) (liftPermutation w) N i.val
      i.isLt hprefix hrank hneval hinjw hoccurs
  refine ⟨⟨j, hjN⟩, hij, ?_, ?_, hminimal, hkeep⟩
  · simpa only [liftPermutation, dite_eq_left i.isLt, dite_eq_left hjN] using hvij
  · simpa only [liftPermutation, dite_eq_left i.isLt, dite_eq_left hjN] using hvjwi

/-- A first difference admits an increasing genuine permutation swap preserving target ranks. -/
theorem finite_permutation_improvement {N : ℕ} (v w : Equiv.Perm (Fin N)) (i : Fin N)
    (hprefix : ∀ p < i.val, liftPermutation v p = liftPermutation w p)
    (hrank : ∀ k l, prefixCount (liftPermutation w) k l ≤
      prefixCount (liftPermutation v) k l)
    (hne : v i ≠ w i) :
    ∃ j : Fin N, i < j ∧ v i < v j ∧ v j ≤ w i ∧
      (∀ k l, prefixCount (liftPermutation w) k l ≤
        prefixCount (liftPermutation (v * Equiv.swap i j)) k l) := by
  obtain ⟨j, hij, hvij, hvjwi, _hminimal, hkeep⟩ :=
    finite_permutation_minimal_step v w i hprefix hrank hne
  exact ⟨j, hij, hvij, hvjwi, by simpa only [liftPermutation_swap] using hkeep⟩

/-- Pointwise order of all actual prefix-rank counts. -/
def RankLE {N : ℕ} (u v : Equiv.Perm (Fin N)) : Prop :=
  ∀ k l, prefixCount (liftPermutation u) k l ≤ prefixCount (liftPermutation v) k l

/-- A genuine increasing position swap. -/
def IncreasingSwap {N : ℕ} (v u : Equiv.Perm (Fin N)) : Prop :=
  ∃ i j : Fin N, i < j ∧ v i < v j ∧ u = v * Equiv.swap i j

/-- A finite natural-valued measure that strictly decreases under an increasing swap. -/
def rankWeight {N : ℕ} (v : Equiv.Perm (Fin N)) : ℕ :=
  ∑ kl ∈ (Finset.range (N + 1) ×ˢ Finset.range N),
    prefixCount (liftPermutation v) kl.1 kl.2

lemma swap_rankLE {N : ℕ} (v : Equiv.Perm (Fin N)) (i j : Fin N)
    (hij : i < j) (hvij : v i < v j) :
    RankLE (v * Equiv.swap i j) v := by
  intro k l
  have hvij' : liftPermutation v i.val < liftPermutation v j.val := by
    simpa only [liftPermutation_at] using (Fin.lt_def.mp hvij)
  have h := swap_rank_formula (liftPermutation v) i.val j.val k l hij hvij'
  rw [← liftPermutation_swap] at h
  omega

lemma rankWeight_swap_lt {N : ℕ} (v : Equiv.Perm (Fin N)) (i j : Fin N)
    (hij : i < j) (hvij : v i < v j) :
    rankWeight (v * Equiv.swap i j) < rankWeight v := by
  have hijNat := Fin.lt_def.mp hij
  unfold rankWeight
  apply Finset.sum_lt_sum
  · intro kl _hkl
    exact swap_rankLE v i j hij hvij kl.1 kl.2
  · refine ⟨(i.val + 1, (v i).val), ?_, ?_⟩
    · simp only [Finset.mem_product, Finset.mem_range]
      exact ⟨by omega, (v i).isLt⟩
    · change prefixCount (liftPermutation (v * Equiv.swap i j))
          (i.val + 1) (v i).val < prefixCount (liftPermutation v) (i.val + 1) (v i).val
      have h := swap_rectangle (liftPermutation v) i.val j.val
        (i.val + 1) (v i).val (by omega) (by omega)
        (by simp only [liftPermutation_at]; exact le_refl _)
        (by simpa only [liftPermutation_at] using (Fin.lt_def.mp hvij))
      rw [← liftPermutation_swap] at h
      omega

lemma exists_first_difference {N : ℕ} (v w : Equiv.Perm (Fin N)) (hne : v ≠ w) :
    ∃ i : Fin N, v i ≠ w i ∧
      ∀ p < i.val, liftPermutation v p = liftPermutation w p := by
  classical
  have hexFin : ∃ i : Fin N, v i ≠ w i := by
    by_contra hn
    apply hne
    apply Equiv.Perm.ext
    intro i
    by_contra hi
    exact hn ⟨i, hi⟩
  have hex : ∃ m, ∃ hm : m < N, v ⟨m, hm⟩ ≠ w ⟨m, hm⟩ := by
    obtain ⟨i, hi⟩ := hexFin
    exact ⟨i.val, i.isLt, hi⟩
  let m := Nat.find hex
  obtain ⟨hm, hneq⟩ := Nat.find_spec hex
  refine ⟨⟨m, hm⟩, hneq, ?_⟩
  intro p hpm
  change p < m at hpm
  have hmN : m < N := hm
  have hpN : p < N := lt_trans hpm hmN
  by_contra hpneq
  have hpfin : v ⟨p, hpN⟩ ≠ w ⟨p, hpN⟩ := by
    intro heq
    apply hpneq
    simpa only [liftPermutation, dite_eq_left hpN] using congrArg Fin.val heq
  have hle : m ≤ p := Nat.find_min' hex ⟨hpN, hpfin⟩
  exact (not_lt_of_ge hle) hpm

/-- Every finite permutation prefix-rank inequality is generated by a finite list of
    increasing swaps. Every permutation in the list remains between the two endpoints. -/
theorem rank_order_generated {N : ℕ} (v w : Equiv.Perm (Fin N)) (hrank : RankLE w v) :
    ∃ tail : List (Equiv.Perm (Fin N)),
      (v :: tail).IsChain IncreasingSwap ∧
      (v :: tail).getLast (List.cons_ne_nil v tail) = w ∧
      ∀ u ∈ v :: tail, RankLE w u ∧ RankLE u v := by
  classical
  have aux : ∀ m : ℕ, ∀ v : Equiv.Perm (Fin N), rankWeight v = m → RankLE w v →
      ∃ tail : List (Equiv.Perm (Fin N)),
        (v :: tail).IsChain IncreasingSwap ∧
        (v :: tail).getLast (List.cons_ne_nil v tail) = w ∧
        ∀ u ∈ v :: tail, RankLE w u ∧ RankLE u v := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
      intro v hweight hrank
      by_cases heq : v = w
      · subst v
        refine ⟨[], by simp, by simp, ?_⟩
        intro u hu
        have hueq : u = w := by simpa only [List.mem_singleton] using hu
        subst u
        exact ⟨fun _ _ => le_refl _, fun _ _ => le_refl _⟩
      · obtain ⟨i, hne_i, hprefix⟩ := exists_first_difference v w heq
        obtain ⟨j, hij, hvij, _hvjwi, hkeep⟩ :=
          finite_permutation_improvement v w i hprefix hrank hne_i
        have hdec : rankWeight (v * Equiv.swap i j) < m := by
          rw [← hweight]
          exact rankWeight_swap_lt v i j hij hvij
        obtain ⟨tail, hchain, hlast, hbounds⟩ :=
          ih (rankWeight (v * Equiv.swap i j)) hdec (v * Equiv.swap i j) rfl hkeep
        refine ⟨(v * Equiv.swap i j) :: tail, ?_, ?_, ?_⟩
        · exact List.isChain_cons_cons.mpr ⟨⟨i, j, hij, hvij, rfl⟩, hchain⟩
        · simpa only [List.getLast_cons_cons] using hlast
        · intro u hu
          rcases List.mem_cons.mp hu with hueq | hu
          · subst u
            exact ⟨hrank, fun _ _ => le_refl _⟩
          · have hb := hbounds u hu
            exact ⟨hb.1, fun k l => (hb.2 k l).trans (swap_rankLE v i j hij hvij k l)⟩
  exact aux (rankWeight v) v rfl hrank

end MAIS.PermutationRankOrder

#print axioms MAIS.PermutationRankOrder.first_difference_lt
#print axioms MAIS.PermutationRankOrder.minimal_index_slack
#print axioms MAIS.PermutationRankOrder.swap_rectangle

#print axioms MAIS.PermutationRankOrder.swap_rank_formula
#print axioms MAIS.PermutationRankOrder.minimal_swap_preserves_rank
#print axioms MAIS.PermutationRankOrder.exists_minimal_swap_index

#print axioms MAIS.PermutationRankOrder.finite_permutation_minimal_step

#print axioms MAIS.PermutationRankOrder.liftPermutation_swap

/--
info: 'MAIS.PermutationRankOrder.finite_permutation_improvement' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.PermutationRankOrder.finite_permutation_improvement

#print axioms MAIS.PermutationRankOrder.rankWeight_swap_lt
#print axioms MAIS.PermutationRankOrder.exists_first_difference

/--
info: 'MAIS.PermutationRankOrder.rank_order_generated' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.PermutationRankOrder.rank_order_generated
end
-- ==================== end module O7.PermutationRankOrder ====================

-- ==================== begin module O7.CanonicalPermutation (formalization/O7/CanonicalPermutation.lean) ====================
section

/-!
A genuine finite permutation associated to a nonnegative integer matrix.
The slots of the matrix are enumerated in two lexicographic orders.
Rows increase, and within each row columns decrease.  Values are ordered
by increasing column, decreasing row, and decreasing slot number.
-/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open scoped BigOperators

namespace MAIS.CanonicalPermutation

variable {m n : ℕ}

def mass (A : Fin m → Fin n → ℕ) : ℕ := ∑ i, ∑ j, A i j

def Event (A : Fin m → Fin n → ℕ) := (i : Fin m) × (j : Fin n) × Fin (A i j)

instance (A : Fin m → Fin n → ℕ) : Fintype (Event A) :=
  inferInstanceAs (Fintype ((i : Fin m) × (j : Fin n) × Fin (A i j)))

lemma event_card (A : Fin m → Fin n → ℕ) : Fintype.card (Event A) = mass A := by
  change Fintype.card (Σ i : Fin m, Σ j : Fin n, Fin (A i j)) = _
  rw [Fintype.card_sigma]
  apply Finset.sum_congr rfl
  intro i _hi
  rw [Fintype.card_sigma]
  simp only [Fintype.card_fin]

def RowEvent (A : Fin m → Fin n → ℕ) := Event A

def ColumnEvent (A : Fin m → Fin n → ℕ) := Event A

instance (A : Fin m → Fin n → ℕ) : Fintype (RowEvent A) :=
  inferInstanceAs (Fintype (Event A))

instance (A : Fin m → Fin n → ℕ) : Fintype (ColumnEvent A) :=
  inferInstanceAs (Fintype (Event A))

def rowKey (A : Fin m → Fin n → ℕ) (x : RowEvent A) :
    Fin m ×ₗ ((Fin n)ᵒᵈ ×ₗ ℕ) :=
  toLex (x.1, toLex (OrderDual.toDual x.2.1, x.2.2.val))

def columnKey (A : Fin m → Fin n → ℕ) (x : ColumnEvent A) :
    Fin n ×ₗ ((Fin m)ᵒᵈ ×ₗ ℕᵒᵈ) :=
  toLex (x.2.1, toLex (OrderDual.toDual x.1, OrderDual.toDual x.2.2.val))

lemma rowKey_injective (A : Fin m → Fin n → ℕ) : Function.Injective (rowKey A) := by
  intro x y h
  rcases x with ⟨i, j, t⟩
  rcases y with ⟨i', j', t'⟩
  have hplain : (i, j, t.val) = (i', j', t'.val) := h
  have hi : i = i' := congrArg Prod.fst hplain
  subst i'
  have hj : j = j' := congrArg (fun k => k.2.1) hplain
  subst j'
  have ht : t.val = t'.val := congrArg (fun k => k.2.2) hplain
  have heq : t = t' := Fin.ext ht
  subst t'
  rfl

lemma columnKey_injective (A : Fin m → Fin n → ℕ) :
    Function.Injective (columnKey A) := by
  intro x y h
  rcases x with ⟨i, j, t⟩
  rcases y with ⟨i', j', t'⟩
  have hplain : (j, i, t.val) = (j', i', t'.val) := h
  have hj : j = j' := congrArg Prod.fst hplain
  subst j'
  have hi : i = i' := congrArg (fun k => k.2.1) hplain
  subst i'
  have ht : t.val = t'.val := congrArg (fun k => k.2.2) hplain
  have heq : t = t' := Fin.ext ht
  subst t'
  rfl

noncomputable instance rowLinearOrder (A : Fin m → Fin n → ℕ) :
    LinearOrder (RowEvent A) := LinearOrder.lift' (rowKey A) (rowKey_injective A)

noncomputable instance columnLinearOrder (A : Fin m → Fin n → ℕ) :
    LinearOrder (ColumnEvent A) := LinearOrder.lift' (columnKey A) (columnKey_injective A)

noncomputable def rowEnumeration (A : Fin m → Fin n → ℕ) :
    Fin (mass A) ≃o RowEvent A :=
  Fintype.orderIsoFinOfCardEq (RowEvent A) (event_card A)

noncomputable def columnEnumeration (A : Fin m → Fin n → ℕ) :
    Fin (mass A) ≃o ColumnEvent A :=
  Fintype.orderIsoFinOfCardEq (ColumnEvent A) (event_card A)

def rowToColumn (A : Fin m → Fin n → ℕ) : RowEvent A ≃ ColumnEvent A := Equiv.refl _

noncomputable def canonical (A : Fin m → Fin n → ℕ) : Equiv.Perm (Fin (mass A)) :=
  (rowEnumeration A).toEquiv.trans
    ((rowToColumn A).trans (columnEnumeration A).symm.toEquiv)

lemma canonical_event (A : Fin m → Fin n → ℕ) (p : Fin (mass A)) :
    columnEnumeration A (canonical A p) = rowToColumn A (rowEnumeration A p) := by
  simp [canonical]

/-- Row labels of the actual position enumeration are nondecreasing. -/
lemma row_monotone (A : Fin m → Fin n → ℕ) :
    Monotone (fun p : Fin (mass A) => (rowEnumeration A p).1) := by
  intro p q hpq
  have hk : rowKey A (rowEnumeration A p) ≤ rowKey A (rowEnumeration A q) :=
    (rowEnumeration A).monotone hpq
  simp only [rowKey, Prod.Lex.toLex_le_toLex] at hk
  rcases hk with h | ⟨h, _⟩
  · exact le_of_lt h
  · exact le_of_eq h

/-- Column labels of the actual value enumeration are nondecreasing. -/
lemma column_monotone (A : Fin m → Fin n → ℕ) :
    Monotone (fun p : Fin (mass A) => (columnEnumeration A p).2.1) := by
  intro p q hpq
  have hk : columnKey A (columnEnumeration A p) ≤ columnKey A (columnEnumeration A q) :=
    (columnEnumeration A).monotone hpq
  simp only [columnKey, Prod.Lex.toLex_le_toLex] at hk
  rcases hk with h | ⟨h, _⟩
  · exact le_of_lt h
  · exact le_of_eq h

/-- Inside one row block, the actual permutation values strictly decrease. -/
theorem canonical_row_decreasing (A : Fin m → Fin n → ℕ)
    (p q : Fin (mass A)) (hpq : p < q)
    (hrow : (rowEnumeration A p).1 = (rowEnumeration A q).1) :
    canonical A q < canonical A p := by
  have hk : rowKey A (rowEnumeration A p) < rowKey A (rowEnumeration A q) :=
    (rowEnumeration A).strictMono hpq
  have hc : columnKey A (rowToColumn A (rowEnumeration A q)) <
      columnKey A (rowToColumn A (rowEnumeration A p)) := by
    simp only [rowKey, Prod.Lex.toLex_lt_toLex] at hk
    simp only [columnKey, rowToColumn, Prod.Lex.toLex_lt_toLex]
    rcases hk with h | ⟨_, h⟩
    · exact False.elim ((not_lt_of_ge (le_of_eq hrow.symm)) h)
    · rcases h with h | ⟨h, ht⟩
      · exact Or.inl h
      · exact Or.inr ⟨h.symm, Or.inr ⟨hrow.symm, ht⟩⟩
  have ht : columnEnumeration A (canonical A q) < columnEnumeration A (canonical A p) := by
    rw [canonical_event, canonical_event]
    exact hc
  exact (columnEnumeration A).lt_iff_lt.mp ht

/-- Inside one column block, the positions occupied by increasing values strictly decrease. -/
theorem canonical_column_decreasing (A : Fin m → Fin n → ℕ)
    (p q : Fin (mass A)) (hpq : p < q)
    (hcol : (columnEnumeration A p).2.1 = (columnEnumeration A q).2.1) :
    (canonical A).symm q < (canonical A).symm p := by
  have hk : columnKey A (columnEnumeration A p) < columnKey A (columnEnumeration A q) :=
    (columnEnumeration A).strictMono hpq
  have hrowevent (r : Fin (mass A)) :
      rowEnumeration A ((canonical A).symm r) = (columnEnumeration A r : Event A) := by
    have h := canonical_event A ((canonical A).symm r)
    simp only [Equiv.apply_symm_apply] at h
    change (columnEnumeration A r : Event A) = (rowEnumeration A ((canonical A).symm r) : Event A) at h
    exact h.symm
  have hc : rowKey A (columnEnumeration A q : Event A) <
      rowKey A (columnEnumeration A p : Event A) := by
    simp only [columnKey, Prod.Lex.toLex_lt_toLex] at hk
    simp only [rowKey, Prod.Lex.toLex_lt_toLex]
    rcases hk with h | ⟨_, h⟩
    · exact False.elim ((not_lt_of_ge (le_of_eq hcol.symm)) h)
    · rcases h with h | ⟨h, ht⟩
      · exact Or.inl h
      · exact Or.inr ⟨h.symm, Or.inr ⟨hcol.symm, ht⟩⟩
  apply (rowEnumeration A).lt_iff_lt.mp
  rw [hrowevent, hrowevent]
  exact hc


lemma canonical_column (A : Fin m → Fin n → ℕ) (p : Fin (mass A)) :
    (columnEnumeration A (canonical A p)).2.1 = (rowEnumeration A p).2.1 := by
  have h := canonical_event A p
  exact congrArg (fun e : ColumnEvent A => e.2.1) h

/-- Counting actual matrix slots with a predicate counts their multiplicities. -/
lemma event_count (A : Fin m → Fin n → ℕ) (P : Fin m → Fin n → Prop)
    [DecidableRel P] :
    ((Finset.univ : Finset (RowEvent A)).filter (fun e => P e.1 e.2.1)).card =
      ∑ i, ∑ j, if P i j then A i j else 0 := by
  classical
  simp only [Finset.card_eq_sum_ones, Finset.sum_filter]
  change (∑ e : (Σ i : Fin m, Σ j : Fin n, Fin (A i j)),
    if P e.1 e.2.1 then 1 else 0) = _
  rw [Fintype.sum_sigma]
  apply Finset.sum_congr rfl
  intro i _hi
  rw [Fintype.sum_sigma]
  apply Finset.sum_congr rfl
  intro j _hj
  by_cases h : P i j
  · simp [h]
  · simp [h]

/-- Actual counts in fixed row and value-column blocks. -/
noncomputable def blockCount (A : Fin m → Fin n → ℕ) (i : Fin m) (j : Fin n) : ℕ :=
  ((Finset.univ : Finset (Fin (mass A))).filter (fun p =>
    (rowEnumeration A p).1 ≤ i ∧
      (columnEnumeration A (canonical A p)).2.1 ≤ j)).card

/-- The constructed permutation really has the prescribed northwest block counts. -/
theorem canonical_block_count (A : Fin m → Fin n → ℕ) (i : Fin m) (j : Fin n) :
    blockCount A i j = ∑ r, ∑ c, if r ≤ i ∧ c ≤ j then A r c else 0 := by
  classical
  unfold blockCount
  simp only [canonical_column]
  rw [Finset.card_eq_sum_ones, Finset.sum_filter]
  have h := (rowEnumeration A).toEquiv.sum_comp (fun e : RowEvent A =>
    if e.1 ≤ i ∧ e.2.1 ≤ j then (1 : ℕ) else 0)
  have hc := event_count A (fun r c => r ≤ i ∧ c ≤ j)
  exact h.trans (by simpa only [Finset.card_eq_sum_ones, Finset.sum_filter] using hc)

/-- Any nondecreasing finite labelling has initial-segment label cuts. -/
lemma monotone_cut {N d : ℕ} (f : Fin N → Fin d) (hf : Monotone f)
    (i : Fin d) (p : Fin N) :
    f p < i ↔ p.val < ((Finset.univ : Finset (Fin N)).filter (fun q => f q < i)).card := by
  classical
  let S := (Finset.univ : Finset (Fin N)).filter (fun q => f q < i)
  constructor
  · intro hp
    have hsub : Finset.Iic p ⊆ S := by
      intro q hq
      simp only [Finset.mem_Iic] at hq
      simp only [S, Finset.mem_filter, Finset.mem_univ, true_and]
      exact lt_of_le_of_lt (hf hq) hp
    have hcard := Finset.card_le_card hsub
    rw [Fin.card_Iic] at hcard
    exact Nat.lt_of_succ_le hcard
  · intro hp
    by_contra hnot
    have hsub : S ⊆ Finset.Iio p := by
      intro q hq
      simp only [S, Finset.mem_filter, Finset.mem_univ, true_and] at hq
      simp only [Finset.mem_Iio]
      by_contra hqp
      have hpq : p ≤ q := le_of_not_gt hqp
      have hpi := lt_of_le_of_lt (hf hpq) hq
      exact hnot hpi
    have hcard := Finset.card_le_card hsub
    rw [Fin.card_Iio] at hcard
    exact (not_lt_of_ge hcard) hp


/-- Cardinalities of slot predicates are preserved by any actual enumeration. -/
lemma enumeration_count (A : Fin m → Fin n → ℕ)
    (e : Fin (mass A) ≃ RowEvent A) (P : Fin m → Fin n → Prop) [DecidableRel P] :
    ((Finset.univ : Finset (Fin (mass A))).filter (fun p => P (e p).1 (e p).2.1)).card =
      ∑ i, ∑ j, if P i j then A i j else 0 := by
  classical
  rw [Finset.card_eq_sum_ones, Finset.sum_filter]
  have h := e.sum_comp (fun x : RowEvent A => if P x.1 x.2.1 then (1 : ℕ) else 0)
  have hc := event_count A P
  exact h.trans (by simpa only [Finset.card_eq_sum_ones, Finset.sum_filter] using hc)

/-- An initial-segment count for a nondecreasing natural-number label. -/
lemma monotone_cut_nat {N : ℕ} (f : Fin N → ℕ) (hf : Monotone f)
    (i : ℕ) (p : Fin N) :
    f p < i ↔ p.val < ((Finset.univ : Finset (Fin N)).filter (fun q => f q < i)).card := by
  classical
  let S := (Finset.univ : Finset (Fin N)).filter (fun q => f q < i)
  constructor
  · intro hp
    have hsub : Finset.Iic p ⊆ S := by
      intro q hq
      simp only [Finset.mem_Iic] at hq
      simp only [S, Finset.mem_filter, Finset.mem_univ, true_and]
      exact lt_of_le_of_lt (hf hq) hp
    have hcard := Finset.card_le_card hsub
    rw [Fin.card_Iic] at hcard
    exact Nat.lt_of_succ_le hcard
  · intro hp
    by_contra hnot
    have hsub : S ⊆ Finset.Iio p := by
      intro q hq
      simp only [S, Finset.mem_filter, Finset.mem_univ, true_and] at hq
      simp only [Finset.mem_Iio]
      by_contra hqp
      have hpq : p ≤ q := le_of_not_gt hqp
      exact hnot (lt_of_le_of_lt (hf hpq) hq)
    have hcard := Finset.card_le_card hsub
    rw [Fin.card_Iio] at hcard
    exact (not_lt_of_ge hcard) hp

def rowBoundary (A : Fin m → Fin n → ℕ) (i : ℕ) : ℕ :=
  ∑ r, ∑ c, if r.val < i then A r c else 0

def columnBoundary (A : Fin m → Fin n → ℕ) (j : ℕ) : ℕ :=
  ∑ r, ∑ c, if c.val < j then A r c else 0

def northWest (A : Fin m → Fin n → ℕ) (i j : ℕ) : ℕ :=
  ∑ r, ∑ c, if r.val < i ∧ c.val < j then A r c else 0

lemma rowBoundary_le_mass (A : Fin m → Fin n → ℕ) (i : ℕ) :
    rowBoundary A i ≤ mass A := by
  apply Finset.sum_le_sum
  intro r _hr
  apply Finset.sum_le_sum
  intro c _hc
  split_ifs <;> omega

lemma columnBoundary_le_mass (A : Fin m → Fin n → ℕ) (j : ℕ) :
    columnBoundary A j ≤ mass A := by
  apply Finset.sum_le_sum
  intro r _hr
  apply Finset.sum_le_sum
  intro c _hc
  split_ifs <;> omega

lemma rowBoundary_mono (A : Fin m → Fin n → ℕ) : Monotone (rowBoundary A) := by
  intro i j hij
  apply Finset.sum_le_sum
  intro r _hr
  apply Finset.sum_le_sum
  intro c _hc
  split_ifs <;> omega

lemma columnBoundary_mono (A : Fin m → Fin n → ℕ) : Monotone (columnBoundary A) := by
  intro i j hij
  apply Finset.sum_le_sum
  intro r _hr
  apply Finset.sum_le_sum
  intro c _hc
  split_ifs <;> omega

lemma row_cut (A : Fin m → Fin n → ℕ) (i : ℕ) (p : Fin (mass A)) :
    (rowEnumeration A p).1.val < i ↔ p.val < rowBoundary A i := by
  have hmono : Monotone (fun p : Fin (mass A) => (rowEnumeration A p).1.val) := by
    intro p q hpq
    exact row_monotone A hpq
  have hcut := monotone_cut_nat _ hmono i p
  have hcount := enumeration_count A (rowEnumeration A).toEquiv (fun r _c => r.val < i)
  have hcount' : ((Finset.univ : Finset (Fin (mass A))).filter
      (fun q => (rowEnumeration A q).1.val < i)).card = rowBoundary A i := hcount
  exact hcut.trans (by rw [hcount'])

lemma column_cut (A : Fin m → Fin n → ℕ) (j : ℕ) (p : Fin (mass A)) :
    (columnEnumeration A p).2.1.val < j ↔ p.val < columnBoundary A j := by
  have hmono : Monotone (fun p : Fin (mass A) => (columnEnumeration A p).2.1.val) := by
    intro p q hpq
    exact column_monotone A hpq
  have hcut := monotone_cut_nat _ hmono j p
  have hcount := enumeration_count A
    ((columnEnumeration A).toEquiv.trans (rowToColumn A).symm) (fun _r c => c.val < j)
  have hcount' : ((Finset.univ : Finset (Fin (mass A))).filter
      (fun q => (columnEnumeration A q).2.1.val < j)).card = columnBoundary A j := hcount
  exact hcut.trans (by rw [hcount'])

/-- A position between the actual cumulative row margins has that row label. -/
theorem row_label_of_bounds (A : Fin m → Fin n → ℕ) (i : Fin m)
    (p : Fin (mass A)) (hlo : rowBoundary A i.val ≤ p.val)
    (hhi : p.val < rowBoundary A (i.val + 1)) :
    (rowEnumeration A p).1 = i := by
  have hsmall := row_cut A i.val p
  have hlarge := row_cut A (i.val + 1) p
  apply Fin.ext
  omega

/-- A value between the actual cumulative column margins has that column label. -/
theorem column_label_of_bounds (A : Fin m → Fin n → ℕ) (j : Fin n)
    (p : Fin (mass A)) (hlo : columnBoundary A j.val ≤ p.val)
    (hhi : p.val < columnBoundary A (j.val + 1)) :
    (columnEnumeration A p).2.1 = j := by
  have hsmall := column_cut A j.val p
  have hlarge := column_cut A (j.val + 1) p
  apply Fin.ext
  omega

end MAIS.CanonicalPermutation



