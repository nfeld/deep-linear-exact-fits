-- ==================== begin module O7.Run2PositiveGaugeTransport (formalization/O7/Run2PositiveGaugeTransport.lean) ====================
section

/-! Actual pointed complete/subpath losses under genuine gauge and vertex
coordinate changes. The target is transformed with its actual center; no
zero-output hypothesis is imposed. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PositiveGaugeTransport
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open MAIS.QuiverGaugeMeasuredPair MAIS.QuiverCoordinateMeasuredPair
open MAIS.Run2SchurProductNorm MAIS.AnalyticTransfer
variable {D : ℕ} (ι : Fin (D+1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- The actual pointed residual transforms by actual endpoint units. -/
theorem path_difference_gauge (g : Gauge ι) (A B : Rep ι)
    (i j : Fin (D+1)) (hij : i ≤ j) :
    pathMatrix (g • B) i j hij-pathMatrix (g • A) i j hij =
      (↑(g j) : Matrix (ι j) (ι j) ℝ) *
        (pathMatrix B i j hij-pathMatrix A i j hij) *
          (↑((g i)⁻¹) : Matrix (ι i) (ι i) ℝ) := by
  simp only [pathMatrix_gauge,Matrix.mul_sub,Matrix.sub_mul]

theorem norm_path_difference_gauge_le (g : Gauge ι) (A B : Rep ι)
    (i j : Fin (D+1)) (hij : i ≤ j) :
    ‖pathMatrix (g • B) i j hij-pathMatrix (g • A) i j hij‖ ≤
      (‖(↑(g j) : Matrix (ι j) (ι j) ℝ)‖*
        ‖(↑((g i)⁻¹) : Matrix (ι i) (ι i) ℝ)‖)*
          ‖pathMatrix B i j hij-pathMatrix A i j hij‖ := by
  rw [path_difference_gauge]
  exact norm_triple_le _ _ _

/-- Gauge transport for the actual centered squared residual, at any output
rank. Actual Haar measures may have different normalizations. -/
theorem pair_iff_gauge_pointed
    (mu nu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]
    (g : Gauge ι) (A : Rep ι) (i j : Fin (D+1)) (hij : i ≤ j) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B i j hij-pathMatrix A i j hij‖^2) A lam m ↔
    HasMeasuredBandPair nu (Metric.ball (g • A))
      (fun B => ‖pathMatrix B i j hij-pathMatrix (g • A) i j hij‖^2) (g • A) lam m := by
  let f : Rep ι → ℝ := fun B => ‖pathMatrix B i j hij-pathMatrix A i j hij‖^2
  let F : Rep ι → ℝ := fun B => ‖pathMatrix (g • B) i j hij-pathMatrix (g • A) i j hij‖^2
  let K := ‖(↑(g j) : Matrix (ι j) (ι j) ℝ)‖*
    ‖(↑((g i)⁻¹) : Matrix (ι i) (ι i) ℝ)‖+1
  let L := ‖(↑((g j)⁻¹) : Matrix (ι j) (ι j) ℝ)‖*
    ‖(↑(g i) : Matrix (ι i) (ι i) ℝ)‖+1
  have hK : 0 < K := by dsimp [K]; positivity
  have hL : 0 < L := by dsimp [L]; positivity
  have hupper (B : Rep ι) : F B ≤ K^2*f B := by
    have hn : ‖pathMatrix (g • B) i j hij-pathMatrix (g • A) i j hij‖ ≤
        K*‖pathMatrix B i j hij-pathMatrix A i j hij‖ :=
      (norm_path_difference_gauge_le ι g A B i j hij).trans
        (mul_le_mul_of_nonneg_right (by dsimp [K]; linarith) (norm_nonneg _))
    simpa only [f,F,mul_pow] using
      (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hK.le (norm_nonneg _))).mpr hn
  have hlower (B : Rep ι) : f B ≤ L^2*F B := by
    have hn0 := norm_path_difference_gauge_le ι g⁻¹ (g • A) (g • B) i j hij
    simp only [inv_smul_smul,Pi.inv_apply,inv_inv] at hn0
    have hn : ‖pathMatrix B i j hij-pathMatrix A i j hij‖ ≤
        L*‖pathMatrix (g • B) i j hij-pathMatrix (g • A) i j hij‖ :=
      hn0.trans (mul_le_mul_of_nonneg_right (by dsimp [L]; linarith) (norm_nonneg _))
    simpa only [f,F,mul_pow] using
      (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hL.le (norm_nonneg _))).mpr hn
  have hf0 : f A = 0 := by simp [f]
  have hF0 : F A = 0 := by simp [F]
  have hcomp : ∀ B ∈ Metric.ball A 1,
      (1/L^2)*|f B-f A| ≤ |F B-F A| ∧ |F B-F A| ≤ K^2*|f B-f A| := by
    intro B _
    rw [hf0,hF0,sub_zero,sub_zero,abs_of_nonneg (sq_nonneg _),abs_of_nonneg (sq_nonneg _)]
    constructor
    · have h : f B/L^2 ≤ F B := (div_le_iff₀ (sq_pos_of_pos hL)).mpr (by simpa only [mul_comm] using hlower B)
      simpa only [one_div,div_eq_mul_inv,mul_comm,one_mul,mul_one] using h
    · exact hupper B
  have hcmp := MAIS.AnalyticTransfer.pair_iff_of_local_comparison
    (mu:=mu) (windows:=Metric.ball A) (f:=f) (g:=F)
    (fun _ _ hab => Metric.ball_subset_ball hab) zero_lt_one
    (one_div_pos.mpr (sq_pos_of_pos hL)) (sq_pos_of_pos hK) hcomp (lam:=lam) (m:=m)
  have hlin := MAIS.LinearObservationTransfer.pair_iff_haar_linear mu nu
    (gaugeContinuousEquiv ι g) A
    (((continuous_pathMatrix i j hij).sub continuous_const).norm.pow 2).measurable
      (g := fun B => ‖pathMatrix B i j hij-pathMatrix (g • A) i j hij‖^2) (lam:=lam) (m:=m)
  exact hcmp.trans hlin

end MAIS.Run2PositiveGaugeTransport

/-- info: 'MAIS.Run2PositiveGaugeTransport.path_difference_gauge' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveGaugeTransport.path_difference_gauge

/-- info: 'MAIS.Run2PositiveGaugeTransport.norm_path_difference_gauge_le' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveGaugeTransport.norm_path_difference_gauge_le

/-- info: 'MAIS.Run2PositiveGaugeTransport.pair_iff_gauge_pointed' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveGaugeTransport.pair_iff_gauge_pointed
end
end
