-- ==================== begin module O7.QuiverCoordinateMeasuredPair (formalization/O7/QuiverCoordinateMeasuredPair.lean) ====================
section

/-! Actual full-entry measured-pair invariance under arbitrary vertex
index bijections. The literal Frobenius loss is exactly preserved, so
no zero-output assumption is needed. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.QuiverCoordinateMeasuredPair
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.MatrixCoordinateTransport MAIS.AnalyticTransfer

variable {D : ℕ} {ι κ : Fin (D+1) → Type*}
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]
  [∀v,Fintype (κ v)] [∀v,DecidableEq (κ v)]

/-- Actual reindexing, with its actual inverse, is linear on the full
independent matrix-entry parameter space. -/
def coordinateLinearEquiv (e : ∀v,ι v ≃ κ v) : Rep ι ≃ₗ[ℝ] Rep κ where
  toFun := transport e
  invFun := transport (fun v => (e v).symm)
  left_inv A := by ext a r s; simp [transport,Matrix.submatrix_apply]
  right_inv A := by ext a r s; simp [transport,Matrix.submatrix_apply]
  map_add' A B := rfl
  map_smul' c A := rfl

/-- Finite-dimensional continuity of both actual coordinate maps. -/
def coordinateContinuousEquiv (e : ∀v,ι v ≃ κ v) : Rep ι ≃L[ℝ] Rep κ :=
  (coordinateLinearEquiv e).toContinuousLinearEquiv

lemma frobenius_norm_reindex {I J K L : Type*}
    [Fintype I] [Fintype J] [Fintype K] [Fintype L]
    (er : I ≃ K) (ec : J ≃ L) (M : Matrix I J ℝ) :
    ‖M.submatrix er.symm ec.symm‖ = ‖M‖ := by
  rw [Matrix.frobenius_norm_def,Matrix.frobenius_norm_def]
  congr 1
  simp only [Matrix.submatrix_apply]
  calc
    (∑r,∑c,‖M (er.symm r) (ec.symm c)‖^(2:ℝ)) =
        ∑r,∑c,‖M r (ec.symm c)‖^(2:ℝ) := er.symm.sum_comp (fun r : I => ∑c : L,‖M r (ec.symm c)‖^(2:ℝ))
    _ = ∑r,∑c,‖M r c‖^(2:ℝ) := by
      apply Finset.sum_congr rfl
      intro r _
      exact ec.symm.sum_comp (fun c : J => ‖M r c‖^(2:ℝ))

/-- The actual consecutive-arrow Frobenius loss is exactly invariant. -/
theorem norm_path_transport (e : ∀v,ι v ≃ κ v) (A : Rep ι)
    (i j : Fin (D+1)) (hij : i≤j) :
    ‖pathMatrix (transport e A) i j hij‖ = ‖pathMatrix A i j hij‖ := by
  rw [path_transport]
  exact frobenius_norm_reindex (e j) (e i) _

/-- Actual radius-first Haar pairs agree on the two full-entry carriers.
It holds at arbitrary loss levels, hence in particular on the zero fiber. -/
theorem pair_iff_coordinate_transport (e : ∀v,ι v ≃ κ v)
    (mu : Measure (Rep ι)) (nu : Measure (Rep κ))
    [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]
    (A : Rep ι) (i j : Fin (D+1)) (hij : i≤j) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B i j hij‖^2) A lam m ↔
    HasMeasuredBandPair nu (Metric.ball (transport e A))
      (fun B => ‖pathMatrix B i j hij‖^2) (transport e A) lam m := by
  have hp := MAIS.LinearObservationTransfer.pair_iff_haar_linear mu nu
    (coordinateContinuousEquiv e) A
    ((continuous_pathMatrix i j hij).norm.pow 2).measurable (lam := lam) (m := m)
  have heq : (fun B : Rep ι => ‖pathMatrix (coordinateContinuousEquiv e B) i j hij‖^2) =
      (fun B : Rep ι => ‖pathMatrix B i j hij‖^2) := by
    funext B
    exact congrArg (fun t : ℝ => t^2) (norm_path_transport e B i j hij)
  change HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix (coordinateContinuousEquiv e B) i j hij‖^2) A lam m ↔ _ at hp
  rw [heq] at hp
  exact hp

end MAIS.QuiverCoordinateMeasuredPair

/-- info: 'MAIS.QuiverCoordinateMeasuredPair.coordinateContinuousEquiv' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverCoordinateMeasuredPair.coordinateContinuousEquiv

/-- info: 'MAIS.QuiverCoordinateMeasuredPair.norm_path_transport' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverCoordinateMeasuredPair.norm_path_transport

/-- info: 'MAIS.QuiverCoordinateMeasuredPair.pair_iff_coordinate_transport' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverCoordinateMeasuredPair.pair_iff_coordinate_transport
end
end
-- ==================== end module O7.QuiverCoordinateMeasuredPair ====================

-- ==================== begin module O7.Run2PositiveCoordinateTransport (formalization/O7/Run2PositiveCoordinateTransport.lean) ====================
section

/-! Genuine pointed-loss invariance under actual vertex index bijections,
including arbitrary output rank and arbitrary finite dimensions. -/
set_option autoImplicit false
set_option maxHeartbeats 1800000
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PositiveCoordinateTransport
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.MatrixCoordinateTransport
open MAIS.QuiverCoordinateMeasuredPair MAIS.AnalyticTransfer
variable {D : ℕ} {ι κ : Fin (D+1) → Type*}
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]
  [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

/-- Actual coordinate permutations preserve the literal pointed residual norm. -/
theorem norm_path_difference_transport (e : ∀ v, ι v ≃ κ v) (A B : Rep ι)
    (i j : Fin (D+1)) (hij : i ≤ j) :
    ‖pathMatrix (transport e B) i j hij-pathMatrix (transport e A) i j hij‖ =
      ‖pathMatrix B i j hij-pathMatrix A i j hij‖ := by
  rw [path_transport,path_transport]
  convert frobenius_norm_reindex (e j) (e i)
    (pathMatrix B i j hij-pathMatrix A i j hij) using 1
  rfl

/-- Literal full-entry Haar pairs for pointed path losses are unchanged by
an actual bijection at each vertex; no zero-output hypothesis is needed. -/
theorem pair_iff_coordinate_pointed (e : ∀ v, ι v ≃ κ v)
    (mu : Measure (Rep ι)) (nu : Measure (Rep κ))
    [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]
    (A : Rep ι) (i j : Fin (D+1)) (hij : i ≤ j) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B i j hij-pathMatrix A i j hij‖^2) A lam m ↔
    HasMeasuredBandPair nu (Metric.ball (transport e A))
      (fun B => ‖pathMatrix B i j hij-pathMatrix (transport e A) i j hij‖^2)
      (transport e A) lam m := by
  have hp := MAIS.LinearObservationTransfer.pair_iff_haar_linear mu nu
    (coordinateContinuousEquiv e) A
    (((continuous_pathMatrix i j hij).sub continuous_const).norm.pow 2).measurable
    (g := fun B => ‖pathMatrix B i j hij-pathMatrix (transport e A) i j hij‖^2)
    (lam:=lam) (m:=m)
  have heq : (fun B : Rep ι =>
      ‖pathMatrix (coordinateContinuousEquiv e B) i j hij-
        pathMatrix (transport e A) i j hij‖^2) =
      (fun B => ‖pathMatrix B i j hij-pathMatrix A i j hij‖^2) := by
    funext B
    exact congrArg (fun x : ℝ => x^2) (norm_path_difference_transport e A B i j hij)
  change HasMeasuredBandPair mu (Metric.ball A)
    (fun B => ‖pathMatrix (coordinateContinuousEquiv e B) i j hij-
      pathMatrix (transport e A) i j hij‖^2) A lam m ↔ _ at hp
  rw [heq] at hp
  exact hp

end MAIS.Run2PositiveCoordinateTransport

/-- info: 'MAIS.Run2PositiveCoordinateTransport.norm_path_difference_transport' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveCoordinateTransport.norm_path_difference_transport

/-- info: 'MAIS.Run2PositiveCoordinateTransport.pair_iff_coordinate_pointed' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveCoordinateTransport.pair_iff_coordinate_pointed
end
end
-- ==================== end module O7.Run2PositiveCoordinateTransport ====================

-- ==================== begin module O7.Run2PositiveRetainedChart (formalization/O7/Run2PositiveRetainedChart.lean) ====================
section

/-! A genuine analytic retaining chart for actual positive-target network regular
coordinates, with surjectivity derived from actual endpoint Lie variations. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace MAIS.Run2PositiveRetainedChart
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.Run2PositiveEndpointRegular MAIS.Run2PositiveRegularChart
open MAIS.Run2ParameterRetainingLinear MAIS.Run2ParameterRetainingChart
open MAIS.Run2ParameterRetainingAnalytic
open scoped Matrix Matrix.Norms.Frobenius ContDiff Topology
variable {D : ℕ} {R : Type*} [Fintype R] [DecidableEq R]
  (κ : Fin (D+1) → Type*) [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

/-- Construct the actual full coordinate chart, retaining the literal normal
parameter in both directions. No inverse, additional regular-derivative kernel
splitting, Jacobian estimate, or endpoint-surjectivity hypothesis is supplied. -/
theorem exists_actual_positive_retaining_chart
    (hD : 0 < D) (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (Carrier (R:=R) κ) A).range N) :
    ∃ e : OpenPartialHomeomorph (H × N)
        ((MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0) ×
          Kernel (fderiv ℝ (regularMap κ A H N) 0)) × N),
      0 ∈ e.source ∧ 0 ∈ e.target ∧ e 0 = 0 ∧
      (∀ p, (e p).2 = p.2 ∧ (e p).1.1 = regularMap κ A H N p) ∧
      (∀ y ∈ e.target, (e.symm y).2 = y.2 ∧
        regularMap κ A H N (e.symm y) = y.1.1) ∧
      (∀ p, AnalyticAt ℝ e p) ∧
      ∃ U, IsOpen U ∧ 0 ∈ U ∧ U ⊆ e.target ∧
        ∀ y ∈ U, AnalyticAt ℝ e.symm y := by
  obtain ⟨s,hs,e,he,hsource,htarget,ha,hinv,hU⟩ :=
    exists_retained_analytic_chart (regularMap κ A H N)
      (contDiff_regularMap κ A H N) (regularMap_zero κ A hA H N)
      (gaugeDerivative_regularMap_surjective κ hD A hA H N hH hN)
  refine ⟨e,hsource,htarget, ?_, ?_, hinv,ha,hU⟩
  · rw [he]
    simp only [coordinateMap_zero,regularMap_zero κ A hA H N]
    ext <;> simp
  · intro p
    rw [he]
    exact ⟨rfl,rfl⟩

omit [DecidableEq R] [∀ v, DecidableEq (κ v)] in
/-- Derived actual dimension of the three independent regular output blocks. -/
theorem finrank_regular_space :
    Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0)) =
      Fintype.card R * Fintype.card R +
        Fintype.card R * Fintype.card (κ 0) +
          Fintype.card (κ (Fin.last D)) * Fintype.card R := by
  simp only [MAIS.Run2PositiveEndpointRegular.RegularSpace,Module.finrank_prod,Module.finrank_matrix,
    Module.finrank_self,mul_one]
  omega

end MAIS.Run2PositiveRetainedChart

/-- info: 'MAIS.Run2PositiveRetainedChart.exists_actual_positive_retaining_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveRetainedChart.exists_actual_positive_retaining_chart

/-- info: 'MAIS.Run2PositiveRetainedChart.finrank_regular_space' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveRetainedChart.finrank_regular_space
end
end
