-- ==================== begin module O7.Run2GeometricZeroFiber (formalization/O7/Run2GeometricZeroFiber.lean) ====================
section

/-! Genuine local Hausdorff dimension of the actual full zero-product fiber,
computed from a finite union of actual ordinary real gauge orbits. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricZeroFiber
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear MAIS.QuiverOrbitRank
open MAIS.QuiverOrbitFiniteHeight MAIS.Run2GeometricOrbitDimension
open MAIS.Run2GeometricCharts MAIS.Run2GeometricLocal

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- The literal full matrix-product zero set, including depth zero. -/
def zeroFiber : Set (Rep ι) :=
  {A | pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0}

/-- Only actual orbit classes containing an actual zero product are retained. -/
def ZeroOrbitIndex :=
  {q : MulAction.orbitRel.Quotient (Gauge ι) (Rep ι) //
    ∃ A : Rep ι, A ∈ zeroFiber ι ∧ Quotient.mk'' A = q}

instance : Fintype (ZeroOrbitIndex ι) := by
  unfold ZeroOrbitIndex
  exact Fintype.ofFinite _

def representative (j : ZeroOrbitIndex ι) : Rep ι :=
  Classical.choose j.property

theorem representative_spec (j : ZeroOrbitIndex ι) :
    representative ι j ∈ zeroFiber ι ∧ Quotient.mk'' (representative ι j) = j.val :=
  Classical.choose_spec j.property

theorem mem_zeroFiber_of_mem_orbit {A B : Rep ι}
    (hAB : A ∈ MulAction.orbit (Gauge ι) B) (hB : B ∈ zeroFiber ι) :
    A ∈ zeroFiber ι := by
  obtain ⟨g, rfl⟩ := MulAction.mem_orbit_iff.mp hAB
  change pathMatrix (g • B) 0 (Fin.last D) (Nat.zero_le D) = 0
  change pathMatrix B 0 (Fin.last D) (Nat.zero_le D) = 0 at hB
  rw [pathMatrix_gauge, hB, Matrix.mul_zero, Matrix.zero_mul]

theorem zeroFiber_eq_iUnion_orbits :
    zeroFiber ι = ⋃ j : ZeroOrbitIndex ι,
      MulAction.orbit (Gauge ι) (representative ι j) := by
  ext A
  constructor
  · intro hA
    let j : ZeroOrbitIndex ι := ⟨Quotient.mk'' A, A, hA, rfl⟩
    apply Set.mem_iUnion.mpr
    refine ⟨j, ?_⟩
    have hq : Quotient.mk'' A = Quotient.mk'' (representative ι j) :=
      (representative_spec ι j).2.symm
    exact Quotient.exact hq
  · intro hA
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hA
    exact mem_zeroFiber_of_mem_orbit ι hj (representative_spec ι j).1

/-- A true geometric local dimension formula. The left hand side was defined
by infima of actual Hausdorff dimensions of metric-ball intersections;
it is not defined using orbit dimensions or a desired numerical table. -/
theorem localDimH_zeroFiber (A : Rep ι) :
    localDimH (zeroFiber ι) A =
      ⨆ (j : ZeroOrbitIndex ι)
        (_ : A ∈ closure (MulAction.orbit (Gauge ι) (representative ι j))),
        (Module.finrank ℝ (orbitDifferential ι (representative ι j)).range : ℝ≥0∞) := by
  rw [zeroFiber_eq_iUnion_orbits]
  exact localDimH_finite_union _ _
    (fun j => orbit_inter_ball_dimH (representative ι j)) A

/-- Geometric codimension is the ambient real dimension minus the true local
Hausdorff dimension. No orbit minimum is built into this definition. -/
def localCodimH (A : Rep ι) : ℝ≥0∞ :=
  (Module.finrank ℝ (Rep ι) : ℝ≥0∞) - localDimH (zeroFiber ι) A

theorem localCodimH_zeroFiber (A : Rep ι) :
    localCodimH ι A =
      (Module.finrank ℝ (Rep ι) : ℝ≥0∞) -
      ⨆ (j : ZeroOrbitIndex ι)
        (_ : A ∈ closure (MulAction.orbit (Gauge ι) (representative ι j))),
        (Module.finrank ℝ (orbitDifferential ι (representative ι j)).range : ℝ≥0∞) := by
  rw [localCodimH, localDimH_zeroFiber]

end MAIS.Run2GeometricZeroFiber

/-- info: 'MAIS.Run2GeometricZeroFiber.representative_spec' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricZeroFiber.representative_spec

/-- info: 'MAIS.Run2GeometricZeroFiber.mem_zeroFiber_of_mem_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricZeroFiber.mem_zeroFiber_of_mem_orbit

/-- info: 'MAIS.Run2GeometricZeroFiber.zeroFiber_eq_iUnion_orbits' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricZeroFiber.zeroFiber_eq_iUnion_orbits

/-- info: 'MAIS.Run2GeometricZeroFiber.localDimH_zeroFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricZeroFiber.localDimH_zeroFiber

/-- info: 'MAIS.Run2GeometricZeroFiber.localCodimH_zeroFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricZeroFiber.localCodimH_zeroFiber
end
end
