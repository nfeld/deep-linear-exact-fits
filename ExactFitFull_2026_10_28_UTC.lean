-- ==================== begin module O7.Run2PositivePairExistence (formalization/O7/Run2PositivePairExistence.lean) ====================
section

/-! Actual measured pair existence for every positive-depth matrix chain at its
own complete output, hence every exact fit to an arbitrary real matrix target.
The residual pair is constructed by the proved zero-target existence theorem. -/
set_option autoImplicit false
set_option maxHeartbeats 2000000
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PositivePairExistence
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.ActiveIntervalDifferential
open MAIS.Run2FullSpanCoordinates MAIS.Run2FullSpanProduct
open MAIS.BarcodeActiveNormalForm MAIS.AnalyticTransfer
variable {D : ℕ} (ι : Fin (D+1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

local instance matrixSecondCountable (I J : Type*) [Fintype I] [Fintype J] :
    SecondCountableTopology (Matrix I J ℝ) :=
  inferInstanceAs (SecondCountableTopology (I → J → ℝ))

/-- At every actual chain of positive depth, the literal full-entry squared
pointed complete-product loss has an actual radius-first Haar pair. -/
theorem exists_pair_pointed (hD : 0 < D)
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι) :
    ∃ a : ℝ, ∃ m : ℕ, HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-
        pathMatrix A 0 (Fin.last D) (Nat.zero_le D)‖^2) A a m := by
  obtain ⟨N⟩ := exists_normal_form A
  let muC : Measure (Rep (Index D N.birth N.death)) := addHaar
  let muRed : Measure (Rep (ReducedIndex D N.birth N.death)) := addHaar
  obtain ⟨a,m,hp⟩ := MAIS.QuiverZeroPairExistence.exists_pair_zero_output
    (ReducedIndex D N.birth N.death) muRed
    (intervalRep D (reducedBirth D N.birth N.death) (reducedDeath D N.birth N.death))
    (reduced_base_completeProduct_zero D N.birth N.death N.bounded)
  have hC := MAIS.Run2PositiveIntervalSuspension.pair_of_reduced_pair
    D N.birth N.death N.bounded hD N.valid muC muRed hp
  refine ⟨a+(Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace
    (FullSlot D N.birth N.death) (ReducedIndex D N.birth N.death (Fin.last D))
    (ReducedIndex D N.birth N.death 0)) : ℝ)/2,m,?_⟩
  exact (MAIS.Run2PositiveMeasuredNormalForm.pair_iff_normal_form_pointed
    N mu muC 0 (Fin.last D) (Nat.zero_le D) _ m).mpr hC

/-- An arbitrary prescribed target requires only actual exact fit at A;
no target-rank, surjectivity, residual-pair or normal-form oracle is supplied. -/
theorem exists_pair_exact_fit (hD : 0 < D)
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι)
    (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = target) :
    ∃ a : ℝ, ∃ m : ℕ, HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2) A a m := by
  simpa only [hfit] using exists_pair_pointed ι hD mu A

/-- The actual pair for an arbitrary exact-fit target is uniquely determined. -/
theorem exists_unique_pair_exact_fit (hD : 0 < D)
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι)
    (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = target) :
    ∃! p : ℝ×ℕ, HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2) A p.1 p.2 := by
  obtain ⟨a,m,hp⟩ := exists_pair_exact_fit ι hD mu A target hfit
  refine ⟨(a,m),hp,?_⟩
  rintro ⟨b,n⟩ hb
  obtain ⟨h1,h2⟩ := O77.PowerLogUniqueness.radius_order_unique hb hp
  exact Prod.ext h1 h2

/-- The exact-fit theorem includes the literal half loss, every positive
continuous ambient prior, and true full-original-entry Euclidean windows. -/
theorem exists_unique_entry_half_pair_exact_fit_prior (hD : 0 < D)
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι)
    (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = target)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A) :
    ∃! p : ℝ×ℕ,
      HasMeasuredBandPair (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
        (MAIS.MatrixChainEntryWindows.entryBall ι A)
        (fun B => (1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2)
        A p.1 p.2 := by
  obtain ⟨a,m,hp⟩ := exists_pair_exact_fit ι hD mu A target hfit
  have hs := MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_positive_scale mu
    (Metric.ball A) (fun _ _ h => Metric.ball_subset_ball h)
    (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2)
    A (1/2:ℝ) (by norm_num) a m
  have hhalf := hs.mp hp
  have hf : Measurable (fun B : Rep ι =>
      (1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2) :=
    measurable_const.mul (((continuous_pathMatrix 0 (Fin.last D) (Nat.zero_le D)).sub
      continuous_const).norm.pow 2).measurable
  have hpp := (MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior
    mu hf hprior hpos).mp hhalf
  have he := (MAIS.MatrixChainEntryWindows.pair_iff_entryBall ι
    (mu.withDensity (fun B => ENNReal.ofReal (prior B))) A).mp hpp
  refine ⟨(a,m),he,?_⟩
  rintro ⟨b,n⟩ hb
  obtain ⟨h1,h2⟩ := O77.PowerLogUniqueness.radius_order_unique hb he
  exact Prod.ext h1 h2

end MAIS.Run2PositivePairExistence

/-- info: 'MAIS.Run2PositivePairExistence.exists_pair_pointed' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositivePairExistence.exists_pair_pointed

/-- info: 'MAIS.Run2PositivePairExistence.exists_pair_exact_fit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositivePairExistence.exists_pair_exact_fit

/-- info: 'MAIS.Run2PositivePairExistence.exists_unique_pair_exact_fit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositivePairExistence.exists_unique_pair_exact_fit

/-- info: 'MAIS.Run2PositivePairExistence.exists_unique_entry_half_pair_exact_fit_prior' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositivePairExistence.exists_unique_entry_half_pair_exact_fit_prior
end
