-- ==================== begin module O7.ActiveIntervalFiniteHigherTable (formalization/O7/ActiveIntervalFiniteHigherTable.lean) ====================
section

/-! Literal interval-model HigherTable derived from actual pointwise
measured pair existence on actual strict higher zero-output orbits. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.ActiveIntervalFiniteHigherTable
open MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalMeasuredSlice
open MAIS.ActiveIntervalRecursivePair MAIS.QuiverFinitePairTable
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.AnalyticTransfer
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ)

/-- Finiteness and genuine measured labels are conclusions; only genuine
pointwise pair existence at actual higher matrix points is supplied. -/
theorem exists_higher_table_of_pointwise_pairs
    (muA:Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (hexists:∀ A:Ambient D birth death,
      pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0→
      intervalRep D birth death∈closure (MulAction.orbit (Gauge (Index D birth death)) A)→
      A∉MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)→
      ∃ lam:ℝ,∃ m:ℕ,HasMeasuredBandPair muA (Metric.ball A)
        (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) A lam m) :
    ∃ a:HigherOrbitIndex (Index D birth death) (intervalRep D birth death)→ℝ,
      ∃ m:HigherOrbitIndex (Index D birth death) (intervalRep D birth death)→ℕ,
        HigherTable D birth death a m muA := by
  obtain ⟨a,m,hcover⟩:=exists_finite_higher_table (Index D birth death) muA
    (intervalRep D birth death) (fun A hA=>hexists A hA.1 hA.2.1 hA.2.2)
  exact ⟨a,m,fun A hz hcl hn=>hcover A ⟨hz,hcl,hn⟩⟩

end MAIS.ActiveIntervalFiniteHigherTable
end

/-- info: 'MAIS.ActiveIntervalFiniteHigherTable.exists_higher_table_of_pointwise_pairs' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalFiniteHigherTable.exists_higher_table_of_pointwise_pairs
end
