-- ==================== begin module O7.QuiverDirectSum (formalization/O7/QuiverDirectSum.lean) ====================
section

/-!
Actual direct sums of finite real matrix representations and matrix-unit gauges.
Ordinary Euclidean orbit closures are stable under unchanged spectator summands,
and more generally under direct sums of two independent degenerations.
-/
set_option autoImplicit false

namespace MAIS.QuiverRealOrbit

open scoped Matrix
variable {D : ℕ}
variable {ι κ : Fin (D + 1) → Type*}
variable [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]
variable [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

/-- The block diagonal of two genuine matrix units is itself a genuine matrix unit. -/
def blockUnits {α β : Type*} [Fintype α] [DecidableEq α] [Fintype β] [DecidableEq β]
    (u : (Matrix α α ℝ)ˣ) (v : (Matrix β β ℝ)ˣ) : (Matrix (α ⊕ β) (α ⊕ β) ℝ)ˣ where
  val := Matrix.fromBlocks (↑u) 0 0 (↑v)
  inv := Matrix.fromBlocks (↑(u⁻¹)) 0 0 (↑(v⁻¹))
  val_inv := by simp [Matrix.fromBlocks_multiply]
  inv_val := by simp [Matrix.fromBlocks_multiply]

@[simp]
lemma blockUnits_val {α β : Type*} [Fintype α] [DecidableEq α] [Fintype β] [DecidableEq β]
    (u : (Matrix α α ℝ)ˣ) (v : (Matrix β β ℝ)ˣ) :
    (↑(blockUnits u v) : Matrix (α ⊕ β) (α ⊕ β) ℝ) = Matrix.fromBlocks ↑u 0 0 ↑v := rfl

@[simp]
lemma blockUnits_inv_val {α β : Type*} [Fintype α] [DecidableEq α] [Fintype β] [DecidableEq β]
    (u : (Matrix α α ℝ)ˣ) (v : (Matrix β β ℝ)ˣ) :
    (↑((blockUnits u v)⁻¹) : Matrix (α ⊕ β) (α ⊕ β) ℝ) =
      Matrix.fromBlocks ↑(u⁻¹) 0 0 ↑(v⁻¹) := rfl

def directSum (A : Rep ι) (B : Rep κ) : Rep (fun v => ι v ⊕ κ v) :=
  fun e => Matrix.fromBlocks (A e) 0 0 (B e)

def directSumGauge (g : Gauge ι) (h : Gauge κ) : Gauge (fun v => ι v ⊕ κ v) :=
  fun v => blockUnits (g v) (h v)

/-- Literal block-matrix direct sum commutes with the actual real gauge action. -/
theorem directSum_smul (g : Gauge ι) (h : Gauge κ) (A : Rep ι) (B : Rep κ) :
    directSumGauge g h • directSum A B = directSum (g • A) (h • B) := by
  funext e
  simp only [gauge_smul_apply, directSum, directSumGauge, blockUnits_val, blockUnits_inv_val,
    Matrix.fromBlocks_multiply, Matrix.mul_zero, Matrix.zero_mul, zero_add, add_zero]

omit [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]
  [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)] in
/-- The actual direct-sum embedding is continuous in the ordinary matrix product topology. -/
theorem continuous_directSum :
    Continuous (fun p : Rep ι × Rep κ => directSum p.1 p.2) := by
  apply continuous_pi
  intro e
  exact ((continuous_apply e).comp continuous_fst).matrix_fromBlocks
    continuous_const continuous_const ((continuous_apply e).comp continuous_snd)

/-- Direct sum maps a pair of actual real orbits into the actual direct-sum orbit. -/
theorem directSum_mem_orbit {A C : Rep ι} {B E : Rep κ}
    (hA : A ∈ MulAction.orbit (Gauge ι) C)
    (hB : B ∈ MulAction.orbit (Gauge κ) E) :
    directSum A B ∈ MulAction.orbit (Gauge (fun v => ι v ⊕ κ v)) (directSum C E) := by
  obtain ⟨g, rfl⟩ := MulAction.mem_orbit_iff.mp hA
  obtain ⟨h, rfl⟩ := MulAction.mem_orbit_iff.mp hB
  rw [← directSum_smul]
  exact MulAction.mem_orbit _ _

/-- Two actual Euclidean degenerations may be summed, with no compactness or complexification. -/
theorem directSum_mem_closure_orbit {A C : Rep ι} {B E : Rep κ}
    (hA : A ∈ closure (MulAction.orbit (Gauge ι) C))
    (hB : B ∈ closure (MulAction.orbit (Gauge κ) E)) :
    directSum A B ∈ closure
      (MulAction.orbit (Gauge (fun v => ι v ⊕ κ v)) (directSum C E)) := by
  exact map_mem_closure₂ continuous_directSum hA hB
    (fun _ ha _ hb => directSum_mem_orbit ha hb)

/-- In particular an arbitrary unchanged spectator representation may be added. -/
theorem add_spectator_mem_closure_orbit {A C : Rep ι} (B : Rep κ)
    (hA : A ∈ closure (MulAction.orbit (Gauge ι) C)) :
    directSum A B ∈ closure
      (MulAction.orbit (Gauge (fun v => ι v ⊕ κ v)) (directSum C B)) := by
  exact directSum_mem_closure_orbit hA (subset_closure (MulAction.mem_orbit_self _))

end MAIS.QuiverRealOrbit

/-- info: 'MAIS.QuiverRealOrbit.directSum_mem_closure_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverRealOrbit.directSum_mem_closure_orbit
/-- info: 'MAIS.QuiverRealOrbit.add_spectator_mem_closure_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverRealOrbit.add_spectator_mem_closure_orbit
end
-- ==================== end module O7.QuiverDirectSum ====================

-- ==================== begin module O7.QuiverDirectSumRanks (formalization/O7/QuiverDirectSumRanks.lean) ====================
section

/-! Actual ranks of block-diagonal matrices and all path maps in direct
sums of real matrix-chain representations. These are rank computations of
the literal matrices, not definitions of an abstract rank array. -/

set_option autoImplicit false
set_option maxHeartbeats 1500000
noncomputable section
universe u v w x
open scoped Matrix

namespace MAIS.QuiverDirectSumRanks

open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism

def submoduleProdEquiv {E F : Type*} [AddCommGroup E] [Module ℝ E]
    [AddCommGroup F] [Module ℝ F] (S : Submodule ℝ E) (T : Submodule ℝ F) :
    S.prod T ≃ₗ[ℝ] S × T where
  toFun z := (⟨z.1.1, z.2.1⟩, ⟨z.1.2, z.2.2⟩)
  invFun z := ⟨((z.1 : E), (z.2 : F)), ⟨z.1.property, z.2.property⟩⟩
  left_inv := by intro z; rfl
  right_inv := by intro z; rfl
  map_add' := by intro z y; rfl
  map_smul' := by intro c z; rfl

lemma finrank_submodule_prod {E F : Type*} [AddCommGroup E] [Module ℝ E]
    [AddCommGroup F] [Module ℝ F] (S : Submodule ℝ E) (T : Submodule ℝ F)
    [Module.Finite ℝ S] [Module.Finite ℝ T] :
    Module.finrank ℝ (S.prod T) = Module.finrank ℝ S + Module.finrank ℝ T := by
  rw [(submoduleProdEquiv S T).finrank_eq, Module.finrank_prod]

lemma block_mulVecLin {α : Type u} {β : Type v} {γ : Type w} {δ : Type x}
    [Fintype γ] [Fintype δ] (A : Matrix α γ ℝ) (B : Matrix β δ ℝ) :
    (Matrix.fromBlocks A 0 0 B).mulVecLin =
      (LinearEquiv.sumArrowLequivProdArrow α β ℝ ℝ).symm.toLinearMap.comp
        ((A.mulVecLin.prodMap B.mulVecLin).comp
          (LinearEquiv.sumArrowLequivProdArrow γ δ ℝ ℝ).toLinearMap) := by
  apply LinearMap.ext
  intro z
  change Matrix.fromBlocks A 0 0 B *ᵥ z =
    Sum.elim (A *ᵥ (z ∘ Sum.inl)) (B *ᵥ (z ∘ Sum.inr))
  simp [Matrix.fromBlocks_mulVec]

/-- The rank of the literal rectangular block diagonal is the sum of the
two actual ranks, including empty row or column types. -/
theorem rank_fromBlocks_zero {α : Type u} {β : Type v} {γ : Type w} {δ : Type x}
    [Fintype α] [Fintype β] [Fintype γ] [Fintype δ]
    (A : Matrix α γ ℝ) (B : Matrix β δ ℝ) :
    (Matrix.fromBlocks A 0 0 B).rank = A.rank + B.rank := by
  rw [Matrix.rank, block_mulVecLin, LinearMap.range_comp, LinearMap.range_comp,
    LinearEquiv.range, Submodule.map_top, LinearEquiv.finrank_map_eq,
    LinearMap.range_prodMap, finrank_submodule_prod]
  rfl

section Paths

variable {D : ℕ} {ι κ : Fin (D + 1) → Type*}
variable [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]
variable [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

/-- Every actual consecutive product of a literal direct sum is the
literal block diagonal of the two actual consecutive products. -/
theorem pathMatrix_directSum (A : Rep ι) (B : Rep κ)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    pathMatrix (directSum A B) i j hij =
      Matrix.fromBlocks (pathMatrix A i j hij) 0 0 (pathMatrix B i j hij) := by
  suffices h : ∀ j : Fin (D + 1), ∀ i (hij : i ≤ j),
      pathMatrix (directSum A B) i j hij =
        Matrix.fromBlocks (pathMatrix A i j hij) 0 0 (pathMatrix B i j hij) from h j i hij
  intro j
  induction j using Fin.induction with
  | zero =>
    intro i hij
    have hi : i = 0 := le_antisymm hij (by exact Nat.zero_le i.val)
    subst i
    rw [pathMatrix_self, pathMatrix_self, pathMatrix_self]
    ext (a | a) (b | b) <;> simp [Matrix.fromBlocks, Matrix.one_apply]
  | succ e ih =>
    intro i hij
    by_cases heq : i = e.succ
    · subst i
      rw [pathMatrix_self, pathMatrix_self, pathMatrix_self]
      ext (a | a) (b | b) <;> simp [Matrix.fromBlocks, Matrix.one_apply]
    · have hne : i.val ≠ e.val + 1 := fun h => heq (Fin.ext h)
      have hij' : i ≤ e.castSucc := by
        change i.val ≤ e.val
        have hle : i.val ≤ e.val + 1 := hij
        omega
      rw [← pathMatrix_comp (directSum A B) i e.castSucc e.succ hij'
        (by exact Nat.le_succ e.val), pathMatrix_arrow, ih i hij',
        ← pathMatrix_comp A i e.castSucc e.succ hij' (by exact Nat.le_succ e.val),
        pathMatrix_arrow,
        ← pathMatrix_comp B i e.castSucc e.succ hij' (by exact Nat.le_succ e.val),
        pathMatrix_arrow]
      simp [directSum, Matrix.fromBlocks_multiply]

/-- Actual path-rank additivity for arbitrary variable vertex dimensions. -/
theorem path_rank_directSum (A : Rep ι) (B : Rep κ)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (directSum A B) i j hij).rank =
      (pathMatrix A i j hij).rank + (pathMatrix B i j hij).rank := by
  rw [pathMatrix_directSum, rank_fromBlocks_zero]

theorem path_rank_directSum_cancel {A B : Rep ι} (C : Rep κ)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (directSum A C) i j hij).rank =
        (pathMatrix (directSum B C) i j hij).rank ↔
      (pathMatrix A i j hij).rank = (pathMatrix B i j hij).rank := by
  rw [path_rank_directSum, path_rank_directSum]
  exact Nat.add_right_cancel_iff

theorem path_rank_directSum_le_cancel {A B : Rep ι} (C : Rep κ)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (directSum A C) i j hij).rank ≤
        (pathMatrix (directSum B C) i j hij).rank ↔
      (pathMatrix A i j hij).rank ≤ (pathMatrix B i j hij).rank := by
  rw [path_rank_directSum, path_rank_directSum]
  exact Nat.add_le_add_iff_right

/-- Actual path-rank-equal source and target substitutions preserve an
established ordinary real orbit-closure inclusion on the same carrier. -/
theorem closure_transfer_of_path_rank_eq {A B C E : Rep ι}
    (hAB : A ∈ closure (MulAction.orbit (Gauge ι) B))
    (hAC : ∀ i j (hij : i ≤ j),
      (pathMatrix A i j hij).rank = (pathMatrix C i j hij).rank)
    (hBE : ∀ i j (hij : i ≤ j),
      (pathMatrix B i j hij).rank = (pathMatrix E i j hij).rank) :
    C ∈ closure (MulAction.orbit (Gauge ι) E) := by
  have hCA : C ∈ MulAction.orbit (Gauge ι) A :=
    mem_gauge_orbit_of_path_rank_eq A C hAC
  have hEB : B ∈ MulAction.orbit (Gauge ι) E :=
    mem_gauge_orbit_of_path_rank_eq E B (fun i j hij => (hBE i j hij).symm)
  exact closure_orbit_trans (closure_orbit_trans (subset_closure hCA) hAB)
    (subset_closure hEB)

end Paths
end MAIS.QuiverDirectSumRanks

/--
info: 'MAIS.QuiverDirectSumRanks.rank_fromBlocks_zero' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverDirectSumRanks.rank_fromBlocks_zero

/--
info: 'MAIS.QuiverDirectSumRanks.path_rank_directSum' depends on axioms:
