-- ==================== begin module O7.Run2GeometricOrbitDimension (formalization/O7/Run2GeometricOrbitDimension.lean) ====================
section

/-! The Hausdorff dimension of every actual rectangular real gauge orbit equals
the rank of its actual gauge differential, derived from genuine ambient
charts and actual finite interval normalization. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricOrbitDimension
open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear
open MAIS.QuiverGaugeMeasuredPair MAIS.QuiverCoordinateMeasuredPair
open MAIS.MatrixCoordinateTransport MAIS.ActiveIntervalDifferential
open MAIS.ActiveIntervalSliceChart MAIS.Run2GeometricIntervalOrbit
open MAIS.Run2GeometricHomogeneous MAIS.Run2GeometricTransport
open MAIS.BarcodeActiveNormalForm
open MAIS.Run2OrbitDifferentialGauge MAIS.Run2OrbitDifferentialCoordinates

variable {D : ℕ} {ι κ : Fin (D + 1) → Type*}
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]
  [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

theorem gauge_image_orbit (g : Gauge ι) (A : Rep ι) :
    gaugeContinuousEquiv ι g '' MulAction.orbit (Gauge ι) A =
      MulAction.orbit (Gauge ι) A := by
  ext B
  constructor
  · rintro ⟨C, hC, rfl⟩
    exact MulAction.mem_orbit_trans (MulAction.mem_orbit C g) hC
  · intro hB
    refine ⟨g⁻¹ • B, ?_, smul_inv_smul g B⟩
    exact MulAction.mem_orbit_trans (MulAction.mem_orbit B g⁻¹) hB

theorem coordinate_image_orbit (e : ∀ v, ι v ≃ κ v) (A : Rep ι) :
    coordinateContinuousEquiv e '' MulAction.orbit (Gauge ι) A =
      MulAction.orbit (Gauge κ) (transport e A) := by
  let f := coordinateContinuousEquiv e
  ext B
  constructor
  · rintro ⟨C, hC, rfl⟩
    exact transport_mem_orbit e hC
  · intro hB
    have hi := transport_mem_orbit (fun v => (e v).symm) hB
    change f.symm B ∈ MulAction.orbit (Gauge ι) (f.symm (f A)) at hi
    rw [f.symm_apply_apply] at hi
    exact ⟨f.symm B, hi, f.apply_symm_apply B⟩

theorem tangent_finrank {S : Type*} [Fintype S] [DecidableEq S]
    (D : ℕ) (birth death : S → ℕ) :
    Module.finrank ℝ (TangentParameters D birth death) =
      Module.finrank ℝ (orbitDifferential (Index D birth death)
        (intervalRep D birth death)).range :=
  ((orbitDifferential (Index D birth death) (intervalRep D birth death)).kerComplementEquivRange
    (orbitDirections_isCompl _ _)).finrank_eq

theorem interval_orbit_inter_ball_dimH
    {S : Type*} [Fintype S] [DecidableEq S]
    (D : ℕ) (birth death : S → ℕ)
    (hD : ∀ s, death s ≤ D + 1) (hvalid : ∀ s, birth s < death s) :
    ∀ A ∈ MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death),
      ∀ r : ℝ, 0 < r →
      dimH (MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death) ∩
          Metric.ball A r) =
        Module.finrank ℝ (orbitDifferential (Index D birth death)
          (intervalRep D birth death)).range := by
  obtain ⟨U, hU, hbU, hdim, hlower⟩ :=
    exists_open_orbit_patch D birth death hD hvalid
  have ht : ∀ A ∈ MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death),
      ∃ e : Rep (Index D birth death) ≃L[ℝ] Rep (Index D birth death),
        e (intervalRep D birth death) = A ∧
          e '' MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death) =
            MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death) := by
    intro A hA
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp hA
    exact ⟨gaugeContinuousEquiv _ g, hg, gauge_image_orbit g _⟩
  have h := dimH_inter_ball_of_transitive_linear _ _
    (Module.finrank ℝ (TangentParameters D birth death)) ht U hU hbU hdim hlower
  simpa only [tangent_finrank] using h

/-- Literal all-ball Hausdorff dimension of every genuine real gauge orbit. -/
theorem orbit_inter_ball_dimH (A : Rep ι) :
    ∀ B ∈ MulAction.orbit (Gauge ι) A, ∀ r : ℝ, 0 < r →
      dimH (MulAction.orbit (Gauge ι) A ∩ Metric.ball B r) =
        Module.finrank ℝ (orbitDifferential ι A).range := by
  obtain ⟨N⟩ := exists_normal_form A
  let C := intervalRep D N.birth N.death
  let f := coordinateContinuousEquiv N.coordinates
  let A₀ := transport N.coordinates C
  have hC := interval_orbit_inter_ball_dimH D N.birth N.death N.bounded N.valid
  have himage : f '' MulAction.orbit (Gauge (Index D N.birth N.death)) C =
      MulAction.orbit (Gauge ι) A₀ := coordinate_image_orbit N.coordinates C
  have hp := dimH_image_inter_ball f
    (MulAction.orbit (Gauge (Index D N.birth N.death)) C)
    (Module.finrank ℝ (orbitDifferential (Index D N.birth N.death) C).range) hC
  rw [himage] at hp
  have horb : MulAction.orbit (Gauge ι) A = MulAction.orbit (Gauge ι) A₀ :=
    MulAction.orbit_eq_iff.mpr N.original_in_orbit
  have hdim : Module.finrank ℝ (orbitDifferential ι A).range =
      Module.finrank ℝ (orbitDifferential (Index D N.birth N.death) C).range := by
    calc
      _ = Module.finrank ℝ (orbitDifferential ι A₀).range :=
        finrank_range_eq_of_mem_orbit ι N.original_in_orbit
      _ = _ := finrank_range_transport N.coordinates C
  rw [horb, hdim]
  exact hp

end MAIS.Run2GeometricOrbitDimension

/-- info: 'MAIS.Run2GeometricOrbitDimension.gauge_image_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricOrbitDimension.gauge_image_orbit

/-- info: 'MAIS.Run2GeometricOrbitDimension.coordinate_image_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricOrbitDimension.coordinate_image_orbit

/-- info: 'MAIS.Run2GeometricOrbitDimension.tangent_finrank' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricOrbitDimension.tangent_finrank

/-- info: 'MAIS.Run2GeometricOrbitDimension.interval_orbit_inter_ball_dimH' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricOrbitDimension.interval_orbit_inter_ball_dimH

/-- info: 'MAIS.Run2GeometricOrbitDimension.orbit_inter_ball_dimH' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricOrbitDimension.orbit_inter_ball_dimH
end
