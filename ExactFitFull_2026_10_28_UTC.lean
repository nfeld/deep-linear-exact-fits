-- ==================== begin module O7.Run2AllHigherAttainment (formalization/O7/Run2AllHigherAttainment.lean) ====================
section

/-! Actual ordinary-real orbit closure implies an attained compact-annulus
witness. The converse uses the proved strict generization of every nonzero
physical normal parameter. No orbit label is declared attained by definition. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set Filter
open scoped Topology Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2AllHigherAttainment
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.ActiveIntervalDirectElimination MAIS.ActiveIntervalEndpointRows
open MAIS.ActiveIntervalAnnulusRecurrence MAIS.ActiveIntervalWeightedResidual
open MAIS.ActiveIntervalSliceChart MAIS.ActiveIntervalStrictGenerization
open MAIS.Run2AllHigherZeroFiber MAIS.Run2AllHigherAnnulus
open MAIS.QuiverRealOrbit MAIS.QuiverOrbitRank MAIS.MatrixChainIsomorphism
open MAIS.WeightedDyadicShells MAIS.WeightedCompactAnnulus
open MAIS.WeightedDilationNeighborhood

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

theorem fullProduct_zero_of_mem_orbit
    {A B : Rep (Index D birth death)}
    (hAB : A ∈ MulAction.orbit (Gauge (Index D birth death)) B)
    (hB : pathMatrix B 0 (Fin.last D) (by exact Nat.zero_le D) = 0) :
    pathMatrix A 0 (Fin.last D) (by exact Nat.zero_le D) = 0 := by
  obtain ⟨g, rfl⟩ := MulAction.mem_orbit_iff.mp hAB
  rw [pathMatrix_gauge, hB, Matrix.mul_zero, Matrix.zero_mul]

theorem parameterChart_eq_gauge (hvalid : ∀ s, birth s < death s)
    (p : TangentParameters D birth death × NormalParams birth death) :
    parameterChart D birth death hD hvalid p =
      MAIS.OrbitSliceChart.expGauge (Index D birth death)
        (p.1 : MAIS.OrbitSliceLinear.Lie (Index D birth death)) •
        normalFamily D birth death hD p.2 := by
  funext e
  rfl

/-- A genuine higher orbit supplies a nonzero corrected zero normal point.
The representative is extracted from the actual open full ambient chart. -/
theorem exists_nonzero_corrected_normal_mem_orbit
    (hvalid : ∀ s, birth s < death s)
    (A : Rep (Index D birth death))
    (hA : pathMatrix A 0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    (hclosure : intervalRep D birth death ∈
      closure (MulAction.orbit (Gauge (Index D birth death)) A))
    (hstrict : A ∉ MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)) :
    ∃ z : Residual D birth death, z ≠ 0 ∧ residualLoss D birth death hD z = 0 ∧
      zeroDirectRep D birth death hD z ∈ MulAction.orbit (Gauge (Index D birth death)) A := by
  let e := parameterChart D birth death hD hvalid
  obtain ⟨C, hCt, hCo⟩ := mem_closure_iff.mp hclosure e.target e.open_target
    (base_mem_parameterChart_target D birth death hD hvalid)
  let p := e.symm C
  let g := MAIS.OrbitSliceChart.expGauge (Index D birth death)
    (p.1 : MAIS.OrbitSliceLinear.Lie (Index D birth death))
  have hCg : C = g • normalFamily D birth death hD p.2 := by
    exact (e.right_inv hCt).symm.trans
      (parameterChart_eq_gauge D birth death hD hvalid p)
  have hnormal : normalFamily D birth death hD p.2 ∈
      MulAction.orbit (Gauge (Index D birth death)) A := by
    apply MulAction.mem_orbit_trans _ hCo
    exact MulAction.mem_orbit_iff.mpr ⟨g⁻¹, by rw [hCg, inv_smul_smul]⟩
  have hnormalZero : fullProduct D birth death hD p.2 = 0 :=
    fullProduct_zero_of_mem_orbit D birth death hnormal hA
  have ht : p.2 ≠ 0 := by
    intro ht
    have hb : intervalRep D birth death ∈ MulAction.orbit (Gauge (Index D birth death)) A := by
      simpa only [ht, MAIS.ActiveIntervalPathDerivative.normalFamily_zero] using hnormal
    exact hstrict (MulAction.mem_orbit_symm.mp hb)
  let z := residualCoordinates D birth death p.2
  obtain ⟨hzH, htz⟩ := zero_fiber_correction D birth death hD p.2 hnormalZero
  have hz : z ≠ 0 := by
    intro hz
    apply ht
    rw [htz]
    change gaussianHomeomorph D birth death hD (z, 0) = 0
    rw [hz]
    exact gaussianHomeomorph_zero D birth death hD
  refine ⟨z, hz, hzH, ?_⟩
  change normalFamily D birth death hD (zeroDirectParameter D birth death hD z) ∈ _
  rw [← htz]
  exact hnormal

/-- Every strict higher zero-output orbit has an actual corrected normal
representative on the fixed compact annulus. -/
theorem exists_annular_corrected_normal_mem_orbit
    (hvalid : ∀ s, birth s < death s)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (A : Rep (Index D birth death))
    (hA : pathMatrix A 0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    (hclosure : intervalRep D birth death ∈
      closure (MulAction.orbit (Gauge (Index D birth death)) A))
    (hstrict : A ∉ MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)) :
    ∃ z ∈ compactAnnulus (integerWeights D birth death),
      residualLoss D birth death hD z = 0 ∧
      zeroDirectRep D birth death hD z ∈ MulAction.orbit (Gauge (Index D birth death)) A := by
  obtain ⟨v, hv, hvH, hvO⟩ := exists_nonzero_corrected_normal_mem_orbit
    D birth death hD hvalid A hA hclosure hstrict
  have hW : ∀ p : ResidualIndex D birth death, 0 < integerWeights D birth death p :=
    fun p => ((zero_base_weight_data D birth death hD hzero).2 p).1
  obtain ⟨r, hr, hrK⟩ := exists_positive_dilation_mem_compactAnnulus
    (integerWeights D birth death) hW v hv
  refine ⟨dilation (integerWeights D birth death) r v, hrK, ?_, ?_⟩
  · change residualLoss D birth death hD (integerDilation D birth death r v) = 0
    rw [zero_base_residualLoss_integerDilation D birth death hD hzero r hr v,
      hvH, mul_zero]
  · exact MulAction.mem_orbit_trans
      (zeroDirectRep_dilation_mem_orbit D birth death hD hzero r hr v hvH) hvO

/-- Actual strict higher zero-output orbits are exactly the actual annular
zero witnesses, rather than a larger collection of proposed labels. -/
theorem strict_higher_zero_iff_annular
    (hvalid : ∀ s, birth s < death s)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (A : Rep (Index D birth death)) :
    (pathMatrix A 0 (Fin.last D) (by exact Nat.zero_le D) = 0 ∧
      intervalRep D birth death ∈ closure (MulAction.orbit (Gauge (Index D birth death)) A) ∧
      A ∉ MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)) ↔
    ∃ z ∈ compactAnnulus (integerWeights D birth death),
      residualLoss D birth death hD z = 0 ∧
      zeroDirectRep D birth death hD z ∈ MulAction.orbit (Gauge (Index D birth death)) A := by
  constructor
  · rintro ⟨hA, hc, hs⟩
    exact exists_annular_corrected_normal_mem_orbit D birth death hD hvalid hzero A hA hc hs
  · rintro ⟨z, hzK, hzH, hzO⟩
    obtain ⟨hZ, hc, hs, _⟩ := annulus_zero_strict_generization D birth death hD z hzK hzH
    have he : MulAction.orbit (Gauge (Index D birth death)) (zeroDirectRep D birth death hD z) =
        MulAction.orbit (Gauge (Index D birth death)) A := MulAction.orbit_eq_iff.mpr hzO
    refine ⟨fullProduct_zero_of_mem_orbit D birth death (MulAction.mem_orbit_symm.mp hzO) hZ,
      by simpa only [he] using hc, ?_⟩
    intro hA
    exact hs (MulAction.mem_orbit_trans hzO hA)

/-- The compact annular representative may additionally be contracted into
every actual neighborhood used by a local measured slice theorem. -/
theorem strict_higher_zero_iff_attained
    (hvalid : ∀ s, birth s < death s)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (U : Set (Residual D birth death)) (hU : U ∈ nhds 0)
    (A : Rep (Index D birth death)) :
    (pathMatrix A 0 (Fin.last D) (by exact Nat.zero_le D) = 0 ∧
      intervalRep D birth death ∈ closure (MulAction.orbit (Gauge (Index D birth death)) A) ∧
      A ∉ MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)) ↔
    ∃ z ∈ compactAnnulus (integerWeights D birth death),
      residualLoss D birth death hD z = 0 ∧ ∃ r : ℝ, 0 < r ∧
      dilation (integerWeights D birth death) r z ∈ U ∧
      zeroDirectRep D birth death hD (dilation (integerWeights D birth death) r z) ∈
        MulAction.orbit (Gauge (Index D birth death)) A := by
  rw [strict_higher_zero_iff_annular D birth death hD hvalid hzero A]
  constructor
  · rintro ⟨z, hzK, hzH, hzO⟩
    have hW : ∀ p : ResidualIndex D birth death, 0 < integerWeights D birth death p :=
      fun p => ((zero_base_weight_data D birth death hD hzero).2 p).1
    obtain ⟨r, hr, hrU⟩ := exists_positive_dilation_mem_nhds
      (integerWeights D birth death) hW z U hU
    refine ⟨z, hzK, hzH, r, hr, hrU, ?_⟩
    exact MulAction.mem_orbit_trans
      (zeroDirectRep_dilation_mem_orbit D birth death hD hzero r hr z hzH) hzO
  · rintro ⟨z, hzK, hzH, r, hr, _, hrO⟩
    refine ⟨z, hzK, hzH, ?_⟩
    have hg := zeroDirectRep_dilation_mem_orbit D birth death hD hzero r hr z hzH
    exact MulAction.mem_orbit_trans (MulAction.mem_orbit_symm.mp hg) hrO

end MAIS.Run2AllHigherAttainment

/-- info: 'MAIS.Run2AllHigherAttainment.fullProduct_zero_of_mem_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2AllHigherAttainment.fullProduct_zero_of_mem_orbit

/-- info: 'MAIS.Run2AllHigherAttainment.parameterChart_eq_gauge' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2AllHigherAttainment.parameterChart_eq_gauge

/-- info: 'MAIS.Run2AllHigherAttainment.exists_nonzero_corrected_normal_mem_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2AllHigherAttainment.exists_nonzero_corrected_normal_mem_orbit

/-- info: 'MAIS.Run2AllHigherAttainment.exists_annular_corrected_normal_mem_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2AllHigherAttainment.exists_annular_corrected_normal_mem_orbit

/-- info: 'MAIS.Run2AllHigherAttainment.strict_higher_zero_iff_annular' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2AllHigherAttainment.strict_higher_zero_iff_annular

/-- info: 'MAIS.Run2AllHigherAttainment.strict_higher_zero_iff_attained' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2AllHigherAttainment.strict_higher_zero_iff_attained
end
end
