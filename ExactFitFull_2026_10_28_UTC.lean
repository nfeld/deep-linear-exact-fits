-- ==================== begin module O7.Run2GeometricReducedGauge (formalization/O7/Run2GeometricReducedGauge.lean) ====================
section

/-! The reduced genuine orbit directions inject into the genuine full
orbit-direction complement through literal block-diagonal Lie matrices. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open scoped Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricReducedGauge
open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear

variable {D : ℕ} {R : Type*} [Fintype R] [DecidableEq R]
variable (κ : Fin (D + 1) → Type*) [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

abbrev Carrier := fun v => R ⊕ κ v

def splitChain (C : Rep κ) : Rep (Carrier (R := R) κ) :=
  fun e => Matrix.fromBlocks 1 0 0 (C e)

def reducedLieLift : Lie κ →ₗ[ℝ] Lie (Carrier (R := R) κ) where
  toFun X v := Matrix.fromBlocks 0 0 0 (X v)
  map_add' X Y := by
    funext v
    simp only [Pi.add_apply, Matrix.fromBlocks_add, zero_add]
  map_smul' r X := by
    funext v
    simp only [Pi.smul_apply, Matrix.fromBlocks_smul, smul_zero, RingHom.id_apply]

omit [∀ v, DecidableEq (κ v)] in
theorem orbitDifferential_lift (C : Rep κ) (X : Lie κ) :
    orbitDifferential (Carrier (R := R) κ) (splitChain κ C) (reducedLieLift κ X) =
      fun e => Matrix.fromBlocks 0 0 0 (orbitDifferential κ C X e) := by
  funext e
  simp only [orbitDifferential_apply, splitChain, reducedLieLift, LinearMap.coe_mk, AddHom.coe_mk,
    Matrix.fromBlocks_multiply, Matrix.zero_mul, Matrix.mul_zero, zero_add, add_zero,
    ]
  ext i j
  cases i <;> cases j <;> simp [Matrix.fromBlocks, Matrix.sub_apply]

variable (A : Rep (Carrier (R := R) κ))
variable (H : Submodule ℝ (Lie (Carrier (R := R) κ)))
variable (hH : IsCompl H (orbitDifferential (Carrier (R := R) κ) A).ker)

/-- Projection onto the chosen actual complement is derived using the actual
orbit differential and its actual range, rather than supplied as data. -/
def complementProjection : Lie (Carrier (R := R) κ) →L[ℝ] H :=
  (((orbitDifferential (Carrier (R := R) κ) A).kerComplementEquivRange hH).symm.toLinearMap.comp
    (orbitDifferential (Carrier (R := R) κ) A).rangeRestrict).toContinuousLinearMap

omit [DecidableEq R] [∀ v, DecidableEq (κ v)] in
theorem complementProjection_differential (X : Lie (Carrier (R := R) κ)) :
    orbitDifferential (Carrier (R := R) κ) A
      (complementProjection κ A H hH X : Lie (Carrier (R := R) κ)) =
      orbitDifferential (Carrier (R := R) κ) A X := by
  let E := (orbitDifferential (Carrier (R := R) κ) A).kerComplementEquivRange hH
  exact congrArg Subtype.val (E.apply_symm_apply
    ⟨orbitDifferential (Carrier (R := R) κ) A X, X, rfl⟩)

def projectedReducedLift (C : Rep κ) :
    orbitDirections κ C →L[ℝ] H :=
  (complementProjection κ A H hH).comp
    ((reducedLieLift (R := R) κ).toContinuousLinearMap.comp (orbitDirections κ C).subtypeL)

omit [∀ v, DecidableEq (κ v)] in
theorem projectedReducedLift_injective (C : Rep κ)
    (hA : A = splitChain κ C) :
    Function.Injective (projectedReducedLift κ A H hH C) := by
  intro x y hxy
  have he := congrArg
    (fun h : H => orbitDifferential (Carrier (R := R) κ) A (h : Lie _)) hxy
  change orbitDifferential (Carrier (R := R) κ) A
      (complementProjection κ A H hH (reducedLieLift κ (x : Lie κ)) : Lie _) =
    orbitDifferential (Carrier (R := R) κ) A
      (complementProjection κ A H hH (reducedLieLift κ (y : Lie κ)) : Lie _) at he
  rw [complementProjection_differential, complementProjection_differential, hA,
    orbitDifferential_lift, orbitDifferential_lift] at he
  have hred : orbitDifferential κ C (x : Lie κ) =
      orbitDifferential κ C (y : Lie κ) := by
    funext e
    have h := congrArg Matrix.toBlocks₂₂ (congrFun he e)
    simpa only [Matrix.toBlocks_fromBlocks₂₂] using h
  let E := (orbitDifferential κ C).kerComplementEquivRange (orbitDirections_isCompl κ C)
  apply E.injective
  exact Subtype.ext hred

end MAIS.Run2GeometricReducedGauge

/-- info: 'MAIS.Run2GeometricReducedGauge.orbitDifferential_lift' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricReducedGauge.orbitDifferential_lift

/-- info: 'MAIS.Run2GeometricReducedGauge.complementProjection_differential' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricReducedGauge.complementProjection_differential

/-- info: 'MAIS.Run2GeometricReducedGauge.projectedReducedLift_injective' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricReducedGauge.projectedReducedLift_injective

/-- info: 'MAIS.Run2GeometricReducedGauge.complementProjection' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricReducedGauge.complementProjection
end
end
-- ==================== end module O7.Run2GeometricReducedGauge ====================

-- ==================== begin module O7.Run2GeometricRetainedInjection (formalization/O7/Run2GeometricRetainedInjection.lean) ====================
section

/-! An actual reduced orbit complement injects into the actual kernel retained
by the full regular-output submersion. The product and its derivative are the
literal network product; the injection is constructed, not a dimension oracle. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open scoped Matrix Matrix.Norms.Frobenius ContDiff
namespace MAIS.Run2GeometricRetainedInjection
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.OrbitSliceChart MAIS.OrbitSliceAnalytic MAIS.Run2PositivePathDerivative
open MAIS.Run2PositiveEndpointRegular MAIS.Run2ParameterRetainingLinear
open MAIS.Run2PositiveRegularChart MAIS.Run2GeometricReducedGauge
variable {D : ℕ} {R : Type*} [Fintype R] [DecidableEq R]
  (κ : Fin (D+1) → Type*) [∀ v,Fintype (κ v)] [∀ v,DecidableEq (κ v)]

/-- The actual gauge derivative of the actual regular map. -/
theorem gaugeDerivative_apply
    (A : Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ))
    (H : Submodule ℝ (Lie (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A).range N) (h : H) :
    gaugeDerivative (fderiv ℝ (regularMap κ A H N) 0) h =
      regularBlocks ((fderiv ℝ (fun B : Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) =>
        pathMatrix B 0 (Fin.last D) (Fin.zero_le _)) A)
          (orbitDifferential (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A (h : Lie _))) := by
  let F : Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) → Matrix (R ⊕ κ (Fin.last D)) (R ⊕ κ 0) ℝ :=
    fun B => pathMatrix B 0 (Fin.last D) (Fin.zero_le _)
  have hF := (contDiff_pathMatrix (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) 0 (Fin.last D)
    (Fin.zero_le _)).differentiable (by simp)
  have hfA : HasFDerivAt F (fderiv ℝ F A)
      (sliceMap (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A H N 0) := by
    simpa only [sliceMap_zero] using (hF A).hasFDerivAt
  have hd := regularBlocks.hasFDerivAt.comp 0
    ((hfA.comp 0 (hasStrictFDerivAt_sliceMap (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A H N hH hN).hasFDerivAt).sub_const
      (standardTarget : Matrix (R ⊕ κ (Fin.last D)) (R ⊕ κ 0) ℝ))
  have hder : fderiv ℝ (regularMap κ A H N) 0 =
      regularBlocks.comp ((fderiv ℝ F A).comp
        (sliceDerivativeEquiv (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A H N hH hN :
          H × N →L[ℝ] Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ))) := by
    apply HasFDerivAt.fderiv
    convert hd using 1 <;> rfl
  rw [gaugeDerivative,hder]
  change regularBlocks ((fderiv ℝ F A)
    (orbitDifferential (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A (h : Lie _) + 0)) = _
  rw [add_zero]

/-- At the actual block-split product, the projected reduced orbit directions
have zero regular derivative, hence genuinely belong to the retained kernel. -/
theorem projectedReducedLift_mem_kernel
    (A : Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A).range N)
    (C : Rep κ) (x : orbitDirections κ C) :
    projectedReducedLift κ A H hH C x ∈ Kernel (fderiv ℝ (regularMap κ A H N) 0) := by
  change gaugeDerivative (fderiv ℝ (regularMap κ A H N) 0)
    (projectedReducedLift κ A H hH C x) = 0
  rw [gaugeDerivative_apply κ A H N hH hN]
  change regularBlocks ((fderiv ℝ (fun B : Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) =>
    pathMatrix B 0 (Fin.last D) (Fin.zero_le _)) A)
      (orbitDifferential (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A
        (complementProjection κ A H hH (reducedLieLift κ (x : Lie κ)) : Lie _))) = 0
  rw [complementProjection_differential, fderiv_path_orbitDifferential, hA]
  simp only [reducedLieLift,LinearMap.coe_mk,AddHom.coe_mk,standardTarget,
    Matrix.fromBlocks_multiply, Matrix.zero_mul,Matrix.mul_zero,add_zero,sub_self]
  exact map_zero regularBlocks

/-- The actual continuous linear embedding into the actual retained kernel. -/
def retainedInjection
    (A : Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A).range N)
    (C : Rep κ) : orbitDirections κ C →L[ℝ] Kernel (fderiv ℝ (regularMap κ A H N) 0) :=
  ((projectedReducedLift κ A H hH C).toLinearMap.codRestrict _
    (projectedReducedLift_mem_kernel κ A hA H N hH hN C)).toContinuousLinearMap

theorem retainedInjection_injective
    (A : Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (MAIS.Run2PositiveEndpointRegular.Carrier (R:=R) κ) A).range N)
    (C : Rep κ) (hsplit : A = splitChain κ C) :
    Function.Injective (retainedInjection κ A hA H N hH hN C) := by
  intro x y hxy
  exact projectedReducedLift_injective κ A H hH C hsplit
    (congrArg Subtype.val hxy)

end MAIS.Run2GeometricRetainedInjection

/-- info: 'MAIS.Run2GeometricRetainedInjection.gaugeDerivative_apply' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricRetainedInjection.gaugeDerivative_apply

/-- info: 'MAIS.Run2GeometricRetainedInjection.projectedReducedLift_mem_kernel' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricRetainedInjection.projectedReducedLift_mem_kernel

/-- info: 'MAIS.Run2GeometricRetainedInjection.retainedInjection_injective' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricRetainedInjection.retainedInjection_injective

/-- info: 'MAIS.Run2GeometricRetainedInjection.retainedInjection' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricRetainedInjection.retainedInjection
end
end
-- ==================== end module O7.Run2GeometricRetainedInjection ====================

-- ==================== begin module O7.Run2PositiveNetworkFiber (formalization/O7/Run2PositiveNetworkFiber.lean) ====================
section

/-! The actual positive-target zero fiber in retained analytic coordinates.
The output identity is derived from the proved actual norm comparison. -/
set_option autoImplicit false
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set Filter
open scoped Matrix Matrix.Norms.Frobenius Topology ContDiff
namespace MAIS.Run2PositiveNetworkFiber
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.OrbitSliceChart MAIS.OrbitSliceAnalytic
open MAIS.Run2PositiveEndpointRegular MAIS.Run2PositiveRegularChart MAIS.Run2PositiveNetworkLoss
open MAIS.Run2ParameterRetainingLinear
variable {D : ℕ} {R : Type*} [Fintype R] [DecidableEq R]
  (κ : Fin (D+1) → Type*) [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

/-- In an actual full neighborhood of the gauge/normal center, the actual
fixed-target fiber is exactly the simultaneous zero set of the three regular
output blocks and the retained literal normal product. -/
theorem exists_local_fiber_description
    (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ)))
    (hsplit : ∀ x : N, pathMatrix (A+(x : Rep (Carrier (R:=R) κ)))
      0 (Fin.last D) (Fin.zero_le _) = Matrix.fromBlocks (1 : Matrix R R ℝ)
        0 0 (normalResidual κ A N x)) :
    ∃ rho : ℝ, 0 < rho ∧ ∀ p ∈ Metric.ball (0 : H×N) rho,
      pathMatrix (sliceMap (Carrier (R:=R) κ) A H N p)
        0 (Fin.last D) (Fin.zero_le _) = standardTarget ↔
      regularMap κ A H N p = 0 ∧ normalResidual κ A N p.2 = 0 := by
  obtain ⟨C,hC,hcmp⟩ := exists_network_loss_comparison κ A hA H N hsplit
  obtain ⟨rho,hrho,hball⟩ := Metric.eventually_nhds_iff.mp hcmp
  refine ⟨rho,hrho,?_⟩
  intro p hp
  have h := hball hp
  constructor
  · intro heq
    have hf : ‖pathMatrix (sliceMap (Carrier (R:=R) κ) A H N p)
        0 (Fin.last D) (Fin.zero_le _)-standardTarget‖^2 = 0 := by
      rw [heq,sub_self,norm_zero,zero_pow (by decide : (2:ℕ)≠0)]
    have hz : ‖regularMap κ A H N p‖^2+‖normalResidual κ A N p.2‖^2 ≤ 0 := by
      have hh := (div_le_iff₀ hC).mp h.1
      rw [hf,zero_mul] at hh
      exact hh
    have hq := sq_nonneg ‖regularMap κ A H N p‖
    have hs := sq_nonneg ‖normalResidual κ A N p.2‖
    constructor
    · apply norm_eq_zero.mp
      nlinarith
    · apply norm_eq_zero.mp
      nlinarith
  · rintro ⟨hq,hs⟩
    have hh := h.2
    simp only [hq,hs,norm_zero,zero_pow (by decide : (2:ℕ)≠0),add_zero,mul_zero] at hh
    apply sub_eq_zero.mp
    apply norm_eq_zero.mp
    have hn := norm_nonneg (pathMatrix (sliceMap (Carrier (R:=R) κ) A H N p)
      0 (Fin.last D) (Fin.zero_le _)-standardTarget)
    nlinarith

/-- A genuine retaining analytic chart carries the actual fixed-target fiber
to regular-coordinate zero times the actual retained normal zero fiber.
Both chart directions and actual local analytic inverse are retained. -/
theorem exists_retained_fiber_description
    (hD : 0 < D) (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (Carrier (R:=R) κ) A).range N)
    (hsplit : ∀ x : N, pathMatrix (A+(x : Rep (Carrier (R:=R) κ)))
      0 (Fin.last D) (Fin.zero_le _) = Matrix.fromBlocks (1 : Matrix R R ℝ)
        0 0 (normalResidual κ A N x)) :
    ∃ e : OpenPartialHomeomorph (H×N)
        ((MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0) ×
          Kernel (fderiv ℝ (regularMap κ A H N) 0))×N),
      0 ∈ e.source ∧ 0 ∈ e.target ∧ e 0 = 0 ∧
      (∀ p, (e p).2 = p.2 ∧ (e p).1.1 = regularMap κ A H N p) ∧
      (∀ p, AnalyticAt ℝ e p) ∧
      ∃ U, IsOpen U ∧ 0 ∈ U ∧ U ⊆ e.target ∧
        ∀ y ∈ U, AnalyticAt ℝ e.symm y ∧
          (pathMatrix (sliceMap (Carrier (R:=R) κ) A H N (e.symm y))
              0 (Fin.last D) (Fin.zero_le _) = standardTarget ↔
            y.1.1 = 0 ∧ normalResidual κ A N y.2 = 0) := by
  obtain ⟨e,hsrc,htgt,he0,he,hinv,ha,U,hU,hU0,hUt,hUa⟩ :=
    MAIS.Run2PositiveRetainedChart.exists_actual_positive_retaining_chart
      κ hD A hA H N hH hN
  obtain ⟨rho,hrho,hfiber⟩ := exists_local_fiber_description κ A hA H N hsplit
  have hes0 : e.symm 0 = 0 := by
    rw [← he0]
    exact e.left_inv hsrc
  have hpre : ∀ᶠ y in nhds 0, e.symm y ∈ Metric.ball (0:H×N) rho := by
    have hc := e.continuousAt_symm htgt
    have hv : Metric.ball (0:H×N) rho ∈ nhds (e.symm 0) := by
      rw [hes0]
      exact Metric.ball_mem_nhds 0 hrho
    exact hc.preimage_mem_nhds hv
  have hev : ∀ᶠ y in nhds 0, y ∈ U ∧ e.symm y ∈ Metric.ball (0:H×N) rho := by
    filter_upwards [hU.mem_nhds hU0,hpre] with y hy hp
    exact ⟨hy,hp⟩
  obtain ⟨eta,heta,hball⟩ := Metric.eventually_nhds_iff.mp hev
  refine ⟨e,hsrc,htgt,he0,he,ha,Metric.ball 0 eta,Metric.isOpen_ball,Metric.mem_ball_self heta,?_,?_⟩
  · intro y hy
    exact hUt (hball hy).1
  · intro y hy
    have hym := hUt (hball hy).1
    refine ⟨hUa y (hball hy).1,?_⟩
    rw [hfiber (e.symm y) (hball hy).2, (hinv y hym).1, (hinv y hym).2]

end MAIS.Run2PositiveNetworkFiber

/-- info: 'MAIS.Run2PositiveNetworkFiber.exists_local_fiber_description' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveNetworkFiber.exists_local_fiber_description

/-- info: 'MAIS.Run2PositiveNetworkFiber.exists_retained_fiber_description' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveNetworkFiber.exists_retained_fiber_description
end
end
-- ==================== end module O7.Run2PositiveNetworkFiber ====================

-- ==================== begin module O7.Run2PositiveAmbientFiber (formalization/O7/Run2PositiveAmbientFiber.lean) ====================
section

/-! A literal full-ambient analytic chart for the actual fixed-target fiber.
This composes the genuine retained chart and the genuine ambient orbit slice;
no local-dimension or codimension identity is assumed. -/
set_option autoImplicit false
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set
open scoped Matrix Matrix.Norms.Frobenius Topology ContDiff
namespace MAIS.Run2PositiveAmbientFiber
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.OrbitSliceChart MAIS.OrbitSliceAnalytic
open MAIS.Run2PositiveEndpointRegular MAIS.Run2PositiveRegularChart MAIS.Run2PositiveNetworkLoss
open MAIS.Run2ParameterRetainingLinear
variable {D : ℕ} {R : Type*} [Fintype R] [DecidableEq R]
  (κ : Fin (D+1) → Type*) [∀ v,Fintype (κ v)] [∀ v,DecidableEq (κ v)]

/-- Actual ambient local chart and exact actual zero-fiber equivalence, with
actual analytic map and inverse, retaining the literal normal coordinates. -/
theorem exists_ambient_fiber_chart
    (hD : 0 < D) (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (Carrier (R:=R) κ) A).range N)
    (hsplit : ∀ x:N,pathMatrix (A+(x:Rep (Carrier (R:=R) κ)))
      0 (Fin.last D) (Fin.zero_le _) = Matrix.fromBlocks (1:Matrix R R ℝ)
        0 0 (normalResidual κ A N x)) :
    ∃ c : OpenPartialHomeomorph
        ((MAIS.Run2PositiveEndpointRegular.RegularSpace R (κ (Fin.last D)) (κ 0) ×
          Kernel (fderiv ℝ (regularMap κ A H N) 0))×N) (Rep (Carrier (R:=R) κ)),
      0 ∈ c.source ∧ c 0=A ∧ A∈c.target ∧ AnalyticAt ℝ c.symm A ∧
      ∃ U,IsOpen U ∧ 0∈U ∧ U⊆c.source ∧ ∀ y∈U,AnalyticAt ℝ c y ∧
        (pathMatrix (c y) 0 (Fin.last D) (Fin.zero_le _)=standardTarget ↔
          y.1.1=0 ∧ normalResidual κ A N y.2=0) := by
  obtain ⟨e,hsrc,htgt,he0,he,ha,U,hU,hU0,hUt,hfiber⟩ :=
    MAIS.Run2PositiveNetworkFiber.exists_retained_fiber_description κ hD A hA H N hH hN hsplit
  let s := sliceChart (Carrier (R:=R) κ) A H N hH hN
  let c := e.symm.trans s
  have hes0 : e.symm 0=0 := by rw [←he0]; exact e.left_inv hsrc
  have hs0 : 0∈s.source := zero_mem_sliceChart_source _ A H N hH hN
  have hc0 : 0∈c.source := by
    change 0∈e.target ∩ e.symm ⁻¹' s.source
    exact ⟨htgt,by simpa only [mem_preimage,hes0] using hs0⟩
  have hcA : c 0=A := by
    change s (e.symm 0)=A
    rw [hes0]
    exact sliceMap_zero _ A H N
  have hAt : A∈c.target :=
    (congrArg (fun z : Rep (Carrier (R:=R) κ) => z∈c.target) hcA).mp (c.map_source hc0)
  have hca : AnalyticAt ℝ c.symm A := by
    change AnalyticAt ℝ (fun B => e (s.symm B)) A
    have heA : AnalyticAt ℝ e (s.symm A) := ha _
    exact heA.comp (analyticAt_sliceChart_symm _ A H N hH hN)
  refine ⟨c,hc0,hcA,hAt,hca,U∩c.source,hU.inter c.open_source,⟨hU0,hc0⟩,
    inter_subset_right,?_⟩
  intro y hy
  have hya := (hfiber y hy.1).1
  constructor
  · change AnalyticAt ℝ (fun z => sliceMap (Carrier (R:=R) κ) A H N (e.symm z)) y
    exact (analyticAt_sliceMap _ A H N _).comp hya
  · exact (hfiber y hy.1).2

end MAIS.Run2PositiveAmbientFiber

/-- info: 'MAIS.Run2PositiveAmbientFiber.exists_ambient_fiber_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveAmbientFiber.exists_ambient_fiber_chart
end
