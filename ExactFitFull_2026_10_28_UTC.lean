-- ==================== begin module O7.MatrixCoordinateTransport (formalization/O7/MatrixCoordinateTransport.lean) ====================
section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
universe w w'
namespace MAIS.MatrixCoordinateTransport

open scoped Matrix
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
variable {d : ℕ} {ι : Fin (d + 1) → Type w} {κ : Fin (d + 1) → Type w'}
variable [∀ i, Fintype (ι i)] [∀ i, DecidableEq (ι i)]
variable [∀ i, Fintype (κ i)] [∀ i, DecidableEq (κ i)]
variable (e : ∀ i, ι i ≃ κ i)

/-- Literal constant reindexing of each actual rectangular arrow matrix. -/
def transport (A : Rep ι) : Rep κ := fun k =>
  (A k).submatrix (e k.succ).symm (e k.castSucc).symm

def transportUnit {α β : Type*} [Fintype α] [DecidableEq α] [Fintype β] [DecidableEq β]
    (f : α ≃ β) (u : (Matrix α α ℝ)ˣ) : (Matrix β β ℝ)ˣ where
  val := (↑u : Matrix α α ℝ).submatrix f.symm f.symm
  inv := (↑(u⁻¹) : Matrix α α ℝ).submatrix f.symm f.symm
  val_inv := by rw [Matrix.submatrix_mul_equiv, Units.mul_inv, Matrix.submatrix_one_equiv]
  inv_val := by rw [Matrix.submatrix_mul_equiv, Units.inv_mul, Matrix.submatrix_one_equiv]

@[simp] lemma transportUnit_val {α β : Type*} [Fintype α] [DecidableEq α]
    [Fintype β] [DecidableEq β] (f : α ≃ β) (u : (Matrix α α ℝ)ˣ) :
    (↑(transportUnit f u) : Matrix β β ℝ) = (↑u : Matrix α α ℝ).submatrix f.symm f.symm := rfl

@[simp] lemma transportUnit_inv_val {α β : Type*} [Fintype α] [DecidableEq α]
    [Fintype β] [DecidableEq β] (f : α ≃ β) (u : (Matrix α α ℝ)ˣ) :
    (↑((transportUnit f u)⁻¹) : Matrix β β ℝ) =
      (↑(u⁻¹) : Matrix α α ℝ).submatrix f.symm f.symm := rfl

def transportGauge (g : Gauge ι) : Gauge κ := fun i => transportUnit (e i) (g i)

/-- Actual coordinate transport intertwines the genuine matrix-unit gauge actions. -/
theorem transport_smul (g : Gauge ι) (A : Rep ι) :
    transport e (g • A) = transportGauge e g • transport e A := by
  funext k
  simp only [transport, gauge_smul_apply, transportGauge, transportUnit_val, transportUnit_inv_val]
  rw [Matrix.submatrix_mul_equiv, Matrix.submatrix_mul_equiv]

omit [∀ i, Fintype (ι i)] [∀ i, DecidableEq (ι i)]
  [∀ i, Fintype (κ i)] [∀ i, DecidableEq (κ i)] in
/-- Constant coordinate transport is continuous in the ordinary Euclidean matrix topology. -/
theorem continuous_transport : Continuous (transport e) := by
  apply continuous_pi
  intro k
  apply continuous_pi
  intro r
  apply continuous_pi
  intro s
  exact (continuous_apply ((e k.castSucc).symm s)).comp
    ((continuous_apply ((e k.succ).symm r)).comp (continuous_apply k))

theorem transport_mem_orbit {A B : Rep ι} (h : A ∈ MulAction.orbit (Gauge ι) B) :
    transport e A ∈ MulAction.orbit (Gauge κ) (transport e B) := by
  obtain ⟨g, rfl⟩ := MulAction.mem_orbit_iff.mp h
  rw [transport_smul]
  exact MulAction.mem_orbit _ _

/-- Ordinary Euclidean orbit closures transport under actual vertex coordinate bijections. -/
theorem transport_mem_closure_orbit {A B : Rep ι}
    (h : A ∈ closure (MulAction.orbit (Gauge ι) B)) :
    transport e A ∈ closure (MulAction.orbit (Gauge κ) (transport e B)) :=
  map_mem_closure (continuous_transport e) h (fun _ ha => transport_mem_orbit e ha)

/-- Actual consecutive products reindex by exactly the terminal and initial bijections. -/
theorem path_transport (A : Rep ι) (i j : Fin (d + 1)) (hij : i ≤ j) :
    pathMatrix (transport e A) i j hij =
      (pathMatrix A i j hij).submatrix (e j).symm (e i).symm := by
  suffices h : ∀ j : Fin (d + 1), ∀ i (hij : i ≤ j),
      pathMatrix (transport e A) i j hij =
        (pathMatrix A i j hij).submatrix (e j).symm (e i).symm from h j i hij
  intro j
  induction j using Fin.induction with
  | zero =>
    intro i hij
    have hi : i = 0 := le_antisymm hij (by exact Nat.zero_le i.val)
    subst i
    rw [pathMatrix_self, pathMatrix_self, Matrix.submatrix_one_equiv]
  | succ k ih =>
    intro i hij
    by_cases heq : i = k.succ
    · subst i
      rw [pathMatrix_self, pathMatrix_self, Matrix.submatrix_one_equiv]
    · have hne : i.val ≠ k.val + 1 := fun h => heq (Fin.ext h)
      have hij' : i ≤ k.castSucc := by
        change i.val ≤ k.val
        have hle : i.val ≤ k.val + 1 := hij
        omega
      rw [pathMatrix_step _ i k hij', pathMatrix_step _ i k hij', ih i hij']
      exact Matrix.submatrix_mul_equiv (A k) (pathMatrix A i k.castSucc hij')
        (e k.succ).symm (e k.castSucc).symm (e i).symm

/-- Actual path ranks are unchanged by actual constant coordinate transport. -/
theorem path_rank_transport (A : Rep ι) (i j : Fin (d + 1)) (hij : i ≤ j) :
    (pathMatrix (transport e A) i j hij).rank = (pathMatrix A i j hij).rank := by
  rw [path_transport, Matrix.rank_submatrix]

end MAIS.MatrixCoordinateTransport

/-- info: 'MAIS.MatrixCoordinateTransport.transport_mem_closure_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.MatrixCoordinateTransport.transport_mem_closure_orbit
/-- info: 'MAIS.MatrixCoordinateTransport.path_rank_transport' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.MatrixCoordinateTransport.path_rank_transport
end
