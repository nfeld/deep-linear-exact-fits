-- ==================== begin module O7.Run2PositiveNormalFormCounts (formalization/O7/Run2PositiveNormalFormCounts.lean) ====================
section

/-! The actual regular-coordinate finrank is counted by the actual complete
product rank and the original endpoint dimensions. No measured value enters. -/
set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PositiveNormalFormCounts
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.ActiveIntervalDifferential
open MAIS.Run2FullSpanCoordinates MAIS.Run2FullSpanSlice
open MAIS.BarcodeActiveNormalForm MAIS.MatrixCoordinateTransport
variable {D : ℕ} {ι : Fin (D+1) → Type*}
  [∀ v,Fintype (ι v)] [∀ v,DecidableEq (ι v)]

def regularCount (A : Rep ι) : ℕ :=
  (pathMatrix A 0 (Fin.last D) (Nat.zero_le D)).rank *
    (Fintype.card (ι 0)+Fintype.card (ι (Fin.last D))-
      (pathMatrix A 0 (Fin.last D) (Nat.zero_le D)).rank)

/-- The actual finite regular block carrier has the original rank-r output
manifold dimension r(n0+nD-r), independent of the chosen interval normal form. -/
theorem finrank_regular_eq_actual_count {A : Rep ι} (N : ActiveNormalForm A) :
    Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace
      (FullSlot D N.birth N.death) (ReducedIndex D N.birth N.death (Fin.last D))
      (ReducedIndex D N.birth N.death 0)) = regularCount A := by
  have hr := path_rank_transport (vertexEquiv D N.birth N.death)
    (intervalRep D N.birth N.death) 0 (Fin.last D) (Nat.zero_le D)
  change (pathMatrix (splitBase D N.birth N.death) 0 (Fin.last D) (Nat.zero_le D)).rank = _ at hr
  rw [split_base_completeProduct D N.birth N.death N.bounded] at hr
  have hrA : (MAIS.Run2PositiveEndpointRegular.standardTarget :
      Matrix (FullSlot D N.birth N.death ⊕ ReducedIndex D N.birth N.death (Fin.last D))
        (FullSlot D N.birth N.death ⊕ ReducedIndex D N.birth N.death 0) ℝ).rank =
      (pathMatrix A 0 (Fin.last D) (Nat.zero_le D)).rank :=
    hr.trans (N.rank_eq 0 (Fin.last D) (Nat.zero_le D))
  have hc (v : Fin (D+1)) :
      Fintype.card (FullSlot D N.birth N.death ⊕ ReducedIndex D N.birth N.death v) =
        Fintype.card (ι v) :=
    Fintype.card_congr (((vertexEquiv D N.birth N.death v).symm).trans (N.coordinates v))
  rw [MAIS.Run2PositiveRegularDimension.finrank_regularSpace_eq_rank_formula]
  rw [hrA,hc,hc]
  rfl

/-- At an actual prescribed exact fit, the count uses the literal target rank. -/
theorem regularCount_eq_target {A : Rep ι}
    (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = target) :
    regularCount A = target.rank *
      (Fintype.card (ι 0)+Fintype.card (ι (Fin.last D))-target.rank) := by
  simp only [regularCount,hfit]

end MAIS.Run2PositiveNormalFormCounts

/-- info: 'MAIS.Run2PositiveNormalFormCounts.finrank_regular_eq_actual_count' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveNormalFormCounts.finrank_regular_eq_actual_count

/-- info: 'MAIS.Run2PositiveNormalFormCounts.regularCount_eq_target' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveNormalFormCounts.regularCount_eq_target
end
end
