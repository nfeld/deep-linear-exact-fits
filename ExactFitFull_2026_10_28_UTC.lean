-- ==================== begin module O7.ActiveIntervalPathDerivative (formalization/O7/ActiveIntervalPathDerivative.lean) ====================
section

/-! Actual one-jump path derivatives in the physical independent normal
coordinates, at the actual interval base. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000
noncomputable section
namespace MAIS.ActiveIntervalPathDerivative
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalEndpointRows MAIS.ActiveIntervalDirectUpdate
open MAIS.ActiveIntervalNormal MAIS.ActiveIntervalBasePaths
open MAIS.MatrixChainIsomorphism MAIS.MatrixPathLocality
open scoped Matrix
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D+1)

def startVertex (p : NormalIndex birth death) : Fin (D+1) :=
  ⟨birth p.val.2, by
    have hp := p.property
    have hd := hD p.val.1
    change birth p.val.2 < birth p.val.1 ∧ birth p.val.1 ≤ death p.val.2 ∧
      death p.val.2 < death p.val.1 at hp
    omega⟩
def endVertex (p : NormalIndex birth death) : Fin (D+1) :=
  ⟨death p.val.1-1, by
    have hd := hD p.val.1
    omega⟩
omit [Fintype S] [DecidableEq S] in
theorem start_le_end (p : NormalIndex birth death) :
    startVertex D birth death hD p ≤ endVertex D birth death hD p := by
  have hp := p.property
  change birth p.val.2 < birth p.val.1 ∧ birth p.val.1 ≤ death p.val.2 ∧
    death p.val.2 < death p.val.1 at hp
  change birth p.val.2 ≤ death p.val.1-1
  omega

def sourceSlot (p : NormalIndex birth death) : Index D birth death (startVertex D birth death hD p) :=
  ⟨p.val.2, by
    have hp := p.property
    change birth p.val.2 < birth p.val.1 ∧ birth p.val.1 ≤ death p.val.2 ∧
      death p.val.2 < death p.val.1 at hp
    change birth p.val.2 ≤ birth p.val.2 ∧ birth p.val.2 < death p.val.2
    omega⟩
def targetSlot (p : NormalIndex birth death) : Index D birth death (endVertex D birth death hD p) :=
  ⟨p.val.1, by
    have hp := p.property
    change birth p.val.2 < birth p.val.1 ∧ birth p.val.1 ≤ death p.val.2 ∧
      death p.val.2 < death p.val.1 at hp
    change birth p.val.1 ≤ death p.val.1-1 ∧ death p.val.1-1 < death p.val.1
    omega⟩

def selectedPathEntry (p : NormalIndex birth death) (t : NormalParams birth death) : ℝ :=
  pathMatrix (normalFamily D birth death hD t)
    (startVertex D birth death hD p) (endVertex D birth death hD p)
    (start_le_end D birth death hD p)
    (targetSlot D birth death hD p) (sourceSlot D birth death hD p)

omit [Fintype S] in
@[simp] theorem normalFamily_zero : normalFamily D birth death hD 0 = intervalRep D birth death := by
  unfold normalFamily
  rw [map_zero,add_zero]

/-- Every scalar entry of every actual subpath is real analytic in the
    genuine finite normal coordinate carrier. -/
theorem analyticAt_path_entry (i j : Fin (D+1)) (hij : i≤j)
    (r : Index D birth death j) (s : Index D birth death i) (t : NormalParams birth death) :
    AnalyticAt ℝ (fun x => pathMatrix (normalFamily D birth death hD x) i j hij r s) t := by
  induction j using Fin.induction generalizing i with
  | zero =>
    have hi : i=0 := le_antisymm hij (by exact Nat.zero_le i.val)
    subst i
    simpa only [pathMatrix_self] using (analyticAt_const (v := (1 : Matrix (Index D birth death 0) _ ℝ) r s) (x:=t))
  | succ e ih =>
    by_cases hi : i=e.succ
    · subst i
      simpa only [pathMatrix_self] using (analyticAt_const (v := (1 : Matrix (Index D birth death e.succ) _ ℝ) r s) (x:=t))
    · have hie : i≤e.castSucc := by
        change i.val≤e.val
        have hh : i.val≤e.val+1 := hij
        have hn : i.val≠e.val+1 := fun h => hi (Fin.ext h)
        omega
      have hf : (fun x => pathMatrix (normalFamily D birth death hD x) i e.succ hij r s) =
          fun x => ∑ k, normalFamily D birth death hD x e r k *
            pathMatrix (normalFamily D birth death hD x) i e.castSucc hie k s := by
        funext x
        rw [pathMatrix_step _ i e hie,Matrix.mul_apply]
      rw [hf]
      have hsummand : ∀ k : Index D birth death e.castSucc, AnalyticAt ℝ
          (fun x => normalFamily D birth death hD x e r k *
            pathMatrix (normalFamily D birth death hD x) i e.castSucc hie k s) t := by
        intro k
        apply AnalyticAt.mul _ (ih i hie k s)
        unfold normalFamily
        change AnalyticAt ℝ (fun x => intervalRep D birth death e r k +
          normalInjection D birth death hD x e r k) t
        have hlin : AnalyticAt ℝ (fun x => normalInjection D birth death hD x e r k) t := by
          rw [show (fun x => normalInjection D birth death hD x e r k) =
            fun x => if h : Linked birth death r.val k.val then
              x ⟨(r.val,k.val),h⟩ * (if e.val+1=birth r.val then 1 else 0) else 0 by
              funext x; exact normalInjection_apply D birth death hD x e r k]
          by_cases h : Linked birth death r.val k.val
          · simp only [dite_eq_left h]
            exact ((ContinuousLinearMap.proj (R:=ℝ) ⟨(r.val,k.val),h⟩ :
              NormalParams birth death →L[ℝ] ℝ).analyticAt t).mul analyticAt_const
          · simp only [dite_eq_right h]
            exact (analyticAt_const (𝕜:=ℝ) (v:=(0:ℝ)) (x:=t))
        exact analyticAt_const.add hlin
      exact Finset.analyticAt_fun_sum Finset.univ (fun k _ => hsummand k)

private theorem sandwich_single {α β γ δ : Type*}
    [Fintype β] [Fintype γ] [DecidableEq β] [DecidableEq γ]
    (L : Matrix α β ℝ) (R : Matrix γ δ ℝ) (r : β) (s : γ) (τ : ℝ)
    (a : α) (b : δ) :
    (L * Matrix.single r s τ * R) a b = L a r * τ * R s b := by
  rw [Matrix.mul_apply,Finset.sum_eq_single s]
  · rw [Matrix.mul_single_apply_same]
  · intro k _ hk
    rw [Matrix.mul_single_apply_of_ne τ r s a k hk L,zero_mul]
  · simp

/-- An actual basis direction produces exactly one jump in the selected
    path, so its scalar entry is the corresponding literal coordinate. -/
theorem selectedPathEntry_axis (p q : NormalIndex birth death) (τ : ℝ) :
    selectedPathEntry D birth death hD p (τ • Pi.single q 1) =
      if q=p then τ else 0 := by
  let i := startVertex D birth death hD p
  let j := endVertex D birth death hD p
  let e := entranceArrow D birth death hD q
  let r := targetSlot D birth death hD p
  let s := sourceSlot D birth death hD p
  have he : e.val+1=birth q.val.1 := entranceArrow_output D birth death hD q
  have hp:=p.property
  have hq:=q.property
  change birth p.val.2 < birth p.val.1 ∧ birth p.val.1 ≤ death p.val.2 ∧ death p.val.2 < death p.val.1 at hp
  change birth q.val.2 < birth q.val.1 ∧ birth q.val.1 ≤ death q.val.2 ∧ death q.val.2 < death q.val.1 at hq
  have hoff : ∀ k : Fin D, k≠e → normalFamily D birth death hD (τ • Pi.single q 1) k =
      intervalRep D birth death k := by
    intro k hk
    have hh := congrFun (normalFamily_basis_update D birth death hD 0 q τ) k
    rw [zero_add,normalFamily_zero] at hh
    simp only [Pi.add_apply,Pi.smul_apply] at hh
    rw [normalBasis_other_arrow D birth death hD q k hk,smul_zero,add_zero] at hh
    exact hh
  have hbase : pathMatrix (intervalRep D birth death) i j (start_le_end D birth death hD p) r s=0 := by
    rw [pathMatrix_intervalRep_entry]
    have hn : r.val≠s.val := by
      change p.val.1≠p.val.2
      intro h; rw [h] at hp; omega
    simp only [ite_eq_right hn]
  by_cases hie : i≤e.castSucc
  · by_cases hej : e.succ≤j
    · let re : Index D birth death e.succ := ⟨q.val.1,by
        change birth q.val.1≤e.val+1 ∧ e.val+1<death q.val.1; omega⟩
      let se : Index D birth death e.castSucc := ⟨q.val.2,by
        change birth q.val.2≤e.val ∧ e.val<death q.val.2; omega⟩
      have hb : ((normalBasis D birth death hD) q : MAIS.QuiverRealOrbit.Rep (Index D birth death)) e =
          Matrix.single re se 1 := by
        ext u v
        rw [normalBasis_entry,Matrix.single_apply]
        simp only [he,and_true,Subtype.ext_iff,show re.val=q.val.1 from rfl,
          show se.val=q.val.2 from rfl,eq_comm]
      have hd : normalFamily D birth death hD (τ • Pi.single q 1) e - intervalRep D birth death e =
          Matrix.single re se τ := by
        have hh := congrFun (normalFamily_basis_update D birth death hD 0 q τ) e
        rw [zero_add,normalFamily_zero] at hh
        rw [hh]
        change (intervalRep D birth death e+τ •
          (((normalBasis D birth death hD) q : MAIS.QuiverRealOrbit.Rep (Index D birth death)) e))-_ = _
        rw [add_sub_cancel_left,hb,Matrix.smul_single,smul_eq_mul,mul_one]
      have hc := pathMatrix_single_arrow_change
        (normalFamily D birth death hD (τ • Pi.single q 1)) (intervalRep D birth death)
        e hoff i j (start_le_end D birth death hD p) hie hej
      have hx:=congrFun (congrFun hc r) s
      rw [Matrix.add_apply,hbase,zero_add,hd,sandwich_single,
        pathMatrix_intervalRep_entry,pathMatrix_intervalRep_entry] at hx
      change selectedPathEntry D birth death hD p (τ • Pi.single q 1) = _ at hx
      rw [hx]
      by_cases hqp : q=p
      · subst q
        simp only [ite_true,show r.val=re.val from rfl,show se.val=s.val from rfl,one_mul,mul_one]
      · have hn : ¬(r.val=re.val ∧ se.val=s.val) := by
          intro h
          apply hqp
          apply Subtype.ext
          apply Prod.ext
          · exact h.1.symm
          · exact h.2
        by_cases hr : r.val=re.val
        · have hs : se.val≠s.val := fun hs => hn ⟨hr,hs⟩
          simp only [ite_eq_left hr,ite_eq_right hs,ite_eq_right hqp,one_mul,mul_zero]
        · simp only [ite_eq_right hr,ite_eq_right hqp,zero_mul]
    · have hc : pathMatrix (normalFamily D birth death hD (τ • Pi.single q 1)) i j
          (start_le_end D birth death hD p) = pathMatrix (intervalRep D birth death) i j
          (start_le_end D birth death hD p) := by
        apply pathMatrix_congr_of_eq_arrows
        intro k _ hkj
        apply hoff k
        intro hk
        subst k
        exact hej hkj
      change pathMatrix _ i j _ r s = _
      rw [hc,hbase]
      have hn : q≠p := by
        intro h
        subst q
        apply hej
        change e.val+1≤death p.val.1-1
        omega
      simp only [ite_eq_right hn]
  · have hc : pathMatrix (normalFamily D birth death hD (τ • Pi.single q 1)) i j
        (start_le_end D birth death hD p) = pathMatrix (intervalRep D birth death) i j
        (start_le_end D birth death hD p) := by
      apply pathMatrix_congr_of_eq_arrows
      intro k hik _
      apply hoff k
      intro hk
      subst k
      exact hie hik
    change pathMatrix _ i j _ r s = _
    rw [hc,hbase]
    have hn : q≠p := by
      intro h
      subst q
      apply hie
      change birth p.val.2≤e.val
      omega
    simp only [ite_eq_right hn]

/-- The actual selected path entry has exactly the indicated coordinate
    differential at the actual interval base. -/
theorem hasFDerivAt_selectedPathEntry (p : NormalIndex birth death) :
    HasFDerivAt (selectedPathEntry D birth death hD p)
      (ContinuousLinearMap.proj (R:=ℝ) p) 0 := by
  have hf : DifferentiableAt ℝ (selectedPathEntry D birth death hD p) 0 :=
    (analyticAt_path_entry D birth death hD
      (startVertex D birth death hD p) (endVertex D birth death hD p)
      (start_le_end D birth death hD p) (targetSlot D birth death hD p)
      (sourceSlot D birth death hD p) 0).differentiableAt
  have he : fderiv ℝ (selectedPathEntry D birth death hD p) 0 =
      (ContinuousLinearMap.proj (R:=ℝ) p) := by
    have hlin : (fderiv ℝ (selectedPathEntry D birth death hD p) 0).toLinearMap =
        (ContinuousLinearMap.proj (R:=ℝ) p).toLinearMap := by
      apply (Pi.basisFun ℝ (NormalIndex birth death)).ext
      intro q
      simp only [Pi.basisFun_apply]
      have hline : HasDerivAt (fun τ : ℝ => τ • (Pi.single q 1 : NormalParams birth death))
          (Pi.single q 1) 0 := by
        convert (hasDerivAt_id (0:ℝ)).smul_const
          (Pi.single q 1 : NormalParams birth death) using 1 <;> try rfl
        simp only [one_smul]
      have hc : HasDerivAt (fun τ : ℝ => selectedPathEntry D birth death hD p
          (τ • Pi.single q 1))
          (fderiv ℝ (selectedPathEntry D birth death hD p) 0 (Pi.single q 1)) 0 := by
        have hh : HasFDerivAt (selectedPathEntry D birth death hD p)
            (fderiv ℝ (selectedPathEntry D birth death hD p) 0)
            ((0:ℝ) • (Pi.single q 1 : NormalParams birth death)) := by
          simpa only [zero_smul] using hf.hasFDerivAt
        exact hh.comp_hasDerivAt 0 hline
      have ha : HasDerivAt (fun τ : ℝ => selectedPathEntry D birth death hD p
          (τ • Pi.single q 1)) (if q=p then 1 else 0) 0 := by
        simp_rw [selectedPathEntry_axis D birth death hD p q]
        by_cases h : q=p
        · simp only [ite_eq_left h]
          exact hasDerivAt_id 0
        · simp only [ite_eq_right h]
          exact hasDerivAt_const 0 0
      change fderiv ℝ (selectedPathEntry D birth death hD p) 0 (Pi.single q 1) =
        (Pi.single q 1 : NormalParams birth death) p
      rw [hc.unique ha]
      by_cases h : q=p <;> simp [h]
    exact ContinuousLinearMap.ext (fun x => LinearMap.congr_fun hlin x)
  rw [← he]
  exact hf.hasFDerivAt

end MAIS.ActiveIntervalPathDerivative
end

