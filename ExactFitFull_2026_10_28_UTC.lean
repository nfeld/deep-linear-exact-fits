-- ==================== begin module O7.ActiveIntervalMeasuredEntrySlice (formalization/O7/ActiveIntervalMeasuredEntrySlice.lean) ====================
section

/-! The actual zero-output interval slice measured equivalence on the literal
Euclidean balls of ALL original matrix entries, including half loss and priors. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.ActiveIntervalMeasuredEntrySlice
open MAIS.QuiverRealOrbit MAIS.ActiveIntervalDifferential MAIS.MatrixChainIsomorphism
open MAIS.ActiveIntervalMeasuredSlice MAIS.AnalyticTransfer

/-- Positive scaling of the actual centered loss preserves literal band
pairs; the needed sublevel comparisons are proved, not postulated. -/
theorem pair_iff_positive_scale {E : Type*} [MeasurableSpace E]
    (mu : Measure E) (windows : ℝ → Set E) (hmon : Monotone windows)
    (f : E → ℝ) (w : E) (c : ℝ) (hc : 0 < c) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu windows f w lam m ↔
      HasMeasuredBandPair mu windows (fun x => c * f x) w lam m := by
  apply pair_iff_of_local_comparison hmon zero_lt_one hc hc
  intro x _
  rw [← mul_sub, abs_mul, abs_of_pos hc]
  exact ⟨le_rfl, le_rfl⟩

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D+1)

/-- Literal all-original-entry Euclidean windows, with the actual Haar
measure held fixed and both norm comparison constants derived. -/
theorem pair_iff_entry_normal_slice
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muN : Measure (Normal birth death)) [Measure.IsAddHaarMeasure muN]
    (i j : Fin (D+1)) (hij : i ≤ j)
    (hzero : pathMatrix (intervalRep D birth death) i j hij = 0)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair muA
      (MAIS.MatrixChainEntryWindows.entryBall (Index D birth death) (intervalRep D birth death))
      (ambientLoss D birth death i j hij) (intervalRep D birth death) lam m ↔
    HasMeasuredBandPair muN (Metric.ball 0)
      (normalLoss D birth death hD i j hij) 0 lam m :=
  (MAIS.MatrixChainEntryWindows.pair_iff_entryBall (Index D birth death) muA
    (intervalRep D birth death)).symm.trans
    (pair_iff_normal_slice D birth death hD hvalid muA muN i j hij hzero lam m)

/-- The literal original-entry endpoint allows an arbitrary continuous
positive ambient prior, which need not factor through the chart. -/
theorem pair_iff_entry_normal_slice_prior
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muN : Measure (Normal birth death)) [Measure.IsAddHaarMeasure muN]
    (i j : Fin (D+1)) (hij : i ≤ j)
    (hzero : pathMatrix (intervalRep D birth death) i j hij = 0)
    (prior : Ambient D birth death → ℝ)
    (hprior : ContinuousAt prior (intervalRep D birth death))
    (hpos : 0 < prior (intervalRep D birth death)) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair (muA.withDensity (fun A => ENNReal.ofReal (prior A)))
      (MAIS.MatrixChainEntryWindows.entryBall (Index D birth death) (intervalRep D birth death))
      (ambientLoss D birth death i j hij) (intervalRep D birth death) lam m ↔
    HasMeasuredBandPair muN (Metric.ball 0)
      (normalLoss D birth death hD i j hij) 0 lam m :=
  (MAIS.MatrixChainEntryWindows.pair_iff_entryBall (Index D birth death)
    (muA.withDensity (fun A => ENNReal.ofReal (prior A))) (intervalRep D birth death)).symm.trans
    (pair_iff_normal_slice_prior D birth death hD hvalid muA muN i j hij hzero
      prior hprior hpos lam m)

/-- The actual half-squared Frobenius loss and its literal normal half loss,
on the Euclidean balls of all original matrix entries with any positive prior. -/
theorem half_pair_iff_entry_normal_slice_prior
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muN : Measure (Normal birth death)) [Measure.IsAddHaarMeasure muN]
    (i j : Fin (D+1)) (hij : i ≤ j)
    (hzero : pathMatrix (intervalRep D birth death) i j hij = 0)
    (prior : Ambient D birth death → ℝ)
    (hprior : ContinuousAt prior (intervalRep D birth death))
    (hpos : 0 < prior (intervalRep D birth death)) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair (muA.withDensity (fun A => ENNReal.ofReal (prior A)))
      (MAIS.MatrixChainEntryWindows.entryBall (Index D birth death) (intervalRep D birth death))
      (fun A => (1/2 : ℝ) * ambientLoss D birth death i j hij A)
      (intervalRep D birth death) lam m ↔
    HasMeasuredBandPair muN (Metric.ball 0)
      (fun t => (1/2 : ℝ) * normalLoss D birth death hD i j hij t) 0 lam m := by
  have hmon : Monotone (MAIS.MatrixChainEntryWindows.entryBall
      (Index D birth death) (intervalRep D birth death)) := by
    intro a b hab A hA
    exact hA.trans_le hab
  have hA := pair_iff_positive_scale
    (muA.withDensity (fun A => ENNReal.ofReal (prior A))) _ hmon
    (ambientLoss D birth death i j hij) (intervalRep D birth death) (1/2 : ℝ)
    (by norm_num) lam m
  have hN := pair_iff_positive_scale muN (Metric.ball (0 : Normal birth death))
    (fun _ _ hab => Metric.ball_subset_ball hab)
    (normalLoss D birth death hD i j hij) 0 (1/2 : ℝ) (by norm_num) lam m
  exact hA.symm.trans ((pair_iff_entry_normal_slice_prior D birth death hD hvalid
    muA muN i j hij hzero prior hprior hpos lam m).trans hN)

end MAIS.ActiveIntervalMeasuredEntrySlice
end

