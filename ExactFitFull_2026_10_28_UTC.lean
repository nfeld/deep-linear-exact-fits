#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalEmptyResidual.residual_pair

/-- info: 'MAIS.ActiveIntervalEmptyResidual.ambient_entry_half_pair_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalEmptyResidual.ambient_entry_half_pair_iff
