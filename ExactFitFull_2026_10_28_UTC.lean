-- ==================== begin module O7.Run2AllHigherZeroFiber (formalization/O7/Run2AllHigherZeroFiber.lean) ====================
section

/-! Literal zero-fiber equivariance of the Gaussian correction.  The
nonlinear inverse is not assumed equivariant: zero output and the actual
sum-of-squares identity force its direct coordinates to vanish. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1400000
noncomputable section
open Set
open scoped Topology Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2AllHigherZeroFiber
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalDirectElimination MAIS.ActiveIntervalEliminationChart
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.ActiveIntervalAnnulusRecurrence MAIS.ActiveIntervalWeightedAction
open MAIS.ActiveIntervalWeightedResidual MAIS.MatrixChainIsomorphism
open MAIS.QuiverRealOrbit MAIS.QuiverOrbitRank MAIS.ActiveIntervalEndpointRows

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- Restriction to the actual non-direct scalar coordinates. -/
def residualCoordinates (t : NormalParams birth death) : Residual D birth death :=
  fun p => t p.val

theorem gaussian_inverse_fst (t : NormalParams birth death) :
    ((gaussianHomeomorph D birth death hD).symm t).1 =
      residualCoordinates D birth death t := by
  funext p
  change t p.val + directResidual D birth death hD t p.val = t p.val
  rw [directResidual, dite_eq_right p.property, add_zero]

theorem residualCoordinates_zeroDirectParameter (z : Residual D birth death) :
    residualCoordinates D birth death (zeroDirectParameter D birth death hD z) = z := by
  rw [← gaussian_inverse_fst D birth death hD]
  exact congrArg Prod.fst ((gaussianHomeomorph D birth death hD).symm_apply_apply (z, 0))

/-- A genuine zero full product uniquely determines its corrected direct
coordinates from its literal residual restriction. -/
theorem zero_fiber_correction (t : NormalParams birth death)
    (ht : fullProduct D birth death hD t = 0) :
    residualLoss D birth death hD (residualCoordinates D birth death t) = 0 ∧
      t = zeroDirectParameter D birth death hD (residualCoordinates D birth death t) := by
  let p := (gaussianHomeomorph D birth death hD).symm t
  have he := normalSquaredLoss_gaussianHomeomorph D birth death hD p
  have htLoss : normalSquaredLoss D birth death hD t = 0 := by
    change ‖fullProduct D birth death hD t‖ ^ 2 = 0
    rw [ht, norm_zero, zero_pow (by decide : (2 : ℕ) ≠ 0)]
  rw [(gaussianHomeomorph D birth death hD).apply_symm_apply t, htLoss] at he
  have hpH : residualLoss D birth death hD p.1 = 0 := by
    have hn := residualLoss_nonneg D birth death hD p.1
    nlinarith [sq_nonneg ‖p.2‖]
  have hpQ : p.2 = 0 := by
    have hs : ‖p.2‖ ^ 2 = 0 := by rw [hpH, zero_add] at he; exact he.symm
    exact norm_eq_zero.mp (sq_eq_zero_iff.mp hs)
  have hpF : p.1 = residualCoordinates D birth death t :=
    gaussian_inverse_fst D birth death hD t
  refine ⟨hpF ▸ hpH, ?_⟩
  change t = gaussianHomeomorph D birth death hD (_, 0)
  calc
    t = gaussianHomeomorph D birth death hD p :=
      ((gaussianHomeomorph D birth death hD).apply_symm_apply t).symm
    _ = gaussianHomeomorph D birth death hD
        (residualCoordinates D birth death t, 0) := by rw [← hpF, ← hpQ]

omit [Fintype S] [DecidableEq S] in
theorem residualCoordinates_scaleExp (q : S → ℝ) (a : ℝ)
    (t : NormalParams birth death) :
    residualCoordinates D birth death (scaleExp birth death q a t) =
      residualScaleExp D birth death q a (residualCoordinates D birth death t) := rfl

/-- Exact corrected-parameter covariance on the actual zero fiber, for any
real potential. No endpoint or positivity assumption is needed here. -/
theorem zeroDirectParameter_scaleExp (q : S → ℝ) (a : ℝ)
    (z : Residual D birth death) (hz : residualLoss D birth death hD z = 0) :
    scaleExp birth death q a (zeroDirectParameter D birth death hD z) =
      zeroDirectParameter D birth death hD (residualScaleExp D birth death q a z) := by
  have hzero := fullProduct_zeroDirectRep_eq_zero D birth death hD z hz
  have hs : fullProduct D birth death hD
      (scaleExp birth death q a (zeroDirectParameter D birth death hD z)) = 0 := by
    change pathMatrix (normalFamily D birth death hD
      (scaleExp birth death q a (zeroDirectParameter D birth death hD z)))
        0 (Fin.last D) (by exact Nat.zero_le D) = 0
    rw [normalFamily_scaleExp, pathMatrix_gauge]
    change _ * pathMatrix (zeroDirectRep D birth death hD z)
      0 (Fin.last D) (by exact Nat.zero_le D) * _ = 0
    rw [hzero, Matrix.mul_zero, Matrix.zero_mul]
  have he := (zero_fiber_correction D birth death hD _ hs).2
  rw [residualCoordinates_scaleExp, residualCoordinates_zeroDirectParameter] at he
  exact he

/-- The corrected zero-output matrices remain in the same actual real gauge
orbit under every potential exponential dilation. -/
theorem zeroDirectRep_scaleExp_mem_orbit (q : S → ℝ) (a : ℝ)
    (z : Residual D birth death) (hz : residualLoss D birth death hD z = 0) :
    zeroDirectRep D birth death hD (residualScaleExp D birth death q a z) ∈
      MulAction.orbit (Gauge (Index D birth death)) (zeroDirectRep D birth death hD z) := by
  apply MulAction.mem_orbit_iff.mpr
  refine ⟨gaugeExp D birth death q a, ?_⟩
  change gaugeExp D birth death q a • normalFamily D birth death hD
    (zeroDirectParameter D birth death hD z) = normalFamily D birth death hD _
  rw [← normalFamily_scaleExp, zeroDirectParameter_scaleExp D birth death hD q a z hz]

/-- The canonical positive integer residual dilation is an actual gauge
orbit motion of the corrected chain, not merely a covariance of its loss. -/
theorem zeroDirectRep_dilation_mem_orbit
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (r : ℝ) (hr : 0 < r) (z : Residual D birth death)
    (hz : residualLoss D birth death hD z = 0) :
    zeroDirectRep D birth death hD
        (MAIS.WeightedDyadicShells.dilation (integerWeights D birth death) r z) ∈
      MulAction.orbit (Gauge (Index D birth death)) (zeroDirectRep D birth death hD z) := by
  have hproper : ∀ s, 0 < MAIS.IntervalPositivePotentials.denominator D birth death s :=
    fun s => MAIS.IntervalPositivePotentials.denominator_pos_of_zero_path
      D birth death hD hzero s
  change zeroDirectRep D birth death hD (integerDilation D birth death r z) ∈ _
  rw [integerDilation_eq_scaleExp D birth death hD hproper r hr z]
  exact zeroDirectRep_scaleExp_mem_orbit D birth death hD
    (realPotential D birth death)
    ((MAIS.IntervalIntegerPotentials.commonDenominator D birth death : ℝ) * Real.log r) z hz

end MAIS.Run2AllHigherZeroFiber

