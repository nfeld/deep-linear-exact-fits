-- ==================== begin module O7.ActiveIntervalMeasuredSuspension (formalization/O7/ActiveIntervalMeasuredSuspension.lean) ====================
section

/-! Actual measured direct-edge suspension for a zero-output interval chain.
The regular coordinates, their dimension and the chart transport are derived. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.ActiveIntervalMeasuredSuspension

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.MatrixChainIsomorphism MAIS.AnalyticTransfer
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- A known actual residual pair yields the exact unique actual normal-slice
    pair, with half the number of genuine direct scalar coordinates added. -/
theorem normal_pair_iff_of_residual_pair
    (muT : Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR : Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    {a : ℝ} {m : ℕ}
    (hres : HasMeasuredBandPair muR (Metric.ball 0) (residualLoss D birth death hD) 0 a m)
    (lam : ℝ) (n : ℕ) :
    HasMeasuredBandPair muT (Metric.ball 0) (normalSquaredLoss D birth death hD) 0 lam n ↔
      lam = a + (Fintype.card (DirectIndex D birth death) : ℝ) / 2 ∧ n = m := by
  let Q := Regular D birth death
  let muQ : Measure Q := addHaar
  let e := (gaussianHomeomorph D birth death hD).toOpenPartialHomeomorph
  let f : Residual D birth death × Q → ℝ :=
    fun p => residualLoss D birth death hD p.1 + ‖p.2‖^2
  have he0 : e 0 = 0 := gaussianHomeomorph_zero D birth death hD
  have hf : Measurable f :=
    ((continuous_residualLoss D birth death hD).comp continuous_fst).measurable.add
      (continuous_snd.norm.pow 2).measurable
  have hchart := MAIS.CrossCarrierChartTransfer.pair_iff_of_chart_local
    (muR.prod muQ) muT e (by trivial)
    (analyticAt_gaussianHomeomorph D birth death hD 0).contDiffAt
    (by
      rw [he0]
      change ContDiffAt ℝ 1 (gaussianHomeomorph D birth death hD).symm 0
      exact (analyticAt_gaussianHomeomorph_symm D birth death hD 0).contDiffAt)
    hf (continuous_normalSquaredLoss D birth death hD).measurable
    (fun p _ => (normalSquaredLoss_gaussianHomeomorph D birth death hD p).symm)
    (lam := lam) (m := n)
  rw [he0] at hchart
  have hs := MAIS.RegularSquareSuspension.pair_iff_scaled_quadratic_suspension muQ hres
    zero_lt_one
    (fun z _ => by
      rw [residualLoss_zero D birth death hD hzero, sub_zero]
      exact residualLoss_nonneg D birth death hD z)
    1 zero_lt_one lam n
  have hdim : Module.finrank ℝ Q = Fintype.card (DirectIndex D birth death) :=
    finrank_regular D birth death
  simp only [one_mul, hdim] at hs
  change HasMeasuredBandPair (muR.prod muQ) (Metric.ball (0 : Residual D birth death × Q))
    f 0 lam n ↔ lam = a + (Fintype.card (DirectIndex D birth death) : ℝ) / 2 ∧ n = m at hs
  exact hchart.symm.trans hs

/-- The actual full ambient matrix-entry loss inherits the same recurrence
    after the already proved physical slice and gauge-spectator reductions. -/
theorem ambient_pair_iff_of_residual_pair
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (MAIS.ActiveIntervalMeasuredSlice.Ambient D birth death))
    [Measure.IsAddHaarMeasure muA]
    (muT : Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR : Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    {a : ℝ} {m : ℕ}
    (hres : HasMeasuredBandPair muR (Metric.ball 0) (residualLoss D birth death hD) 0 a m)
    (lam : ℝ) (n : ℕ) :
    HasMeasuredBandPair muA (Metric.ball (intervalRep D birth death))
      (MAIS.ActiveIntervalMeasuredSlice.ambientLoss D birth death 0 (Fin.last D)
        (by exact Nat.zero_le D)) (intervalRep D birth death) lam n ↔
      lam = a + (Fintype.card (DirectIndex D birth death) : ℝ) / 2 ∧ n = m :=
  (MAIS.ActiveIntervalMeasuredSlice.pair_iff_normal_slice D birth death hD hvalid
    muA muT 0 (Fin.last D) (by exact Nat.zero_le D) hzero lam n).trans
    (normal_pair_iff_of_residual_pair D birth death hD muT muR hzero hres lam n)

/-- Literal half-squared loss on all-original-entry Euclidean balls, with an
    arbitrary ambient continuous positive prior and a derived regular shift. -/
theorem ambient_entry_half_pair_iff_of_residual_pair
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (MAIS.ActiveIntervalMeasuredSlice.Ambient D birth death))
    [Measure.IsAddHaarMeasure muA]
    (muT : Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR : Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    (prior : MAIS.ActiveIntervalMeasuredSlice.Ambient D birth death → ℝ)
    (hprior : ContinuousAt prior (intervalRep D birth death))
    (hpos : 0 < prior (intervalRep D birth death))
    {a : ℝ} {m : ℕ}
    (hres : HasMeasuredBandPair muR (Metric.ball 0) (residualLoss D birth death hD) 0 a m)
    (lam : ℝ) (n : ℕ) :
    HasMeasuredBandPair (muA.withDensity (fun A => ENNReal.ofReal (prior A)))
      (MAIS.MatrixChainEntryWindows.entryBall (Index D birth death) (intervalRep D birth death))
      (fun A => (1/2 : ℝ) * MAIS.ActiveIntervalMeasuredSlice.ambientLoss D birth death
        0 (Fin.last D) (by exact Nat.zero_le D) A) (intervalRep D birth death) lam n ↔
      lam = a + (Fintype.card (DirectIndex D birth death) : ℝ) / 2 ∧ n = m := by
  have hA := MAIS.ActiveIntervalMeasuredEntrySlice.half_pair_iff_entry_normal_slice_prior
    D birth death hD hvalid muA muT 0 (Fin.last D) (by exact Nat.zero_le D)
    hzero prior hprior hpos lam n
  have hN := MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_positive_scale muT
    (Metric.ball (0 : NormalParams birth death))
    (fun _ _ hab => Metric.ball_subset_ball hab)
    (normalSquaredLoss D birth death hD) 0 (1/2 : ℝ) (by norm_num) lam n
  exact hA.trans (hN.symm.trans
    (normal_pair_iff_of_residual_pair D birth death hD muT muR hzero hres lam n))

end MAIS.ActiveIntervalMeasuredSuspension
end
end
