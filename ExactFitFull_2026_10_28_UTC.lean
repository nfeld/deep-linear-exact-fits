-- ==================== begin module O7.WeightedDyadicShells (formalization/O7/WeightedDyadicShells.lean) ====================
section

/-! Actual integer-weight diagonal dilations, their exact Haar volume, and
literal dyadic weighted boxes/shells. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 500000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal Matrix
namespace MAIS.WeightedDyadicShells
variable {I:Type*} [Fintype I] [DecidableEq I]

def dilation (W:I→ℕ) (r:ℝ) (x:I→ℝ) : I→ℝ:=fun i=>r^(W i)*x i

def dilationEquiv (W:I→ℕ) (r:ℝ) (hr:r≠0) : (I→ℝ)≃L[ℝ] (I→ℝ) :=
  ({ toFun:=dilation W r
     invFun:=fun y i=>(r^(W i))⁻¹*y i
     left_inv:=by intro x;funext i;simp [dilation,pow_ne_zero _ hr]
     right_inv:=by intro x;funext i;simp [dilation,pow_ne_zero _ hr]
     map_add':=by intro x y;funext i;simp [dilation,mul_add]
     map_smul':=by intro c x;funext i;simp only [dilation,Pi.smul_apply,smul_eq_mul,RingHom.id_apply];ring }
    : (I→ℝ)≃ₗ[ℝ] (I→ℝ)).toContinuousLinearEquiv

omit [Fintype I] [DecidableEq I] in
theorem dilation_mul (W:I→ℕ) (r s:ℝ) (x:I→ℝ) :
    dilation W r (dilation W s x)=dilation W (r*s) x := by
  funext i
  simp only [dilation,mul_pow]
  ring

omit [Fintype I] [DecidableEq I] in
theorem dilation_one (W:I→ℕ) (x:I→ℝ) : dilation W 1 x=x := by
  funext i
  simp [dilation]

theorem det_dilationEquiv (W:I→ℕ) (r:ℝ) (hr:r≠0) :
    ((dilationEquiv W r hr): (I→ℝ)→L[ℝ] (I→ℝ)).det=r^(∑ i,W i) := by
  change LinearMap.det (dilationEquiv W r hr).toLinearEquiv.toLinearMap=_
  rw [← LinearMap.det_toMatrix']
  have hm:LinearMap.toMatrix' (dilationEquiv W r hr).toLinearEquiv.toLinearMap=
      Matrix.diagonal (fun i=>r^(W i)) := by
    ext i j
    rw [LinearMap.toMatrix'_apply]
    by_cases h:i=j <;> simp [dilationEquiv,dilation,h]
  rw [hm,Matrix.det_diagonal,Finset.prod_pow_eq_pow_sum]

theorem measure_dilation_image (mu:Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (W:I→ℕ) (r:ℝ) (hr:0<r) (U:Set (I→ℝ)) :
    mu (dilation W r '' U)=ENNReal.ofReal (r^(∑ i,W i))*mu U := by
  have hh:=mu.addHaar_image_continuousLinearEquiv (dilationEquiv W r (ne_of_gt hr)) U
  change mu (dilation W r '' U)=_ at hh
  change mu (dilation W r '' U)=ENNReal.ofReal
    |((dilationEquiv W r (ne_of_gt hr)): (I→ℝ)→L[ℝ] (I→ℝ)).det| *mu U at hh
  rw [det_dilationEquiv,abs_of_pos (pow_pos hr _)] at hh
  exact hh

def box (W:I→ℕ) (k:ℕ) : Set (I→ℝ):={x|∀ i,|x i|≤(1/2:ℝ)^(k*W i)}
def annulus (W:I→ℕ) : Set (I→ℝ):=box W 0 \ box W 1
def shell (W:I→ℕ) (k:ℕ) : Set (I→ℝ):=box W k \ box W (k+1)

omit [DecidableEq I] in
theorem measurableSet_box (W:I→ℕ) (k:ℕ) : MeasurableSet (box W k) := by
  have he:box W k=⋂ i,{x:I→ℝ | |x i|≤(1/2:ℝ)^(k*W i)} := by
    ext x
    simp [box]
  rw [he]
  exact (isClosed_iInter (fun i=>isClosed_le
    (continuous_apply i : Continuous (fun x:I→ℝ=>x i)).abs continuous_const)).measurableSet

omit [Fintype I] [DecidableEq I] in
theorem box_antitone (W:I→ℕ) : Antitone (box W) := by
  intro n m h x hx i
  exact (hx i).trans (pow_le_pow_of_le_one (by norm_num) (by norm_num)
    (Nat.mul_le_mul_right (W i) h))

omit [DecidableEq I] in
theorem box_image (W:I→ℕ) (r:ℝ) (hr:0<r) (k:ℕ) :
    dilation W r '' box W k={x|∀ i,|x i|≤r^(W i)*(1/2:ℝ)^(k*W i)} := by
  ext x
  constructor
  · rintro ⟨y,hy,rfl⟩ i
    simp only [dilation,abs_mul,abs_of_pos (pow_pos hr _)]
    exact mul_le_mul_of_nonneg_left (hy i) (le_of_lt (pow_pos hr _))
  · intro hx
    refine ⟨(dilationEquiv W r (ne_of_gt hr)).symm x,?_,?_⟩
    · intro i
      change |(r^(W i))⁻¹*x i|≤_
      rw [abs_mul,abs_of_pos (inv_pos.mpr (pow_pos hr _))]
      exact (inv_mul_le_iff₀ (pow_pos hr _)).mpr (hx i)
    · exact (dilationEquiv W r (ne_of_gt hr)).apply_symm_apply x

omit [DecidableEq I] in
theorem dyadic_box_image (W:I→ℕ) (k:ℕ) :
    dilation W ((1/2:ℝ)^k) '' box W 0=box W k := by
  rw [box_image W _ (pow_pos (by norm_num) _)]
  ext x
  simp only [box,Nat.zero_mul,pow_zero,mul_one,← pow_mul]

omit [DecidableEq I] in
theorem dyadic_next_box_image (W:I→ℕ) (k:ℕ) :
    dilation W ((1/2:ℝ)^k) '' box W 1=box W (k+1) := by
  rw [box_image W _ (pow_pos (by norm_num) _)]
  ext x
  simp only [box,one_mul,← pow_mul,← pow_add,Nat.add_mul ]

omit [DecidableEq I] in
theorem dyadic_shell_image (W:I→ℕ) (k:ℕ) :
    dilation W ((1/2:ℝ)^k) '' annulus W=shell W k := by
  rw [annulus,Set.image_sdiff (f:=dilation W ((1/2:ℝ)^k)) (dilationEquiv W _ (pow_ne_zero _ (by norm_num))).injective,
    dyadic_box_image,dyadic_next_box_image]
  rfl

omit [Fintype I] [DecidableEq I] in
/-- The actual nested weighted boxes shrink to precisely the origin. -/
theorem iInter_box (W:I→ℕ) (hW:∀ i,0<W i) :
    (⋂ k:ℕ,box W k)={(0:I→ℝ)} := by
  ext x
  constructor
  · intro hx
    apply Set.mem_singleton_iff.mpr
    funext i
    have hle:∀ k:ℕ,|x i|≤(1/2:ℝ)^k := by
      intro k
      have hh:|x i|≤(1/2:ℝ)^(k*W i):=(Set.mem_iInter.mp hx k) i
      exact hh.trans (pow_le_pow_of_le_one (by norm_num) (by norm_num)
        (by simpa using Nat.mul_le_mul_left k (hW i)))
    have hz:|x i|≤(0:ℝ):=ge_of_tendsto
      (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num:0≤(1/2:ℝ)) (by norm_num))
      (Filter.Eventually.of_forall hle)
    exact abs_eq_zero.mp (le_antisymm hz (abs_nonneg _))
  · rintro rfl
    apply Set.mem_iInter.mpr
    intro k i
    simp only [Pi.zero_apply,abs_zero]
    positivity

omit [Fintype I] [DecidableEq I] in
theorem shell_pairwise_disjoint (W:I→ℕ) :
    Pairwise (fun k l:ℕ=>Disjoint (shell W k) (shell W l)) := by
  intro k l hne
  apply Set.disjoint_left.mpr
  intro x hxk hxl
  rcases lt_or_gt_of_ne hne with hkl|hlk
  · exact hxk.2 (box_antitone W (Nat.succ_le_of_lt hkl) hxl.1)
  · exact hxl.2 (box_antitone W (Nat.succ_le_of_lt hlk) hxk.1)

omit [Fintype I] [DecidableEq I] in
/-- Actual disjoint dyadic shell partition, without dropping the origin
    or silently assigning it zero measure in dimension zero. -/
theorem iUnion_shell (W:I→ℕ) (hW:∀ i,0<W i) :
    (⋃ k:ℕ,shell W k)=box W 0 \ {(0:I→ℝ)} := by
  classical
  ext x
  constructor
  · intro hx
    obtain ⟨k,hk⟩:=Set.mem_iUnion.mp hx
    refine ⟨box_antitone W (Nat.zero_le k) hk.1,?_⟩
    intro hz
    have hx0:x=0:=Set.mem_singleton_iff.mp hz
    subst x
    apply hk.2
    intro i
    simp only [Pi.zero_apply,abs_zero]
    positivity
  · intro hx
    have hex:∃ n:ℕ,x∉box W n:=by
      by_contra hn
      push Not at hn
      have hi:x∈⋂ n:ℕ,box W n:=Set.mem_iInter.mpr hn
      rw [iInter_box W hW] at hi
      exact hx.2 hi
    have hn0:Nat.find hex≠0:=by
      intro h
      have hh:=Nat.find_spec hex
      rw [h] at hh
      exact hh hx.1
    have hpos:1≤Nat.find hex:=Nat.one_le_iff_ne_zero.mpr hn0
    have hk:x∈box W (Nat.find hex-1):=by
      by_contra hnot
      have hle:=Nat.find_min' hex hnot
      omega
    apply Set.mem_iUnion.mpr
    refine ⟨Nat.find hex-1,hk,?_⟩
    simpa only [Nat.sub_add_cancel hpos] using Nat.find_spec hex

end MAIS.WeightedDyadicShells
end

