-- ==================== begin module O7.IntervalIntegerPotentials (formalization/O7/IntervalIntegerPotentials.lean) ====================
section

/-! A finite explicit clearing of the rational interval potentials.  The
resulting actual edge weights are strictly positive natural numbers. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000

namespace MAIS.IntervalIntegerPotentials
open MAIS.IntervalPositivePotentials MAIS.IntervalCochainProduct
variable {S : Type*} [Fintype S]
variable (D : ℕ) (birth death : S → ℕ)

def commonDenominator : ℕ := ∏ s : S, denominator D birth death s

def integerPotential (s : S) : ℕ :=
  birth s * (commonDenominator D birth death / denominator D birth death s)

def integerWeight (p : NormalIndex birth death) : ℕ :=
  integerPotential D birth death p.val.1 - integerPotential D birth death p.val.2

theorem denominator_dvd_common (s : S) :
    denominator D birth death s ∣ commonDenominator D birth death := by
  exact Finset.dvd_prod_of_mem (denominator D birth death) (Finset.mem_univ s)

theorem commonDenominator_pos (hproper : ∀ s, 0 < denominator D birth death s) :
    0 < commonDenominator D birth death := by
  apply Finset.prod_pos
  intro s _
  exact hproper s

/-- The natural potential is literally the rational potential multiplied by
    the displayed common denominator, with exact natural division justified. -/
theorem integerPotential_cast (s : S) :
    (integerPotential D birth death s : ℚ) =
      (commonDenominator D birth death : ℚ) * potential D birth death s := by
  rw [integerPotential, Nat.cast_mul,
    Nat.cast_div_charZero (denominator_dvd_common D birth death s)]
  unfold potential
  ring

theorem integerPotential_lt_of_linked (hD : ∀ s, death s ≤ D + 1)
    (hproper : ∀ s, 0 < denominator D birth death s)
    (r s : S) (hp : Linked birth death r s) :
    integerPotential D birth death s < integerPotential D birth death r := by
  have hq := potential_lt_of_linked D birth death hD r s hp
  have hN : (0 : ℚ) < (commonDenominator D birth death : ℚ) :=
    Nat.cast_pos.mpr (commonDenominator_pos D birth death hproper)
  have h := mul_lt_mul_of_pos_left hq hN
  rw [← integerPotential_cast D birth death s, ← integerPotential_cast D birth death r] at h
  exact_mod_cast h

theorem integerWeight_pos (hD : ∀ s, death s ≤ D + 1)
    (hproper : ∀ s, 0 < denominator D birth death s) (p : NormalIndex birth death) :
    0 < integerWeight D birth death p := by
  exact Nat.sub_pos_of_lt
    (integerPotential_lt_of_linked D birth death hD hproper p.val.1 p.val.2 p.property)

theorem integerWeight_cast (hD : ∀ s, death s ≤ D + 1)
    (hproper : ∀ s, 0 < denominator D birth death s) (p : NormalIndex birth death) :
    (integerWeight D birth death p : ℚ) =
      (commonDenominator D birth death : ℚ) * edgeWeight D birth death p := by
  rw [integerWeight, Nat.cast_sub
    (integerPotential_lt_of_linked D birth death hD hproper p.val.1 p.val.2 p.property).le,
    integerPotential_cast, integerPotential_cast]
  unfold edgeWeight
  ring

theorem integerPotential_birth_zero (s : S) (hs : birth s = 0) :
    integerPotential D birth death s = 0 := by simp [integerPotential, hs]

theorem integerPotential_death_last (hproper : ∀ s, 0 < denominator D birth death s)
    (s : S) (hs : death s = D + 1) :
    integerPotential D birth death s = commonDenominator D birth death := by
  have h := integerPotential_cast D birth death s
  rw [potential_death_last D birth death s hs (hproper s), mul_one] at h
  exact_mod_cast h

theorem integerPotential_le_common (s : S) :
    integerPotential D birth death s ≤ commonDenominator D birth death := by
  have hq := potential_le_one D birth death s
  have h := mul_le_mul_of_nonneg_left hq
    (Nat.cast_nonneg (commonDenominator D birth death) : (0 : ℚ) ≤ _)
  rw [← integerPotential_cast D birth death s, mul_one] at h
  exact_mod_cast h

theorem integerWeight_le_common (p : NormalIndex birth death) :
    integerWeight D birth death p ≤ commonDenominator D birth death :=
  (Nat.sub_le _ _).trans (integerPotential_le_common D birth death p.val.1)

end MAIS.IntervalIntegerPotentials
end
-- ==================== end module O7.IntervalIntegerPotentials ====================

-- ==================== begin module O7.ActiveIntervalWeightedResidual (formalization/O7/ActiveIntervalWeightedResidual.lean) ====================
section

/-! Exact positive rational and positive integer weighted homogeneity of the
COMPLETE actual residual path map and its literal residual squared loss. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section

namespace MAIS.ActiveIntervalWeightedResidual

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalDirectElimination MAIS.ActiveIntervalGaussianCoordinates
open MAIS.IntervalPositivePotentials MAIS.IntervalIntegerPotentials
open MAIS.ActiveIntervalWeightedAction MAIS.MatrixChainIsomorphism
open scoped Matrix Topology
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

def realPotential (s : S) : ℝ := (potential D birth death s : ℝ)

def residualScaleExp (q : S → ℝ) (lam : ℝ) (z : Residual D birth death) :
    Residual D birth death := fun p =>
  Real.exp (lam * (q p.val.val.1 - q p.val.val.2)) * z p

omit [DecidableEq S] in
theorem residualInjection_scaleExp (q : S → ℝ) (lam : ℝ) (z : Residual D birth death) :
    residualInjection D birth death (residualScaleExp D birth death q lam z) =
      scaleExp birth death q lam (residualInjection D birth death z) := by
  funext p
  change (coordinateSplit D birth death).symm
    (residualScaleExp D birth death q lam z,0) p =
      Real.exp (lam * (q p.val.1-q p.val.2)) * (coordinateSplit D birth death).symm (z,0) p
  rw [coordinateSplit_symm_apply, coordinateSplit_symm_apply]
  by_cases hp : IsDirect D birth death p
  · simp only [dite_eq_left hp, PiLp.zero_apply, mul_zero]
  · simp only [dite_eq_right hp, residualScaleExp]

theorem fullProduct_residualScaleExp (q : S → ℝ) (lam : ℝ) (z : Residual D birth death)
    (hin : ∀ s, birth s = 0 → q s = 0)
    (hout : ∀ s, death s = D + 1 → q s = 1) :
    fullProduct D birth death hD
      (residualInjection D birth death (residualScaleExp D birth death q lam z)) =
      Real.exp lam • fullProduct D birth death hD (residualInjection D birth death z) := by
  rw [residualInjection_scaleExp]
  exact fullProduct_scaleExp D birth death hD q lam (residualInjection D birth death z) hin hout

theorem residualLoss_scaleExp (q : S → ℝ) (lam : ℝ) (z : Residual D birth death)
    (hin : ∀ s, birth s = 0 → q s = 0)
    (hout : ∀ s, death s = D + 1 → q s = 1) :
    residualLoss D birth death hD (residualScaleExp D birth death q lam z) =
      (Real.exp lam)^2 * residualLoss D birth death hD z := by
  have hF := fullProduct_residualScaleExp D birth death hD q lam z hin hout
  unfold residualLoss
  rw [hF]
  simp only [Matrix.smul_apply, smul_eq_mul, mul_pow]
  simp only [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro r _
  apply Finset.sum_congr rfl
  intro s _
  split_ifs <;> simp

include hD in
omit [Fintype S] [DecidableEq S] in
theorem real_edgeWeight_pos (p : NormalIndex birth death) :
    0 < realPotential D birth death p.val.1 - realPotential D birth death p.val.2 := by
  have h := edgeWeight_pos D birth death hD p
  unfold edgeWeight at h
  unfold realPotential
  exact_mod_cast h

omit [Fintype S] [DecidableEq S] in
theorem realPotential_birth_zero (s : S) (hs : birth s = 0) :
    realPotential D birth death s = 0 := by
  unfold realPotential
  rw [potential_birth_zero D birth death s hs, Rat.cast_zero]

omit [Fintype S] [DecidableEq S] in
theorem realPotential_death_last
    (hproper : ∀ s, 0 < denominator D birth death s) (s : S) (hs : death s = D + 1) :
    realPotential D birth death s = 1 := by
  unfold realPotential
  rw [potential_death_last D birth death s hs (hproper s), Rat.cast_one]

def rationalDilation (r : ℝ) (z : Residual D birth death) : Residual D birth death :=
  residualScaleExp D birth death (realPotential D birth death) (Real.log r) z

omit [Fintype S] [DecidableEq S] in
theorem rationalDilation_apply (r : ℝ) (hr : 0 < r) (z : Residual D birth death)
    (p : ResidualIndex D birth death) :
    rationalDilation D birth death r z p =
      r ^ (edgeWeight D birth death p.val : ℝ) * z p := by
  simp only [rationalDilation, residualScaleExp, realPotential, edgeWeight,
    Rat.cast_sub, Real.rpow_def_of_pos hr]

theorem residualLoss_rationalDilation
    (hproper : ∀ s, 0 < denominator D birth death s)
    (r : ℝ) (hr : 0 < r) (z : Residual D birth death) :
    residualLoss D birth death hD (rationalDilation D birth death r z) =
      r ^ 2 * residualLoss D birth death hD z := by
  have h := residualLoss_scaleExp D birth death hD (realPotential D birth death)
    (Real.log r) z (realPotential_birth_zero D birth death)
    (realPotential_death_last D birth death hproper)
  simpa only [rationalDilation, Real.exp_log hr] using h

/-- Literal natural-power dilation with strictly positive actual finite weights. -/
def integerDilation (r : ℝ) (z : Residual D birth death) : Residual D birth death :=
  fun p => r ^ integerWeight D birth death p.val * z p

include hD in
omit [DecidableEq S] in
theorem integerDilation_eq_scaleExp
    (hproper : ∀ s, 0 < denominator D birth death s)
    (r : ℝ) (hr : 0 < r) (z : Residual D birth death) :
    integerDilation D birth death r z = residualScaleExp D birth death
      (realPotential D birth death) ((commonDenominator D birth death : ℝ) * Real.log r) z := by
  funext p
  have hw : (integerWeight D birth death p.val : ℝ) =
      (commonDenominator D birth death : ℝ) *
        (realPotential D birth death p.val.val.1 - realPotential D birth death p.val.val.2) := by
    have h := integerWeight_cast D birth death hD hproper p.val
    unfold edgeWeight at h
    unfold realPotential
    exact_mod_cast h
  change r ^ integerWeight D birth death p.val * z p = _
  rw [← Real.rpow_natCast, Real.rpow_def_of_pos hr, hw]
  unfold residualScaleExp
  congr 2
  ring

omit [DecidableEq S] in
private theorem exp_common_log (r : ℝ) (hr : 0 < r) :
    Real.exp ((commonDenominator D birth death : ℝ) * Real.log r) =
      r ^ commonDenominator D birth death := by
  rw [mul_comm, Real.exp_mul, Real.exp_log hr, Real.rpow_natCast]

/-- The COMPLETE residual path matrix has the displayed common integer degree. -/
theorem fullProduct_integerDilation
    (hproper : ∀ s, 0 < denominator D birth death s)
    (r : ℝ) (hr : 0 < r) (z : Residual D birth death) :
    fullProduct D birth death hD (residualInjection D birth death (integerDilation D birth death r z)) =
      r ^ commonDenominator D birth death •
        fullProduct D birth death hD (residualInjection D birth death z) := by
  rw [integerDilation_eq_scaleExp D birth death hD hproper r hr z]
  rw [fullProduct_residualScaleExp D birth death hD (realPotential D birth death)
    ((commonDenominator D birth death : ℝ) * Real.log r) z
    (realPotential_birth_zero D birth death) (realPotential_death_last D birth death hproper)]
  rw [exp_common_log D birth death r hr]

/-- Exact positive-integer weighted homogeneity of the literal residual loss. -/
theorem residualLoss_integerDilation
    (hproper : ∀ s, 0 < denominator D birth death s)
    (r : ℝ) (hr : 0 < r) (z : Residual D birth death) :
    residualLoss D birth death hD (integerDilation D birth death r z) =
      r ^ (2 * commonDenominator D birth death) * residualLoss D birth death hD z := by
  rw [integerDilation_eq_scaleExp D birth death hD hproper r hr z]
  rw [residualLoss_scaleExp D birth death hD (realPotential D birth death)
    ((commonDenominator D birth death : ℝ) * Real.log r) z
    (realPotential_birth_zero D birth death) (realPotential_death_last D birth death hproper)]
  rw [exp_common_log D birth death r hr, ← pow_mul]
  rw [Nat.mul_comm]

include hD in
omit [DecidableEq S] in
theorem integerDilation_zero
    (hproper : ∀ s, 0 < denominator D birth death s) (z : Residual D birth death) :
    integerDilation D birth death 0 z = 0 := by
  funext p
  have hp := integerWeight_pos D birth death hD hproper p.val
  simp only [integerDilation, zero_pow (by omega : integerWeight D birth death p.val ≠ 0),
    zero_mul, Pi.zero_apply]

omit [DecidableEq S] in
theorem continuous_integerDilation (z : Residual D birth death) :
    Continuous (fun r : ℝ => integerDilation D birth death r z) := by
  apply continuous_pi
  intro p
  exact (continuous_id.pow _).mul_const (z p)

omit [DecidableEq S] in
theorem integerDilation_mul (r s : ℝ) (z : Residual D birth death) :
    integerDilation D birth death (r*s) z =
      integerDilation D birth death r (integerDilation D birth death s z) := by
  funext p
  simp only [integerDilation, mul_pow, mul_assoc]

omit [DecidableEq S] in
theorem integerDilation_one (z : Residual D birth death) :
    integerDilation D birth death 1 z = z := by
  funext p
  simp only [integerDilation, one_pow, one_mul]

include hD in
omit [DecidableEq S] in
/-- The genuine positive-weight polynomial dilation contracts every residual
    parameter to the origin; this is a statement about the actual carrier. -/
theorem tendsto_integerDilation_zero
    (hproper : ∀ s, 0 < denominator D birth death s) (z : Residual D birth death) :
    Filter.Tendsto (fun r : ℝ => integerDilation D birth death r z) (𝓝 0) (𝓝 0) := by
  simpa only [integerDilation_zero D birth death hD hproper z] using
    (continuous_integerDilation D birth death z).tendsto 0

include hD in
/-- An actual zero-product base supplies all properness and positive integer
    weight conditions; no weighted action or degree is assumed. -/
theorem zero_base_weight_data
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) = 0) :
    0 < commonDenominator D birth death ∧
      ∀ p : ResidualIndex D birth death,
        0 < integerWeight D birth death p.val ∧
          integerWeight D birth death p.val ≤ commonDenominator D birth death := by
  have hp := denominator_pos_of_zero_path D birth death hD hzero
  exact ⟨commonDenominator_pos D birth death hp, fun p =>
    ⟨integerWeight_pos D birth death hD hp p.val, integerWeight_le_common D birth death p.val⟩⟩

/-- The actual zero base yields exact integer homogeneity of the COMPLETE
    residual path matrix on every positive radius. -/
theorem zero_base_fullProduct_integerDilation
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    (r : ℝ) (hr : 0 < r) (z : Residual D birth death) :
    fullProduct D birth death hD (residualInjection D birth death (integerDilation D birth death r z)) =
      r ^ commonDenominator D birth death •
        fullProduct D birth death hD (residualInjection D birth death z) :=
  fullProduct_integerDilation D birth death hD
    (denominator_pos_of_zero_path D birth death hD hzero) r hr z

/-- The literal residual squared loss has exact positive integer weighted
    degree twice the explicit common degree, at every actual zero base. -/
theorem zero_base_residualLoss_integerDilation
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    (r : ℝ) (hr : 0 < r) (z : Residual D birth death) :
    residualLoss D birth death hD (integerDilation D birth death r z) =
      r ^ (2 * commonDenominator D birth death) * residualLoss D birth death hD z :=
  residualLoss_integerDilation D birth death hD
    (denominator_pos_of_zero_path D birth death hD hzero) r hr z

end MAIS.ActiveIntervalWeightedResidual
end
end
-- ==================== end module O7.ActiveIntervalWeightedResidual ====================

-- ==================== begin module O7.ContinuousUnitTransfer (formalization/O7/ContinuousUnitTransfer.lean) ====================
section

/-! Actual centered band pairs are invariant under a continuous nonzero
factor of the centered loss difference. Signed factors are allowed: the
measured band uses absolute values, and the local positive bounds are
derived for the absolute value of the factor. -/

set_option autoImplicit false
noncomputable section

open Set Filter MeasureTheory
open scoped Topology

namespace MAIS.ContinuousUnitTransfer

open MAIS.AnalyticTransfer

/-- Actual pair invariance under a continuous nonvanishing factor in the
centered loss germ. The factor may have either sign. -/
theorem pair_iff_of_centered_factor {E : Type*} [PseudoMetricSpace E] [MeasurableSpace E]
    (mu : Measure E) {f g unit : E → ℝ} {w : E} {lam : ℝ} {m : ℕ}
    (hcont : ContinuousAt unit w) (hunit : unit w ≠ 0)
    (hidentity : ∀ᶠ x in nhds w, g x - g w = unit x * (f x - f w)) :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair mu (Metric.ball w) g w lam m := by
  have hpos : 0 < |unit w| := abs_pos.mpr hunit
  have hevent : ∀ᶠ x in nhds w,
      |unit w| / 2 < |unit x| ∧ |unit x| < 2 * |unit w| :=
    hcont.abs.eventually (Ioo_mem_nhds (by linarith) (by linarith))
  obtain ⟨rho, hrho, hb⟩ := Metric.eventually_nhds_iff.mp (hevent.and hidentity)
  apply pair_iff_of_local_comparison
    (lo := |unit w| / 2) (hi := 2 * |unit w|) (rho := rho)
    (show Monotone (Metric.ball w) from fun _ _ h => Metric.ball_subset_ball h)
    hrho (half_pos hpos) (mul_pos (by norm_num) hpos)
  intro x hx
  have h := hb hx
  rw [h.2, abs_mul]
  exact ⟨mul_le_mul_of_nonneg_right h.1.1.le (abs_nonneg _),
    mul_le_mul_of_nonneg_right h.1.2.le (abs_nonneg _)⟩

/-- A zero-centered function may be multiplied by any continuous signed
unit without changing its actual measured pair. -/
theorem pair_iff_of_factor_at_zero {E : Type*} [PseudoMetricSpace E] [MeasurableSpace E]
    (mu : Measure E) {f unit : E → ℝ} {w : E} {lam : ℝ} {m : ℕ}
    (hzero : f w = 0) (hcont : ContinuousAt unit w) (hunit : unit w ≠ 0) :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair mu (Metric.ball w) (fun x => unit x * f x) w lam m := by
  apply pair_iff_of_centered_factor mu hcont hunit
  exact Filter.Eventually.of_forall fun x => by simp only [hzero, mul_zero, sub_zero]

end MAIS.ContinuousUnitTransfer

/--
info: 'MAIS.ContinuousUnitTransfer.pair_iff_of_centered_factor' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ContinuousUnitTransfer.pair_iff_of_centered_factor
end
end
-- ==================== end module O7.ContinuousUnitTransfer ====================

-- ==================== begin module O7.WeightedPuncturedSlice (formalization/O7/WeightedPuncturedSlice.lean) ====================
section

/-! Actual angular measured-pair transfer at a nonzero weighted coordinate.
No Jacobian estimate, polar integration or numerical pair is assumed. -/
set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal
namespace MAIS.WeightedPuncturedSlice
open MAIS.AnalyticTransfer MAIS.WeightedCoordinateSlice
variable {I : Type*} [Fintype I] [DecidableEq I]

/-- The literal restriction to the affine coordinate section through w. -/
def angularLoss (p : I) (w : I → ℝ) (f : (I → ℝ) → ℝ) (z : Other p) : ℝ :=
  f (lift p (w p) z)

/-- At every nonzero weighted coordinate, a zero-level homogeneous loss has
exactly its actual angular restriction's radius-first measured band pairs.
The chart, its inverse, Haar comparison and removal of the radial spectator
are all derived, rather than supplied as hypotheses. -/
theorem pair_iff_angular (p : I)
    (mu : Measure (I → ℝ)) (nu : Measure (Other p))
    [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]
    (a : I → ℝ) (w : I → ℝ) (hb : w p ≠ 0) (ha : a p ≠ 0)
    {f : (I → ℝ) → ℝ} (hf : Measurable f) (hz : f w = 0) (degree : ℝ)
    (hhom : ∀ s x, f (dilate a s x) = Real.exp (degree*s)*f x)
    {lam : ℝ} {m : ℕ} :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (fun i : {i : I // i ≠ p} => w i.val))
        (angularLoss p w f) (fun i => w i.val) lam m := by
  let e := chart a p hb ha
  let u0 := base p w
  let productMeasure : Measure (Parameters p) := (volume : Measure ℝ).prod nu
  let model : Parameters p → ℝ := fun u => angularLoss p w f u.2
  let pulled : Parameters p → ℝ := fun u => f (forward a p (w p) u)
  let unit : Parameters p → ℝ := fun u => Real.exp (degree*u.1)
  have he0 : e u0 = w := forward_base a p w
  have hm : Measurable (angularLoss p w f) :=
    hf.comp (contDiff_lift p (w p) (n := 1)).continuous.measurable
  have hmodel : Measurable model := hm.comp measurable_snd
  have hpulled : Measurable pulled :=
    hf.comp (contDiff_forward a p (w p) (n := 1)).continuous.measurable
  have he : ∀ x ∈ e.source, ContDiffAt ℝ 1 e x := by
    intro x _
    exact (contDiff_forward a p (w p) (n := 1)).contDiffAt
  have hei : ∀ x ∈ e.target, ContDiffAt ℝ 1 e.symm x := by
    intro x hx
    exact contDiffAt_inverse a p (w p) hx
  have hc := MAIS.CrossCarrierChartTransfer.pair_iff_of_chart productMeasure mu e
    (w := u0) (lam := lam) (m := m) (by trivial) he hei hpulled hf
    (by intro x _; rfl)
  rw [he0] at hc
  have hzero : model u0 = 0 := by
    change f (lift p (w p) (fun i => w i.val)) = 0
    rw [lift_restrict]
    exact hz
  have hunit : ContinuousAt unit u0 := by
    exact (Real.continuous_exp.comp (continuous_const.mul continuous_fst)).continuousAt
  have hid : pulled = fun u => unit u * model u := by
    funext u
    exact hhom u.1 (lift p (w p) u.2)
  have hu := MAIS.ContinuousUnitTransfer.pair_iff_of_factor_at_zero productMeasure
    (lam := lam) (m := m) hzero hunit (Real.exp_ne_zero _)
  rw [← hid] at hu
  let q : Parameters p →L[ℝ] Other p := ContinuousLinearMap.snd ℝ ℝ (Other p)
  have hq : Function.Surjective q := fun z => ⟨(0,z),rfl⟩
  have hs := MAIS.LinearObservationTransfer.pair_iff_surjective_observation
    productMeasure nu q hq u0 hm (lam := lam) (m := m)
  exact hc.symm.trans (hu.symm.trans hs)

/-- An arbitrary continuous positive prior in the original ambient coordinates
is allowed; it need not factor in the weighted chart. -/
theorem pair_iff_angular_prior (p : I)
    (mu : Measure (I → ℝ)) (nu : Measure (Other p))
    [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]
    (a : I → ℝ) (w : I → ℝ) (hb : w p ≠ 0) (ha : a p ≠ 0)
    {f prior : (I → ℝ) → ℝ} (hf : Measurable f) (hz : f w = 0) (degree : ℝ)
    (hhom : ∀ s x, f (dilate a s x) = Real.exp (degree*s)*f x)
    (hprior : ContinuousAt prior w) (hpos : 0 < prior w) {lam : ℝ} {m : ℕ} :
    HasMeasuredBandPair (mu.withDensity (fun x => ENNReal.ofReal (prior x)))
      (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (fun i : {i : I // i ≠ p} => w i.val))
        (angularLoss p w f) (fun i => w i.val) lam m :=
  (MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior
    mu hf hprior hpos).symm.trans (pair_iff_angular p mu nu a w hb ha hf hz degree hhom)

end MAIS.WeightedPuncturedSlice
end

/--
info: 'MAIS.WeightedPuncturedSlice.pair_iff_angular' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedPuncturedSlice.pair_iff_angular

/--
info: 'MAIS.WeightedPuncturedSlice.pair_iff_angular_prior' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedPuncturedSlice.pair_iff_angular_prior
end
-- ==================== end module O7.WeightedPuncturedSlice ====================

-- ==================== begin module O7.ActiveIntervalAngularSlice (formalization/O7/ActiveIntervalAngularSlice.lean) ====================
section

/-! Actual angular measured restriction for the literal residual path loss at
every nonzero residual zero, with its positive weights and degree derived. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set MeasureTheory
namespace MAIS.ActiveIntervalAngularSlice

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.ActiveIntervalWeightedResidual MAIS.IntervalPositivePotentials
open MAIS.MatrixChainIsomorphism MAIS.AnalyticTransfer
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

def weights (p : ResidualIndex D birth death) : ℝ :=
  realPotential D birth death p.val.val.1 - realPotential D birth death p.val.val.2

omit [Fintype S] [DecidableEq S] in
include hD in
theorem weights_pos (p : ResidualIndex D birth death) : 0 < weights D birth death p :=
  real_edgeWeight_pos D birth death hD p.val

/-- Exact degree2 under the literal exponential dilation, derived from the
    complete matrix family and actual zero-product base. -/
theorem residualLoss_homogeneity
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    (s : ℝ) (z : Residual D birth death) :
    residualLoss D birth death hD (MAIS.WeightedCoordinateSlice.dilate
      (weights D birth death) s z) = Real.exp (2*s) * residualLoss D birth death hD z := by
  change residualLoss D birth death hD
    (residualScaleExp D birth death (realPotential D birth death) s z) = _
  rw [residualLoss_scaleExp D birth death hD (realPotential D birth death) s z
    (realPotential_birth_zero D birth death)
    (realPotential_death_last D birth death
      (denominator_pos_of_zero_path D birth death hD hzero))]
  congr 1
  rw [pow_two, ← Real.exp_add]
  congr 1
  ring

omit [DecidableEq S] in
include hD in
/-- Every actual nonzero residual point has a nonzero coordinate with a
    genuinely positive derived weight. -/
theorem exists_nonzero_weighted_coordinate (w : Residual D birth death) (hw : w ≠ 0) :
    ∃ p : ResidualIndex D birth death, w p ≠ 0 ∧ 0 < weights D birth death p := by
  have hp : ∃ p, w p ≠ 0 := by
    by_contra h
    push Not at h
    apply hw
    funext p
    exact h p
  obtain ⟨p,hp⟩ := hp
  exact ⟨p,hp,weights_pos D birth death hD p⟩

/-- Actual radius-first angular reduction at any selected nonzero coordinate
    of a literal residual zero. No weighted degree or chart is assumed. -/
theorem pair_iff_angular (p : ResidualIndex D birth death)
    (mu : Measure (Residual D birth death))
    (nu : Measure (MAIS.WeightedCoordinateSlice.Other p))
    [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    (w : Residual D birth death) (hp : w p ≠ 0)
    (hw : residualLoss D birth death hD w = 0) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball w) (residualLoss D birth death hD) w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (fun i : {i : ResidualIndex D birth death // i ≠ p} => w i.val))
        (MAIS.WeightedPuncturedSlice.angularLoss p w (residualLoss D birth death hD))
        (fun i => w i.val) lam m :=
  MAIS.WeightedPuncturedSlice.pair_iff_angular p mu nu (weights D birth death) w hp
    (ne_of_gt (weights_pos D birth death hD p))
    (continuous_residualLoss D birth death hD).measurable hw 2
    (residualLoss_homogeneity D birth death hD hzero) (lam := lam) (m := m)

/-- The same literal angular restriction allows any actual continuous
    positive prior on the original residual coordinates. -/
theorem pair_iff_angular_prior (p : ResidualIndex D birth death)
    (mu : Measure (Residual D birth death))
    (nu : Measure (MAIS.WeightedCoordinateSlice.Other p))
    [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    (w : Residual D birth death) (hp : w p ≠ 0)
    (hw : residualLoss D birth death hD w = 0)
    (prior : Residual D birth death → ℝ) (hprior : ContinuousAt prior w) (hpos : 0 < prior w)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair (mu.withDensity (fun z => ENNReal.ofReal (prior z)))
      (Metric.ball w) (residualLoss D birth death hD) w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (fun i : {i : ResidualIndex D birth death // i ≠ p} => w i.val))
        (MAIS.WeightedPuncturedSlice.angularLoss p w (residualLoss D birth death hD))
        (fun i => w i.val) lam m :=
  MAIS.WeightedPuncturedSlice.pair_iff_angular_prior p mu nu (weights D birth death) w hp
    (ne_of_gt (weights_pos D birth death hD p))
    (continuous_residualLoss D birth death hD).measurable hw 2
    (residualLoss_homogeneity D birth death hD hzero) hprior hpos (lam := lam) (m := m)

end MAIS.ActiveIntervalAngularSlice
end

/-- info: 'MAIS.ActiveIntervalAngularSlice.weights_pos' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalAngularSlice.weights_pos

/-- info: 'MAIS.ActiveIntervalAngularSlice.residualLoss_homogeneity' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalAngularSlice.residualLoss_homogeneity

/-- info: 'MAIS.ActiveIntervalAngularSlice.exists_nonzero_weighted_coordinate' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalAngularSlice.exists_nonzero_weighted_coordinate

/-- info: 'MAIS.ActiveIntervalAngularSlice.pair_iff_angular' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalAngularSlice.pair_iff_angular

/-- info: 'MAIS.ActiveIntervalAngularSlice.pair_iff_angular_prior' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalAngularSlice.pair_iff_angular_prior
end
