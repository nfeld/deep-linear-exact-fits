-- ==================== begin module O7.DyadicRadialComparison (formalization/O7/DyadicRadialComparison.lean) ====================
section

/-! Actual monotone band masses: a dyadic weighted sum is comparable with
its literal continuous radial integral, with explicit computed constants. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.DyadicRadialComparison
open MAIS.DyadicRadialMeasure

def signalFactor (d k : ℕ) : ℝ := (2:ℝ)^(k*d)

def series (A d : ℕ) (B : ℝ→ℝ≥0∞) (eps : ℝ) : ℝ≥0∞ :=
  ∑' k:ℕ, ratio A^k * B (eps*signalFactor d k)

def weightedIntegral (A d : ℕ) (B : ℝ→ℝ≥0∞) (eps : ℝ) : ℝ≥0∞ :=
  ∫⁻ r in Ioc (0:ℝ) 1,B (eps/r^d) ∂radialMeasure A

theorem div_scale_pow (d k : ℕ) (eps : ℝ) :
    eps/(scale k)^d = eps*signalFactor d k := by
  unfold scale signalFactor
  rw [← pow_mul,one_div_pow]
  field_simp

/-- The actual signal argument lies between the two adjacent dyadic values. -/
theorem signal_bounds {eps r : ℝ} (heps : 0≤eps) (d k : ℕ) (hr : r∈shell k) :
    eps*signalFactor d k ≤ eps/r^d ∧ eps/r^d ≤ eps*signalFactor d (k+1) := by
  have hr0 : 0<r := (scale_pos (k+1)).trans hr.1
  have hk0 := scale_pos k
  have hk10 := scale_pos (k+1)
  have hpowL := pow_le_pow_left₀ hr0.le hr.2 d
  have hpowU := pow_le_pow_left₀ hk10.le hr.1.le d
  constructor
  · rw [← div_scale_pow]
    exact div_le_div_of_nonneg_left heps (pow_pos hr0 d) hpowL
  · rw [← div_scale_pow]
    exact div_le_div_of_nonneg_left heps (pow_pos hk10 d) hpowU

/-- The literal nonnegative integral on each actual dyadic interval is
sandwiched between its two actual constant-band endpoint integrals. -/
theorem shell_integral_bounds (A d : ℕ) (B : ℝ→ℝ≥0∞) (hB : Monotone B)
    {eps : ℝ} (heps : 0≤eps) (k : ℕ) :
    radialMeasure A (shell k)*B (eps*signalFactor d k) ≤
      (∫⁻ r in shell k,B (eps/r^d) ∂radialMeasure A) ∧
    (∫⁻ r in shell k,B (eps/r^d) ∂radialMeasure A) ≤
      radialMeasure A (shell k)*B (eps*signalFactor d (k+1)) := by
  constructor
  · calc
      _ = ∫⁻ _r in shell k,B (eps*signalFactor d k) ∂radialMeasure A := by
        rw [setLIntegral_const]
        ac_rfl
      _ ≤ _ := setLIntegral_mono' measurableSet_Ioc (fun r hr => hB (signal_bounds heps d k hr).1)
  · calc
      _ ≤ ∫⁻ _r in shell k,B (eps*signalFactor d (k+1)) ∂radialMeasure A :=
        setLIntegral_mono' measurableSet_Ioc (fun r hr => hB (signal_bounds heps d k hr).2)
      _ = _ := by rw [setLIntegral_const]; ac_rfl

private theorem reciprocal_ratio (A : ℕ) : ENNReal.ofReal ((2:ℝ)^A)*ratio A=1 := by
  unfold ratio
  rw [← ENNReal.ofReal_mul (by positivity),← mul_pow]
  norm_num

/-- An actual dyadic-sum/radial-integral comparison. It permits infinite
integrals and series, and assumes only monotonicity of the genuine band mass. -/
theorem series_integral_bounds {A : ℕ} (hA : 0<A) (d : ℕ)
    (B : ℝ→ℝ≥0∞) (hB : Monotone B) {eps : ℝ} (heps : 0≤eps) :
    ENNReal.ofReal (shellConstant A)*series A d B eps ≤ weightedIntegral A d B eps ∧
      weightedIntegral A d B eps ≤ ENNReal.ofReal (shellConstant A)*
        ENNReal.ofReal ((2:ℝ)^A)*series A d B eps := by
  let c : ℝ≥0∞ := ENNReal.ofReal (shellConstant A)
  let q := ratio A
  let R : ℝ≥0∞ := ENNReal.ofReal ((2:ℝ)^A)
  let F : ℕ→ℝ≥0∞ := fun k => q^k*B (eps*signalFactor d k)
  have hRq : R*q=1 := reciprocal_ratio A
  have hpoint : ∀ k:ℕ, q^k*B (eps*signalFactor d (k+1)) =
      R*(q^(k+1)*B (eps*signalFactor d (k+1))) := by
    intro k
    rw [pow_succ]
    calc
      _ = (R*q)*(q^k*B (eps*signalFactor d (k+1))) := by rw [hRq,one_mul]
      _ = _ := by ac_rfl
  have htail : (∑' k:ℕ,F (k+1)) ≤ ∑' k:ℕ,F k :=
    ENNReal.tsum_comp_le_tsum_of_injective Nat.succ_injective F
  constructor
  · calc
      c*series A d B eps = ∑' k:ℕ,c*(q^k*B (eps*signalFactor d k)) :=
        ENNReal.tsum_mul_left.symm
      _ = ∑' k:ℕ,radialMeasure A (shell k)*B (eps*signalFactor d k) := by
        apply tsum_congr
        intro k
        rw [radialMeasure_shell hA]
        dsimp [c,q]
        ac_rfl
      _ ≤ ∑' k:ℕ,∫⁻ r in shell k,B (eps/r^d) ∂radialMeasure A :=
        ENNReal.tsum_le_tsum (fun k => (shell_integral_bounds A d B hB heps k).1)
      _ = weightedIntegral A d B eps := (lintegral_eq_tsum_shell A _).symm
  · calc
      weightedIntegral A d B eps =
          ∑' k:ℕ,∫⁻ r in shell k,B (eps/r^d) ∂radialMeasure A := lintegral_eq_tsum_shell A _
      _ ≤ ∑' k:ℕ,radialMeasure A (shell k)*B (eps*signalFactor d (k+1)) :=
        ENNReal.tsum_le_tsum (fun k => (shell_integral_bounds A d B hB heps k).2)
      _ = c*(∑' k:ℕ,q^k*B (eps*signalFactor d (k+1))) := by
        simp_rw [radialMeasure_shell hA]
        simp only [mul_assoc]
        exact ENNReal.tsum_mul_left
      _ = c*(R*∑' k:ℕ,F (k+1)) := by
        congr 1
        simp_rw [hpoint]
        exact ENNReal.tsum_mul_left
      _ ≤ c*(R*∑' k:ℕ,F k) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left htail bot_le) bot_le
      _ = c*R*series A d B eps := by
        change c*(R*series A d B eps)=c*R*series A d B eps
        ac_rfl

/-- The radial integral is also literally the usual Lebesgue integral with
its proved polynomial density; no integrability premise is supplied. -/
theorem weightedIntegral_eq_lintegral (A d : ℕ) (B : ℝ→ℝ≥0∞) (hB : Monotone B) (eps : ℝ) :
    weightedIntegral A d B eps =
      ∫⁻ r in Ioc (0:ℝ) 1,ENNReal.ofReal (r^(A-1))*B (eps/r^d) := by
  unfold weightedIntegral radialMeasure
  rw [restrict_withDensity measurableSet_Ioc]
  apply lintegral_withDensity_eq_lintegral_mul
  · exact ENNReal.measurable_ofReal.comp (measurable_id.pow_const (A-1))
  · exact hB.measurable.comp (measurable_const.div (measurable_id.pow_const d))

end MAIS.DyadicRadialComparison
end

/-- info: 'MAIS.DyadicRadialComparison.signal_bounds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.DyadicRadialComparison.signal_bounds

/-- info: 'MAIS.DyadicRadialComparison.series_integral_bounds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.DyadicRadialComparison.series_integral_bounds

/-- info: 'MAIS.DyadicRadialComparison.weightedIntegral_eq_lintegral' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.DyadicRadialComparison.weightedIntegral_eq_lintegral
end
-- ==================== end module O7.DyadicRadialComparison ====================

-- ==================== begin module O7.DyadicRadialOrder (formalization/O7/DyadicRadialOrder.lean) ====================
section

/-! Literal dyadic shell sums and literal radial integrals have the same
measured power-log order, with constants derived by the preceding comparison. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.DyadicRadialOrder
open MAIS.DyadicRadialMeasure MAIS.DyadicRadialComparison O77.Residual

private theorem ofReal_inv_mul {x : ℝ} (hx : 0<x) :
    ENNReal.ofReal (1/x)*ENNReal.ofReal x=1 := by
  rw [← ENNReal.ofReal_mul (by positivity)]
  simp [hx.ne']

/-- The reverse inequalities are derived from the actual integral comparison,
including the finite positive constants. No finiteness of B is required. -/
theorem integral_series_bounds {A : ℕ} (hA : 0<A) (d : ℕ)
    (B : ℝ→ℝ≥0∞) (hB : Monotone B) {eps : ℝ} (heps : 0≤eps) :
    ENNReal.ofReal (1/(shellConstant A*(2:ℝ)^A))*weightedIntegral A d B eps ≤
      series A d B eps ∧
    series A d B eps ≤ ENNReal.ofReal (1/shellConstant A)*weightedIntegral A d B eps := by
  have hc := shellConstant_pos hA
  have hR : 0<(2:ℝ)^A := by positivity
  have hb := series_integral_bounds hA d B hB heps
  constructor
  · have h := mul_le_mul_of_nonneg_left hb.2
      (by positivity : (0:ℝ≥0∞)≤ENNReal.ofReal (1/(shellConstant A*(2:ℝ)^A)))
    calc
      _ ≤ ENNReal.ofReal (1/(shellConstant A*(2:ℝ)^A))*
          (ENNReal.ofReal (shellConstant A)*ENNReal.ofReal ((2:ℝ)^A)*series A d B eps) := h
      _ = _ := by
        rw [← ENNReal.ofReal_mul hc.le]
        rw [← mul_assoc,ofReal_inv_mul (mul_pos hc hR),one_mul]
  · have h := mul_le_mul_of_nonneg_left hb.1
      (by positivity : (0:ℝ≥0∞)≤ENNReal.ofReal (1/shellConstant A))
    calc
      _ = ENNReal.ofReal (1/shellConstant A)*
          (ENNReal.ofReal (shellConstant A)*series A d B eps) := by
        rw [← mul_assoc,ofReal_inv_mul hc,one_mul]
      _ ≤ _ := h

/-- Actual ETheta equivalence between the true radial integral and the true
monotone shell series. This is an order transfer, not an assigned exponent. -/
theorem order_iff {A : ℕ} (hA : 0<A) (d : ℕ) (B : ℝ→ℝ≥0∞)
    (hB : Monotone B) (lam : ℝ) (n : ℕ) :
    EThetaZeroPowerLog (fun eps => series A d B eps) lam n ↔
      EThetaZeroPowerLog (fun eps => weightedIntegral A d B eps) lam n := by
  have hc := shellConstant_pos hA
  have hR : 0<(2:ℝ)^A := by positivity
  constructor
  · intro hp
    apply O77.Transport0906.order_of_two_window_bounds hp hp hc (mul_pos hc hR)
    intro eps heps
    have hb := series_integral_bounds hA d B hB heps.le
    rw [ENNReal.ofReal_mul hc.le]
    exact hb
  · intro hp
    apply O77.Transport0906.order_of_two_window_bounds hp hp
      (one_div_pos.mpr (mul_pos hc hR)) (one_div_pos.mpr hc)
    intro eps heps
    exact integral_series_bounds hA d B hB heps.le

/-- A literal measured annular sublevel mass is monotone without any
measurability or regularity premise on the loss. -/
theorem monotone_actual_band {E : Type*} [MeasurableSpace E]
    (mu : Measure E) (K : Set E) (f : E→ℝ) :
    Monotone (fun eps : ℝ => mu {x | x∈K ∧ |f x|<eps}) := by
  intro a b hab
  apply measure_mono
  intro x hx
  exact ⟨hx.1,hx.2.trans_le hab⟩

/-- The comparison specializes directly to an actual annulus band measure;
no abstract band-mass monotonicity oracle is left as a premise. -/
theorem actual_band_order_iff {E : Type*} [MeasurableSpace E]
    (mu : Measure E) (K : Set E) (f : E→ℝ) {A : ℕ} (hA : 0<A)
    (d : ℕ) (lam : ℝ) (n : ℕ) :
    EThetaZeroPowerLog
        (fun eps => series A d (fun e => mu {x | x∈K ∧ |f x|<e}) eps) lam n ↔
      EThetaZeroPowerLog
        (fun eps => weightedIntegral A d (fun e => mu {x | x∈K ∧ |f x|<e}) eps) lam n :=
  order_iff hA d _ (monotone_actual_band mu K f) lam n

end MAIS.DyadicRadialOrder
end

/-- info: 'MAIS.DyadicRadialOrder.integral_series_bounds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.DyadicRadialOrder.integral_series_bounds

/-- info: 'MAIS.DyadicRadialOrder.order_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.DyadicRadialOrder.order_iff

/-- info: 'MAIS.DyadicRadialOrder.actual_band_order_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.DyadicRadialOrder.actual_band_order_iff
end
-- ==================== end module O7.DyadicRadialOrder ====================

-- ==================== begin module O7.ActiveIntervalRadialBand (formalization/O7/ActiveIntervalRadialBand.lean) ====================
section

/-! Literal complete interval residual box bands have exactly the order of
an actual one-dimensional radial integral of their actual compact-annulus
bands; no radial exponent or angular pair is assigned. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 500000
noncomputable section
open Set MeasureTheory
open scoped ENNReal
namespace MAIS.ActiveIntervalRadialBand
open MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalGaussianCoordinates
open MAIS.ActiveIntervalGaussianChart MAIS.ActiveIntervalAnnulusRecurrence
open MAIS.ActiveIntervalWeightedResidual MAIS.IntervalIntegerPotentials
open MAIS.WeightedDyadicShells MAIS.WeightedDyadicBandIdentity MAIS.WeightedCompactAnnulus
open MAIS.MatrixChainIsomorphism O77.Residual
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s≤D+1)

/-- The exact actual annular band mass, rather than an abstract table. -/
def annularBand (mu:Measure (Residual D birth death)) (eps:ℝ) : ℝ≥0∞:=
  bandOn mu (compactAnnulus (integerWeights D birth death)) (residualLoss D birth death hD) eps

include hD in
theorem totalIntegerWeight_pos [Nonempty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0) :
    0 < ∑ p:ResidualIndex D birth death,integerWeights D birth death p := by
  apply Finset.sum_pos
  · intro p _
    exact ((zero_base_weight_data D birth death hD hzero).2 p).1
  · exact Finset.univ_nonempty

/-- The actual compact-shell series is exactly the scalar comparison
    theorem's literal series after normalizing only notation. -/
theorem box_band_eq_series (mu:Measure (Residual D birth death))
    [Measure.IsAddHaarMeasure mu] [NullSingletonClass mu]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (eps:ℝ) :
    bandOn mu (box (integerWeights D birth death) 0) (residualLoss D birth death hD) eps=
      MAIS.DyadicRadialComparison.series
        (∑ p:ResidualIndex D birth death,integerWeights D birth death p)
        (2*commonDenominator D birth death) (annularBand D birth death hD mu) eps := by
  rw [residual_band_series_compact D birth death hD mu hzero eps]
  unfold MAIS.DyadicRadialComparison.series MAIS.DyadicRadialMeasure.ratio
    MAIS.DyadicRadialComparison.signalFactor annularBand
  apply tsum_congr
  intro k
  rw [ENNReal.ofReal_pow (by positivity),← pow_mul,Nat.mul_comm k]

/-- An actual measured fixed-box power/log order is equivalent to the
    actual compact-annulus radial integral order, with positive volume degree
    derived from genuine nonempty residual coordinates. -/
theorem box_order_iff_radial_integral (mu:Measure (Residual D birth death))
    [Measure.IsAddHaarMeasure mu] [NullSingletonClass mu]
    [Nonempty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (lam:ℝ) (n:ℕ) :
    EThetaZeroPowerLog
      (fun eps=>bandOn mu (box (integerWeights D birth death) 0)
        (residualLoss D birth death hD) eps) lam n ↔
    EThetaZeroPowerLog
      (fun eps=>MAIS.DyadicRadialComparison.weightedIntegral
        (∑ p:ResidualIndex D birth death,integerWeights D birth death p)
        (2*commonDenominator D birth death) (annularBand D birth death hD mu) eps) lam n := by
  have he:(fun eps=>bandOn mu (box (integerWeights D birth death) 0)
      (residualLoss D birth death hD) eps)=fun eps=>MAIS.DyadicRadialComparison.series
      (∑ p:ResidualIndex D birth death,integerWeights D birth death p)
      (2*commonDenominator D birth death) (annularBand D birth death hD mu) eps:=by
    funext eps
    exact box_band_eq_series D birth death hD mu hzero eps
  rw [he]
  exact MAIS.DyadicRadialOrder.order_iff (totalIntegerWeight_pos D birth death hD hzero)
    _ _ (bandOn_monotone mu _ _) lam n

end MAIS.ActiveIntervalRadialBand
end

/-- info: 'MAIS.ActiveIntervalRadialBand.totalIntegerWeight_pos' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalRadialBand.totalIntegerWeight_pos

/-- info: 'MAIS.ActiveIntervalRadialBand.box_band_eq_series' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalRadialBand.box_band_eq_series

/-- info: 'MAIS.ActiveIntervalRadialBand.box_order_iff_radial_integral' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalRadialBand.box_order_iff_radial_integral
end
