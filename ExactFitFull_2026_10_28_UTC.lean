-- ==================== begin module O7.ClippedRadialGeometry (formalization/O7/ClippedRadialGeometry.lean) ====================
section

/-! Literal saturated-kernel radial integration, including its actual inner
polynomial mass and actual finite outer integral. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.ClippedRadialGeometry
open MAIS.ClippedBandComparison MAIS.DyadicRadialComparison MAIS.DyadicRadialMeasure
open MAIS.WeightedRadialIntegral MAIS.WeightedRadialMoments MAIS.WeightedRadialOrder O77.Residual

def lowerRadius (d : ℕ) (eta eps : ℝ) : ℝ := (eps/eta)^(1/(d:ℝ))

theorem lowerRadius_pos {eta eps : ℝ} (heta : 0<eta) (heps : 0<eps) (d : ℕ) :
    0<lowerRadius d eta eps := Real.rpow_pos_of_pos (div_pos heps heta) _

theorem lowerRadius_pow {d : ℕ} (hd : 0<d) {eta eps : ℝ}
    (heta : 0<eta) (heps : 0<eps) :
    lowerRadius d eta eps^d=eps/eta := by
  unfold lowerRadius
  rw [← Real.rpow_natCast,← Real.rpow_mul (div_pos heps heta).le]
  rw [one_div_mul_cancel (by exact_mod_cast Nat.ne_zero_of_lt hd : (d:ℝ)≠0),Real.rpow_one]

theorem lowerRadius_lt_one {d : ℕ} (hd : 0<d) {eta eps : ℝ}
    (heta : 0<eta) (heps : 0<eps) (hsmall : eps<eta) : lowerRadius d eta eps<1 := by
  have hx : eps/eta<1 := (div_lt_one heta).mpr hsmall
  unfold lowerRadius
  exact Real.rpow_lt_one (div_nonneg heps.le heta.le) hx (one_div_pos.mpr (by exact_mod_cast hd))

theorem radialMeasure_Ioc {A : ℕ} (hA : 0<A) {b : ℝ} (hb : 0≤b) :
    radialMeasure A (Ioc (0:ℝ) b)=ENNReal.ofReal (b^A/(A:ℝ)) := by
  have hi : IntegrableOn (fun r : ℝ=>r^(A-1)) (Ioc (0:ℝ) b) :=
    ((continuous_id.pow (A-1)).intervalIntegrable _ _).1
  have hn : 0≤ᵐ[volume.restrict (Ioc (0:ℝ) b)] (fun r:ℝ=>r^(A-1)) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with r hr
    exact pow_nonneg hr.1.le _
  rw [radialMeasure,withDensity_apply _ measurableSet_Ioc,
    ← ofReal_integral_eq_lintegral_ofReal hi hn,
    ← intervalIntegral.integral_of_le hb,integral_pow]
  simp only [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr (Nat.ne_zero_of_lt hA))]
  have hcast : ((A-1:ℕ):ℝ)+1=(A:ℝ) := by
    exact_mod_cast Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr (Nat.ne_zero_of_lt hA))
  rw [hcast,zero_pow (Nat.ne_zero_of_lt hA),sub_zero]

private theorem measurable_clipped (eta beta : ℝ) (n : ℕ) :
    Measurable (clippedModel eta beta n) := by
  apply Measurable.ite measurableSet_Iio
  · unfold powerLogZero powerLogZeroReal
    exact ENNReal.measurable_ofReal.comp
      ((measurable_id.pow_const beta).mul
        ((measurable_const.div measurable_id).log.pow_const n))
  · exact measurable_const

theorem continuousAt_integrand {A D beta eps r : ℝ} (heps : 0<eps) (hr : 0<r) (n : ℕ) :
    ContinuousAt (integrand A D beta n eps) r := by
  have hrd : ContinuousAt (fun x:ℝ=>x^D) r :=
    continuousAt_id.rpow_const (Or.inl hr.ne')
  have hp1 : ContinuousAt (fun x:ℝ=>x^(A-1)) r :=
    continuousAt_id.rpow_const (Or.inl hr.ne')
  have hq : ContinuousAt (fun x:ℝ=>eps/x^D) r :=
    continuousAt_const.div hrd (Real.rpow_pos_of_pos hr D).ne'
  have hb : ContinuousAt (fun x:ℝ=>(eps/x^D)^beta) r :=
    hq.rpow_const (Or.inl (div_pos heps (Real.rpow_pos_of_pos hr D)).ne')
  have hl : ContinuousAt (fun x:ℝ=>Real.log (x^D/eps)) r :=
    (hrd.div_const eps).log (div_pos (Real.rpow_pos_of_pos hr D) heps).ne'
  exact (hp1.mul hb).mul (hl.pow n)

private theorem nat_integrand_eq {A d : ℕ} (hA : 0<A) (beta : ℝ) (n : ℕ) (eps r : ℝ) :
    r^(A-1)*powerLogZeroReal beta n (eps/r^d)=integrand (A:ℝ) (d:ℝ) beta n eps r := by
  unfold powerLogZeroReal integrand
  have hcast : ((A-1:ℕ):ℝ)=(A:ℝ)-1 := by
    rw [Nat.cast_sub (by omega : 1≤A),Nat.cast_one]
  rw [← hcast,Real.rpow_natCast,Real.rpow_natCast]
  rw [one_div_div]
  ring

/-- Exact genuine inner-radius mass of the clipped annular kernel. -/
theorem clipped_inner_integral {A d : ℕ} (hA : 0<A) (hd : 0<d)
    {eta eps : ℝ} (heta : 0<eta) (heps : 0<eps) (beta : ℝ) (n : ℕ) :
    (∫⁻ r in Ioc (0:ℝ) (lowerRadius d eta eps),
      clippedModel eta beta n (eps/r^d) ∂radialMeasure A)=
      ENNReal.ofReal (lowerRadius d eta eps^A/(A:ℝ)) := by
  calc
    _ = ∫⁻ _r in Ioc (0:ℝ) (lowerRadius d eta eps),(1:ℝ≥0∞) ∂radialMeasure A := by
      apply setLIntegral_congr_fun measurableSet_Ioc
      intro r hr
      apply ite_eq_right
      intro hlt
      have hp := pow_le_pow_left₀ hr.1.le hr.2 d
      rw [lowerRadius_pow hd heta heps] at hp
      have h := (div_lt_iff₀ (pow_pos hr.1 d)).mp hlt
      have hmul := mul_le_mul_of_nonneg_left hp heta.le
      have heq : eta*(eps/eta)=eps := by field_simp
      rw [heq] at hmul
      nlinarith
    _ = _ := by rw [setLIntegral_const,one_mul,radialMeasure_Ioc hA (lowerRadius_pos heta heps d).le]

/-- Exact genuine outer-radius integral of the original power-log kernel. -/
theorem clipped_outer_integral {A d : ℕ} (hA : 0<A) (hd : 0<d)
    {eta eps : ℝ} (heta : 0<eta) (heta1 : eta<1) (heps : 0<eps) (hsmall : eps<eta)
    (beta : ℝ) (n : ℕ) :
    (∫⁻ r in Ioc (lowerRadius d eta eps) 1,
      clippedModel eta beta n (eps/r^d) ∂radialMeasure A)=
      ENNReal.ofReal (∫ r in (lowerRadius d eta eps)..1,
        integrand (A:ℝ) (d:ℝ) beta n eps r) := by
  let low := lowerRadius d eta eps
  have hlow : 0<low := lowerRadius_pos heta heps d
  have hlow1 : low<1 := lowerRadius_lt_one hd heta heps hsmall
  have hpt : ∀ r∈Ioc low 1,
      clippedModel eta beta n (eps/r^d)=powerLogZero beta n (eps/r^d) := by
    intro r hr
    apply ite_eq_left
    have hp : low^d<r^d := pow_lt_pow_left₀ hr.1 hlow.le (Nat.ne_zero_of_lt hd)
    rw [show low^d=eps/eta from lowerRadius_pow hd heta heps] at hp
    apply (div_lt_iff₀ (pow_pos (hlow.trans hr.1) d)).mpr
    have h := (div_lt_iff₀ heta).mp hp
    nlinarith
  have hi : IntervalIntegrable (integrand (A:ℝ) (d:ℝ) beta n eps) volume low 1 := by
    apply ContinuousOn.intervalIntegrable_of_Icc hlow1.le
    intro r hr
    exact (continuousAt_integrand heps (hlow.trans_le hr.1) n).continuousWithinAt
  have hn : 0≤ᵐ[volume.restrict (Ioc low 1)] (integrand (A:ℝ) (d:ℝ) beta n eps) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with r hr
    rw [← nat_integrand_eq hA]
    apply mul_nonneg (pow_nonneg (hlow.trans hr.1).le _)
    apply powerLogZeroReal_nonneg (div_pos heps (pow_pos (hlow.trans hr.1) d))
    have hs : eps/r^d<eta := by
      have h := hpt r hr
      have hp : low^d<r^d := pow_lt_pow_left₀ hr.1 hlow.le (Nat.ne_zero_of_lt hd)
      rw [show low^d=eps/eta from lowerRadius_pow hd heta heps] at hp
      exact (div_lt_iff₀ (pow_pos (hlow.trans hr.1) d)).mpr (by
        have hq := (div_lt_iff₀ heta).mp hp
        nlinarith)
    exact hs.le.trans heta1.le
  have hmeas : Measurable (fun r:ℝ=>clippedModel eta beta n (eps/r^d)) :=
    (measurable_clipped eta beta n).comp
      (measurable_const.div (measurable_id.pow_const d))
  have hden : Measurable (fun r:ℝ=>ENNReal.ofReal (r^(A-1))) :=
    ENNReal.measurable_ofReal.comp (measurable_id.pow_const (A-1))
  unfold radialMeasure
  rw [restrict_withDensity measurableSet_Ioc,
    lintegral_withDensity_eq_lintegral_mul _ hden hmeas]
  calc
    _ = ∫⁻ r in Ioc low 1,ENNReal.ofReal (integrand (A:ℝ) (d:ℝ) beta n eps r) := by
      apply setLIntegral_congr_fun measurableSet_Ioc
      intro r hr
      change ENNReal.ofReal (r^(A-1))*clippedModel eta beta n (eps/r^d)=_
      rw [hpt r hr,powerLogZero,← ENNReal.ofReal_mul (pow_nonneg (hlow.trans hr.1).le _),
        nat_integrand_eq hA]
    _ = _ := by
      rw [← ofReal_integral_eq_lintegral_ofReal hi.1 hn,← intervalIntegral.integral_of_le hlow1.le]

/-- The true clipped radial integral splits into a proved polynomial inner
mass and the genuine finite outer power-log integral. -/
theorem clipped_integral_split {A d : ℕ} (hA : 0<A) (hd : 0<d)
    {eta eps : ℝ} (heta : 0<eta) (heta1 : eta<1) (heps : 0<eps) (hsmall : eps<eta)
    (beta : ℝ) (n : ℕ) :
    weightedIntegral A d (clippedModel eta beta n) eps=
      ENNReal.ofReal (lowerRadius d eta eps^A/(A:ℝ))+
      ENNReal.ofReal (∫ r in (lowerRadius d eta eps)..1,
        integrand (A:ℝ) (d:ℝ) beta n eps r) := by
  have hlow := lowerRadius_pos heta heps d
  have hlow1 := lowerRadius_lt_one hd heta heps hsmall
  have hsplit : Ioc (0:ℝ) 1=Ioc (0:ℝ) (lowerRadius d eta eps)∪Ioc (lowerRadius d eta eps) 1 := by
    exact (Ioc_union_Ioc_eq_Ioc hlow.le hlow1.le).symm
  unfold weightedIntegral
  have hdis : Disjoint (Ioc (0:ℝ) (lowerRadius d eta eps)) (Ioc (lowerRadius d eta eps) 1) := by
    apply Set.disjoint_left.mpr
    intro r h1 h2
    exact (not_lt_of_ge h1.2) h2.1
  rw [hsplit,lintegral_union measurableSet_Ioc hdis,
    clipped_inner_integral hA hd heta heps,clipped_outer_integral hA hd heta heta1 heps hsmall]

end MAIS.ClippedRadialGeometry
end

