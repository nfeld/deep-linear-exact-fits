-- ==================== begin module O7.ActiveIntervalEmptyResidual (formalization/O7/ActiveIntervalEmptyResidual.lean) ====================
section

/-! The genuine zero-residual-dimensional branch is handled through the
actual constant-loss Haar pair, without an annulus or nonatomicity. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000
noncomputable section
open Set MeasureTheory
namespace MAIS.ActiveIntervalEmptyResidual
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.MatrixChainIsomorphism MAIS.AnalyticTransfer
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s≤D+1)

/-- Actual empty residual carrier: the literal residual loss is constant
zero and hence has the actual neutral measured pair. -/
theorem residual_pair (mu:Measure (Residual D birth death))
    [Measure.IsAddHaarMeasure mu] [IsEmpty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0) :
    HasMeasuredBandPair mu (Metric.ball (0:Residual D birth death))
      (residualLoss D birth death hD) 0 0 1 := by
  have he:residualLoss D birth death hD=(fun _=>0):=by
    funext z
    have hz:z=0:=Subsingleton.elim _ _
    rw [hz]
    exact residualLoss_zero D birth death hD hzero
  rw [he]
  exact MAIS.LinearObservationTransfer.constant_pair mu 0 0

include hD in
/-- Full original-entry Euclidean half-loss and arbitrary positive prior
have the unique Gaussian pair when no residual coordinate exists. -/
theorem ambient_entry_half_pair_iff
    (hvalid:∀ s,birth s<death s)
    (muA:Measure (MAIS.ActiveIntervalMeasuredSlice.Ambient D birth death))
    [Measure.IsAddHaarMeasure muA]
    (muT:Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR:Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    [IsEmpty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (prior:MAIS.ActiveIntervalMeasuredSlice.Ambient D birth death→ℝ)
    (hprior:ContinuousAt prior (intervalRep D birth death))
    (hpos:0<prior (intervalRep D birth death)) (lam:ℝ) (m:ℕ) :
    HasMeasuredBandPair (muA.withDensity (fun A=>ENNReal.ofReal (prior A)))
      (MAIS.MatrixChainEntryWindows.entryBall (Index D birth death) (intervalRep D birth death))
      (fun A=>(1/2:ℝ)*MAIS.ActiveIntervalMeasuredSlice.ambientLoss D birth death
        0 (Fin.last D) (by exact Nat.zero_le D) A) (intervalRep D birth death) lam m ↔
      lam=(Fintype.card (DirectIndex D birth death):ℝ)/2 ∧ m=1 := by
  simpa only [zero_add] using
    MAIS.ActiveIntervalMeasuredSuspension.ambient_entry_half_pair_iff_of_residual_pair
      D birth death hD hvalid muA muT muR hzero prior hprior hpos
      (residual_pair D birth death hD muR hzero) lam m

end MAIS.ActiveIntervalEmptyResidual
end

