-- ==================== begin module O7.Run2OrbitDifferentialGauge (formalization/O7/Run2OrbitDifferentialGauge.lean) ====================
section

/-! The actual orbit differential has the same range dimension at genuinely
gauge-equivalent rectangular matrix chains. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1200000
noncomputable section
open scoped Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2OrbitDifferentialGauge
open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.QuiverGaugeMeasuredPair

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
variable [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

def lieConjugation (g : Gauge ι) : Lie ι ≃ₗ[ℝ] Lie ι where
  toFun X v := (g v).val * X v * (g v).inv
  invFun X v := ((g v).inv : Matrix (ι v) (ι v) ℝ) * X v * (g v).val
  left_inv X := by
    funext v
    change ((g v).inv * ((g v).val * X v * (g v).inv)) * (g v).val = X v
    calc
      _ = ((g v).inv * (g v).val) * X v * ((g v).inv * (g v).val) := by
        simp only [Matrix.mul_assoc]
      _ = X v := by rw [(g v).inv_val, Matrix.one_mul, Matrix.mul_one]
  right_inv X := by
    funext v
    change ((g v).val * ((g v).inv * X v * (g v).val)) * (g v).inv = X v
    calc
      _ = ((g v).val * (g v).inv) * X v * ((g v).val * (g v).inv) := by
        simp only [Matrix.mul_assoc]
      _ = X v := by rw [(g v).val_inv, Matrix.one_mul, Matrix.mul_one]
  map_add' X Y := by
    funext v
    simp only [Pi.add_apply, Matrix.mul_add, Matrix.add_mul]
  map_smul' c X := by
    funext v
    simp only [Pi.smul_apply, Matrix.mul_smul, Matrix.smul_mul, RingHom.id_apply]

theorem orbitDifferential_conjugation (g : Gauge ι) (A : Rep ι) (X : Lie ι) :
    orbitDifferential ι (g • A) (lieConjugation ι g X) =
      g • orbitDifferential ι A X := by
  funext e
  change ((g e.succ).val * X e.succ * (g e.succ).inv) *
      ((g e.succ).val * A e * (g e.castSucc).inv) -
      ((g e.succ).val * A e * (g e.castSucc).inv) *
      ((g e.castSucc).val * X e.castSucc * (g e.castSucc).inv) =
    (g e.succ).val * (X e.succ * A e - A e * X e.castSucc) * (g e.castSucc).inv
  simp only [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_assoc]
  congr 1
  · calc
      _ = (g e.succ).val * X e.succ * ((g e.succ).inv * (g e.succ).val) *
          A e * (g e.castSucc).inv := by simp only [Matrix.mul_assoc]
      _ = _ := by rw [(g e.succ).inv_val, Matrix.mul_one]; simp only [Matrix.mul_assoc]
  · calc
      _ = (g e.succ).val * A e * ((g e.castSucc).inv * (g e.castSucc).val) *
          X e.castSucc * (g e.castSucc).inv := by simp only [Matrix.mul_assoc]
      _ = _ := by rw [(g e.castSucc).inv_val, Matrix.mul_one]; simp only [Matrix.mul_assoc]

def kernelEquiv (g : Gauge ι) (A : Rep ι) :
    (orbitDifferential ι A).ker ≃ₗ[ℝ] (orbitDifferential ι (g • A)).ker where
  toFun X := ⟨lieConjugation ι g X.val, by
    rw [LinearMap.mem_ker, orbitDifferential_conjugation, X.property]
    exact (gaugeLinearEquiv ι g).map_zero⟩
  invFun Y := ⟨(lieConjugation ι g).symm Y.val, by
    have h := orbitDifferential_conjugation ι g A ((lieConjugation ι g).symm Y.val)
    rw [(lieConjugation ι g).apply_symm_apply, Y.property] at h
    apply (gaugeLinearEquiv ι g).injective
    exact h.symm.trans ((gaugeLinearEquiv ι g).map_zero).symm⟩
  left_inv X := by apply Subtype.ext; exact (lieConjugation ι g).symm_apply_apply X.val
  right_inv Y := by apply Subtype.ext; exact (lieConjugation ι g).apply_symm_apply Y.val
  map_add' X Y := by apply Subtype.ext; exact map_add _ _ _
  map_smul' c X := by apply Subtype.ext; exact map_smul _ _ _

theorem finrank_range_gauge (g : Gauge ι) (A : Rep ι) :
    Module.finrank ℝ (orbitDifferential ι (g • A)).range =
      Module.finrank ℝ (orbitDifferential ι A).range := by
  have hk := (kernelEquiv ι g A).finrank_eq
  have hA := (orbitDifferential ι A).finrank_range_add_finrank_ker
  have hG := (orbitDifferential ι (g • A)).finrank_range_add_finrank_ker
  omega

theorem finrank_range_eq_of_mem_orbit {A B : Rep ι}
    (hAB : A ∈ MulAction.orbit (Gauge ι) B) :
    Module.finrank ℝ (orbitDifferential ι A).range =
      Module.finrank ℝ (orbitDifferential ι B).range := by
  obtain ⟨g, rfl⟩ := MulAction.mem_orbit_iff.mp hAB
  exact finrank_range_gauge ι g B

end MAIS.Run2OrbitDifferentialGauge

/-- info: 'MAIS.Run2OrbitDifferentialGauge.lieConjugation' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OrbitDifferentialGauge.lieConjugation

/-- info: 'MAIS.Run2OrbitDifferentialGauge.orbitDifferential_conjugation' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OrbitDifferentialGauge.orbitDifferential_conjugation

/-- info: 'MAIS.Run2OrbitDifferentialGauge.kernelEquiv' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OrbitDifferentialGauge.kernelEquiv

/-- info: 'MAIS.Run2OrbitDifferentialGauge.finrank_range_gauge' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OrbitDifferentialGauge.finrank_range_gauge

/-- info: 'MAIS.Run2OrbitDifferentialGauge.finrank_range_eq_of_mem_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OrbitDifferentialGauge.finrank_range_eq_of_mem_orbit
end
end
