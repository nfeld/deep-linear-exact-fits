-- ==================== begin module O7.Run2GeometricCharts (formalization/O7/Run2GeometricCharts.lean) ====================
section

/-! Actual Hausdorff dimensions of differentiable coordinate patches.
No orbit rank or desired codimension is used as a definition. -/
set_option autoImplicit false
set_option maxHeartbeats 1000000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal

namespace MAIS.Run2GeometricCharts

variable {E F G : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  [NormedAddCommGroup G] [NormedSpace ℝ G]

/-- Local Hausdorff dimension, defined using actual intersections with all
positive-radius metric balls. -/
def localDimH (s : Set E) (a : E) : ℝ≥0∞ :=
  ⨅ (r : ℝ) (_ : 0 < r), dimH (s ∩ Metric.ball a r)

omit [NormedSpace ℝ E] in
theorem localDimH_le (s : Set E) (a : E) {r : ℝ} (hr : 0 < r) :
    localDimH s a ≤ dimH (s ∩ Metric.ball a r) :=
  iInf_le_of_le r (iInf_le_of_le hr le_rfl)

omit [NormedSpace ℝ E] in
theorem le_localDimH {s : Set E} {a : E} {d : ℝ≥0∞}
    (h : ∀ r : ℝ, 0 < r → d ≤ dimH (s ∩ Metric.ball a r)) :
    d ≤ localDimH s a :=
  le_iInf fun r => le_iInf fun hr => h r hr

omit [NormedSpace ℝ E] in
theorem localDimH_mono {s t : Set E} (hst : s ⊆ t) (a : E) :
    localDimH s a ≤ localDimH t a := by
  exact iInf_mono fun r => iInf_mono fun _ =>
    dimH_mono (inter_subset_inter_left _ hst)

omit [NormedSpace ℝ E] in
omit [NormedSpace ℝ E] in
theorem localDimH_le_dimH (s : Set E) (a : E) :
    localDimH s a ≤ dimH s :=
  (localDimH_le s a (by norm_num : (0 : ℝ) < 1)).trans
    (dimH_mono inter_subset_left)

/-- A differentiable map with a differentiable left inverse preserves the
literal Hausdorff dimension of every subset on which the inverse identity holds. -/
theorem dimH_image_eq_of_left_inverse {f : E → F} {g : F → E}
    {s : Set E} (hf : DifferentiableOn ℝ f s)
    (hg : DifferentiableOn ℝ g (f '' s))
    (hinv : ∀ x ∈ s, g (f x) = x) :
    dimH (f '' s) = dimH s := by
  apply le_antisymm hf.dimH_image_le
  have he : g '' (f '' s) = s := by
    ext x
    constructor
    · rintro ⟨y, ⟨z, hz, rfl⟩, rfl⟩
      simpa only [hinv z hz] using hz
    · intro hx
      exact ⟨f x, ⟨x, hx, rfl⟩, hinv x hx⟩
  simpa only [he] using hg.dimH_image_le

/-- Actual partial differentiable charts preserve dimensions of every subset of
their source, without imposing an artificial dimension on that source. -/
theorem OpenPartialHomeomorph.dimH_image_eq
    (e : OpenPartialHomeomorph E F)
    (he : DifferentiableOn ℝ e e.source)
    (hi : DifferentiableOn ℝ e.symm e.target)
    {s : Set E} (hs : s ⊆ e.source) :
    dimH (e '' s) = dimH s := by
  apply dimH_image_eq_of_left_inverse (he.mono hs)
  · exact hi.mono (fun _ hy => by
      rcases hy with ⟨x, hx, rfl⟩
      exact e.map_source (hs hx))
  · exact fun x hx => e.left_inv (hs hx)

/-- Keeping every regular coordinate and fixing every normal coordinate at zero
gives a patch of the actual regular-space dimension, including dimension zero. -/
theorem dimH_coordinate_patch [FiniteDimensional ℝ E]
    {u : Set E} {x : E} (hu : u ∈ 𝓝 x) :
    dimH ((fun a : E => (a, (0 : F))) '' u) = Module.finrank ℝ E := by
  calc
    dimH ((fun a : E => (a, (0 : F))) '' u) = dimH u := by
      apply dimH_image_eq_of_left_inverse
      · exact (differentiable_id.prodMk (differentiable_const (0 : F))).differentiableOn
      · exact differentiable_fst.differentiableOn
      · intro a _
        rfl
    _ = Module.finrank ℝ E := Real.dimH_of_mem_nhds hu

/-- In a genuine differentiable ambient chart, a full regular-coordinate
neighborhood with all normal coordinates fixed to zero has its literal
Hausdorff dimension, rather than an assigned orbit dimension. -/
theorem dimH_chart_coordinate_patch [FiniteDimensional ℝ E]
    (e : OpenPartialHomeomorph (E × F) G)
    (he : DifferentiableOn ℝ e e.source)
    (hi : DifferentiableOn ℝ e.symm e.target)
    {u : Set E} {x : E} (hu : u ∈ 𝓝 x)
    (hs : (fun a : E => (a, (0 : F))) '' u ⊆ e.source) :
    dimH (e '' ((fun a : E => (a, (0 : F))) '' u)) = Module.finrank ℝ E := by
  rw [OpenPartialHomeomorph.dimH_image_eq e he hi hs]
  exact dimH_coordinate_patch hu

end MAIS.Run2GeometricCharts

/-- info: 'MAIS.Run2GeometricCharts.localDimH_le' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCharts.localDimH_le

/-- info: 'MAIS.Run2GeometricCharts.le_localDimH' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCharts.le_localDimH

/-- info: 'MAIS.Run2GeometricCharts.localDimH_mono' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCharts.localDimH_mono

/-- info: 'MAIS.Run2GeometricCharts.dimH_image_eq_of_left_inverse' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCharts.dimH_image_eq_of_left_inverse

