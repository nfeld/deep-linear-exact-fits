  simp only [frobeniusSq, Fin.sum_univ_castSucc, rowAssemble_old, rowAssemble_last]

lemma gram_isSymm {k d : ℕ} (R : Matrix (Fin k) (Fin d) ℝ) :
    (R * R.transpose).IsSymm := by
  simp [Matrix.IsSymm, Matrix.transpose_mul]

