-- ==================== begin module O7.Run2PositiveFiberTransport (formalization/O7/Run2PositiveFiberTransport.lean) ====================
section

/-! Literal arbitrary-output product fibers and their genuine geometric
codimension are preserved by actual gauge and vertex-coordinate maps. -/
set_option autoImplicit false
set_option maxHeartbeats 1500000
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PositiveFiberTransport
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open MAIS.QuiverGaugeMeasuredPair MAIS.QuiverCoordinateMeasuredPair MAIS.MatrixCoordinateTransport
open MAIS.Run2GeometricCharts MAIS.Run2GeometricCodimCharts MAIS.Run2GeometricFiberInvariance
open MAIS.ActiveIntervalDifferential MAIS.BarcodeActiveNormalForm

section Linear
variable {E F : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]

omit [FiniteDimensional ℝ E] [FiniteDimensional ℝ F] in
/-- Actual linear ambient coordinates preserve the independently defined
Hausdorff local geometric codimension. -/
theorem geometricCodimNat_linear_image (e : E ≃L[ℝ] F) (s : Set E) (a : E) :
    geometricCodimNat (e '' s) (e a)=geometricCodimNat s a := by
  have hd := e.toLinearEquiv.finrank_eq
  simp only [geometricCodimNat,localDimH_linear_image,hd]
end Linear

variable {D : ℕ} (ι : Fin (D+1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

/-- The literal fiber through A of the actual complete matrix product. -/
def fixedProductFiber (A : Rep ι) : Set (Rep ι) :=
  {B | pathMatrix B 0 (Fin.last D) (Nat.zero_le D)=
    pathMatrix A 0 (Fin.last D) (Nat.zero_le D)}


/-- The actual product fiber is a closed subset of the real entry space. -/
theorem isClosed_fixedProductFiber (A : Rep ι) : IsClosed (fixedProductFiber ι A) :=
  isClosed_eq (continuous_pathMatrix 0 (Fin.last D) (Nat.zero_le D)) continuous_const

/-- At a genuine zero-output point this literal product fiber is exactly
the actual zero-product set used in the independent zero-target geometry. -/
theorem fixedProductFiber_eq_zeroFiber (A : Rep ι)
    (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0) :
    fixedProductFiber ι A=MAIS.Run2GeometricZeroFiber.zeroFiber ι := by
  ext B
  change (pathMatrix B 0 (Fin.last D) (Nat.zero_le D)=
    pathMatrix A 0 (Fin.last D) (Nat.zero_le D)) ↔
      pathMatrix B 0 (Fin.last D) (Nat.zero_le D)=0
  rw [hzero]

/-- A genuine gauge carries the ENTIRE actual product fiber onto the actual
fiber of the transformed center. No zero-output assumption is used. -/
theorem gauge_image_fixedProductFiber (g : Gauge ι) (A : Rep ι) :
    gaugeContinuousEquiv ι g '' fixedProductFiber ι A=fixedProductFiber ι (g • A) := by
  have hf (h : Gauge ι) (B X : Rep ι) (hX : X∈fixedProductFiber ι B) :
      h • X∈fixedProductFiber ι (h • B) := by
    change pathMatrix (h • X) 0 (Fin.last D) (Nat.zero_le D)=
      pathMatrix (h • B) 0 (Fin.last D) (Nat.zero_le D)
    change pathMatrix X 0 (Fin.last D) (Nat.zero_le D)=
      pathMatrix B 0 (Fin.last D) (Nat.zero_le D) at hX
    rw [pathMatrix_gauge,pathMatrix_gauge,hX]
  ext X
  constructor
  · rintro ⟨B,hB,rfl⟩
    exact hf g A B hB
  · intro hX
    refine ⟨g⁻¹ • X,?_,smul_inv_smul g X⟩
    simpa only [inv_smul_smul] using hf g⁻¹ (g • A) X hX

theorem geometricCodimNat_gauge (g : Gauge ι) (A : Rep ι) :
    geometricCodimNat (fixedProductFiber ι (g • A)) (g • A)=
      geometricCodimNat (fixedProductFiber ι A) A := by
  rw [←gauge_image_fixedProductFiber]
  exact geometricCodimNat_linear_image (gaugeContinuousEquiv ι g) _ _

theorem geometricCodimNat_eq_of_mem_orbit {A B : Rep ι}
    (h : A∈MulAction.orbit (Gauge ι) B) :
    geometricCodimNat (fixedProductFiber ι A) A=
      geometricCodimNat (fixedProductFiber ι B) B := by
  obtain ⟨g,rfl⟩ := MulAction.mem_orbit_iff.mp h
  exact geometricCodimNat_gauge ι g B

variable {κ : Fin (D+1) → Type*}
  [∀v,Fintype (κ v)] [∀v,DecidableEq (κ v)]

/-- Actual vertex-coordinate bijections carry actual arbitrary-output
product fibers onto actual product fibers, including empty dimensions. -/
theorem coordinate_image_fixedProductFiber (e : ∀v,ι v≃κ v) (A : Rep ι) :
    coordinateContinuousEquiv e '' fixedProductFiber ι A=
      fixedProductFiber κ (transport e A) := by
  let f := coordinateContinuousEquiv e
  have hf (B : Rep ι) (hB : B∈fixedProductFiber ι A) :
      f B∈fixedProductFiber κ (transport e A) := by
    change pathMatrix (transport e B) 0 (Fin.last D) (Nat.zero_le D)=
      pathMatrix (transport e A) 0 (Fin.last D) (Nat.zero_le D)
    change pathMatrix B 0 (Fin.last D) (Nat.zero_le D)=
      pathMatrix A 0 (Fin.last D) (Nat.zero_le D) at hB
    rw [path_transport,path_transport,hB]
  have hb (B : Rep κ) (hB : B∈fixedProductFiber κ (transport e A)) :
      f.symm B∈fixedProductFiber ι A := by
    change pathMatrix B 0 (Fin.last D) (Nat.zero_le D)=
      pathMatrix (transport e A) 0 (Fin.last D) (Nat.zero_le D) at hB
    change pathMatrix (transport (fun v => (e v).symm) B) 0 (Fin.last D) (Nat.zero_le D)=
      pathMatrix A 0 (Fin.last D) (Nat.zero_le D)
    rw [path_transport,hB,path_transport]
    ext r s
    simp only [Matrix.submatrix_apply,Equiv.symm_symm,Equiv.symm_apply_apply]
  ext B
  constructor
  · rintro ⟨C,hC,rfl⟩
    exact hf C hC
  · intro hB
    exact ⟨f.symm B,hb B hB,f.apply_symm_apply B⟩

theorem geometricCodimNat_coordinate (e : ∀v,ι v≃κ v) (A : Rep ι) :
    geometricCodimNat (fixedProductFiber κ (transport e A)) (transport e A)=
      geometricCodimNat (fixedProductFiber ι A) A := by
  rw [←coordinate_image_fixedProductFiber]
  exact geometricCodimNat_linear_image (coordinateContinuousEquiv e) _ _

/-- Actual barcode normalization preserves geometric codimension of the
literal product fiber through the actual center, at arbitrary output rank. -/
theorem geometricCodimNat_normal_form {A : Rep ι} (N : ActiveNormalForm A) :
    geometricCodimNat (fixedProductFiber ι A) A=
      geometricCodimNat (fixedProductFiber (Index D N.birth N.death)
        (intervalRep D N.birth N.death)) (intervalRep D N.birth N.death) := by
  exact (geometricCodimNat_eq_of_mem_orbit ι N.original_in_orbit).trans
    (geometricCodimNat_coordinate (Index D N.birth N.death) N.coordinates
      (intervalRep D N.birth N.death))

/-- Actual whole-fiber local Hausdorff dimension is preserved by gauge;
in particular integral-dimension witnesses transfer without any flooring. -/
theorem localDimH_gauge (g : Gauge ι) (A : Rep ι) :
    localDimH (fixedProductFiber ι (g • A)) (g • A)=
      localDimH (fixedProductFiber ι A) A := by
  rw [←gauge_image_fixedProductFiber]
  exact localDimH_linear_image (gaugeContinuousEquiv ι g) _ _

/-- Actual whole-fiber local Hausdorff dimension is preserved by the
literal vertex-coordinate equivalences. -/
theorem localDimH_coordinate (e : ∀v,ι v≃κ v) (A : Rep ι) :
    localDimH (fixedProductFiber κ (transport e A)) (transport e A)=
      localDimH (fixedProductFiber ι A) A := by
  rw [←coordinate_image_fixedProductFiber]
  exact localDimH_linear_image (coordinateContinuousEquiv e) _ _

/-- Actual barcode normalization preserves the actual local Hausdorff
dimension, independently of any numerical codimension or measured pair. -/
theorem localDimH_normal_form {A : Rep ι} (N : ActiveNormalForm A) :
    localDimH (fixedProductFiber ι A) A=
      localDimH (fixedProductFiber (Index D N.birth N.death)
        (intervalRep D N.birth N.death)) (intervalRep D N.birth N.death) := by
  obtain ⟨g,hg⟩ := MulAction.mem_orbit_iff.mp N.original_in_orbit
  have ht := congrArg (fun Z : Rep ι => localDimH (fixedProductFiber ι Z) Z) hg
  exact ht.symm.trans ((localDimH_gauge ι g _).trans
    (localDimH_coordinate (Index D N.birth N.death) N.coordinates
      (intervalRep D N.birth N.death)))

end MAIS.Run2PositiveFiberTransport

/-- info: 'MAIS.Run2PositiveFiberTransport.geometricCodimNat_linear_image' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.geometricCodimNat_linear_image

/-- info: 'MAIS.Run2PositiveFiberTransport.isClosed_fixedProductFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.isClosed_fixedProductFiber

/-- info: 'MAIS.Run2PositiveFiberTransport.fixedProductFiber_eq_zeroFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.fixedProductFiber_eq_zeroFiber

/-- info: 'MAIS.Run2PositiveFiberTransport.gauge_image_fixedProductFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.gauge_image_fixedProductFiber

/-- info: 'MAIS.Run2PositiveFiberTransport.geometricCodimNat_gauge' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.geometricCodimNat_gauge

/-- info: 'MAIS.Run2PositiveFiberTransport.geometricCodimNat_eq_of_mem_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.geometricCodimNat_eq_of_mem_orbit

/-- info: 'MAIS.Run2PositiveFiberTransport.coordinate_image_fixedProductFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.coordinate_image_fixedProductFiber

/-- info: 'MAIS.Run2PositiveFiberTransport.geometricCodimNat_coordinate' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.geometricCodimNat_coordinate

/-- info: 'MAIS.Run2PositiveFiberTransport.geometricCodimNat_normal_form' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.geometricCodimNat_normal_form

/-- info: 'MAIS.Run2PositiveFiberTransport.localDimH_gauge' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.localDimH_gauge

/-- info: 'MAIS.Run2PositiveFiberTransport.localDimH_coordinate' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.localDimH_coordinate

/-- info: 'MAIS.Run2PositiveFiberTransport.localDimH_normal_form' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveFiberTransport.localDimH_normal_form
end
