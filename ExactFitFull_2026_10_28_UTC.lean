  · rintro ⟨_, lam, m, hp, hmin⟩
    obtain ⟨hlam, _⟩ := (exact_fit_pair_iff_of_pairs Phi hPairs hfit lam m).mp hp
    refine ⟨D, ?_⟩
    intro a b Dab
