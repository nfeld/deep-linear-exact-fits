-- ==================== begin module O7.Run2GeometricClosure (formalization/O7/Run2GeometricClosure.lean) ====================
section

/-! Actual geometric local dimension increases toward orbit-specialization;
the opposite inequality holds for the derived natural codimension. -/
set_option autoImplicit false
set_option maxHeartbeats 1400000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricClosure
open MAIS.QuiverRealOrbit MAIS.Run2GeometricCharts
open MAIS.Run2GeometricZeroFiber MAIS.Run2GeometricCodimension

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

theorem localDimH_mono_of_mem_closure_orbit {A B : Rep ι}
    (hAB : A ∈ closure (MulAction.orbit (Gauge ι) B)) :
    localDimH (zeroFiber ι) B ≤ localDimH (zeroFiber ι) A := by
  rw [localDimH_zeroFiber, localDimH_zeroFiber]
  exact iSup_le fun j => iSup_le fun hj =>
    le_iSup_of_le j (le_iSup_of_le (quiver_orbit_closure_trans ι hAB hj) le_rfl)

theorem localCodimNat_mono_of_mem_closure_orbit {A B : Rep ι}
    (hAB : A ∈ closure (MulAction.orbit (Gauge ι) B)) :
    localCodimNat ι A ≤ localCodimNat ι B := by
  have hd := localDimH_mono_of_mem_closure_orbit ι hAB
  have hr := ENNReal.toReal_mono (localDimH_lt_top ι A).ne hd
  exact Nat.sub_le_sub_left (Nat.floor_mono hr) _

end MAIS.Run2GeometricClosure

/-- info: 'MAIS.Run2GeometricClosure.localDimH_mono_of_mem_closure_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricClosure.localDimH_mono_of_mem_closure_orbit

/-- info: 'MAIS.Run2GeometricClosure.localCodimNat_mono_of_mem_closure_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricClosure.localCodimNat_mono_of_mem_closure_orbit
end
