-- ==================== begin module O7.BarcodeRankGeneration (formalization/O7/BarcodeRankGeneration.lean) ====================
section

set_option autoImplicit false
universe u w w'
namespace MAIS.LinearChain

open Module
open MAIS.IntervalPaddingOrder MAIS.TypeAPadding MAIS.MatrixRankGeneration
variable {K : Type u} [Field K] {n : ℕ}
variable {V : Fin n → Type w} [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)]
variable {W : Fin n → Type w'} [∀ i, AddCommGroup (W i)] [∀ i, Module K (W i)]
variable {C : Chain K (Fin n) V} {D : Chain K (Fin n) W}
variable (B : Barcode C) (E : Barcode D)

lemma Barcode.crossing_zero_start (j : ℕ) : crossing B.multiplicity 0 j = 0 := by
  simp only [crossing, Nat.not_lt_zero, false_and, ite_false, Finset.sum_const_zero]

lemma Barcode.crossing_zero_after (i j : ℕ) (hj : n < j) :
    crossing B.multiplicity i j = 0 := by
  rw [B.crossing_multiplicity, Fintype.card_eq_zero_iff]
  refine ⟨fun s => ?_⟩
  have hd := (B.death s.val).isLt
  have hs := s.property.2
  omega

lemma Barcode.crossing_diagonal_interior (i : Fin n) :
    crossing B.multiplicity (i.val + 1) (i.val + 1) = Module.finrank K (V i) := by
  rw [B.crossing_multiplicity, B.finrank_vertex]
  apply Fintype.card_congr
  exact Equiv.subtypeEquivRight (fun s => by
    simp only [Fin.le_def, Nat.lt_succ_iff, Nat.add_le_add_iff_right])

lemma Barcode.starts_le_card (a : Fin (n + 1)) :
    starts B.multiplicity a ≤ Fintype.card B.Index := by
  classical
  rw [starts_double]
  have hc := finite_pair_fiber_count (fun s : B.Index => (B.birth s).castSucc)
    (fun s => (B.death s).succ) (fun r k => r = a ∧ a < k)
  change (∑ r, ∑ k, if r = a ∧ a < k then B.multiplicity r k else 0) ≤ _
  rw [show (∑ r, ∑ k, if r = a ∧ a < k then B.multiplicity r k else 0) =
    Fintype.card {s : B.Index // (B.birth s).castSucc = a ∧ a < (B.death s).succ} from hc]
  exact Fintype.card_subtype_le _

/-- Actual vertex dimensions give the full padded coverage equality, including boundary cuts. -/
theorem Barcode.coverage_eq_of_dimensions
    (hdim : ∀ i, Module.finrank K (V i) = Module.finrank K (W i)) :
    ∀ i, crossing B.multiplicity i i = crossing E.multiplicity i i := by
  intro i
  by_cases hi : i = 0
  · subst i
    rw [B.crossing_zero_start, E.crossing_zero_start]
  · by_cases hn : n < i
    · rw [B.crossing_zero_after i i hn, E.crossing_zero_after i i hn]
    · let v : Fin n := ⟨i - 1, by omega⟩
      have hv : v.val + 1 = i := by dsimp [v]; omega
      rw [← hv, B.crossing_diagonal_interior v, E.crossing_diagonal_interior v]
      exact hdim v

/-- Actual persistence-map rank order gives every finite crossing-count inequality. -/
theorem Barcode.crossing_order_of_rank_order
    (hrank : ∀ i j (hij : i ≤ j), Module.finrank K (LinearMap.range (C.map i j hij)) ≤
      Module.finrank K (LinearMap.range (D.map i j hij))) :
    ∀ i j, i ≤ j → crossing B.multiplicity i j ≤ crossing E.multiplicity i j := by
  intro i j hij
  by_cases hi : i = 0
  · subst i
    rw [B.crossing_zero_start, E.crossing_zero_start]
  · by_cases hn : n < j
    · rw [B.crossing_zero_after i j hn, E.crossing_zero_after i j hn]
    · let a : Fin n := ⟨i - 1, by omega⟩
      let c : Fin n := ⟨j - 1, by omega⟩
      have ha : a.val + 1 = i := by dsimp [a]; omega
      have hc : c.val + 1 = j := by dsimp [c]; omega
      have hac : a ≤ c := by change i - 1 ≤ j - 1; omega
      rw [← ha, ← hc, B.crossing_multiplicity_interior a c hac,
        E.crossing_multiplicity_interior a c hac]
      exact hrank a c hac

/-- Full terminating linked-switch generation, starting from genuine ranks of arbitrary
    finite-dimensional persistence diagrams and their actual interval bases. -/
theorem Barcode.actual_rank_order_generated
    (hdim : ∀ i, Module.finrank K (V i) = Module.finrank K (W i))
    (hrank : ∀ i j (hij : i ≤ j), Module.finrank K (LinearMap.range (C.map i j hij)) ≤
      Module.finrank K (LinearMap.range (D.map i j hij))) :
    let N := Fintype.card B.Index + Fintype.card E.Index
    Relation.ReflTransGen
      (BoundedLinkedSwitch (padding E.multiplicity N) (padding B.multiplicity N))
      (padding B.multiplicity N) (padding E.multiplicity N) := by
  dsimp only
  apply interval_rank_order_generated
  · intro a
    exact (B.starts_le_card a).trans (Nat.le_add_right _ _)
  · intro a
    exact (E.starts_le_card a).trans (Nat.le_add_left _ _)
  · exact B.coverage_eq_of_dimensions E hdim
  · exact B.crossing_order_of_rank_order E hrank

variable [∀ i, FiniteDimensional K (V i)] [∀ i, FiniteDimensional K (W i)]

/-- Every pair of actual finite-dimensional chains satisfying actual rank order has genuine
    interval bases whose actual multiplicity arrays are joined by the full finite linked path. -/
theorem actual_chains_rank_order_generated
    (hdim : ∀ i, Module.finrank K (V i) = Module.finrank K (W i))
    (hrank : ∀ i j (hij : i ≤ j), Module.finrank K (LinearMap.range (C.map i j hij)) ≤
      Module.finrank K (LinearMap.range (D.map i j hij))) :
    ∃ (B : Barcode C) (E : Barcode D),
      let N := Fintype.card B.Index + Fintype.card E.Index
      Relation.ReflTransGen
        (BoundedLinkedSwitch (padding E.multiplicity N) (padding B.multiplicity N))
        (padding B.multiplicity N) (padding E.multiplicity N) := by
  obtain ⟨B⟩ := exists_barcode C
  obtain ⟨E⟩ := exists_barcode D
  exact ⟨B, E, B.actual_rank_order_generated E hdim hrank⟩

end MAIS.LinearChain

/-- info: 'MAIS.LinearChain.actual_chains_rank_order_generated' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.actual_chains_rank_order_generated
end
-- ==================== end module O7.BarcodeRankGeneration ====================

-- ==================== begin module O7.BarcodeUniqueness (formalization/O7/BarcodeUniqueness.lean) ====================
section

set_option autoImplicit false
universe u w w'
namespace MAIS.LinearChain

open Module
open MAIS.IntervalPaddingOrder MAIS.TypeAPadding MAIS.MatrixRankGeneration
variable {K : Type u} [Field K] {n : ℕ}
variable {V : Fin n → Type w} [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)]
variable {W : Fin n → Type w'} [∀ i, AddCommGroup (W i)] [∀ i, Module K (W i)]
variable {C : Chain K (Fin n) V} {D : Chain K (Fin n) W}
variable (B : Barcode C) (E : Barcode D)

/-- Actual equal persistence-map ranks force equality of actual interval multiplicities. -/
theorem Barcode.multiplicity_eq_of_rank_eq
    (hdim : ∀ i, Module.finrank K (V i) = Module.finrank K (W i))
    (hrank : ∀ i j (hij : i ≤ j), Module.finrank K (LinearMap.range (C.map i j hij)) =
      Module.finrank K (LinearMap.range (D.map i j hij))) :
    B.multiplicity = E.multiplicity := by
  let N := Fintype.card B.Index + Fintype.card E.Index
  have hB : ∀ a, starts B.multiplicity a ≤ N :=
    fun a => (B.starts_le_card a).trans (Nat.le_add_right _ _)
  have hE : ∀ a, starts E.multiplicity a ≤ N :=
    fun a => (E.starts_le_card a).trans (Nat.le_add_left _ _)
  have hd := B.coverage_eq_of_dimensions E hdim
  have hBE := B.crossing_order_of_rank_order E (fun i j hij => (hrank i j hij).le)
  have hEB := E.crossing_order_of_rank_order B (fun i j hij => (hrank i j hij).ge)
  have hpad : padding B.multiplicity N = padding E.multiplicity N := by
    apply MAIS.MatrixRankGeneration.eq_of_northwest
    intro i j
    exact le_antisymm
      (padding_northwest_order E.multiplicity B.multiplicity N hE hB
        (fun k => (hd k).symm) hEB i j)
      (padding_northwest_order B.multiplicity E.multiplicity N hB hE hd hBE i j)
  funext a k
  by_cases hak : a < k
  · have h := congrFun (congrFun hpad a) k
    simpa only [padding, hak, ite_true] using h
  · rw [B.multiplicity_upper a k (not_lt.mp hak), E.multiplicity_upper a k (not_lt.mp hak)]

lemma Barcode.endpoint_fiber_card (hm : B.multiplicity = E.multiplicity)
    (q : Fin (n + 1) × Fin (n + 1)) :
    Fintype.card {s : B.Index // ((B.birth s).castSucc, (B.death s).succ) = q} =
      Fintype.card {s : E.Index // ((E.birth s).castSucc, (E.death s).succ) = q} := by
  rcases q with ⟨a, k⟩
  simpa only [Barcode.multiplicity, Prod.mk.injEq] using congrFun (congrFun hm a) k

noncomputable def Barcode.endpointEquiv
    (hm : B.multiplicity = E.multiplicity) : B.Index ≃ E.Index :=
  Equiv.ofFiberEquiv (fun q => Fintype.equivOfCardEq (B.endpoint_fiber_card E hm q))

lemma Barcode.endpointEquiv_birth (hm : B.multiplicity = E.multiplicity) (s : B.Index) :
    E.birth (B.endpointEquiv E hm s) = B.birth s := by
  have h := Equiv.ofFiberEquiv_map
    (f := fun s : B.Index => ((B.birth s).castSucc, (B.death s).succ))
    (g := fun s : E.Index => ((E.birth s).castSucc, (E.death s).succ))
    (fun q => Fintype.equivOfCardEq (B.endpoint_fiber_card E hm q)) s
  apply Fin.ext
  exact congrArg (fun q : Fin (n + 1) × Fin (n + 1) => q.1.val) h

lemma Barcode.endpointEquiv_death (hm : B.multiplicity = E.multiplicity) (s : B.Index) :
    E.death (B.endpointEquiv E hm s) = B.death s := by
  have h := Equiv.ofFiberEquiv_map
    (f := fun s : B.Index => ((B.birth s).castSucc, (B.death s).succ))
    (g := fun s : E.Index => ((E.birth s).castSucc, (E.death s).succ))
    (fun q => Fintype.equivOfCardEq (B.endpoint_fiber_card E hm q)) s
  apply Fin.ext
  exact Nat.add_right_cancel (congrArg (fun q : Fin (n + 1) × Fin (n + 1) => q.2.val) h)

end MAIS.LinearChain

/-- info: 'MAIS.LinearChain.Barcode.multiplicity_eq_of_rank_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.Barcode.multiplicity_eq_of_rank_eq
/-- info: 'MAIS.LinearChain.Barcode.endpointEquiv_birth' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.Barcode.endpointEquiv_birth
end
-- ==================== end module O7.BarcodeUniqueness ====================

-- ==================== begin module O7.BarcodeIsomorphism (formalization/O7/BarcodeIsomorphism.lean) ====================
section

set_option autoImplicit false
universe u v w w'
namespace MAIS.LinearChain

open Module
variable {K : Type u} [Field K]
variable {I : Type v} [Fintype I] [LinearOrder I]
variable {V : I → Type w} [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)]
variable {W : I → Type w'} [∀ i, AddCommGroup (W i)] [∀ i, Module K (W i)]

/-- An actual isomorphism of actual linear chains. -/
structure Iso (C : Chain K I V) (D : Chain K I W) where
  equiv : ∀ i, V i ≃ₗ[K] W i
  commutes : ∀ i j (hij : i ≤ j),
    (equiv j).toLinearMap.comp (C.map i j hij) =
      (D.map i j hij).comp (equiv i).toLinearMap

variable {C : Chain K I V} {D : Chain K I W}
variable (B : Barcode C) (E : Barcode D)

/-- A genuine bijection of actual interval slots preserving their actual endpoints. -/
structure Barcode.Matching where
  indexEquiv : B.Index ≃ E.Index
  birth_eq : ∀ s, E.birth (indexEquiv s) = B.birth s
  death_eq : ∀ s, E.death (indexEquiv s) = B.death s

variable {B E} (M : Barcode.Matching B E)

def Barcode.Matching.activeEquiv (i : I) :
    {s : B.Index // B.birth s ≤ i ∧ i ≤ B.death s} ≃
      {s : E.Index // E.birth s ≤ i ∧ i ≤ E.death s} :=
  M.indexEquiv.subtypeEquiv (fun s => by rw [M.birth_eq s, M.death_eq s])

noncomputable def Barcode.Matching.vertexEquiv (i : I) : V i ≃ₗ[K] W i :=
  (B.basis i).equiv (E.basis i) (M.activeEquiv i)

omit [Fintype I] in
lemma Barcode.Matching.vertexEquiv_basis (i : I) (s : B.Index)
    (hs : B.birth s ≤ i ∧ i ≤ B.death s) :
    M.vertexEquiv i (B.basis i ⟨s, hs⟩) =
      E.basis i ⟨M.indexEquiv s, by rw [M.birth_eq s, M.death_eq s]; exact hs⟩ := by
  exact (B.basis i).equiv_apply ⟨s, hs⟩ (E.basis i) (M.activeEquiv i)

/-- Endpoint-preserving barcode bijections give actual commuting linear equivalences. -/
noncomputable def Barcode.Matching.iso : Iso C D where
  equiv := M.vertexEquiv
  commutes i j hij := by
    apply (B.basis i).ext
    rintro ⟨s, hs⟩
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
    rw [M.vertexEquiv_basis i s hs]
    rw [B.map_basis i j hij s hs]
    rw [E.map_basis i j hij (M.indexEquiv s)
      (show E.birth (M.indexEquiv s) ≤ i ∧ i ≤ E.death (M.indexEquiv s) by
        rw [M.birth_eq s, M.death_eq s]; exact hs)]
    by_cases hj : j ≤ B.death s
    · rw [dite_eq_left hj, dite_eq_left (show j ≤ E.death (M.indexEquiv s) by
        rw [M.death_eq s]; exact hj)]
      exact M.vertexEquiv_basis j s ⟨hs.1.trans hij, hj⟩
    · rw [dite_eq_right hj, dite_eq_right (show ¬j ≤ E.death (M.indexEquiv s) by
        rw [M.death_eq s]; exact hj), map_zero]

section FiniteVertices
variable {n : ℕ}
variable {V' : Fin n → Type w} [∀ i, AddCommGroup (V' i)] [∀ i, Module K (V' i)]
variable {W' : Fin n → Type w'} [∀ i, AddCommGroup (W' i)] [∀ i, Module K (W' i)]
variable {C' : Chain K (Fin n) V'} {D' : Chain K (Fin n) W'}
variable (B' : Barcode C') (E' : Barcode D')

noncomputable def Barcode.matchingOfMultiplicity
    (hm : B'.multiplicity = E'.multiplicity) : Barcode.Matching B' E' where
  indexEquiv := B'.endpointEquiv E' hm
  birth_eq := B'.endpointEquiv_birth E' hm
  death_eq := B'.endpointEquiv_death E' hm

/-- Equal actual ranks classify arbitrary finite-dimensional chains up to actual isomorphism. -/
theorem actual_chains_isomorphic_of_rank_eq
    [∀ i, FiniteDimensional K (V' i)] [∀ i, FiniteDimensional K (W' i)]
    (hdim : ∀ i, Module.finrank K (V' i) = Module.finrank K (W' i))
    (hrank : ∀ i j (hij : i ≤ j), Module.finrank K (LinearMap.range (C'.map i j hij)) =
      Module.finrank K (LinearMap.range (D'.map i j hij))) : Nonempty (Iso C' D') := by
  obtain ⟨B⟩ := exists_barcode C'
  obtain ⟨E⟩ := exists_barcode D'
  have hm := B.multiplicity_eq_of_rank_eq E hdim hrank
  exact ⟨(B.matchingOfMultiplicity E hm).iso⟩

end FiniteVertices
end MAIS.LinearChain

/-- info: 'MAIS.LinearChain.actual_chains_isomorphic_of_rank_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.actual_chains_isomorphic_of_rank_eq
end
-- ==================== end module O7.BarcodeIsomorphism ====================

-- ==================== begin module O7.LinearChainFromArrows (formalization/O7/LinearChainFromArrows.lean) ====================
section

set_option autoImplicit false
universe u w
namespace MAIS.LinearChain

open CategoryTheory
variable {K : Type u} [Field K] {d : ℕ}
variable {V : Fin (d + 1) → Type w}
variable [∀ i, AddCommGroup (V i)] [∀ i, Module K (V i)]

/-- The actual functor generated by an arbitrary finite tuple of actual consecutive linear maps. -/
noncomputable def arrowFunctor
    (A : ∀ e : Fin d, V e.castSucc →ₗ[K] V e.succ) :
    ComposableArrows (ModuleCat.{w} K) d :=
  ComposableArrows.mkOfObjOfMapSucc (fun i => ModuleCat.of K (V i))
    (fun e => ModuleCat.ofHom (A e))

/-- The all-path chain associated with actual consecutive arrows.  The construction uses
    Mathlib's actual free finite-chain functor construction, and assumes no rank formula. -/
noncomputable def ofArrows
    (A : ∀ e : Fin d, V e.castSucc →ₗ[K] V e.succ) : Chain K (Fin (d + 1)) V where
  map i j hij := ((arrowFunctor A).map (homOfLE hij)).hom
  map_id i := by
    change ((arrowFunctor A).map (𝟙 i)).hom = LinearMap.id
    rw [(arrowFunctor A).map_id]
    rfl
  map_comp i j k hij hjk := by
    change ((arrowFunctor A).map (homOfLE hij) ≫
      (arrowFunctor A).map (homOfLE hjk)).hom = _
    rw [← (arrowFunctor A).map_comp]
    rfl

/-- The generated chain has exactly the original consecutive arrows. -/
lemma ofArrows_map_succ
    (A : ∀ e : Fin d, V e.castSucc →ₗ[K] V e.succ) (e : Fin d) :
    (ofArrows A).map e.castSucc e.succ (by exact Nat.le_succ e.val) = A e := by
  have h := ComposableArrows.mkOfObjOfMapSucc_map_succ
    (fun i => ModuleCat.of K (V i)) (fun e => ModuleCat.ofHom (A e)) e.val e.isLt
  exact congrArg ModuleCat.Hom.hom h

variable [∀ i, FiniteDimensional K (V i)]

/-- Every finite tuple of actual linear maps over an arbitrary field has a genuine
    simultaneous interval basis.  This applies directly to arbitrary rectangular real matrices. -/
theorem arrows_have_interval_basis
    (A : ∀ e : Fin d, V e.castSucc →ₗ[K] V e.succ) : Nonempty (Barcode (ofArrows A)) :=
  exists_barcode (ofArrows A)

end MAIS.LinearChain

/-- info: 'MAIS.LinearChain.arrows_have_interval_basis' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearChain.arrows_have_interval_basis
end
-- ==================== end module O7.LinearChainFromArrows ====================

-- ==================== begin module O7.MatrixChainIsomorphism (formalization/O7/MatrixChainIsomorphism.lean) ====================
section

set_option autoImplicit false
universe w
namespace MAIS.MatrixChainIsomorphism

open MAIS.LinearChain MAIS.QuiverRealOrbit
variable {d : ℕ} {ι : Fin (d + 1) → Type w}
variable [∀ i, Fintype (ι i)] [∀ i, DecidableEq (ι i)]

def matrixArrows (A : Rep ι) :
    ∀ e : Fin d, (ι e.castSucc → ℝ) →ₗ[ℝ] (ι e.succ → ℝ) :=
  fun e => Matrix.toLin' (A e)

noncomputable def matrixChain (A : Rep ι) :
    Chain ℝ (Fin (d + 1)) (fun i => ι i → ℝ) := ofArrows (matrixArrows A)

/-- The actual matrix of the actual composed persistence map. -/
noncomputable def pathMatrix (A : Rep ι) (i j : Fin (d + 1)) (hij : i ≤ j) :
    Matrix (ι j) (ι i) ℝ := LinearMap.toMatrix' ((matrixChain A).map i j hij)

lemma pathMatrix_self (A : Rep ι) (i : Fin (d + 1)) : pathMatrix A i i le_rfl = 1 := by
  rw [pathMatrix, (matrixChain A).map_id]
  exact LinearMap.toMatrix'_id

lemma pathMatrix_comp (A : Rep ι) (i j k : Fin (d + 1)) (hij : i ≤ j) (hjk : j ≤ k) :
    pathMatrix A j k hjk * pathMatrix A i j hij = pathMatrix A i k (hij.trans hjk) := by
  rw [pathMatrix, pathMatrix, ← LinearMap.toMatrix'_comp, (matrixChain A).map_comp]
  rfl

lemma pathMatrix_arrow (A : Rep ι) (e : Fin d) :
    pathMatrix A e.castSucc e.succ (by exact Nat.le_succ e.val) = A e := by
  rw [pathMatrix, matrixChain, ofArrows_map_succ]
  exact LinearMap.toMatrix'_toLin' _

lemma pathMatrix_rank (A : Rep ι) (i j : Fin (d + 1)) (hij : i ≤ j) :
    (pathMatrix A i j hij).rank =
      Module.finrank ℝ (LinearMap.range ((matrixChain A).map i j hij)) := by
  change Module.finrank ℝ (LinearMap.range
    (Matrix.toLin' (LinearMap.toMatrix' ((matrixChain A).map i j hij)))) = _
  rw [Matrix.toLin'_toMatrix']

/-- A genuine linear automorphism gives a genuine matrix unit in the standard bases. -/
noncomputable def matrixUnit {α : Type w} [Fintype α] [DecidableEq α]
    (e : (α → ℝ) ≃ₗ[ℝ] (α → ℝ)) : (Matrix α α ℝ)ˣ where
  val := LinearMap.toMatrix' e.toLinearMap
  inv := LinearMap.toMatrix' e.symm.toLinearMap
  val_inv := by
    rw [← LinearMap.toMatrix'_comp]
    have h : e.toLinearMap.comp e.symm.toLinearMap = LinearMap.id := by ext x; simp
    rw [h]
    exact LinearMap.toMatrix'_id
  inv_val := by
    rw [← LinearMap.toMatrix'_comp]
    have h : e.symm.toLinearMap.comp e.toLinearMap = LinearMap.id := by ext x; simp
    rw [h]
    exact LinearMap.toMatrix'_id

noncomputable def isoGauge {A B : Rep ι} (e : Iso (matrixChain A) (matrixChain B)) : Gauge ι :=
  fun i => matrixUnit (e.equiv i)

/-- An actual isomorphism of the actual matrix chains is an actual real gauge change. -/
theorem isoGauge_smul {A B : Rep ι} (e : Iso (matrixChain A) (matrixChain B)) :
    isoGauge e • A = B := by
  funext k
  have h : (e.equiv k.succ).toLinearMap.comp (matrixArrows A k) =
      (matrixArrows B k).comp (e.equiv k.castSucc).toLinearMap := by
    simpa only [matrixChain, ofArrows_map_succ] using
      e.commutes k.castSucc k.succ (by exact Nat.le_succ k.val)
  have hm := congrArg LinearMap.toMatrix' h
  simp only [LinearMap.toMatrix'_comp, matrixArrows, LinearMap.toMatrix'_toLin'] at hm
  rw [gauge_smul_apply]
  change LinearMap.toMatrix' (e.equiv k.succ).toLinearMap * A k *
    LinearMap.toMatrix' (e.equiv k.castSucc).symm.toLinearMap = B k
  rw [hm, Matrix.mul_assoc]
  have hinv : LinearMap.toMatrix' (e.equiv k.castSucc).toLinearMap *
      LinearMap.toMatrix' (e.equiv k.castSucc).symm.toLinearMap = 1 :=
    (matrixUnit (e.equiv k.castSucc)).val_inv
  rw [hinv, Matrix.mul_one]

/-- Equality of every actual consecutive product rank gives membership in the actual real
    matrix gauge-group orbit, with no algebraic closure and no assumed decomposition. -/
theorem mem_gauge_orbit_of_path_rank_eq (A B : Rep ι)
    (hrank : ∀ i j (hij : i ≤ j), (pathMatrix A i j hij).rank = (pathMatrix B i j hij).rank) :
    B ∈ MulAction.orbit (Gauge ι) A := by
  have hlinear : ∀ i j (hij : i ≤ j),
      Module.finrank ℝ (LinearMap.range ((matrixChain A).map i j hij)) =
      Module.finrank ℝ (LinearMap.range ((matrixChain B).map i j hij)) := by
    intro i j hij
    simpa only [pathMatrix_rank] using hrank i j hij
  obtain ⟨e⟩ := actual_chains_isomorphic_of_rank_eq (C' := matrixChain A) (D' := matrixChain B)
    (fun _ => rfl) hlinear
  exact MulAction.mem_orbit_iff.mpr ⟨isoGauge e, isoGauge_smul e⟩

end MAIS.MatrixChainIsomorphism

/-- info: 'MAIS.MatrixChainIsomorphism.mem_gauge_orbit_of_path_rank_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.MatrixChainIsomorphism.mem_gauge_orbit_of_path_rank_eq
end
-- ==================== end module O7.MatrixChainIsomorphism ====================

-- ==================== begin module O7.MatrixPathContinuity (formalization/O7/MatrixPathContinuity.lean) ====================
section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
universe w
namespace MAIS.MatrixChainIsomorphism

open scoped Matrix
open MAIS.QuiverRealOrbit
variable {d : ℕ} {ι : Fin (d + 1) → Type w}
variable [∀ i, Fintype (ι i)] [∀ i, DecidableEq (ι i)]

lemma pathMatrix_step (A : Rep ι) (i : Fin (d + 1)) (e : Fin d) (h : i ≤ e.castSucc) :
    pathMatrix A i e.succ (h.trans (by exact Nat.le_succ e.val)) =
      A e * pathMatrix A i e.castSucc h := by
  rw [← pathMatrix_comp A i e.castSucc e.succ h (by exact Nat.le_succ e.val), pathMatrix_arrow]

/-- Actual consecutive-product matrices depend continuously on the supplied actual arrows. -/
theorem continuous_pathMatrix (i j : Fin (d + 1)) (hij : i ≤ j) :
    Continuous (fun A : Rep ι => pathMatrix A i j hij) := by
  suffices h : ∀ j : Fin (d + 1), ∀ i (hij : i ≤ j),
      Continuous (fun A : Rep ι => pathMatrix A i j hij) from h j i hij
  intro j
  induction j using Fin.induction with
  | zero =>
    intro i hij
    have hi : i = 0 := le_antisymm hij (by exact Nat.zero_le i.val)
    subst i
    simpa only [pathMatrix_self] using
      (continuous_const : Continuous (fun _ : Rep ι => (1 : Matrix (ι 0) (ι 0) ℝ)))
  | succ e ih =>
    intro i hij
    by_cases heq : i = e.succ
    · subst i
      simpa only [pathMatrix_self] using
        (continuous_const : Continuous (fun _ : Rep ι => (1 : Matrix (ι e.succ) (ι e.succ) ℝ)))
    · have hne : i.val ≠ e.val + 1 := fun h => heq (Fin.ext h)
      have hij' : i ≤ e.castSucc := by
        change i.val ≤ e.val
        have hle : i.val ≤ e.val + 1 := hij
        omega
      have hf : (fun A : Rep ι => pathMatrix A i e.succ hij) =
          (fun A : Rep ι => A e * pathMatrix A i e.castSucc hij') := by
        funext A
        exact pathMatrix_step A i e hij'
      rw [hf]
      exact (continuous_apply e).matrix_mul (ih i hij')

end MAIS.MatrixChainIsomorphism

/-- info: 'MAIS.MatrixChainIsomorphism.continuous_pathMatrix' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.MatrixChainIsomorphism.continuous_pathMatrix
end
-- ==================== end module O7.MatrixPathContinuity ====================

-- ==================== begin module O7.ActiveIntervalBasePaths (formalization/O7/ActiveIntervalBasePaths.lean) ====================
section

/-! Exact actual path entries at a labelled active interval representation. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
namespace MAIS.ActiveIntervalBasePaths

open MAIS.ActiveIntervalDifferential MAIS.MatrixChainIsomorphism
open scoped Matrix
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ)

/-- The actual interval path carries precisely each surviving slot coordinate. -/
theorem pathMatrix_intervalRep_entry (i j : Fin (D + 1)) (hij : i ≤ j)
    (r : Index D birth death j) (s : Index D birth death i) :
    pathMatrix (intervalRep D birth death) i j hij r s =
      if r.val = s.val then 1 else 0 := by
  induction j using Fin.induction generalizing i with
  | zero =>
    have hi : i = 0 := le_antisymm hij (by exact Nat.zero_le i.val)
    subst i
    simp only [pathMatrix_self, Matrix.one_apply, Subtype.ext_iff]
  | succ e ih =>
    by_cases hi : i = e.succ
    · subst i
      simp only [pathMatrix_self, Matrix.one_apply, Subtype.ext_iff]
    · have hie : i ≤ e.castSucc := by
        change i.val ≤ e.val
        have hle : i.val ≤ e.val + 1 := hij
        have hn : i.val ≠ e.val + 1 := fun h => hi (Fin.ext h)
        omega
      rw [pathMatrix_step _ i e hie, Matrix.mul_apply]
      by_cases ha : active D birth death e.castSucc r.val
      · let k₀ : Index D birth death e.castSucc := ⟨r.val, ha⟩
        rw [Finset.sum_eq_single k₀]
        · simp only [intervalRep, show r.val = k₀.val from rfl, ite_true, one_mul]
          exact ih i hie k₀ s
        · intro k _ hk
          have hv : r.val ≠ k.val := by
            intro h
            apply hk
            apply Subtype.ext
            exact h.symm
          simp only [intervalRep, ite_eq_right hv, zero_mul]
        · simp
      · have hrs : r.val ≠ s.val := by
          intro h
          apply ha
          have hb := s.property.1
          have hd := r.property.2
          change birth s.val ≤ i.val at hb
          change e.val + 1 < death r.val at hd
          change birth r.val ≤ e.val ∧ e.val < death r.val
          change i.val ≤ e.val at hie
          rw [h] at hd ⊢
          omega
        rw [ite_eq_right hrs]
        apply Finset.sum_eq_zero
        intro k _
        have hv : r.val ≠ k.val := by
          intro h
          apply ha
          simpa only [h] using k.property
        simp only [intervalRep, ite_eq_right hv, zero_mul]

/-- Literal zero-product criterion: no labelled interval survives both ends. -/
theorem pathMatrix_intervalRep_eq_zero_iff (i j : Fin (D + 1)) (hij : i ≤ j) :
    pathMatrix (intervalRep D birth death) i j hij = 0 ↔
      ∀ s : S, ¬ (active D birth death i s ∧ active D birth death j s) := by
  constructor
  · intro hz s hs
    let c : Index D birth death i := ⟨s, hs.1⟩
    let r : Index D birth death j := ⟨s, hs.2⟩
    have he := congrFun (congrFun hz r) c
    rw [pathMatrix_intervalRep_entry] at he
    simp only [show r.val = c.val from rfl, ite_true, Matrix.zero_apply] at he
    exact one_ne_zero he
  · intro h
    ext r s
    rw [pathMatrix_intervalRep_entry]
    by_cases he : r.val = s.val
    · exfalso
      apply h s.val
      exact ⟨s.property, by simpa only [he] using r.property⟩
    · simp only [ite_eq_right he, Matrix.zero_apply]

end MAIS.ActiveIntervalBasePaths
end
-- ==================== end module O7.ActiveIntervalBasePaths ====================

-- ==================== begin module O7.IntervalCochainProduct (formalization/O7/IntervalCochainProduct.lean) ====================
section

/-! Products of literal scalar interval incidence maps.  The actual normal
coordinates are the sums for the linked ordered pairs, and their section is
supported in the actual first arrow coordinate of each linked block. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000

namespace MAIS.IntervalCochainProduct

open MAIS.IntervalBlockRank MAIS.IntervalBlockGeometry
open scoped Matrix

variable {S : Type*} [Fintype S]
variable (birth death : S → ℕ)

abbrev VertexCochains := (r s : S) →
  Fin (vertexCount (birth s) (death s) (birth r) (death r)) → ℝ
abbrev ArrowCochains := (r s : S) →
  Fin (arrowCount (birth s) (death s) (birth r) (death r)) → ℝ

/-- The literal product of the actual scalar interval difference matrices. -/
noncomputable def differential : VertexCochains birth death →ₗ[ℝ] ArrowCochains birth death where
  toFun f r s := Matrix.toLin' (intervalDifferential ℝ (birth s) (death s) (birth r) (death r)) (f r s)
  map_add' f g := by
    funext r s
    exact map_add _ _ _
  map_smul' t f := by
    funext r s
    exact (Matrix.toLin' (intervalDifferential ℝ (birth s) (death s) (birth r) (death r))).map_smul t (f r s)

def Linked (r s : S) : Prop :=
  birth s < birth r ∧ birth r ≤ death s ∧ death s < death r

instance linked_decidable (r s : S) : Decidable (Linked birth death r s) := by
  unfold Linked
  infer_instance

abbrev NormalIndex := {p : S × S // Linked birth death p.1 p.2}
abbrev NormalParams := NormalIndex birth death → ℝ

/-- Actual scalar sums on the finitely many linked arrow-coordinate blocks. -/
noncomputable def obstruction : ArrowCochains birth death →ₗ[ℝ] NormalParams birth death where
  toFun y p := sumFunctional ℝ
    (arrowCount (birth p.val.2) (death p.val.2) (birth p.val.1) (death p.val.1))
      (y p.val.1 p.val.2)
  map_add' f g := by
    funext p
    exact map_add _ _ _
  map_smul' t f := by
    funext p
    exact (sumFunctional ℝ
      (arrowCount (birth p.val.2) (death p.val.2) (birth p.val.1) (death p.val.1))).map_smul t (f p.val.1 p.val.2)

/-- The section uses the actual entrance-arrow vector in each linked block. -/
noncomputable def normalInjection : NormalParams birth death →ₗ[ℝ] ArrowCochains birth death where
  toFun t r s := if h : Linked birth death r s then
    t ⟨(r, s), h⟩ • firstVector ℝ (arrowCount (birth s) (death s) (birth r) (death r)) else 0
  map_add' f g := by
    funext r s i
    by_cases h : Linked birth death r s
    · simp [h, add_mul]
    · simp [h]
  map_smul' t f := by
    funext r s i
    by_cases h : Linked birth death r s
    · simp [h, mul_assoc]
    · simp [h]

omit [Fintype S] in
/-- The actual obstruction recovers each injected entrance coefficient. -/
theorem obstruction_normalInjection (t : NormalParams birth death) :
    obstruction birth death (normalInjection birth death t) = t := by
  funext p
  rcases p with ⟨⟨r, s⟩, hp⟩
  change Linked birth death r s at hp
  have hn : 0 < arrowCount (birth s) (death s) (birth r) (death r) := by
    have hp' : birth s < birth r ∧ birth r ≤ death s ∧ death s < death r := hp
    rcases hp' with ⟨h1, h2, h3⟩
    unfold arrowCount
    omega
  change sumFunctional ℝ (arrowCount (birth s) (death s) (birth r) (death r))
    ((normalInjection birth death t) r s) = t ⟨(r, s), hp⟩
  rw [show (normalInjection birth death t) r s = t ⟨(r, s), hp⟩ •
      firstVector ℝ (arrowCount (birth s) (death s) (birth r) (death r)) by
        simp [normalInjection, hp]]
  rw [map_smul, sum_firstVector ℝ _ hn]
  simp

omit [Fintype S] in
/-- Exact membership in the image of the product of actual block maps. -/
theorem mem_range_differential_iff (y : ArrowCochains birth death) :
    y ∈ (differential birth death).range ↔
      ∀ r s, y r s ∈ (Matrix.toLin'
        (intervalDifferential ℝ (birth s) (death s) (birth r) (death r))).range := by
  constructor
  · rintro ⟨f, rfl⟩ r s
    exact ⟨f r s, rfl⟩
  · intro h
    classical
    choose f hf using h
    refine ⟨f, ?_⟩
    funext r s
    exact hf r s

omit [Fintype S] in
/-- A nonlinked actual scalar block is surjective. -/
theorem block_range_eq_top_of_not_linked
    (hvalid : ∀ s, birth s < death s) (r s : S) (h : ¬ Linked birth death r s) :
    (Matrix.toLin' (intervalDifferential ℝ (birth s) (death s) (birth r) (death r))).range = ⊤ := by
  have hq := finrank_interval_cokernel ℝ (birth s) (death s) (birth r) (death r)
    (hvalid s) (hvalid r)
  simp only [Linked] at h
  rw [ite_eq_right h] at hq
  have hd := Submodule.finrank_quotient_add_finrank
    (Matrix.toLin' (intervalDifferential ℝ (birth s) (death s) (birth r) (death r))).range
  rw [hq, zero_add] at hd
  exact Submodule.eq_top_of_finrank_eq hd

omit [Fintype S] in
/-- The kernel is proved from the literal block maps and their actual ranges. -/
theorem range_differential_eq_ker_obstruction
    (hvalid : ∀ s, birth s < death s) :
    (differential birth death).range = (obstruction birth death).ker := by
  apply Submodule.ext
  intro y
  rw [mem_range_differential_iff, LinearMap.mem_ker]
  constructor
  · intro hy
    funext p
    rcases p with ⟨⟨r, s⟩, hp⟩
    change sumFunctional ℝ (arrowCount (birth s) (death s) (birth r) (death r)) (y r s) = 0
    have hr := hy r s
    rw [linked_range_eq_ker_sum ℝ _ _ _ _ hp.1 hp.2.1 hp.2.2] at hr
    exact hr
  · intro hy r s
    by_cases h : Linked birth death r s
    · rw [linked_range_eq_ker_sum ℝ _ _ _ _ h.1 h.2.1 h.2.2]
      exact congrArg (fun t : NormalParams birth death => t ⟨(r, s), h⟩) hy
    · rw [block_range_eq_top_of_not_linked birth death hvalid r s h]
      trivial

omit [Fintype S] in
theorem normalInjection_injective : Function.Injective (normalInjection birth death) := by
  intro t u h
  calc
    t = obstruction birth death (normalInjection birth death t) :=
      (obstruction_normalInjection birth death t).symm
    _ = obstruction birth death (normalInjection birth death u) := congrArg _ h
    _ = u := obstruction_normalInjection birth death u

omit [Fintype S] in
/-- The actual image of entrance-coordinate injection complements the actual
    product incidence image. -/
theorem differential_normalInjection_isCompl (hvalid : ∀ s, birth s < death s) :
    IsCompl (differential birth death).range (normalInjection birth death).range := by
  let P := (normalInjection birth death).comp (obstruction birth death)
  have hP : IsIdempotentElem P := by
    apply LinearMap.ext
    intro y
    change normalInjection birth death
      (obstruction birth death (normalInjection birth death (obstruction birth death y))) =
        normalInjection birth death (obstruction birth death y)
    rw [obstruction_normalInjection]
  have hQ : (obstruction birth death).range = ⊤ := LinearMap.range_eq_top.mpr (by
    intro t
    exact ⟨normalInjection birth death t, obstruction_normalInjection birth death t⟩)
  have hr : P.range = (normalInjection birth death).range :=
    LinearMap.range_comp_of_range_eq_top _ hQ
  have hk : P.ker = (obstruction birth death).ker := by
    apply Submodule.ext
    intro y
    change normalInjection birth death (obstruction birth death y) = 0 ↔
      obstruction birth death y = 0
    constructor
    · intro h
      apply normalInjection_injective birth death
      simpa only [map_zero] using h
    · intro h
      rw [h, map_zero]
  have h := (LinearMap.IsIdempotentElem.isCompl hP).symm
  rw [hr, hk, ← range_differential_eq_ker_obstruction birth death hvalid] at h
  exact h

/-- The actual normal-space dimension is the number of linked ordered slot
    pairs.  Distinct multiplicity slots are counted independently. -/
theorem finrank_normalInjection_range :
    Module.finrank ℝ (normalInjection birth death).range =
      Fintype.card (NormalIndex birth death) := by
  rw [LinearMap.finrank_range_of_inj (normalInjection_injective birth death)]
  simp only [Module.finrank_pi]

/-- The quotient by the actual product matrix image has that same dimension. -/
theorem finrank_cokernel_differential (hvalid : ∀ s, birth s < death s) :
    Module.finrank ℝ (ArrowCochains birth death ⧸ (differential birth death).range) =
      Fintype.card (NormalIndex birth death) := by
  have hQ : (obstruction birth death).range = ⊤ := LinearMap.range_eq_top.mpr (by
    intro t
    exact ⟨normalInjection birth death t, obstruction_normalInjection birth death t⟩)
  have hdim := (obstruction birth death).finrank_range_add_finrank_ker
  rw [hQ, finrank_top,
    ← range_differential_eq_ker_obstruction birth death hvalid] at hdim
  have hquot := Submodule.finrank_quotient_add_finrank (differential birth death).range
  have hparam : Module.finrank ℝ (NormalParams birth death) =
      Fintype.card (NormalIndex birth death) := by simp only [Module.finrank_pi]
  rw [hparam] at hdim
  omega

end MAIS.IntervalCochainProduct
end
-- ==================== end module O7.IntervalCochainProduct ====================

-- ==================== begin module O7.IntervalPositivePotentials (formalization/O7/IntervalPositivePotentials.lean) ====================
section

/-! Positive rational potentials for the actual linked interval graph. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
namespace MAIS.IntervalPositivePotentials

open MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalBasePaths
open MAIS.IntervalCochainProduct MAIS.MatrixChainIsomorphism
variable {S : Type*} (D : ℕ) (birth death : S → ℕ)

def denominator (s : S) : ℕ := birth s + (D + 1 - death s)

/-- Rational interval potential, before clearing any finite denominators. -/
def potential (s : S) : ℚ := (birth s : ℚ) / (denominator D birth death s : ℚ)

def edgeWeight (p : NormalIndex birth death) : ℚ :=
  potential D birth death p.val.1 - potential D birth death p.val.2

theorem denominator_cast (hD : ∀ s, death s ≤ D + 1) (s : S) :
    (denominator D birth death s : ℚ) =
      (birth s : ℚ) + ((D + 1 : ℕ) : ℚ) - (death s : ℚ) := by
  unfold denominator
  rw [Nat.cast_add, Nat.cast_sub (hD s)]
  ring

theorem potential_nonneg (s : S) : 0 ≤ potential D birth death s := by
  exact div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)

theorem potential_le_one (s : S) : potential D birth death s ≤ 1 := by
  by_cases hd : denominator D birth death s = 0
  · simp only [potential, hd, Nat.cast_zero, div_zero, zero_le_one]
  · have hp : (0 : ℚ) < (denominator D birth death s : ℚ) :=
      Nat.cast_pos.mpr (Nat.pos_of_ne_zero hd)
    apply (div_le_one hp).mpr
    exact_mod_cast (Nat.le_add_right (birth s) (D + 1 - death s))

theorem potential_birth_zero (s : S) (hs : birth s = 0) :
    potential D birth death s = 0 := by simp [potential, hs]

theorem potential_death_last (s : S) (hs : death s = D + 1)
    (hp : 0 < denominator D birth death s) : potential D birth death s = 1 := by
  have hd : denominator D birth death s = birth s := by simp [denominator, hs]
  have hb : birth s ≠ 0 := by omega
  unfold potential
  rw [hd, div_self (by exact_mod_cast hb)]

/-- Linked inequalities force strictly increasing rational potential. -/
theorem potential_lt_of_linked (hD : ∀ s, death s ≤ D + 1)
    (r s : S) (hp : Linked birth death r s) :
    potential D birth death s < potential D birth death r := by
  rcases hp with ⟨hac, hcb, hbd⟩
  have hbr : 0 < birth r := by omega
  have hbs : death s < D + 1 := lt_of_lt_of_le hbd (hD r)
  have hds : 0 < denominator D birth death s := by unfold denominator; omega
  have hdr : 0 < denominator D birth death r := by unfold denominator; omega
  unfold potential
  rw [div_lt_div_iff₀ (by exact_mod_cast hds) (by exact_mod_cast hdr),
    denominator_cast D birth death hD s, denominator_cast D birth death hD r]
  have hca : (birth s : ℚ) < (birth r : ℚ) := by exact_mod_cast hac
  have hdb : (death s : ℚ) < (death r : ℚ) := by exact_mod_cast hbd
  have hNb : (death s : ℚ) < ((D + 1 : ℕ) : ℚ) := by exact_mod_cast hbs
  have hpos := mul_pos (sub_pos.mpr hca) (sub_pos.mpr hNb)
  have hnon := mul_nonneg (Nat.cast_nonneg (birth s) : (0 : ℚ) ≤ birth s)
    (sub_nonneg.mpr hdb.le)
  nlinarith

theorem edgeWeight_pos (hD : ∀ s, death s ≤ D + 1) (p : NormalIndex birth death) :
    0 < edgeWeight D birth death p :=
  sub_pos.mpr (potential_lt_of_linked D birth death hD p.val.1 p.val.2 p.property)

section ZeroBase
variable [Fintype S] [DecidableEq S]

/-- Actual zero full product rules out precisely the denominator-zero full
    interval slots, so every actual vertex potential is proper. -/
theorem denominator_pos_of_zero_path (hD : ∀ s, death s ≤ D + 1)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    (s : S) : 0 < denominator D birth death s := by
  have hn := (pathMatrix_intervalRep_eq_zero_iff D birth death 0 (Fin.last D)
    (by exact Nat.zero_le D)).mp hzero s
  by_contra h
  have hd : denominator D birth death s = 0 := by omega
  have hb : birth s = 0 := by unfold denominator at hd; omega
  have hlast : death s = D + 1 := by
    have := hD s
    unfold denominator at hd
    omega
  apply hn
  constructor
  · change birth s ≤ 0 ∧ 0 < death s
    omega
  · change birth s ≤ D ∧ D < death s
    omega

end ZeroBase
end MAIS.IntervalPositivePotentials
end
-- ==================== end module O7.IntervalPositivePotentials ====================

-- ==================== begin module O7.Run2PotentialWeightedPaths (formalization/O7/Run2PotentialWeightedPaths.lean) ====================
section

/-! Independent finite-path costs and their Bellman characterization. The
path/cost definitions contain no proposed solution or multiplicity function.
The actual measured adapter separately proves all Bellman hypotheses. -/
set_option autoImplicit false
noncomputable section
open Set
namespace MAIS.Run2PotentialWeightedPaths
variable {J : Type*}

/-- A genuine finite directed path, weighted at its source vertices. A
zero-edge terminal contributes zero cost, irrespective of its vertex weight. -/
inductive HasPathCost (edge : J → J → Prop) (weight : J → ℕ) : J → J → ℕ → Prop
  | refl (i : J) : HasPathCost edge weight i i 0
  | cons {i j k : J} {c : ℕ} (hij : edge i j) (hpath : HasPathCost edge weight j k c) :
      HasPathCost edge weight i k (weight i + c)

def costs (edge : J → J → Prop) (weight : J → ℕ) (i : J) : Set ℕ :=
  {c | ∃ k, HasPathCost edge weight i k c}

/-- Independent greatest-path-cost candidate, before any measured value is
introduced. Subsequent theorems prove boundedness and attainment. -/
def criticalDepth (edge : J → J → Prop) (weight : J → ℕ) (i : J) : ℕ :=
  sSup (costs edge weight i)

theorem zero_mem_costs (edge : J → J → Prop) (weight : J → ℕ) (i : J) :
    0 ∈ costs edge weight i := ⟨i, HasPathCost.refl i⟩

/-- Strictly decreasing natural rank and weights at most one bound every
actual finite path cost, independently of any multiplicity or Bellman data. -/
theorem path_cost_le_rank (edge : J → J → Prop) (weight rank : J → ℕ)
    (hweight : ∀ i, weight i ≤ 1) (hprogress : ∀ i j, edge i j → rank j < rank i)
    {i k : J} {c : ℕ} (hp : HasPathCost edge weight i k c) : c ≤ rank i := by
  induction hp with
  | refl i => exact Nat.zero_le _
  | @cons i j k c hij hpath ih =>
    have hw := hweight i
    have hr := hprogress i j hij
    omega

theorem finite_costs (edge : J → J → Prop) (weight rank : J → ℕ)
    (hweight : ∀ i, weight i ≤ 1) (hprogress : ∀ i j, edge i j → rank j < rank i)
    (i : J) : (costs edge weight i).Finite := by
  apply (Set.finite_Iic (rank i)).subset
  rintro c ⟨k, hp⟩
  exact path_cost_le_rank edge weight rank hweight hprogress hp

/-- Derived Bellman inequalities bound every actual finite path cost. The
positive endpoint multiplicity contributes exactly the final one. -/
theorem cost_add_one_le_of_bellman (edge : J → J → Prop) (weight m : J → ℕ)
    (hm : ∀ i, 1 ≤ m i)
    (hedge : ∀ i j, edge i j → m j + weight i ≤ m i)
    {i k : J} {c : ℕ} (hp : HasPathCost edge weight i k c) : c + 1 ≤ m i := by
  induction hp with
  | refl i => exact hm i
  | @cons i j k c hij hpath ih =>
    have hh := hedge i j hij
    omega

/-- On a genuine well-founded graph, positive Bellman data with an actual
maximizing successor whenever m>1 imply an ATTAINED largest path cost m-1.
This finite utility's Bellman data are derived from actual volumes later. -/
theorem isGreatest_costs_of_bellman
    (edge : J → J → Prop) (weight m : J → ℕ)
    (hwf : WellFounded (fun j i => edge i j))
    (hm : ∀ i, 1 ≤ m i)
    (hedge : ∀ i j, edge i j → m j + weight i ≤ m i)
    (hstep : ∀ i, 1 < m i → ∃ j, edge i j ∧ m i = m j + weight i)
    (i : J) : IsGreatest (costs edge weight i) (m i - 1) := by
  have hex : ∀ i, ∃ k, HasPathCost edge weight i k (m i - 1) := by
    intro i
    refine hwf.induction (C := fun i => ∃ k, HasPathCost edge weight i k (m i - 1)) i ?_
    intro i ih
    by_cases hi : m i = 1
    · exact ⟨i, by simpa only [hi, Nat.sub_self] using HasPathCost.refl (edge := edge) (weight := weight) i⟩
    · obtain ⟨j, hij, heq⟩ := hstep i (by have h := hm i; omega)
      obtain ⟨k, hk⟩ := ih j hij
      have hc : weight i + (m j - 1) = m i - 1 := by
        have hj := hm j
        omega
      exact ⟨k, hc ▸ HasPathCost.cons hij hk⟩
  refine ⟨hex i, ?_⟩
  rintro c ⟨k, hp⟩
  have hc := cost_add_one_le_of_bellman edge weight m hm hedge hp
  omega

/-- The independent maximum-path definition agrees with the actual Bellman
solution. No answer was used in the graph, weight or path-cost definition. -/
theorem multiplicity_eq_one_add_criticalDepth
    (edge : J → J → Prop) (weight m : J → ℕ)
    (hwf : WellFounded (fun j i => edge i j))
    (hm : ∀ i, 1 ≤ m i)
    (hedge : ∀ i j, edge i j → m j + weight i ≤ m i)
    (hstep : ∀ i, 1 < m i → ∃ j, edge i j ∧ m i = m j + weight i)
    (i : J) : m i = 1 + criticalDepth edge weight i := by
  have hmax := isGreatest_costs_of_bellman edge weight m hwf hm hedge hstep i
  have hdepth : criticalDepth edge weight i = m i - 1 := hmax.csSup_eq
  have hpos := hm i
  omega

end MAIS.Run2PotentialWeightedPaths

/-- info: 'MAIS.Run2PotentialWeightedPaths.isGreatest_costs_of_bellman' depends on axioms: [propext, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialWeightedPaths.isGreatest_costs_of_bellman

/-- info: 'MAIS.Run2PotentialWeightedPaths.multiplicity_eq_one_add_criticalDepth' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialWeightedPaths.multiplicity_eq_one_add_criticalDepth
end
end
-- ==================== end module O7.Run2PotentialWeightedPaths ====================

-- ==================== begin module O7.Run2ArithmeticCriticalPathDynamic (formalization/O7/Run2ArithmeticCriticalPathDynamic.lean) ====================
section

/-! Executable bounded-fuel longest-path evaluation. The evaluator uses only
the finite graph, source costs and a natural fuel, independently of any
measured multiplicity. The actual measured adapter derives the Bellman laws
to which the correctness theorem below applies. -/
set_option autoImplicit false
namespace MAIS.Run2ArithmeticCriticalPathDynamic
variable {J : Type*} [Fintype J]

/-- Maximum source-weight sum over paths using at most the supplied number
of edges. Stopping at the current vertex always has cost zero. -/
def depthFuel (edge : J → J → Prop) [DecidableRel edge]
    (weight : J → ℕ) : ℕ → J → ℕ
  | 0, _ => 0
  | n + 1, i => Finset.univ.sup (fun j =>
      if edge i j then weight i + depthFuel edge weight n j else 0)

theorem depthFuel_le_of_bellman (edge : J → J → Prop) [DecidableRel edge]
    (weight m : J → ℕ) (hm : ∀ i, 1 ≤ m i)
    (hedge : ∀ i j, edge i j → m j + weight i ≤ m i)
    (n : ℕ) (i : J) : depthFuel edge weight n i ≤ m i - 1 := by
  induction n generalizing i with
  | zero => simp only [depthFuel]; omega
  | succ n ih =>
    apply Finset.sup_le
    intro j _
    split_ifs with hij
    · have hh := hedge i j hij
      have hj := hm j
      have hd := ih j
      omega
    · exact Nat.zero_le _

/-- Once the fuel covers a strictly decreasing natural rank, the finite
evaluator equals the positive Bellman solution minus its terminal one.
Every hypothesis here is later derived from actual measured bands. -/
theorem depthFuel_eq_of_bellman (edge : J → J → Prop) [DecidableRel edge]
    (weight rank m : J → ℕ)
    (hm : ∀ i, 1 ≤ m i)
    (hedge : ∀ i j, edge i j → m j + weight i ≤ m i)
    (hstep : ∀ i, 1 < m i → ∃ j, edge i j ∧ m i = m j + weight i)
    (hprogress : ∀ i j, edge i j → rank j < rank i)
    (n : ℕ) (i : J) (hfuel : rank i ≤ n) :
    depthFuel edge weight n i = m i - 1 := by
  apply Nat.le_antisymm (depthFuel_le_of_bellman edge weight m hm hedge n i)
  induction n generalizing i with
  | zero =>
    have hmi : m i = 1 := by
      by_contra h
      obtain ⟨j, hij, _⟩ := hstep i (by have := hm i; omega)
      have := hprogress i j hij
      omega
    simp [depthFuel, hmi]
  | succ n ih =>
    by_cases hmi : m i = 1
    · simp only [hmi, Nat.sub_self, Nat.zero_le]
    · obtain ⟨j, hij, heq⟩ := hstep i (by have := hm i; omega)
      have hjrank := hprogress i j hij
      have hj := ih j (by omega)
      have hsup : weight i + depthFuel edge weight n j ≤
          depthFuel edge weight (n + 1) i := by
        simpa only [depthFuel, ite_eq_left hij] using
          (Finset.le_sup (f := fun k =>
            if edge i k then weight i + depthFuel edge weight n k else 0)
            (Finset.mem_univ j))
      have hmj := hm j
      omega

/-- In particular the evaluator computes the independently defined maximum
cost of genuine finite paths, rather than a formula assigned that name. -/
theorem depthFuel_eq_criticalDepth_of_bellman
    (edge : J → J → Prop) [DecidableRel edge] (weight rank m : J → ℕ)
    (hm : ∀ i, 1 ≤ m i)
    (hedge : ∀ i j, edge i j → m j + weight i ≤ m i)
    (hstep : ∀ i, 1 < m i → ∃ j, edge i j ∧ m i = m j + weight i)
    (hprogress : ∀ i j, edge i j → rank j < rank i)
    (n : ℕ) (i : J) (hfuel : rank i ≤ n) :
    depthFuel edge weight n i =
      MAIS.Run2PotentialWeightedPaths.criticalDepth edge weight i := by
  have hwf : WellFounded (fun j i => edge i j) :=
    Subrelation.wf (fun h => hprogress _ _ h) (measure rank).wf
  have hmval := MAIS.Run2PotentialWeightedPaths.multiplicity_eq_one_add_criticalDepth
    edge weight m hwf hm hedge hstep i
  have hd := depthFuel_eq_of_bellman edge weight rank m hm hedge hstep hprogress n i hfuel
  omega

end MAIS.Run2ArithmeticCriticalPathDynamic

/-- info: 'MAIS.Run2ArithmeticCriticalPathDynamic.depthFuel_eq_of_bellman' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathDynamic.depthFuel_eq_of_bellman

/-- info: 'MAIS.Run2ArithmeticCriticalPathDynamic.depthFuel_eq_criticalDepth_of_bellman' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathDynamic.depthFuel_eq_criticalDepth_of_bellman
end
-- ==================== end module O7.Run2ArithmeticCriticalPathDynamic ====================

-- ==================== begin module O7.Run2ArithmeticCriticalPathData (formalization/O7/Run2ArithmeticCriticalPathData.lean) ====================
section

/-! An independently executable arithmetic graph on a supplied finite list
of interval multiplicity arrays. Edges, thresholds and source weights use
only finite natural counts and exact rational arithmetic. In particular no
measured pair, orbit quotient, real matrix rank, or measured multiplicity
appears in these definitions. -/
set_option autoImplicit false
namespace MAIS.Run2ArithmeticCriticalPathData
open MAIS.Run2BarcodeEnumerationData
variable {D M : ℕ}

def rankInput (h : Multiplicities D M) (i j : Fin (D + 1)) : ℕ :=
  if i ≤ j then pathCount h i j else 0

def Matches (h : Multiplicities D M)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : Prop :=
  ∀ i j : Fin (D + 1), i ≤ j → pathCount h i j = ranks i j

instance matchesDecidable (h : Multiplicities D M)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : Decidable (Matches h ranks) := by
  unfold Matches
  infer_instance

def RankLE (h k : Multiplicities D M) : Prop :=
  ∀ i j : Fin (D + 1), i ≤ j → pathCount h i j ≤ pathCount k i j

def RankLT (h k : Multiplicities D M) : Prop :=
  RankLE h k ∧ ∃ i j : Fin (D + 1), i ≤ j ∧ pathCount h i j < pathCount k i j

instance rankLEDecidable (h k : Multiplicities D M) : Decidable (RankLE h k) := by
  unfold RankLE
  infer_instance
instance rankLTDecidable (h k : Multiplicities D M) : Decidable (RankLT h k) := by
  unfold RankLT
  infer_instance

/-- Independently enumerated balanced-output objective above a given array.
The supplied list may be replaced by any proved-equal faster enumeration. -/
def higherOutputValues (ν : Finset (Multiplicities D M)) (h : Multiplicities D M) : Finset ℕ :=
  (ν.filter (fun k => RankLE h k ∧ Balanced k)).image outputCount

/-- Total arithmetic coefficient. Off the feasible domain an empty list
returns zero; the actual measured adapter proves nonemptiness on-domain. -/
def coefficient (ν : Finset (Multiplicities D M)) (h : Multiplicities D M) : ℕ :=
  (higherOutputValues ν h).min.untopD 0

/-- Exact rational canonical potential threshold, before any real cast. -/
def threshold (h : Multiplicities D M) : ℚ :=
  (∑ p : MAIS.IntervalCochainProduct.NormalIndex
      (@birth D M h) (@death D M h),
    MAIS.IntervalPositivePotentials.edgeWeight D (@birth D M h) (@death D M h) p) / 2

/-- A critical source contributes one precisely at exact rational equality.
This equality test never compares arbitrary real numbers. -/
def weight (ν : Finset (Multiplicities D M)) (h : Multiplicities D M) : ℕ :=
  if (coefficient ν h : ℚ) / 2 = threshold h then 1 else 0

def Edge (ν : Finset (Multiplicities D M)) (h k : Multiplicities D M) : Prop :=
  RankLT h k ∧ coefficient ν h = coefficient ν k

instance edgeDecidable (ν : Finset (Multiplicities D M)) : DecidableRel (Edge ν) := by
  intro h k
  unfold Edge
  infer_instance

/-- Enumerating this subtype uses the supplied finite list, not the full
function-space enumeration of all bounded arrays. -/
abbrev Node (ν : Finset (Multiplicities D M)) := ↥ν

def nodeEdge (ν : Finset (Multiplicities D M)) (h k : Node ν) : Prop := Edge ν h.val k.val
instance nodeEdgeDecidable (ν : Finset (Multiplicities D M)) : DecidableRel (nodeEdge ν) := by
  intro h k
  exact edgeDecidable ν h.val k.val

def nodeWeight (ν : Finset (Multiplicities D M)) (h : Node ν) : ℕ := weight ν h.val

abbrev PathIndex (D : ℕ) := {p : Fin (D + 1) × Fin (D + 1) // p.1 ≤ p.2}

/-- Strict rank-order edges strictly increase this literal finite sum. -/
def height (h : Multiplicities D M) : ℕ :=
  ∑ p : PathIndex D, pathCount h p.val.1 p.val.2

def capacity (D M : ℕ) : ℕ := Fintype.card (PathIndex D) * M

def defect (h : Multiplicities D M) : ℕ := capacity D M - height h

/-- A fully executable finite-arithmetic longest-path candidate. Its fuel
is an architecture-independent finite bound for all feasible arrays. -/
def criticalDepth (ν : Finset (Multiplicities D M)) (h : Node ν) : ℕ :=
  MAIS.Run2ArithmeticCriticalPathDynamic.depthFuel (nodeEdge ν) (nodeWeight ν)
    (capacity D M) h

/-- Complete proof-free algorithm output from a supplied integer rank
table: all coefficient/multiplicity pairs at matching finite sources.
Actual correctness later proves this output is a nonempty singleton. -/
def computedPairs (ν : Finset (Multiplicities D M))
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : Finset (ℕ × ℕ) :=
  (ν.attach.filter (fun h => Matches h.val ranks)).image
    (fun h => (coefficient ν h.val, 1 + criticalDepth ν h))

theorem weight_le_one (ν : Finset (Multiplicities D M)) (h : Multiplicities D M) :
    weight ν h ≤ 1 := by unfold weight; split_ifs <;> omega

theorem pathCount_le_vertexCount (h : Multiplicities D M)
    (i j : Fin (D + 1)) (hij : i ≤ j) : pathCount h i j ≤ vertexCount h i := by
  apply Fintype.card_le_of_injective
    (fun s : {s : Slot h // birth s ≤ i.val ∧ j.val < death s} =>
      (⟨s.val, s.property.1, lt_of_le_of_lt hij s.property.2⟩ :
        {s : Slot h // birth s ≤ i.val ∧ i.val < death s}))
  intro s t heq
  apply Subtype.ext
  exact congrArg (fun u : {s : Slot h // birth s ≤ i.val ∧ i.val < death s} => u.val) heq

theorem height_le_capacity (h : Multiplicities D M)
    (hvertex : ∀ v : Fin (D + 1), vertexCount h v ≤ M) : height h ≤ capacity D M := by
  unfold height capacity
  calc
    _ ≤ ∑ _p : PathIndex D, M := Finset.sum_le_sum (fun p _ =>
      (pathCount_le_vertexCount h p.val.1 p.val.2 p.property).trans (hvertex p.val.1))
    _ = _ := by simp

theorem height_lt_of_rankLT {h k : Multiplicities D M} (hh : RankLT h k) :
    height h < height k := by
  rcases hh with ⟨hle, i, j, hij, hstrict⟩
  apply Finset.sum_lt_sum
  · intro p _
    exact hle p.val.1 p.val.2 p.property
  · exact ⟨⟨(i, j), hij⟩, Finset.mem_univ _, hstrict⟩

theorem defect_lt_of_rankLT {h k : Multiplicities D M} (hh : RankLT h k)
    (hk : height k ≤ capacity D M) : defect k < defect h := by
  have := height_lt_of_rankLT hh
  unfold defect
  omega

end MAIS.Run2ArithmeticCriticalPathData

/-- info: 'MAIS.Run2ArithmeticCriticalPathData.height_le_capacity' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathData.height_le_capacity

/-- info: 'MAIS.Run2ArithmeticCriticalPathData.height_lt_of_rankLT' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathData.height_lt_of_rankLT

/-- info: 'MAIS.Run2ArithmeticCriticalPathData.defect_lt_of_rankLT' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathData.defect_lt_of_rankLT
end
-- ==================== end module O7.Run2ArithmeticCriticalPathData ====================

-- ==================== begin module O7.Run2BarcodeFastEnumerationData (formalization/O7/Run2BarcodeFastEnumerationData.lean) ====================
section

/-! A smaller executable candidate generator. Enumerate at most M valid
interval slots, pad by None, histogram their endpoints, deduplicate, and
apply the same arithmetic feasibility tests as the exhaustive array list. -/
set_option autoImplicit false
namespace MAIS.Run2BarcodeFastEnumerationData
open MAIS.Run2BarcodeEnumerationData

abbrev ValidKey (D : ℕ) := {p : IntervalKey D // p.1.val < p.2.val}
abbrev Assignment (D M : ℕ) := Fin M → Option (ValidKey D)

def histogram {D M : ℕ} (f : Assignment D M) : Multiplicities D M := fun p =>
  ⟨Fintype.card {i : Fin M // Option.map Subtype.val (f i) = some p}, by
    have h := Fintype.card_le_of_injective
      (Subtype.val : {i : Fin M // Option.map Subtype.val (f i) = some p} → Fin M)
      Subtype.val_injective
    simpa only [Fintype.card_fin] using Nat.lt_succ_of_le h⟩

def generated {D M : ℕ} : Finset (Multiplicities D M) :=
  Finset.univ.image histogram

def fastCandidates {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : Finset (Multiplicities D M) :=
  (Finset.univ.filter (fun f : Assignment D M => Feasible dims ranks (histogram f))).image histogram

def fastBalancedCandidates {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : Finset (Multiplicities D M) :=
  (fastCandidates dims ranks).filter Balanced

def fastOutputValues {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : Finset ℕ :=
  (fastBalancedCandidates (M := M) dims ranks).image outputCount

def fastMinimum {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : WithTop ℕ :=
  (fastOutputValues (M := M) dims ranks).min

theorem assignments_card (D M : ℕ) :
    Fintype.card (Assignment D M) = (Fintype.card (ValidKey D) + 1) ^ M := by
  simp only [Assignment, Fintype.card_fun, Fintype.card_option, Fintype.card_fin]

/-- Exact finite interval-type count, independent of any matrix data. -/
theorem validKey_card (D : ℕ) :
    Fintype.card (ValidKey D) = (D + 2).choose 2 := by
  simpa only [ValidKey, IntervalKey, Endpoint, Fintype.card_subtype, Fintype.card_fin, Fin.lt_def] using
    (Fintype.card_product_filter_lt (α := Fin (D + 2)))

/-- The smaller enumeration has this explicit worst-case list length before
histogram deduplication and feasibility filtering. -/
theorem assignments_card_explicit (D M : ℕ) :
    Fintype.card (Assignment D M) = ((D + 2) * (D + 1) / 2 + 1) ^ M := by
  rw [assignments_card, validKey_card, Nat.choose_two_right]
  congr 3

@[simp] theorem mem_fastCandidates {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) (h : Multiplicities D M) :
    h ∈ fastCandidates dims ranks ↔ h ∈ generated ∧ Feasible dims ranks h := by
  simp only [fastCandidates, generated, Finset.mem_image, Finset.mem_filter,
    Finset.mem_univ, true_and]
  constructor
  · rintro ⟨f, hf, rfl⟩
    exact ⟨⟨f, rfl⟩, hf⟩
  · rintro ⟨⟨f, rfl⟩, hf⟩
    exact ⟨f, hf, rfl⟩

end MAIS.Run2BarcodeFastEnumerationData

/-- info: 'MAIS.Run2BarcodeFastEnumerationData.assignments_card_explicit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeFastEnumerationData.assignments_card_explicit

/-- info: 'MAIS.Run2BarcodeFastEnumerationData.mem_fastCandidates' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeFastEnumerationData.mem_fastCandidates
end
-- ==================== end module O7.Run2BarcodeFastEnumerationData ====================

-- ==================== begin module O7.Run2ArithmeticPositiveData (formalization/O7/Run2ArithmeticPositiveData.lean) ====================
section

/-! A proof-free integer-input algorithm for exact-fit pairs. Delete the
complete-product rank from every vertex dimension and every consecutive
path rank, run the zero-output algorithm, and add the regular rank count.
Depth zero has its actual neutral branch. All definitions are executable. -/
set_option autoImplicit false
namespace MAIS.Run2ArithmeticPositiveData
open MAIS.Run2BarcodeEnumerationData MAIS.Run2ArithmeticCriticalPathData
open MAIS.Run2BarcodeFastEnumerationData
variable {D : ℕ}

def residualDimensions (dims : Fin (D + 1) → ℕ) (r : ℕ) : Fin (D + 1) → ℕ :=
  fun v => dims v - r

def residualRanks (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) (r : ℕ) :
    Fin (D + 1) → Fin (D + 1) → ℕ := fun i j => ranks i j - r

abbrev ResidualCarrier (dims : Fin (D + 1) → ℕ) (r : ℕ) (v : Fin (D + 1)) :=
  Fin (residualDimensions dims r v)

/-- Cardinalities of the literal canonical finite residual carriers. These
are proved equal to the supplied residual dimensions below. -/
def residualArchitecture (dims : Fin (D + 1) → ℕ) (r : ℕ) : Fin (D + 1) → ℕ :=
  fun v => Fintype.card (ResidualCarrier dims r v)

def residualBudget (dims : Fin (D + 1) → ℕ) (r : ℕ) : ℕ :=
  ∑ v, residualArchitecture dims r v

def regularCoefficient (dims : Fin (D + 1) → ℕ) (r : ℕ) : ℕ :=
  r * (dims 0 + dims (Fin.last D) - r)

def residualNodes (dims : Fin (D + 1) → ℕ) (r : ℕ) :
    Finset (Multiplicities D (residualBudget dims r)) :=
  fastCandidates (residualArchitecture dims r) (fun _ _ => 0)

theorem residualArchitecture_eq (dims : Fin (D + 1) → ℕ) (r : ℕ) :
    residualArchitecture dims r = residualDimensions dims r := by
  funext v
  exact Fintype.card_fin _

theorem residualBudget_eq (dims : Fin (D + 1) → ℕ) (r : ℕ) :
    residualBudget dims r = ∑ v, (dims v - r) := by
  simp only [residualBudget, residualArchitecture_eq, residualDimensions]

def residualPairs (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) (r : ℕ) : Finset (ℕ × ℕ) :=
  computedPairs (residualNodes dims r) (residualRanks ranks r)

/-- The first returned integer is twice the actual exponent, and the second
is its logarithmic multiplicity. Actual correctness and singleton output
are proved separately; no desired measured value enters this program. -/
def exactFitPairs (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : Finset (ℕ × ℕ) :=
  if D = 0 then {(0, 1)} else
    (residualPairs dims ranks (ranks 0 (Fin.last D))).image
      (fun p => (regularCoefficient dims (ranks 0 (Fin.last D)) + p.1, p.2))

end MAIS.Run2ArithmeticPositiveData

/-- info: 'MAIS.Run2ArithmeticPositiveData.residualArchitecture_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositiveData.residualArchitecture_eq

/-- info: 'MAIS.Run2ArithmeticPositiveData.residualBudget_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositiveData.residualBudget_eq
end
-- ==================== end module O7.Run2ArithmeticPositiveData ====================

-- ==================== begin module O7.Run2SchurRectangular (formalization/O7/Run2SchurRectangular.lean) ====================
section

/-! Exact rectangular Schur algebra for a positive-rank complete product.
All inverse hypotheses below concern literal finite matrices. -/
set_option autoImplicit false
noncomputable section
open Matrix
open scoped Matrix
namespace MAIS.Run2SchurRectangular

variable {R M N : Type*} [Fintype R] [Fintype M] [Fintype N]
  [DecidableEq R] [DecidableEq M] [DecidableEq N]

/-- The literal complementary block after eliminating the leading block. -/
def schur (Y : Matrix (R ⊕ M) (R ⊕ N) ℝ) : Matrix M N ℝ :=
  Y.toBlocks₂₂ - Y.toBlocks₂₁ * Y.toBlocks₁₁⁻¹ * Y.toBlocks₁₂

omit [Fintype M] [Fintype N] [DecidableEq M] [DecidableEq N] in
@[simp] theorem schur_fromBlocks (A : Matrix R R ℝ) (B : Matrix R N ℝ)
    (C : Matrix M R ℝ) (D : Matrix M N ℝ) :
    schur (fromBlocks A B C D) = D - C * A⁻¹ * B := by
  simp [schur]

omit [DecidableEq M] in
/-- The genuinely rectangular push-through identity; no commutation is used. -/
theorem central_push_through (U : Matrix R M ℝ) (S : Matrix M N ℝ)
    (V : Matrix N R ℝ) :
    (U * S) * (1 + V * U * S) = (1 + U * S * V) * (U * S) := by
  simp only [Matrix.mul_add, Matrix.add_mul, Matrix.mul_one, Matrix.one_mul,
    Matrix.mul_assoc]

omit [DecidableEq M] in
/-- The exact inverse-product correction, including empty rectangular blocks. -/
theorem central_residual (U : Matrix R M ℝ) (S : Matrix M N ℝ)
    (V : Matrix N R ℝ) [Invertible (1 + U * S * V)]
    [Invertible (1 + V * U * S)] :
    S - S * V * (1 + U * S * V)⁻¹ * U * S =
      S * (1 + V * U * S)⁻¹ := by
  have hp := central_push_through U S V
  have ht : (S * V * (1 + U * S * V)⁻¹ * U * S) * (1 + V * U * S) =
      S * V * U * S := by
    calc
      _ = S * V * ((1 + U * S * V)⁻¹ *
          ((U * S) * (1 + V * U * S))) := by simp only [Matrix.mul_assoc]
      _ = S * V * ((1 + U * S * V)⁻¹ *
          ((1 + U * S * V) * (U * S))) := by rw [hp]
      _ = S * V * (U * S) := by rw [Matrix.inv_mul_cancel_left_of_invertible]
      _ = _ := by simp only [Matrix.mul_assoc]
  have hmul : (S - S * V * (1 + U * S * V)⁻¹ * U * S) * (1 + V * U * S) = S := by
    rw [Matrix.sub_mul, ht, Matrix.mul_add, Matrix.mul_one]
    simp only [Matrix.mul_assoc]
    exact add_sub_cancel_right _ _
  calc
    _ = ((S - S * V * (1 + U * S * V)⁻¹ * U * S) *
        (1 + V * U * S)) * (1 + V * U * S)⁻¹ := by
      rw [Matrix.mul_inv_cancel_right_of_invertible]
    _ = _ := by rw [hmul]

/-- Exact central block multiplication behind positive-target reconstruction. -/
theorem central_product (U : Matrix R M ℝ) (S : Matrix M N ℝ)
    (V : Matrix N R ℝ) :
    fromBlocks (1 : Matrix R R ℝ) U 0 (1 : Matrix M M ℝ) *
      fromBlocks (1 : Matrix R R ℝ) (0 : Matrix R N ℝ) 0 S *
      fromBlocks (1 : Matrix R R ℝ) 0 V (1 : Matrix N N ℝ) =
      fromBlocks (1 + U * S * V) (U * S) (S * V) S := by
  simp only [fromBlocks_multiply, Matrix.mul_one, Matrix.one_mul,
    Matrix.mul_zero, add_zero, zero_add]

/-- Actual Schur residual of the central product. -/
theorem schur_central_product (U : Matrix R M ℝ) (S : Matrix M N ℝ)
    (V : Matrix N R ℝ) [Invertible (1 + U * S * V)]
    [Invertible (1 + V * U * S)] :
    schur (fromBlocks (1 : Matrix R R ℝ) U 0 (1 : Matrix M M ℝ) *
      fromBlocks (1 : Matrix R R ℝ) (0 : Matrix R N ℝ) 0 S *
      fromBlocks (1 : Matrix R R ℝ) 0 V (1 : Matrix N N ℝ)) =
      S * (1 + V * U * S)⁻¹ := by
  rw [central_product, schur_fromBlocks]
  simpa only [Matrix.mul_assoc] using central_residual U S V

end MAIS.Run2SchurRectangular

/-- info: 'MAIS.Run2SchurRectangular.central_push_through' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurRectangular.central_push_through

/-- info: 'MAIS.Run2SchurRectangular.central_residual' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurRectangular.central_residual

/-- info: 'MAIS.Run2SchurRectangular.central_product' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurRectangular.central_product

/-- info: 'MAIS.Run2SchurRectangular.schur_central_product' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurRectangular.schur_central_product
end
end
-- ==================== end module O7.Run2SchurRectangular ====================

-- ==================== begin module O7.Run2SchurCovariance (formalization/O7/Run2SchurCovariance.lean) ====================
section

/-! Exact covariance under the actual outer LDU factors. -/
set_option autoImplicit false
noncomputable section
open Matrix
open scoped Matrix
namespace MAIS.Run2SchurCovariance
open MAIS.Run2SchurRectangular
variable {R M N : Type*} [Fintype R] [Fintype M] [Fintype N]
  [DecidableEq R] [DecidableEq M] [DecidableEq N]

/-- Lower-left and upper-right unitriangular operations preserve the actual
Schur residual, including rectangular complementary blocks. -/
theorem schur_lower_upper (A : Matrix R R ℝ) (B : Matrix R N ℝ)
    (C : Matrix M R ℝ) (D : Matrix M N ℝ) (L : Matrix M R ℝ)
    (K : Matrix R N ℝ) [Invertible A] :
    schur (fromBlocks (1 : Matrix R R ℝ) 0 L (1 : Matrix M M ℝ) *
      fromBlocks A B C D *
      fromBlocks (1 : Matrix R R ℝ) K 0 (1 : Matrix N N ℝ)) =
      schur (fromBlocks A B C D) := by
  simp only [fromBlocks_multiply, Matrix.mul_one, Matrix.one_mul, Matrix.mul_zero,
    Matrix.zero_mul, add_zero, schur_fromBlocks]
  simp only [Matrix.mul_add, Matrix.add_mul, Matrix.mul_assoc,
    Matrix.inv_mul_cancel_left_of_invertible]
  simp only [Matrix.mul_inv_cancel_left_of_invertible]
  abel

omit [DecidableEq M] [DecidableEq N] in
/-- Actual block-diagonal changes act on the complementary residual by the
literal complementary factors. -/
theorem schur_diagonal (A E : Matrix R R ℝ) (L : Matrix M M ℝ)
    (Z : Matrix N N ℝ) (P : Matrix R R ℝ) (B : Matrix R N ℝ)
    (C : Matrix M R ℝ) (D : Matrix M N ℝ)
    [Invertible A] [Invertible E] [Invertible P] :
    schur (fromBlocks A (0 : Matrix R M ℝ) 0 L *
      fromBlocks P B C D * fromBlocks E (0 : Matrix R N ℝ) 0 Z) =
      L * schur (fromBlocks P B C D) * Z := by
  simp only [fromBlocks_multiply, Matrix.mul_zero, Matrix.zero_mul, add_zero,
    zero_add, schur_fromBlocks]
  rw [Matrix.mul_inv_rev, Matrix.mul_inv_rev]
  simp only [Matrix.mul_assoc, Matrix.mul_inv_cancel_left_of_invertible,
    Matrix.inv_mul_cancel_left_of_invertible]
  simp only [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_assoc]

/-- The same identity on the literal blocks of any output matrix. -/
theorem schur_lower_upper_matrix
    (Y : Matrix (R ⊕ M) (R ⊕ N) ℝ)
    (L : Matrix M R ℝ) (K : Matrix R N ℝ) [Invertible Y.toBlocks₁₁] :
    schur (fromBlocks (1 : Matrix R R ℝ) 0 L (1 : Matrix M M ℝ) * Y *
      fromBlocks (1 : Matrix R R ℝ) K 0 (1 : Matrix N N ℝ)) = schur Y := by
  convert schur_lower_upper Y.toBlocks₁₁ Y.toBlocks₁₂ Y.toBlocks₂₁ Y.toBlocks₂₂ L K using 1 <;>
    rw [fromBlocks_toBlocks]

end MAIS.Run2SchurCovariance

/-- info: 'MAIS.Run2SchurCovariance.schur_lower_upper' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurCovariance.schur_lower_upper

/-- info: 'MAIS.Run2SchurCovariance.schur_diagonal' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurCovariance.schur_diagonal

/-- info: 'MAIS.Run2SchurCovariance.schur_lower_upper_matrix' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurCovariance.schur_lower_upper_matrix
end
end
-- ==================== end module O7.Run2SchurCovariance ====================

-- ==================== begin module O7.Run2SchurPositiveProduct (formalization/O7/Run2SchurPositiveProduct.lean) ====================
section

/-! The literal positive-target Schur formula, with all complementary factors
computed from the actual endpoint matrices. -/
set_option autoImplicit false
noncomputable section
open Matrix
open scoped Matrix
namespace MAIS.Run2SchurPositiveProduct
open MAIS.Run2SchurRectangular MAIS.Run2SchurCovariance
variable {R M N : Type*} [Fintype R] [Fintype M] [Fintype N]
  [DecidableEq R] [DecidableEq M] [DecidableEq N]

/-- Invertibility of the complementary Schur factor is derived from actual
endpoint invertibility and its actual invertible leading block. -/
theorem schur_isUnit_of_endpoint_isUnit
    (A : Matrix R R ℝ) (B : Matrix R M ℝ) (C : Matrix M R ℝ)
    (D : Matrix M M ℝ) [Invertible A]
    (h : IsUnit (fromBlocks A B C D)) : IsUnit (D - C * A⁻¹ * B) := by
  simpa only [Matrix.invOf_eq_nonsing_inv] using
    (Matrix.isUnit_fromBlocks_iff_of_invertible₁₁).mp h

/-- Complete exact noncommutative formula for L diag(I,S) Z. Neither endpoint
matrix is replaced by an abstract factorization witness. -/
theorem schur_positive_product
    (A : Matrix R R ℝ) (B : Matrix R M ℝ) (C : Matrix M R ℝ)
    (D : Matrix M M ℝ) (E : Matrix R R ℝ) (F : Matrix R N ℝ)
    (G : Matrix N R ℝ) (H : Matrix N N ℝ) (S : Matrix M N ℝ)
    [Invertible A] [Invertible E]
    [Invertible (1 + (A⁻¹ * B) * S * (G * E⁻¹))]
    [Invertible (1 + (G * E⁻¹) * (A⁻¹ * B) * S)] :
    schur (fromBlocks A B C D *
      fromBlocks (1 : Matrix R R ℝ) (0 : Matrix R N ℝ) 0 S *
      fromBlocks E F G H) =
      (D - C * A⁻¹ * B) * S *
        (1 + (G * E⁻¹) * (A⁻¹ * B) * S)⁻¹ * (H - G * E⁻¹ * F) := by
  let U := A⁻¹ * B
  let V := G * E⁻¹
  let Ls := D - C * A⁻¹ * B
  let Zs := H - G * E⁻¹ * F
  let T := fromBlocks (1 : Matrix R R ℝ) U 0 (1 : Matrix M M ℝ) *
      fromBlocks (1 : Matrix R R ℝ) (0 : Matrix R N ℝ) 0 S *
      fromBlocks (1 : Matrix R R ℝ) 0 V (1 : Matrix N N ℝ)
  let Y := fromBlocks A (0 : Matrix R M ℝ) 0 Ls * T *
      fromBlocks E (0 : Matrix R N ℝ) 0 Zs
  have hY : Y.toBlocks₁₁ = A * (1 + U * S * V) * E := by
    simp only [Y, T, central_product, fromBlocks_multiply, Matrix.mul_zero,
      Matrix.zero_mul, add_zero, zero_add, toBlocks_fromBlocks₁₁]
  let _ : Invertible (A * (1 + U * S * V)) := invertibleMul A _
  let _ : Invertible (A * (1 + U * S * V) * E) := invertibleMul _ E
  let _ : Invertible Y.toBlocks₁₁ := hY.symm ▸ inferInstance
  have hL := Matrix.fromBlocks_eq_of_invertible₁₁ A B C D
  have hZ := Matrix.fromBlocks_eq_of_invertible₁₁ E F G H
  simp only [Matrix.invOf_eq_nonsing_inv] at hL hZ
  calc
    _ = schur (fromBlocks (1 : Matrix R R ℝ) 0 (C * A⁻¹) (1 : Matrix M M ℝ) *
        Y * fromBlocks (1 : Matrix R R ℝ) (E⁻¹ * F) 0 (1 : Matrix N N ℝ)) := by
      rw [hL,hZ]
      simp only [Y, T, U, V, Ls, Zs, Matrix.mul_assoc]
    _ = schur Y := schur_lower_upper_matrix Y _ _
    _ = Ls * schur T * Zs := by
      dsimp only [Y]
      rw [show T = fromBlocks (1 + U*S*V) (U*S) (S*V) S from central_product U S V]
      exact schur_diagonal A E Ls Zs (1+U*S*V) (U*S) (S*V) S
    _ = _ := by
      rw [show schur T = S * (1 + V*U*S)⁻¹ from schur_central_product U S V]
      simp only [Ls,Zs,U,V,Matrix.mul_assoc]

end MAIS.Run2SchurPositiveProduct

/-- info: 'MAIS.Run2SchurPositiveProduct.schur_isUnit_of_endpoint_isUnit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurPositiveProduct.schur_isUnit_of_endpoint_isUnit

/-- info: 'MAIS.Run2SchurPositiveProduct.schur_positive_product' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2SchurPositiveProduct.schur_positive_product
end
end
-- ==================== end module O7.Run2SchurPositiveProduct ====================

-- ==================== begin module O7.Run2PositiveLocalNormComparison (formalization/O7/Run2PositiveLocalNormComparison.lean) ====================
section

/-! Genuine two-sided local norm bounds from actual differentiable inverse germs.
This generic fact is later applied to literal Schur output coordinates. -/
set_option autoImplicit false
noncomputable section
open Filter Asymptotics
open scoped Topology
namespace MAIS.Run2PositiveLocalNormComparison
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- Two actual differentiable inverse germs give actual uniform two-sided
squared norm bounds. No boundedness constant is supplied as a premise. -/
theorem exists_squared_comparison
    (f : E → F) (g : F → E) (a : E) (b : F)
    (hf : DifferentiableAt ℝ f a) (hg : DifferentiableAt ℝ g b)
    (hfa : f a = b) (hgb : g b = a)
    (hgf : ∀ᶠ x in 𝓝 a, g (f x) = x) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ x in 𝓝 a,
      ‖x-a‖^2 / C ≤ ‖f x-b‖^2 ∧ ‖f x-b‖^2 ≤ C * ‖x-a‖^2 := by
  obtain ⟨K,hK,hupper⟩ := isBigO_iff'.mp hf.isBigO_sub
  obtain ⟨L,hL,hlower⟩ := isBigO_iff'.mp hg.isBigO_sub
  have hl : ∀ᶠ x in 𝓝 a, ‖x-a‖ ≤ L * ‖f x-b‖ := by
    have hh := hf.continuousAt.tendsto
    rw [hfa] at hh
    filter_upwards [hh.eventually hlower,hgf] with x hx hinv
    simpa only [hinv,hgb] using hx
  have hu : ∀ᶠ x in 𝓝 a, ‖f x-b‖ ≤ K * ‖x-a‖ := by
    simpa only [hfa] using hupper
  let C := max (K^2) (L^2)
  have hC : 0 < C := lt_of_lt_of_le (sq_pos_of_pos hK) (le_max_left _ _)
  refine ⟨C,hC, ?_⟩
  filter_upwards [hl,hu] with x hx hy
  have hu2 := (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hK.le (norm_nonneg _))).mpr hy
  have hl2 := (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hL.le (norm_nonneg _))).mpr hx
  rw [mul_pow] at hu2 hl2
  constructor
  · apply (div_le_iff₀ hC).mpr
    calc
      _ ≤ L^2 * ‖f x-b‖^2 := hl2
      _ ≤ C * ‖f x-b‖^2 := mul_le_mul_of_nonneg_right (le_max_right _ _) (sq_nonneg _)
      _ = _ := mul_comm _ _
  · exact hu2.trans (mul_le_mul_of_nonneg_right (le_max_left _ _) (sq_nonneg _))

end MAIS.Run2PositiveLocalNormComparison

/-- info: 'MAIS.Run2PositiveLocalNormComparison.exists_squared_comparison' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveLocalNormComparison.exists_squared_comparison
end
end
