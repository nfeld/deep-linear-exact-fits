  rcases hA with ⟨a, A0, ea, ha, haA, hea, heaexp, hAb⟩
  rcases hC with ⟨c, C0, ec, hc, hcC, hec, hecexp, hCb⟩
  let low := min (lo*a) (hi*C0)
  let high := hi*C0
