-- ==================== begin module O7.ProductVolume (formalization/O7/ProductVolume.lean) ====================
section

/-!
# Positive-cube product volumes

Analytic recurrence and, subsequently, actual product-measure calculations.
-/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory
open scoped ENNReal

namespace MAIS.ProductVolume

/-- The explicit candidate for the CDF of a product of `n` unit uniforms. -/
def candidate (n : ℕ) (t : ℝ) : ℝ :=
  t * ∑ j ∈ Finset.range n, (Real.log (1 / t)) ^ j / (j.factorial : ℝ)

theorem candidate_div_eq_sum (n : ℕ) (t x : ℝ) :
    candidate n (t / x) =
      ∑ j ∈ Finset.range n,
        (t / (j.factorial : ℝ)) * ((Real.log (x / t)) ^ j / x) := by
  have he : (1 : ℝ) / (t / x) = x / t := by simp [div_eq_mul_inv]
  simp only [candidate, he, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _hj
  ring

theorem candidate_div_integrableOn (n : ℕ) {t : ℝ}
    (ht : 0 < t) (ht1 : t ≤ 1) :
    IntegrableOn (fun x : ℝ => candidate n (t / x)) (Ioo t 1) := by
  have hsum : IntegrableOn
      (fun x : ℝ => ∑ j ∈ Finset.range n,
        (t / (j.factorial : ℝ)) * ((Real.log (x / t)) ^ j / x)) (Ioo t 1) := by
    apply integrable_finsetSum
    intro j _hj
    exact (MAIS.LogMoments.logMoment_integrableOn j ht ht1).const_mul _
  exact hsum.congr (Filter.Eventually.of_forall (fun x =>
    (candidate_div_eq_sum n t x).symm))

theorem integral_candidate_div (n : ℕ) {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) :
    ∫ x in Ioo t 1, candidate n (t / x) =
      t * ∑ j ∈ Finset.range n,
        (Real.log (1 / t)) ^ (j + 1) / ((j + 1).factorial : ℝ) := by
  have hfun : (fun x : ℝ => candidate n (t / x)) =
      (fun x : ℝ => ∑ j ∈ Finset.range n,
        (t / (j.factorial : ℝ)) * ((Real.log (x / t)) ^ j / x)) := by
    funext x
    exact candidate_div_eq_sum n t x
  rw [hfun, integral_finsetSum]
  · rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _hj
    rw [integral_const_mul, MAIS.LogMoments.integral_Ioo_logMoment j ht ht1]
    simp only [Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
    field_simp
  · intro j _hj
    exact (MAIS.LogMoments.logMoment_integrableOn j ht ht1).const_mul _

/-- The complete one-dimensional recurrence required by the product-CDF induction. -/
theorem candidate_recurrence (n : ℕ) {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) :
    t + (∫ x in Ioo t 1, candidate n (t / x)) = candidate (n + 1) t := by
  rw [integral_candidate_div n ht ht1, candidate, Finset.sum_range_succ']
  simp only [pow_zero, Nat.factorial_zero, Nat.cast_one, div_one]
  ring

theorem candidate_nonneg (n : ℕ) {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) :
    0 ≤ candidate n t := by
  apply mul_nonneg ht.le
  apply Finset.sum_nonneg
  intro j _hj
  have hl : 0 ≤ Real.log (1 / t) :=
    Real.log_nonneg ((le_div_iff₀ ht).mpr (by simpa using ht1))
  exact div_nonneg (pow_nonneg hl _) (by positivity)

def unitInterval : Measure ℝ := volume.restrict (Ioo (0 : ℝ) 1)

instance unitInterval_probability : IsProbabilityMeasure unitInterval where
  measure_univ := by simp [unitInterval]

def cubeMeasure (n : ℕ) : Measure (Fin n → ℝ) :=
  Measure.pi (fun _ : Fin n => unitInterval)

instance cubeMeasure_probability (n : ℕ) : IsProbabilityMeasure (cubeMeasure n) := by
  unfold cubeMeasure
  infer_instance

/-- The actual strict-sublevel volume for the coordinate-product map. -/
def sublevelVolume (n : ℕ) (t : ℝ) : ℝ≥0∞ :=
  cubeMeasure n {x | ∏ i, x i < t}

theorem measurableSet_sublevel (n : ℕ) (t : ℝ) :
    MeasurableSet {x : Fin n → ℝ | ∏ i, x i < t} := by
  exact measurableSet_lt (by fun_prop) measurable_const

theorem ae_cube_coordinates (n : ℕ) :
    ∀ᵐ x ∂cubeMeasure n, ∀ i, x i ∈ Ioo (0 : ℝ) 1 := by
  apply Filter.eventually_all.mpr
  intro i
  exact (Measure.tendsto_eval_ae_ae (μ := fun _ : Fin n => unitInterval)
    (i := i)).eventually (ae_restrict_mem measurableSet_Ioo)

theorem sublevelVolume_eq_one {n : ℕ} (hn : 0 < n) {t : ℝ} (ht : 1 ≤ t) :
    sublevelVolume n t = 1 := by
  apply (mem_ae_iff_prob_eq_one (measurableSet_sublevel n t)).mp
  filter_upwards [ae_cube_coordinates n] with x hx
  have hnonempty : (Finset.univ : Finset (Fin n)).Nonempty := by
    exact ⟨⟨0, hn⟩, Finset.mem_univ _⟩
  have hp : ∏ i, x i < ∏ _i : Fin n, (1 : ℝ) :=
    Finset.prod_lt_prod_of_nonempty (fun i _ => (hx i).1)
      (fun i _ => (hx i).2) hnonempty
  exact (by simpa using hp : (∏ i, x i) < 1).trans_le ht

/-- Tonelli's exact recurrence for the actual coordinate-product sublevel measure. -/
theorem sublevelVolume_succ (n : ℕ) (t : ℝ) :
    sublevelVolume (n + 1) t =
      ∫⁻ x in Ioo (0 : ℝ) 1, sublevelVolume n (t / x) := by
  let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0
  let s : Set (ℝ × (Fin n → ℝ)) := {z | z.1 * ∏ i, z.2 i < t}
  have hmp : MeasurePreserving e (cubeMeasure (n + 1))
      (unitInterval.prod (cubeMeasure n)) :=
    measurePreserving_piFinSuccAbove (fun _ : Fin (n + 1) => unitInterval) 0
  have hs : MeasurableSet s := by
    exact measurableSet_lt (by fun_prop) measurable_const
  have he : e ⁻¹' s = {x : Fin (n + 1) → ℝ | ∏ i, x i < t} := by
    ext x
    change x 0 * (∏ i : Fin n, x ((0 : Fin (n + 1)).succAbove i)) < t ↔ _
    rw [← Fin.prod_univ_succAbove]
    rfl
  calc
    _ = (unitInterval.prod (cubeMeasure n)) s := by
      simpa only [sublevelVolume, he] using hmp.measure_preimage_equiv s
    _ = ∫⁻ x, cubeMeasure n {y | x * ∏ i, y i < t} ∂unitInterval := by
      rw [Measure.prod_apply hs]
      rfl
    _ = _ := by
      apply lintegral_congr_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
      congr 1
      ext y
      change x * (∏ i, y i) < t ↔ (∏ i, y i) < t / x
      rw [lt_div_iff₀ hx.1, mul_comm]

theorem sublevelVolume_one {t : ℝ} (_ht : 0 < t) (ht1 : t ≤ 1) :
    sublevelVolume 1 t = ENNReal.ofReal t := by
  have hmp := measurePreserving_eval (μ := fun _ : Fin 1 => unitInterval) (0 : Fin 1)
  have hpre := hmp.measure_preimage (measurableSet_Iio (a := t)).nullMeasurableSet
  have hfirst : sublevelVolume 1 t = unitInterval (Iio t) := by
    simpa only [sublevelVolume, cubeMeasure, Fin.prod_univ_one, Set.preimage,
      mem_Iio] using hpre
  rw [hfirst, unitInterval, Measure.restrict_apply measurableSet_Iio]
  have he : Iio t ∩ Ioo (0 : ℝ) 1 = Ioo 0 t := by
    ext x
    simp only [mem_inter_iff, mem_Iio, mem_Ioo]
    constructor
    · exact fun hx => ⟨hx.2.1, hx.1⟩
    · exact fun hx => ⟨hx.2, hx.1, hx.2.trans_le ht1⟩
  rw [he]
  simp

theorem sublevelVolume_succ_of_formula {n : ℕ} (hn : 0 < n)
    (ih : ∀ {s : ℝ}, 0 < s → s ≤ 1 →
      sublevelVolume n s = ENNReal.ofReal (candidate n s))
    {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) :
    sublevelVolume (n + 1) t = ENNReal.ofReal (candidate (n + 1) t) := by
  have hsplit : (∫⁻ x in Ioo (0 : ℝ) 1, sublevelVolume n (t / x)) =
      (∫⁻ x in Ioo (0 : ℝ) t, sublevelVolume n (t / x)) +
        (∫⁻ x in Ioo t 1, sublevelVolume n (t / x)) := by
    rw [← Ioo_union_Ico_eq_Ioo ht ht1, lintegral_union measurableSet_Ico]
    · congr 1
      exact setLIntegral_congr Ioo_ae_eq_Ico.symm
    · exact Set.disjoint_left.mpr (fun x hx hy => hx.2.not_ge hy.1)
  have hlo : (∫⁻ x in Ioo (0 : ℝ) t, sublevelVolume n (t / x)) =
      ENNReal.ofReal t := by
    calc
      _ = ∫⁻ _x in Ioo (0 : ℝ) t, (1 : ℝ≥0∞) := by
        apply setLIntegral_congr_fun measurableSet_Ioo
        intro x hx
        exact sublevelVolume_eq_one hn ((le_div_iff₀ hx.1).mpr (by simpa using hx.2.le))
      _ = _ := by simp
  have hhi : (∫⁻ x in Ioo t 1, sublevelVolume n (t / x)) =
      ENNReal.ofReal (∫ x in Ioo t 1, candidate n (t / x)) := by
    calc
      _ = ∫⁻ x in Ioo t 1, ENNReal.ofReal (candidate n (t / x)) := by
        apply setLIntegral_congr_fun measurableSet_Ioo
        intro x hx
        have hx0 : 0 < x := ht.trans hx.1
        exact ih (div_pos ht hx0) ((div_le_one hx0).mpr hx.1.le)
      _ = _ := by
        symm
        apply ofReal_integral_eq_lintegral_ofReal (candidate_div_integrableOn n ht ht1)
        filter_upwards [ae_restrict_mem measurableSet_Ioo] with x hx
        have hx0 : 0 < x := ht.trans hx.1
        exact candidate_nonneg n (div_pos ht hx0) ((div_le_one hx0).mpr hx.1.le)
  rw [sublevelVolume_succ, hsplit, hlo, hhi,
    ← ENNReal.ofReal_add ht.le (by
      apply setIntegral_nonneg measurableSet_Ioo
      intro x hx
      have hx0 : 0 < x := ht.trans hx.1
      exact candidate_nonneg n (div_pos ht hx0) ((div_le_one hx0).mpr hx.1.le)),
    candidate_recurrence n ht ht1]

/-- Exact product sublevel volume in every positive depth, proved by Tonelli induction. -/
theorem sublevelVolume_eq_candidate {n : ℕ} (hn : 0 < n)
    {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) :
    sublevelVolume n t = ENNReal.ofReal (candidate n t) := by
  induction n, hn using Nat.le_induction generalizing t with
  | base => simpa [candidate] using sublevelVolume_one ht ht1
  | succ n hn ih => exact sublevelVolume_succ_of_formula hn (fun hs hs1 => ih hs hs1) ht ht1

theorem candidate_succ_eq_gammaTail (n : ℕ) {t : ℝ} (ht : 0 < t) :
    candidate (n + 1) t =
      MAIS.GammaTail.tail n (Real.log (1 / t)) / (n.factorial : ℝ) := by
  have he : Real.exp (-Real.log (1 / t)) = t := by
    rw [Real.exp_neg, Real.exp_log (one_div_pos.mpr ht), one_div, inv_inv]
  rw [MAIS.GammaTail.tail_eq_sum, he, candidate]
  have hf : (n.factorial : ℝ) ≠ 0 := by exact_mod_cast n.factorial_ne_zero
  field_simp

/-- Explicit two-sided leading-logarithm bounds for the exact scalar-product CDF. -/
theorem sublevelVolume_succ_bounds (n : ℕ) {t : ℝ}
    (ht : 0 < t) (ht1 : t ≤ 1) (hlog : 1 ≤ Real.log (1 / t)) :
    ENNReal.ofReal (t * (Real.log (1 / t)) ^ n / (n.factorial : ℝ)) ≤
        sublevelVolume (n + 1) t ∧
      sublevelVolume (n + 1) t ≤
        ENNReal.ofReal ((n + 1 : ℝ) * t * (Real.log (1 / t)) ^ n) := by
  have he : Real.exp (-Real.log (1 / t)) = t := by
    rw [Real.exp_neg, Real.exp_log (one_div_pos.mpr ht), one_div, inv_inv]
  have hlo := MAIS.GammaTail.leading_le_tail n (le_trans zero_le_one hlog)
  have hhi := MAIS.GammaTail.tail_le_factorial_mul_leading n hlog
  rw [he] at hlo hhi
  have hf : (0 : ℝ) < (n.factorial : ℝ) := by exact_mod_cast n.factorial_pos
  rw [sublevelVolume_eq_candidate (Nat.zero_lt_succ n) ht ht1,
    candidate_succ_eq_gammaTail n ht]
  constructor
  · apply ENNReal.ofReal_le_ofReal
    apply (div_le_div_iff_of_pos_right hf).mpr
    simpa only [mul_comm] using hlo
  · apply ENNReal.ofReal_le_ofReal
    apply (div_le_iff₀ hf).mpr
    simpa only [Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one,
      mul_assoc, mul_comm, mul_left_comm] using hhi

/-- Exact strict-sublevel volume for the squared scalar product in every depth. -/
theorem squared_sublevelVolume_eq_candidate {n : ℕ} (hn : 0 < n)
    {eps : ℝ} (heps : 0 < eps) (heps1 : eps ≤ 1) :
    cubeMeasure n {x | (∏ i, x i) ^ 2 < eps} =
      ENNReal.ofReal (candidate n (Real.sqrt eps)) := by
  have heq : cubeMeasure n {x | (∏ i, x i) ^ 2 < eps} =
      sublevelVolume n (Real.sqrt eps) := by
    apply measure_congr
    filter_upwards [ae_cube_coordinates n] with x hx
    have hp : 0 ≤ ∏ i, x i := Finset.prod_nonneg (fun i _ => (hx i).1.le)
    exact propext (Real.lt_sqrt hp).symm
  rw [heq]
  exact sublevelVolume_eq_candidate hn (Real.sqrt_pos.mpr heps) (Real.sqrt_le_one.mpr heps1)

/-- The squared scalar-product volume has explicit exponent `1/2` and
logarithmic power `n` in depth `n+1`; no volume asymptotic is assumed. -/
theorem squared_sublevelVolume_succ_bounds (n : ℕ) {eps : ℝ}
    (heps : 0 < eps) (heps1 : eps ≤ 1)
    (hlog : 1 ≤ Real.log (1 / Real.sqrt eps)) :
    ENNReal.ofReal (Real.sqrt eps * (Real.log (1 / Real.sqrt eps)) ^ n /
        (n.factorial : ℝ)) ≤
        cubeMeasure (n + 1) {x | (∏ i, x i) ^ 2 < eps} ∧
      cubeMeasure (n + 1) {x | (∏ i, x i) ^ 2 < eps} ≤
        ENNReal.ofReal ((n + 1 : ℝ) * Real.sqrt eps *
          (Real.log (1 / Real.sqrt eps)) ^ n) := by
  rw [squared_sublevelVolume_eq_candidate (Nat.zero_lt_succ n) heps heps1,
    ← sublevelVolume_eq_candidate (Nat.zero_lt_succ n)
      (Real.sqrt_pos.mpr heps) (Real.sqrt_le_one.mpr heps1)]
  exact sublevelVolume_succ_bounds n (Real.sqrt_pos.mpr heps)
    (Real.sqrt_le_one.mpr heps1) hlog

theorem log_inv_sqrt {eps : ℝ} (heps : 0 ≤ eps) :
    Real.log (1 / Real.sqrt eps) = Real.log (1 / eps) / 2 := by
  simp only [one_div, Real.log_inv, Real.log_sqrt heps]
  ring

/-- Standard power/log bounds, with a concrete small-loss threshold. -/
theorem squared_sublevelVolume_power_log_bounds (n : ℕ) {eps : ℝ}
    (heps : 0 < eps) (hsmall : eps ≤ Real.exp (-2)) :
    ENNReal.ofReal (Real.sqrt eps * (Real.log (1 / eps)) ^ n /
        ((2 : ℝ) ^ n * (n.factorial : ℝ))) ≤
        cubeMeasure (n + 1) {x | (∏ i, x i) ^ 2 < eps} ∧
      cubeMeasure (n + 1) {x | (∏ i, x i) ^ 2 < eps} ≤
        ENNReal.ofReal (((n + 1 : ℝ) / (2 : ℝ) ^ n) * Real.sqrt eps *
          (Real.log (1 / eps)) ^ n) := by
  have heps1 : eps ≤ 1 := hsmall.trans (Real.exp_le_one_iff.mpr (by norm_num))
  have hlogeps : Real.log eps ≤ -2 := (Real.log_le_iff_le_exp heps).mpr hsmall
  have hlog : 1 ≤ Real.log (1 / Real.sqrt eps) := by
    rw [log_inv_sqrt heps.le]
    simp only [one_div, Real.log_inv]
    linarith
  have h := squared_sublevelVolume_succ_bounds n heps heps1 hlog
  rw [log_inv_sqrt heps.le, div_pow] at h
  simpa only [← mul_div_assoc, div_mul_eq_mul_div, div_div, mul_assoc] using h

/-- info: 'MAIS.ProductVolume.sublevelVolume_eq_candidate' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms sublevelVolume_eq_candidate
/-- info: 'MAIS.ProductVolume.sublevelVolume_succ_bounds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms sublevelVolume_succ_bounds
/-- info: 'MAIS.ProductVolume.squared_sublevelVolume_eq_candidate' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms squared_sublevelVolume_eq_candidate
/-- info: 'MAIS.ProductVolume.squared_sublevelVolume_succ_bounds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms squared_sublevelVolume_succ_bounds
/-- info: 'MAIS.ProductVolume.squared_sublevelVolume_power_log_bounds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms squared_sublevelVolume_power_log_bounds

/-- info: 'MAIS.ProductVolume.candidate_recurrence' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms candidate_recurrence

end MAIS.ProductVolume
end
end
-- ==================== end module O7.ProductVolume ====================

-- ==================== begin module O7.SignedCubeMeasure (formalization/O7/SignedCubeMeasure.lean) ====================
section

/-! Exact absolute-value folding of signed scalar cubes, with original
Lebesgue product measures. This supplies the orthant factor 2^n without
assuming a symmetry multiplier for sublevel volumes. -/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory
open scoped ENNReal BigOperators

namespace MAIS.SignedCubeMeasure

/-- Folding the signed unit interval by absolute value doubles the actual
positive-interval Lebesgue measure. -/
theorem map_abs_signed_unit :
    Measure.map (fun x : ℝ => |x|) (volume.restrict (Ioo (-1 : ℝ) 1)) =
      (2 : ℝ≥0∞) • volume.restrict (Ioo (0 : ℝ) 1) := by
  apply Measure.ext_of_Iic
  intro t
  rw [Measure.map_apply measurable_abs measurableSet_Iic,
    Measure.restrict_apply (measurable_abs measurableSet_Iic),
    Measure.smul_apply, smul_eq_mul, Measure.restrict_apply measurableSet_Iic]
  by_cases ht : t < 0
  · have hleft : (fun x : ℝ => |x|) ⁻¹' Iic t ∩ Ioo (-1 : ℝ) 1 = ∅ := by
      ext x
      simp only [mem_empty_iff_false, iff_false]
      intro hx
      exact (abs_nonneg x).not_gt (hx.1.trans_lt ht)
    have hright : Iic t ∩ Ioo (0 : ℝ) 1 = ∅ := by
      ext x
      simp only [mem_empty_iff_false, iff_false]
      intro hx
      exact hx.2.1.not_ge (hx.1.trans ht.le)
    simp only [hleft, hright, measure_empty, mul_zero]
  · have ht0 : 0 ≤ t := le_of_not_gt ht
    by_cases ht1 : t < 1
    · have hleft : (fun x : ℝ => |x|) ⁻¹' Iic t ∩ Ioo (-1 : ℝ) 1 = Icc (-t) t := by
        ext x
        constructor
        · intro hx
          exact abs_le.mp hx.1
        · intro hx
          refine ⟨abs_le.mpr hx, ?_⟩
          exact ⟨(neg_lt_neg ht1).trans_le hx.1, hx.2.trans_lt ht1⟩
      have hright : Iic t ∩ Ioo (0 : ℝ) 1 = Ioc (0 : ℝ) t := by
        ext x
        constructor
        · intro hx
          exact ⟨hx.2.1, hx.1⟩
        · intro hx
          exact ⟨hx.2, hx.1, hx.2.trans_lt ht1⟩
      rw [hleft, hright, Real.volume_Icc, Real.volume_Ioc, sub_zero]
      have heq : t - -t = 2 * t := by ring
      rw [heq, ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2)]
      norm_num
    · have h1t : 1 ≤ t := le_of_not_gt ht1
      have hleft : (fun x : ℝ => |x|) ⁻¹' Iic t ∩ Ioo (-1 : ℝ) 1 = Ioo (-1 : ℝ) 1 := by
        apply Set.inter_eq_right.mpr
        intro x hx
        exact (abs_lt.mpr hx).le.trans h1t
      have hright : Iic t ∩ Ioo (0 : ℝ) 1 = Ioo (0 : ℝ) 1 := by
        apply Set.inter_eq_right.mpr
        intro x hx
        exact hx.2.le.trans h1t
      rw [hleft, hright, Real.volume_Ioo, Real.volume_Ioo]
      norm_num

def signedCubeMeasure (n : ℕ) : Measure (Fin n → ℝ) :=
  Measure.pi (fun _ : Fin n => volume.restrict (Ioo (-1 : ℝ) 1))

def positiveCubeMeasure (n : ℕ) : Measure (Fin n → ℝ) :=
  Measure.pi (fun _ : Fin n => volume.restrict (Ioo (0 : ℝ) 1))

lemma pi_double_positive (n : ℕ) :
    Measure.pi (fun _ : Fin n => (2 : ℝ≥0∞) • volume.restrict (Ioo (0 : ℝ) 1)) =
      (2 : ℝ≥0∞) ^ n • positiveCubeMeasure n := by
  let : IsFiniteMeasure ((2 : ℝ≥0∞) • volume.restrict (Ioo (0 : ℝ) 1)) := by
    constructor
    norm_num [Measure.smul_apply, Measure.restrict_apply, Real.volume_Ioo]
  apply Measure.pi_eq
  intro s hs
  simp only [Measure.smul_apply, smul_eq_mul, positiveCubeMeasure,
    Measure.pi_pi, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ,
    Fintype.card_fin]

/-- The full n-dimensional folding identity, including the exact orthant
factor. The map acts coordinatewise; no quotient measure is substituted. -/
theorem map_abs_signed_cube (n : ℕ) :
    Measure.map (fun x : Fin n → ℝ => fun i => |x i|) (signedCubeMeasure n) =
      (2 : ℝ≥0∞) ^ n • positiveCubeMeasure n := by
  unfold signedCubeMeasure
  rw [Measure.pi_map_pi (fun _ => measurable_abs.aemeasurable)]
  simp_rw [map_abs_signed_unit]
  exact pi_double_positive n

end MAIS.SignedCubeMeasure

/--
info: 'MAIS.SignedCubeMeasure.map_abs_signed_cube' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.SignedCubeMeasure.map_abs_signed_cube
end
end
-- ==================== end module O7.SignedCubeMeasure ====================

-- ==================== begin module O7.SignedProductVolume (formalization/O7/SignedProductVolume.lean) ====================
section

/-! The exact squared-product sublevel volume on the full signed unit cube.
The factor 2^n is proved by an actual absolute-value pushforward measure.
-/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory
open scoped ENNReal BigOperators

namespace MAIS.SignedProductVolume

open MAIS.SignedCubeMeasure

theorem signed_squared_volume (n : ℕ) (eps : ℝ) :
    signedCubeMeasure n {x | (∏ i, x i) ^ 2 < eps} =
      (2 : ℝ≥0∞) ^ n * positiveCubeMeasure n {x | (∏ i, x i) ^ 2 < eps} := by
  have hmap : Measurable (fun x : Fin n → ℝ => fun i => |x i|) := by
    apply Measurable.of_eval
    intro i
    exact (measurable_pi_apply i).abs
  have hset : MeasurableSet {x : Fin n → ℝ | (∏ i, x i) ^ 2 < eps} := by
    have hf : Measurable (fun x : Fin n → ℝ => (∏ i, x i) ^ 2) := by fun_prop
    exact hf measurableSet_Iio
  have hpre : (fun x : Fin n → ℝ => fun i => |x i|) ⁻¹'
      {x | (∏ i, x i) ^ 2 < eps} = {x | (∏ i, x i) ^ 2 < eps} := by
    ext x
    simp only [mem_preimage, mem_ofPred_eq]
    rw [← Finset.abs_prod, sq_abs]
  have h := congrArg
    (fun mu : Measure (Fin n → ℝ) => mu {x | (∏ i, x i) ^ 2 < eps})
    (map_abs_signed_cube n)
  rw [Measure.map_apply hmap hset, hpre, Measure.smul_apply, smul_eq_mul] at h
  exact h

/-- Full signed-cube exact volume, in every positive depth. -/
theorem signed_squared_volume_eq_candidate {n : ℕ} (hn : 0 < n)
    {eps : ℝ} (heps : 0 < eps) (heps1 : eps ≤ 1) :
    signedCubeMeasure n {x | (∏ i, x i) ^ 2 < eps} =
      (2 : ℝ≥0∞) ^ n *
        ENNReal.ofReal (MAIS.ProductVolume.candidate n (Real.sqrt eps)) := by
  rw [signed_squared_volume]
  exact congrArg (fun a : ℝ≥0∞ => (2 : ℝ≥0∞) ^ n * a)
    (MAIS.ProductVolume.squared_sublevelVolume_eq_candidate hn heps heps1)

/-- Quantitative signed-cube bounds in depth n+1, with literal measured
volume and the expected square-root/logarithmic gauge. -/
theorem signed_squared_volume_power_log_bounds (n : ℕ) {eps : ℝ}
    (heps : 0 < eps) (hsmall : eps ≤ Real.exp (-2)) :
    (2 : ℝ≥0∞) ^ (n + 1) *
      ENNReal.ofReal (Real.sqrt eps * (Real.log (1 / eps)) ^ n /
        ((2 : ℝ) ^ n * (n.factorial : ℝ))) ≤
        signedCubeMeasure (n + 1) {x | (∏ i, x i) ^ 2 < eps} ∧
      signedCubeMeasure (n + 1) {x | (∏ i, x i) ^ 2 < eps} ≤
        (2 : ℝ≥0∞) ^ (n + 1) *
          ENNReal.ofReal (((n + 1 : ℝ) / (2 : ℝ) ^ n) * Real.sqrt eps *
            (Real.log (1 / eps)) ^ n) := by
  rw [signed_squared_volume]
  have h := MAIS.ProductVolume.squared_sublevelVolume_power_log_bounds n heps hsmall
  exact ⟨mul_le_mul' le_rfl h.1, mul_le_mul' le_rfl h.2⟩

end MAIS.SignedProductVolume

/--
info: 'MAIS.SignedProductVolume.signed_squared_volume_eq_candidate' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.SignedProductVolume.signed_squared_volume_eq_candidate
end
end
-- ==================== end module O7.SignedProductVolume ====================

-- ==================== begin module O7.ScalarVolumeOrder (formalization/O7/ScalarVolumeOrder.lean) ====================
section

/-! Actual scalar-product volume estimates expressed in the existing O77
power/log predicate. The estimates are derived from proved product volumes,
not built into the meaning of a scalar learning coefficient. -/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory
open scoped ENNReal

namespace MAIS.ScalarVolumeOrder

open MAIS.SignedCubeMeasure
open O77.Residual

/-- On the signed unit cube, the squared product in n+1 scalar factors has
the actual square-root/logarithmic volume order (1/2,n+1). -/
theorem signed_unit_squared_order (n : ℕ) :
    EThetaZeroPowerLog
      (fun eps => signedCubeMeasure (n + 1) {x | (∏ i, x i) ^ 2 < eps})
      (1 / 2 : ℝ) n := by
  let low : ℝ := (2 : ℝ) ^ (n + 1) /
    ((2 : ℝ) ^ n * (n.factorial : ℝ))
  let high : ℝ := (2 : ℝ) ^ (n + 1) * ((n + 1 : ℝ) / (2 : ℝ) ^ n)
  have hlow : 0 < low := by dsimp [low]; positivity
  have hhigh : 0 < high := by dsimp [high]; positivity
  have hpow : (2 : ℝ≥0∞) ^ (n + 1) = ENNReal.ofReal ((2 : ℝ) ^ (n + 1)) := by
    rw [ENNReal.ofReal_pow (by norm_num : (0 : ℝ) ≤ 2)]
    norm_num
  apply eThetaZeroPowerLog_of_sublevelPowerLogBounds
  refine ⟨low, high, Real.exp (-2), hlow, hhigh, Real.exp_pos _, ?_, ?_⟩
  · exact Real.exp_lt_one_iff.mpr (by norm_num)
  · intro eps heps hsmall
    have h := MAIS.SignedProductVolume.signed_squared_volume_power_log_bounds
      n heps hsmall.le
    have hloEq : ENNReal.ofReal low * powerLogZero (1 / 2 : ℝ) n eps =
        (2 : ℝ≥0∞) ^ (n + 1) *
          ENNReal.ofReal (Real.sqrt eps * Real.log (1 / eps) ^ n /
            ((2 : ℝ) ^ n * (n.factorial : ℝ))) := by
      rw [powerLogZero, powerLogZeroReal, hpow,
        ← ENNReal.ofReal_mul hlow.le,
        ← ENNReal.ofReal_mul (pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) _),
        Real.sqrt_eq_rpow]
      congr 1
      dsimp [low]
      ring
    have hhiEq : ENNReal.ofReal high * powerLogZero (1 / 2 : ℝ) n eps =
        (2 : ℝ≥0∞) ^ (n + 1) *
          ENNReal.ofReal (((n + 1 : ℝ) / (2 : ℝ) ^ n) * Real.sqrt eps *
            Real.log (1 / eps) ^ n) := by
      rw [powerLogZero, powerLogZeroReal, hpow,
        ← ENNReal.ofReal_mul hhigh.le,
        ← ENNReal.ofReal_mul (pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) _),
        Real.sqrt_eq_rpow]
      congr 1
      dsimp [high]
      ring
    exact ⟨hloEq ▸ h.1, hhiEq ▸ h.2⟩

end MAIS.ScalarVolumeOrder

/--
info: 'MAIS.ScalarVolumeOrder.signed_unit_squared_order' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ScalarVolumeOrder.signed_unit_squared_order
end
end
-- ==================== end module O7.ScalarVolumeOrder ====================

-- ==================== begin module O7.CubeScaling (formalization/O7/CubeScaling.lean) ====================
section

/-!
# Scalar dilation of actual cube measures

All measures are products of restricted one-dimensional Lebesgue measure.
The dilation and product-loss identities below introduce no volume asymptotic.
-/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory
open scoped ENNReal BigOperators

namespace MAIS.CubeScaling

def signedCubeAt (n : ℕ) (a : ℝ) : Measure (Fin n → ℝ) :=
  Measure.pi (fun _ : Fin n => volume.restrict (Ioo (-a) a))

def positiveCubeAt (n : ℕ) (a : ℝ) : Measure (Fin n → ℝ) :=
  Measure.pi (fun _ : Fin n => volume.restrict (Ioo (0 : ℝ) a))

def dilation (n : ℕ) (a : ℝ) (x : Fin n → ℝ) : Fin n → ℝ := fun i => a * x i

theorem measurable_dilation (n : ℕ) (a : ℝ) : Measurable (dilation n a) := by
  unfold dilation
  fun_prop

theorem map_mul_signed_interval {a : ℝ} (ha : 0 < a) :
    Measure.map (fun x : ℝ => a * x) (volume.restrict (Ioo (-1 : ℝ) 1)) =
      ENNReal.ofReal (a⁻¹) • volume.restrict (Ioo (-a) a) := by
  have hpre : (fun x : ℝ => a * x) ⁻¹' Ioo (-a) a = Ioo (-1 : ℝ) 1 := by
    rw [preimage_const_mul_Ioo₀ _ _ ha]
    simp [ha.ne']
  rw [← hpre, ← Measure.restrict_map (measurable_const_mul a) measurableSet_Ioo,
    Real.map_volume_mul_left ha.ne', Measure.restrict_smul, abs_of_pos (inv_pos.mpr ha)]

theorem map_mul_positive_interval {a : ℝ} (ha : 0 < a) :
    Measure.map (fun x : ℝ => a * x) (volume.restrict (Ioo (0 : ℝ) 1)) =
      ENNReal.ofReal (a⁻¹) • volume.restrict (Ioo (0 : ℝ) a) := by
  have hpre : (fun x : ℝ => a * x) ⁻¹' Ioo (0 : ℝ) a = Ioo (0 : ℝ) 1 := by
    rw [preimage_const_mul_Ioo₀ _ _ ha]
    simp [ha.ne']
  rw [← hpre, ← Measure.restrict_map (measurable_const_mul a) measurableSet_Ioo,
    Real.map_volume_mul_left ha.ne', Measure.restrict_smul, abs_of_pos (inv_pos.mpr ha)]

theorem pi_smul_intervals (n : ℕ) (c : ℝ≥0∞) (hc : c ≠ ∞) (lo hi : ℝ) :
    Measure.pi (fun _ : Fin n => c • volume.restrict (Ioo lo hi)) =
      c ^ n • Measure.pi (fun _ : Fin n => volume.restrict (Ioo lo hi)) := by
  let : IsFiniteMeasure (c • volume.restrict (Ioo lo hi)) := by
    constructor
    simp only [Measure.smul_apply, smul_eq_mul, Measure.restrict_apply_univ]
    exact ENNReal.mul_lt_top hc.lt_top (by rw [Real.volume_Ioo]; exact ENNReal.ofReal_lt_top)
  apply Measure.pi_eq
  intro s hs
  simp only [Measure.smul_apply, smul_eq_mul, Measure.pi_pi,
    Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

theorem map_dilation_signedCube (n : ℕ) {a : ℝ} (ha : 0 < a) :
    Measure.map (dilation n a) (signedCubeAt n 1) =
      ENNReal.ofReal (a⁻¹) ^ n • signedCubeAt n a := by
  unfold signedCubeAt dilation
  rw [Measure.pi_map_pi (fun _ => (measurable_const_mul a).aemeasurable)]
  simp_rw [map_mul_signed_interval ha]
  exact pi_smul_intervals n _ ENNReal.ofReal_ne_top _ _

theorem map_dilation_positiveCube (n : ℕ) {a : ℝ} (ha : 0 < a) :
    Measure.map (dilation n a) (positiveCubeAt n 1) =
      ENNReal.ofReal (a⁻¹) ^ n • positiveCubeAt n a := by
  unfold positiveCubeAt dilation
  rw [Measure.pi_map_pi (fun _ => (measurable_const_mul a).aemeasurable)]
  simp_rw [map_mul_positive_interval ha]
  exact pi_smul_intervals n _ ENNReal.ofReal_ne_top _ _

theorem signedCube_eq_scaled_map (n : ℕ) {a : ℝ} (ha : 0 < a) :
    signedCubeAt n a =
      ENNReal.ofReal a ^ n • Measure.map (dilation n a) (signedCubeAt n 1) := by
  rw [map_dilation_signedCube n ha, smul_smul, ← mul_pow,
    ← ENNReal.ofReal_mul ha.le, mul_inv_cancel₀ ha.ne', ENNReal.ofReal_one, one_pow, one_smul]

theorem positiveCube_eq_scaled_map (n : ℕ) {a : ℝ} (ha : 0 < a) :
    positiveCubeAt n a =
      ENNReal.ofReal a ^ n • Measure.map (dilation n a) (positiveCubeAt n 1) := by
  rw [map_dilation_positiveCube n ha, smul_smul, ← mul_pow,
    ← ENNReal.ofReal_mul ha.le, mul_inv_cancel₀ ha.ne', ENNReal.ofReal_one, one_pow, one_smul]

theorem prod_dilation (n : ℕ) (a : ℝ) (x : Fin n → ℝ) :
    (∏ i, dilation n a x i) = a ^ n * ∏ i, x i := by
  simp only [dilation, Finset.prod_mul_distrib, Finset.prod_const,
    Finset.card_univ, Fintype.card_fin]

theorem signedCube_squared_sublevel_scale (n : ℕ) {a : ℝ} (ha : 0 < a) (eps : ℝ) :
    signedCubeAt n a {x | (∏ i, x i) ^ 2 < eps} =
      ENNReal.ofReal a ^ n *
        signedCubeAt n 1 {x | (∏ i, x i) ^ 2 < eps / (a ^ n) ^ 2} := by
  rw [signedCube_eq_scaled_map n ha, Measure.smul_apply, smul_eq_mul,
    Measure.map_apply (measurable_dilation n a) (measurableSet_lt (by fun_prop) measurable_const)]
  congr 2
  ext x
  simp only [mem_preimage, mem_ofPred_eq, prod_dilation, mul_pow]
  rw [lt_div_iff₀ (sq_pos_of_pos (pow_pos ha n)), mul_comm]

theorem positiveCube_squared_sublevel_scale (n : ℕ) {a : ℝ} (ha : 0 < a) (eps : ℝ) :
    positiveCubeAt n a {x | (∏ i, x i) ^ 2 < eps} =
      ENNReal.ofReal a ^ n *
        positiveCubeAt n 1 {x | (∏ i, x i) ^ 2 < eps / (a ^ n) ^ 2} := by
  rw [positiveCube_eq_scaled_map n ha, Measure.smul_apply, smul_eq_mul,
    Measure.map_apply (measurable_dilation n a) (measurableSet_lt (by fun_prop) measurable_const)]
  congr 2
  ext x
  simp only [mem_preimage, mem_ofPred_eq, prod_dilation, mul_pow]
  rw [lt_div_iff₀ (sq_pos_of_pos (pow_pos ha n)), mul_comm]

theorem signedCubeAt_eq_restrict (n : ℕ) (a : ℝ) :
    signedCubeAt n a = (volume : Measure (Fin n → ℝ)).restrict
      (Set.univ.pi (fun _ : Fin n => Ioo (-a) a)) := by
  exact (Measure.restrict_pi_pi (fun _ : Fin n => (volume : Measure ℝ))
    (fun _ : Fin n => Ioo (-a) a)).symm

theorem positiveCubeAt_eq_restrict (n : ℕ) (a : ℝ) :
    positiveCubeAt n a = (volume : Measure (Fin n → ℝ)).restrict
      (Set.univ.pi (fun _ : Fin n => Ioo (0 : ℝ) a)) := by
  exact (Measure.restrict_pi_pi (fun _ : Fin n => (volume : Measure ℝ))
    (fun _ : Fin n => Ioo (0 : ℝ) a)).symm

/-- info: 'MAIS.CubeScaling.signedCube_squared_sublevel_scale' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms signedCube_squared_sublevel_scale
/-- info: 'MAIS.CubeScaling.positiveCube_squared_sublevel_scale' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms positiveCube_squared_sublevel_scale

end MAIS.CubeScaling
end
end
-- ==================== end module O7.CubeScaling ====================

-- ==================== begin module O7.EuclideanCubeBounds (formalization/O7/EuclideanCubeBounds.lean) ====================
section

/-! Explicit coordinate-cube sandwiches for original-entry Euclidean balls.
The norm is written as sqrt(sum of entry squares), rather than relying on
the default sup norm on Lean function spaces. -/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory
open scoped BigOperators

namespace MAIS.EuclideanCubeBounds

def coordinateCube (n : ℕ) (R : ℝ) : Set (Fin n → ℝ) :=
  Set.univ.pi (fun _ : Fin n => Ioo (-R) R)

def euclideanBall (n : ℕ) (R : ℝ) : Set (Fin n → ℝ) :=
  {x | Real.sqrt (∑ i, (x i) ^ 2) < R}

theorem coordinateCube_subset_euclideanBall (n : ℕ) {R : ℝ} (hR : 0 < R) :
    coordinateCube n (R / (n + 1 : ℝ)) ⊆ euclideanBall n R := by
  intro x hx
  have hx' : ∀ i : Fin n, x i ∈ Ioo (-(R / (n + 1 : ℝ))) (R / (n + 1 : ℝ)) := by
    simpa only [coordinateCube, Set.mem_pi, Set.mem_univ, forall_true_left] using hx
  let s : ℝ := R / (n + 1 : ℝ)
  have hden : 0 < (n + 1 : ℝ) := by positivity
  have hs : 0 < s := div_pos hR hden
  have hxi : ∀ i : Fin n, (x i) ^ 2 ≤ s ^ 2 := by
    intro i
    have h := (sq_le_sq₀ (abs_nonneg (x i)) hs.le).mpr (abs_lt.mpr (hx' i)).le
    simpa only [sq_abs] using h
  have hsum : (∑ i, (x i) ^ 2) ≤ (n : ℝ) * s ^ 2 := by
    calc
      (∑ i, (x i) ^ 2) ≤ ∑ _i : Fin n, s ^ 2 :=
        Finset.sum_le_sum (fun i _ => hxi i)
      _ = (n : ℝ) * s ^ 2 := by simp
  have hn : (n : ℝ) < (n + 1 : ℝ) ^ 2 := by
    nlinarith [Nat.cast_nonneg (α := ℝ) n]
  have hsR : s * (n + 1 : ℝ) = R := by
    exact div_mul_cancel₀ R hden.ne'
  have hsmall : (n : ℝ) * s ^ 2 < R ^ 2 := by
    calc
      (n : ℝ) * s ^ 2 < (n + 1 : ℝ) ^ 2 * s ^ 2 :=
        mul_lt_mul_of_pos_right hn (sq_pos_of_pos hs)
      _ = R ^ 2 := by rw [← hsR]; ring
  exact (Real.sqrt_lt' hR).mpr (hsum.trans_lt hsmall)

theorem euclideanBall_subset_coordinateCube (n : ℕ) {R : ℝ} (hR : 0 < R) :
    euclideanBall n R ⊆ coordinateCube n R := by
  intro x hx
  have hsum : (∑ i, (x i) ^ 2) < R ^ 2 := (Real.sqrt_lt' hR).mp hx
  have hcoord : ∀ i : Fin n, x i ∈ Ioo (-R) R := by
    intro i
    have hsqi : (x i) ^ 2 < R ^ 2 :=
      (Finset.single_le_sum (fun j _ => sq_nonneg (x j)) (Finset.mem_univ i)).trans_lt hsum
    have habs : |x i| < R :=
      (sq_lt_sq₀ (abs_nonneg (x i)) hR.le).mp (by simpa only [sq_abs] using hsqi)
    exact abs_lt.mp habs
  simpa only [coordinateCube, Set.mem_pi, Set.mem_univ, forall_true_left] using hcoord

theorem measurable_coordinateCube (n : ℕ) (R : ℝ) :
    MeasurableSet (coordinateCube n R) :=
  MeasurableSet.univ_pi (fun _ => measurableSet_Ioo)

theorem measurable_euclideanBall (n : ℕ) (R : ℝ) :
    MeasurableSet (euclideanBall n R) := by
  have h : Measurable (fun x : Fin n → ℝ => Real.sqrt (∑ i, (x i) ^ 2)) := by fun_prop
  exact h measurableSet_Iio

end MAIS.EuclideanCubeBounds
end
end
-- ==================== end module O7.EuclideanCubeBounds ====================

-- ==================== begin module O7.LossTransfer (formalization/O7/LossTransfer.lean) ====================
section

/-!
Actual-measure invariance of the radius-first power/log pair under local
comparison of centered losses and positive prior densities.

The gauge estimates for rescaling epsilon are imported from the existing O77
development. The new theorems prove their own sublevel-set inclusions, measure
inequalities, and all-small-radius quantifiers. No exponent is assigned by a
formula in the definition of the measured predicate.
-/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory
open scoped ENNReal Topology

namespace MAIS.AnalyticTransfer

def bandMass {E : Type*} [MeasurableSpace E] (mu : Measure E)
    (windows : ℝ → Set E) (f : E → ℝ) (w : E) (R eps : ℝ) : ℝ≥0∞ :=
  mu {x | x ∈ windows R ∧ |f x - f w| < eps}

def HasMeasuredBandPair {E : Type*} [MeasurableSpace E] (mu : Measure E)
    (windows : ℝ → Set E) (f : E → ℝ) (w : E) (lam : ℝ) (m : ℕ) : Prop :=
  O77.Transport0906.RadiusOrder (bandMass mu windows f w) lam m

/-- Local comparison of the literal centered loss differences preserves the
actual measured power and logarithmic multiplicity, at all small radii. -/
theorem pair_of_local_comparison {E : Type*} [MeasurableSpace E]
    {mu : Measure E} {windows : ℝ → Set E} {f g : E → ℝ} {w : E}
    {lam lo hi rho : ℝ} {m : ℕ}
    (hpair : HasMeasuredBandPair mu windows f w lam m)
    (hmon : Monotone windows) (hrho : 0 < rho)
    (hlo : 0 < lo) (hhi : 0 < hi)
    (hcompare : ∀ x ∈ windows rho,
      lo * |f x - f w| ≤ |g x - g w| ∧
      |g x - g w| ≤ hi * |f x - f w|) :
    HasMeasuredBandPair mu windows g w lam m := by
  rcases hpair with ⟨hlam, hm, r, hr, hsource⟩
  refine ⟨hlam, hm, min r rho, lt_min hr hrho, ?_⟩
  intro R hR hRsmall
  have hRr : R < r := hRsmall.trans_le (min_le_left _ _)
  have hRrho : R < rho := hRsmall.trans_le (min_le_right _ _)
  have hsrc := hsource R hR hRr
  have hinner : O77.Residual.EThetaZeroPowerLog
      (fun eps => bandMass mu windows f w R (eps / hi)) lam (m - 1) := by
    simpa only [one_div, div_eq_mul_inv, mul_comm, one_mul, mul_one] using
      O77.NormalForm0906.rescale_order hsrc (one_div_pos.mpr hhi)
  have houter : O77.Residual.EThetaZeroPowerLog
      (fun eps => bandMass mu windows f w R (eps / lo)) lam (m - 1) := by
    simpa only [one_div, div_eq_mul_inv, mul_comm, one_mul, mul_one] using
      O77.NormalForm0906.rescale_order hsrc (one_div_pos.mpr hlo)
  apply O77.Transport0906.order_of_two_window_bounds
    hinner houter zero_lt_one zero_lt_one
  intro eps _heps
  simp only [ENNReal.ofReal_one, one_mul]
  constructor
  · apply measure_mono
    rintro x ⟨hx, hband⟩
    refine ⟨hx, (hcompare x (hmon hRrho.le hx)).2.trans_lt ?_⟩
    have hh := (lt_div_iff₀ hhi).mp hband
    simpa only [mul_comm] using hh
  · apply measure_mono
    rintro x ⟨hx, hband⟩
    refine ⟨hx, (lt_div_iff₀ hlo).mpr ?_⟩
    have hh := (hcompare x (hmon hRrho.le hx)).1.trans_lt hband
    simpa only [mul_comm] using hh

/-- Local comparison is symmetric after inverting its positive constants. -/
theorem pair_iff_of_local_comparison {E : Type*} [MeasurableSpace E]
    {mu : Measure E} {windows : ℝ → Set E} {f g : E → ℝ} {w : E}
    {lam lo hi rho : ℝ} {m : ℕ}
    (hmon : Monotone windows) (hrho : 0 < rho)
    (hlo : 0 < lo) (hhi : 0 < hi)
    (hcompare : ∀ x ∈ windows rho,
      lo * |f x - f w| ≤ |g x - g w| ∧
      |g x - g w| ≤ hi * |f x - f w|) :
    HasMeasuredBandPair mu windows f w lam m ↔
      HasMeasuredBandPair mu windows g w lam m := by
  constructor
  · exact fun hp => pair_of_local_comparison hp hmon hrho hlo hhi hcompare
  · intro hp
    apply pair_of_local_comparison hp hmon hrho
      (one_div_pos.mpr hhi) (one_div_pos.mpr hlo)
    intro x hx
    have hc := hcompare x hx
    constructor
    · have hh := (div_le_iff₀ hhi).mpr (by simpa only [mul_comm] using hc.2)
      simpa only [one_div, div_eq_mul_inv, mul_comm, one_mul, mul_one] using hh
    · have hh := (le_div_iff₀ hlo).mpr (by simpa only [mul_comm] using hc.1)
      simpa only [one_div, div_eq_mul_inv, mul_comm, one_mul, mul_one] using hh

/-- On a measurable band, a positive bounded prior gives literal measure
bounds by its lower and upper densities. -/
theorem withDensity_band_bounds {E : Type*} [MeasurableSpace E]
    {mu : Measure E} {windows : ℝ → Set E} {f : E → ℝ} {w : E}
    {phi : E → ℝ≥0∞} {lo hi rho R eps : ℝ}
    (hmon : Monotone windows) (hRrho : R ≤ rho)
    (hband : MeasurableSet {x | x ∈ windows R ∧ |f x - f w| < eps})
    (hphi : ∀ x ∈ windows rho,
      ENNReal.ofReal lo ≤ phi x ∧ phi x ≤ ENNReal.ofReal hi) :
    ENNReal.ofReal lo * bandMass mu windows f w R eps ≤
      bandMass (mu.withDensity phi) windows f w R eps ∧
    bandMass (mu.withDensity phi) windows f w R eps ≤
      ENNReal.ofReal hi * bandMass mu windows f w R eps := by
  unfold bandMass
  rw [withDensity_apply phi hband]
  constructor
  · rw [← setLIntegral_const]
    exact setLIntegral_mono' hband (fun x hx => (hphi x (hmon hRrho hx.1)).1)
  · rw [← setLIntegral_const]
    exact setLIntegral_mono' hband (fun x hx => (hphi x (hmon hRrho hx.1)).2)

/-- Positive bounded priors preserve both the exponent and logarithmic
multiplicity on every sufficiently small ball/window. -/
theorem pair_withDensity_of_local_bounds {E : Type*} [MeasurableSpace E]
    {mu : Measure E} {windows : ℝ → Set E} {f : E → ℝ} {w : E}
    {phi : E → ℝ≥0∞} {lam lo hi rho : ℝ} {m : ℕ}
    (hpair : HasMeasuredBandPair mu windows f w lam m)
    (hmon : Monotone windows) (hrho : 0 < rho)
    (hlo : 0 < lo) (hhi : 0 < hi)
    (hbands : ∀ R eps,
      MeasurableSet {x | x ∈ windows R ∧ |f x - f w| < eps})
    (hphi : ∀ x ∈ windows rho,
      ENNReal.ofReal lo ≤ phi x ∧ phi x ≤ ENNReal.ofReal hi) :
    HasMeasuredBandPair (mu.withDensity phi) windows f w lam m := by
  rcases hpair with ⟨hlam, hm, r, hr, hsource⟩
  refine ⟨hlam, hm, min r rho, lt_min hr hrho, ?_⟩
  intro R hR hRsmall
  have hRr := hRsmall.trans_le (min_le_left r rho)
  have hRrho := hRsmall.trans_le (min_le_right r rho)
  have hsrc := hsource R hR hRr
  apply O77.Transport0906.order_of_two_window_bounds hsrc hsrc hlo hhi
  intro eps _heps
  exact withDensity_band_bounds hmon hRrho.le (hbands R eps) hphi

end MAIS.AnalyticTransfer
end
end
-- ==================== end module O7.LossTransfer ====================

-- ==================== begin module O7.NativeLossTransfer (formalization/O7/NativeLossTransfer.lean) ====================
section

/-!
Continuous positive loss units and priors for the actual O77 matrix-entry
volumes. These are measured analytic consequences of the existing exact-fit
pair theorem. They preserve both lambda and the logarithmic multiplicity.
-/

set_option autoImplicit false
noncomputable section

open Set Filter MeasureTheory
open scoped ENNReal Topology

namespace MAIS.AnalyticTransfer

/-- Multiplication by a locally bounded positive unit preserves the actual
band pair at a zero of the original loss. This need not hold at a saddle
with positive loss, because subtracting the new central value adds terms. -/
theorem pair_iff_of_positive_unit_bounds {E : Type*} [MeasurableSpace E]
    {mu : Measure E} {windows : ℝ → Set E} {f unit : E → ℝ} {w : E}
    {lam lo hi rho : ℝ} {m : ℕ}
    (hzero : f w = 0) (hmon : Monotone windows) (hrho : 0 < rho)
    (hlo : 0 < lo) (hhi : 0 < hi)
    (hunit : ∀ x ∈ windows rho, lo ≤ unit x ∧ unit x ≤ hi) :
    HasMeasuredBandPair mu windows f w lam m ↔
      HasMeasuredBandPair mu windows (fun x => unit x * f x) w lam m := by
  apply pair_iff_of_local_comparison hmon hrho hlo hhi
  intro x hx
  have hu := hunit x hx
  have hupos : 0 < unit x := hlo.trans_le hu.1
  simp only [hzero, mul_zero, sub_zero, abs_mul, abs_of_pos hupos]
  exact ⟨mul_le_mul_of_nonneg_right hu.1 (abs_nonneg _),
    mul_le_mul_of_nonneg_right hu.2 (abs_nonneg _)⟩

open O77.Native
open O77.Reconstruction0905 (RM)

local instance parametersBorelSpace (I O H : ℕ) :
    BorelSpace (Parameters I O H) :=
  O77.Coordinates0906.matrix_prod_borelSpace H I
    (O77.Coordinates0906.matrix_borelSpace O H)

lemma entryBall_monotone {I O H : ℕ} (w : Parameters I O H) :
    Monotone (entryBall w) := by
  intro a b hab x hx
  exact hx.trans_le hab

/-- Continuity and positivity at the center supply explicit positive bounds
on a genuine entrywise Euclidean ball. -/
theorem exists_entryBall_positive_bounds {I O H : ℕ}
    {unit : Parameters I O H → ℝ} {w : Parameters I O H}
    (hcont : ContinuousAt unit w) (hpos : 0 < unit w) :
    ∃ rho : ℝ, 0 < rho ∧ ∀ x ∈ entryBall w rho,
      unit w / 2 ≤ unit x ∧ unit x ≤ 2 * unit w := by
  have hevent : ∀ᶠ x in nhds w,
      unit w / 2 < unit x ∧ unit x < 2 * unit w :=
    hcont.eventually (Ioo_mem_nhds (by linarith) (by linarith))
  have hinv : Tendsto (flat I O H).symm (nhds (flat I O H w)) (nhds w) := by
    simpa only [ContinuousLinearEquiv.symm_apply_apply] using
      (flat I O H).symm.continuous.tendsto (flat I O H w)
  obtain ⟨rho, hrho, hball⟩ :=
    Metric.eventually_nhds_iff.mp (hinv.eventually hevent)
  refine ⟨rho, hrho, ?_⟩
  intro x hx
  have hdist : dist (flat I O H x) (flat I O H w) < rho := by
    simpa only [entryBall_eq, mem_preimage, Metric.mem_ball] using hx
  have hb := hball hdist
  simpa only [ContinuousLinearEquiv.symm_apply_apply] using
    And.intro hb.1.le hb.2.le

lemma measurable_entryBand_of_continuous {I O H : ℕ}
    {f : Parameters I O H → ℝ} (hcont : Continuous f)
    (w : Parameters I O H) (R eps : ℝ) :
    MeasurableSet {x | x ∈ entryBall w R ∧ |f x - f w| < eps} := by
  have hball : MeasurableSet (entryBall w R) := by
    rw [entryBall_eq]
    exact measurableSet_ball.preimage (flat I O H).continuous.measurable
  exact hball.inter
    ((hcont.sub continuous_const).abs.measurable measurableSet_Iio)

/-- The unchanged native exact-fit pair also describes a loss multiplied by
any function continuous and strictly positive at that fit. -/
theorem native_pair_with_continuous_positive_unit {I O H : ℕ}
    {Phi : RM O I} {w : Parameters I O H} {lam : ℝ} {m : ℕ}
    {unit : Parameters I O H → ℝ}
    (hfit : w.2 * w.1 = Phi)
    (hcont : ContinuousAt unit w) (hpos : 0 < unit w)
    (hpair : HasLocalBandPair Phi w lam m) :
    HasMeasuredBandPair (entryMeasure I O H) (entryBall w)
      (fun x => unit x * loss Phi x) w lam m := by
  obtain ⟨rho, hrho, hbounds⟩ := exists_entryBall_positive_bounds hcont hpos
  have hzero : loss Phi w = 0 := by
    simp [loss, hfit, O77.Residual.frobeniusSq]
  exact (pair_iff_of_positive_unit_bounds hzero (entryBall_monotone w)
    hrho (half_pos hpos) (mul_pos (by norm_num) hpos) hbounds).mp hpair

/-- Every existing native pair is invariant under a continuous positive prior
density, evaluated with the literal withDensity measure on the same bands. -/
theorem native_pair_with_continuous_positive_prior {I O H : ℕ}
    {Phi : RM O I} {w : Parameters I O H} {lam : ℝ} {m : ℕ}
    {prior : Parameters I O H → ℝ}
    (hcont : ContinuousAt prior w) (hpos : 0 < prior w)
    (hpair : HasLocalBandPair Phi w lam m) :
    HasMeasuredBandPair
      ((entryMeasure I O H).withDensity (fun x => ENNReal.ofReal (prior x)))
      (entryBall w) (loss Phi) w lam m := by
  obtain ⟨rho, hrho, hbounds⟩ := exists_entryBall_positive_bounds hcont hpos
  apply pair_withDensity_of_local_bounds
    (lo := prior w / 2) (hi := 2 * prior w) (rho := rho)
    hpair (entryBall_monotone w)
    hrho (half_pos hpos) (mul_pos (by norm_num) hpos)
  · intro R eps
    exact measurable_entryBand_of_continuous (continuous_loss I O H Phi) w R eps
  · intro x hx
    exact ⟨ENNReal.ofReal_le_ofReal (hbounds x hx).1,
      ENNReal.ofReal_le_ofReal (hbounds x hx).2⟩

/-- A simultaneous positive unit and positive prior extension of every actual
exact-fit pair, with the already proved O77 numerical classification supplied.
No strict width or singular-spectrum hypothesis is added. -/
theorem exact_fit_pair_with_unit_and_prior {I O H : ℕ}
    {Phi : RM O I} {w : Parameters I O H}
    {unit prior : Parameters I O H → ℝ}
    (hfit : w.2 * w.1 = Phi)
    (hunit : Continuous unit) (hunitpos : 0 < unit w)
    (hprior : ContinuousAt prior w) (hpriorpos : 0 < prior w) :
    HasMeasuredBandPair
      ((entryMeasure I O H).withDensity (fun x => ENNReal.ofReal (prior x)))
      (entryBall w) (fun x => unit x * loss Phi x) w
      ((O77.candidateTwiceLambda I O H Phi.rank w.1.rank w.2.rank : ℝ) / 2)
      (O77.candidateMultiplicity I O H Phi.rank w.1.rank w.2.rank) := by
  have hp := O77.FiberClassification.exact_fit_pair_of_wishart
    O77.GlobalSpectralIntegral.realWishartEigenvalueFormula hfit
  have hunitpair := native_pair_with_continuous_positive_unit
    hfit hunit.continuousAt hunitpos hp
  obtain ⟨rho, hrho, hbounds⟩ :=
    exists_entryBall_positive_bounds hprior hpriorpos
  apply pair_withDensity_of_local_bounds
    (lo := prior w / 2) (hi := 2 * prior w) (rho := rho)
    hunitpair (entryBall_monotone w)
    hrho (half_pos hpriorpos) (mul_pos (by norm_num) hpriorpos)
  · intro R eps
    exact measurable_entryBand_of_continuous
      (hunit.mul (continuous_loss I O H Phi)) w R eps
  · intro x hx
    exact ⟨ENNReal.ofReal_le_ofReal (hbounds x hx).1,
      ENNReal.ofReal_le_ofReal (hbounds x hx).2⟩

end MAIS.AnalyticTransfer

/--
info: 'MAIS.AnalyticTransfer.pair_iff_of_local_comparison' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.AnalyticTransfer.pair_iff_of_local_comparison

/--
info: 'MAIS.AnalyticTransfer.exact_fit_pair_with_unit_and_prior' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.AnalyticTransfer.exact_fit_pair_with_unit_and_prior
end
end
-- ==================== end module O7.NativeLossTransfer ====================

-- ==================== begin module O7.ScalarOrigin (formalization/O7/ScalarOrigin.lean) ====================
section

/-!
An actual all-small-Euclidean-ball learning pair for the scalar product loss
at the all-zero point, in every positive depth. The proof uses exact cube
volumes, dilation, and Euclidean cube sandwiches. There is no postulated
asymptotic formula, and the norm is explicitly sqrt(sum of entry squares).
-/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory
open scoped ENNReal BigOperators

namespace MAIS.ScalarOrigin

open MAIS.CubeScaling
open MAIS.EuclideanCubeBounds
open MAIS.AnalyticTransfer
open O77.Residual

theorem signed_cube_squared_order (n : ℕ) {R : ℝ} (hR : 0 < R) :
    EThetaZeroPowerLog
      (fun eps => signedCubeAt (n + 1) R {x | (∏ i, x i) ^ 2 < eps})
      (1 / 2 : ℝ) n := by
  have hp : 0 < (R ^ (n + 1)) ^ 2 := sq_pos_of_pos (pow_pos hR _)
  have hscaled : EThetaZeroPowerLog
      (fun eps => signedCubeAt (n + 1) 1
        {x | (∏ i, x i) ^ 2 < eps / (R ^ (n + 1)) ^ 2}) (1 / 2 : ℝ) n := by
    simpa only [one_div, div_eq_mul_inv, mul_comm, one_mul, mul_one,
      MAIS.SignedCubeMeasure.signedCubeMeasure, signedCubeAt] using
      O77.NormalForm0906.rescale_order
        (MAIS.ScalarVolumeOrder.signed_unit_squared_order n) (one_div_pos.mpr hp)
  have hcoef : 0 < R ^ (n + 1) := pow_pos hR _
  apply O77.Transport0906.order_of_two_window_bounds hscaled hscaled hcoef hcoef
  intro eps _heps
  rw [signedCube_squared_sublevel_scale (n + 1) hR eps,
    ENNReal.ofReal_pow hR.le]
  exact ⟨le_rfl, le_rfl⟩

lemma signed_cube_sublevel_eq_volume (d : ℕ) (R eps : ℝ) :
    signedCubeAt d R {x | (∏ i, x i) ^ 2 < eps} =
      (volume : Measure (Fin d → ℝ))
        {x | x ∈ coordinateCube d R ∧ (∏ i, x i) ^ 2 < eps} := by
  have hset : MeasurableSet {x : Fin d → ℝ | (∏ i, x i) ^ 2 < eps} := by
    have hf : Measurable (fun x : Fin d → ℝ => (∏ i, x i) ^ 2) := by fun_prop
    exact hf measurableSet_Iio
  rw [signedCubeAt_eq_restrict, Measure.restrict_apply hset]
  congr 1
  ext x
  simp only [coordinateCube, mem_inter_iff, mem_ofPred_eq, and_comm]

/-- Explicit radius-first pair for squared product in the original scalar
entries, with Euclidean balls and ordinary product Lebesgue measure. -/
theorem euclidean_radius_order (n : ℕ) :
    O77.Transport0906.RadiusOrder
      (fun R eps => (volume : Measure (Fin (n + 1) → ℝ))
        {x | x ∈ euclideanBall (n + 1) R ∧ (∏ i, x i) ^ 2 < eps})
      (1 / 2 : ℝ) (n + 1) := by
  refine ⟨by norm_num, by omega, 1, zero_lt_one, ?_⟩
  intro R hR _hRsmall
  have hden : 0 < (n + 1 + 1 : ℝ) := by positivity
  have hinner := signed_cube_squared_order n (div_pos hR hden)
  have houter := signed_cube_squared_order n hR
  apply O77.Transport0906.order_of_two_window_bounds
    hinner houter zero_lt_one zero_lt_one
  intro eps _heps
  simp only [ENNReal.ofReal_one, one_mul]
  rw [signed_cube_sublevel_eq_volume, signed_cube_sublevel_eq_volume]
  constructor
  · apply measure_mono
    rintro x ⟨hx, he⟩
    refine ⟨coordinateCube_subset_euclideanBall (n + 1) hR ?_, he⟩
    simpa only [Nat.cast_add, Nat.cast_one] using hx
  · apply measure_mono
    rintro x ⟨hx, he⟩
    exact ⟨euclideanBall_subset_coordinateCube (n + 1) hR hx, he⟩

def squaredProduct (n : ℕ) (x : Fin (n + 1) → ℝ) : ℝ := (∏ i, x i) ^ 2

theorem squaredProduct_zero (n : ℕ) : squaredProduct n 0 = 0 := by
  simp [squaredProduct]

theorem squared_product_origin_pair (n : ℕ) :
    HasMeasuredBandPair (volume : Measure (Fin (n + 1) → ℝ))
      (euclideanBall (n + 1)) (squaredProduct n) 0 (1 / 2 : ℝ) (n + 1) := by
  have hband : bandMass (volume : Measure (Fin (n + 1) → ℝ))
      (euclideanBall (n + 1)) (squaredProduct n) 0 =
      (fun R eps => (volume : Measure (Fin (n + 1) → ℝ))
        {x | x ∈ euclideanBall (n + 1) R ∧ (∏ i, x i) ^ 2 < eps}) := by
    funext R eps
    unfold bandMass
    rw [squaredProduct_zero]
    congr 1
    ext x
    simp only [mem_ofPred_eq, squaredProduct, sub_zero,
      abs_of_nonneg (sq_nonneg (∏ i, x i))]
  change O77.Transport0906.RadiusOrder _ _ _
  rw [hband]
  exact euclidean_radius_order n

/-- The usual half-squared loss has pair (1/2, depth) at the all-zero
parameter in every positive scalar depth, on all small Euclidean balls. -/
theorem scalar_zero_target_origin_pair (n : ℕ) :
    HasMeasuredBandPair (volume : Measure (Fin (n + 1) → ℝ))
      (euclideanBall (n + 1))
      (fun x => (∏ i, x i) ^ 2 / 2) 0 (1 / 2 : ℝ) (n + 1) := by
  have hmon : Monotone (euclideanBall (n + 1)) := by
    intro a b hab x hx
    exact hx.trans_le hab
  have hbounds : ∀ x ∈ euclideanBall (n + 1) 1,
      (1 / 2 : ℝ) ≤ (fun _ : Fin (n + 1) → ℝ => (1 / 2 : ℝ)) x ∧
      (fun _ : Fin (n + 1) → ℝ => (1 / 2 : ℝ)) x ≤ (1 / 2 : ℝ) := by
    intro x _hx
    exact ⟨le_rfl, le_rfl⟩
  have h := (pair_iff_of_positive_unit_bounds (mu := volume)
    (squaredProduct_zero n) hmon zero_lt_one
    (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (0 : ℝ) < 1 / 2)
    hbounds).mp (squared_product_origin_pair n)
  simpa only [squaredProduct, div_eq_mul_inv, mul_comm, one_mul] using h

end MAIS.ScalarOrigin

/--
info: 'MAIS.ScalarOrigin.scalar_zero_target_origin_pair' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ScalarOrigin.scalar_zero_target_origin_pair
end
end
-- ==================== end module O7.ScalarOrigin ====================

-- ==================== begin module O7.ScalarSpectators (formalization/O7/ScalarSpectators.lean) ====================
section

/-!
Arbitrary-depth scalar zero-target points in grouped original coordinates:
there are n+1 vanishing coordinates and s nonzero coordinates. The measure
is ordinary product Lebesgue measure and the windows are explicitly the
Euclidean balls in all n+1+s entries. Spectators are integrated out before
the nonzero factors are restored as a continuous positive loss unit.
-/

set_option autoImplicit false
noncomputable section

open Set Filter MeasureTheory
open scoped BigOperators ENNReal Topology

namespace MAIS.ScalarSpectators

open MAIS.EuclideanCubeBounds MAIS.AnalyticTransfer O77.Residual

abbrev Space (n s : ℕ) := (Fin (n + 1) → ℝ) × (Fin s → ℝ)

def shiftedCube (s : ℕ) (w : Fin s → ℝ) (R : ℝ) : Set (Fin s → ℝ) :=
  Set.univ.pi (fun i => Ioo (w i - R) (w i + R))

def blockCube (n s : ℕ) (w : Fin s → ℝ) (R : ℝ) : Set (Space n s) :=
  coordinateCube (n + 1) R ×ˢ shiftedCube s w R

def blockBall (n s : ℕ) (w : Fin s → ℝ) (R : ℝ) : Set (Space n s) :=
  {x | Real.sqrt ((∑ i, (x.1 i) ^ 2) + ∑ j, (x.2 j - w j) ^ 2) < R}

def baseLoss (n s : ℕ) (x : Space n s) : ℝ := (∏ i, x.1 i) ^ 2

def scalarLoss (n s : ℕ) (x : Space n s) : ℝ :=
  ((∏ i, x.1 i) * ∏ j, x.2 j) ^ 2 / 2

lemma shiftedCube_volume (s : ℕ) (w : Fin s → ℝ) {R : ℝ} (hR : 0 < R) :
    volume (shiftedCube s w R) = ENNReal.ofReal ((2 * R) ^ s) := by
  rw [shiftedCube, Real.volume_pi_Ioo]
  have hdiff : ∀ i : Fin s, w i + R - (w i - R) = 2 * R := by intro i; ring
  simp only [hdiff, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  exact (ENNReal.ofReal_pow (by positivity : (0 : ℝ) ≤ 2 * R) s).symm

lemma block_cube_sublevel (n s : ℕ) (w : Fin s → ℝ) {R : ℝ} (hR : 0 < R) (eps : ℝ) :
    (volume : Measure (Space n s)) {x | x ∈ blockCube n s w R ∧ baseLoss n s x < eps} =
      MAIS.CubeScaling.signedCubeAt (n + 1) R {x | (∏ i, x i) ^ 2 < eps} *
        ENNReal.ofReal ((2 * R) ^ s) := by
  rw [MAIS.ScalarOrigin.signed_cube_sublevel_eq_volume]
  have hset : {x : Space n s | x ∈ blockCube n s w R ∧ baseLoss n s x < eps} =
      {x : Fin (n + 1) → ℝ | x ∈ coordinateCube (n + 1) R ∧ (∏ i, x i) ^ 2 < eps}
        ×ˢ shiftedCube s w R := by
    ext x
    simp only [blockCube, baseLoss, mem_ofPred_eq, mem_prod]
    tauto
  rw [hset, Measure.volume_eq_prod, Measure.prod_prod, shiftedCube_volume s w hR]

lemma block_cube_order (n s : ℕ) (w : Fin s → ℝ) {R : ℝ} (hR : 0 < R) :
    EThetaZeroPowerLog
      (fun eps => (volume : Measure (Space n s))
        {x | x ∈ blockCube n s w R ∧ baseLoss n s x < eps}) (1 / 2 : ℝ) n := by
  have hc : 0 < (2 * R) ^ s := pow_pos (by positivity) s
  apply O77.Transport0906.order_of_two_window_bounds
    (MAIS.ScalarOrigin.signed_cube_squared_order n hR)
    (MAIS.ScalarOrigin.signed_cube_squared_order n hR) hc hc
  intro eps _heps
  rw [block_cube_sublevel n s w hR, mul_comm]
  exact ⟨le_rfl, le_rfl⟩

lemma blockBall_subset_blockCube (n s : ℕ) (w : Fin s → ℝ) {R : ℝ} (hR : 0 < R) :
    blockBall n s w R ⊆ blockCube n s w R := by
  intro x hx
  have hs : (∑ i, (x.1 i) ^ 2) + ∑ j, (x.2 j - w j) ^ 2 < R ^ 2 :=
    (Real.sqrt_lt' hR).mp hx
  have hfirst : ∀ i : Fin (n + 1), x.1 i ∈ Ioo (-R) R := by
    intro i
    have hi := Finset.single_le_sum (fun j _ => sq_nonneg (x.1 j)) (Finset.mem_univ i)
    have hother : 0 ≤ ∑ j, (x.2 j - w j) ^ 2 := Finset.sum_nonneg (fun j _ => sq_nonneg _)
    have habs : |x.1 i| < R := (sq_lt_sq₀ (abs_nonneg _) hR.le).mp (by simpa only [sq_abs] using (show (x.1 i) ^ 2 < R ^ 2 by linarith))
    exact abs_lt.mp habs
  have hsecond : ∀ j : Fin s, x.2 j ∈ Ioo (w j - R) (w j + R) := by
    intro j
    have hj := Finset.single_le_sum (fun i _ => sq_nonneg (x.2 i - w i)) (Finset.mem_univ j)
    have hother : 0 ≤ ∑ i, (x.1 i) ^ 2 := Finset.sum_nonneg (fun i _ => sq_nonneg _)
    have habs : |x.2 j - w j| < R := (sq_lt_sq₀ (abs_nonneg _) hR.le).mp (by simpa only [sq_abs] using (show (x.2 j - w j) ^ 2 < R ^ 2 by linarith))
    have hh := abs_lt.mp habs
    constructor <;> linarith [hh.1, hh.2]
  constructor
  · simpa only [coordinateCube, Set.mem_pi, mem_univ, forall_true_left] using hfirst
  · simpa only [shiftedCube, Set.mem_pi, mem_univ, forall_true_left] using hsecond

lemma blockCube_subset_blockBall (n s : ℕ) (w : Fin s → ℝ) {R : ℝ} (hR : 0 < R) :
    blockCube n s w (R / (n + 1 + s + 1 : ℝ)) ⊆ blockBall n s w R := by
  intro x hx
  let r : ℝ := R / (n + 1 + s + 1 : ℝ)
  have hden : 0 < (n + 1 + s + 1 : ℝ) := by positivity
  have hr : 0 < r := div_pos hR hden
  have hleft : ∀ i : Fin (n + 1), (x.1 i) ^ 2 ≤ r ^ 2 := by
    intro i
    have hi : -r < x.1 i ∧ x.1 i < r := hx.1 i (mem_univ i)
    simpa only [sq_abs] using (sq_le_sq₀ (abs_nonneg _) hr.le).mpr (abs_lt.mpr hi).le
  have hright : ∀ j : Fin s, (x.2 j - w j) ^ 2 ≤ r ^ 2 := by
    intro j
    have hj := hx.2 j (mem_univ j)
    have hi : -r < x.2 j - w j ∧ x.2 j - w j < r := by constructor <;> linarith [hj.1, hj.2]
    simpa only [sq_abs] using (sq_le_sq₀ (abs_nonneg _) hr.le).mpr (abs_lt.mpr hi).le
  have hsum : (∑ i, (x.1 i) ^ 2) + ∑ j, (x.2 j - w j) ^ 2 ≤
      (n + 1 + s : ℝ) * r ^ 2 := by
    have h1 := Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => hleft i)
    have h2 := Finset.sum_le_sum (fun j (_ : j ∈ Finset.univ) => hright j)
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
      Nat.cast_add, Nat.cast_one] at h1 h2
    nlinarith
  have hsmall : (n + 1 + s : ℝ) < (n + 1 + s + 1 : ℝ) ^ 2 := by
    nlinarith [Nat.cast_nonneg (α := ℝ) n, Nat.cast_nonneg (α := ℝ) s]
  have hrR : r * (n + 1 + s + 1 : ℝ) = R := div_mul_cancel₀ R hden.ne'
  apply (Real.sqrt_lt' hR).mpr
  calc
    _ ≤ (n + 1 + s : ℝ) * r ^ 2 := hsum
    _ < (n + 1 + s + 1 : ℝ) ^ 2 * r ^ 2 := mul_lt_mul_of_pos_right hsmall (sq_pos_of_pos hr)
    _ = R ^ 2 := by rw [← hrR]; ring

lemma baseLoss_center (n s : ℕ) (w : Fin s → ℝ) : baseLoss n s (0, w) = 0 := by
  simp [baseLoss]

/-- Inactive coordinates contribute a strictly positive finite factor to
cube volumes and preserve the all-small-Euclidean-ball logarithmic pair. -/
theorem base_pair (n s : ℕ) (w : Fin s → ℝ) :
    HasMeasuredBandPair (volume : Measure (Space n s)) (blockBall n s w)
      (baseLoss n s) (0, w) (1 / 2 : ℝ) (n + 1) := by
  refine ⟨by norm_num, by omega, 1, zero_lt_one, ?_⟩
  intro R hR _hRsmall
  have hden : 0 < (n + 1 + s + 1 : ℝ) := by positivity
  have hinner := block_cube_order n s w (div_pos hR hden)
  have houter := block_cube_order n s w hR
  apply O77.Transport0906.order_of_two_window_bounds hinner houter zero_lt_one zero_lt_one
  intro eps _heps
  simp only [ENNReal.ofReal_one, one_mul]
  unfold bandMass
  rw [baseLoss_center]
  have hnonneg : ∀ x : Space n s, 0 ≤ baseLoss n s x := fun x => sq_nonneg _
  simp only [sub_zero, abs_of_nonneg (hnonneg _)]
  constructor
  · apply measure_mono
    rintro x ⟨hx, he⟩
    exact ⟨blockCube_subset_blockBall n s w hR hx, he⟩
  · apply measure_mono
    rintro x ⟨hx, he⟩
    exact ⟨blockBall_subset_blockCube n s w hR hx, he⟩

lemma blockBall_subset_metricBall (n s : ℕ) (w : Fin s → ℝ) {R : ℝ} (hR : 0 < R) :
    blockBall n s w R ⊆ Metric.ball (0, w) R := by
  intro x hx
  have hcube := blockBall_subset_blockCube n s w hR hx
  rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff, dist_pi_lt_iff hR, dist_pi_lt_iff hR]
  constructor
  · intro i
    have hi := hcube.1 i (mem_univ i)
    simpa only [Pi.zero_apply, Real.dist_eq, sub_zero] using abs_lt.mpr hi
  · intro j
    have hj := hcube.2 j (mem_univ j)
    rw [Real.dist_eq]
    apply abs_lt.mpr
    constructor <;> linarith [hj.1, hj.2]

lemma blockBall_monotone (n s : ℕ) (w : Fin s → ℝ) : Monotone (blockBall n s w) := by
  intro a b hab x hx
  exact hx.trans_le hab

/-- At any grouped scalar zero-target point with exactly n+1 zero factors
and arbitrary nonzero spectator factors, the actual learning pair is
(1/2,n+1). No asymptotic statement or Jacobian condition is assumed. -/
theorem scalar_zero_target_pair (n s : ℕ) (w : Fin s → ℝ) (hw : ∀ j, w j ≠ 0) :
    HasMeasuredBandPair (volume : Measure (Space n s)) (blockBall n s w)
      (scalarLoss n s) (0, w) (1 / 2 : ℝ) (n + 1) := by
  let unit : Space n s → ℝ := fun x => (∏ j, x.2 j) ^ 2 / 2
  have hcont : Continuous unit := by unfold unit; fun_prop
  have hpos : 0 < unit (0, w) := by
    apply div_pos
    · exact sq_pos_of_ne_zero (Finset.prod_ne_zero_iff.mpr (fun j _ => hw j))
    · norm_num
  have hevent : ∀ᶠ x in nhds (0, w), unit (0, w) / 2 < unit x ∧ unit x < 2 * unit (0, w) :=
    hcont.continuousAt.eventually (Ioo_mem_nhds (by linarith) (by linarith))
  obtain ⟨rho, hrho, hbounds⟩ := Metric.eventually_nhds_iff.mp hevent
  have hunit : ∀ x ∈ blockBall n s w rho,
      unit (0, w) / 2 ≤ unit x ∧ unit x ≤ 2 * unit (0, w) := by
    intro x hx
    exact let h := hbounds (blockBall_subset_metricBall n s w hrho hx); ⟨h.1.le, h.2.le⟩
  have hp := (pair_iff_of_positive_unit_bounds (mu := volume) (baseLoss_center n s w)
    (blockBall_monotone n s w) hrho (half_pos hpos) (mul_pos (by norm_num) hpos) hunit).mp
      (base_pair n s w)
  convert hp using 1
  funext x
  dsimp [unit, scalarLoss, baseLoss]
  ring

end MAIS.ScalarSpectators

/--
info: 'MAIS.ScalarSpectators.scalar_zero_target_pair' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ScalarSpectators.scalar_zero_target_pair
end
end
-- ==================== end module O7.ScalarSpectators ====================

-- ==================== begin module O7.EuclideanWindowTransfer (formalization/O7/EuclideanWindowTransfer.lean) ====================
section

/-! Actual measured radius-first pairs are invariant under uniformly
comparable ball systems. The scalar block specialization compares the
literal sqrt(sum of squared entry differences) balls with Pi/product
metric balls; no default sup norm is called Euclidean. -/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory
open scoped ENNReal

namespace MAIS.EuclideanWindowTransfer

open MAIS.AnalyticTransfer MAIS.ScalarSpectators

/-- Actual set/measure comparison for two radius systems, with all radii
fixed before the epsilon asymptotics. -/
theorem pair_iff_of_window_sandwich {E : Type*} [PseudoMetricSpace E] [MeasurableSpace E]
    (mu : Measure E) {f : E → ℝ} {w : E} {windows : ℝ → Set E}
    {lam L : ℝ} {m : ℕ} (hL : 1 ≤ L)
    (hwindow : ∀ R, 0 < R →
      Metric.ball w (R / L) ⊆ windows R ∧ windows R ⊆ Metric.ball w (L * R)) :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair mu windows f w lam m := by
  have hLp : 0 < L := zero_lt_one.trans_le hL
  constructor
  · intro hp
    apply O77.Transport0906.radiusOrder_of_fixed_distortion hp
      zero_lt_one zero_lt_one hL zero_lt_one
    intro R hR _hRsmall eps _heps
    simp only [ENNReal.ofReal_one, one_mul]
    constructor
    · apply measure_mono
      rintro x ⟨hx, he⟩
      exact ⟨(hwindow R hR).1 hx, he⟩
    · apply measure_mono
      rintro x ⟨hx, he⟩
      exact ⟨(hwindow R hR).2 hx, he⟩
  · intro hp
    apply O77.Transport0906.radiusOrder_of_fixed_distortion hp
      zero_lt_one zero_lt_one hL zero_lt_one
    intro R hR _hRsmall eps _heps
    simp only [ENNReal.ofReal_one, one_mul]
    have hinner := (hwindow (R / L) (div_pos hR hLp)).2
    have houter := (hwindow (L * R) (mul_pos hLp hR)).1
    have hcancel1 : L * (R / L) = R := mul_div_cancel₀ R hLp.ne'
    have hcancel2 : L * R / L = R := mul_div_cancel_left₀ R hLp.ne'
    rw [hcancel1] at hinner
    rw [hcancel2] at houter
    constructor
    · apply measure_mono
      rintro x ⟨hx, he⟩
      exact ⟨hinner hx, he⟩
    · apply measure_mono
      rintro x ⟨hx, he⟩
      exact ⟨houter hx, he⟩

def shiftFirst {n s : ℕ} (w x : Space n s) : Space n s := (x.1 - w.1, x.2)

def entryBall {n s : ℕ} (w : Space n s) (R : ℝ) : Set (Space n s) :=
  {x | Real.sqrt ((∑ i, (x.1 i - w.1 i) ^ 2) + ∑ j, (x.2 j - w.2 j) ^ 2) < R}

lemma dist_shiftFirst {n s : ℕ} (w x : Space n s) :
    dist (shiftFirst w x) (0, w.2) = dist x w := by
  change dist (x.1 - w.1, x.2) (0, w.2) = dist x w
  rw [Prod.dist_eq, Prod.dist_eq]
  simp only [dist_eq_norm, sub_zero]

lemma entryBall_iff_shift {n s : ℕ} (w x : Space n s) (R : ℝ) :
    x ∈ entryBall w R ↔ shiftFirst w x ∈ blockBall n s w.2 R := Iff.rfl

lemma blockCube_eq_metricBall (n s : ℕ) (w : Fin s → ℝ) {R : ℝ} (hR : 0 < R) :
    blockCube n s w R = Metric.ball (0, w) R := by
  ext x
  rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff, dist_pi_lt_iff hR, dist_pi_lt_iff hR]
  constructor
  · intro hx
    constructor
    · intro i
      have hi := hx.1 i (mem_univ i)
      simpa only [Pi.zero_apply, Real.dist_eq, sub_zero] using abs_lt.mpr hi
    · intro j
      have hj := hx.2 j (mem_univ j)
      rw [Real.dist_eq]
      apply abs_lt.mpr
      constructor <;> linarith [hj.1, hj.2]
  · rintro ⟨hfirst, hsecond⟩
    constructor
    · intro i _hi
      have hi := hfirst i
      simpa only [Set.mem_Ioo, Pi.zero_apply, Real.dist_eq, sub_zero] using abs_lt.mp hi
    · intro j _hj
      have hj : |x.2 j - w j| < R := by simpa only [Real.dist_eq] using hsecond j
      have hh := abs_lt.mp hj
      constructor <;> linarith [hh.1, hh.2]

lemma entryBall_sandwich {n s : ℕ} (w : Space n s) {R : ℝ} (hR : 0 < R) :
    Metric.ball w (R / (n + 1 + s + 1 : ℝ)) ⊆ entryBall w R ∧
      entryBall w R ⊆ Metric.ball w R := by
  have hden : 0 < (n + 1 + s + 1 : ℝ) := by positivity
  constructor
  · intro x hx
    apply (entryBall_iff_shift w x R).mpr
    apply blockCube_subset_blockBall n s w.2 hR
    rw [blockCube_eq_metricBall n s w.2 (div_pos hR hden)]
    change dist (shiftFirst w x) (0, w.2) < _
    rwa [dist_shiftFirst]
  · intro x hx
    have hball := blockBall_subset_metricBall n s w.2 hR ((entryBall_iff_shift w x R).mp hx)
    change dist x w < R
    rwa [Metric.mem_ball, dist_shiftFirst] at hball

/-- The literal scalar original-entry Euclidean balls have exactly the
same measured pair as the default Pi/product metric balls. -/
theorem pair_iff_entryBall {n s : ℕ} (w : Space n s) {f : Space n s → ℝ}
    {lam : ℝ} {m : ℕ} :
    HasMeasuredBandPair (volume : Measure (Space n s)) (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair (volume : Measure (Space n s)) (entryBall w) f w lam m := by
  have hL : 1 ≤ (n + 1 + s + 1 : ℝ) := by
    nlinarith [Nat.cast_nonneg (α := ℝ) n, Nat.cast_nonneg (α := ℝ) s]
  apply pair_iff_of_window_sandwich volume hL
  intro R hR
  refine ⟨(entryBall_sandwich w hR).1, ?_⟩
  exact (entryBall_sandwich w hR).2.trans (Metric.ball_subset_ball (le_mul_of_one_le_left hR.le hL))

end MAIS.EuclideanWindowTransfer

/--
info: 'MAIS.EuclideanWindowTransfer.pair_iff_entryBall' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.EuclideanWindowTransfer.pair_iff_entryBall
end
end
-- ==================== end module O7.EuclideanWindowTransfer ====================

-- ==================== begin module O7.LinearWindowTransfer (formalization/O7/LinearWindowTransfer.lean) ====================
section

/-! Actual radius-first band pairs are unchanged when the window norm is
transported by a continuous linear equivalence. In particular this bridges
the native matrix entry-Euclidean windows to the ambient product norm. -/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory
open scoped Matrix.Norms.Elementwise

namespace MAIS.LinearWindowTransfer

open MAIS.AnalyticTransfer MAIS.EuclideanWindowTransfer

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

lemma dist_apply_le (T : E ≃L[ℝ] F) (x w : E) :
    dist (T x) (T w) ≤ ‖T.toContinuousLinearMap‖ * dist x w := by
  rw [dist_eq_norm, dist_eq_norm, ← map_sub]
  exact T.toContinuousLinearMap.le_opNorm (x - w)

/-- The measure is arbitrary and is held fixed. Only the window changes;
the comparison constants are derived from the two operator norms. -/
theorem pair_iff_linear_windows [MeasurableSpace E] (mu : Measure E)
    (T : E ≃L[ℝ] F) (w : E) {f : E → ℝ} {lam : ℝ} {m : ℕ} :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair mu (fun R => T ⁻¹' Metric.ball (T w) R) f w lam m := by
  let L := max 1 (max ‖T.toContinuousLinearMap‖ ‖T.symm.toContinuousLinearMap‖)
  have hL : 1 ≤ L := le_max_left _ _
  have hLp : 0 < L := zero_lt_one.trans_le hL
  have hT : ‖T.toContinuousLinearMap‖ ≤ L :=
    (le_max_left _ _).trans (le_max_right _ _)
  have hS : ‖T.symm.toContinuousLinearMap‖ ≤ L :=
    (le_max_right _ _).trans (le_max_right _ _)
  apply pair_iff_of_window_sandwich mu hL
  intro R hR
  constructor
  · intro x hx
    change dist (T x) (T w) < R
    have hbound := (dist_apply_le T x w).trans (mul_le_mul_of_nonneg_right hT dist_nonneg)
    have hstrict := mul_lt_mul_of_pos_left hx hLp
    have hcancel : L * (R / L) = R := mul_div_cancel₀ R hLp.ne'
    rw [hcancel] at hstrict
    exact hbound.trans_lt hstrict
  · intro x hx
    change dist (T x) (T w) < R at hx
    change dist x w < L * R
    have hbound : dist x w ≤ L * dist (T x) (T w) := by
      have h := dist_apply_le T.symm (T x) (T w)
      simp only [ContinuousLinearEquiv.symm_apply_apply] at h
      exact h.trans (mul_le_mul_of_nonneg_right hS dist_nonneg)
    exact hbound.trans_lt (mul_lt_mul_of_pos_left hx hLp)

/-- An actual measure-preserving linear change of carrier transports all
small-ball bands. The source and target norm need not be isometric. -/
theorem pair_iff_measured_linear [MeasurableSpace E] [BorelSpace E]
    [MeasurableSpace F] [BorelSpace F] (mu : Measure E) (nu : Measure F)
    (T : E ≃L[ℝ] F) (hT : MeasurePreserving T mu nu) (w : E)
    {g : F → ℝ} (hg : Measurable g) {lam : ℝ} {m : ℕ} :
    HasMeasuredBandPair mu (Metric.ball w) (fun x => g (T x)) w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (T w)) g (T w) lam m := by
  have hp := pair_iff_linear_windows mu T w (f := fun x => g (T x))
    (lam := lam) (m := m)
  have heq : bandMass mu (fun R => T ⁻¹' Metric.ball (T w) R)
      (fun x => g (T x)) w = bandMass nu (Metric.ball (T w)) g (T w) := by
    funext R eps
    let S : Set F := {z | z ∈ Metric.ball (T w) R ∧ |g z - g (T w)| < eps}
    have hS : MeasurableSet S := measurableSet_ball.inter
      (measurableSet_lt ((hg.sub_const _).abs) measurable_const)
    have hm := hT.measure_preimage hS.nullMeasurableSet
    exact hm
  change O77.Transport0906.RadiusOrder _ _ _ ↔ O77.Transport0906.RadiusOrder _ _ _ at hp ⊢
  rw [heq] at hp
  exact hp

/-- The native matrix layout is a genuine continuous linear equivalence,
so its original-entry Euclidean bands agree with ambient metric bands. -/
theorem native_pair_iff_metric {I O H : ℕ} {Phi : O77.Reconstruction0905.RM O I}
    (w : O77.Native.Parameters I O H) {lam : ℝ} {m : ℕ} :
    HasMeasuredBandPair (O77.Native.entryMeasure I O H) (Metric.ball w)
      (O77.Native.loss Phi) w lam m ↔ O77.Native.HasLocalBandPair Phi w lam m := by
  have heq : O77.Native.entryBall w =
      (fun R => (O77.Native.flat I O H) ⁻¹' Metric.ball (O77.Native.flat I O H w) R) := by
    funext R
    exact O77.Native.entryBall_eq I O H w R
  have hp := pair_iff_linear_windows (O77.Native.entryMeasure I O H)
    (O77.Native.flat I O H) w (f := O77.Native.loss Phi) (lam := lam) (m := m)
  change HasMeasuredBandPair (O77.Native.entryMeasure I O H) (Metric.ball w)
      (O77.Native.loss Phi) w lam m ↔
    HasMeasuredBandPair (O77.Native.entryMeasure I O H) (O77.Native.entryBall w)
      (O77.Native.loss Phi) w lam m
  rw [heq]
  exact hp

end MAIS.LinearWindowTransfer

/--
info: 'MAIS.LinearWindowTransfer.native_pair_iff_metric' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearWindowTransfer.native_pair_iff_metric

/--
info: 'MAIS.LinearWindowTransfer.pair_iff_measured_linear' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.LinearWindowTransfer.pair_iff_measured_linear
end
end
-- ==================== end module O7.LinearWindowTransfer ====================

-- ==================== begin module O7.SpectatorTransfer (formalization/O7/SpectatorTransfer.lean) ====================
section

/-! Actual local band pairs are unchanged by spectator coordinates with
positive finite small-ball mass. Product set identities and product measure
integration are proved explicitly; the spectator mass is not assigned as a
learning exponent. -/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory
open scoped ENNReal

namespace MAIS.SpectatorTransfer

open MAIS.AnalyticTransfer

variable {E F : Type*} [PseudoMetricSpace E] [MeasurableSpace E]
  [PseudoMetricSpace F] [MeasurableSpace F]
  (mu : Measure E) (nu : Measure F) [SigmaFinite nu]

lemma bandMass_prod_fst (f : E → ℝ) (w : E) (v : F) (R eps : ℝ) :
    bandMass (mu.prod nu) (Metric.ball (w, v)) (fun p => f p.1) (w, v) R eps =
      bandMass mu (Metric.ball w) f w R eps * nu (Metric.ball v R) := by
  unfold bandMass
  have hset : {p : E × F | p ∈ Metric.ball (w, v) R ∧ |f p.1 - f w| < eps} =
      {x : E | x ∈ Metric.ball w R ∧ |f x - f w| < eps} ×ˢ Metric.ball v R := by
    ext p
    simp only [mem_ofPred_eq, mem_prod, Metric.mem_ball, Prod.dist_eq, max_lt_iff]
    tauto
  rw [hset, Measure.prod_prod]

/-- Literal spectator invariance under minimal geometric measure hypotheses.
The spectator measure is positive on open sets and finite on compact sets. -/
theorem pair_iff_spectators [ProperSpace F] [IsFiniteMeasureOnCompacts nu]
    [Measure.IsOpenPosMeasure nu] {f : E → ℝ} {w : E} {v : F} {lam : ℝ} {m : ℕ} :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair (mu.prod nu) (Metric.ball (w, v)) (fun p => f p.1) (w, v) lam m := by
  have hcoef : ∀ R, 0 < R → ∃ c : ℝ, 0 < c ∧ ENNReal.ofReal c = nu (Metric.ball v R) := by
    intro R hR
    have hpos := Metric.measure_ball_pos nu v hR
    have hfin : nu (Metric.ball v R) ≠ ⊤ := by
      apply ne_of_lt
      exact (measure_mono Metric.ball_subset_closedBall).trans_lt (isCompact_closedBall v R).measure_lt_top
    refine ⟨(nu (Metric.ball v R)).toReal, ENNReal.toReal_pos hpos.ne' hfin, ?_⟩
    exact ENNReal.ofReal_toReal hfin
  constructor
  · rintro ⟨hlam, hm, rho, hrho, hp⟩
    refine ⟨hlam, hm, rho, hrho, ?_⟩
    intro R hR hsmall
    obtain ⟨c, hc, heq⟩ := hcoef R hR
    apply O77.Transport0906.order_of_two_window_bounds (hp R hR hsmall) (hp R hR hsmall) hc hc
    intro eps _heps
    rw [bandMass_prod_fst, ← heq, mul_comm]
    exact ⟨le_rfl, le_rfl⟩
  · rintro ⟨hlam, hm, rho, hrho, hp⟩
    refine ⟨hlam, hm, rho, hrho, ?_⟩
    intro R hR hsmall
    obtain ⟨c, hc, heq⟩ := hcoef R hR
    have hinv : 0 < 1 / c := one_div_pos.mpr hc
    apply O77.Transport0906.order_of_two_window_bounds (hp R hR hsmall) (hp R hR hsmall) hinv hinv
    intro eps _heps
    rw [bandMass_prod_fst, ← heq]
    have hcancel : ENNReal.ofReal (1 / c) * ENNReal.ofReal c = 1 := by
      rw [← ENNReal.ofReal_mul hinv.le]
      simp only [one_div_mul_cancel hc.ne', ENNReal.ofReal_one]
    rw [mul_comm (bandMass mu _ _ _ _ _), ← mul_assoc, hcancel, one_mul]
    exact ⟨le_rfl, le_rfl⟩

end MAIS.SpectatorTransfer

/--
info: 'MAIS.SpectatorTransfer.pair_iff_spectators' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.SpectatorTransfer.pair_iff_spectators
end
end
-- ==================== end module O7.SpectatorTransfer ====================

-- ==================== begin module O7.ContinuousPriorTransfer (formalization/O7/ContinuousPriorTransfer.lean) ====================
section

/-! Actual two-way invariance of measured local learning pairs under a
continuous prior density that is positive at the center. -/

set_option autoImplicit false
noncomputable section

open Set Filter MeasureTheory
open scoped ENNReal Topology

namespace MAIS.ContinuousPriorTransfer

open MAIS.AnalyticTransfer

/-- Both implications follow from the actual withDensity measure bounds;
no reciprocal-density identity or probability normalization is assumed. -/
theorem pair_iff_withDensity_of_local_bounds {E : Type*} [MeasurableSpace E]
    {mu : Measure E} {windows : ℝ → Set E} {f : E → ℝ} {w : E}
    {phi : E → ℝ≥0∞} {lam lo hi rho : ℝ} {m : ℕ}
    (hmon : Monotone windows) (hrho : 0 < rho) (hlo : 0 < lo) (hhi : 0 < hi)
    (hbands : ∀ R eps, MeasurableSet {x | x ∈ windows R ∧ |f x - f w| < eps})
    (hphi : ∀ x ∈ windows rho,
      ENNReal.ofReal lo ≤ phi x ∧ phi x ≤ ENNReal.ofReal hi) :
    HasMeasuredBandPair mu windows f w lam m ↔
      HasMeasuredBandPair (mu.withDensity phi) windows f w lam m := by
  constructor
  · intro hp
    exact pair_withDensity_of_local_bounds hp hmon hrho hlo hhi hbands hphi
  · rintro ⟨hlam, hm, r, hr, hsource⟩
    refine ⟨hlam, hm, min r rho, lt_min hr hrho, ?_⟩
    intro R hR hRsmall
    have hRr := hRsmall.trans_le (min_le_left r rho)
    have hRrho := hRsmall.trans_le (min_le_right r rho)
    have hsrc := hsource R hR hRr
    apply O77.Transport0906.order_of_two_window_bounds hsrc hsrc
      (one_div_pos.mpr hhi) (one_div_pos.mpr hlo)
    intro eps _heps
    have hb := withDensity_band_bounds (mu := mu) hmon hRrho.le (hbands R eps) hphi
    have hcancel (a : ℝ) (ha : 0 < a) :
        ENNReal.ofReal (1 / a) * ENNReal.ofReal a = 1 := by
      rw [← ENNReal.ofReal_mul (one_div_pos.mpr ha).le]
      have hid : 1 / a * a = 1 := by field_simp
      rw [hid, ENNReal.ofReal_one]
    constructor
    · calc
        ENNReal.ofReal (1 / hi) * bandMass (mu.withDensity phi) windows f w R eps ≤
            ENNReal.ofReal (1 / hi) *
              (ENNReal.ofReal hi * bandMass mu windows f w R eps) :=
            mul_le_mul_of_nonneg_left hb.2 (by positivity)
        _ = bandMass mu windows f w R eps := by rw [← mul_assoc, hcancel hi hhi, one_mul]
    · calc
        bandMass mu windows f w R eps = ENNReal.ofReal (1 / lo) *
            (ENNReal.ofReal lo * bandMass mu windows f w R eps) := by
          rw [← mul_assoc, hcancel lo hlo, one_mul]
        _ ≤ ENNReal.ofReal (1 / lo) * bandMass (mu.withDensity phi) windows f w R eps :=
          mul_le_mul_of_nonneg_left hb.1 (by positivity)

/-- A prior only needs to be continuous and positive at the chosen center.
The loss is any measurable real-valued function, at any loss level. -/
theorem pair_iff_continuous_positive_prior {E : Type*} [PseudoMetricSpace E]
    [MeasurableSpace E] [BorelSpace E] (mu : Measure E)
    {f prior : E → ℝ} {w : E} {lam : ℝ} {m : ℕ}
    (hf : Measurable f) (hprior : ContinuousAt prior w) (hpos : 0 < prior w) :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair (mu.withDensity (fun x => ENNReal.ofReal (prior x)))
        (Metric.ball w) f w lam m := by
  have hnear : ∀ᶠ x in nhds w, prior w / 2 < prior x ∧ prior x < 2 * prior w :=
    hprior.eventually (Ioo_mem_nhds (by linarith) (by linarith))
  obtain ⟨rho, hrho, hb⟩ := Metric.mem_nhds_iff.mp hnear
  apply pair_iff_withDensity_of_local_bounds
    (lo := prior w / 2) (hi := 2 * prior w) (rho := rho)
    (fun _ _ h => Metric.ball_subset_ball h) hrho (half_pos hpos) (by positivity)
  · intro R eps
    exact measurableSet_ball.inter
      (measurableSet_lt ((hf.sub_const _).abs) measurable_const)
  · intro x hx
    exact ⟨ENNReal.ofReal_le_ofReal (hb hx).1.le,
      ENNReal.ofReal_le_ofReal (hb hx).2.le⟩

/-- Positive priors preserve the actual pair for any linearly transported
Euclidean window system, including original-entry balls. -/
theorem pair_iff_positive_prior_linear_windows {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] (mu : Measure E) (T : E ≃L[ℝ] F)
    {f prior : E → ℝ} {w : E} {lam : ℝ} {m : ℕ}
    (hf : Measurable f) (hprior : ContinuousAt prior w) (hpos : 0 < prior w) :
    HasMeasuredBandPair mu (fun R => T ⁻¹' Metric.ball (T w) R) f w lam m ↔
      HasMeasuredBandPair (mu.withDensity (fun x => ENNReal.ofReal (prior x)))
        (fun R => T ⁻¹' Metric.ball (T w) R) f w lam m := by
  exact (MAIS.LinearWindowTransfer.pair_iff_linear_windows mu T w).symm.trans
    ((pair_iff_continuous_positive_prior mu hf hprior hpos).trans
      (MAIS.LinearWindowTransfer.pair_iff_linear_windows
        (mu.withDensity (fun x => ENNReal.ofReal (prior x))) T w))

end MAIS.ContinuousPriorTransfer

