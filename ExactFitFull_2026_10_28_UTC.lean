-- ==================== begin module O7.Run2GeometricPositiveSplit (formalization/O7/Run2GeometricPositiveSplit.lean) ====================
section

/-! Actual fixed-target fiber codimension for a genuine full-span/reduced
matrix-chain split. The retained kernel contains the actual reduced gauge
complement by a constructed embedding; no dimension inequality is an input. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
noncomputable section
open Set
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2GeometricPositiveSplit
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.Run2PositiveEndpointRegular MAIS.Run2PositiveRegularChart MAIS.Run2PositiveNetworkLoss
open MAIS.Run2ParameterRetainingLinear MAIS.Run2GeometricCodimCharts
open MAIS.Run2GeometricZeroFiber MAIS.Run2GeometricCodimension
open MAIS.Run2GeometricAnalyticFiber MAIS.Run2GeometricNormalSuspension
open MAIS.Run2GeometricCharts
open MAIS.Run2GeometricRetainedInjection MAIS.Run2GeometricSpectatorSplit
variable {D : ℕ} {R : Type*} [Fintype R] [DecidableEq R]
  (κ : Fin (D+1) → Type*) [∀ v,Fintype (κ v)] [∀ v,DecidableEq (κ v)]

/-- Independently geometric fixed-target codimension, derived from the actual
ambient retained chart and the literal reduced product identity. -/
theorem geometricCodimNat_split_fiber_and_integral
    (hD : 0<D) (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _)=standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (Carrier (R:=R) κ) A).range N)
    (hsplit : ∀ x:N,pathMatrix (A+(x:Rep (Carrier (R:=R) κ)))
      0 (Fin.last D) (Fin.zero_le _) = Matrix.fromBlocks (1:Matrix R R ℝ)
        0 0 (normalResidual κ A N x))
    (C : Rep κ) (hC : C∈zeroFiber κ)
    (hblock : A=MAIS.Run2GeometricReducedGauge.splitChain κ C)
    (Nr : Submodule ℝ (Rep κ))
    (hNr : IsCompl (orbitDifferential κ C).range Nr)
    (eN : N ≃L[ℝ] Nr)
    (hR : ∀ n,normalResidual κ A N n=pathMatrix (C+(eN n:Rep κ))
      0 (Fin.last D) (Fin.zero_le _)) :
    geometricCodimNat
      {B : Rep (Carrier (R:=R) κ) | pathMatrix B 0 (Fin.last D) (Fin.zero_le _)=standardTarget} A =
        Module.finrank ℝ (RegularSpace R (κ (Fin.last D)) (κ 0)) + localCodimNat κ C ∧
      ∃ n : ℕ,localDimH
        {B : Rep (Carrier (R:=R) κ) | pathMatrix B 0 (Fin.last D) (Fin.zero_le _)=standardTarget}
        A=(n:ℝ≥0∞) := by
  let f := retainedInjection κ A hA H N hH hN C
  have hf : Function.Injective f := retainedInjection_injective κ A hA H N hH hN C hblock
  let eK := split f hf
  have hcod := codim_retainedFiber_and_integral κ (Q:=RegularSpace R (κ (Fin.last D)) (κ 0))
    C hC Nr hNr eK eN (normalResidual κ A N) hR
  obtain ⟨c,hsrc,hc0,htgt,hinv,U,hU,hU0,hUs,hcf⟩ :=
    MAIS.Run2PositiveAmbientFiber.exists_ambient_fiber_chart κ hD A hA H N hH hN hsplit
  have hci : AnalyticAt ℝ c.symm (c 0) := by rw [hc0];exact hinv
  have ht := geometricCodimNat_of_local_analytic_chart c 0 U hU hU0 hUs
    (fun y hy => (hcf y hy).1) hci
    (retainedFiber (Q:=RegularSpace R (κ (Fin.last D)) (κ 0)) (K:=Kernel
      (fderiv ℝ (regularMap κ A H N) 0)) κ (normalResidual κ A N))
    {B : Rep (Carrier (R:=R) κ) | pathMatrix B 0 (Fin.last D) (Fin.zero_le _)=standardTarget}
    (fun y hy => (hcf y hy).2)
  rw [hc0] at ht
  refine ⟨ht.trans hcod.1,?_⟩
  have hloc := localDimH_of_local_analytic_chart c 0 U hU hU0 hUs
    (fun y hy => (hcf y hy).1) hci
    (retainedFiber (Q:=RegularSpace R (κ (Fin.last D)) (κ 0)) (K:=Kernel
      (fderiv ℝ (regularMap κ A H N) 0)) κ (normalResidual κ A N))
    {B : Rep (Carrier (R:=R) κ) | pathMatrix B 0 (Fin.last D) (Fin.zero_le _)=standardTarget}
    (fun y hy => (hcf y hy).2)
  rw [hc0] at hloc
  obtain ⟨n,hn⟩ := hcod.2
  exact ⟨n,hloc.trans hn⟩

theorem geometricCodimNat_split_fiber
    (hD : 0<D) (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _)=standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (Carrier (R:=R) κ) A).ker)
    (hN : IsCompl (orbitDifferential (Carrier (R:=R) κ) A).range N)
    (hsplit : ∀ x:N,pathMatrix (A+(x:Rep (Carrier (R:=R) κ)))
      0 (Fin.last D) (Fin.zero_le _) = Matrix.fromBlocks (1:Matrix R R ℝ)
        0 0 (normalResidual κ A N x))
    (C : Rep κ) (hC : C∈zeroFiber κ)
    (hblock : A=MAIS.Run2GeometricReducedGauge.splitChain κ C)
    (Nr : Submodule ℝ (Rep κ))
    (hNr : IsCompl (orbitDifferential κ C).range Nr)
    (eN : N ≃L[ℝ] Nr)
    (hR : ∀ n,normalResidual κ A N n=pathMatrix (C+(eN n:Rep κ))
      0 (Fin.last D) (Fin.zero_le _)) :
    geometricCodimNat
      {B : Rep (Carrier (R:=R) κ) | pathMatrix B 0 (Fin.last D) (Fin.zero_le _)=standardTarget} A =
        Module.finrank ℝ (RegularSpace R (κ (Fin.last D)) (κ 0)) + localCodimNat κ C := by
  exact (geometricCodimNat_split_fiber_and_integral κ hD A hA H N hH hN hsplit C hC
    hblock Nr hNr eN hR).1
end MAIS.Run2GeometricPositiveSplit

/-- info: 'MAIS.Run2GeometricPositiveSplit.geometricCodimNat_split_fiber_and_integral' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricPositiveSplit.geometricCodimNat_split_fiber_and_integral

/-- info: 'MAIS.Run2GeometricPositiveSplit.geometricCodimNat_split_fiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricPositiveSplit.geometricCodimNat_split_fiber
end
end
