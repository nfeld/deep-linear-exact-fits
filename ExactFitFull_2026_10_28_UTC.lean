-- ==================== begin module O7.WeightedBoxWindows (formalization/O7/WeightedBoxWindows.lean) ====================
section

/-! Actual weighted coordinate boxes form a shrinking neighborhood basis.
Thus arbitrary positive integer weights preserve the literal radius-first
measured pair on finite real coordinate space, including the empty index. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology
namespace MAIS.WeightedBoxWindows
open MAIS.AnalyticTransfer MAIS.CofinalWindowTransfer

variable {ι : Type*} [Fintype ι]

def box (a : ι → ℕ) (w : ι → ℝ) (R : ℝ) : Set (ι → ℝ) :=
  {x | ∀ i, |x i-w i| < R^(a i)}

theorem box_neighborhood_windows (a : ι → ℕ) (ha : ∀ i,0<a i) (w : ι → ℝ) :
    NeighborhoodWindows (box a w) w := by
  constructor
  · intro R hR
    have hopen : IsOpen (box a w R) := by
      have hset : box a w R = ⋂ i, {x : ι → ℝ | |x i-w i| < R^(a i)} := by
        ext x
        simp [box]
      rw [hset]
      apply isOpen_iInter_of_finite
      intro i
      exact isOpen_lt ((continuous_apply i).sub continuous_const).abs continuous_const
    apply hopen.mem_nhds
    intro i
    simpa using pow_pos hR (a i)
  · intro V hV
    obtain ⟨delta,hdelta,hball⟩ := Metric.mem_nhds_iff.mp hV
    refine ⟨min 1 delta,lt_min zero_lt_one hdelta,?_⟩
    intro R hR hsmall x hx
    apply hball
    change dist x w < delta
    rw [dist_pi_lt_iff hdelta]
    intro i
    rw [Real.dist_eq]
    have hRone : R ≤ 1 := (hsmall.trans_le (min_le_left _ _)).le
    have hpow : R^(a i) ≤ R := by
      obtain ⟨k,hk⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt (ha i))
      rw [hk,pow_succ]
      calc
        R^k*R ≤ 1*R := mul_le_mul_of_nonneg_right (pow_le_one₀ hR.le hRone) hR.le
        _ = R := one_mul _
    exact ((hx i).trans_le hpow).trans (hsmall.trans_le (min_le_right _ _))

theorem pair_iff_metric (mu : Measure (ι → ℝ))
    (a : ι → ℕ) (ha : ∀ i,0<a i) (w : ι → ℝ)
    (f : (ι → ℝ) → ℝ) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (box a w) f w lam m ↔
      HasMeasuredBandPair mu (Metric.ball w) f w lam m :=
  pair_iff_neighborhood_windows mu (box_neighborhood_windows a ha w) (metric_ball_windows w)

end MAIS.WeightedBoxWindows

/--
info: 'MAIS.WeightedBoxWindows.box_neighborhood_windows' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedBoxWindows.box_neighborhood_windows

/--
info: 'MAIS.WeightedBoxWindows.pair_iff_metric' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedBoxWindows.pair_iff_metric
end
end
-- ==================== end module O7.WeightedBoxWindows ====================

-- ==================== begin module O7.WeightedHomogeneousBoxOrder (formalization/O7/WeightedHomogeneousBoxOrder.lean) ====================
section

/-! Actual homogeneous unit-box bands determine the full radius-first
ordinary-ball measured pair, using derived diagonal Haar scaling and an
actual shrinking neighborhood system. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.WeightedHomogeneousBoxOrder
open MAIS.WeightedDyadicShells MAIS.WeightedDyadicBandIdentity
open MAIS.AnalyticTransfer MAIS.CofinalWindowTransfer O77.Residual
variable {I:Type*} [Fintype I] [DecidableEq I]

/-- A generic proved positive value/argument rescaling equivalence for the
    actual existing power-log predicate. -/
theorem order_iff_scaled (V:ℝ→ℝ≥0∞) (c a:ℝ) (hc:0<c) (ha:0<a)
    (lam:ℝ) (n:ℕ) :
    EThetaZeroPowerLog V lam n ↔
      EThetaZeroPowerLog (fun eps=>ENNReal.ofReal c*V (a*eps)) lam n := by
  have hmul:∀ (T:ℝ→ℝ≥0∞) (b:ℝ),0<b→EThetaZeroPowerLog T lam n→
      EThetaZeroPowerLog (fun eps=>ENNReal.ofReal b*T eps) lam n:=by
    intro T b hb hp
    apply O77.Transport0906.order_of_two_window_bounds hp hp hb hb
    intro eps _
    exact ⟨le_rfl,le_rfl⟩
  constructor
  · intro hp
    exact hmul _ c hc (O77.NormalForm0906.rescale_order hp ha)
  · intro hp
    have hh:=hmul _ (1/c) (one_div_pos.mpr hc)
      (O77.NormalForm0906.rescale_order hp (one_div_pos.mpr ha))
    have he:(fun eps=>ENNReal.ofReal (1/c)*(ENNReal.ofReal c*V (a*((1/a)*eps))))=V:=by
      funext eps
      rw [← mul_assoc,← ENNReal.ofReal_mul (le_of_lt (one_div_pos.mpr hc))]
      simp [hc.ne',ha.ne']
    rw [he] at hh
    exact hh

def windows (W:I→ℕ) (R:ℝ) : Set (I→ℝ):=dilation W R '' box W 0

omit [DecidableEq I] in
theorem mem_windows (W:I→ℕ) {R:ℝ} (hR:0<R) (x:I→ℝ) :
    x∈windows W R ↔ ∀ i,|x i|≤R^(W i) := by
  rw [windows,box_image W R hR 0]
  simp only [Nat.zero_mul,pow_zero,mul_one,Set.mem_ofPred_eq]

omit [DecidableEq I] in
/-- The actual closed weighted boxes form a genuine neighborhood system;
    no linear relation between radius parameters is asserted. -/
theorem neighborhood_windows (W:I→ℕ) (hW:∀ i,0<W i) :
    NeighborhoodWindows (windows W) (0:I→ℝ) := by
  constructor
  · intro R hR
    apply Filter.mem_of_superset ((MAIS.WeightedBoxWindows.box_neighborhood_windows W hW 0).1 R hR)
    intro x hx
    apply (mem_windows W hR x).mpr
    intro i
    simpa only [Pi.zero_apply,sub_zero] using (hx i).le
  · intro U hU
    obtain ⟨delta,hd,hball⟩:=Metric.mem_nhds_iff.mp hU
    refine ⟨min 1 delta,lt_min zero_lt_one hd,?_⟩
    intro R hR hsmall x hx
    apply hball
    rw [Metric.mem_ball,dist_pi_lt_iff hd]
    intro i
    rw [Real.dist_eq,Pi.zero_apply,sub_zero]
    have hbound:|x i|≤R^(W i):=(mem_windows W hR x).mp hx i
    have hpow:R^(W i)≤R:=by
      exact pow_le_of_le_one hR.le ((hsmall.trans_le (min_le_left _ _)).le) (ne_of_gt (hW i))
    exact (hbound.trans hpow).trans_lt (hsmall.trans_le (min_le_right _ _))

/-- Actual homogeneous band scaling in every fixed positive weighted box. -/
theorem band_windows (mu:Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (W:I→ℕ) (d:ℕ) (f:(I→ℝ)→ℝ)
    (hhom:∀ r:ℝ,0<r→∀ x,f (dilation W r x)=r^d*f x)
    (R:ℝ) (hR:0<R) (eps:ℝ) :
    bandOn mu (windows W R) f eps=ENNReal.ofReal (R^(∑ i,W i))*
      bandOn mu (box W 0) f ((R^d)⁻¹*eps) := by
  have he:dilation W R '' {x|x∈box W 0 ∧ f x<eps/R^d}=
      {x|x∈windows W R ∧ f x<eps}:=by
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩
      refine ⟨⟨y,hy.1,rfl⟩,?_⟩
      rw [hhom R hR y]
      simpa only [mul_comm] using (lt_div_iff₀ (pow_pos hR d)).mp hy.2
    · rintro ⟨⟨y,hy,rfl⟩,hfy⟩
      refine ⟨y,⟨hy,?_⟩,rfl⟩
      apply (lt_div_iff₀ (pow_pos hR d)).mpr
      simpa only [hhom R hR y,mul_comm] using hfy
  unfold bandOn
  rw [← he,measure_dilation_image mu W R hR]
  rw [div_eq_mul_inv,mul_comm eps]

/-- Every fixed positive box has exactly the actual unit-box order. -/
theorem order_windows_iff (mu:Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (W:I→ℕ) (d:ℕ) (f:(I→ℝ)→ℝ)
    (hhom:∀ r:ℝ,0<r→∀ x,f (dilation W r x)=r^d*f x)
    (R:ℝ) (hR:0<R) (lam:ℝ) (n:ℕ) :
    EThetaZeroPowerLog (bandOn mu (windows W R) f) lam n ↔
      EThetaZeroPowerLog (bandOn mu (box W 0) f) lam n := by
  have he:bandOn mu (windows W R) f=fun eps=>ENNReal.ofReal (R^(∑ i,W i))*
      bandOn mu (box W 0) f ((R^d)⁻¹*eps):=by
    funext eps
    exact band_windows mu W d f hhom R hR eps
  rw [he]
  exact (order_iff_scaled _ _ _ (pow_pos hR _) (inv_pos.mpr (pow_pos hR d)) lam n).symm

/-- Full radius-first ordinary-ball pair iff actual fixed-unit-box order.
    The sign and multiplicity restrictions are the actual predicate's own. -/
theorem pair_iff_unit_box (mu:Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (W:I→ℕ) (hW:∀ i,0<W i) (d:ℕ) (f:(I→ℝ)→ℝ)
    (hhom:∀ r:ℝ,0<r→∀ x,f (dilation W r x)=r^d*f x)
    (hfnonneg:∀ x,0≤f x) (hfzero:f 0=0) (lam:ℝ) (m:ℕ) :
    HasMeasuredBandPair mu (Metric.ball 0) f 0 lam m ↔
      0 ≤ lam ∧ 1 ≤ m ∧ EThetaZeroPowerLog (bandOn mu (box W 0) f) lam (m-1) := by
  have hw:=pair_iff_neighborhood_windows mu (metric_ball_windows (0:I→ℝ))
    (neighborhood_windows W hW) (f:=f) (lam:=lam) (m:=m)
  rw [hw]
  have hmass:∀ R,bandMass mu (windows W) f 0 R=bandOn mu (windows W R) f:=by
    intro R
    funext eps
    unfold bandMass bandOn
    congr 1
    ext x
    simp only [Set.mem_ofPred_eq,hfzero,sub_zero,abs_of_nonneg (hfnonneg x)]
  change O77.Transport0906.RadiusOrder (bandMass mu (windows W) f 0) lam m ↔ _
  constructor
  · rintro ⟨hl,hm,rho,hrho,hp⟩
    refine ⟨hl,hm,?_⟩
    have he:=hp (rho/2) (half_pos hrho) (half_lt_self hrho)
    rw [hmass] at he
    exact (order_windows_iff mu W d f hhom _ (half_pos hrho) lam (m-1)).mp he
  · rintro ⟨hl,hm,hp⟩
    refine ⟨hl,hm,1,zero_lt_one,?_⟩
    intro R hR _
    rw [hmass]
    exact (order_windows_iff mu W d f hhom R hR lam (m-1)).mpr hp

end MAIS.WeightedHomogeneousBoxOrder
end

