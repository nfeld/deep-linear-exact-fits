-- ==================== begin module O7.ShiftedRadialMoment (formalization/O7/ShiftedRadialMoment.lean) ====================
section

/-! A fixed positive saturation mass and a fixed lower logarithmic cutoff
preserve the already computed actual radial moment order. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.ShiftedRadialMoment
open MAIS.WeightedRadialMoments MAIS.WeightedRadialOrder O77.Residual

def offsetModel (alpha beta D K S : ℝ) (n : ℕ) (eps : ℝ) : ℝ :=
  eps^alpha*(K+(moment (alpha-beta) n (-Real.log eps)-moment (alpha-beta) n S)/D)

theorem moment_mono {S T c : ℝ} (hS : 0≤S) (hST : S≤T) (n : ℕ) :
    moment c n S ≤ moment c n T := by
  have hn : 0≤ᵐ[volume.restrict (Ioc (0:ℝ) T)] (fun u:ℝ=>Real.exp (c*u)*u^n) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with u hu
    exact mul_nonneg (Real.exp_nonneg _) (pow_nonneg hu.1.le _)
  exact intervalIntegral.integral_mono_interval le_rfl hS hST hn (integrable c n 0 T)

/-- Eventual actual comparisons transfer the exact measured order. -/
theorem order_of_small_comparison {V W : ℝ→ℝ≥0∞} {lam lo hi eta : ℝ} {n : ℕ}
    (hp : EThetaZeroPowerLog V lam n) (hlo : 0<lo) (hhi : 0<hi) (heta : 0<eta)
    (hb : ∀ eps,0<eps→eps<eta→ENNReal.ofReal lo*V eps≤W eps ∧
      W eps≤ENNReal.ofReal hi*V eps) : EThetaZeroPowerLog W lam n := by
  obtain ⟨a,b,e,ha,hab,he,heExp,hp⟩ := hp
  let c := min (lo*a) (hi*b)
  let C := hi*b
  have hbpos : 0<b := ha.trans_le hab
  refine ⟨c,C,min e eta,lt_min (mul_pos hlo ha) (mul_pos hhi hbpos),min_le_right _ _,
    lt_min he heta,(min_le_left _ _).trans_lt heExp,?_⟩
  intro eps heps hsmall
  obtain ⟨hl,hu⟩ := hp eps heps (hsmall.trans_le (min_le_left _ _))
  obtain ⟨wl,wu⟩ := hb eps heps (hsmall.trans_le (min_le_right _ _))
  constructor
  · calc
      ENNReal.ofReal c*powerLogZero lam n eps ≤
          ENNReal.ofReal (lo*a)*powerLogZero lam n eps :=
        mul_le_mul' (ENNReal.ofReal_le_ofReal (min_le_left _ _)) le_rfl
      _ = ENNReal.ofReal lo*(ENNReal.ofReal a*powerLogZero lam n eps) := by
        rw [ENNReal.ofReal_mul hlo.le,mul_assoc]
      _ ≤ ENNReal.ofReal lo*V eps := mul_le_mul' le_rfl hl
      _ ≤ W eps := wl
  · calc
      W eps ≤ ENNReal.ofReal hi*V eps := wu
      _ ≤ ENNReal.ofReal hi*(ENNReal.ofReal b*powerLogZero lam n eps) := mul_le_mul' le_rfl hu
      _ = ENNReal.ofReal C*powerLogZero lam n eps := by
        rw [show C=hi*b from rfl,ENNReal.ofReal_mul hhi.le,mul_assoc]

/-- Fixed cutoff removal changes only the positive constant part of an
actual nonnegative finite moment. Consequently its model remains comparable
with the full moment, uniformly at every sufficiently small epsilon. -/
theorem offsetModel_bounds {alpha beta D K S : ℝ} (hD : 0<D) (hK : 0<K)
    (hS : 0≤S) (n : ℕ) :
    ∃ lo hi : ℝ,0<lo ∧ lo≤hi ∧ ∀ eps,0<eps→eps<Real.exp (-S)→
      lo*model alpha beta D 0 n eps≤offsetModel alpha beta D K S n eps ∧
      offsetModel alpha beta D K S n eps≤hi*model alpha beta D 0 n eps := by
  let M := moment (alpha-beta) n S
  let H := 1+M/D
  have hM : 0≤M := moment_nonneg _ n hS
  have hH : 0<H := by dsimp [H];positivity
  let lo := min 1 (K/H)
  let hi := max 1 (K/H)
  have hlo : 0<lo := lt_min zero_lt_one (div_pos hK hH)
  have hhi : 1≤hi := le_max_left _ _
  refine ⟨lo,hi,hlo,(min_le_left _ _).trans hhi,?_⟩
  intro eps heps hsmall
  have hlog := Real.log_lt_log heps hsmall
  rw [Real.log_exp] at hlog
  have hST : S≤ -Real.log eps := by linarith
  let X := (moment (alpha-beta) n (-Real.log eps)-M)/D
  have hX : 0≤X := div_nonneg (sub_nonneg.mpr (moment_mono hS hST n)) hD.le
  have hloH : lo*H≤K := by
    calc
      _ ≤ (K/H)*H := mul_le_mul_of_nonneg_right (min_le_right _ _) hH.le
      _ = K := div_mul_cancel₀ _ hH.ne'
  have hhiH : K≤hi*H := by
    calc
      _ = (K/H)*H := (div_mul_cancel₀ _ hH.ne').symm
      _ ≤ _ := mul_le_mul_of_nonneg_right (le_max_right _ _) hH.le
  have hloX : lo*X≤X := by
    simpa only [one_mul] using mul_le_mul_of_nonneg_right (min_le_left 1 (K/H)) hX
  have hhiX : X≤hi*X := by
    simpa only [one_mul] using mul_le_mul_of_nonneg_right hhi hX
  have hlow : lo*(H+X)≤K+X := by nlinarith
  have hupp : K+X≤hi*(H+X) := by nlinarith
  have hfactor : 0≤eps^alpha := Real.rpow_nonneg heps.le _
  have hm : model alpha beta D 0 n eps=eps^alpha*(H+X) := by
    unfold model
    simp only [zero_sub]
    dsimp [H,X]
    ring
  have hoff : offsetModel alpha beta D K S n eps=eps^alpha*(K+X) := rfl
  rw [hm,hoff]
  constructor
  · calc
      _ = eps^alpha*(lo*(H+X)) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hlow hfactor
  · calc
      _ ≤ eps^alpha*(hi*(H+X)) := mul_le_mul_of_nonneg_left hupp hfactor
      _ = _ := by ring

/-- The exact three branches survive an arbitrary fixed lower logarithmic
cutoff and an arbitrary positive saturation mass. -/
theorem offsetModel_trichotomy {alpha beta D K S : ℝ}
    (hD : 0<D) (hK : 0<K) (hS : 0≤S) (n : ℕ) :
    (beta<alpha→EThetaZeroPowerLog (fun eps=>ENNReal.ofReal
      (offsetModel alpha beta D K S n eps)) beta n) ∧
    (beta=alpha→EThetaZeroPowerLog (fun eps=>ENNReal.ofReal
      (offsetModel alpha beta D K S n eps)) alpha (n+1)) ∧
    (alpha<beta→EThetaZeroPowerLog (fun eps=>ENNReal.ofReal
      (offsetModel alpha beta D K S n eps)) alpha 0) := by
  obtain ⟨lo,hi,hlo,hlohi,hbounds⟩ := offsetModel_bounds hD hK hS n
  have htransfer : ∀ lam k,EThetaZeroPowerLog
      (fun eps=>ENNReal.ofReal (model alpha beta D 0 n eps)) lam k →
      EThetaZeroPowerLog (fun eps=>ENNReal.ofReal (offsetModel alpha beta D K S n eps)) lam k := by
    intro lam k hp
    apply order_of_small_comparison hp hlo (hlo.trans_le hlohi) (Real.exp_pos (-S))
    intro eps heps hsmall
    have hb := hbounds eps heps hsmall
    constructor
    · rw [← ENNReal.ofReal_mul hlo.le]
      exact ENNReal.ofReal_le_ofReal hb.1
    · rw [← ENNReal.ofReal_mul (hlo.trans_le hlohi).le]
      exact ENNReal.ofReal_le_ofReal hb.2
  obtain ⟨hlt,heq,hgt⟩ := model_trichotomy (alpha:=alpha) (beta:=beta) (L:=0) hD n
  exact ⟨fun h=>htransfer _ _ (hlt h),fun h=>htransfer _ _ (heq h),fun h=>htransfer _ _ (hgt h)⟩

end MAIS.ShiftedRadialMoment
end

/-- info: 'MAIS.ShiftedRadialMoment.moment_mono' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ShiftedRadialMoment.moment_mono

/-- info: 'MAIS.ShiftedRadialMoment.order_of_small_comparison' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ShiftedRadialMoment.order_of_small_comparison

/-- info: 'MAIS.ShiftedRadialMoment.offsetModel_bounds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ShiftedRadialMoment.offsetModel_bounds

/-- info: 'MAIS.ShiftedRadialMoment.offsetModel_trichotomy' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ShiftedRadialMoment.offsetModel_trichotomy
end
-- ==================== end module O7.ShiftedRadialMoment ====================

-- ==================== begin module O7.ClippedRadialModel (formalization/O7/ClippedRadialModel.lean) ====================
section

/-! Exact saturation-cutoff evaluation of the actual radial integral,
followed by the checked finite-moment order trichotomy. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.ClippedRadialModel
open MAIS.ClippedBandComparison MAIS.ClippedRadialGeometry
open MAIS.DyadicRadialComparison MAIS.WeightedRadialIntegral
open MAIS.WeightedRadialMoments MAIS.WeightedRadialOrder MAIS.ShiftedRadialMoment O77.Residual

def saturationConstant (A d : ℕ) (eta : ℝ) : ℝ :=
  1/((A:ℝ)*eta^((A:ℝ)/(d:ℝ)))

theorem saturationConstant_pos {A : ℕ} (hA : 0<A) (d : ℕ) {eta : ℝ} (heta : 0<eta) :
    0<saturationConstant A d eta := by
  unfold saturationConstant
  exact one_div_pos.mpr (mul_pos (by exact_mod_cast hA) (Real.rpow_pos_of_pos heta _))

theorem inner_mass_eq {A d : ℕ} (hd : 0<d) {eta eps : ℝ}
    (heta : 0<eta) (heps : 0<eps) :
    lowerRadius d eta eps^A/(A:ℝ)=
      eps^((A:ℝ)/(d:ℝ))*saturationConstant A d eta := by
  have hd0 : (d:ℝ)≠0 := by exact_mod_cast Nat.ne_zero_of_lt hd
  unfold lowerRadius saturationConstant
  rw [← Real.rpow_natCast,← Real.rpow_mul (div_pos heps heta).le]
  rw [show (1/(d:ℝ))*(A:ℝ)=(A:ℝ)/(d:ℝ) by ring,
    Real.div_rpow heps.le heta.le]
  ring

/-- The actual outer radius integral has exactly the finite logarithmic
moment between the two genuine cutoff coordinates. -/
theorem outer_integral_eq_tail {A d : ℕ} (hd : 0<d) {eta eps : ℝ}
    (heta : 0<eta) (heps : 0<eps) (beta : ℝ) (n : ℕ) :
    (∫ r in (lowerRadius d eta eps)..1,integrand (A:ℝ) (d:ℝ) beta n eps r)=
      eps^((A:ℝ)/(d:ℝ))/(d:ℝ)*
        (moment ((A:ℝ)/(d:ℝ)-beta) n (-Real.log eps)-
          moment ((A:ℝ)/(d:ℝ)-beta) n (-Real.log eta)) := by
  let D : ℝ := d
  have hD : 0<D := by dsimp [D];exact_mod_cast hd
  let low := lowerRadius d eta eps
  have hlow : 0<low := lowerRadius_pos heta heps d
  have hrpos : ∀ r∈uIcc low 1,0<r := by
    intro r hr
    exact lt_of_lt_of_le (lt_min hlow zero_lt_one) hr.1
  have hdlog : ∀ r∈uIcc low 1,HasDerivAt (logCoordinate D eps) (D/r) r := by
    intro r hr
    have h := (((hasDerivAt_id r).log (hrpos r hr).ne').const_mul D).sub_const (Real.log eps)
    convert! h using 1
    simp only [div_eq_mul_inv,one_mul,id_eq]
  have hc : ContinuousOn (fun r:ℝ=>D/r) (uIcc low 1) := by
    intro r hr
    exact (continuousAt_const.div continuousAt_id (hrpos r hr).ne').continuousWithinAt
  have hcv := intervalIntegral.integral_comp_mul_deriv hdlog hc
    (continuous_integrand ((A:ℝ)/D-beta) n)
  have hlowlog : logCoordinate D eps low= -Real.log eta := by
    unfold logCoordinate low lowerRadius
    rw [Real.log_rpow (div_pos heps heta),Real.log_div heps.ne' heta.ne']
    dsimp [D]
    field_simp
    ring
  have huplog : logCoordinate D eps 1= -Real.log eps := by simp [logCoordinate]
  rw [hlowlog,huplog] at hcv
  have hmoment : (∫ u in (-Real.log eta)..(-Real.log eps),
      Real.exp (((A:ℝ)/D-beta)*u)*u^n)=
      moment ((A:ℝ)/D-beta) n (-Real.log eps)-moment ((A:ℝ)/D-beta) n (-Real.log eta) := by
    exact (intervalIntegral.integral_interval_sub_left
      (integrable ((A:ℝ)/D-beta) n 0 (-Real.log eps))
      (integrable ((A:ℝ)/D-beta) n 0 (-Real.log eta))).symm
  calc
    _ = ∫ r in low..1,eps^((A:ℝ)/D)/D*
        ((Real.exp (((A:ℝ)/D-beta)*logCoordinate D eps r)*(logCoordinate D eps r)^n)*(D/r)) := by
      apply intervalIntegral.integral_congr
      intro r hr
      rw [integrand_eq_pullback hD heps (hrpos r hr) n]
      ring
    _ = eps^((A:ℝ)/D)/D*(∫ r in low..1,
        (Real.exp (((A:ℝ)/D-beta)*logCoordinate D eps r)*(logCoordinate D eps r)^n)*(D/r)) :=
      intervalIntegral.integral_const_mul _ _
    _ = _ := by
      rw [show (fun r => (Real.exp (((A:ℝ)/D-beta)*logCoordinate D eps r)*
          (logCoordinate D eps r)^n)*(D/r))=
          (fun r=>((fun u:ℝ=>Real.exp (((A:ℝ)/D-beta)*u)*u^n)∘logCoordinate D eps) r*(D/r)) by rfl,
        hcv,hmoment]

/-- Exact evaluation of the actual clipped radial integral. Its positive
saturation constant and fixed lower log cutoff are explicitly derived. -/
theorem clipped_integral_eq_offsetModel {A d : ℕ} (hA : 0<A) (hd : 0<d)
    {eta eps : ℝ} (heta : 0<eta) (heta1 : eta<1) (heps : 0<eps) (hsmall : eps<eta)
    (beta : ℝ) (n : ℕ) :
    weightedIntegral A d (clippedModel eta beta n) eps=
      ENNReal.ofReal (offsetModel ((A:ℝ)/(d:ℝ)) beta (d:ℝ)
        (saturationConstant A d eta) (-Real.log eta) n eps) := by
  have hD : 0<(d:ℝ) := by exact_mod_cast hd
  have hS : 0≤ -Real.log eta := neg_nonneg.mpr (Real.log_nonpos heta.le heta1.le)
  have hlog := Real.log_le_log heps hsmall.le
  have hST : -Real.log eta≤ -Real.log eps := by linarith
  have htail : 0 ≤ moment ((A:ℝ)/(d:ℝ)-beta) n (-Real.log eps)-
      moment ((A:ℝ)/(d:ℝ)-beta) n (-Real.log eta) :=
    sub_nonneg.mpr (moment_mono hS hST n)
  have hinner : 0≤eps^((A:ℝ)/(d:ℝ))*saturationConstant A d eta :=
    mul_nonneg (Real.rpow_nonneg heps.le _) (saturationConstant_pos hA d heta).le
  have houter := mul_nonneg (div_nonneg (Real.rpow_nonneg heps.le ((A:ℝ)/(d:ℝ))) hD.le) htail
  rw [clipped_integral_split hA hd heta heta1 heps hsmall,
    inner_mass_eq hd heta heps,outer_integral_eq_tail hd heta heps,
    ← ENNReal.ofReal_add hinner houter]
  congr 1
  unfold offsetModel
  ring

/-- All three actual clipped-kernel branches, without any angular order or
radial exponent supplied as a premise. -/
theorem clipped_integral_trichotomy {A d : ℕ} (hA : 0<A) (hd : 0<d)
    {eta : ℝ} (heta : 0<eta) (heta1 : eta<1) (beta : ℝ) (n : ℕ) :
    (beta<(A:ℝ)/(d:ℝ)→EThetaZeroPowerLog
      (fun eps=>weightedIntegral A d (clippedModel eta beta n) eps) beta n) ∧
    (beta=(A:ℝ)/(d:ℝ)→EThetaZeroPowerLog
      (fun eps=>weightedIntegral A d (clippedModel eta beta n) eps) ((A:ℝ)/(d:ℝ)) (n+1)) ∧
    ((A:ℝ)/(d:ℝ)<beta→EThetaZeroPowerLog
      (fun eps=>weightedIntegral A d (clippedModel eta beta n) eps) ((A:ℝ)/(d:ℝ)) 0) := by
  have hD : 0<(d:ℝ) := by exact_mod_cast hd
  have hS : 0≤ -Real.log eta := neg_nonneg.mpr (Real.log_nonpos heta.le heta1.le)
  obtain ⟨hlt,heq,hgt⟩ := offsetModel_trichotomy (beta:=beta) hD
    (saturationConstant_pos hA d heta) hS n
  have htransfer : ∀ lam k,EThetaZeroPowerLog (fun eps=>ENNReal.ofReal
      (offsetModel ((A:ℝ)/(d:ℝ)) beta (d:ℝ) (saturationConstant A d eta) (-Real.log eta) n eps)) lam k →
      EThetaZeroPowerLog (fun eps=>weightedIntegral A d (clippedModel eta beta n) eps) lam k := by
    intro lam k hp
    apply order_of_small_comparison hp zero_lt_one zero_lt_one heta
    intro eps heps hsmall
    rw [clipped_integral_eq_offsetModel hA hd heta heta1 heps hsmall]
    simp
  exact ⟨fun h=>htransfer _ _ (hlt h),fun h=>htransfer _ _ (heq h),fun h=>htransfer _ _ (hgt h)⟩

end MAIS.ClippedRadialModel
end

/-- info: 'MAIS.ClippedRadialModel.inner_mass_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ClippedRadialModel.inner_mass_eq

/-- info: 'MAIS.ClippedRadialModel.outer_integral_eq_tail' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ClippedRadialModel.outer_integral_eq_tail

/-- info: 'MAIS.ClippedRadialModel.clipped_integral_eq_offsetModel' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ClippedRadialModel.clipped_integral_eq_offsetModel

/-- info: 'MAIS.ClippedRadialModel.clipped_integral_trichotomy' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ClippedRadialModel.clipped_integral_trichotomy
end
