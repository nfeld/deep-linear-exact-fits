-- ==================== begin module O7.CofinalWindowTransfer (formalization/O7/CofinalWindowTransfer.lean) ====================
section

/-! Literal radius-first measured pairs depend on a genuine shrinking
neighborhood basis, not on a linear parametrization of its radius. This
permits honest weighted boxes as well as ordinary Euclidean balls. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1200000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology
namespace MAIS.CofinalWindowTransfer
open MAIS.AnalyticTransfer

variable {E : Type*} [TopologicalSpace E]

def NeighborhoodWindows (U : ℝ → Set E) (w : E) : Prop :=
  (∀ R : ℝ, 0 < R → U R ∈ nhds w) ∧
  ∀ V ∈ nhds w, ∃ rho : ℝ, 0 < rho ∧
    ∀ R : ℝ, 0 < R → R < rho → U R ⊆ V

variable [MeasurableSpace E]

/-- Each comparison radius is chosen before epsilon. No linear relation
between the two radius parameters, or measure regularity, is assumed. -/
theorem pair_of_neighborhood_windows (mu : Measure E) {U V : ℝ → Set E}
    {w : E} {f : E → ℝ} {lam : ℝ} {m : ℕ}
    (hU : NeighborhoodWindows U w) (hV : NeighborhoodWindows V w)
    (hp : HasMeasuredBandPair mu U f w lam m) :
    HasMeasuredBandPair mu V f w lam m := by
  obtain ⟨hlam,hm,r0,hr0,hsource⟩ := hp
  have hrhalf : 0 < r0/2 := half_pos hr0
  obtain ⟨R0,hR0,houter⟩ := hV.2 (U (r0/2)) (hU.1 _ hrhalf)
  refine ⟨hlam,hm,R0,hR0,?_⟩
  intro R hR hRR0
  obtain ⟨a,ha,hinner⟩ := hU.2 (V R) (hV.1 R hR)
  let r := min a r0/2
  have hr : 0 < r := half_pos (lt_min ha hr0)
  have hra : r < a := (half_lt_self (lt_min ha hr0)).trans_le (min_le_left _ _)
  have hrr0 : r < r0 := (half_lt_self (lt_min ha hr0)).trans_le (min_le_right _ _)
  have hi := hsource r hr hrr0
  have ho := hsource (r0/2) hrhalf (half_lt_self hr0)
  apply O77.Transport0906.order_of_two_window_bounds hi ho zero_lt_one zero_lt_one
  intro eps _
  simp only [ENNReal.ofReal_one,one_mul]
  constructor
  · apply measure_mono
    rintro x ⟨hx,hband⟩
    exact ⟨hinner r hr hra hx,hband⟩
  · apply measure_mono
    rintro x ⟨hx,hband⟩
    exact ⟨houter R hR hRR0 hx,hband⟩

theorem pair_iff_neighborhood_windows (mu : Measure E) {U V : ℝ → Set E}
    {w : E} {f : E → ℝ} {lam : ℝ} {m : ℕ}
    (hU : NeighborhoodWindows U w) (hV : NeighborhoodWindows V w) :
    HasMeasuredBandPair mu U f w lam m ↔ HasMeasuredBandPair mu V f w lam m :=
  ⟨pair_of_neighborhood_windows mu hU hV,pair_of_neighborhood_windows mu hV hU⟩

section Metric
variable {X : Type*} [PseudoMetricSpace X]

theorem metric_ball_windows (w : X) : NeighborhoodWindows (Metric.ball w) w := by
  refine ⟨fun R hR => Metric.ball_mem_nhds w hR,?_⟩
  intro V hV
  obtain ⟨rho,hrho,hball⟩ := Metric.mem_nhds_iff.mp hV
  exact ⟨rho,hrho,fun R _ hR => (Metric.ball_subset_ball hR.le).trans hball⟩

end Metric
end MAIS.CofinalWindowTransfer

