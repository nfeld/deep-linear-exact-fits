-- ==================== begin module O7.ActiveIntervalNearbyResidual (formalization/O7/ActiveIntervalNearbyResidual.lean) ====================
section

/-! Actual nearby full-matrix pair implies existence of a local residual
pair, by the genuine nearby physical chart and reverse Gaussian suspension. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1400000
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.ActiveIntervalNearbyResidual
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.ActiveIntervalMeasuredSlice MAIS.ActiveIntervalNearbySlice
open MAIS.MatrixChainIsomorphism MAIS.AnalyticTransfer
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s≤D+1)

/-- The actual open residual neighborhood is derived. At each residual zero
there, a literal full-matrix pair supplies the previously missing actual
local residual-pair existence, with real Gaussian exponent subtraction. -/
theorem exists_open_residual_pair_of_ambient_pair
    (hvalid:∀ s,birth s<death s)
    (muA:Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muT:Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR:Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR] :
    ∃ V:Set (Residual D birth death),IsOpen V ∧ 0∈V ∧
      ∀ z∈V,residualLoss D birth death hD z=0→∀ a:ℝ,∀ m:ℕ,
      HasMeasuredBandPair muA
        (Metric.ball (intervalRep D birth death+
          MAIS.ActiveIntervalNormal.normalInjection D birth death hD
            (gaussianHomeomorph D birth death hD (z,0))))
        (ambientLoss D birth death 0 (Fin.last D) (by exact Nat.zero_le D))
        (intervalRep D birth death+MAIS.ActiveIntervalNormal.normalInjection D birth death hD
          (gaussianHomeomorph D birth death hD (z,0))) a m→
      HasMeasuredBandPair muR (Metric.ball z) (residualLoss D birth death hD) z
        (a-(Fintype.card (DirectIndex D birth death):ℝ)/2) m := by
  obtain ⟨W,hWo,h0W,hW⟩:=exists_open_pair_iff_nearby_normal D birth death hD hvalid
    muA muT 0 (Fin.last D) (by exact Nat.zero_le D)
  let j:Residual D birth death→NormalParams birth death:=
    fun z=>gaussianHomeomorph D birth death hD (z,0)
  have hj:Continuous j:=(gaussianHomeomorph D birth death hD).continuous.comp
    (continuous_id.prodMk continuous_const)
  let V:Set (Residual D birth death):=j⁻¹' W
  have hVo:IsOpen V:=hWo.preimage hj
  have h0V:(0:Residual D birth death)∈V:=by
    change gaussianHomeomorph D birth death hD 0∈W
    rw [gaussianHomeomorph_zero]
    exact h0W
  refine ⟨V,hVo,h0V,?_⟩
  intro z hzV hz a m hp
  have hLoss:normalSquaredLoss D birth death hD (j z)=0:=by
    rw [normalSquaredLoss_gaussianHomeomorph]
    simp only [hz,norm_zero,zero_pow (by decide : (2:ℕ)≠0),add_zero]
  have hpath:pathMatrix (intervalRep D birth death+
      MAIS.ActiveIntervalNormal.normalInjection D birth death hD (j z))
      0 (Fin.last D) (by exact Nat.zero_le D)=0:=by
    exact norm_eq_zero.mp (sq_eq_zero_iff.mp hLoss)
  have hn:HasMeasuredBandPair muT (Metric.ball (j z))
      (normalSquaredLoss D birth death hD) (j z) a m:=
    (hW (j z) hzV hpath a m).mp hp
  exact MAIS.ActiveIntervalGaussianCancellation.residual_pair_of_normal_pair
    D birth death hD muT muR z hz hn

end MAIS.ActiveIntervalNearbyResidual
end

/-- info: 'MAIS.ActiveIntervalNearbyResidual.exists_open_residual_pair_of_ambient_pair' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalNearbyResidual.exists_open_residual_pair_of_ambient_pair
end
