-- ==================== begin module O7.Run2LinearRankGain (formalization/O7/Run2LinearRankGain.lean) ====================
section

/-! Finite-dimensional openness and a genuine extra range direction. These
linear lemmas assign no orbit or geometric dimension by definition. -/
set_option autoImplicit false
set_option maxHeartbeats 900000
noncomputable section
open Set Filter
open scoped Topology

namespace MAIS.Run2LinearRankGain

section Openness
variable {X E F : Type*} [TopologicalSpace X]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- Pointwise continuity on the actual finite-dimensional source suffices
to preserve injectivity locally. The finite basis is constructed. -/
theorem eventually_injective {x : X} (T : X → E →ₗ[ℝ] F)
    (hc : ∀ v : E, ContinuousAt (fun y => T y v) x)
    (hinj : Function.Injective (T x)) :
    ∀ᶠ y in nhds x, Function.Injective (T y) := by
  let b := Module.finBasis ℝ E
  have hli : LinearIndependent ℝ ((T x) ∘ b) :=
    b.linearIndependent.map' (T x) (LinearMap.ker_eq_bot.mpr hinj)
  have hcont : ContinuousAt (fun y => (T y) ∘ b) x :=
    continuousAt_pi.mpr (fun i => hc (b i))
  filter_upwards [hcont.tendsto.eventually hli.eventually] with y hy
  exact LinearMap.injective_of_linearIndependent b.span_eq hy

end Openness

section Gain
variable {E F U W : Type*}
  [AddCommGroup E] [Module ℝ E]
  [AddCommGroup F] [Module ℝ F] [FiniteDimensional ℝ F]
  [AddCommGroup U] [Module ℝ U] [FiniteDimensional ℝ U]
  [AddCommGroup W] [Module ℝ W]

/-- A nonzero normal direction in the actual range adds one independent
dimension beyond the transverse injective source directions. -/
theorem finrank_range_ge_add_one (d : E →ₗ[ℝ] F) (i : U →ₗ[ℝ] E)
    (j : W →ₗ[ℝ] F)
    (hinj : Function.Injective ((d.comp i).coprod j))
    (w : W) (hw : w ≠ 0) (hrange : j w ∈ d.range) :
    Module.finrank ℝ U + 1 ≤ Module.finrank ℝ d.range := by
  obtain ⟨v, hv⟩ := hrange
  let f : U × ℝ →ₗ[ℝ] d.range :=
    { toFun p := ⟨d (i p.1 + p.2 • v), ⟨i p.1 + p.2 • v, rfl⟩⟩
      map_add' p q := by
        apply Subtype.ext
        change d (i (p.1 + q.1) + (p.2 + q.2) • v) =
          d (i p.1 + p.2 • v) + d (i q.1 + q.2 • v)
        simp only [map_add, add_smul]
        abel
      map_smul' c p := by
        apply Subtype.ext
        change d (i (c • p.1) + (c * p.2) • v) = c • d (i p.1 + p.2 • v)
        simp only [map_add, map_smul, smul_add, smul_smul] }
  have hf : Function.Injective f := by
    apply (injective_iff_map_eq_zero f).mpr
    intro p hp
    have he : ((d.comp i).coprod j) (p.1, p.2 • w) = 0 := by
      have hh := congrArg Subtype.val hp
      change d (i p.1 + p.2 • v) = 0 at hh
      change d (i p.1) + j (p.2 • w) = 0
      calc
        _ = d (i p.1 + p.2 • v) := by simp only [map_add, map_smul, hv]
        _ = 0 := hh
    have hh : (p.1, p.2 • w) = 0 := hinj (he.trans (map_zero _).symm)
    have hc : p.2 = 0 := (smul_eq_zero.mp (congrArg Prod.snd hh)).resolve_right hw
    have hu : p.1 = 0 := congrArg (fun q : U × W => q.1) hh
    exact Prod.ext hu hc
  have h := LinearMap.finrank_le_finrank_of_injective hf
  simpa only [Module.finrank_prod, Module.finrank_self] using h

end Gain
end MAIS.Run2LinearRankGain

/-- info: 'MAIS.Run2LinearRankGain.eventually_injective' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2LinearRankGain.eventually_injective

/-- info: 'MAIS.Run2LinearRankGain.finrank_range_ge_add_one' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2LinearRankGain.finrank_range_ge_add_one
end
end
