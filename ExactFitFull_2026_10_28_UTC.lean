-- ==================== begin module O7.ActiveIntervalRecursivePair (formalization/O7/ActiveIntervalRecursivePair.lean) ====================
section

/-! End-to-end actual measured recurrence from a finite table of genuine
higher-orbit ambient pairs, with actual attained-label filtering. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.ActiveIntervalRecursivePair
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.ActiveIntervalMeasuredSlice MAIS.ActiveIntervalAnnulusRecurrence
open MAIS.ActiveIntervalWeightedResidual MAIS.ActiveIntervalRadialBand
open MAIS.ActiveIntervalNumericRecurrence MAIS.ActiveIntervalHigherPairs
open MAIS.MatrixChainIsomorphism MAIS.QuiverRealOrbit
open MAIS.WeightedCompactAnnulus MAIS.AnalyticTransfer O77.Residual
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s ≤ D+1)

/-- A label is retained only if its actual residual pair is attained at an
actual zero of the complete actual compact-annulus residual loss. -/
def Attained {J:Type*} (a:J→ℝ) (m:J→ℕ)
    (muR:Measure (Residual D birth death)) (j:J) : Prop:=
  ∃ z∈compactAnnulus (integerWeights D birth death),residualLoss D birth death hD z=0 ∧
    HasMeasuredBandPair muR (Metric.ball z) (residualLoss D birth death hD) z
      (a j-(Fintype.card (DirectIndex D birth death):ℝ)/2) (m j)

/-- Actual higher-orbit ambient table coverage. This hypothesis contains
literal measured pairs and literal ordinary real orbit closure. -/
def HigherTable {J:Type*} (a:J→ℝ) (m:J→ℕ)
    (muA:Measure (Ambient D birth death)) : Prop:=
  ∀ A:Ambient D birth death,
    pathMatrix A 0 (Fin.last D) (by exact Nat.zero_le D)=0→
    intervalRep D birth death∈closure (MulAction.orbit (Gauge (Index D birth death)) A)→
    A∉MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)→
    ∃ j,HasMeasuredBandPair muA (Metric.ball A)
      (ambientLoss D birth death 0 (Fin.last D) (by exact Nat.zero_le D)) A (a j) (m j)

/-- Actual finite-table compact aggregation, with no unattained labels and
with table nonemptiness derived from an actual residual-axis zero. -/
theorem annular_order_of_higher_table {J:Type*} [Fintype J] (a:J→ℝ) (m:J→ℕ)
    (hvalid:∀ s,birth s<death s)
    (muA:Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muT:Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR:Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    [Nonempty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (hcover:HigherTable D birth death a m muA) :
    ∃ j,Attained D birth death hD a m muR j ∧
      (∀ i,Attained D birth death hD a m muR i→a j<a i ∨ a j=a i ∧ m i ≤ m j) ∧
      EThetaZeroPowerLog (annularBand D birth death hD muR)
        (a j-(Fintype.card (DirectIndex D birth death):ℝ)/2) (m j-1) := by
  classical
  have hlocal:=local_residual_pairs_of_higher_table D birth death hD a m hvalid muA muT muR hzero hcover
  let T:Type _ :={j:J // Attained D birth death hD a m muR j}
  let _ : Fintype T:=inferInstance
  obtain ⟨z,hzK,hz⟩:=MAIS.ActiveIntervalResidualAxis.exists_annular_zero D birth death hD
    (integerWeights D birth death) hzero
  obtain ⟨j,hj⟩:=hlocal z hzK hz
  let _ : Nonempty T:=⟨⟨j,⟨z,hzK,hz,hj⟩⟩⟩
  have hW:∀ p:ResidualIndex D birth death,0 < integerWeights D birth death p:=
    fun p=>((zero_base_weight_data D birth death hD hzero).2 p).1
  have hhom:∀ r:ℝ,0<r→∀ z:Residual D birth death,
      residualLoss D birth death hD (MAIS.WeightedDyadicShells.dilation (integerWeights D birth death) r z)=
      r^(2*MAIS.IntervalIntegerPotentials.commonDenominator D birth death)*residualLoss D birth death hD z:=by
    intro r hr z
    exact zero_base_residualLoss_integerDilation D birth death hD hzero r hr z
  have hlocT:∀ z∈compactAnnulus (integerWeights D birth death),residualLoss D birth death hD z=0→
      ∃ j:T,HasMeasuredBandPair muR (Metric.ball z) (residualLoss D birth death hD) z
        (a j.val-(Fintype.card (DirectIndex D birth death):ℝ)/2) (m j.val):=by
    intro z hzK hz
    obtain ⟨i,hi⟩:=hlocal z hzK hz
    exact ⟨⟨i,⟨z,hzK,hz,hi⟩⟩,hi⟩
  have hattT:∀ j:T,∃ z∈compactAnnulus (integerWeights D birth death),residualLoss D birth death hD z=0 ∧
      HasMeasuredBandPair muR (Metric.ball z) (residualLoss D birth death hD) z
        (a j.val-(Fintype.card (DirectIndex D birth death):ℝ)/2) (m j.val):=fun j=>j.property
  obtain ⟨q,hbest,hp⟩:=MAIS.WeightedAnnulusFiniteTable.annulus_sublevel_order_of_ambient_types
    (fun j:T=>a j.val-(Fintype.card (DirectIndex D birth death):ℝ)/2)
    (fun j:T=>m j.val) muR (integerWeights D birth death) hW
    (2*MAIS.IntervalIntegerPotentials.commonDenominator D birth death)
    (residualLoss D birth death hD) (continuous_residualLoss D birth death hD)
    (residualLoss_nonneg D birth death hD) hhom hlocT hattT
  refine ⟨q.val,q.property,?_,hp⟩
  intro i hi
  rcases hbest (⟨i,hi⟩:T) with hlt|⟨heq,hm⟩
  · exact Or.inl (by linarith)
  · exact Or.inr ⟨by linarith,hm⟩

/-- This is only an abbreviation for the literal full original-entry
Euclidean half-loss measured pair, with the given actual prior. -/
abbrev ambientHalfPair (muA:Measure (Ambient D birth death))
    (prior:Ambient D birth death→ℝ) (lam:ℝ) (n:ℕ) : Prop:=
  HasMeasuredBandPair (muA.withDensity (fun A=>ENNReal.ofReal (prior A)))
    (MAIS.MatrixChainEntryWindows.entryBall (Index D birth death) (intervalRep D birth death))
    (fun A=>(1/2:ℝ)*ambientLoss D birth death 0 (Fin.last D) (by exact Nat.zero_le D) A)
    (intervalRep D birth death) lam n

/-- Full end-to-end actual numerical recurrence from genuine higher ambient
pair coverage. The selected label is truly attained; local residual pair
existence, finite compact aggregation, radial integration, all windows,
Gaussian shift and original-entry prior transport are conclusions. -/
theorem ambient_pair_recurrence_of_higher_table {J:Type*} [Fintype J] (a:J→ℝ) (m:J→ℕ)
    (hvalid:∀ s,birth s<death s)
    (muA:Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muT:Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR:Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    [Nonempty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (hcover:HigherTable D birth death a m muA)
    (prior:Ambient D birth death→ℝ) (hprior:ContinuousAt prior (intervalRep D birth death))
    (hpos:0<prior (intervalRep D birth death)) :
    ∃ j,Attained D birth death hD a m muR j ∧
      (∀ i,Attained D birth death hD a m muR i→a j<a i ∨ a j=a i ∧ m i ≤ m j) ∧
      ∀ lam:ℝ,∀ n:ℕ,
      let beta:=a j-(Fintype.card (DirectIndex D birth death):ℝ)/2
      let alpha:=radialRatio D birth death
      let q:ℝ:=(Fintype.card (DirectIndex D birth death):ℝ)/2
      (beta<alpha→(ambientHalfPair D birth death muA prior lam n ↔ lam=a j ∧ n=m j)) ∧
      (beta=alpha→(ambientHalfPair D birth death muA prior lam n ↔ lam=alpha+q ∧ n=m j+1)) ∧
      (alpha<beta→(ambientHalfPair D birth death muA prior lam n ↔ lam=alpha+q ∧ n=1)) := by
  obtain ⟨j,hatt,hbest,hp⟩:=annular_order_of_higher_table D birth death hD a m hvalid
    muA muT muR hzero hcover
  have hatt0:=hatt
  obtain ⟨z,_,_,hzpair⟩:=hatt0
  have hb:0 ≤ a j-(Fintype.card (DirectIndex D birth death):ℝ)/2:=hzpair.1
  have hm:1 ≤ m j:=hzpair.2.1
  have h1:m j-1+1=m j:=by omega
  have h2:m j-1+2=m j+1:=by omega
  refine ⟨j,hatt,hbest,?_⟩
  intro lam n
  have htri:=ambient_entry_half_pair_trichotomy_of_annulus_order D birth death hD hvalid
    muA muT muR hzero prior hprior hpos hb hp lam n
  simpa only [ambientHalfPair,h1,h2,sub_add_cancel] using htri


include hD in
/-- In particular, the actual full-entry pair exists from genuine finite
higher-orbit coverage; a radial comparison branch is chosen by real trichotomy. -/
theorem ambient_pair_exists_of_higher_table {J:Type*} [Fintype J] (a:J→ℝ) (m:J→ℕ)
    (hvalid:∀ s,birth s<death s)
    (muA:Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muT:Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR:Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    [Nonempty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (hcover:HigherTable D birth death a m muA)
    (prior:Ambient D birth death→ℝ) (hprior:ContinuousAt prior (intervalRep D birth death))
    (hpos:0<prior (intervalRep D birth death)) :
    ∃ lam:ℝ,∃ n:ℕ,ambientHalfPair D birth death muA prior lam n := by
  obtain ⟨j,_,_,htri⟩:=ambient_pair_recurrence_of_higher_table D birth death hD a m hvalid
    muA muT muR hzero hcover prior hprior hpos
  let beta:=a j-(Fintype.card (DirectIndex D birth death):ℝ)/2
  let alpha:=radialRatio D birth death
  let q:ℝ:=(Fintype.card (DirectIndex D birth death):ℝ)/2
  rcases lt_trichotomy beta alpha with hlt|heq|hgt
  · exact ⟨a j,m j,((htri (a j) (m j)).1 hlt).mpr ⟨rfl,rfl⟩⟩
  · exact ⟨alpha+q,m j+1,((htri (alpha+q) (m j+1)).2.1 heq).mpr ⟨rfl,rfl⟩⟩
  · exact ⟨alpha+q,1,((htri (alpha+q) 1).2.2 hgt).mpr ⟨rfl,rfl⟩⟩

end MAIS.ActiveIntervalRecursivePair
end

/-- info: 'MAIS.ActiveIntervalRecursivePair.annular_order_of_higher_table' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalRecursivePair.annular_order_of_higher_table

/-- info: 'MAIS.ActiveIntervalRecursivePair.ambient_pair_recurrence_of_higher_table' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalRecursivePair.ambient_pair_recurrence_of_higher_table

/-- info: 'MAIS.ActiveIntervalRecursivePair.ambient_pair_exists_of_higher_table' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalRecursivePair.ambient_pair_exists_of_higher_table
end
