-- ==================== begin module O7.WeightedRadialOrder (formalization/O7/WeightedRadialOrder.lean) ====================
section

/-! Actual power-log orders of the log-coordinate weighted radial integral. -/
set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.WeightedRadialOrder
open O77.Residual O77.PowerLogUniqueness MAIS.WeightedRadialMoments

/-- The literal exponential-moment representation of a radial model. -/
def model (alpha beta D L : ℝ) (n : ℕ) (eps : ℝ) : ℝ :=
  eps^alpha * (1 + moment (alpha-beta) n (L-Real.log eps)/D)

/-- Exact logarithmic substitution, retaining the entire finite integral. -/
theorem model_exp (alpha beta D L t : ℝ) (n : ℕ) :
    model alpha beta D L n (Real.exp (-t)) =
      Real.exp (-alpha*t)*(1+moment (alpha-beta) n (L+t)/D) := by
  have hp : (Real.exp (-t))^alpha = Real.exp (-alpha*t) := by
    rw [Real.rpow_def_of_pos (Real.exp_pos _),Real.log_exp]
    congr 1
    ring
  rw [model,hp,Real.log_exp,sub_neg_eq_add]

/-- Real exponential-parameter bounds give the existing actual extended-real
small-parameter order, with a derived epsilon cutoff. -/
theorem order_of_exp_bounds {F : ℝ → ℝ} {lam : ℝ} {k : ℕ}
    {c C T0 : ℝ} (hc : 0<c) (hC : 0<C)
    (h : ∀ t, T0 ≤ t →
      c*(Real.exp (-lam*t)*t^k) ≤ F (Real.exp (-t)) ∧
        F (Real.exp (-t)) ≤ C*(Real.exp (-lam*t)*t^k)) :
    EThetaZeroPowerLog (fun eps => ENNReal.ofReal (F eps)) lam k := by
  let S := max T0 2
  apply eThetaZeroPowerLog_of_sublevelPowerLogBounds
  refine ⟨c,C,Real.exp (-S),hc,hC,Real.exp_pos _,?_,?_⟩
  · apply Real.exp_lt_one_iff.mpr
    have hs : 2 ≤ S := le_max_right _ _
    linarith
  · intro eps heps hsmall
    let t := -Real.log eps
    have hlog := Real.log_lt_log heps hsmall
    rw [Real.log_exp] at hlog
    have hSt : S < t := by dsimp [t]; linarith
    have ht0 : T0 ≤ t := (le_max_left _ _).trans hSt.le
    have hexp : Real.exp (-t) = eps := by simp [t,Real.exp_log heps]
    have hb := h t ht0
    rw [← hexp]
    change ENNReal.ofReal c * ENNReal.ofReal
        (powerLogZeroReal lam k (Real.exp (-t))) ≤ ENNReal.ofReal (F (Real.exp (-t))) ∧
      ENNReal.ofReal (F (Real.exp (-t))) ≤ ENNReal.ofReal C * ENNReal.ofReal
        (powerLogZeroReal lam k (Real.exp (-t)))
    rw [← ENNReal.ofReal_mul hc.le,← ENNReal.ofReal_mul hC.le,gauge_exp]
    exact ⟨ENNReal.ofReal_le_ofReal hb.1,ENNReal.ofReal_le_ofReal hb.2⟩

/-- When the angular exponent exceeds the radial exponent, the actual finite
moment is uniformly bounded and contributes no logarithm. -/
theorem order_beta_gt_alpha {alpha beta D L : ℝ} (hD : 0<D) (hab : alpha<beta) (n : ℕ) :
    EThetaZeroPowerLog (fun eps => ENNReal.ofReal (model alpha beta D L n eps)) alpha 0 := by
  let a := beta-alpha
  have ha : 0<a := sub_pos.mpr hab
  let B : ℝ := (n.factorial:ℝ)/a^(n+1)
  have hB : 0 ≤ B := by dsimp [B]; positivity
  let C := 1+B/D
  have hC : 0<C := by dsimp [C]; positivity
  apply order_of_exp_bounds (c:=1) (C:=C) (T0:=max 1 (-L)) zero_lt_one hC
  intro t ht
  have hT : 0 ≤ L+t := by have h := (le_max_right 1 (-L)).trans ht; linarith
  have hj := moment_negative_bounds ha n hT
  have hsign : alpha-beta = -a := by dsimp [a]; ring
  rw [← hsign] at hj
  have hlo : 1 ≤ 1+moment (alpha-beta) n (L+t)/D := by
    have := div_nonneg hj.1 hD.le
    linarith
  have hup : 1+moment (alpha-beta) n (L+t)/D ≤ C := by
    have := div_le_div_of_nonneg_right hj.2 hD.le
    dsimp [C,B] at *
    linarith
  rw [model_exp]
  simpa only [pow_zero,mul_one,one_mul] using
    And.intro (mul_le_mul_of_nonneg_left hlo (Real.exp_nonneg (-alpha*t)))
      (by simpa only [mul_comm C] using
        mul_le_mul_of_nonneg_left hup (Real.exp_nonneg (-alpha*t)))

/-- At equality, the literal elementary moment adds exactly one logarithmic
power; this is a conclusion about the actual integral. -/
theorem order_beta_eq_alpha (alpha L : ℝ) {D : ℝ} (hD : 0<D) (n : ℕ) :
    EThetaZeroPowerLog (fun eps => ENNReal.ofReal (model alpha alpha D L n eps)) alpha (n+1) := by
  let p : ℕ := n+1
  have hp : (0:ℝ)<p := by dsimp [p]; positivity
  let c : ℝ := 1/(D*p*2^p)
  let C : ℝ := 1+2^p/(D*p)
  have hc : 0<c := by dsimp [c]; positivity
  have hC : 0<C := by dsimp [C]; positivity
  apply order_of_exp_bounds (c:=c) (C:=C) (T0:=2*|L|+4) hc hC
  intro t ht
  have ht4 : 4≤t := by have := abs_nonneg L; linarith
  have ht1 : 1≤t := by linarith
  have htl : t/2 ≤ L+t := by have := neg_abs_le L; linarith
  have htu : L+t ≤ 2*t := by have := le_abs_self L; linarith
  have hpowL := pow_le_pow_left₀ (by linarith : 0≤t/2) htl p
  have hpowU := pow_le_pow_left₀ (by linarith : 0≤L+t) htu p
  have hpow1 : 1≤t^p := one_le_pow₀ ht1
  have hlo : c*t^p ≤ 1+(L+t)^p/p/D := by
    calc
      c*t^p = (t/2)^p/p/D := by
        dsimp [c]
        rw [div_pow]
        field_simp
      _ ≤ (L+t)^p/p/D :=
        div_le_div_of_nonneg_right (div_le_div_of_nonneg_right hpowL hp.le) hD.le
      _ ≤ _ := by linarith
  have hup : 1+(L+t)^p/p/D ≤ C*t^p := by
    calc
      _ ≤ t^p+(2*t)^p/p/D := by
        have hh := div_le_div_of_nonneg_right (div_le_div_of_nonneg_right hpowU hp.le) hD.le
        linarith
      _ = C*t^p := by
        dsimp [C]
        rw [mul_pow]
        field_simp
  rw [model_exp,sub_self,moment_zero]
  constructor
  · simpa only [p,Nat.cast_add,Nat.cast_one,mul_left_comm c] using
      mul_le_mul_of_nonneg_left hlo (Real.exp_nonneg (-alpha*t))
  · simpa only [p,Nat.cast_add,Nat.cast_one,mul_left_comm C] using
      mul_le_mul_of_nonneg_left hup (Real.exp_nonneg (-alpha*t))

end MAIS.WeightedRadialOrder
end

