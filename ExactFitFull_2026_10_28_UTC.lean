info: 'MAIS.WeightedRadialOrder.model_exp' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedRadialOrder.model_exp

/--
info: 'MAIS.WeightedRadialOrder.order_of_exp_bounds' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedRadialOrder.order_of_exp_bounds

/--
info: 'MAIS.WeightedRadialOrder.order_beta_gt_alpha' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedRadialOrder.order_beta_gt_alpha

/--
info: 'MAIS.WeightedRadialOrder.order_beta_eq_alpha' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedRadialOrder.order_beta_eq_alpha
end
