-- ==================== begin module O7.ActiveIntervalResidualPolynomial (formalization/O7/ActiveIntervalResidualPolynomial.lean) ====================
section

/-! Native residual-index polynomials for the complete direct-eliminated loss.
All actual path terms are retained, and both the literal evaluation and the
positive integral weighted covariance are derived. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 250000
noncomputable section
namespace MAIS.ActiveIntervalResidualPolynomial

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalDirectElimination MAIS.ActiveIntervalGaussianCoordinates
open MAIS.ActiveIntervalPathPolynomial MAIS.ActiveIntervalWeightedResidual
open MAIS.MatrixPrefixPolynomial
open scoped Matrix
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- Direct variables are actually set to zero; every other variable is a
    genuinely independent variable indexed by the residual coordinate set. -/
def residualVariable (p : NormalIndex birth death) :
    MvPolynomial (ResidualIndex D birth death) ℝ :=
  if hp : IsDirect D birth death p then 0 else MvPolynomial.X ⟨p,hp⟩

def residualSubstitution : MvPolynomial (NormalIndex birth death) ℝ →+*
    MvPolynomial (ResidualIndex D birth death) ℝ :=
  MvPolynomial.eval₂Hom MvPolynomial.C (residualVariable D birth death)

omit [DecidableEq S] in
theorem residualInjection_apply (z : Residual D birth death) (p : NormalIndex birth death) :
    residualInjection D birth death z p =
      if hp : IsDirect D birth death p then 0 else z ⟨p,hp⟩ := by
  change (coordinateSplit D birth death).symm (z,0) p = _
  rw [coordinateSplit_symm_apply]
  split_ifs <;> rfl

omit [DecidableEq S] in
/-- The actual substitution homomorphism evaluates at the actual linear
    residual injection, rather than an assigned polynomial invariant. -/
theorem eval_residualSubstitution (z : Residual D birth death)
    (P : MvPolynomial (NormalIndex birth death) ℝ) :
    MvPolynomial.eval z (residualSubstitution D birth death P) =
      MvPolynomial.eval (residualInjection D birth death z) P := by
  have h : (MvPolynomial.eval z).comp (residualSubstitution D birth death) =
      MvPolynomial.eval (residualInjection D birth death z) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [residualSubstitution]
    · intro p
      simp only [RingHom.comp_apply, residualSubstitution, MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval_X, residualVariable, residualInjection_apply]
      split_ifs <;> simp
  exact RingHom.congr_fun h P

/-- Literal universal arrow matrices after setting the direct coordinates to
    zero, now over the smaller, actual residual polynomial ring. -/
def residualArrow (e : Fin D) :
    Matrix (Index D birth death e.succ) (Index D birth death e.castSucc)
      (MvPolynomial (ResidualIndex D birth death) ℝ) :=
  (universalArrow D birth death e).map (residualSubstitution D birth death)

theorem eval_residualArrow (z : Residual D birth death) (e : Fin D) :
    (residualArrow D birth death e).map (MvPolynomial.eval z) =
      MAIS.ActiveIntervalEndpointRows.normalFamily D birth death hD
        (residualInjection D birth death z) e := by
  ext r s
  change MvPolynomial.eval z
    (residualSubstitution D birth death (universalArrow D birth death e r s)) = _
  rw [eval_residualSubstitution]
  exact congrFun (congrFun (eval_universalArrow D birth death hD
    (residualInjection D birth death z) e) r) s

omit [Fintype S] in
theorem totalDegree_residualArrow_le (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    (residualArrow D birth death e r s).totalDegree ≤ 1 := by
  unfold residualArrow
  change (residualSubstitution D birth death (universalArrow D birth death e r s)).totalDegree ≤ 1
  unfold universalArrow residualSubstitution
  simp only [map_add, MvPolynomial.eval₂Hom_C]
  apply (MvPolynomial.totalDegree_add _ _).trans
  apply max_le
  · split_ifs <;> simp
  · split_ifs <;> simp only [map_zero, MvPolynomial.totalDegree_zero, zero_le, MvPolynomial.eval₂Hom_X']
    unfold residualVariable
    split_ifs <;> simp

/-- Complete native residual path matrix: all nonlinear terms survive. -/
def residualPathPolynomial (j : Fin (D + 1)) :
    Matrix (Index D birth death j) (Index D birth death 0)
      (MvPolynomial (ResidualIndex D birth death) ℝ) :=
  prefixProduct (Index D birth death) (residualArrow D birth death) j

theorem residualPathPolynomial_eq_substitution (j : Fin (D + 1)) :
    residualPathPolynomial D birth death j =
      (pathPolynomial D birth death j).map (residualSubstitution D birth death) := by
  exact (map_prefixProduct (Index D birth death) (residualSubstitution D birth death)
    (universalArrow D birth death) j).symm

theorem eval_residualPathPolynomial (z : Residual D birth death) (j : Fin (D + 1)) :
    (residualPathPolynomial D birth death j).map (MvPolynomial.eval z) =
      MAIS.MatrixChainIsomorphism.pathMatrix
        (MAIS.ActiveIntervalEndpointRows.normalFamily D birth death hD
          (residualInjection D birth death z)) 0 j (by exact Nat.zero_le j.val) := by
  rw [residualPathPolynomial_eq_substitution]
  ext r s
  change MvPolynomial.eval z
    (residualSubstitution D birth death (pathPolynomial D birth death j r s)) = _
  rw [eval_residualSubstitution]
  exact eval_pathPolynomial_entry D birth death hD
    (residualInjection D birth death z) j r s

theorem totalDegree_residualPathPolynomial_le (j : Fin (D + 1))
    (r : Index D birth death j) (s : Index D birth death 0) :
    (residualPathPolynomial D birth death j r s).totalDegree ≤ j.val :=
  totalDegree_prefixProduct_le (Index D birth death) (residualArrow D birth death)
    (totalDegree_residualArrow_le D birth death) j r s

/-- Literal sum of squares of the nonlinked complete endpoint entries in
    genuine residual variables, after the exact direct-block elimination. -/
def residualPolynomial : MvPolynomial (ResidualIndex D birth death) ℝ :=
  ∑ r : Index D birth death (Fin.last D), ∑ s : Index D birth death 0,
    if Linked birth death r.val s.val then 0 else
      (residualPathPolynomial D birth death (Fin.last D) r s)^2

theorem eval_residualPolynomial (z : Residual D birth death) :
    MvPolynomial.eval z (residualPolynomial D birth death) =
      residualLoss D birth death hD z := by
  unfold residualPolynomial residualLoss
  simp only [map_sum]
  apply Finset.sum_congr rfl
  intro r _
  apply Finset.sum_congr rfl
  intro s _
  split_ifs with h
  · simp only [map_zero]
  · rw [map_pow]
    congr 1
    exact congrFun (congrFun (eval_residualPathPolynomial D birth death hD z (Fin.last D)) r) s

theorem totalDegree_residualPolynomial_le :
    (residualPolynomial D birth death).totalDegree ≤ 2*D := by
  unfold residualPolynomial
  apply MvPolynomial.totalDegree_finsetSum_le
  intro r _
  apply MvPolynomial.totalDegree_finsetSum_le
  intro s _
  split_ifs
  · simp
  · apply (MvPolynomial.totalDegree_pow _ 2).trans
    exact Nat.mul_le_mul_left 2 (totalDegree_residualPathPolynomial_le
      D birth death (Fin.last D) r s)

/-- Real analyticity of the literal post-elimination residual loss follows
    from its actual native polynomial, in every residual coordinate. -/
theorem analyticAt_residualLoss (z : Residual D birth death) :
    AnalyticAt ℝ (residualLoss D birth death hD) z := by
  have he : (fun x : Residual D birth death =>
      MvPolynomial.eval x (residualPolynomial D birth death)) =
      residualLoss D birth death hD := by
    funext x
    exact eval_residualPolynomial D birth death hD x
  rw [← he]
  exact MAIS.MvPolynomialAnalyticEval.analyticAt_eval _ z

include hD in
/-- Exact positive integral weighted covariance of the actual polynomial
    evaluation. The weights and degree are derived from the zero-product base. -/
theorem eval_residualPolynomial_integerDilation
    (hzero : MAIS.MatrixChainIsomorphism.pathMatrix (intervalRep D birth death)
      0 (Fin.last D) (by exact Nat.zero_le D) = 0)
    (r : ℝ) (hr : 0 < r) (z : Residual D birth death) :
    MvPolynomial.eval (integerDilation D birth death r z) (residualPolynomial D birth death) =
      r^(2*MAIS.IntervalIntegerPotentials.commonDenominator D birth death) *
        MvPolynomial.eval z (residualPolynomial D birth death) := by
  rw [eval_residualPolynomial D birth death hD, eval_residualPolynomial D birth death hD]
  exact zero_base_residualLoss_integerDilation D birth death hD hzero r hr z

end MAIS.ActiveIntervalResidualPolynomial
end

/-- info: 'MAIS.ActiveIntervalResidualPolynomial.eval_residualSubstitution' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualPolynomial.eval_residualSubstitution

/-- info: 'MAIS.ActiveIntervalResidualPolynomial.eval_residualArrow' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualPolynomial.eval_residualArrow

/-- info: 'MAIS.ActiveIntervalResidualPolynomial.eval_residualPathPolynomial' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualPolynomial.eval_residualPathPolynomial

/-- info: 'MAIS.ActiveIntervalResidualPolynomial.totalDegree_residualPathPolynomial_le' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualPolynomial.totalDegree_residualPathPolynomial_le

/-- info: 'MAIS.ActiveIntervalResidualPolynomial.eval_residualPolynomial' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualPolynomial.eval_residualPolynomial

/-- info: 'MAIS.ActiveIntervalResidualPolynomial.totalDegree_residualPolynomial_le' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualPolynomial.totalDegree_residualPolynomial_le

/-- info: 'MAIS.ActiveIntervalResidualPolynomial.analyticAt_residualLoss' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualPolynomial.analyticAt_residualLoss

/-- info: 'MAIS.ActiveIntervalResidualPolynomial.eval_residualPolynomial_integerDilation' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualPolynomial.eval_residualPolynomial_integerDilation
end
-- ==================== end module O7.ActiveIntervalResidualPolynomial ====================

-- ==================== begin module O7.ActiveIntervalResidualAxis (formalization/O7/ActiveIntervalResidualAxis.lean) ====================
section

/-! Every actual residual coordinate axis stays in the zero full-product
fiber of a zero-product interval base. This derives an actual nonzero
residual zero; no annular zero is assigned. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
namespace MAIS.ActiveIntervalResidualAxis
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalEndpointRows MAIS.ActiveIntervalDirectUpdate
open MAIS.ActiveIntervalNormal MAIS.ActiveIntervalBasePaths
open MAIS.ActiveIntervalDirectElimination MAIS.ActiveIntervalGaussianCoordinates
open MAIS.ActiveIntervalResidualPolynomial MAIS.ActiveIntervalPathDerivative
open MAIS.MatrixChainIsomorphism MAIS.MatrixPathLocality
open scoped Matrix
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s,death s≤D+1)

private theorem sandwich_single {α β γ δ : Type*}
    [Fintype β] [Fintype γ] [DecidableEq β] [DecidableEq γ]
    (L : Matrix α β ℝ) (R : Matrix γ δ ℝ) (r : β) (s : γ) (τ : ℝ)
    (a : α) (b : δ) :
    (L * Matrix.single r s τ * R) a b = L a r * τ * R s b := by
  rw [Matrix.mul_apply,Finset.sum_eq_single s]
  · rw [Matrix.mul_single_apply_same]
  · intro k _ hk
    rw [Matrix.mul_single_apply_of_ne τ r s a k hk L,zero_mul]
  · simp

/-- A non-direct entrance basis update changes none of the actual full
    endpoint product, at arbitrary amplitude along that single axis. -/
theorem fullProduct_axis_eq_base (p:NormalIndex birth death)
    (hpnot:¬IsDirect D birth death p) (τ:ℝ) :
    pathMatrix (normalFamily D birth death hD (τ • Pi.single p 1))
      0 (Fin.last D) (by exact Nat.zero_le D)=
    pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D) := by
  let e:=entranceArrow D birth death hD p
  have he:e.val+1=birth p.val.1:=entranceArrow_output D birth death hD p
  have hp:=p.property
  change birth p.val.2<birth p.val.1 ∧ birth p.val.1≤death p.val.2 ∧
    death p.val.2<death p.val.1 at hp
  let re:Index D birth death e.succ:=⟨p.val.1,by
    change birth p.val.1≤e.val+1 ∧ e.val+1<death p.val.1;omega⟩
  let se:Index D birth death e.castSucc:=⟨p.val.2,by
    change birth p.val.2≤e.val ∧ e.val<death p.val.2;omega⟩
  have hb:((normalBasis D birth death hD) p : MAIS.QuiverRealOrbit.Rep (Index D birth death)) e=
      Matrix.single re se 1:=by
    ext u v
    rw [normalBasis_entry,Matrix.single_apply]
    simp only [he,and_true,Subtype.ext_iff,show re.val=p.val.1 from rfl,
      show se.val=p.val.2 from rfl,eq_comm]
  have hoff:∀ k:Fin D,k≠e→normalFamily D birth death hD (τ•Pi.single p 1) k=
      intervalRep D birth death k:=by
    intro k hk
    have hh:=congrFun (normalFamily_basis_update D birth death hD 0 p τ) k
    rw [zero_add,normalFamily_zero] at hh
    simp only [Pi.add_apply,Pi.smul_apply] at hh
    rw [normalBasis_other_arrow D birth death hD p k hk,smul_zero,add_zero] at hh
    exact hh
  have hd:normalFamily D birth death hD (τ•Pi.single p 1) e-intervalRep D birth death e=
      Matrix.single re se τ:=by
    have hh:=congrFun (normalFamily_basis_update D birth death hD 0 p τ) e
    rw [zero_add,normalFamily_zero] at hh
    simp only [Pi.add_apply,Pi.smul_apply] at hh
    rw [hh,add_sub_cancel_left,hb,Matrix.smul_single,smul_eq_mul,mul_one]
  have hc:=pathMatrix_single_arrow_change
    (normalFamily D birth death hD (τ•Pi.single p 1)) (intervalRep D birth death) e hoff
    0 (Fin.last D) (by exact Nat.zero_le D) (by exact Nat.zero_le e.val)
    (by exact Nat.succ_le_of_lt e.isLt)
  rw [hd] at hc
  ext r s
  have ht:=congrFun (congrFun hc r) s
  rw [Matrix.add_apply,sandwich_single] at ht
  simp_rw [pathMatrix_intervalRep_entry] at ht ⊢
  have hnot:¬(r.val=re.val ∧ se.val=s.val):=by
    rintro ⟨hr,hs⟩
    apply hpnot
    have hsrc:=s.property.1
    have htgt:=r.property.2
    have hbound:=hD p.val.1
    change birth s.val≤0 at hsrc
    change D<death r.val at htgt
    change birth p.val.2=0 ∧ death p.val.1=D+1
    change r.val=p.val.1 at hr
    change p.val.2=s.val at hs
    rw [hs] at ⊢
    rw [hr] at htgt
    omega
  by_cases hr:r.val=re.val
  · have hs:se.val≠s.val:=fun hs=>hnot ⟨hr,hs⟩
    simpa only [hr,ite_true,ite_eq_right hs,mul_zero,add_zero] using ht
  · simpa only [ite_eq_right hr,zero_mul,add_zero] using ht

lemma residualInjection_axis (p:ResidualIndex D birth death) (τ:ℝ) :
    residualInjection D birth death (τ•Pi.single p 1)=τ•Pi.single p.val 1 := by
  funext q
  rw [residualInjection_apply]
  by_cases hq:IsDirect D birth death q
  · have hn:q≠p.val:=fun he=>p.property (he ▸ hq)
    simp [hq,Pi.smul_apply,hn]
  · simp only [dite_eq_right hq,Pi.smul_apply,smul_eq_mul,Pi.single_apply,Subtype.ext_iff]

theorem residualLoss_axis_zero
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (p:ResidualIndex D birth death) (τ:ℝ) :
    residualLoss D birth death hD (τ•Pi.single p 1)=0 := by
  unfold residualLoss
  unfold MAIS.ActiveIntervalDirectElimination.fullProduct
  rw [residualInjection_axis]
  have hf:=fullProduct_axis_eq_base D birth death hD p.val p.property τ
  rw [hzero] at hf
  simp only [hf,Matrix.zero_apply,zero_pow (by decide:2≠0),ite_self,Finset.sum_const_zero]

/-- A literal unit coordinate lies in every actual compact weighted annulus,
    without any supplied zero-set or positive-measure premise. -/
theorem unit_axis_mem_compactAnnulus
    {I:Type*} [Fintype I] [DecidableEq I] (W:I→ℕ) (p:I) :
    (Pi.single p (1:ℝ))∈MAIS.WeightedCompactAnnulus.compactAnnulus W := by
  constructor
  · intro i
    simp only [Nat.zero_mul,pow_zero]
    by_cases hi:i=p <;> simp [hi]
  · intro h
    change ∀ i,|((Pi.single p (1:ℝ)):I→ℝ) i|<(1/2:ℝ)^(1*W i) at h
    have hp:=h p
    simp only [Pi.single_eq_same,abs_one,Nat.one_mul] at hp
    have hw:(1/2:ℝ)^(W p)≤1:=pow_le_one₀ (by norm_num) (by norm_num)
    linarith

/-- A nonempty actual residual carrier always has an actual annular zero.
    This discharges nonemptiness of a finite angular zero table. -/
theorem exists_annular_zero (W:ResidualIndex D birth death→ℕ)
    [Nonempty (ResidualIndex D birth death)]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0) :
    ∃ z∈MAIS.WeightedCompactAnnulus.compactAnnulus W,residualLoss D birth death hD z=0 := by
  obtain ⟨p⟩:=‹Nonempty (ResidualIndex D birth death)›
  refine ⟨Pi.single p 1,unit_axis_mem_compactAnnulus W p,?_⟩
  simpa only [one_smul] using residualLoss_axis_zero D birth death hD hzero p 1

end MAIS.ActiveIntervalResidualAxis

/-- info: 'MAIS.ActiveIntervalResidualAxis.fullProduct_axis_eq_base' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualAxis.fullProduct_axis_eq_base

/-- info: 'MAIS.ActiveIntervalResidualAxis.residualInjection_axis' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualAxis.residualInjection_axis

/-- info: 'MAIS.ActiveIntervalResidualAxis.residualLoss_axis_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualAxis.residualLoss_axis_zero

/-- info: 'MAIS.ActiveIntervalResidualAxis.unit_axis_mem_compactAnnulus' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualAxis.unit_axis_mem_compactAnnulus

/-- info: 'MAIS.ActiveIntervalResidualAxis.exists_annular_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalResidualAxis.exists_annular_zero
end
end
-- ==================== end module O7.ActiveIntervalResidualAxis ====================

-- ==================== begin module O7.CompactBandLocalization (formalization/O7/CompactBandLocalization.lean) ====================
section

/-! Actual compact localization of zero-level band measures. -/
set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.CompactBandLocalization
open MAIS.AnalyticTransfer O77.Residual
variable {E : Type*} [MetricSpace E] [MeasurableSpace E]

omit [MeasurableSpace E] in
/-- Compactness derives a uniform positive loss gap outside any open
neighborhood of the compact zero set. -/
theorem small_band_subset_open {K U : Set E} (hK : IsCompact K)
    {f : E → ℝ} (hf : Continuous f) (hU : IsOpen U)
    (hzero : {x | x ∈ K ∧ f x = 0} ⊆ U) :
    ∃ eta : ℝ, 0 < eta ∧ ∀ x ∈ K, |f x| < eta → x ∈ U := by
  have hC : IsCompact (f '' (K \ U)) := (hK.diff hU).image hf
  have h0 : (0 : ℝ) ∉ f '' (K \ U) := by
    rintro ⟨x,hx,hfx⟩
    exact hx.2 (hzero ⟨hx.1,hfx⟩)
  obtain ⟨eta,heta,hball⟩ := Metric.isOpen_iff.mp hC.isClosed.isOpen_compl 0 h0
  refine ⟨eta,heta,?_⟩
  intro x hx hfx
  by_contra hxU
  have hv : f x ∈ Metric.ball 0 eta := by simpa [Metric.mem_ball,Real.dist_eq] using hfx
  exact (hball hv) ⟨x,⟨hx,hxU⟩,rfl⟩

/-- Literal compact-band order from actual local upper bounds and one
attained actual lower patch. The finite subcover and off-zero cutoff are
constructed by compactness, not included as oracle fields. -/
theorem compact_order_of_local_upper
    (mu : Measure E) {K : Set E} (hK : IsCompact K) {f : E → ℝ}
    (hf : Continuous f) {lam : ℝ} {k : ℕ}
    (hupper : ∀ x, x ∈ K → f x = 0 →
      ∃ R C eta : ℝ, 0 < R ∧ 0 < C ∧ 0 < eta ∧
        ∀ eps, 0 < eps → eps < eta →
          mu {y | y ∈ K ∧ y ∈ Metric.ball x R ∧ |f y| < eps} ≤
            ENNReal.ofReal C * powerLogZero lam k eps)
    (hlower : ∃ x R, x ∈ K ∧ f x = 0 ∧ 0 < R ∧
      EThetaZeroPowerLog
        (fun eps => mu {y | y ∈ K ∧ y ∈ Metric.ball x R ∧ |f y| < eps}) lam k) :
    EThetaZeroPowerLog (fun eps => mu {x | x ∈ K ∧ |f x| < eps}) lam k := by
  classical
  let Z : Set E := {x | x ∈ K ∧ f x = 0}
  have hZ : IsCompact Z := hK.inter_right (isClosed_eq hf continuous_const)
  choose R C eta hR hC heta hb using
    (fun z : Z => hupper z.val z.property.1 z.property.2)
  let U : Z → Set E := fun z => Metric.ball z.val (R z)
  have hcover : Z ⊆ ⋃ z, U z := by
    intro x hx
    exact mem_iUnion.mpr ⟨⟨x,hx⟩, Metric.mem_ball_self (hR ⟨x,hx⟩)⟩
  obtain ⟨T,hT⟩ := hZ.elim_finite_subcover U (fun _ => Metric.isOpen_ball) hcover
  let V := ⋃ z ∈ T, U z
  have hVo : IsOpen V := isOpen_biUnion fun z _ => Metric.isOpen_ball
  obtain ⟨gap,hgap,hsmall⟩ := small_band_subset_open hK hf hVo hT
  obtain ⟨x0,R0,hx0,hf0,hR0,hlo⟩ := hlower
  obtain ⟨c0,C0,e0,hc0,hc0C0,he0,he0Exp,hbounds0⟩ := hlo
  have hTne : T.Nonempty := by
    have hxcover := hT (show x0 ∈ Z from ⟨hx0,hf0⟩)
    obtain ⟨z,hz,_⟩ := mem_iUnion₂.mp hxcover
    exact ⟨z,hz⟩
  let eT := T.inf' hTne eta
  have heT : 0 < eT := (Finset.lt_inf'_iff hTne).mpr (fun z hz => heta z)
  let total := 1 + ∑ z ∈ T, C z
  have htotal : 0 < total := by
    have hs : 0 ≤ ∑ z ∈ T, C z := Finset.sum_nonneg fun z _ => (hC z).le
    dsimp [total]
    linarith
  apply eThetaZeroPowerLog_of_sublevelPowerLogBounds
  refine ⟨c0,total,min gap (min e0 eT),hc0,htotal,
    lt_min hgap (lt_min he0 heT),?_,?_⟩
  · exact (min_le_right _ _).trans_lt
      ((min_le_left _ _).trans_lt (he0Exp.trans (Real.exp_lt_one_iff.mpr (by norm_num))))
  · intro eps heps hepssmall
    have hegap := hepssmall.trans_le (min_le_left _ _)
    have hee0 := (hepssmall.trans_le (min_le_right _ _)).trans_le (min_le_left _ _)
    have heeT := (hepssmall.trans_le (min_le_right _ _)).trans_le (min_le_right _ _)
    constructor
    · exact (hbounds0 eps heps hee0).1.trans (measure_mono (by
        rintro y ⟨hyK,_,hyf⟩
        exact ⟨hyK,hyf⟩))
    · have hs : {x | x ∈ K ∧ |f x| < eps} ⊆
          ⋃ z ∈ T, {y | y ∈ K ∧ y ∈ U z ∧ |f y| < eps} := by
        rintro x ⟨hxK,hxf⟩
        obtain ⟨z,hz,hxz⟩ := mem_iUnion₂.mp (hsmall x hxK (hxf.trans hegap))
        exact mem_iUnion₂.mpr ⟨z,hz,⟨hxK,hxz,hxf⟩⟩
      calc
        _ ≤ mu (⋃ z ∈ T, {y | y ∈ K ∧ y ∈ U z ∧ |f y| < eps}) := measure_mono hs
        _ ≤ ∑ z ∈ T, mu {y | y ∈ K ∧ y ∈ U z ∧ |f y| < eps} :=
          measure_biUnion_finset_le T _
        _ ≤ ∑ z ∈ T, ENNReal.ofReal (C z) * powerLogZero lam k eps := by
          apply Finset.sum_le_sum
          intro z hz
          exact hb z eps heps (heeT.trans_le (Finset.inf'_le eta hz))
        _ = ENNReal.ofReal (∑ z ∈ T, C z) * powerLogZero lam k eps := by
          rw [ENNReal.ofReal_sum_of_nonneg (fun z _ => (hC z).le), Finset.sum_mul]
        _ ≤ ENNReal.ofReal total * powerLogZero lam k eps := by
          apply mul_le_mul_of_nonneg_right _ bot_le
          apply ENNReal.ofReal_le_ofReal
          dsimp [total]
          linarith

end MAIS.CompactBandLocalization
end

/--
info: 'MAIS.CompactBandLocalization.small_band_subset_open' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.CompactBandLocalization.small_band_subset_open

/--
info: 'MAIS.CompactBandLocalization.compact_order_of_local_upper' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.CompactBandLocalization.compact_order_of_local_upper
end
