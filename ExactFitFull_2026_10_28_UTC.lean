    (β := fun _ : UpperIndex k => ℝ) (upperIndexSplit k)
    ((MeasurableEquiv.sumPiEquivProdPi
      (fun _ : Fin k ⊕ StrictUpperIndex k => ℝ)).symm (s, z)) x).trans
