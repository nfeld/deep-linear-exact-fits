-- ==================== begin module O7.LogMoments (formalization/O7/LogMoments.lean) ====================
section

/-!
# Logarithmic moments on a positive interval

Exact one-dimensional integrals needed for the positive-cube product-CDF
induction. The integrals below are literal Lebesgue integrals.
-/

set_option autoImplicit false
noncomputable section

open Set MeasureTheory

namespace MAIS.LogMoments

/-- Differentiation of the logarithmic primitive away from zero. -/
theorem hasDerivAt_logPrimitive (j : ℕ) {t x : ℝ} (ht : t ≠ 0) (hx : x ≠ 0) :
    HasDerivAt (fun y : ℝ => (Real.log (y / t)) ^ (j + 1) / (j + 1 : ℝ))
      ((Real.log (x / t)) ^ j / x) x := by
  have hl := ((hasDerivAt_id x).div_const t).log (div_ne_zero hx ht)
  have hp := (hl.pow (j + 1)).div_const (j + 1 : ℝ)
  convert! hp using 1
  simp only [Nat.cast_add, Nat.cast_one, Nat.add_sub_cancel, id_eq]
  have hj : (j + 1 : ℝ) ≠ 0 := by positivity
  field_simp

theorem logMoment_intervalIntegrable (j : ℕ) {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) :
    IntervalIntegrable (fun x : ℝ => (Real.log (x / t)) ^ j / x) volume t 1 := by
  apply ContinuousOn.intervalIntegrable_of_Icc ht1
  intro x hx
  have hx0 : x ≠ 0 := ne_of_gt (ht.trans_le hx.1)
  have hdiv : ContinuousAt (fun y : ℝ => y / t) x :=
    continuousAt_id.div_const t
  have hl : ContinuousAt (fun y : ℝ => Real.log (y / t)) x :=
    hdiv.log (div_ne_zero hx0 ht.ne')
  exact ((hl.pow j).div continuousAt_id hx0).continuousWithinAt

theorem logMoment_integrableOn (j : ℕ) {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) :
    IntegrableOn (fun x : ℝ => (Real.log (x / t)) ^ j / x) (Ioo t 1) := by
  have h := logMoment_intervalIntegrable j ht ht1
  rw [intervalIntegrable_iff_integrableOn_Ioc_of_le ht1] at h
  exact h.mono_set Ioo_subset_Ioc_self

/-- Exact logarithmic moment on `[t, 1]`, with the standard oriented integral. -/
theorem integral_logMoment (j : ℕ) {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) :
    ∫ x in t..1, (Real.log (x / t)) ^ j / x =
      (Real.log (1 / t)) ^ (j + 1) / (j + 1 : ℝ) := by
  have h := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (f := fun x : ℝ => (Real.log (x / t)) ^ (j + 1) / (j + 1 : ℝ))
    (f' := fun x : ℝ => (Real.log (x / t)) ^ j / x)
    (a := t) (b := 1)
    (fun x hx => hasDerivAt_logPrimitive j ht.ne'
      (ne_of_gt (ht.trans_le ((uIcc_of_le ht1) ▸ hx).1)))
    (logMoment_intervalIntegrable j ht ht1)
  simpa using h

/-- Exact Lebesgue integral over the open interval, including the endpoint `t = 1`. -/
theorem integral_Ioo_logMoment (j : ℕ) {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) :
    ∫ x in Ioo t 1, (Real.log (x / t)) ^ j / x =
      (Real.log (1 / t)) ^ (j + 1) / (j + 1 : ℝ) := by
  rw [← integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le ht1]
  exact integral_logMoment j ht ht1

/-- info: 'MAIS.LogMoments.integral_Ioo_logMoment' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms integral_Ioo_logMoment

end MAIS.LogMoments
end
end
