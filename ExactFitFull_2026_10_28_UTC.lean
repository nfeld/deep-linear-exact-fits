-- ==================== begin module O7.BarcodeActiveNormalForm (formalization/O7/BarcodeActiveNormalForm.lean) ====================
section

/-! Every actual real rectangular chain admits a genuine active-interval
representative after actual vertex coordinate bijections and an actual
matrix-unit gauge. The representative is derived from an actual barcode. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
noncomputable section
namespace MAIS.BarcodeActiveNormalForm
open MAIS.LinearChain MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalPivotRanks MAIS.MatrixCoordinateTransport

variable {D : ℕ} {ι : Fin (D+1) → Type*}
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]
local instance (T : Type*) : DecidableEq T := Classical.decEq T

abbrev birth {A : Rep ι} (B : Barcode (matrixChain A)) (s : B.Index) : ℕ := (B.birth s).val
abbrev death {A : Rep ι} (B : Barcode (matrixChain A)) (s : B.Index) : ℕ := (B.death s).val+1

theorem valid {A : Rep ι} (B : Barcode (matrixChain A)) (s : B.Index) : birth B s  <  death B s := by
  have h := B.valid s
  change (B.birth s).val  ≤  (B.death s).val at h
  exact Nat.lt_succ_iff.mpr h

theorem bounded {A : Rep ι} (B : Barcode (matrixChain A)) (s : B.Index) : death B s  ≤  D+1 := by
  have h := (B.death s).isLt
  exact h

/-- The actual active labels are precisely the barcode's actual vertex basis labels. -/
def vertexSurvivorEquiv {A : Rep ι} (B : Barcode (matrixChain A)) (v : Fin (D+1)) :
    Index D (birth B) (death B) v ≃ B.Survivor v v :=
  Equiv.subtypeEquivRight (fun s => by
    change ((B.birth s).val ≤ v.val  ∧  v.val < (B.death s).val+1) ↔
      ((B.birth s).val ≤ v.val  ∧  v.val ≤ (B.death s).val)
    omega)

/-- The actual common labels count precisely the barcode survivors on that path. -/
def commonSurvivorEquiv {A : Rep ι} (B : Barcode (matrixChain A))
    (i j : Fin (D+1)) (hij : i ≤ j) :
    Common D (birth B) (death B) i j ≃ B.Survivor i j :=
  Equiv.subtypeEquivRight (fun s => by
    change (((B.birth s).val ≤ i.val  ∧  i.val < (B.death s).val+1)  ∧ 
      ((B.birth s).val ≤ j.val  ∧  j.val < (B.death s).val+1)) ↔
      ((B.birth s).val ≤ i.val  ∧  j.val ≤ (B.death s).val)
    have h : i.val ≤ j.val := hij
    omega)

/-- The dimensions needed for actual vertex coordinate bijections are derived. -/
theorem vertex_card {A : Rep ι} (B : Barcode (matrixChain A)) (v : Fin (D+1)) :
    Fintype.card (Index D (birth B) (death B) v) = Fintype.card (ι v) := by
  calc
    _ = Fintype.card (B.Survivor v v) := Fintype.card_congr (vertexSurvivorEquiv B v)
    _ = Module.finrank ℝ (ι v → ℝ) := (B.finrank_vertex v).symm
    _ = Fintype.card (ι v) := by simp

/-- A literal vertex-by-vertex coordinate bijection, with no assumed basis change. -/
def vertexEquiv {A : Rep ι} (B : Barcode (matrixChain A)) (v : Fin (D+1)) :
    Index D (birth B) (death B) v ≃ ι v := Fintype.equivOfCardEq (vertex_card B v)

/-- Actual path ranks of the actual active interval representative agree
with the actual composed matrices of the original chain. -/
theorem path_rank_eq {A : Rep ι} (B : Barcode (matrixChain A))
    (i j : Fin (D+1)) (hij : i ≤ j) :
    (pathMatrix (intervalRep D (birth B) (death B)) i j hij).rank =
      (pathMatrix A i j hij).rank := by
  rw [path_rank_eq_common_card,pathMatrix_rank,B.finrank_range]
  exact Fintype.card_congr (commonSurvivorEquiv B i j hij)

/-- The actual transported interval arrows lie in the actual real gauge
orbit of the original chain, not merely in an algebraic orbit closure. -/
theorem actual_orbit {A : Rep ι} (B : Barcode (matrixChain A)) :
    transport (vertexEquiv B) (intervalRep D (birth B) (death B)) ∈ MulAction.orbit (Gauge ι) A := by
  apply mem_gauge_orbit_of_path_rank_eq
  intro i j hij
  rw [path_rank_transport]
  exact (path_rank_eq B i j hij).symm

/-- An actual finite active-interval normal representative exists for every
actual rectangular real matrix chain, including zero-dimensional vertices. -/
theorem exists_actual_interval_normal_form (A : Rep ι) :
    ∃ B : Barcode (matrixChain A),
      (∀s,birth B s < death B s)  ∧  (∀s,death B s ≤ D+1)  ∧ 
      ∃ e : ∀v,Index D (birth B) (death B) v ≃ ι v,
        transport e (intervalRep D (birth B) (death B)) ∈ MulAction.orbit (Gauge ι) A := by
  obtain ⟨B⟩ := exists_barcode (matrixChain A)
  exact ⟨B,valid B,bounded B,vertexEquiv B,actual_orbit B⟩

/-- Actual finite interval coordinates and actual real-orbit normalization,
with all dependent finite and decidable instances bundled explicitly. -/
structure ActiveNormalForm (A : Rep ι) where
  Label : Type
  [finiteLabel : Fintype Label]
  [decidableLabel : DecidableEq Label]
  birth : Label → ℕ
  death : Label → ℕ
  valid : ∀s,birth s < death s
  bounded : ∀s,death s ≤ D+1
  coordinates : ∀v,Index D birth death v ≃ ι v
  original_in_orbit : A ∈ MulAction.orbit (Gauge ι)
    (transport coordinates (intervalRep D birth death))
  rank_eq : ∀i j (hij : i ≤ j),
    (pathMatrix (intervalRep D birth death) i j hij).rank = (pathMatrix A i j hij).rank

attribute [instance] ActiveNormalForm.finiteLabel ActiveNormalForm.decidableLabel

/-- The complete actual interval normalization data are derived for every
actual real rectangular chain; no normal-form or rank witness is supplied. -/
theorem exists_normal_form (A : Rep ι) : Nonempty (ActiveNormalForm A) := by
  obtain ⟨B⟩ := exists_barcode (matrixChain A)
  have horbit : A ∈ MulAction.orbit (Gauge ι)
      (transport (vertexEquiv B) (intervalRep D (birth B) (death B))) := by
    obtain ⟨g,hg⟩ := MulAction.mem_orbit_iff.mp (actual_orbit B)
    apply MulAction.mem_orbit_iff.mpr
    refine ⟨g⁻¹,?_⟩
    rw [←hg,inv_smul_smul]
  exact ⟨{ Label := B.Index
           finiteLabel := B.finiteIndex
           decidableLabel := Classical.decEq B.Index
           birth := birth B
           death := death B
           valid := valid B
           bounded := bounded B
           coordinates := vertexEquiv B
           original_in_orbit := horbit
           rank_eq := path_rank_eq B }⟩

end MAIS.BarcodeActiveNormalForm

/-- info: 'MAIS.BarcodeActiveNormalForm.path_rank_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.BarcodeActiveNormalForm.path_rank_eq

/-- info: 'MAIS.BarcodeActiveNormalForm.actual_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.BarcodeActiveNormalForm.actual_orbit

/-- info: 'MAIS.BarcodeActiveNormalForm.exists_normal_form' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.BarcodeActiveNormalForm.exists_normal_form
end
end
-- ==================== end module O7.BarcodeActiveNormalForm ====================

-- ==================== begin module O7.QuiverIntervalMeasuredNormalForm (formalization/O7/QuiverIntervalMeasuredNormalForm.lean) ====================
section

/-! Actual zero-output pair normalization to an actual finite active
interval representative, with every independent source parameter present. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.QuiverIntervalMeasuredNormalForm
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open MAIS.MatrixCoordinateTransport MAIS.BarcodeActiveNormalForm
open MAIS.ActiveIntervalDifferential MAIS.AnalyticTransfer

variable {D : ℕ} {ι : Fin (D+1) → Type*}
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

/-- The derived actual interval representative is genuinely on the same
zero-output fiber, rather than merely having an assigned zero rank. -/
theorem intervalRep_zero_of_original_zero {A : Rep ι} (N : ActiveNormalForm A)
    (i j : Fin (D+1)) (hij : i ≤ j) (hzero : pathMatrix A i j hij=0) :
    pathMatrix (intervalRep D N.birth N.death) i j hij=0 := by
  let C := intervalRep D N.birth N.death
  let B := transport N.coordinates C
  obtain ⟨g,hg⟩ := MulAction.mem_orbit_iff.mp N.original_in_orbit
  have hB : B=g⁻¹ • A := by
    rw [←hg,inv_smul_smul]
  have hBzero : pathMatrix B i j hij=0 := by
    rw [hB,pathMatrix_gauge,hzero,Matrix.mul_zero,Matrix.zero_mul]
  apply norm_eq_zero.mp
  have hn := MAIS.QuiverCoordinateMeasuredPair.norm_path_transport N.coordinates C i j hij
  change ‖pathMatrix B i j hij‖=‖pathMatrix C i j hij‖ at hn
  rw [hBzero,norm_zero] at hn
  exact hn.symm

/-- Full actual Haar measured pairs reduce to the actual active interval
carrier through derived coordinate and genuine gauge changes. -/
theorem pair_iff_normal_form {A : Rep ι} (N : ActiveNormalForm A)
    (mu : Measure (Rep ι))
    (nu : Measure (Rep (Index D N.birth N.death)))
    [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]
    (i j : Fin (D+1)) (hij : i ≤ j) (hzero : pathMatrix A i j hij=0)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A) (fun B => ‖pathMatrix B i j hij‖^2) A lam m ↔
    HasMeasuredBandPair nu (Metric.ball (intervalRep D N.birth N.death))
      (fun B => ‖pathMatrix B i j hij‖^2) (intervalRep D N.birth N.death) lam m := by
  let C := intervalRep D N.birth N.death
  let B := transport N.coordinates C
  obtain ⟨g,hg⟩ := MulAction.mem_orbit_iff.mp N.original_in_orbit
  have hB : B=g⁻¹ • A := by rw [←hg,inv_smul_smul]
  have hBzero : pathMatrix B i j hij=0 := by
    rw [hB,pathMatrix_gauge,hzero,Matrix.mul_zero,Matrix.zero_mul]
  have hc := MAIS.QuiverCoordinateMeasuredPair.pair_iff_coordinate_transport
    N.coordinates nu mu C i j hij lam m
  have hgauge := MAIS.QuiverGaugeMeasuredPair.pair_iff_gauge_zero ι mu mu g B i j hij hBzero lam m
  change g • B=A at hg
  rw [hg] at hgauge
  exact (hc.trans hgauge).symm

end MAIS.QuiverIntervalMeasuredNormalForm

/-- info: 'MAIS.QuiverIntervalMeasuredNormalForm.intervalRep_zero_of_original_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverIntervalMeasuredNormalForm.intervalRep_zero_of_original_zero

/-- info: 'MAIS.QuiverIntervalMeasuredNormalForm.pair_iff_normal_form' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverIntervalMeasuredNormalForm.pair_iff_normal_form
end
end
