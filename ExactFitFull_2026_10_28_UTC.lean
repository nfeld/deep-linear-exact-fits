-- ==================== begin module O7.Run2GeometricCylinderZeroFiber (formalization/O7/Run2GeometricCylinderZeroFiber.lean) ====================
section

/-! The actual residual zero fiber has a finite real-orbit decomposition;
this gives an actual spectator-cylinder dimension formula without a general
Hausdorff product axiom. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricCylinderZeroFiber
open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear
open MAIS.Run2GeometricCharts MAIS.Run2GeometricLocal
open MAIS.Run2GeometricZeroFiber MAIS.Run2GeometricCodimension
open MAIS.Run2GeometricCylinderPatch MAIS.Run2GeometricCylinderOrbit

variable {K Q E : Type*}
  [NormedAddCommGroup K] [NormedSpace ℝ K] [FiniteDimensional ℝ K]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q] [FiniteDimensional ℝ Q]
  [NormedAddCommGroup E] [NormedSpace ℝ E]

omit [FiniteDimensional ℝ K] [FiniteDimensional ℝ Q]
  [NormedAddCommGroup K] [NormedSpace ℝ K] [NormedSpace ℝ Q]
  [NormedAddCommGroup E] [NormedSpace ℝ E] in
theorem cylinder_eq_prod (s : Set E) :
    (cylinder s : Set (K × (Q × E))) =
      (Set.univ : Set K) ×ˢ (({0} : Set Q) ×ˢ s) := by
  ext x
  simp only [MAIS.Run2GeometricCylinderPatch.cylinder, Set.mem_ofPred_eq, Set.mem_prod, Set.mem_univ, true_and,
    Set.mem_singleton_iff]

omit [FiniteDimensional ℝ K] [FiniteDimensional ℝ Q]
  [NormedSpace ℝ K] [NormedSpace ℝ Q] [NormedSpace ℝ E] in
theorem mem_closure_cylinder (s : Set E) (k : K) (a : E) :
    (k, ((0 : Q), a)) ∈ closure (cylinder s : Set (K × (Q × E))) ↔
      a ∈ closure s := by
  rw [cylinder_eq_prod, closure_prod_eq, closure_prod_eq, closure_univ, closure_singleton]
  simp only [Set.mem_prod, Set.mem_univ, true_and, Set.mem_singleton_iff]

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

omit [NormedAddCommGroup K] [NormedSpace ℝ K] [FiniteDimensional ℝ K]
  [NormedSpace ℝ Q] [FiniteDimensional ℝ Q] in
theorem cylinder_zeroFiber_eq_iUnion :
    (cylinder (zeroFiber ι) : Set (K × (Q × Rep ι))) =
      ⋃ j : ZeroOrbitIndex ι, cylinder (MulAction.orbit (Gauge ι) (representative ι j)) := by
  rw [zeroFiber_eq_iUnion_orbits]
  ext x
  simp only [MAIS.Run2GeometricCylinderPatch.cylinder, Set.mem_ofPred_eq, Set.mem_iUnion]
  constructor
  · rintro ⟨hx, j, hj⟩
    exact ⟨j, hx, hj⟩
  · rintro ⟨j, hx, hj⟩
    exact ⟨hx, j, hj⟩

/-- Actual residual-zero-fiber cylinders add exactly the free Euclidean
spectator dimension.  The genuine zero-product premise is essential. -/
theorem localDimH_cylinder_zeroFiber (A : Rep ι) (hA : A ∈ zeroFiber ι) (k : K) :
    localDimH (cylinder (zeroFiber ι) : Set (K × (Q × Rep ι))) (k, (0, A)) =
      (Module.finrank ℝ K : ℝ≥0∞) + localDimH (zeroFiber ι) A := by
  have hnonempty : ∃ j : ZeroOrbitIndex ι,
      A ∈ closure (MulAction.orbit (Gauge ι) (representative ι j)) := by
    obtain ⟨j⟩ := relevant_nonempty ι hA
    exact ⟨j.val, j.property⟩
  rw [cylinder_zeroFiber_eq_iUnion]
  rw [localDimH_finite_union _ _
    (fun j => orbit_cylinder_inter_ball_dimH (K := K) (Q := Q) (representative ι j))]
  simp only [mem_closure_cylinder, Nat.cast_add]
  rw [localDimH_zeroFiber, ENNReal.add_biSup' hnonempty]

end MAIS.Run2GeometricCylinderZeroFiber

/-- info: 'MAIS.Run2GeometricCylinderZeroFiber.cylinder_eq_prod' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderZeroFiber.cylinder_eq_prod

/-- info: 'MAIS.Run2GeometricCylinderZeroFiber.mem_closure_cylinder' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderZeroFiber.mem_closure_cylinder

/-- info: 'MAIS.Run2GeometricCylinderZeroFiber.cylinder_zeroFiber_eq_iUnion' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderZeroFiber.cylinder_zeroFiber_eq_iUnion

/-- info: 'MAIS.Run2GeometricCylinderZeroFiber.localDimH_cylinder_zeroFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderZeroFiber.localDimH_cylinder_zeroFiber
end
end
