-- ==================== begin module O7.Run2PositiveComparisonAlgebra (formalization/O7/Run2PositiveComparisonAlgebra.lean) ====================
section

/-! Elementary actual nonnegative comparison composition. This isolates the
constant bookkeeping from the concrete output/Schur identities. -/
set_option autoImplicit false
namespace MAIS.Run2PositiveComparisonAlgebra

/-- If the complementary square is uniformly comparable, adding the SAME
nonnegative regular square preserves a uniform comparison. -/
theorem sum_comparison {u s t C : ℝ} (hu : 0 ≤ u) (hs : 0 ≤ s) (ht : 0 ≤ t)
    (hC : 0 < C) (hl : s/C ≤ t) (hr : t ≤ C*s) :
    (u+s)/(max C 1) ≤ u+t ∧ u+t ≤ (max C 1)*(u+s) := by
  let K := max C 1
  have hK : 0 < K := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  have hCK : C ≤ K := le_max_left _ _
  have h1K : 1 ≤ K := le_max_right _ _
  have hs' : s ≤ C*t := (div_le_iff₀ hC).mp hl |>.trans_eq (mul_comm _ _)
  have hsu : u+s ≤ K*(u+t) := by
    have hutu : u ≤ K*u := by nlinarith
    have hst : s ≤ K*t := hs'.trans (mul_le_mul_of_nonneg_right hCK ht)
    nlinarith
  constructor
  · exact (div_le_iff₀ hK).mpr (by simpa only [mul_comm] using hsu)
  · have hutu : u ≤ K*u := by nlinarith
    have hts : t ≤ K*s := hr.trans (mul_le_mul_of_nonneg_right hCK hs)
    nlinarith

/-- Compose two literal uniform comparisons without assigning an asymptotic
exponent or asserting any pair predicate. -/
theorem compose_comparison {a b c C D : ℝ} (hC : 0 < C) (hD : 0 < D)
    (hab : a/C ≤ b ∧ b ≤ C*a) (hbc : b/D ≤ c ∧ c ≤ D*b) :
    a/(C*D) ≤ c ∧ c ≤ (C*D)*a := by
  constructor
  · have h1 : a ≤ C*b := (div_le_iff₀ hC).mp hab.1 |>.trans_eq (mul_comm _ _)
    have h2 : b ≤ D*c := (div_le_iff₀ hD).mp hbc.1 |>.trans_eq (mul_comm _ _)
    apply (div_le_iff₀ (mul_pos hC hD)).mpr
    calc
      _ ≤ C*b := h1
      _ ≤ C*(D*c) := mul_le_mul_of_nonneg_left h2 hC.le
      _ = _ := by ring
  · calc
      _ ≤ D*b := hbc.2
      _ ≤ D*(C*a) := mul_le_mul_of_nonneg_left hab.2 hD.le
      _ = _ := by ring

end MAIS.Run2PositiveComparisonAlgebra

