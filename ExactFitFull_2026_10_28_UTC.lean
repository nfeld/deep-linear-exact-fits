/-- info: 'MAIS.Run2FullSpanSlice.split_normal_completeProduct' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanSlice.split_normal_completeProduct
/-- info: 'MAIS.Run2FullSpanSlice.split_base_completeProduct' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanSlice.split_base_completeProduct
/-- info: 'MAIS.Run2FullSpanSlice.reduced_normal_completeProduct' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanSlice.reduced_normal_completeProduct
/-- info: 'MAIS.Run2FullSpanSlice.splitNormalSpace_completeProduct' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2FullSpanSlice.splitNormalSpace_completeProduct
end
