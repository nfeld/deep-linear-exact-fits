-- ==================== begin module O7.Run2StrictOrbitDimension (formalization/O7/Run2StrictOrbitDimension.lean) ====================
section

/-! Genuine strict real orbit generization at an interval representation
strictly increases the dimension of the literal orbit-differential range.
No geometric dimension or finite-orbit boundary theorem is assumed. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000
noncomputable section
open Set Filter
open scoped Topology Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2StrictOrbitDimension
open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalEndpointRows MAIS.ActiveIntervalSliceChart
open MAIS.Run2StrictOrbitLinear MAIS.Run2OrbitDifferentialGauge
open MAIS.Run2AllHigherAttainment MAIS.WeightedDilationNeighborhood

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- Actual global normal points gain a range direction, because the honest
positive diagonal gauge ray brings them into the derived transverse region. -/
theorem normal_finrank_range_strict (hvalid : ∀ s, birth s < death s)
    (t : NormalParams birth death) (ht : t ≠ 0) :
    Module.finrank ℝ (orbitDifferential (Index D birth death) (intervalRep D birth death)).range <
      Module.finrank ℝ (orbitDifferential (Index D birth death) (normalFamily D birth death hD t)).range := by
  have hnear := eventually_sliceLinear_injective D birth death hD hvalid
  obtain ⟨r, hr, hu, hne⟩ := exists_positive_dilation_mem_nhds_ne_zero
    (MAIS.ActiveIntervalNormalContraction.heightWeight birth death)
    (MAIS.ActiveIntervalNormalContraction.heightWeight_pos birth death) t ht
    {u | Function.Injective (sliceLinear D birth death hD u)} hnear
  have hs := nearby_finrank_range_strict D birth death hD _ hne hu
  have ho := MAIS.ActiveIntervalNormalContraction.normalFamily_dilation_mem_orbit
    birth death D hD t r hr
  have he := finrank_range_eq_of_mem_orbit (Index D birth death) ho
  change Module.finrank ℝ
      (orbitDifferential (Index D birth death)
        (normalFamily D birth death hD
          (MAIS.WeightedDyadicShells.dilation
            (MAIS.ActiveIntervalNormalContraction.heightWeight birth death) r t))).range = _ at he
  rw [he] at hs
  exact hs

/-- The actual open ambient chart extracts a nonzero normal representative
of every strict higher real orbit, without any zero-output assumption. -/
theorem exists_nonzero_normal_mem_orbit (hvalid : ∀ s, birth s < death s)
    (A : Rep (Index D birth death))
    (hclosure : intervalRep D birth death ∈
      closure (MulAction.orbit (Gauge (Index D birth death)) A))
    (hstrict : A ∉ MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)) :
    ∃ t : NormalParams birth death, t ≠ 0 ∧
      normalFamily D birth death hD t ∈ MulAction.orbit (Gauge (Index D birth death)) A := by
  let e := parameterChart D birth death hD hvalid
  obtain ⟨C, hCt, hCo⟩ := mem_closure_iff.mp hclosure e.target e.open_target
    (base_mem_parameterChart_target D birth death hD hvalid)
  let p := e.symm C
  let g := MAIS.OrbitSliceChart.expGauge (Index D birth death)
    (p.1 : Lie (Index D birth death))
  have hCg : C = g • normalFamily D birth death hD p.2 :=
    (e.right_inv hCt).symm.trans (parameterChart_eq_gauge D birth death hD hvalid p)
  have hnormal : normalFamily D birth death hD p.2 ∈
      MulAction.orbit (Gauge (Index D birth death)) A := by
    apply MulAction.mem_orbit_trans _ hCo
    exact MulAction.mem_orbit_iff.mpr ⟨g⁻¹, by rw [hCg, inv_smul_smul]⟩
  refine ⟨p.2, ?_, hnormal⟩
  intro ht
  have hb : intervalRep D birth death ∈ MulAction.orbit (Gauge (Index D birth death)) A := by
    simpa only [ht, MAIS.ActiveIntervalPathDerivative.normalFamily_zero] using hnormal
  exact hstrict (MulAction.mem_orbit_symm.mp hb)

include hD in
/-- Strict ordinary-real orbit closure gives a strict inequality between
the actual matrix orbit-differential ranks, at every valid interval base. -/
theorem finrank_range_lt_of_strict_closure (hvalid : ∀ s, birth s < death s)
    (A : Rep (Index D birth death))
    (hclosure : intervalRep D birth death ∈
      closure (MulAction.orbit (Gauge (Index D birth death)) A))
    (hstrict : A ∉ MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)) :
    Module.finrank ℝ (orbitDifferential (Index D birth death) (intervalRep D birth death)).range <
      Module.finrank ℝ (orbitDifferential (Index D birth death) A).range := by
  obtain ⟨t, ht, ho⟩ := exists_nonzero_normal_mem_orbit D birth death hD hvalid A hclosure hstrict
  have hs := normal_finrank_range_strict D birth death hD hvalid t ht
  rw [finrank_range_eq_of_mem_orbit (Index D birth death) ho] at hs
  exact hs

end MAIS.Run2StrictOrbitDimension

/-- info: 'MAIS.Run2StrictOrbitDimension.normal_finrank_range_strict' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2StrictOrbitDimension.normal_finrank_range_strict

/-- info: 'MAIS.Run2StrictOrbitDimension.exists_nonzero_normal_mem_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2StrictOrbitDimension.exists_nonzero_normal_mem_orbit

/-- info: 'MAIS.Run2StrictOrbitDimension.finrank_range_lt_of_strict_closure' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2StrictOrbitDimension.finrank_range_lt_of_strict_closure
end
end
