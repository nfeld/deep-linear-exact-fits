-- ==================== begin module O7.ActiveIntervalPolarDensity (formalization/O7/ActiveIntervalPolarDensity.lean) ====================
section

/-! Actual weighted radial density and complete homogeneous loss in the
literal residual interval coordinates; every weight and degree is derived. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal
namespace MAIS.ActiveIntervalPolarDensity
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.ActiveIntervalAngularSlice MAIS.ActiveIntervalWeightedResidual
open MAIS.WeightedCoordinateSlice MAIS.WeightedChartJacobian MAIS.WeightedPolarJacobian
open MAIS.MatrixChainIsomorphism
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s≤D+1)

def totalWeight : ℝ := ∑ p:ResidualIndex D birth death,weights D birth death p

/-- The complete actual residual loss in literal logarithmic radial coordinates. -/
theorem residualLoss_coordinateForward
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (p:ResidualIndex D birth death) (b:ℝ) (x:Residual D birth death) :
    residualLoss D birth death hD (coordinateForward (weights D birth death) p b x) =
      Real.exp (2*x p)*residualLoss D birth death hD
        (lift p b (fun i => x i.val)) :=
  residualLoss_homogeneity D birth death hD hzero (x p) (lift p b (fun i => x i.val))

/-- In positive radius coordinates the complete actual residual loss has
    derived degree two, with its literal affine face restriction. -/
theorem residualLoss_polarForward
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (p:ResidualIndex D birth death) (b:ℝ) (x:Residual D birth death) (hx:0<x p) :
    residualLoss D birth death hD (polarForward (weights D birth death) p b x) =
      (x p)^2*residualLoss D birth death hD
        (lift p b (fun i => x i.val)) := by
  rw [polarForward,residualLoss_coordinateForward D birth death hD hzero]
  have hl : (fun i : {i:ResidualIndex D birth death // i≠p} => logCoordinate p x i.val) =
      fun i => x i.val := by
    funext i
    simp only [logCoordinate,Function.update_of_ne i.property]
  rw [hl]
  simp only [logCoordinate,Function.update_self]
  rw [two_mul,Real.exp_add,Real.exp_log hx]
  ring

omit [DecidableEq S] in
include hD in
theorem totalWeight_pos (p:ResidualIndex D birth death) : 0<totalWeight D birth death := by
  unfold totalWeight
  exact Finset.sum_pos (fun q _ => weights_pos D birth death hD q) ⟨p,Finset.mem_univ p⟩

include hD in
/-- The Jacobian uses the actual derived positive coordinate weight and
    actual weight sum, not an assigned weighted-volume exponent. -/
theorem abs_det_fderiv_actual_polar (p:ResidualIndex D birth death) (b:ℝ)
    (x:Residual D birth death) (hx:0<x p) :
    |(fderiv ℝ (polarForward (weights D birth death) p b) x).det| =
      weights D birth death p*|b| *(x p)^(totalWeight D birth death-1) := by
  rw [abs_det_fderiv_polarForward _ _ _ _ hx,abs_mul,
    abs_of_pos (weights_pos D birth death hD p)]
  rfl

include hD in
/-- Exact actual Haar radial change of variables on every measurable
    positive-radius domain in the genuine residual carrier. -/
theorem lintegral_image_actual_polar (mu:Measure (Residual D birth death))
    [Measure.IsAddHaarMeasure mu] (p:ResidualIndex D birth death) {b:ℝ} (hb:b≠0)
    {U:Set (Residual D birth death)} (hU:MeasurableSet U) (hpos:∀ x∈U,0<x p)
    (g:Residual D birth death→ℝ≥0∞) :
    ∫⁻ y in polarForward (weights D birth death) p b '' U,g y ∂mu =
      ∫⁻ x in U,ENNReal.ofReal (weights D birth death p*|b| *
        (x p)^(totalWeight D birth death-1))*
        g (polarForward (weights D birth death) p b x) ∂mu := by
  have hh:=lintegral_image_polarForward mu (weights D birth death) p hb
    (ne_of_gt (weights_pos D birth death hD p)) hU hpos g
  simpa only [abs_mul,abs_of_pos (weights_pos D birth death hD p),totalWeight] using hh

include hD in
/-- Exact clearing of the actual residual weight sum by the actual positive
    common denominator constructed from the interval slots. -/
theorem integer_weight_sum
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0) :
    ((∑ p:ResidualIndex D birth death,
      MAIS.IntervalIntegerPotentials.integerWeight D birth death p.val : ℕ):ℝ) =
      (MAIS.IntervalIntegerPotentials.commonDenominator D birth death:ℝ)*totalWeight D birth death := by
  have hproper:=MAIS.IntervalPositivePotentials.denominator_pos_of_zero_path D birth death hD hzero
  have he : ∀ p:ResidualIndex D birth death,
      (MAIS.IntervalIntegerPotentials.integerWeight D birth death p.val:ℝ) =
      (MAIS.IntervalIntegerPotentials.commonDenominator D birth death:ℝ)*weights D birth death p := by
    intro p
    have hh:=MAIS.IntervalIntegerPotentials.integerWeight_cast D birth death hD hproper p.val
    unfold MAIS.IntervalPositivePotentials.edgeWeight at hh
    unfold weights realPotential
    exact_mod_cast hh
  rw [Nat.cast_sum]
  simp_rw [he]
  rw [← Finset.mul_sum]
  rfl

include hD in
/-- The density/degree ratio agrees exactly with its positive integral
    weight presentation; this statement assigns no measured pair. -/
theorem density_degree_ratio
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0) :
    totalWeight D birth death/2 =
      ((∑ p:ResidualIndex D birth death,
        MAIS.IntervalIntegerPotentials.integerWeight D birth death p.val : ℕ):ℝ)/
        (2*(MAIS.IntervalIntegerPotentials.commonDenominator D birth death:ℝ)) := by
  have hproper:=MAIS.IntervalPositivePotentials.denominator_pos_of_zero_path D birth death hD hzero
  have hp : (MAIS.IntervalIntegerPotentials.commonDenominator D birth death:ℝ)≠0 := by
    exact_mod_cast (ne_of_gt (MAIS.IntervalIntegerPotentials.commonDenominator_pos D birth death hproper))
  rw [integer_weight_sum D birth death hD hzero]
  field_simp

end MAIS.ActiveIntervalPolarDensity
end

