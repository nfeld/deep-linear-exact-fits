-- ==================== begin module O7.Run2PowerLogLowerBound (formalization/O7/Run2PowerLogLowerBound.lean) ====================
section

/-! An actual power lower envelope bounds the exponent of the existing
radius-fixed measured power/log order. No exponent is assigned to a volume
function by definition. This is the asymptotic comparison needed by the
weighted-cube argument. -/

set_option autoImplicit false
noncomputable section
open Filter
open scoped Topology ENNReal

namespace MAIS.Run2PowerLogLowerBound
open O77.Residual O77.PowerLogUniqueness

/-- A positive lower power bound, on the literal exponential small-parameter
curve, prevents an actual power/log order from having a larger exponent. -/
theorem exponent_le_of_eventual_power_lower
    {V : ℝ → ℝ≥0∞} {lam a c : ℝ} {k : ℕ}
    (hV : EThetaZeroPowerLog V lam k) (hc : 0 < c)
    (hlower : ∀ᶠ t : ℝ in atTop,
      ENNReal.ofReal c * powerLogZero a 0 (Real.exp (-t)) ≤ V (Real.exp (-t))) :
    lam ≤ a := by
  by_contra hla
  have hal : a < lam := lt_of_not_ge hla
  obtain ⟨b, C, eps0, hb, hbC, heps0, _, hbounds⟩ := hV
  have hC : 0 < C := hb.trans_le hbC
  have hratio : ∀ᶠ t : ℝ in atTop,
      c / C ≤ powerLogZeroReal lam k (Real.exp (-t)) /
        powerLogZeroReal a 0 (Real.exp (-t)) := by
    filter_upwards [hlower, eventually_gt_atTop (0 : ℝ),
      Real.tendsto_exp_neg_atTop_nhds_zero.eventually (gt_mem_nhds heps0)]
      with t ht htpos heps
    have hcross := ht.trans (hbounds _ (Real.exp_pos _) heps).2
    have hreal : c * powerLogZeroReal a 0 (Real.exp (-t)) ≤
        C * powerLogZeroReal lam k (Real.exp (-t)) := by
      apply (ENNReal.ofReal_le_ofReal_iff
        (mul_pos hC (gauge_exp_pos lam k htpos)).le).mp
      simpa only [powerLogZero, ENNReal.ofReal_mul hc.le,
        ENNReal.ofReal_mul hC.le] using hcross
    apply (div_le_div_iff₀ hC (gauge_exp_pos a 0 htpos)).mpr
    simpa only [mul_comm C] using hreal
  have hzero := ratio_tendsto_zero_threshold hal k 0
  have hsmall : ∀ᶠ t : ℝ in atTop,
      powerLogZeroReal lam k (Real.exp (-t)) /
        powerLogZeroReal a 0 (Real.exp (-t)) < c / C :=
    hzero.eventually (gt_mem_nhds (div_pos hc hC))
  obtain ⟨t, hlo, hhi⟩ := (hratio.and hsmall).exists
  exact (not_lt_of_ge hlo) hhi

end MAIS.Run2PowerLogLowerBound

/-- info: 'MAIS.Run2PowerLogLowerBound.exponent_le_of_eventual_power_lower' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PowerLogLowerBound.exponent_le_of_eventual_power_lower
end
end
-- ==================== end module O7.Run2PowerLogLowerBound ====================

-- ==================== begin module O7.Run2WeightedCubeBound (formalization/O7/Run2WeightedCubeBound.lean) ====================
section

/-! A genuine Haar-measure weighted-cube lower bound and its consequence for
the actual radius-first measured exponent. Empty coordinate index types are
included: no origin-null or nonempty-index hypothesis is used. -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal

namespace MAIS.Run2WeightedCubeBound
open MAIS.WeightedDyadicShells MAIS.WeightedDyadicBandIdentity
open MAIS.WeightedHomogeneousBoxOrder MAIS.WeightedCompactAnnulus
open MAIS.AnalyticTransfer O77.Residual O77.PowerLogUniqueness

variable {I : Type*} [Fintype I] [DecidableEq I]

omit [DecidableEq I] in
/-- An actual compact, positive-Haar-volume coordinate box on which the loss
is strictly below one. It is obtained from continuity, not supplied as a
sublevel-volume assumption. -/
theorem exists_positive_small_box (mu : Measure (I → ℝ)) [Measure.IsAddHaarMeasure mu]
    (W : I → ℕ) (hW : ∀ i, 0 < W i) (f : (I → ℝ) → ℝ)
    (hf : ContinuousAt f 0) (hzero : f 0 = 0) :
    ∃ U : Set (I → ℝ), IsCompact U ∧ 0 < mu U ∧ mu U ≠ ∞ ∧
      U ⊆ box W 0 ∧ ∀ x ∈ U, f x < 1 := by
  have hnear : {x : I → ℝ | f x < 1} ∈ nhds 0 := by
    exact hf.eventually (gt_mem_nhds (by rw [hzero]; norm_num))
  obtain ⟨delta, hd, hsub⟩ := (neighborhood_windows W hW).2 _ hnear
  let r : ℝ := min delta 1 / 2
  have hr : 0 < r := half_pos (lt_min hd zero_lt_one)
  have hrd : r < delta :=
    (half_lt_self (lt_min hd zero_lt_one)).trans_le (min_le_left _ _)
  have hr1 : r ≤ 1 :=
    ((half_lt_self (lt_min hd zero_lt_one)).trans_le (min_le_right _ _)).le
  let U := windows W r
  have hUc : IsCompact U := by
    exact (isCompact_box W 0).image (dilationEquiv W r hr.ne').continuous
  have hUp : 0 < mu U :=
    mu.measure_pos_of_mem_nhds ((neighborhood_windows W hW).1 r hr)
  refine ⟨U, hUc, hUp, hUc.measure_ne_top, ?_, ?_⟩
  · intro x hx i
    have hb := (mem_windows W hr x).mp hx i
    have hp : r ^ W i ≤ 1 := pow_le_one₀ hr.le hr1
    simpa only [Nat.zero_mul, pow_zero] using hb.trans hp
  · exact fun x hx => hsub r hr hrd hx

/-- Literal dilated boxes give a positive power lower envelope for the actual
unit-box sublevel measure. Every factor is a genuine Haar volume. -/
theorem eventual_power_lower (mu : Measure (I → ℝ)) [Measure.IsAddHaarMeasure mu]
    (W : I → ℕ) (hW : ∀ i, 0 < W i) (d : ℕ) (hd : 0 < d)
    (f : (I → ℝ) → ℝ) (hf : ContinuousAt f 0) (hzero : f 0 = 0)
    (hhom : ∀ r : ℝ, 0 < r → ∀ x, f (dilation W r x) = r ^ d * f x) :
    ∃ c : ℝ, 0 < c ∧ ∀ᶠ t : ℝ in atTop,
      ENNReal.ofReal c * powerLogZero (((∑ i, W i : ℕ) : ℝ) / d) 0
        (Real.exp (-t)) ≤ bandOn mu (box W 0) f (Real.exp (-t)) := by
  obtain ⟨U, _, hUp, hUfin, hUbox, hUf⟩ :=
    exists_positive_small_box mu W hW f hf hzero
  let c : ℝ := (mu U).toReal
  have hc : 0 < c := ENNReal.toReal_pos hUp.ne' hUfin
  refine ⟨c, hc, ?_⟩
  filter_upwards [eventually_ge_atTop (0 : ℝ)] with t ht
  let r : ℝ := Real.exp (-t / d)
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  have hr : 0 < r := Real.exp_pos _
  have hr1 : r ≤ 1 := Real.exp_le_one_iff.mpr (div_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr ht) hdR.le)
  have hrd : r ^ d = Real.exp (-t) := by
    dsimp [r]
    rw [← Real.exp_nat_mul]
    congr 1
    field_simp
  have hrW : r ^ (∑ i, W i) =
      powerLogZeroReal (((∑ i, W i : ℕ) : ℝ) / d) 0 (Real.exp (-t)) := by
    rw [gauge_exp]
    simp only [pow_zero, mul_one]
    dsimp [r]
    rw [← Real.exp_nat_mul]
    congr 1
    ring
  have hsubset : dilation W r '' U ⊆
      {x | x ∈ box W 0 ∧ f x < Real.exp (-t)} := by
    rintro x ⟨y, hy, rfl⟩
    constructor
    · intro i
      have hby : |y i| ≤ 1 := by
        simpa only [Nat.zero_mul, pow_zero] using hUbox hy i
      have hp : r ^ W i ≤ 1 := pow_le_one₀ hr.le hr1
      change |r ^ W i * y i| ≤ _
      rw [abs_mul, abs_of_pos (pow_pos hr _)]
      simpa only [Nat.zero_mul, pow_zero, mul_one] using
        (mul_le_mul hp hby (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 1))
    · rw [hhom r hr, ← hrd]
      simpa only [mul_one] using mul_lt_mul_of_pos_left (hUf y hy) (pow_pos hr d)
  have hmeasure : mu (dilation W r '' U) ≤
      mu {x | x ∈ box W 0 ∧ f x < Real.exp (-t)} := measure_mono hsubset
  rw [measure_dilation_image mu W r hr] at hmeasure
  rw [hrW] at hmeasure
  change ENNReal.ofReal c * ENNReal.ofReal _ ≤ _
  rw [show ENNReal.ofReal c = mu U by exact ENNReal.ofReal_toReal hUfin]
  simpa only [mul_comm, bandOn] using hmeasure

/-- The weighted-cube theorem for the existing radius-first actual measured
pair. The conclusion is derived from literal volume, exact homogeneity and
the pair's power/log bounds; it is not part of a definition. -/
theorem exponent_le_weight_ratio (mu : Measure (I → ℝ)) [Measure.IsAddHaarMeasure mu]
    (W : I → ℕ) (hW : ∀ i, 0 < W i) (d : ℕ) (hd : 0 < d)
    (f : (I → ℝ) → ℝ) (hf : Continuous f) (hzero : f 0 = 0)
    (hnonneg : ∀ x, 0 ≤ f x)
    (hhom : ∀ r : ℝ, 0 < r → ∀ x, f (dilation W r x) = r ^ d * f x)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball 0) f 0 lam m) :
    lam ≤ ((∑ i, W i : ℕ) : ℝ) / d := by
  have horder := (pair_iff_unit_box mu W hW d f hhom hnonneg hzero lam m).mp hp
  obtain ⟨c, hc, hlower⟩ := eventual_power_lower mu W hW d hd f hf.continuousAt hzero hhom
  exact MAIS.Run2PowerLogLowerBound.exponent_le_of_eventual_power_lower horder.2.2 hc hlower

/-- A prior only continuous and strictly positive at the center preserves the
same genuine radius-first exponent bound. -/
theorem exponent_le_weight_ratio_positive_prior
    (mu : Measure (I → ℝ)) [Measure.IsAddHaarMeasure mu]
    (W : I → ℕ) (hW : ∀ i, 0 < W i) (d : ℕ) (hd : 0 < d)
    (f prior : (I → ℝ) → ℝ) (hf : Continuous f) (hzero : f 0 = 0)
    (hnonneg : ∀ x, 0 ≤ f x)
    (hhom : ∀ r : ℝ, 0 < r → ∀ x, f (dilation W r x) = r ^ d * f x)
    (hprior : ContinuousAt prior 0) (hpos : 0 < prior 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair (mu.withDensity (fun x => ENNReal.ofReal (prior x)))
      (Metric.ball 0) f 0 lam m) :
    lam ≤ ((∑ i, W i : ℕ) : ℝ) / d := by
  apply exponent_le_weight_ratio mu W hW d hd f hf hzero hnonneg hhom
  exact (MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior
    mu hf.measurable hprior hpos).mpr hp

end MAIS.Run2WeightedCubeBound

/-- info: 'MAIS.Run2WeightedCubeBound.exists_positive_small_box' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2WeightedCubeBound.exists_positive_small_box

/-- info: 'MAIS.Run2WeightedCubeBound.eventual_power_lower' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2WeightedCubeBound.eventual_power_lower

/-- info: 'MAIS.Run2WeightedCubeBound.exponent_le_weight_ratio' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2WeightedCubeBound.exponent_le_weight_ratio

/-- info: 'MAIS.Run2WeightedCubeBound.exponent_le_weight_ratio_positive_prior' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2WeightedCubeBound.exponent_le_weight_ratio_positive_prior
end
end
-- ==================== end module O7.Run2WeightedCubeBound ====================

-- ==================== begin module O7.Run2PotentialExponentialBound (formalization/O7/Run2PotentialExponentialBound.lean) ====================
section

/-! Actual Haar cube bounds for arbitrary positive REAL diagonal weights.
The exponential action matches the existing literal slot-potential gauge
identity, avoiding denominator choices while retaining measured semantics. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1200000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal

namespace MAIS.Run2PotentialExponentialBound
open MAIS.AnalyticTransfer O77.Residual O77.PowerLogUniqueness
variable {I : Type*} [Fintype I] [DecidableEq I]

def scale (w : I → ℝ) (s : ℝ) (x : I → ℝ) : I → ℝ :=
  fun i => Real.exp (s * w i) * x i

omit [Fintype I] [DecidableEq I] in
theorem scale_add (w : I → ℝ) (s t : ℝ) (x : I → ℝ) :
    scale w s (scale w t x) = scale w (s + t) x := by
  funext i
  simp only [scale, add_mul, Real.exp_add]
  ring

omit [Fintype I] [DecidableEq I] in
@[simp] theorem scale_zero (w : I → ℝ) (x : I → ℝ) : scale w 0 x = x := by
  funext i
  simp [scale]

def scaleEquiv (w : I → ℝ) (s : ℝ) : (I → ℝ) ≃L[ℝ] (I → ℝ) :=
  ({ toFun := scale w s
     invFun := scale w (-s)
     left_inv := by intro x; rw [scale_add]; simp
     right_inv := by intro x; rw [scale_add]; simp
     map_add' := by intro x y; funext i; simp only [scale, Pi.add_apply]; ring
     map_smul' := by
       intro c x; funext i
       simp only [scale, Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
       ring } : (I → ℝ) ≃ₗ[ℝ] (I → ℝ)).toContinuousLinearEquiv

theorem det_scaleEquiv (w : I → ℝ) (s : ℝ) :
    ((scaleEquiv w s : (I → ℝ) →L[ℝ] (I → ℝ))).det =
      Real.exp (s * ∑ i, w i) := by
  change LinearMap.det (scaleEquiv w s).toLinearEquiv.toLinearMap = _
  rw [← LinearMap.det_toMatrix']
  have hm : LinearMap.toMatrix' (scaleEquiv w s).toLinearEquiv.toLinearMap =
      Matrix.diagonal (fun i => Real.exp (s * w i)) := by
    ext i j
    rw [LinearMap.toMatrix'_apply]
    by_cases h : i = j <;> simp [scaleEquiv, scale, h]
  rw [hm, Matrix.det_diagonal, ← Real.exp_sum, Finset.mul_sum]

/-- The actual volume factor is computed from the literal diagonal linear
equivalence, for arbitrary Haar normalization and even an empty index. -/
theorem measure_scale_image (mu : Measure (I → ℝ)) [Measure.IsAddHaarMeasure mu]
    (w : I → ℝ) (s : ℝ) (U : Set (I → ℝ)) :
    mu (scale w s '' U) = ENNReal.ofReal (Real.exp (s * ∑ i, w i)) * mu U := by
  have h := mu.addHaar_image_continuousLinearEquiv (scaleEquiv w s) U
  change mu (scale w s '' U) = _ at h
  change mu (scale w s '' U) =
    ENNReal.ofReal |((scaleEquiv w s : (I → ℝ) →L[ℝ] (I → ℝ))).det| * mu U at h
  rw [det_scaleEquiv, abs_of_pos (Real.exp_pos _)] at h
  exact h

omit [DecidableEq I] in
/-- Continuity constructs a genuine positive-volume compact box inside ANY
prescribed ball, on which the actual loss is below one. -/
theorem exists_positive_box_in_ball
    (mu : Measure (I → ℝ)) [Measure.IsAddHaarMeasure mu]
    (f : (I → ℝ) → ℝ) (hf : ContinuousAt f 0) (hzero : f 0 = 0)
    (R : ℝ) (hR : 0 < R) :
    ∃ U : Set (I → ℝ), 0 < mu U ∧ mu U ≠ ∞ ∧ U ⊆ Metric.ball 0 R ∧
      ∀ x ∈ U, f x < 1 := by
  let g : (I → ℝ) → ℝ := fun x => max (f x) (‖x‖ / R)
  have hg : ContinuousAt g 0 := hf.max (continuousAt_id.norm.div_const R)
  have hgzero : g 0 = 0 := by simp [g, hzero]
  obtain ⟨U, _, hUp, hUfin, _, hUg⟩ :=
    MAIS.Run2WeightedCubeBound.exists_positive_small_box mu (fun _ : I => 1)
      (fun _ => Nat.zero_lt_one) g hg hgzero
  refine ⟨U, hUp, hUfin, ?_, ?_⟩
  · intro x hx
    have hnorm : ‖x‖ / R < 1 := (le_max_right _ _).trans_lt (hUg x hx)
    have hn : ‖x‖ < R := (div_lt_one hR).mp hnorm
    simpa only [Metric.mem_ball, dist_zero_right] using hn
  · exact fun x hx => (le_max_left _ _).trans_lt (hUg x hx)

/-- Every fixed actual ball has the genuine power lower envelope dictated by
the real weighted action. There is no pre-assumed volume estimate. -/
theorem eventual_power_lower
    (mu : Measure (I → ℝ)) [Measure.IsAddHaarMeasure mu]
    (w : I → ℝ) (hw : ∀ i, 0 < w i) (D : ℝ) (hD : 0 < D)
    (f : (I → ℝ) → ℝ) (hf : ContinuousAt f 0) (hzero : f 0 = 0)
    (hnonneg : ∀ x, 0 ≤ f x)
    (hhom : ∀ s : ℝ, ∀ x, f (scale w s x) = Real.exp (s * D) * f x)
    (R : ℝ) (hR : 0 < R) :
    ∃ c : ℝ, 0 < c ∧ ∀ᶠ t : ℝ in atTop,
      ENNReal.ofReal c * powerLogZero ((∑ i, w i) / D) 0 (Real.exp (-t)) ≤
        bandMass mu (Metric.ball 0) f 0 R (Real.exp (-t)) := by
  obtain ⟨U, hUp, hUfin, hUball, hUf⟩ :=
    exists_positive_box_in_ball mu f hf hzero R hR
  let c : ℝ := (mu U).toReal
  have hc : 0 < c := ENNReal.toReal_pos hUp.ne' hUfin
  refine ⟨c, hc, ?_⟩
  filter_upwards [eventually_ge_atTop (0 : ℝ)] with t ht
  let s : ℝ := -t / D
  have hs : s ≤ 0 := div_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr ht) hD.le
  have hdegree : Real.exp (s * D) = Real.exp (-t) := by
    congr 1
    dsimp [s]
    field_simp
  have hsubset : scale w s '' U ⊆
      {x | x ∈ Metric.ball 0 R ∧ |f x - f 0| < Real.exp (-t)} := by
    rintro x ⟨y, hy, rfl⟩
    constructor
    · rw [Metric.mem_ball, dist_pi_lt_iff hR]
      intro i
      have hyi : |y i| < R := by
        have h := hUball hy
        rw [Metric.mem_ball, dist_pi_lt_iff hR] at h
        simpa only [Pi.zero_apply, Real.dist_eq, sub_zero] using h i
      have hp : Real.exp (s * w i) ≤ 1 :=
        Real.exp_le_one_iff.mpr (mul_nonpos_of_nonpos_of_nonneg hs (hw i).le)
      simp only [scale, Pi.zero_apply, Real.dist_eq, sub_zero,
        abs_mul, abs_of_pos (Real.exp_pos _)]
      exact (mul_le_of_le_one_left (abs_nonneg _) hp).trans_lt hyi
    · rw [hzero, sub_zero, abs_of_nonneg (hnonneg _), hhom s y, hdegree]
      simpa only [mul_one] using
        mul_lt_mul_of_pos_left (hUf y hy) (Real.exp_pos (-t))
  have hmeasure : mu (scale w s '' U) ≤
      mu {x | x ∈ Metric.ball 0 R ∧ |f x - f 0| < Real.exp (-t)} := measure_mono hsubset
  rw [measure_scale_image] at hmeasure
  have hpower : Real.exp (s * ∑ i, w i) =
      powerLogZeroReal ((∑ i, w i) / D) 0 (Real.exp (-t)) := by
    rw [gauge_exp]
    simp only [pow_zero, mul_one]
    dsimp [s]
    congr 1
    ring
  rw [hpower] at hmeasure
  change ENNReal.ofReal c * ENNReal.ofReal _ ≤ _
  rw [show ENNReal.ofReal c = mu U by exact ENNReal.ofReal_toReal hUfin]
  simpa only [mul_comm, bandMass] using hmeasure

/-- Arbitrary positive real weights bound the actual radius-first measured
exponent. This exactly matches arbitrary real slot-potential covariance. -/
theorem exponent_le_weight_ratio
    (mu : Measure (I → ℝ)) [Measure.IsAddHaarMeasure mu]
    (w : I → ℝ) (hw : ∀ i, 0 < w i) (D : ℝ) (hD : 0 < D)
    (f : (I → ℝ) → ℝ) (hf : ContinuousAt f 0) (hzero : f 0 = 0)
    (hnonneg : ∀ x, 0 ≤ f x)
    (hhom : ∀ s : ℝ, ∀ x, f (scale w s x) = Real.exp (s * D) * f x)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball 0) f 0 lam m) :
    lam ≤ (∑ i, w i) / D := by
  obtain ⟨_, _, rho, hrho, horder⟩ := hp
  let R : ℝ := rho / 2
  have hR : 0 < R := half_pos hrho
  have hsmall : R < rho := half_lt_self hrho
  obtain ⟨c, hc, hlower⟩ := eventual_power_lower mu w hw D hD f hf hzero hnonneg hhom R hR
  exact MAIS.Run2PowerLogLowerBound.exponent_le_of_eventual_power_lower
    (horder R hR hsmall) hc hlower

end MAIS.Run2PotentialExponentialBound

/-- info: 'MAIS.Run2PotentialExponentialBound.measure_scale_image' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialExponentialBound.measure_scale_image

/-- info: 'MAIS.Run2PotentialExponentialBound.exponent_le_weight_ratio' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialExponentialBound.exponent_le_weight_ratio
end
end
-- ==================== end module O7.Run2PotentialExponentialBound ====================

-- ==================== begin module O7.Run2PotentialNormalBound (formalization/O7/Run2PotentialNormalBound.lean) ====================
section

/-! Arbitrary admissible REAL slot potentials bound the exponent of the
literal complete normal-slice loss and the actual full ambient zero-output
loss. The full normal polynomial is kept fixed while the potential varies;
no residual-pair or volume inequality is assumed. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2PotentialNormalBound
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalDirectElimination MAIS.ActiveIntervalWeightedAction
open MAIS.ActiveIntervalGaussianChart MAIS.ActiveIntervalMeasuredSlice
open MAIS.MatrixChainIsomorphism MAIS.AnalyticTransfer
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

def edgeWeights (q : S → ℝ) (p : NormalIndex birth death) : ℝ :=
  q p.val.1 - q p.val.2

def threshold (q : S → ℝ) : ℝ :=
  (∑ p : NormalIndex birth death, edgeWeights birth death q p) / 2

/-- Arbitrary endpoint-compatible potentials give exact degree two for the
COMPLETE actual normal loss, globally in all independent parameters. -/
theorem normal_loss_homogeneity (q : S → ℝ)
    (hin : ∀ s, birth s = 0 → q s = 0)
    (hout : ∀ s, death s = D + 1 → q s = 1)
    (a : ℝ) (t : NormalParams birth death) :
    normalSquaredLoss D birth death hD
      (MAIS.Run2PotentialExponentialBound.scale (edgeWeights birth death q) a t) =
      Real.exp (a * 2) * normalSquaredLoss D birth death hD t := by
  change ‖fullProduct D birth death hD (scaleExp birth death q a t)‖ ^ 2 =
    Real.exp (a * 2) * ‖fullProduct D birth death hD t‖ ^ 2
  rw [fullProduct_scaleExp D birth death hD q a t hin hout,
    norm_smul, Real.norm_eq_abs, abs_of_pos (Real.exp_pos a), mul_pow]
  have he : (Real.exp a) ^ 2 = Real.exp (a * 2) := by
    rw [← Real.exp_nat_mul]
    congr 1
    ring
  rw [he]

/-- The actual normal measured exponent is at most the actual full-edge
potential threshold. The measured hypothesis mentions no candidate formula. -/
theorem normal_exponent_le_threshold
    (q : S → ℝ) (hin : ∀ s, birth s = 0 → q s = 0)
    (hout : ∀ s, death s = D + 1 → q s = 1)
    (hpos : ∀ p : NormalIndex birth death, 0 < edgeWeights birth death q p)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (mu : Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure mu]
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball 0)
      (normalSquaredLoss D birth death hD) 0 lam m) :
    lam ≤ threshold birth death q := by
  have hz : normalSquaredLoss D birth death hD 0 = 0 := by
    simp only [normalSquaredLoss, normalLoss, ambientLoss, map_zero, add_zero,
      hzero, norm_zero, zero_pow (by decide : 2 ≠ 0)]
  apply MAIS.Run2PotentialExponentialBound.exponent_le_weight_ratio mu
    (edgeWeights birth death q) hpos 2 (by norm_num)
    (normalSquaredLoss D birth death hD)
    (continuous_normalSquaredLoss D birth death hD).continuousAt hz
    (fun _ => sq_nonneg _)
    (normal_loss_homogeneity D birth death hD q hin hout) hp

include hD in
/-- Actual full ambient entry-Haar bands reduce through the already proved
analytic slice chart, then satisfy the same derived potential bound. -/
theorem ambient_exponent_le_threshold
    (hvalid : ∀ s, birth s < death s)
    (q : S → ℝ) (hin : ∀ s, birth s = 0 → q s = 0)
    (hout : ∀ s, death s = D + 1 → q s = 1)
    (hpos : ∀ p : NormalIndex birth death, 0 < edgeWeights birth death q p)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (mu : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure mu]
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (by exact Nat.zero_le D))
      (intervalRep D birth death) lam m) :
    lam ≤ threshold birth death q := by
  let muN : Measure (NormalParams birth death) := MeasureTheory.Measure.addHaar
  have hN := (pair_iff_normal_slice D birth death hD hvalid mu muN
    0 (Fin.last D) (by exact Nat.zero_le D) hzero lam m).mp hp
  exact normal_exponent_le_threshold D birth death hD q hin hout hpos hzero muN hN

include hD in
/-- The ambient prior may couple every matrix entry; continuity and positivity
only at the actual center suffice, via the existing measured prior theorem. -/
theorem ambient_exponent_le_threshold_positive_prior
    (hvalid : ∀ s, birth s < death s)
    (q : S → ℝ) (hin : ∀ s, birth s = 0 → q s = 0)
    (hout : ∀ s, death s = D + 1 → q s = 1)
    (hpos : ∀ p : NormalIndex birth death, 0 < edgeWeights birth death q p)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (mu : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure mu]
    (prior : Ambient D birth death → ℝ)
    (hprior : ContinuousAt prior (intervalRep D birth death))
    (hpriorpos : 0 < prior (intervalRep D birth death))
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair (mu.withDensity (fun A => ENNReal.ofReal (prior A)))
      (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (by exact Nat.zero_le D))
      (intervalRep D birth death) lam m) :
    lam ≤ threshold birth death q := by
  let muN : Measure (NormalParams birth death) := MeasureTheory.Measure.addHaar
  have hN := (pair_iff_normal_slice_prior D birth death hD hvalid mu muN
    0 (Fin.last D) (by exact Nat.zero_le D) hzero prior hprior hpriorpos lam m).mp hp
  exact normal_exponent_le_threshold D birth death hD q hin hout hpos hzero muN hN

end MAIS.Run2PotentialNormalBound

/-- info: 'MAIS.Run2PotentialNormalBound.normal_loss_homogeneity' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialNormalBound.normal_loss_homogeneity

/-- info: 'MAIS.Run2PotentialNormalBound.normal_exponent_le_threshold' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialNormalBound.normal_exponent_le_threshold

/-- info: 'MAIS.Run2PotentialNormalBound.ambient_exponent_le_threshold' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialNormalBound.ambient_exponent_le_threshold

/-- info: 'MAIS.Run2PotentialNormalBound.ambient_exponent_le_threshold_positive_prior' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialNormalBound.ambient_exponent_le_threshold_positive_prior
end
end
-- ==================== end module O7.Run2PotentialNormalBound ====================

-- ==================== begin module O7.Run2PotentialStationarity (formalization/O7/Run2PotentialStationarity.lean) ====================
section

/-! Finite labeled-edge potential variation. Incidence counts are literal
finite fibers, and their balance is proved by an actual two-sided admissible
perturbation. This is a finite variational lemma; the separate normal-bound
adapter supplies its optimality premise from actual measured volumes. -/
set_option autoImplicit false
set_option maxHeartbeats 1200000
noncomputable section
open Set Filter
open scoped Topology

namespace MAIS.Run2PotentialStationarity
variable {S E : Type*} [Fintype E] [DecidableEq S]

def fiberCount (f : E → S) (v : S) : ℕ :=
  (Finset.univ.filter (fun e => f e = v)).card

def imbalance (src dst : E → S) (v : S) : ℝ :=
  (fiberCount dst v : ℝ) - (fiberCount src v : ℝ)

def threshold (src dst : E → S) (q : S → ℝ) : ℝ :=
  (∑ e, (q (dst e) - q (src e))) / 2

def Admissible (src dst : E → S) (inputs outputs : Finset S) (q : S → ℝ) : Prop :=
  (∀ v ∈ inputs, q v = 0) ∧ (∀ v ∈ outputs, q v = 1) ∧
    ∀ e, q (src e) < q (dst e)

def perturb (q : S → ℝ) (v : S) (h : ℝ) : S → ℝ :=
  fun x => q x + h * (if x = v then 1 else 0)

omit [Fintype E] in
@[simp] theorem perturb_zero (q : S → ℝ) (v : S) : perturb q v 0 = q := by
  funext x
  simp [perturb]

omit [Fintype E] in
theorem continuous_perturb_entry (q : S → ℝ) (v x : S) :
    Continuous (fun h : ℝ => perturb q v h x) :=
  continuous_const.add (continuous_id.mul_const _)

theorem sum_indicator_fiber (f : E → S) (v : S) :
    (∑ e, if f e = v then (1 : ℝ) else 0) = (fiberCount f v : ℝ) := by
  simp [fiberCount]

/-- The coefficient of the independently varied label is the true integer
incoming-minus-outgoing edge count, even for repeated or parallel labels. -/
theorem threshold_perturb (src dst : E → S) (q : S → ℝ) (v : S) (h : ℝ) :
    threshold src dst (perturb q v h) = threshold src dst q + h * imbalance src dst v / 2 := by
  have hsum :
      (∑ e, (perturb q v h (dst e) - perturb q v h (src e))) =
      (∑ e, (q (dst e) - q (src e))) +
        h * ((∑ e, if dst e = v then (1 : ℝ) else 0) -
          ∑ e, if src e = v then (1 : ℝ) else 0) := by
    simp only [perturb, Finset.sum_sub_distrib, Finset.sum_add_distrib,
      ← Finset.mul_sum]
    ring
  unfold threshold
  rw [hsum, sum_indicator_fiber, sum_indicator_fiber]
  unfold imbalance
  ring

/-- Every interior slot admits actual perturbations of BOTH signs preserving
all finitely many strict edge inequalities and all endpoint values. -/
theorem eventually_admissible_perturb (src dst : E → S)
    (inputs outputs : Finset S) (q : S → ℝ)
    (hq : Admissible src dst inputs outputs q) (v : S)
    (hin : v ∉ inputs) (hout : v ∉ outputs) :
    ∀ᶠ h : ℝ in nhds 0, Admissible src dst inputs outputs (perturb q v h) := by
  have hedge : ∀ e, ∀ᶠ h : ℝ in nhds 0,
      perturb q v h (src e) < perturb q v h (dst e) := by
    intro e
    apply (isOpen_lt (continuous_perturb_entry q v (src e))
      (continuous_perturb_entry q v (dst e))).mem_nhds
    change perturb q v 0 (src e) < perturb q v 0 (dst e)
    simpa only [perturb, zero_mul, add_zero] using hq.2.2 e
  filter_upwards [Filter.eventually_all.mpr hedge] with h hh
  refine ⟨?_, ?_, hh⟩
  · intro x hx
    have hxv : x ≠ v := by intro he; subst x; exact hin hx
    simp only [perturb, ite_eq_right hxv, mul_zero, add_zero, hq.1 x hx]
  · intro x hx
    have hxv : x ≠ v := by intro he; subst x; exact hout hx
    simp only [perturb, ite_eq_right hxv, mul_zero, add_zero, hq.2.1 x hx]

/-- A true local minimum of the finite edge-potential sum has balanced
integer incidence at every free interior slot. The later measured adapter
DERIVES this minimality from the actual exponent lower bound. -/
theorem balanced_at_interior_of_minimum (src dst : E → S)
    (inputs outputs : Finset S) (q : S → ℝ)
    (hq : Admissible src dst inputs outputs q)
    (hmin : ∀ q' : S → ℝ, Admissible src dst inputs outputs q' →
      threshold src dst q ≤ threshold src dst q')
    (v : S) (hin : v ∉ inputs) (hout : v ∉ outputs) :
    fiberCount dst v = fiberCount src v := by
  have hnear := eventually_admissible_perturb src dst inputs outputs q hq v hin hout
  obtain ⟨delta, hd, hball⟩ := Metric.mem_nhds_iff.mp hnear
  have hplus : Admissible src dst inputs outputs (perturb q v (delta / 2)) := by
    apply hball
    simpa only [Metric.mem_ball, Real.dist_eq, sub_zero,
      abs_of_pos (half_pos hd)] using half_lt_self hd
  have hminus : Admissible src dst inputs outputs (perturb q v (-(delta / 2))) := by
    apply hball
    simpa only [Metric.mem_ball, Real.dist_eq, sub_zero, abs_neg,
      abs_of_pos (half_pos hd)] using half_lt_self hd
  have hp := hmin _ hplus
  have hn := hmin _ hminus
  rw [threshold_perturb] at hp hn
  have hz : (delta / 2) * imbalance src dst v = 0 := by
    apply le_antisymm <;> nlinarith
  have hc : imbalance src dst v = 0 :=
    (mul_eq_zero.mp hz).resolve_left (ne_of_gt (half_pos hd))
  have he : (fiberCount dst v : ℝ) = (fiberCount src v : ℝ) := sub_eq_zero.mp hc
  exact_mod_cast he

variable [Fintype S]

/-- Regroup a literal edge sum over the actual finite vertex fibers. -/
theorem sum_over_fibers (f : E → S) (q : S → ℝ) :
    (∑ e, q (f e)) = ∑ v, (fiberCount f v : ℝ) * q v := by
  calc
    (∑ e, q (f e)) = ∑ e, ∑ v, if f e = v then q v else 0 := by
      apply Finset.sum_congr rfl
      intro e _
      simp [eq_comm]
    _ = ∑ v, ∑ e, if f e = v then q v else 0 := Finset.sum_comm
    _ = ∑ v, (fiberCount f v : ℝ) * q v := by
      apply Finset.sum_congr rfl
      intro v _
      rw [← sum_indicator_fiber f v, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro e _
      split_ifs <;> simp

/-- The exact incoming-minus-outgoing telescoping identity. -/
theorem sum_edge_differences (src dst : E → S) (q : S → ℝ) :
    (∑ e, (q (dst e) - q (src e))) = ∑ v, imbalance src dst v * q v := by
  rw [Finset.sum_sub_distrib, sum_over_fibers, sum_over_fibers,
    ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro v _
  unfold imbalance
  ring

def outputEdgeCount (dst : E → S) (outputs : Finset S) : ℕ :=
  (Finset.univ.filter (fun e => dst e ∈ outputs)).card

/-- Balanced free vertices leave exactly the number of output-target edges.
This is an independently proved integer identity, including empty graphs. -/
theorem threshold_eq_half_output_count (src dst : E → S)
    (inputs outputs : Finset S) (q : S → ℝ)
    (hq : Admissible src dst inputs outputs q)
    (hbal : ∀ v, v ∉ inputs → v ∉ outputs → fiberCount dst v = fiberCount src v)
    (hnoout : ∀ e, src e ∉ outputs) :
    threshold src dst q = (outputEdgeCount dst outputs : ℝ) / 2 := by
  let qOut : S → ℝ := fun v => if v ∈ outputs then 1 else 0
  have hterms : ∀ v, imbalance src dst v * q v = imbalance src dst v * qOut v := by
    intro v
    by_cases ho : v ∈ outputs
    · simp only [qOut, ite_eq_left ho, hq.2.1 v ho]
    · by_cases hi : v ∈ inputs
      · simp only [qOut, ite_eq_right ho, hq.1 v hi]
      · have hz : imbalance src dst v = 0 := by
          simp only [imbalance, hbal v hi ho, sub_self]
        rw [hz, zero_mul, zero_mul]
  have he : (∑ e, (q (dst e) - q (src e))) =
      ∑ e, (qOut (dst e) - qOut (src e)) := by
    rw [sum_edge_differences, sum_edge_differences]
    exact Finset.sum_congr rfl (fun v _ => hterms v)
  have hsrc : ∀ e, qOut (src e) = 0 := by
    intro e
    simp only [qOut, ite_eq_right (hnoout e)]
  have hcount : (∑ e, (qOut (dst e) - qOut (src e))) =
      (outputEdgeCount dst outputs : ℝ) := by
    simp_rw [hsrc, sub_zero]
    simp [qOut, outputEdgeCount]
  unfold threshold
  rw [he, hcount]

end MAIS.Run2PotentialStationarity

/-- info: 'MAIS.Run2PotentialStationarity.threshold_perturb' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialStationarity.threshold_perturb

/-- info: 'MAIS.Run2PotentialStationarity.eventually_admissible_perturb' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialStationarity.eventually_admissible_perturb

/-- info: 'MAIS.Run2PotentialStationarity.balanced_at_interior_of_minimum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialStationarity.balanced_at_interior_of_minimum

/-- info: 'MAIS.Run2PotentialStationarity.sum_edge_differences' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialStationarity.sum_edge_differences

/-- info: 'MAIS.Run2PotentialStationarity.threshold_eq_half_output_count' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialStationarity.threshold_eq_half_output_count
end
end
-- ==================== end module O7.Run2PotentialStationarity ====================

-- ==================== begin module O7.Run2PotentialBalance (formalization/O7/Run2PotentialBalance.lean) ====================
section

/-! Actual measured potential stationarity for the complete normal polynomial.
The finite variational hypothesis is DERIVED from the measured exponent bound
for every admissible real potential. Radial equality therefore forces literal
integer normal-incidence balance and a natural half-integral exponent. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2PotentialBalance
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianChart MAIS.ActiveIntervalMeasuredSlice
open MAIS.Run2PotentialNormalBound MAIS.MatrixChainIsomorphism MAIS.AnalyticTransfer
open MAIS.Run2PotentialStationarity (fiberCount outputEdgeCount)
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

def sourceSlot (p : NormalIndex birth death) : S := p.val.2
def targetSlot (p : NormalIndex birth death) : S := p.val.1
def inputSlots : Finset S := Finset.univ.filter (fun s => birth s = 0)
def outputSlots : Finset S := Finset.univ.filter (fun s => death s = D + 1)

/-- Endpoint values and strict positivity on every actual normal coordinate.
Repeated interval labels remain independent coordinates. -/
def AdmissiblePotential (q : S → ℝ) : Prop :=
  MAIS.Run2PotentialStationarity.Admissible
    (sourceSlot birth death) (targetSlot birth death)
    (inputSlots birth) (outputSlots D death) q

theorem bound_of_normal_pair (q : S → ℝ)
    (hq : AdmissiblePotential D birth death q)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (mu : Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure mu]
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball 0)
      (normalSquaredLoss D birth death hD) 0 lam m) :
    lam ≤ threshold birth death q := by
  rcases hq with ⟨hin, hout, hpos⟩
  apply normal_exponent_le_threshold D birth death hD q
    (fun s hs => hin s (by simp [inputSlots, hs]))
    (fun s hs => hout s (by simp [outputSlots, hs]))
    (fun p => sub_pos.mpr (hpos p)) hzero mu hp

/-- Equality with a potential threshold forces true count balance at every
interior slot. No optimality or balance premise is supplied: it follows from
the actual measured bounds under both signs of potential perturbation. -/
theorem balanced_of_normal_threshold_eq (q : S → ℝ)
    (hq : AdmissiblePotential D birth death q)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (mu : Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure mu]
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball 0)
      (normalSquaredLoss D birth death hD) 0 lam m)
    (heq : lam = threshold birth death q)
    (v : S) (hin : birth v ≠ 0) (hout : death v ≠ D + 1) :
    fiberCount (targetSlot birth death) v = fiberCount (sourceSlot birth death) v := by
  apply MAIS.Run2PotentialStationarity.balanced_at_interior_of_minimum
    (sourceSlot birth death) (targetSlot birth death)
    (inputSlots birth) (outputSlots D death) q hq
    (v := v)
  · intro q' hq'
    have hb := bound_of_normal_pair D birth death hD q' hq' hzero mu hp
    rw [heq] at hb
    exact hb
  · simpa only [inputSlots, Finset.mem_filter, Finset.mem_univ, true_and] using hin
  · simpa only [outputSlots, Finset.mem_filter, Finset.mem_univ, true_and] using hout

include hD in
omit [DecidableEq S] in
theorem source_not_output (p : NormalIndex birth death) :
    sourceSlot birth death p ∉ outputSlots D death := by
  intro hp
  have hs : death p.val.2 = D + 1 := by
    simpa only [sourceSlot, outputSlots, Finset.mem_filter, Finset.mem_univ, true_and] using hp
  have he := p.property.2.2
  have hb := hD p.val.1
  omega

/-- At every actual radial equality, twice the actual measured exponent is
the literal natural number of output-target normal coordinates. -/
theorem normal_radial_exponent_eq_half_output_count (q : S → ℝ)
    (hq : AdmissiblePotential D birth death q)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (mu : Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure mu]
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball 0)
      (normalSquaredLoss D birth death hD) 0 lam m)
    (heq : lam = threshold birth death q) :
    lam = (outputEdgeCount (targetSlot birth death) (outputSlots D death) : ℝ) / 2 := by
  have hbal : ∀ v, v ∉ inputSlots birth → v ∉ outputSlots D death →
      fiberCount (targetSlot birth death) v = fiberCount (sourceSlot birth death) v := by
    intro v hi ho
    apply balanced_of_normal_threshold_eq D birth death hD q hq hzero mu hp heq v
    · simpa only [inputSlots, Finset.mem_filter, Finset.mem_univ, true_and] using hi
    · simpa only [outputSlots, Finset.mem_filter, Finset.mem_univ, true_and] using ho
  have hcount := MAIS.Run2PotentialStationarity.threshold_eq_half_output_count
    (sourceSlot birth death) (targetSlot birth death)
    (inputSlots birth) (outputSlots D death) q hq hbal
    (source_not_output D birth death hD)
  exact heq.trans hcount

theorem normal_radial_exponent_half_integer (q : S → ℝ)
    (hq : AdmissiblePotential D birth death q)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (mu : Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure mu]
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball 0)
      (normalSquaredLoss D birth death hD) 0 lam m)
    (heq : lam = threshold birth death q) :
    ∃ k : ℕ, lam = (k : ℝ) / 2 :=
  ⟨_, normal_radial_exponent_eq_half_output_count D birth death hD q hq hzero mu hp heq⟩

include hD in
/-- The same radial half-integrality concerns the FULL ambient parameter
measure, not just a normal-slice model. -/
theorem ambient_radial_exponent_half_integer
    (hvalid : ∀ s, birth s < death s) (q : S → ℝ)
    (hq : AdmissiblePotential D birth death q)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (mu : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure mu]
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (by exact Nat.zero_le D))
      (intervalRep D birth death) lam m)
    (heq : lam = threshold birth death q) :
    ∃ k : ℕ, lam = (k : ℝ) / 2 := by
  let muN : Measure (NormalParams birth death) := MeasureTheory.Measure.addHaar
  have hN := (pair_iff_normal_slice D birth death hD hvalid mu muN
    0 (Fin.last D) (by exact Nat.zero_le D) hzero lam m).mp hp
  exact normal_radial_exponent_half_integer D birth death hD q hq hzero muN hN heq

include hD in
/-- Arbitrary coupled positive continuous ambient priors retain the actual
radial half-integrality result. -/
theorem ambient_radial_exponent_half_integer_positive_prior
    (hvalid : ∀ s, birth s < death s) (q : S → ℝ)
    (hq : AdmissiblePotential D birth death q)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (mu : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure mu]
    (prior : Ambient D birth death → ℝ)
    (hprior : ContinuousAt prior (intervalRep D birth death))
    (hpriorpos : 0 < prior (intervalRep D birth death))
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair (mu.withDensity (fun A => ENNReal.ofReal (prior A)))
      (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (by exact Nat.zero_le D))
      (intervalRep D birth death) lam m)
    (heq : lam = threshold birth death q) :
    ∃ k : ℕ, lam = (k : ℝ) / 2 := by
  let muN : Measure (NormalParams birth death) := MeasureTheory.Measure.addHaar
  have hN := (pair_iff_normal_slice_prior D birth death hD hvalid mu muN
    0 (Fin.last D) (by exact Nat.zero_le D) hzero prior hprior hpriorpos lam m).mp hp
  exact normal_radial_exponent_half_integer D birth death hD q hq hzero muN hN heq

end MAIS.Run2PotentialBalance

