/-! Actual complete-network loss comparison in its genuine full ambient slice.
The normal block decomposition is an explicit structural hypothesis, to be
derived separately from actual full-span interval isolation. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace MAIS.Run2PositiveNetworkLoss
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.OrbitSliceChart MAIS.OrbitSliceLoss MAIS.MatrixSmoothMul
open MAIS.Run2PositivePathDerivative MAIS.Run2PositiveEndpointRegular MAIS.Run2PositiveRegularChart
open MAIS.Run2SchurOutputCoordinates MAIS.Run2SchurPositiveLossComparison
open scoped Matrix Matrix.Norms.Frobenius Topology
variable {D : ℕ} {R : Type*} [Fintype R] [DecidableEq R]
  (κ : Fin (D+1) → Type*) [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

/-- Literal complementary complete product on an actual linear normal space. -/
def normalResidual (A : Rep (Carrier (R:=R) κ))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ))) (x : N) :
    Matrix (κ (Fin.last D)) (κ 0) ℝ :=
  (pathMatrix (A+(x : Rep (Carrier (R:=R) κ))) 0 (Fin.last D) (Fin.zero_le _)).toBlocks₂₂

theorem continuous_normalResidual (A : Rep (Carrier (R:=R) κ))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ))) : Continuous (normalResidual κ A N) :=
  (submatrixCLM (I:=R⊕κ (Fin.last D)) (J:=R⊕κ 0) (K:=κ (Fin.last D)) (L:=κ 0)
    Sum.inr Sum.inr).continuous.comp
      ((contDiff_pathMatrix (Carrier (R:=R) κ) 0 (Fin.last D) (Fin.zero_le _)).continuous.comp
        (continuous_const.add N.subtypeL.continuous))

@[simp] theorem normalResidual_zero (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ))) : normalResidual κ A N 0 = 0 := by
  simp only [normalResidual,ZeroMemClass.coe_zero,add_zero,hA,standardTarget,
    Matrix.toBlocks_fromBlocks₂₂]

/-- All constants in the actual network loss comparison are derived. The
only extra structural input is a literal identity for its normal products. -/
theorem exists_network_loss_comparison
    (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (N : Submodule ℝ (Rep (Carrier (R:=R) κ)))
    (hsplit : ∀ x : N, pathMatrix (A+(x : Rep (Carrier (R:=R) κ)))
      0 (Fin.last D) (Fin.zero_le _) = Matrix.fromBlocks (1 : Matrix R R ℝ)
        0 0 (normalResidual κ A N x)) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ p : H × N in 𝓝 0,
      (‖regularMap κ A H N p‖^2+‖normalResidual κ A N p.2‖^2)/C ≤
        ‖pathMatrix (sliceMap (Carrier (R:=R) κ) A H N p) 0 (Fin.last D) (Fin.zero_le _)-standardTarget‖^2 ∧
      ‖pathMatrix (sliceMap (Carrier (R:=R) κ) A H N p) 0 (Fin.last D) (Fin.zero_le _)-standardTarget‖^2 ≤
        C*(‖regularMap κ A H N p‖^2+‖normalResidual κ A N p.2‖^2) := by
  let dx (v : Fin (D+1)) : H × N →L[ℝ] Matrix (Carrier (R:=R) κ v) (Carrier (R:=R) κ v) ℝ :=
    (ContinuousLinearMap.proj v).comp (H.subtypeL.comp (ContinuousLinearMap.fst ℝ H N))
  let L := fun p : H × N => NormedSpace.exp (dx (Fin.last D) p)
  let Z := fun p : H × N => NormedSpace.exp (-(dx 0 p))
  let S := fun p : H × N => normalResidual κ A N p.2
  have hL : ContinuousAt L 0 := (NormedSpace.exp_continuous.comp (dx (Fin.last D)).continuous).continuousAt
  have hZ : ContinuousAt Z 0 := (NormedSpace.exp_continuous.comp (dx 0).continuous.neg).continuousAt
  have hS : ContinuousAt S 0 := ((continuous_normalResidual κ A N).comp continuous_snd).continuousAt
  have hL0 : L 0 = 1 := by simp [L]
  have hZ0 : Z 0 = 1 := by simp [Z]
  have hS0 : S 0 = 0 := normalResidual_zero κ A hA N
  obtain ⟨C,hC,h⟩ := exists_complete_loss_comparison L Z S 0 hL hZ hS hL0 hZ0 hS0
  refine ⟨C,hC, ?_⟩
  have he (p : H × N) : L p * Matrix.fromBlocks (1 : Matrix R R ℝ) 0 0 (S p) * Z p =
      pathMatrix (sliceMap (Carrier (R:=R) κ) A H N p) 0 (Fin.last D) (Fin.zero_le _) := by
    rw [pathMatrix_sliceMap,hsplit]
    rfl
  filter_upwards [h] with p hp
  simpa only [he,regularMap,S] using hp

end MAIS.Run2PositiveNetworkLoss

/-- info: 'MAIS.Run2PositiveNetworkLoss.continuous_normalResidual' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveNetworkLoss.continuous_normalResidual

/-- info: 'MAIS.Run2PositiveNetworkLoss.normalResidual_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveNetworkLoss.normalResidual_zero

