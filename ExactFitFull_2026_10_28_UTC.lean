-- ==================== begin module O7.ActiveIntervalCoordinates (formalization/O7/ActiveIntervalCoordinates.lean) ====================
section

/-! Actual entry-coordinate linear equivalences for arbitrary finite
half-open interval slots. Empty slots and zero-dimensional vertices are allowed. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
noncomputable section
namespace MAIS.ActiveIntervalCoordinates

open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.IntervalBlockRank
open MAIS.IntervalBlockDifferential MAIS.ActiveIntervalDifferential

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

abbrev VertexCochains := (r s : S) →
  Fin (vertexCount (birth s) (death s) (birth r) (death r)) → ℝ

abbrev ArrowCochains := (r s : S) →
  Fin (arrowCount (birth s) (death s) (birth r) (death r)) → ℝ

/-- The physical overlap vertex belonging to one actual ordered interval pair. -/
def physicalVertex (r s : S)
    (j : Fin (vertexCount (birth s) (death s) (birth r) (death r))) : Fin (D + 1) :=
  ⟨max (birth s) (birth r) + j.val, by
    have hh := overlap_vertex_active (birth s) (death s) (birth r) (death r) j
    have hd := hD r
    omega⟩

def vertexRow (r s : S)
    (j : Fin (vertexCount (birth s) (death s) (birth r) (death r))) :
    Index D birth death (physicalVertex D birth death hD r s j) :=
  ⟨r, by
    have hh := overlap_vertex_active (birth s) (death s) (birth r) (death r) j
    exact ⟨hh.2.2.1, hh.2.2.2⟩⟩

def vertexColumn (r s : S)
    (j : Fin (vertexCount (birth s) (death s) (birth r) (death r))) :
    Index D birth death (physicalVertex D birth death hD r s j) :=
  ⟨s, by
    have hh := overlap_vertex_active (birth s) (death s) (birth r) (death r) j
    exact ⟨hh.1, hh.2.1⟩⟩

omit hD in
/-- Every literal Lie entry has a unique overlap-coordinate number. -/
def vertexCoordinate (v : Fin (D + 1)) (r s : Index D birth death v) :
    Fin (vertexCount (birth s.val) (death s.val) (birth r.val) (death r.val)) :=
  ⟨v.val - max (birth s.val) (birth r.val), by
    have hr := r.property
    have hs := s.property
    dsimp [active] at hr hs
    dsimp [vertexCount]
    omega⟩

omit [Fintype S] [DecidableEq S] in
theorem physicalVertex_coordinate (v : Fin (D + 1)) (r s : Index D birth death v) :
    physicalVertex D birth death hD r.val s.val (vertexCoordinate D birth death v r s) = v := by
  apply Fin.ext
  change max (birth s.val) (birth r.val) +
    (v.val - max (birth s.val) (birth r.val)) = v.val
  have hr := r.property
  have hs := s.property
  dsimp [active] at hr hs
  omega

omit [Fintype S] [DecidableEq S] in
theorem vertexCoordinate_physical (r s : S)
    (j : Fin (vertexCount (birth s) (death s) (birth r) (death r))) :
    vertexCoordinate D birth death (physicalVertex D birth death hD r s j)
      (vertexRow D birth death hD r s j) (vertexColumn D birth death hD r s j) = j := by
  apply Fin.ext
  change max (birth s) (birth r) + j.val - max (birth s) (birth r) = j.val
  omega

omit hD [Fintype S] [DecidableEq S] in
lemma lie_entry_congr (X : Lie (Index D birth death))
    {v u : Fin (D + 1)} (r s : Index D birth death v) (r' s' : Index D birth death u)
    (hu : u = v) (hr : r'.val = r.val) (hs : s'.val = s.val) :
    X u r' s' = X v r s := by
  cases hu
  rw [Subtype.ext hr, Subtype.ext hs]

/-- Read the literal matrix entry at its actual overlap vertex. -/
def encodeLie (X : Lie (Index D birth death)) : VertexCochains birth death :=
  fun r s j => X (physicalVertex D birth death hD r s j)
    (vertexRow D birth death hD r s j) (vertexColumn D birth death hD r s j)

omit hD in
/-- Place each interval-pair coordinate back in its literal physical entry. -/
def decodeLie (Y : VertexCochains birth death) : Lie (Index D birth death) :=
  fun v r s => Y r.val s.val (vertexCoordinate D birth death v r s)

/-- A genuine linear equivalence in all original Lie matrix entries. -/
def lieEquiv : Lie (Index D birth death) ≃ₗ[ℝ] VertexCochains birth death where
  toFun := encodeLie D birth death hD
  invFun := decodeLie D birth death
  left_inv := by
    intro X
    funext v r s
    exact lie_entry_congr D birth death X r s
      (vertexRow D birth death hD r.val s.val (vertexCoordinate D birth death v r s))
      (vertexColumn D birth death hD r.val s.val (vertexCoordinate D birth death v r s))
      (physicalVertex_coordinate D birth death hD v r s) rfl rfl
  right_inv := by
    intro Y
    funext r s j
    change Y r s (vertexCoordinate D birth death (physicalVertex D birth death hD r s j)
      (vertexRow D birth death hD r s j) (vertexColumn D birth death hD r s j)) = Y r s j
    rw [vertexCoordinate_physical]
  map_add' := by intro X Y; rfl
  map_smul' := by intro r X; rfl

omit [Fintype S] [DecidableEq S] in
@[simp]
theorem lieEquiv_apply (X : Lie (Index D birth death)) (r s : S)
    (j : Fin (vertexCount (birth s) (death s) (birth r) (death r))) :
    lieEquiv D birth death hD X r s j = X (physicalVertex D birth death hD r s j)
      (vertexRow D birth death hD r s j) (vertexColumn D birth death hD r s j) := rfl

omit [Fintype S] [DecidableEq S] in
@[simp]
theorem lieEquiv_symm_apply (Y : VertexCochains birth death) (v : Fin (D + 1))
    (r s : Index D birth death v) :
    (lieEquiv D birth death hD).symm Y v r s =
      Y r.val s.val (vertexCoordinate D birth death v r s) := rfl

/-- The physical arrow whose output vertex is max(birth(source)+1,birth(target))+i. -/
def physicalEdge (r s : S)
    (i : Fin (arrowCount (birth s) (death s) (birth r) (death r))) : Fin D :=
  MAIS.IntervalBlockDifferential.physicalArrow D (birth s) (death s) (birth r) (death r) (hD r) i

def arrowRow (r s : S)
    (i : Fin (arrowCount (birth s) (death s) (birth r) (death r))) :
    Index D birth death (physicalEdge D birth death hD r s i).succ :=
  ⟨r, by
    have hh := physicalArrow_properties D (birth s) (death s) (birth r) (death r) (hD r) i
    exact ⟨hh.2.2.1, hh.2.2.2.1⟩⟩

def arrowColumn (r s : S)
    (i : Fin (arrowCount (birth s) (death s) (birth r) (death r))) :
    Index D birth death (physicalEdge D birth death hD r s i).castSucc :=
  ⟨s, by
    have hh := physicalArrow_properties D (birth s) (death s) (birth r) (death r) (hD r) i
    exact ⟨hh.1, hh.2.1⟩⟩

omit hD in
/-- Every literal arrow entry has a unique interval-pair row-coordinate. -/
def arrowCoordinate (e : Fin D) (r : Index D birth death e.succ)
    (s : Index D birth death e.castSucc) :
    Fin (arrowCount (birth s.val) (death s.val) (birth r.val) (death r.val)) :=
  ⟨e.val + 1 - max (birth s.val + 1) (birth r.val), by
    have hr := r.property
    have hs := s.property
    dsimp [active] at hr hs
    dsimp [arrowCount]
    omega⟩

omit [Fintype S] [DecidableEq S] in
theorem physicalEdge_coordinate (e : Fin D) (r : Index D birth death e.succ)
    (s : Index D birth death e.castSucc) :
    physicalEdge D birth death hD r.val s.val (arrowCoordinate D birth death e r s) = e := by
  apply Fin.ext
  change max (birth s.val + 1) (birth r.val) +
    (e.val + 1 - max (birth s.val + 1) (birth r.val)) - 1 = e.val
  have hr := r.property
  have hs := s.property
  dsimp [active] at hr hs
  omega

omit [Fintype S] [DecidableEq S] in
theorem arrowCoordinate_physical (r s : S)
    (i : Fin (arrowCount (birth s) (death s) (birth r) (death r))) :
    arrowCoordinate D birth death (physicalEdge D birth death hD r s i)
      (arrowRow D birth death hD r s i) (arrowColumn D birth death hD r s i) = i := by
  apply Fin.ext
  change (max (birth s + 1) (birth r) + i.val - 1) + 1 -
    max (birth s + 1) (birth r) = i.val
  omega

omit hD [Fintype S] [DecidableEq S] in
lemma rep_entry_congr (X : Rep (Index D birth death))
    {e u : Fin D} (r : Index D birth death e.succ) (s : Index D birth death e.castSucc)
    (r' : Index D birth death u.succ) (s' : Index D birth death u.castSucc)
    (hu : u = e) (hr : r'.val = r.val) (hs : s'.val = s.val) :
    X u r' s' = X e r s := by
  cases hu
  rw [Subtype.ext hr, Subtype.ext hs]

/-- Read every actual arrow entry at its interval-pair output coordinate. -/
def encodeRep (X : Rep (Index D birth death)) : ArrowCochains birth death :=
  fun r s i => X (physicalEdge D birth death hD r s i)
    (arrowRow D birth death hD r s i) (arrowColumn D birth death hD r s i)

omit hD in
/-- Place every scalar arrow coordinate back in its literal physical entry. -/
def decodeRep (Y : ArrowCochains birth death) : Rep (Index D birth death) :=
  fun e r s => Y r.val s.val (arrowCoordinate D birth death e r s)

/-- A genuine linear equivalence on all actual rectangular arrow entries. -/
def repEquiv : Rep (Index D birth death) ≃ₗ[ℝ] ArrowCochains birth death where
  toFun := encodeRep D birth death hD
  invFun := decodeRep D birth death
  left_inv := by
    intro X
    funext e r s
    exact rep_entry_congr D birth death X r s
      (arrowRow D birth death hD r.val s.val (arrowCoordinate D birth death e r s))
      (arrowColumn D birth death hD r.val s.val (arrowCoordinate D birth death e r s))
      (physicalEdge_coordinate D birth death hD e r s) rfl rfl
  right_inv := by
    intro Y
    funext r s i
    change Y r s (arrowCoordinate D birth death (physicalEdge D birth death hD r s i)
      (arrowRow D birth death hD r s i) (arrowColumn D birth death hD r s i)) = Y r s i
    rw [arrowCoordinate_physical]
  map_add' := by intro X Y; rfl
  map_smul' := by intro r X; rfl

omit [Fintype S] [DecidableEq S] in
@[simp]
theorem repEquiv_apply (X : Rep (Index D birth death)) (r s : S)
    (i : Fin (arrowCount (birth s) (death s) (birth r) (death r))) :
    repEquiv D birth death hD X r s i = X (physicalEdge D birth death hD r s i)
      (arrowRow D birth death hD r s i) (arrowColumn D birth death hD r s i) := rfl

omit [Fintype S] [DecidableEq S] in
@[simp]
theorem repEquiv_symm_apply (Y : ArrowCochains birth death) (e : Fin D)
    (r : Index D birth death e.succ) (s : Index D birth death e.castSucc) :
    (repEquiv D birth death hD).symm Y e r s =
      Y r.val s.val (arrowCoordinate D birth death e r s) := rfl

end MAIS.ActiveIntervalCoordinates
end

