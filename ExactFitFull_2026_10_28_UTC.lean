-- ==================== begin module O7.PrefixInterpolation (formalization/O7/PrefixInterpolation.lean) ====================
section

/-!
Actual finite-prefix cardinalities for a predicate which is a final segment
inside a block.  This is the count-theoretic ingredient in the canonical
permutation four-corner formula, rather than an assumed rank-array formula.
-/
set_option autoImplicit false

namespace MAIS.PrefixInterpolation

open Finset

def count (P : ℕ → Prop) [DecidablePred P] (k : ℕ) : ℕ :=
  ((Finset.range k).filter P).card

lemma count_split (P : ℕ → Prop) [DecidablePred P] (a b : ℕ) (hab : a ≤ b) :
    count P b = count P a + ((Finset.Ico a b).filter P).card := by
  have hu : (Finset.range b).filter P =
      (Finset.range a).filter P ∪ (Finset.Ico a b).filter P := by
    ext p
    by_cases hp : P p <;> simp only [mem_filter, mem_range, mem_union, mem_Ico, hp]
    all_goals simp_all only [and_true, and_false, or_false]
    all_goals omega
  have hd : Disjoint ((Finset.range a).filter P) ((Finset.Ico a b).filter P) := by
    apply Finset.disjoint_left.mpr
    intro p hp hq
    simp only [mem_filter, mem_range, mem_Ico] at hp hq
    omega
  exact (congrArg Finset.card hu).trans (Finset.card_union_of_disjoint hd)

lemma count_mono (P : ℕ → Prop) [DecidablePred P] {a b : ℕ} (hab : a ≤ b) :
    count P a ≤ count P b := by
  apply Finset.card_le_card
  intro p hp
  simp only [mem_filter, mem_range] at hp ⊢
  exact ⟨lt_of_lt_of_le hp.1 hab, hp.2⟩

/-- A final-segment predicate inside a block gives the max interpolation of its two
    boundary prefix counts. -/
theorem final_segment_interpolation (P : ℕ → Prop) [DecidablePred P]
    (a k b : ℕ) (hak : a ≤ k) (hkb : k ≤ b)
    (hfinal : ∀ p q, a ≤ p → p ≤ q → q < b → P p → P q) :
    count P k = max (count P a) (count P b - (b - k)) := by
  have hleft := count_split P a k hak
  have hright := count_split P k b hkb
  have htail : ((Finset.Ico k b).filter P).card ≤ b - k := by
    calc
      _ ≤ (Finset.Ico k b).card := Finset.card_filter_le _ _
      _ = _ := Nat.card_Ico _ _
  have hbound : count P b - (b - k) ≤ count P k := by omega
  by_cases hzero : ((Finset.Ico a k).filter P).card = 0
  · have hsame : count P k = count P a := by omega
    rw [max_eq_left (by omega)]
    exact hsame
  · have hpos : 0 < ((Finset.Ico a k).filter P).card := Nat.pos_of_ne_zero hzero
    obtain ⟨p, hp⟩ := Finset.card_pos.mp hpos
    simp only [mem_filter, mem_Ico] at hp
    have hfull : (Finset.Ico k b).filter P = Finset.Ico k b := by
      apply Finset.filter_eq_self.mpr
      intro q hq
      simp only [mem_Ico] at hq
      exact hfinal p q hp.1.1 (by omega) hq.2 hp.2
    rw [hfull, Nat.card_Ico] at hright
    have hsame : count P b - (b - k) = count P k := by omega
    rw [hsame, max_eq_right (count_mono P hak)]

/-- Integer max-plus form of the four-corner identity. -/
theorem max_sub_four_corners (U V W Z dr dc : ℕ) :
    max (max U (V - dc)) (max W (Z - dc) - dr) =
      max (max U (V - dc)) (max (W - dr) (Z - dc - dr)) := by
  omega

end MAIS.PrefixInterpolation



/--
info: 'MAIS.PrefixInterpolation.final_segment_interpolation' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.PrefixInterpolation.final_segment_interpolation
end
-- ==================== end module O7.PrefixInterpolation ====================

-- ==================== begin module O7.PermutationInterpolation (formalization/O7/PermutationInterpolation.lean) ====================
section

/-!
Four-corner interpolation of actual prefix counts for a finite permutation
whose positions and inverse positions decrease inside the relevant blocks.
-/
set_option autoImplicit false

namespace MAIS.PermutationInterpolation

open MAIS.PermutationRankOrder
open MAIS.PrefixInterpolation

lemma lift_lt {N : ℕ} (v : Equiv.Perm (Fin N)) (p : ℕ) (hp : p < N) :
    liftPermutation v p < N := by
  simp only [liftPermutation, dite_eq_left hp]
  exact (v ⟨p, hp⟩).isLt

lemma lift_inverse {N : ℕ} (v : Equiv.Perm (Fin N)) (p : ℕ) (hp : p < N) :
    liftPermutation v.symm (liftPermutation v p) = p := by
  let x : Fin N := ⟨p, hp⟩
  rw [show liftPermutation v p = (v x).val from liftPermutation_at v x,
    liftPermutation_at]
  exact congrArg Fin.val (v.symm_apply_apply x)

/-- Actual prefix cardinality, with both the position and value cuts strict. -/
def Q {N : ℕ} (v : Equiv.Perm (Fin N)) (k l : ℕ) : ℕ :=
  count (fun p => liftPermutation v p < l) k

/-- Transposing the permutation exchanges the actual position and value prefix counts. -/
theorem Q_inverse {N : ℕ} (v : Equiv.Perm (Fin N)) (k l : ℕ)
    (hk : k ≤ N) (hl : l ≤ N) : Q v k l = Q v.symm l k := by
  classical
  unfold Q count
  apply Finset.card_bij (fun p _hp => liftPermutation v p)
  · intro p hp
    simp only [Finset.mem_filter, Finset.mem_range] at hp ⊢
    refine ⟨hp.2, ?_⟩
    rw [lift_inverse v p (lt_of_lt_of_le hp.1 hk)]
    exact hp.1
  · intro p hp q hq hpq
    simp only [Finset.mem_filter, Finset.mem_range] at hp hq
    have h := congrArg (liftPermutation v.symm) hpq
    rw [lift_inverse v p (lt_of_lt_of_le hp.1 hk),
      lift_inverse v q (lt_of_lt_of_le hq.1 hk)] at h
    exact h
  · intro q hq
    simp only [Finset.mem_filter, Finset.mem_range] at hq
    let p := liftPermutation v.symm q
    have hqN : q < N := lt_of_lt_of_le hq.1 hl
    have heq : liftPermutation v p = q := by
      exact lift_inverse v.symm q hqN
    refine ⟨p, ?_, heq⟩
    simp only [Finset.mem_filter, Finset.mem_range]
    exact ⟨hq.2, by rw [heq]; exact hq.1⟩

/-- A decreasing row block gives the max of its two boundary prefix counts. -/
theorem Q_row_interpolation {N : ℕ} (v : Equiv.Perm (Fin N))
    (a k b l : ℕ) (hak : a ≤ k) (hkb : k ≤ b)
    (hdec : ∀ p q, a ≤ p → p < q → q < b →
      liftPermutation v q < liftPermutation v p) :
    Q v k l = max (Q v a l) (Q v b l - (b - k)) := by
  apply final_segment_interpolation _ a k b hak hkb
  intro p q hap hpq hqb hp
  by_cases heq : p = q
  · simpa only [heq] using hp
  · exact lt_trans (hdec p q hap (by omega) hqb) hp

/-- The canonical four-corner formula, proved from actual finite cardinalities. -/
theorem four_corners {N : ℕ} (v : Equiv.Perm (Fin N))
    (a k b c l d : ℕ) (hak : a ≤ k) (hkb : k ≤ b) (hb : b ≤ N)
    (hcl : c ≤ l) (hld : l ≤ d) (hd : d ≤ N)
    (hrow : ∀ p q, a ≤ p → p < q → q < b →
      liftPermutation v q < liftPermutation v p)
    (hcol : ∀ p q, c ≤ p → p < q → q < d →
      liftPermutation v.symm q < liftPermutation v.symm p) :
    Q v k l = max (max (Q v a c) (Q v a d - (d - l)))
      (max (Q v b c - (b - k)) (Q v b d - (d - l) - (b - k))) := by
  have ha : a ≤ N := le_trans hak (le_trans hkb hb)
  have hl : l ≤ N := le_trans hld hd
  have hc : c ≤ N := le_trans hcl hl
  have hroweq := Q_row_interpolation v a k b l hak hkb hrow
  have hcola : Q v a l = max (Q v a c) (Q v a d - (d - l)) := by
    rw [Q_inverse v a l ha hl]
    rw [Q_row_interpolation v.symm c l d a hcl hld hcol]
    rw [← Q_inverse v a c ha hc, ← Q_inverse v a d ha hd]
  have hcolb : Q v b l = max (Q v b c) (Q v b d - (d - l)) := by
    rw [Q_inverse v b l hb hl]
    rw [Q_row_interpolation v.symm c l d b hcl hld hcol]
    rw [← Q_inverse v b c hb hc, ← Q_inverse v b d hb hd]
  rw [hcola, hcolb] at hroweq
  rw [hroweq]
  exact max_sub_four_corners _ _ _ _ _ _

end MAIS.PermutationInterpolation



/--
info: 'MAIS.PermutationInterpolation.four_corners' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.PermutationInterpolation.four_corners
end
-- ==================== end module O7.PermutationInterpolation ====================

-- ==================== begin module O7.CanonicalFourCorners (formalization/O7/CanonicalFourCorners.lean) ====================
section

/-!
The actual canonical matrix permutation has the four-corner prefix-count
formula.  The northwest entries are finite sums of the original matrix;
the left side is the cardinality of an actual finite-permutation prefix.
-/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace MAIS.CanonicalPermutation

variable {m n : ℕ}

open MAIS.PermutationRankOrder
open MAIS.PermutationInterpolation

lemma Q_to_fin_count {N : ℕ} (v : Equiv.Perm (Fin N)) (k l : ℕ) (hk : k ≤ N) :
    Q v k l = ((Finset.univ : Finset (Fin N)).filter
      (fun p => p.val < k ∧ (v p).val < l)).card := by
  classical
  unfold Q MAIS.PrefixInterpolation.count
  apply Finset.card_bij (fun p hp =>
    (⟨p, lt_of_lt_of_le (Finset.mem_range.mp (Finset.mem_filter.mp hp).1) hk⟩ : Fin N))
  · intro p hp
    simp only [Finset.mem_filter, Finset.mem_range] at hp
    have hpN : p < N := lt_of_lt_of_le hp.1 hk
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨hp.1, by simpa only [liftPermutation, dite_eq_left hpN] using hp.2⟩
  · intro p _hp q _hq hpq
    exact congrArg Fin.val hpq
  · intro q hq
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hq
    refine ⟨q.val, ?_, ?_⟩
    · simp only [Finset.mem_filter, Finset.mem_range]
      exact ⟨hq.1, by simpa only [liftPermutation_at] using hq.2⟩
    · exact Fin.ext rfl

/-- At actual block boundaries, permutation prefix ranks recover actual matrix sums. -/
theorem Q_boundaries (A : Fin m → Fin n → ℕ) (i j : ℕ) :
    Q (canonical A) (rowBoundary A i) (columnBoundary A j) = northWest A i j := by
  classical
  rw [Q_to_fin_count _ _ _ (rowBoundary_le_mass A i)]
  have heq : ((Finset.univ : Finset (Fin (mass A))).filter
      (fun p => p.val < rowBoundary A i ∧ (canonical A p).val < columnBoundary A j)) =
      (Finset.univ.filter (fun p =>
        (rowEnumeration A p).1.val < i ∧ (rowEnumeration A p).2.1.val < j)) := by
    ext p
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    rw [← row_cut A i p, ← column_cut A j (canonical A p), canonical_column]
  rw [heq]
  exact enumeration_count A (rowEnumeration A).toEquiv
    (fun r c => r.val < i ∧ c.val < j)

/-- Four-corner interpolation for the genuine permutation constructed from A. -/
theorem canonical_four_corners (A : Fin m → Fin n → ℕ) (i : Fin m) (j : Fin n)
    (k l : ℕ)
    (hkr : rowBoundary A i.val ≤ k) (hkr' : k ≤ rowBoundary A (i.val + 1))
    (hlc : columnBoundary A j.val ≤ l) (hlc' : l ≤ columnBoundary A (j.val + 1)) :
    Q (canonical A) k l =
      max (max (northWest A i.val j.val)
        (northWest A i.val (j.val + 1) - (columnBoundary A (j.val + 1) - l)))
      (max (northWest A (i.val + 1) j.val - (rowBoundary A (i.val + 1) - k))
        (northWest A (i.val + 1) (j.val + 1) -
          (columnBoundary A (j.val + 1) - l) - (rowBoundary A (i.val + 1) - k))) := by
  have hrN := rowBoundary_le_mass A (i.val + 1)
  have hcN := columnBoundary_le_mass A (j.val + 1)
  have hrow : ∀ p q, rowBoundary A i.val ≤ p → p < q →
      q < rowBoundary A (i.val + 1) →
      liftPermutation (canonical A) q < liftPermutation (canonical A) p := by
    intro p q hp hpq hq
    have hpN : p < mass A := by omega
    have hqN : q < mass A := by omega
    have hpi := row_label_of_bounds A i ⟨p, hpN⟩ hp (by change p < rowBoundary A (i.val + 1); omega)
    have hqi := row_label_of_bounds A i ⟨q, hqN⟩ (by change rowBoundary A i.val ≤ q; omega) hq
    have h := canonical_row_decreasing A ⟨p, hpN⟩ ⟨q, hqN⟩ hpq (hpi.trans hqi.symm)
    simpa only [liftPermutation, dite_eq_left hpN, dite_eq_left hqN] using (Fin.lt_def.mp h)
  have hcol : ∀ p q, columnBoundary A j.val ≤ p → p < q →
      q < columnBoundary A (j.val + 1) →
      liftPermutation (canonical A).symm q < liftPermutation (canonical A).symm p := by
    intro p q hp hpq hq
    have hpN : p < mass A := by omega
    have hqN : q < mass A := by omega
    have hpj := column_label_of_bounds A j ⟨p, hpN⟩ hp (by change p < columnBoundary A (j.val + 1); omega)
    have hqj := column_label_of_bounds A j ⟨q, hqN⟩ (by change columnBoundary A j.val ≤ q; omega) hq
    have h := canonical_column_decreasing A ⟨p, hpN⟩ ⟨q, hqN⟩ hpq (hpj.trans hqj.symm)
    simpa only [liftPermutation, dite_eq_left hpN, dite_eq_left hqN] using (Fin.lt_def.mp h)
  have h := four_corners (canonical A)
    (rowBoundary A i.val) k (rowBoundary A (i.val + 1))
    (columnBoundary A j.val) l (columnBoundary A (j.val + 1))
    hkr hkr' hrN hlc hlc' hcN hrow hcol
  simpa only [Q_boundaries] using h

end MAIS.CanonicalPermutation



/--
info: 'MAIS.CanonicalPermutation.canonical_four_corners' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.CanonicalPermutation.canonical_four_corners
end
-- ==================== end module O7.CanonicalFourCorners ====================

-- ==================== begin module O7.CanonicalOrder (formalization/O7/CanonicalOrder.lean) ====================
section

/-!
Actual matrix northwest order lifts to full prefix-rank order of the
canonical permutations, hence to the already verified finite swap chain.
-/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace MAIS.PermutationInterpolation

open MAIS.PermutationRankOrder

lemma prefixCount_eq_Q_succ {N : ℕ} (v : Equiv.Perm (Fin N)) (k l : ℕ) :
    prefixCount (liftPermutation v) k l = Q v k (l + 1) := by
  simp only [prefixCount, Q, MAIS.PrefixInterpolation.count, Nat.lt_succ_iff]

lemma prefixCount_large_value {N : ℕ} (v : Equiv.Perm (Fin N)) (k l : ℕ)
    (hk : k ≤ N) (hl : N ≤ l) : prefixCount (liftPermutation v) k l = k := by
  unfold prefixCount
  have heq : (Finset.range k).filter (fun p => liftPermutation v p ≤ l) = Finset.range k := by
    apply Finset.filter_eq_self.mpr
    intro p hp
    exact (Nat.le_of_lt (lift_lt v p (lt_of_lt_of_le (Finset.mem_range.mp hp) hk))).trans hl
  rw [heq, Finset.card_range]

/-- Bounded actual finite-prefix ranks suffice for the whole identity-extended rank order. -/
theorem RankLE_of_Q {N : ℕ} (v w : Equiv.Perm (Fin N))
    (hQ : ∀ k ≤ N, ∀ l ≤ N, Q w k l ≤ Q v k l) : RankLE w v := by
  have hbounded : ∀ k ≤ N, ∀ l, prefixCount (liftPermutation w) k l ≤
      prefixCount (liftPermutation v) k l := by
    intro k hk l
    by_cases hl : l < N
    · rw [prefixCount_eq_Q_succ, prefixCount_eq_Q_succ]
      exact hQ k hk (l + 1) (by omega)
    · rw [prefixCount_large_value w k l hk (by omega),
        prefixCount_large_value v k l hk (by omega)]
  intro k
  induction k with
  | zero => intro l; simp only [prefixCount, Finset.range_zero, Finset.filter_empty,
      Finset.card_empty, le_refl]
  | succ k ih =>
    intro l
    by_cases hk : k + 1 ≤ N
    · exact hbounded (k + 1) hk l
    · have hNk : N ≤ k := by omega
      have hs (u : Equiv.Perm (Fin N)) :
          prefixCount (liftPermutation u) (k + 1) l =
            prefixCount (liftPermutation u) k l + (if k ≤ l then 1 else 0) := by
        simp only [prefixCount_eq_sum, Finset.sum_range_succ,
          liftPermutation, dite_eq_right (not_lt.mpr hNk)]
      rw [hs w, hs v]
      exact Nat.add_le_add_right (ih l) _

/-- Reindexing by equal cardinalities keeps all numerical permutation prefix counts. -/
def reindexPermutation {N M : ℕ} (h : N = M) (v : Equiv.Perm (Fin N)) :
    Equiv.Perm (Fin M) := (finCongr h).permCongr v

lemma Q_reindex {N M : ℕ} (h : N = M) (v : Equiv.Perm (Fin N)) (k l : ℕ) :
    Q (reindexPermutation h v) k l = Q v k l := by
  cases h
  rfl

end MAIS.PermutationInterpolation

namespace MAIS.CanonicalPermutation

variable {m n : ℕ}

open MAIS.PermutationRankOrder
open MAIS.PermutationInterpolation

lemma rowBoundary_total (A : Fin m → Fin n → ℕ) : rowBoundary A m = mass A := by
  unfold rowBoundary mass
  apply Finset.sum_congr rfl
  intro r _hr
  apply Finset.sum_congr rfl
  intro c _hc
  simp only [r.isLt, ite_true]

lemma columnBoundary_total (A : Fin m → Fin n → ℕ) : columnBoundary A n = mass A := by
  unfold columnBoundary mass
  apply Finset.sum_congr rfl
  intro r _hr
  apply Finset.sum_congr rfl
  intro c _hc
  simp only [c.isLt, ite_true]

/-- Every cut of a nonempty matrix slot set lies in an actual row block. -/
lemma row_bracket (A : Fin m → Fin n → ℕ) (hpos : 0 < mass A)
    (k : ℕ) (hk : k ≤ mass A) :
    ∃ i : Fin m, rowBoundary A i.val ≤ k ∧ k ≤ rowBoundary A (i.val + 1) := by
  let p : Fin (mass A) := ⟨min k (mass A - 1), by omega⟩
  let i := (rowEnumeration A p).1
  have hlo : rowBoundary A i.val ≤ p.val := by
    have hc := row_cut A i.val p
    have hnot : ¬ (rowEnumeration A p).1.val < i.val := by exact lt_irrefl _
    omega
  have hhi : p.val < rowBoundary A (i.val + 1) := by
    apply (row_cut A (i.val + 1) p).mp
    change i.val < i.val + 1
    omega
  have hrN := rowBoundary_le_mass A (i.val + 1)
  refine ⟨i, ?_, ?_⟩
  · exact le_trans hlo (min_le_left _ _)
  · dsimp only [p] at hhi
    omega

/-- Every cut of a nonempty matrix slot set lies in an actual value-column block. -/
lemma column_bracket (A : Fin m → Fin n → ℕ) (hpos : 0 < mass A)
    (l : ℕ) (hl : l ≤ mass A) :
    ∃ j : Fin n, columnBoundary A j.val ≤ l ∧ l ≤ columnBoundary A (j.val + 1) := by
  let p : Fin (mass A) := ⟨min l (mass A - 1), by omega⟩
  let j := (columnEnumeration A p).2.1
  have hlo : columnBoundary A j.val ≤ p.val := by
    have hc := column_cut A j.val p
    have hnot : ¬ (columnEnumeration A p).2.1.val < j.val := by exact lt_irrefl _
    omega
  have hhi : p.val < columnBoundary A (j.val + 1) := by
    apply (column_cut A (j.val + 1) p).mp
    change j.val < j.val + 1
    omega
  have hcN := columnBoundary_le_mass A (j.val + 1)
  refine ⟨j, ?_, ?_⟩
  · exact le_trans hlo (min_le_left _ _)
  · dsimp only [p] at hhi
    omega

/-- Actual northwest matrix-count order yields all canonical permutation prefix inequalities. -/
theorem canonical_Q_mono (A B : Fin m → Fin n → ℕ)
    (hrow : ∀ i, rowBoundary B i = rowBoundary A i)
    (hcol : ∀ j, columnBoundary B j = columnBoundary A j)
    (hNW : ∀ i j, northWest B i j ≤ northWest A i j)
    (k l : ℕ) (hk : k ≤ mass A) (hl : l ≤ mass A) :
    Q (canonical B) k l ≤ Q (canonical A) k l := by
  by_cases hzero : mass A = 0
  · have hk0 : k = 0 := by omega
    subst k
    simp only [Q, MAIS.PrefixInterpolation.count, Finset.range_zero,
      Finset.filter_empty, Finset.card_empty, le_refl]
  · have hpos : 0 < mass A := Nat.pos_of_ne_zero hzero
    obtain ⟨i, hik, hki⟩ := row_bracket A hpos k hk
    obtain ⟨j, hjl, hlj⟩ := column_bracket A hpos l hl
    have hA := canonical_four_corners A i j k l hik hki hjl hlj
    have hB := canonical_four_corners B i j k l
      (by rw [hrow]; exact hik) (by rw [hrow]; exact hki)
      (by rw [hcol]; exact hjl) (by rw [hcol]; exact hlj)
    simp only [hrow, hcol] at hB
    have h00 := hNW i.val j.val
    have h01 := hNW i.val (j.val + 1)
    have h10 := hNW (i.val + 1) j.val
    have h11 := hNW (i.val + 1) (j.val + 1)
    rw [hA, hB]
    omega

/-- Full finite swap generation for the genuine canonical permutations of two matrices. -/
theorem canonical_swap_chain (A B : Fin m → Fin n → ℕ)
    (hrow : ∀ i, rowBoundary B i = rowBoundary A i)
    (hcol : ∀ j, columnBoundary B j = columnBoundary A j)
    (hNW : ∀ i j, northWest B i j ≤ northWest A i j) :
    let hmass : mass B = mass A := by
      simpa only [rowBoundary_total] using hrow m
    let w := reindexPermutation hmass (canonical B)
    ∃ tail : List (Equiv.Perm (Fin (mass A))),
      (canonical A :: tail).IsChain IncreasingSwap ∧
      (canonical A :: tail).getLast (List.cons_ne_nil _ _) = w ∧
      ∀ u ∈ canonical A :: tail, RankLE w u ∧ RankLE u (canonical A) := by
  dsimp only
  apply rank_order_generated
  apply RankLE_of_Q
  intro k hk l hl
  rw [Q_reindex]
  exact canonical_Q_mono A B hrow hcol hNW k l hk hl

end MAIS.CanonicalPermutation




/--
info: 'MAIS.CanonicalPermutation.canonical_Q_mono' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.CanonicalPermutation.canonical_Q_mono

/--
info: 'MAIS.CanonicalPermutation.canonical_swap_chain' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.CanonicalPermutation.canonical_swap_chain
end
-- ==================== end module O7.CanonicalOrder ====================

-- ==================== begin module O7.TypeAPadding (formalization/O7/TypeAPadding.lean) ====================
section

/-!
Finite matrix pieces of the type-A padding argument.
These lemmas use actual finite sums of matrix entries. They do not assume
or claim that a canonical matrix-to-permutation lift has been formalized.
-/
set_option autoImplicit false

namespace MAIS.TypeAPadding

/-- Algebra behind the canonical permutation's four-corner interpolation formula. -/
theorem four_corner_identity (U p b a T C : ℤ) (ha : 0 ≤ a) :
    U + max 0 (C + b) + max 0 (p + T + min a (max 0 (C + b + a))) =
      max (max U (U + b + C)) (max (U + p + T) (U + p + b + a + T + C)) := by
  omega

/-- Increasing all four cumulative corners increases their interpolation. -/
theorem four_corner_mono (U V W Z U' V' W' Z' T C : ℤ)
    (hU : U ≤ U') (hV : V ≤ V') (hW : W ≤ W') (hZ : Z ≤ Z') :
    max (max U (V + C)) (max (W + T) (Z + T + C)) ≤
      max (max U' (V' + C)) (max (W' + T) (Z' + T + C)) := by
  omega

/-- Entries of rows at most i and columns at most j. -/
def northWest {m n : ℕ} (A : Fin m → Fin n → ℕ) (i : Fin m) (j : Fin n) : ℕ :=
  ∑ a ∈ Finset.univ.filter (fun a => a ≤ i),
    ∑ k ∈ Finset.univ.filter (fun k => k ≤ j), A a k

/-- Total mass in all rows of columns at most j. -/
def columnPrefix {m n : ℕ} (A : Fin m → Fin n → ℕ) (j : Fin n) : ℕ :=
  ∑ a : Fin m, ∑ k ∈ Finset.univ.filter (fun k => k ≤ j), A a k

/-- Equality of diagonal northwest counts to total column-prefix mass forbids all
    below-diagonal entries. -/
theorem upper_triangular_of_diagonal {m : ℕ} (A : Fin m → Fin m → ℕ)
    (hdiag : ∀ j, northWest A j j = columnPrefix A j) :
    ∀ a k, k < a → A a k = 0 := by
  intro a k hka
  let rows : Fin m → ℕ := fun r =>
    ∑ c ∈ Finset.univ.filter (fun c => c ≤ k), A r c
  have hpart := Finset.sum_filter_add_sum_filter_not Finset.univ (fun r => r ≤ k) rows
  have hzero : (∑ r ∈ Finset.univ.filter (fun r => ¬ r ≤ k), rows r) = 0 := by
    have hdiag' : (∑ r ∈ Finset.univ.filter (fun r => r ≤ k), rows r) =
        ∑ r : Fin m, rows r := hdiag k
    omega
  have hrow : rows a ≤ ∑ r ∈ Finset.univ.filter (fun r => ¬ r ≤ k), rows r := by
    apply Finset.single_le_sum
    · intro r _hr
      exact Nat.zero_le _
    · simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      exact not_le.mpr hka
  have hentry : A a k ≤ rows a := by
    apply Finset.single_le_sum
    · intro c _hc
      exact Nat.zero_le _
    · simp only [Finset.mem_filter, Finset.mem_univ, le_refl, and_self]
  omega

/-- The actual diagonal sandwich in the padding proof forces triangularity. -/
theorem upper_triangular_of_sandwich {m : ℕ}
    (A M B : Fin m → Fin m → ℕ)
    (hA : ∀ j, northWest A j j = columnPrefix M j)
    (hB : ∀ j, northWest B j j = columnPrefix M j)
    (hlo : ∀ i j, northWest A i j ≤ northWest M i j)
    (hhi : ∀ i j, northWest M i j ≤ northWest B i j) :
    ∀ a k, k < a → M a k = 0 := by
  apply upper_triangular_of_diagonal
  intro j
  have hl := hlo j j
  have hh := hhi j j
  rw [hA j] at hl
  rw [hB j] at hh
  omega

/-- Number of nonempty intervals starting at a row index (column is right endpoint+1). -/
def starts {m : ℕ} (M : Fin m → Fin m → ℕ) (a : Fin m) : ℕ :=
  ∑ k ∈ Finset.univ.filter (fun k => a < k), M a k

/-- Number of nonempty intervals ending just before a column index. -/
def ends {m : ℕ} (M : Fin m → Fin m → ℕ) (k : Fin m) : ℕ :=
  ∑ a ∈ Finset.univ.filter (fun a => a < k), M a k

/-- The empty-interval padding is diagonal, and all below-diagonal entries vanish. -/
def padding {m : ℕ} (M : Fin m → Fin m → ℕ) (N : ℕ) (a k : Fin m) : ℕ :=
  if a < k then M a k else if a = k then N - starts M a else 0

lemma padding_split {m : ℕ} (M : Fin m → Fin m → ℕ) (N : ℕ) (a k : Fin m) :
    padding M N a k = (if a < k then M a k else 0) +
      (if k = a then N - starts M a else 0) := by
  unfold padding
  by_cases hak : a < k
  · have hne : k ≠ a := by omega
    simp [hak, hne]
  · by_cases heq : a = k
    · subst k
      simp
    · have hne : k ≠ a := Ne.symm heq
      simp [hak, heq, hne]

/-- Padding makes every row total the same prescribed integer N. -/
theorem padding_row_total {m : ℕ} (M : Fin m → Fin m → ℕ) (N : ℕ)
    (a : Fin m) (hN : starts M a ≤ N) :
    (∑ k : Fin m, padding M N a k) = N := by
  simp only [padding_split, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ,
    ite_true]
  have hstart : (∑ k : Fin m, if a < k then M a k else 0) = starts M a := by
    simp only [starts, Finset.sum_filter]
  rw [hstart]
  omega

/-- The exact column total before substituting the coverage-difference identity. -/
theorem padding_column_total {m : ℕ} (M : Fin m → Fin m → ℕ) (N : ℕ) (k : Fin m) :
    (∑ a : Fin m, padding M N a k) = ends M k + (N - starts M k) := by
  simp only [padding_split, Finset.sum_add_distrib, Finset.sum_ite_eq, Finset.mem_univ,
    ite_true]
  simp only [ends, Finset.sum_filter]

/-- Coverage difference turns the padded column total into the fixed dimension margin. -/
theorem padding_column_dimension {m : ℕ} (M : Fin m → Fin m → ℕ) (N : ℕ)
    (k : Fin m) (nprev ncurrent : ℕ)
    (hstart : starts M k ≤ N) (hcurrent : ncurrent ≤ N)
    (hcoverage : starts M k + nprev = ends M k + ncurrent) :
    (∑ a : Fin m, padding M N a k) = N - ncurrent + nprev := by
  rw [padding_column_total]
  omega

end MAIS.TypeAPadding

/--
info: 'MAIS.TypeAPadding.four_corner_identity' depends on axioms:
  [propext, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.TypeAPadding.four_corner_identity
/--
info: 'MAIS.TypeAPadding.upper_triangular_of_sandwich' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.TypeAPadding.upper_triangular_of_sandwich
/--
info: 'MAIS.TypeAPadding.padding_row_total' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.TypeAPadding.padding_row_total
/--
info: 'MAIS.TypeAPadding.padding_column_dimension' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.TypeAPadding.padding_column_dimension
end
-- ==================== end module O7.TypeAPadding ====================

-- ==================== begin module O7.IntervalPaddingOrder (formalization/O7/IntervalPaddingOrder.lean) ====================
section

/-!
The actual empty-interval padding turns interval-coverage rank inequalities
into northwest inequalities of finite nonnegative matrices.  Combined with
CanonicalOrder this constructs a genuine finite permutation swap chain.
-/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open scoped BigOperators

namespace MAIS.IntervalPaddingOrder

variable {m : ℕ}
open MAIS.CanonicalPermutation
open MAIS.TypeAPadding

/-- Actual total multiplicity of intervals whose birth precedes i and whose
    endpoint-plus-one is at least j.  On diagonal cuts this counts coverage. -/
def crossing (M : Fin m → Fin m → ℕ) (i j : ℕ) : ℕ :=
  ∑ a, ∑ k, if a.val < i ∧ j ≤ k.val then M a k else 0

lemma northwest_add_crossing (M : Fin m → Fin m → ℕ) (i j : ℕ) :
    MAIS.CanonicalPermutation.northWest M i j + crossing M i j = rowBoundary M i := by
  unfold MAIS.CanonicalPermutation.northWest crossing rowBoundary
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro a _ha
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k _hk
  split_ifs <;> omega

lemma padding_crossing (M : Fin m → Fin m → ℕ) (N i j : ℕ) (hij : i ≤ j) :
    crossing (padding M N) i j = crossing M i j := by
  unfold crossing
  apply Finset.sum_congr rfl
  intro a _ha
  apply Finset.sum_congr rfl
  intro k _hk
  by_cases h : a.val < i ∧ j ≤ k.val
  · have hak : a < k := by exact (show a.val < k.val by omega)
    simp only [h, ite_true, padding, hak]
  · simp only [h, ite_false]

lemma padding_upper (M : Fin m → Fin m → ℕ) (N : ℕ) :
    ∀ a k, k < a → padding M N a k = 0 := by
  intro a k hka
  simp only [padding, not_lt.mpr (le_of_lt hka), ite_false, ne_of_gt hka]

lemma northwest_eq_column_of_upper (M : Fin m → Fin m → ℕ)
    (hupper : ∀ a k, k < a → M a k = 0) (i j : ℕ) (hji : j ≤ i) :
    MAIS.CanonicalPermutation.northWest M i j = columnBoundary M j := by
  unfold MAIS.CanonicalPermutation.northWest columnBoundary
  apply Finset.sum_congr rfl
  intro a _ha
  apply Finset.sum_congr rfl
  intro k _hk
  by_cases hk : k.val < j
  · by_cases ha : a.val < i
    · simp only [ha, hk, and_self, ite_true]
    · have hka : k < a := by exact (show k.val < a.val by omega)
      simp only [ha, hk, false_and, ite_false, ite_true, hupper a k hka]
  · simp only [hk, and_false, ite_false]

lemma rowBoundary_eq_of_totals (A B : Fin m → Fin m → ℕ)
    (h : ∀ a, (∑ k, A a k) = ∑ k, B a k) (i : ℕ) :
    rowBoundary A i = rowBoundary B i := by
  unfold rowBoundary
  apply Finset.sum_congr rfl
  intro a _ha
  by_cases ha : a.val < i
  · simpa only [ha, ite_true] using h a
  · simp only [ha, ite_false, Finset.sum_const_zero]

lemma columnBoundary_eq_of_totals (A B : Fin m → Fin m → ℕ)
    (h : ∀ k, (∑ a, A a k) = ∑ a, B a k) (j : ℕ) :
    columnBoundary A j = columnBoundary B j := by
  unfold columnBoundary
  conv_lhs => rw [Finset.sum_comm]
  conv_rhs => rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro k _hk
  by_cases hk : k.val < j
  · simpa only [hk, ite_true] using h k
  · simp only [hk, ite_false, Finset.sum_const_zero]

lemma starts_double (M : Fin m → Fin m → ℕ) (c : Fin m) :
    starts M c = ∑ a, ∑ k, if a = c ∧ c < k then M a k else 0 := by
  symm
  calc
    _ = ∑ a, if a = c then (∑ k, if c < k then M a k else 0) else 0 := by
      apply Finset.sum_congr rfl
      intro a _ha
      by_cases h : a = c <;> simp only [h, true_and, false_and, ite_true,
        ite_false, Finset.sum_const_zero]
    _ = ∑ k, if c < k then M c k else 0 := by simp
    _ = starts M c := by simp only [starts, Finset.sum_filter]

lemma ends_double (M : Fin m → Fin m → ℕ) (c : Fin m) :
    ends M c = ∑ a, ∑ k, if k = c ∧ a < c then M a k else 0 := by
  symm
  calc
    _ = ∑ a, if a < c then M a c else 0 := by
      apply Finset.sum_congr rfl
      intro a _ha
      by_cases h : a < c <;> simp [h]
    _ = ends M c := by simp only [ends, Finset.sum_filter]

/-- The coverage difference is an identity of actual finite interval multiplicities. -/
theorem coverage_difference (M : Fin m → Fin m → ℕ) (c : Fin m) :
    starts M c + crossing M c.val c.val =
      ends M c + crossing M (c.val + 1) (c.val + 1) := by
  rw [starts_double, ends_double]
  unfold crossing
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro a _ha
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k _hk
  simp only [Fin.ext_iff, Fin.lt_def]
  split_ifs <;> omega

lemma padding_row_margins (S R : Fin m → Fin m → ℕ) (N : ℕ)
    (hS : ∀ a, starts S a ≤ N) (hR : ∀ a, starts R a ≤ N) (i : ℕ) :
    rowBoundary (padding R N) i = rowBoundary (padding S N) i := by
  apply rowBoundary_eq_of_totals
  intro a
  rw [padding_row_total R N a (hR a), padding_row_total S N a (hS a)]

lemma padding_column_margins (S R : Fin m → Fin m → ℕ) (N : ℕ)
    (hS : ∀ a, starts S a ≤ N) (hR : ∀ a, starts R a ≤ N)
    (hdim : ∀ i, crossing S i i = crossing R i i) (j : ℕ) :
    columnBoundary (padding R N) j = columnBoundary (padding S N) j := by
  apply columnBoundary_eq_of_totals
  intro k
  rw [padding_column_total, padding_column_total]
  have hSc := coverage_difference S k
  have hRc := coverage_difference R k
  rw [hdim k.val, hdim (k.val + 1)] at hSc
  have hSbound := hS k
  have hRbound := hR k
  omega

/-- Actual interval crossing order, with equal vertex coverage, becomes northwest order
    of the actual padded multiplicity matrices. -/
theorem padding_northwest_order (S R : Fin m → Fin m → ℕ) (N : ℕ)
    (hS : ∀ a, starts S a ≤ N) (hR : ∀ a, starts R a ≤ N)
    (hdim : ∀ i, crossing S i i = crossing R i i)
    (hrank : ∀ i j, i ≤ j → crossing S i j ≤ crossing R i j) :
    ∀ i j, MAIS.CanonicalPermutation.northWest (padding R N) i j ≤
      MAIS.CanonicalPermutation.northWest (padding S N) i j := by
  intro i j
  by_cases hij : i ≤ j
  · have hRsum := northwest_add_crossing (padding R N) i j
    have hSsum := northwest_add_crossing (padding S N) i j
    rw [padding_crossing R N i j hij] at hRsum
    rw [padding_crossing S N i j hij] at hSsum
    have hmarg := padding_row_margins S R N hS hR i
    have hle := hrank i j hij
    omega
  · rw [northwest_eq_column_of_upper _ (padding_upper R N) i j (by omega),
      northwest_eq_column_of_upper _ (padding_upper S N) i j (by omega)]
    rw [padding_column_margins S R N hS hR hdim j]

/-- A genuine terminating swap chain for the canonical permutations of interval paddings. -/
theorem interval_padding_swap_chain (S R : Fin m → Fin m → ℕ) (N : ℕ)
    (hS : ∀ a, starts S a ≤ N) (hR : ∀ a, starts R a ≤ N)
    (hdim : ∀ i, crossing S i i = crossing R i i)
    (hrank : ∀ i j, i ≤ j → crossing S i j ≤ crossing R i j) :
    let A := padding S N
    let B := padding R N
    let hmass : mass B = mass A := by
      simpa only [rowBoundary_total] using padding_row_margins S R N hS hR m
    let w := MAIS.PermutationInterpolation.reindexPermutation hmass (canonical B)
    ∃ tail : List (Equiv.Perm (Fin (mass A))),
      (canonical A :: tail).IsChain MAIS.PermutationRankOrder.IncreasingSwap ∧
      (canonical A :: tail).getLast (List.cons_ne_nil _ _) = w ∧
      ∀ u ∈ canonical A :: tail,
        MAIS.PermutationRankOrder.RankLE w u ∧
          MAIS.PermutationRankOrder.RankLE u (canonical A) := by
  exact canonical_swap_chain (padding S N) (padding R N)
    (padding_row_margins S R N hS hR)
    (padding_column_margins S R N hS hR hdim)
    (padding_northwest_order S R N hS hR hdim hrank)

end MAIS.IntervalPaddingOrder




