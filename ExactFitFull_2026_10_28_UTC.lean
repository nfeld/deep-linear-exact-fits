-- ==================== begin module O7.Run2PotentialFiniteCountSearch (formalization/O7/Run2PotentialFiniteCountSearch.lean) ====================
section

/-! A genuine finite bound for the independent incidence-count search.
Every actual interval label is injected into one of its active vertex slots;
the actual normal coordinates inject into the square of that label set. No
measured exponent or codimension is used in these cardinality bounds. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set
namespace MAIS.Run2PotentialFiniteCountSearch
open MAIS.QuiverRealOrbit MAIS.BarcodeActiveNormalForm MAIS.ActiveIntervalDifferential
open MAIS.IntervalCochainProduct MAIS.QuiverOrbitFiniteHeight
open MAIS.Run2PotentialBalancedNormalForms MAIS.Run2PotentialBalancedMinimum
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

def birthVertex {A : Rep ι} (N : ActiveNormalForm A) (s : N.Label) : Fin (D + 1) :=
  ⟨N.birth s, by have hv := N.valid s; have hd := N.bounded s; omega⟩

def labelActiveSlot {A : Rep ι} (N : ActiveNormalForm A) :
    N.Label → Σ v : Fin (D + 1), Index D N.birth N.death v :=
  fun s => ⟨birthVertex ι N s, ⟨s, by exact ⟨le_rfl, N.valid s⟩⟩⟩

/-- Every literal interval label occupies its actual birth vertex, so the
number of labels is no larger than the sum of original vertex dimensions. -/
theorem label_card_le_dimensionSum {A : Rep ι} (N : ActiveNormalForm A) :
    Fintype.card N.Label ≤ dimensionSum ι := by
  have hi : Function.Injective (labelActiveSlot ι N) := by
    intro s t h
    exact congrArg (fun p : Σ v : Fin (D + 1), Index D N.birth N.death v => p.2.val) h
  have hc := Fintype.card_le_of_injective (labelActiveSlot ι N) hi
  have hv : (∑ v : Fin (D + 1), Fintype.card (Index D N.birth N.death v)) =
      dimensionSum ι := by
    apply Finset.sum_congr rfl
    intro v _
    exact Fintype.card_congr (N.coordinates v)
  simpa only [Fintype.card_sigma, hv] using hc

/-- Independent normal scalar entries are an actual subtype of label pairs. -/
theorem normal_card_le_dimensionSum_sq {A : Rep ι} (N : ActiveNormalForm A) :
    Fintype.card (NormalIndex N.birth N.death) ≤ dimensionSum ι * dimensionSum ι := by
  have hn : Fintype.card (NormalIndex N.birth N.death) ≤
      Fintype.card (N.Label × N.Label) :=
    Fintype.card_le_of_injective Subtype.val Subtype.val_injective
  rw [Fintype.card_prod] at hn
  exact hn.trans (Nat.mul_le_mul (label_card_le_dimensionSum ι N)
    (label_card_le_dimensionSum ι N))

/-- Every output incidence count is bounded independently of the measured
pair or zero-output condition. This is a literal finite-coordinate bound. -/
theorem outputCount_le_dimensionSum_sq {A : Rep ι} (N : ActiveNormalForm A) :
    outputCount D N.birth N.death ≤ dimensionSum ι * dimensionSum ι := by
  have hc : outputCount D N.birth N.death ≤ Fintype.card (NormalIndex N.birth N.death) := by
    exact Finset.card_filter_le _ _
  exact hc.trans (normal_card_le_dimensionSum_sq ι N)

/-- All independent balanced candidates lie in one explicit finite integer
range. This does not claim a decision procedure for the geometric predicate. -/
theorem balancedOutputCounts_subset_Iic (A : Rep ι) :
    balancedOutputCounts ι A ⊆ Set.Iic (dimensionSum ι * dimensionSum ι) := by
  intro k hk
  rcases hk with ⟨B, N, _, _, _, rfl⟩
  exact outputCount_le_dimensionSum_sq ι N

/-- The independently defined incidence optimization has finitely many
candidate VALUES, proved without using any exponent formula. -/
theorem finite_balancedOutputCounts (A : Rep ι) :
    (balancedOutputCounts ι A).Finite :=
  (Set.finite_Iic _).subset (balancedOutputCounts_subset_Iic ι A)

end MAIS.Run2PotentialFiniteCountSearch

/-- info: 'MAIS.Run2PotentialFiniteCountSearch.label_card_le_dimensionSum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialFiniteCountSearch.label_card_le_dimensionSum

/-- info: 'MAIS.Run2PotentialFiniteCountSearch.outputCount_le_dimensionSum_sq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialFiniteCountSearch.outputCount_le_dimensionSum_sq

/-- info: 'MAIS.Run2PotentialFiniteCountSearch.finite_balancedOutputCounts' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialFiniteCountSearch.finite_balancedOutputCounts
end
end
-- ==================== end module O7.Run2PotentialFiniteCountSearch ====================

-- ==================== begin module O7.Run2BarcodeEnumerationEncoding (formalization/O7/Run2BarcodeEnumerationEncoding.lean) ====================
section

/-! An actual barcode normal form encodes into bounded integer multiplicities,
with a genuine endpoint-preserving bijection of its independent labels. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
namespace MAIS.Run2BarcodeEnumerationEncoding
open MAIS.Run2BarcodeEnumerationData MAIS.QuiverRealOrbit MAIS.BarcodeActiveNormalForm
open MAIS.QuiverOrbitFiniteHeight MAIS.Run2PotentialFiniteCountSearch
variable {D : ℕ} {ι : Fin (D + 1) → Type*}
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]
variable {A : Rep ι} (N : ActiveNormalForm A)

def endpointKey (s : N.Label) : IntervalKey D :=
  (⟨N.birth s, by have h := N.valid s; have hd := N.bounded s; omega⟩,
   ⟨N.death s, by have h := N.bounded s; omega⟩)

def encode : Multiplicities D (dimensionSum ι) := fun p =>
  ⟨Fintype.card {s : N.Label // endpointKey N s = p}, by
    have h := Fintype.card_le_of_injective
      (Subtype.val : {s : N.Label // endpointKey N s = p} → N.Label) Subtype.val_injective
    exact Nat.lt_succ_of_le (h.trans (label_card_le_dimensionSum ι N))⟩

/-- Every actual independent interval label is retained, including repetitions. -/
def labelEquiv : N.Label ≃ Slot (encode N) :=
  (Equiv.sigmaFiberEquiv (endpointKey N)).symm.trans
    (Equiv.sigmaCongrRight fun p => Fintype.equivFin {s : N.Label // endpointKey N s = p})

@[simp] theorem labelEquiv_key (s : N.Label) : (labelEquiv N s).1 = endpointKey N s := rfl
@[simp] theorem labelEquiv_birth (s : N.Label) : birth (labelEquiv N s) = N.birth s := rfl
@[simp] theorem labelEquiv_death (s : N.Label) : death (labelEquiv N s) = N.death s := rfl

/-- The encoded list passes genuine interval validity, rather than deleting
invalid entries only after assigning an invariant. -/
theorem encode_valid : Valid (encode N) := by
  intro s
  obtain ⟨t, rfl⟩ := (labelEquiv N).surjective s
  exact N.valid t

theorem encoded_bounded (s : Slot (encode N)) : death s ≤ D + 1 := by
  have h := s.1.2.isLt
  exact Nat.le_of_lt_succ h

/-- Exact vertex-coordinate bijections survive integer encoding. -/
def vertexEquiv (v : Fin (D + 1)) :
    MAIS.ActiveIntervalDifferential.Index D N.birth N.death v ≃
      {s : Slot (encode N) // birth s ≤ v.val ∧ v.val < death s} :=
  Equiv.subtypeEquiv (labelEquiv N) (fun s => by simp [MAIS.ActiveIntervalDifferential.active])

theorem encode_vertexCount (v : Fin (D + 1)) :
    vertexCount (encode N) v = Fintype.card (ι v) := by
  exact (Fintype.card_congr (vertexEquiv N v)).symm.trans
    (Fintype.card_congr (N.coordinates v))

/-- Exact integer path counts equal literal actual composed-matrix ranks. -/
theorem encode_pathCount (i j : Fin (D + 1)) (hij : i ≤ j) :
    pathCount (encode N) i j = (MAIS.MatrixChainIsomorphism.pathMatrix A i j hij).rank := by
  let e : MAIS.ActiveIntervalPivotRanks.Common D N.birth N.death i j ≃
      {s : Slot (encode N) // birth s ≤ i.val ∧ j.val < death s} :=
    Equiv.subtypeEquiv (labelEquiv N) (fun s => by
      simp only [MAIS.ActiveIntervalDifferential.active, labelEquiv_birth, labelEquiv_death]
      have h : i.val ≤ j.val := hij
      omega)
  exact (Fintype.card_congr e).symm.trans
    ((MAIS.ActiveIntervalPivotRanks.path_rank_eq_common_card D N.birth N.death i j hij).symm.trans
      (N.rank_eq i j hij))

end MAIS.Run2BarcodeEnumerationEncoding

/-- info: 'MAIS.Run2BarcodeEnumerationEncoding.encode_valid' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumerationEncoding.encode_valid

/-- info: 'MAIS.Run2BarcodeEnumerationEncoding.encode_vertexCount' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumerationEncoding.encode_vertexCount

/-- info: 'MAIS.Run2BarcodeEnumerationEncoding.encode_pathCount' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumerationEncoding.encode_pathCount
end
end
-- ==================== end module O7.Run2BarcodeEnumerationEncoding ====================

-- ==================== begin module O7.Run2BarcodeEnumerationIncidence (formalization/O7/Run2BarcodeEnumerationIncidence.lean) ====================
section

/-! Literal normal-incidence balance and output counts are preserved by the
actual integer-slot encoding. No exponent is used to filter the search. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
namespace MAIS.Run2BarcodeEnumerationIncidence
open MAIS.IntervalCochainProduct MAIS.Run2PotentialStationarity MAIS.Run2PotentialBalance
open MAIS.Run2PotentialBalancedNormalForms MAIS.Run2BarcodeEnumerationData
open MAIS.Run2BarcodeEnumerationEncoding MAIS.QuiverRealOrbit MAIS.BarcodeActiveNormalForm
open MAIS.QuiverOrbitFiniteHeight
variable {S : Type*} [Fintype S] [DecidableEq S] (b d : S → ℕ)

def incomingEquiv (v : S) :
    {p : NormalIndex b d // targetSlot b d p = v} ≃
      {s : S // MAIS.IntervalCochainProduct.Linked b d v s} where
  toFun p := ⟨p.val.val.2, by
    have hp := p.val.property
    have he : p.val.val.1 = v := p.property
    simpa only [he] using hp⟩
  invFun s := ⟨⟨(v, s.val), s.property⟩, rfl⟩
  left_inv p := by
    apply Subtype.ext
    apply Subtype.ext
    exact Prod.ext p.property.symm rfl
  right_inv s := rfl

def outgoingEquiv (v : S) :
    {p : NormalIndex b d // sourceSlot b d p = v} ≃
      {r : S // MAIS.IntervalCochainProduct.Linked b d r v} where
  toFun p := ⟨p.val.val.1, by
    have hp := p.val.property
    have he : p.val.val.2 = v := p.property
    simpa only [he] using hp⟩
  invFun r := ⟨⟨(r.val, v), r.property⟩, rfl⟩
  left_inv p := by
    apply Subtype.ext
    apply Subtype.ext
    exact Prod.ext rfl p.property.symm
  right_inv r := rfl

theorem target_fiberCount (v : S) : fiberCount (targetSlot b d) v =
    Fintype.card {s : S // MAIS.IntervalCochainProduct.Linked b d v s} := by
  rw [fiberCount, ← Fintype.card_subtype]
  exact Fintype.card_congr (incomingEquiv b d v)

theorem source_fiberCount (v : S) : fiberCount (sourceSlot b d) v =
    Fintype.card {r : S // MAIS.IntervalCochainProduct.Linked b d r v} := by
  rw [fiberCount, ← Fintype.card_subtype]
  exact Fintype.card_congr (outgoingEquiv b d v)

theorem actual_outputCount (D : ℕ) : MAIS.Run2PotentialBalancedNormalForms.outputCount D b d =
    Fintype.card {p : S × S // MAIS.IntervalCochainProduct.Linked b d p.1 p.2 ∧ d p.1 = D + 1} := by
  unfold MAIS.Run2PotentialBalancedNormalForms.outputCount outputEdgeCount
  rw [← Fintype.card_subtype]
  apply Fintype.card_congr
  exact { toFun := fun p => ⟨p.val.val, p.val.property, (Finset.mem_filter.mp p.property).2⟩
          invFun := fun p => ⟨⟨p.val, p.property.1⟩,
            Finset.mem_filter.mpr ⟨Finset.mem_univ _, p.property.2⟩⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl }

variable {D : ℕ} {ι : Fin (D + 1) → Type*}
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]
variable {A : Rep ι} (N : ActiveNormalForm A)

theorem encode_incoming (v : N.Label) :
    fiberCount (targetSlot N.birth N.death) v = incoming (labelEquiv N v) := by
  rw [target_fiberCount]
  apply Fintype.card_congr
  exact Equiv.subtypeEquiv (labelEquiv N) (fun s => by
    simp only [Run2BarcodeEnumerationData.Linked, labelEquiv_birth, labelEquiv_death,
      MAIS.IntervalCochainProduct.Linked])

theorem encode_outgoing (v : N.Label) :
    fiberCount (sourceSlot N.birth N.death) v = outgoing (labelEquiv N v) := by
  rw [source_fiberCount]
  apply Fintype.card_congr
  exact Equiv.subtypeEquiv (labelEquiv N) (fun r => by
    simp only [Run2BarcodeEnumerationData.Linked, labelEquiv_birth, labelEquiv_death,
      MAIS.IntervalCochainProduct.Linked])

/-- The finite arithmetic balance test equals actual independent normal
incidence balance, including every repeated label. -/
theorem encode_balanced_iff : Run2BarcodeEnumerationData.Balanced (encode N) ↔
    MAIS.Run2PotentialBalancedNormalForms.Balanced D N.birth N.death := by
  constructor
  · intro h v hi ho
    rw [encode_incoming N v, encode_outgoing N v]
    exact h (labelEquiv N v) hi ho
  · intro h s hi ho
    obtain ⟨v, rfl⟩ := (labelEquiv N).surjective s
    rw [← encode_incoming N v, ← encode_outgoing N v]
    exact h v hi ho

/-- The computed integer objective is the literal output-target normal
coordinate count of the actual normal representative. -/
theorem encode_outputCount : Run2BarcodeEnumerationData.outputCount (encode N) =
    MAIS.Run2PotentialBalancedNormalForms.outputCount D N.birth N.death := by
  rw [actual_outputCount]
  symm
  apply Fintype.card_congr
  exact Equiv.subtypeEquiv ((labelEquiv N).prodCongr (labelEquiv N)) (fun p => by
    rcases p with ⟨r, s⟩
    rfl)

end MAIS.Run2BarcodeEnumerationIncidence

/-- info: 'MAIS.Run2BarcodeEnumerationIncidence.encode_balanced_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumerationIncidence.encode_balanced_iff

/-- info: 'MAIS.Run2BarcodeEnumerationIncidence.encode_outputCount' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumerationIncidence.encode_outputCount
end
end
-- ==================== end module O7.Run2BarcodeEnumerationIncidence ====================

-- ==================== begin module O7.Run2BarcodeEnumerationRealization (formalization/O7/Run2BarcodeEnumerationRealization.lean) ====================
section

/-! Every feasible integer array produces a literal interval matrix chain on
the original architecture, with exactly the counted ranks and actual real
orbit-closure relation. No measured invariant is supplied. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
namespace MAIS.Run2BarcodeEnumerationRealization
open MAIS.Run2BarcodeEnumerationData MAIS.ActiveIntervalDifferential
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.MatrixCoordinateTransport
open MAIS.BarcodeActiveNormalForm
variable {D M : ℕ} (h : Multiplicities D M)

def slotBirth (s : Slot h) : ℕ := Run2BarcodeEnumerationData.birth s
def slotDeath (s : Slot h) : ℕ := Run2BarcodeEnumerationData.death s

theorem slot_bounded (s : Slot h) : slotDeath h s ≤ D + 1 := by
  exact Nat.le_of_lt_succ s.1.2.isLt

theorem interval_path_rank (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (intervalRep D (slotBirth h) (slotDeath h)) i j hij).rank = pathCount h i j := by
  rw [MAIS.ActiveIntervalPivotRanks.path_rank_eq_common_card]
  apply Fintype.card_congr
  refine Equiv.subtypeEquivRight (fun s => ?_)
  change ((slotBirth h s ≤ i.val ∧ i.val < slotDeath h s) ∧
    (slotBirth h s ≤ j.val ∧ j.val < slotDeath h s)) ↔
    (slotBirth h s ≤ i.val ∧ j.val < slotDeath h s)
  have hh : i.val ≤ j.val := hij
  omega

lemma matrix_eq_zero_of_rank_zero {R C : Type*} [Fintype R] [Fintype C]
    [DecidableEq C] (P : Matrix R C ℝ) (hz : P.rank = 0) : P = 0 := by
  have hlin : P.mulVecLin = 0 :=
    LinearMap.range_eq_bot.mp (Submodule.finrank_eq_zero.mp hz)
  ext r c
  have hc := congrArg (fun f : (C → ℝ) →ₗ[ℝ] (R → ℝ) => f (Pi.single c 1) r) hlin
  simpa using hc

variable (ι : Fin (D + 1) → Type*) [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

def vertexCoordinates (hd : ∀ v, vertexCount h v = Fintype.card (ι v))
    (v : Fin (D + 1)) : Index D (slotBirth h) (slotDeath h) v ≃ ι v :=
  Fintype.equivOfCardEq (hd v)

def actualRep (hd : ∀ v, vertexCount h v = Fintype.card (ι v)) : Rep ι :=
  transport (vertexCoordinates h ι hd) (intervalRep D (slotBirth h) (slotDeath h))

/-- The integer path count is the rank of the actual composed rectangular
matrices, not a rank assigned to a formal barcode. -/
theorem actualRep_rank (hd : ∀ v, vertexCount h v = Fintype.card (ι v))
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (actualRep h ι hd) i j hij).rank = pathCount h i j := by
  rw [actualRep, path_rank_transport, interval_path_rank]

theorem actualRep_zero (hd : ∀ v, vertexCount h v = Fintype.card (ι v))
    (hz : pathCount h 0 (Fin.last D) = 0) :
    pathMatrix (actualRep h ι hd) 0 (Fin.last D) (Nat.zero_le D) = 0 :=
  matrix_eq_zero_of_rank_zero _ ((actualRep_rank h ι hd 0 (Fin.last D) _).trans hz)

/-- A valid integer array is itself actual interval normal-form data for its
constructed chain, without invoking an external classification oracle. -/
def actualNormalForm (hv : Valid h)
    (hd : ∀ v, vertexCount h v = Fintype.card (ι v)) : ActiveNormalForm (actualRep h ι hd) where
  Label := Slot h
  birth := slotBirth h
  death := slotDeath h
  valid := hv
  bounded := slot_bounded h
  coordinates := vertexCoordinates h ι hd
  original_in_orbit := MulAction.mem_orbit_self _
  rank_eq := by
    intro i j hij
    exact (path_rank_transport (vertexCoordinates h ι hd)
      (intervalRep D (slotBirth h) (slotDeath h)) i j hij).symm

/-- Exact rank feasibility realizes the actual higher-orbit relation. -/
theorem actualRep_closure (A : Rep ι)
    (hf : Feasible (fun v => Fintype.card (ι v))
      (fun i j => if hij : i ≤ j then (pathMatrix A i j hij).rank else 0) h) :
    A ∈ closure (MulAction.orbit (Gauge ι) (actualRep h ι hf.2.1)) := by
  apply MAIS.RealTypeAClosure.mem_closure_orbit_of_path_rank_le
  intro i j hij
  rw [actualRep_rank]
  simpa only [dite_eq_left hij] using hf.2.2.2 i j hij

/-- The feasibility rank inequalities imply actual ordinary Euclidean
orbit closure on the original carrier. -/
theorem feasible_realization (A : Rep ι)
    (hf : Feasible (fun v => Fintype.card (ι v))
      (fun i j => if hij : i ≤ j then (pathMatrix A i j hij).rank else 0) h) :
    ∃ B : Rep ι, pathMatrix B 0 (Fin.last D) (Nat.zero_le D) = 0 ∧
      A ∈ closure (MulAction.orbit (Gauge ι) B) ∧
      ∃ N : ActiveNormalForm B, N.Label = Slot h := by
  refine ⟨actualRep h ι hf.2.1, actualRep_zero h ι hf.2.1 hf.2.2.1, ?_,
    actualNormalForm h ι hf.1 hf.2.1, rfl⟩
  apply MAIS.RealTypeAClosure.mem_closure_orbit_of_path_rank_le
  intro i j hij
  rw [actualRep_rank]
  simpa only [dite_eq_left hij] using hf.2.2.2 i j hij

end MAIS.Run2BarcodeEnumerationRealization

/-- info: 'MAIS.Run2BarcodeEnumerationRealization.actualRep_rank' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumerationRealization.actualRep_rank

/-- info: 'MAIS.Run2BarcodeEnumerationRealization.actualRep_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumerationRealization.actualRep_zero

/-- info: 'MAIS.Run2BarcodeEnumerationRealization.actualRep_closure' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumerationRealization.actualRep_closure

/-- info: 'MAIS.Run2BarcodeEnumerationRealization.feasible_realization' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumerationRealization.feasible_realization
end
end
-- ==================== end module O7.Run2BarcodeEnumerationRealization ====================

-- ==================== begin module O7.Run2BarcodeEnumeration (formalization/O7/Run2BarcodeEnumeration.lean) ====================
section

/-! Exact equality between a literal bounded arithmetic enumeration and the
independently defined attained balanced-incidence candidates. The only
noncomputable input conversion is taking ranks of an arbitrary real chain;
the enumeration itself consumes integer dimensions and integer ranks. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2BarcodeEnumeration
open MAIS.Run2BarcodeEnumerationData MAIS.Run2BarcodeEnumerationEncoding
open MAIS.Run2BarcodeEnumerationIncidence MAIS.Run2BarcodeEnumerationRealization
open MAIS.QuiverRealOrbit MAIS.BarcodeActiveNormalForm MAIS.MatrixChainIsomorphism
open MAIS.QuiverOrbitFiniteHeight MAIS.Run2PotentialBalancedMinimum
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

def architecture : Fin (D + 1) → ℕ := fun v => Fintype.card (ι v)
def pathRankInput (A : Rep ι) (i j : Fin (D + 1)) : ℕ :=
  if hij : i ≤ j then (pathMatrix A i j hij).rank else 0

def enumeratedValues (A : Rep ι) : Finset ℕ :=
  outputValues (M := dimensionSum ι) (architecture ι) (pathRankInput ι A)

/-- Every actual higher zero-output normal form occurs in the bounded
integer list, with its actual original dimensions and composed ranks. -/
theorem encode_feasible (A B : Rep ι)
    (hzero : pathMatrix B 0 (Fin.last D) (Nat.zero_le D) = 0)
    (hclosure : A ∈ closure (MulAction.orbit (Gauge ι) B)) (N : ActiveNormalForm B) :
    Feasible (architecture ι) (pathRankInput ι A) (encode N) := by
  refine ⟨encode_valid N, encode_vertexCount N, ?_, ?_⟩
  · rw [encode_pathCount N 0 (Fin.last D) (Nat.zero_le D), hzero, Matrix.rank_zero]
  · intro i j hij
    rw [pathRankInput, dite_eq_left hij, encode_pathCount N i j hij]
    exact (MAIS.RealTypeAClosure.mem_closure_orbit_iff_path_rank_le A B).mp hclosure i j hij

theorem realized_balanced_iff {M : ℕ} (h : Multiplicities D M) :
    MAIS.Run2PotentialBalancedNormalForms.Balanced D (slotBirth h) (slotDeath h) ↔
      Run2BarcodeEnumerationData.Balanced h := by
  simp only [MAIS.Run2PotentialBalancedNormalForms.Balanced,
    Run2BarcodeEnumerationData.Balanced, target_fiberCount, source_fiberCount]
  rfl

theorem realized_outputCount {M : ℕ} (h : Multiplicities D M) :
    MAIS.Run2PotentialBalancedNormalForms.outputCount D (slotBirth h) (slotDeath h) =
      Run2BarcodeEnumerationData.outputCount h := by
  rw [actual_outputCount]
  rfl

/-- Soundness and completeness of the executable integer candidate list.
The set on the right is defined geometrically by actual higher real orbits
and actual balanced normal incidence; it contains no measured pair input. -/
theorem enumeratedValues_eq (A : Rep ι) :
    (enumeratedValues ι A : Set ℕ) = balancedOutputCounts ι A := by
  ext k
  change k ∈ outputValues (M := dimensionSum ι) (architecture ι) (pathRankInput ι A) ↔ _
  rw [mem_outputValues]
  constructor
  · rintro ⟨h, hf, hb, hk⟩
    refine ⟨actualRep h ι hf.2.1, actualNormalForm h ι hf.1 hf.2.1,
      actualRep_zero h ι hf.2.1 hf.2.2.1, actualRep_closure h ι A hf, ?_, ?_⟩
    · exact (realized_balanced_iff h).mpr hb
    · exact hk.symm.trans (realized_outputCount h).symm
  · rintro ⟨B, N, hz, hc, hb, hk⟩
    exact ⟨encode N, encode_feasible ι A B hz hc N,
      (encode_balanced_iff N).mpr hb, (encode_outputCount N).trans hk.symm⟩

/-- Every actual zero-output chain has an attained feasible arithmetic
minimum; zero-dimensional vertices and depth zero need no exception. -/
theorem enumeratedValues_nonempty (A : Rep ι)
    (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    (enumeratedValues ι A).Nonempty := by
  have h := balancedOutputCounts_nonempty ι A hzero
  rw [← enumeratedValues_eq ι A] at h
  exact h

/-- The actual independent geometric minimum equals the explicitly
computed minimum of the finite integer list. -/
theorem computed_minimum_eq (A : Rep ι)
    (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    (enumeratedValues ι A).min' (enumeratedValues_nonempty ι A hzero) =
      balancedOutputMinimum ι A := by
  apply le_antisymm
  · apply Finset.min'_le
    change balancedOutputMinimum ι A ∈ (enumeratedValues ι A : Set ℕ)
    rw [enumeratedValues_eq]
    exact balancedOutputMinimum_mem ι A hzero
  · apply csInf_le ⟨0, fun _ _ => Nat.zero_le _⟩
    rw [← enumeratedValues_eq]
    exact Finset.min'_mem _ _

/-- The proof-free executable minimum returns the actual finite optimum. -/
theorem executable_minimum_eq (A : Rep ι)
    (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    minimum (M := dimensionSum ι) (architecture ι) (pathRankInput ι A) =
      (balancedOutputMinimum ι A : WithTop ℕ) := by
  change (enumeratedValues ι A).min = _
  rw [← Finset.coe_min' (enumeratedValues_nonempty ι A hzero), computed_minimum_eq ι A hzero]
  rfl

/-- This is a theorem about genuine Haar sublevel volumes, with the
executable minimum obtained independently from bounded integer arrays. -/
theorem measured_exponent_eq_half_computed_minimum
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : MAIS.AnalyticTransfer.HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    lam = ((enumeratedValues ι A).min' (enumeratedValues_nonempty ι A hzero) : ℝ) / 2 := by
  rw [computed_minimum_eq ι A hzero]
  exact exponent_eq_half_balancedOutputMinimum ι mu A hzero hp

/-- Full original-entry Euclidean balls and arbitrary continuous positive
source priors retain the same independently computed finite minimum. -/
theorem entry_half_prior_exponent_eq_half_computed_minimum
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    {lam : ℝ} {m : ℕ}
    (hp : MAIS.AnalyticTransfer.HasMeasuredBandPair
      (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1 / 2 : ℝ) * ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2)
      A lam m) :
    lam = ((enumeratedValues ι A).min' (enumeratedValues_nonempty ι A hzero) : ℝ) / 2 := by
  rw [computed_minimum_eq ι A hzero]
  exact entry_half_prior_exponent_eq_half_balancedOutputMinimum ι mu A hzero prior hprior hpos hp

end MAIS.Run2BarcodeEnumeration

/-- info: 'MAIS.Run2BarcodeEnumeration.enumeratedValues_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumeration.enumeratedValues_eq

/-- info: 'MAIS.Run2BarcodeEnumeration.enumeratedValues_nonempty' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumeration.enumeratedValues_nonempty

/-- info: 'MAIS.Run2BarcodeEnumeration.computed_minimum_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumeration.computed_minimum_eq

/-- info: 'MAIS.Run2BarcodeEnumeration.executable_minimum_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumeration.executable_minimum_eq

/-- info: 'MAIS.Run2BarcodeEnumeration.measured_exponent_eq_half_computed_minimum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumeration.measured_exponent_eq_half_computed_minimum

/-- info: 'MAIS.Run2BarcodeEnumeration.entry_half_prior_exponent_eq_half_computed_minimum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumeration.entry_half_prior_exponent_eq_half_computed_minimum
