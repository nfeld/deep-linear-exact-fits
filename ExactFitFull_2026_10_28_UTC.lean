-- ==================== begin module O7.WeightedAnnulusFiniteTable (formalization/O7/WeightedAnnulusFiniteTable.lean) ====================
section

/-! Actual compact weighted-annulus order from an attained finite table
of genuine ambient local measured pairs. Boundary lower patches are moved
into the true interior by derived weighted dilation geometry. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.WeightedAnnulusFiniteTable
open MAIS.AnalyticTransfer O77.Residual
open MAIS.WeightedDyadicShells MAIS.WeightedCompactAnnulus
open MAIS.WeightedAnnulusPairTransport MAIS.WeightedAnnulusInterior
variable {I : Type*} [Fintype I] [DecidableEq I]

omit [DecidableEq I] in
/-- An actual ambient pair attained anywhere on the compact annulus is
attained at a genuine interior zero. The point, zero equation and pair
transport are constructed; no boundary-relative estimate is assumed. -/
theorem interior_attainment (mu : Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (W : I→ℕ) (hW : ∀ i,0<W i) (d : ℕ) (f : (I→ℝ)→ℝ) (hf : Measurable f)
    (hhom : ∀ r:ℝ,0<r→∀ x,f (dilation W r x)=r^d*f x)
    {x : I→ℝ} (hx : x∈compactAnnulus W) (hfx : f x=0) {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball x) f x lam m) :
    ∃ y,y∈interior (compactAnnulus W) ∧ f y=0 ∧
      HasMeasuredBandPair mu (Metric.ball y) f y lam m := by
  obtain ⟨r,hr,hy⟩ := exists_positive_dilation_mem_interior W hW x hx
  refine ⟨dilation W r x,hy,?_,?_⟩
  · rw [hhom r hr x,hfx,mul_zero]
  · exact (pair_iff_dilation mu W d f hf hhom r hr x lam m).mp hp

omit [DecidableEq I] in
/-- The actual aggregate compact-annulus order is derived from a finite
attained table of AMBIENT residual-loss pairs, without any local-relative
pair premise or assumed uniform estimate at the boundary. -/
theorem annulus_order_of_ambient_types
    {J : Type*} [Fintype J] [Nonempty J] (a : J→ℝ) (m : J→ℕ)
    (mu : Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (W : I→ℕ) (hW : ∀ i,0<W i) (d : ℕ) (f : (I→ℝ)→ℝ) (hf : Continuous f)
    (hhom : ∀ r:ℝ,0<r→∀ x,f (dilation W r x)=r^d*f x)
    (hlocal : ∀ x,x∈compactAnnulus W→f x=0→∃ j,
      HasMeasuredBandPair mu (Metric.ball x) f x (a j) (m j))
    (hattained : ∀ j,∃ x,x∈compactAnnulus W ∧ f x=0 ∧
      HasMeasuredBandPair mu (Metric.ball x) f x (a j) (m j)) :
    ∃ j,(∀ i,a j<a i ∨ a j=a i ∧ m i ≤ m j) ∧
      EThetaZeroPowerLog (fun eps=>mu {x | x∈compactAnnulus W ∧ |f x|<eps})
        (a j) (m j-1) := by
  apply MAIS.CompactAmbientBandTable.compact_order_of_ambient_types a m mu
    (isCompact_compactAnnulus W) hf hlocal
  intro j
  obtain ⟨x,hx,hfx,hp⟩ := hattained j
  exact interior_attainment mu W hW d f hf.measurable hhom hx hfx hp

omit [DecidableEq I] in
/-- Nonnegative actual losses give the literal ordinary annular sublevel
band required by the numeric radial recurrence. -/
theorem annulus_sublevel_order_of_ambient_types
    {J : Type*} [Fintype J] [Nonempty J] (a : J→ℝ) (m : J→ℕ)
    (mu : Measure (I→ℝ)) [Measure.IsAddHaarMeasure mu]
    (W : I→ℕ) (hW : ∀ i,0<W i) (d : ℕ) (f : (I→ℝ)→ℝ) (hf : Continuous f)
    (hnonneg : ∀ x,0≤f x)
    (hhom : ∀ r:ℝ,0<r→∀ x,f (dilation W r x)=r^d*f x)
    (hlocal : ∀ x,x∈compactAnnulus W→f x=0→∃ j,
      HasMeasuredBandPair mu (Metric.ball x) f x (a j) (m j))
    (hattained : ∀ j,∃ x,x∈compactAnnulus W ∧ f x=0 ∧
      HasMeasuredBandPair mu (Metric.ball x) f x (a j) (m j)) :
    ∃ j,(∀ i,a j<a i ∨ a j=a i ∧ m i ≤ m j) ∧
      EThetaZeroPowerLog (fun eps=>mu {x | x∈compactAnnulus W ∧ f x<eps})
        (a j) (m j-1) := by
  obtain ⟨j,hbest,horder⟩ := annulus_order_of_ambient_types a m mu W hW d f hf hhom hlocal hattained
  refine ⟨j,hbest,?_⟩
  simpa only [abs_of_nonneg (hnonneg _)] using horder

end MAIS.WeightedAnnulusFiniteTable
end

/-- info: 'MAIS.WeightedAnnulusFiniteTable.interior_attainment' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedAnnulusFiniteTable.interior_attainment

/-- info: 'MAIS.WeightedAnnulusFiniteTable.annulus_order_of_ambient_types' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedAnnulusFiniteTable.annulus_order_of_ambient_types

/-- info: 'MAIS.WeightedAnnulusFiniteTable.annulus_sublevel_order_of_ambient_types' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedAnnulusFiniteTable.annulus_sublevel_order_of_ambient_types
end
