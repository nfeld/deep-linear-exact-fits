-- ==================== begin module O7.Run2GeometricActualFiber (formalization/O7/Run2GeometricActualFiber.lean) ====================
section

/-! Actual arbitrary-output matrix-product fiber geometry, independently of
measured exponents. The actual normal-form fiber has integral Hausdorff local
dimension, and its geometric codimension equals the independently counted
regular output dimension plus the genuine reduced zero-fiber codimension. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
noncomputable section
open Set
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2GeometricActualFiber
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.BarcodeActiveNormalForm
open MAIS.ActiveIntervalDifferential MAIS.Run2FullSpanCoordinates MAIS.Run2FullSpanSlice
open MAIS.Run2GeometricCharts MAIS.Run2GeometricCodimCharts MAIS.Run2GeometricIntegralCodim
open MAIS.Run2GeometricFullSpanFiber MAIS.Run2GeometricLearningCodimension
open MAIS.Run2PositiveFiberTransport MAIS.Run2PositiveNormalFormCounts
open MAIS.Run2GeometricCodimension MAIS.Run2PotentialBalancedMinimum
variable {D : ℕ} (ι : Fin (D+1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

/-- Geometric codimension of the literal fixed-product fiber at an arbitrary
actual center, with no measured pair among the premises. -/
theorem geometricCodimNat_fixedProductFiber (hD : 0<D) {A : Rep ι}
    (N : ActiveNormalForm A) :
    geometricCodimNat (fixedProductFiber ι A) A=regularCount A+
      localCodimNat (ReducedIndex D N.birth N.death)
        (intervalRep D (reducedBirth D N.birth N.death) (reducedDeath D N.birth N.death)) := by
  let C := intervalRep D N.birth N.death
  have h1 := geometricCodimNat_normal_form ι N
  have h2 := geometricCodimNat_coordinate (Index D N.birth N.death)
    (vertexEquiv D N.birth N.death) C
  have h3 := split_fiber_codim D N.birth N.death N.bounded hD N.valid
  have he : geometricCodimNat (fixedProductFiber ι A) A =
      Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace
        (FullSlot D N.birth N.death) (ReducedIndex D N.birth N.death (Fin.last D))
        (ReducedIndex D N.birth N.death 0)) +
      MAIS.Run2GeometricCodimension.localCodimNat (ReducedIndex D N.birth N.death)
        (intervalRep D (reducedBirth D N.birth N.death) (reducedDeath D N.birth N.death)) :=
    h1.trans (h2.symm.trans h3)
  rw [finrank_regular_eq_actual_count N] at he
  exact he

/-- The geometric formula may also be expressed by the independent actual
balanced-incidence minimum of the reduced zero-output chain. -/
theorem geometricCodimNat_eq_balanced_count (hD : 0<D) {A : Rep ι}
    (N : ActiveNormalForm A) :
    geometricCodimNat (fixedProductFiber ι A) A=regularCount A+
      balancedOutputMinimum (ReducedIndex D N.birth N.death)
        (intervalRep D (reducedBirth D N.birth N.death) (reducedDeath D N.birth N.death)) := by
  rw [geometricCodimNat_fixedProductFiber ι hD N,
    localCodimNat_eq_balancedOutputMinimum (ReducedIndex D N.birth N.death)
      (intervalRep D (reducedBirth D N.birth N.death) (reducedDeath D N.birth N.death))
      (MAIS.Run2FullSpanProduct.reduced_base_completeProduct_zero D N.birth N.death N.bounded)]

/-- Actual integral Hausdorff local dimension of every literal product fiber
in positive depth; this is established by actual charts before any measured
exponent is invoked. -/
theorem fixedProductFiber_integralLocalDimension (hD : 0<D) {A : Rep ι}
    (N : ActiveNormalForm A) :
    ∃ n : ℕ,localDimH (fixedProductFiber ι A) A=(n:ℝ≥0∞) := by
  obtain ⟨n,hn⟩ := (split_fiber_codim_and_integral D N.birth N.death N.bounded hD N.valid).2
  refine ⟨n,?_⟩
  rw [localDimH_normal_form ι N]
  have ht := localDimH_coordinate (Index D N.birth N.death)
    (vertexEquiv D N.birth N.death) (intervalRep D N.birth N.death)
  exact ht.symm.trans hn

/-- Therefore true ambient-minus-Hausdorff codimension agrees with its natural
presentation at every actual positive-depth product fiber. -/
theorem geometricCodimH_fixedProductFiber (hD : 0<D) {A : Rep ι}
    (N : ActiveNormalForm A) :
    geometricCodimH (fixedProductFiber ι A) A=
      ((regularCount A+localCodimNat (ReducedIndex D N.birth N.death)
        (intervalRep D (reducedBirth D N.birth N.death) (reducedDeath D N.birth N.death)):ℕ):ℝ≥0∞) := by
  rw [geometricCodimH_eq_nat _ _ (fixedProductFiber_integralLocalDimension ι hD N),
    geometricCodimNat_fixedProductFiber ι hD N]
end MAIS.Run2GeometricActualFiber

/-- info: 'MAIS.Run2GeometricActualFiber.geometricCodimNat_fixedProductFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricActualFiber.geometricCodimNat_fixedProductFiber

/-- info: 'MAIS.Run2GeometricActualFiber.geometricCodimNat_eq_balanced_count' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricActualFiber.geometricCodimNat_eq_balanced_count

/-- info: 'MAIS.Run2GeometricActualFiber.fixedProductFiber_integralLocalDimension' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricActualFiber.fixedProductFiber_integralLocalDimension

/-- info: 'MAIS.Run2GeometricActualFiber.geometricCodimH_fixedProductFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricActualFiber.geometricCodimH_fixedProductFiber
end
