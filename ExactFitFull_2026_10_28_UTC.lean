-- ==================== begin module O7.Run2PotentialRadialThreshold (formalization/O7/Run2PotentialRadialThreshold.lean) ====================
section

/-! The actual canonical radial threshold equals the full-normal real-potential
threshold. This is an exact coordinate-partition identity, not a definition of
an exponent: every direct coordinate has potential difference one and the
remaining integer weights are the cleared genuine real differences. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialRadialThreshold
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalDirectElimination
open MAIS.ActiveIntervalWeightedResidual MAIS.ActiveIntervalNumericRecurrence
open MAIS.ActiveIntervalAnnulusRecurrence MAIS.IntervalIntegerPotentials
open MAIS.Run2PotentialNormalBound MAIS.Run2PotentialBalance
open MAIS.MatrixChainIsomorphism
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

include hD in
/-- The canonical interval potential is actually admissible at every true
zero-output base, including empty vertex and normal-coordinate carriers. -/
theorem canonical_admissible
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (Nat.zero_le D) = 0) :
    AdmissiblePotential D birth death (realPotential D birth death) := by
  refine ⟨?_, ?_, ?_⟩
  · intro s hs
    apply realPotential_birth_zero D birth death s
    simpa only [inputSlots, Finset.mem_filter, Finset.mem_univ, true_and] using hs
  · intro s hs
    apply realPotential_death_last D birth death
      (MAIS.IntervalPositivePotentials.denominator_pos_of_zero_path D birth death hD hzero) s
    simpa only [outputSlots, Finset.mem_filter, Finset.mem_univ, true_and] using hs
  · intro p
    exact sub_pos.mp (real_edgeWeight_pos D birth death hD p)

include hD in
/-- Full-normal and Gaussian-split radial thresholds agree as actual finite
sums on the true independent coordinate sets. -/
theorem radial_threshold_eq
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (Nat.zero_le D) = 0) :
    radialRatio D birth death + (Fintype.card (DirectIndex D birth death) : ℝ) / 2 =
      threshold birth death (realPotential D birth death) := by
  have hproper := MAIS.IntervalPositivePotentials.denominator_pos_of_zero_path
    D birth death hD hzero
  have hM : (commonDenominator D birth death : ℝ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Nat.ne_of_gt (commonDenominator_pos D birth death hproper))
  have hw (p : ResidualIndex D birth death) :
      (integerWeights D birth death p : ℝ) =
        (commonDenominator D birth death : ℝ) *
          edgeWeights birth death (realPotential D birth death) p.val := by
    have hh := integerWeight_cast D birth death hD hproper p.val
    unfold MAIS.IntervalPositivePotentials.edgeWeight at hh
    change (integerWeight D birth death p.val : ℝ) = _
    unfold edgeWeights realPotential
    exact_mod_cast hh
  have hsum : (∑ p : ResidualIndex D birth death, integerWeights D birth death p : ℝ) =
      (commonDenominator D birth death : ℝ) *
        ∑ p : ResidualIndex D birth death,
          edgeWeights birth death (realPotential D birth death) p.val := by
    simp_rw [hw]
    rw [Finset.mul_sum]
  have hd (p : DirectIndex D birth death) :
      edgeWeights birth death (realPotential D birth death) p.val = 1 := by
    change realPotential D birth death p.val.val.1 -
      realPotential D birth death p.val.val.2 = 1
    rw [realPotential_birth_zero D birth death p.val.val.2 p.property.1,
      realPotential_death_last D birth death hproper p.val.val.1 p.property.2]
    norm_num
  have hpartition := Fintype.sum_subtype_add_sum_subtype
    (IsDirect D birth death)
    (edgeWeights birth death (realPotential D birth death))
  have hdirect : (∑ p : DirectIndex D birth death,
      edgeWeights birth death (realPotential D birth death) p.val) =
        (Fintype.card (DirectIndex D birth death) : ℝ) := by
    simp_rw [hd]
    simp
  rw [hdirect] at hpartition
  unfold radialRatio threshold
  push_cast
  rw [hsum]
  field_simp
  nlinarith [hpartition]

end MAIS.Run2PotentialRadialThreshold

/-- info: 'MAIS.Run2PotentialRadialThreshold.canonical_admissible' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialRadialThreshold.canonical_admissible

/-- info: 'MAIS.Run2PotentialRadialThreshold.radial_threshold_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialRadialThreshold.radial_threshold_eq
end
end
-- ==================== end module O7.Run2PotentialRadialThreshold ====================

-- ==================== begin module O7.Run2PotentialActualRecurrence (formalization/O7/Run2PotentialActualRecurrence.lean) ====================
section

/-! A numerical recurrence for the ACTUAL measured pair, over ALL actual
strict higher zero-output real orbits. All label values are genuine measured
witnesses and all their annular attainments are derived. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2600000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Topology ENNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialActualRecurrence
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalMeasuredSlice
open MAIS.ActiveIntervalRecursivePair MAIS.ActiveIntervalNumericRecurrence
open MAIS.ActiveIntervalExistenceStep MAIS.Run2PotentialAllHigherLabels
open MAIS.Run2PotentialNormalBound MAIS.Run2PotentialRadialThreshold
open MAIS.ActiveIntervalWeightedResidual MAIS.QuiverFinitePairTable
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.AnalyticTransfer
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

include hD in
/-- For a nonterminal actual normal model, a genuine strict higher zero orbit
attains the smallest higher exponent and largest tied multiplicity, and the
actual base pair obeys the complete three-branch numerical recurrence. -/
theorem actual_nonterminal_recurrence
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    [Nonempty (ResidualIndex D birth death)]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {n : ℕ}
    (hp : HasMeasuredBandPair muA (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
      (intervalRep D birth death) lam n) :
    ∃ B : Ambient D birth death, ∃ a : ℝ, ∃ m : ℕ,
      IsHigherZero (Index D birth death) (intervalRep D birth death) B ∧
      HasMeasuredBandPair muA (Metric.ball B)
        (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) B a m ∧
      (∀ C : Ambient D birth death,
        IsHigherZero (Index D birth death) (intervalRep D birth death) C →
        ∀ a' : ℝ, ∀ m' : ℕ,
        HasMeasuredBandPair muA (Metric.ball C)
          (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) C a' m' →
        a < a' ∨ a = a' ∧ m' ≤ m) ∧
      lam = min a (threshold birth death (realPotential D birth death)) ∧
      n = if a < threshold birth death (realPotential D birth death) then m else
        if a = threshold birth death (realPotential D birth death) then m + 1 else 1 := by
  let muT : Measure (NormalParams birth death) := addHaar
  let muR : Measure (Residual D birth death) := addHaar
  obtain ⟨a, m, hcover, hall, hrep⟩ := exists_all_attained_higher_table
    D birth death hD hvalid muA muT muR hzero
  obtain ⟨j, _, hbest, htri⟩ := ambient_pair_recurrence_of_higher_table
    D birth death hD a m hvalid muA muT muR hzero hcover
    (fun _ => 1) continuousAt_const zero_lt_one
  refine ⟨representative (Index D birth death) (intervalRep D birth death) j,
    a j, m j, (representative_spec _ _ j).1, hrep j, ?_, ?_⟩
  · intro C hC a' m' hCpair
    obtain ⟨i, hi⟩ := hcover C hC.1 hC.2.1 hC.2.2
    obtain ⟨ha, hm⟩ := O77.PowerLogUniqueness.radius_order_unique hCpair hi
    rw [ha, hm]
    exact hbest i (hall i)
  · let beta := a j - (Fintype.card (DirectIndex D birth death) : ℝ) / 2
    let alpha := radialRatio D birth death
    let q : ℝ := (Fintype.card (DirectIndex D birth death) : ℝ) / 2
    have ht : alpha + q = threshold birth death (realPotential D birth death) :=
      radial_threshold_eq D birth death hD hzero
    rcases lt_trichotomy beta alpha with hlt | heq | hgt
    · have hlt' : a j < threshold birth death (realPotential D birth death) := by
        rw [← ht]
        dsimp [beta, alpha, q] at *
        linarith
      have hc := ((htri (a j) (m j)).1 hlt).mpr ⟨rfl, rfl⟩
      obtain ⟨hl, hm⟩ := O77.PowerLogUniqueness.radius_order_unique hp
        (native_pair_of_entry_half_one D birth death muA hc)
      simp only [hl, hm, min_eq_left hlt'.le, ite_eq_left hlt', and_self]
    · have heq' : a j = threshold birth death (realPotential D birth death) := by
        rw [← ht]
        dsimp [beta, alpha, q] at *
        linarith
      have hc := ((htri (alpha + q) (m j + 1)).2.1 heq).mpr ⟨rfl, rfl⟩
      obtain ⟨hl, hm⟩ := O77.PowerLogUniqueness.radius_order_unique hp
        (native_pair_of_entry_half_one D birth death muA hc)
      rw [hl, hm, ht, heq']
      simp
    · have hgt' : threshold birth death (realPotential D birth death) < a j := by
        rw [← ht]
        dsimp [beta, alpha, q] at *
        linarith
      have hc := ((htri (alpha + q) 1).2.2 hgt).mpr ⟨rfl, rfl⟩
      obtain ⟨hl, hm⟩ := O77.PowerLogUniqueness.radius_order_unique hp
        (native_pair_of_entry_half_one D birth death muA hc)
      simp only [hl, hm, ht, min_eq_right hgt'.le,
        ite_eq_right (not_lt.mpr hgt'.le), ite_eq_right (ne_of_gt hgt'), and_self]

end MAIS.Run2PotentialActualRecurrence

/-- info: 'MAIS.Run2PotentialActualRecurrence.actual_nonterminal_recurrence' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialActualRecurrence.actual_nonterminal_recurrence
end
end
-- ==================== end module O7.Run2PotentialActualRecurrence ====================

-- ==================== begin module O7.Run2PotentialExponentAlternative (formalization/O7/Run2PotentialExponentAlternative.lean) ====================
section

/-! An actual exponent either equals its independent canonical threshold, or
is inherited from an actual strictly higher zero-output orbit. The terminal
case is derived from the actual empty-residual Haar theorem. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialExponentAlternative
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalMeasuredSlice
open MAIS.ActiveIntervalRecursivePair MAIS.ActiveIntervalNumericRecurrence
open MAIS.ActiveIntervalExistenceStep MAIS.Run2PotentialActualRecurrence
open MAIS.Run2PotentialNormalBound MAIS.Run2PotentialRadialThreshold
open MAIS.ActiveIntervalWeightedResidual MAIS.QuiverFinitePairTable
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.AnalyticTransfer
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

include hD in
/-- Actual radial threshold equality or actual strict higher-orbit exponent
inheritance. No candidate numerical recurrence is supplied as a hypothesis. -/
theorem radial_or_inherited
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {n : ℕ}
    (hp : HasMeasuredBandPair muA (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
      (intervalRep D birth death) lam n) :
    lam = threshold birth death (realPotential D birth death) ∨
      ∃ B : Ambient D birth death,
        IsHigherZero (Index D birth death) (intervalRep D birth death) B ∧
        ∃ m : ℕ, HasMeasuredBandPair muA (Metric.ball B)
          (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) B lam m := by
  rcases isEmpty_or_nonempty (ResidualIndex D birth death) with hR | hR
  · let _ : IsEmpty (ResidualIndex D birth death) := hR
    let muT : Measure (NormalParams birth death) := addHaar
    let muR : Measure (Residual D birth death) := addHaar
    let q : ℝ := (Fintype.card (DirectIndex D birth death) : ℝ) / 2
    have hh := MAIS.ActiveIntervalEmptyResidual.ambient_entry_half_pair_iff D birth death hD hvalid
      muA muT muR hzero (fun _ => 1) continuousAt_const zero_lt_one q 1
    have hc : ambientHalfPair D birth death muA (fun _ => 1) q 1 := hh.mpr ⟨rfl, rfl⟩
    have heq := (O77.PowerLogUniqueness.radius_order_unique hp
      (native_pair_of_entry_half_one D birth death muA hc)).1
    have hr : radialRatio D birth death = 0 := by simp [radialRatio]
    have ht := radial_threshold_eq D birth death hD hzero
    rw [hr, zero_add] at ht
    exact Or.inl (heq.trans ht)
  · let _ : Nonempty (ResidualIndex D birth death) := hR
    obtain ⟨B, a, m, hB, hBp, _, hlam, _⟩ :=
      actual_nonterminal_recurrence D birth death hD hvalid muA hzero hp
    by_cases hle : a ≤ threshold birth death (realPotential D birth death)
    · rw [min_eq_left hle] at hlam
      exact Or.inr ⟨B, hB, m, by simpa only [hlam] using hBp⟩
    · exact Or.inl (hlam.trans (min_eq_right (le_of_not_ge hle)))

include hD in
/-- Actual exponents cannot decrease when passing to a strict higher
zero-output real orbit. All higher labels are genuinely attained. -/
theorem exponent_le_strict_higher
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0)
    (B : Ambient D birth death)
    (hB : IsHigherZero (Index D birth death) (intervalRep D birth death) B)
    {lam a : ℝ} {n m : ℕ}
    (hp : HasMeasuredBandPair muA (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
      (intervalRep D birth death) lam n)
    (hBp : HasMeasuredBandPair muA (Metric.ball B)
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) B a m) : lam ≤ a := by
  rcases isEmpty_or_nonempty (ResidualIndex D birth death) with hR | hR
  · let _ : IsEmpty (ResidualIndex D birth death) := hR
    obtain ⟨z, hz, _⟩ := MAIS.Run2AllHigherAttainment.exists_nonzero_corrected_normal_mem_orbit
      D birth death hD hvalid B hB.1 hB.2.1 hB.2.2
    exact False.elim (hz (Subsingleton.elim _ _))
  · let _ : Nonempty (ResidualIndex D birth death) := hR
    obtain ⟨_, b, _, _, _, hbest, hlam, _⟩ :=
      actual_nonterminal_recurrence D birth death hD hvalid muA hzero hp
    have hba : b ≤ a := by
      rcases hbest B hB a m hBp with h | ⟨h, _⟩
      · exact h.le
      · exact h.le
    exact (hlam.le.trans (min_le_left _ _)).trans hba

end MAIS.Run2PotentialExponentAlternative

/-- info: 'MAIS.Run2PotentialExponentAlternative.radial_or_inherited' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialExponentAlternative.radial_or_inherited

/-- info: 'MAIS.Run2PotentialExponentAlternative.exponent_le_strict_higher' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialExponentAlternative.exponent_le_strict_higher
end
end
-- ==================== end module O7.Run2PotentialExponentAlternative ====================

-- ==================== begin module O7.Run2PotentialBalancedNormalForms (formalization/O7/Run2PotentialBalancedNormalForms.lean) ====================
section

/-! Literal independent normal-incidence balance and output count. These
finite definitions do not mention measured exponents or codimensions. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialBalancedNormalForms
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalMeasuredSlice MAIS.ActiveIntervalWeightedResidual
open MAIS.Run2PotentialStationarity (fiberCount outputEdgeCount)
open MAIS.Run2PotentialBalance MAIS.Run2PotentialNormalBound
open MAIS.Run2PotentialRadialThreshold MAIS.MatrixChainIsomorphism MAIS.AnalyticTransfer
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)

/-- Integer incidence balance at every actual independent interior slot. -/
def Balanced : Prop := ∀ v, birth v ≠ 0 → death v ≠ D + 1 →
  fiberCount (targetSlot birth death) v = fiberCount (sourceSlot birth death) v

/-- Literal number of normal scalar coordinates whose target is an output slot. -/
def outputCount : ℕ := outputEdgeCount (targetSlot birth death) (outputSlots D death)

include hD in
theorem balanced_threshold_eq
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0)
    (hbal : Balanced D birth death) :
    threshold birth death (realPotential D birth death) = (outputCount D birth death : ℝ) / 2 := by
  apply MAIS.Run2PotentialStationarity.threshold_eq_half_output_count
    (sourceSlot birth death) (targetSlot birth death)
    (inputSlots birth) (outputSlots D death) (realPotential D birth death)
    (canonical_admissible D birth death hD hzero)
  · intro v hi ho
    apply hbal v
    · simpa only [inputSlots, Finset.mem_filter, Finset.mem_univ, true_and] using hi
    · simpa only [outputSlots, Finset.mem_filter, Finset.mem_univ, true_and] using ho
  · exact source_not_output D birth death hD

include hD in
/-- At actual radial equality, balance follows from the measured cube bound. -/
theorem balanced_of_ambient_radial_equality
    (hvalid : ∀ s, birth s < death s)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0)
    (mu : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure mu]
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
      (intervalRep D birth death) lam m)
    (heq : lam = threshold birth death (realPotential D birth death)) :
    Balanced D birth death := by
  let muN : Measure (NormalParams birth death) := MeasureTheory.Measure.addHaar
  have hN := (pair_iff_normal_slice D birth death hD hvalid mu muN
    0 (Fin.last D) (Nat.zero_le D) hzero lam m).mp hp
  intro v hi ho
  exact balanced_of_normal_threshold_eq D birth death hD (realPotential D birth death)
    (canonical_admissible D birth death hD hzero) hzero muN hN heq v hi ho

include hD in
/-- Any balanced normal form bounds its true ambient measured exponent by
half its independently counted output-target normal coordinates. -/
theorem ambient_exponent_le_balanced_output_count
    (hvalid : ∀ s, birth s < death s)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0)
    (hbal : Balanced D birth death)
    (mu : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure mu]
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
      (intervalRep D birth death) lam m) : lam ≤ (outputCount D birth death : ℝ) / 2 := by
  rw [← balanced_threshold_eq D birth death hD hzero hbal]
  apply ambient_exponent_le_threshold D birth death hD hvalid
    (realPotential D birth death) (realPotential_birth_zero D birth death)
    (realPotential_death_last D birth death
      (MAIS.IntervalPositivePotentials.denominator_pos_of_zero_path D birth death hD hzero))
    (fun p => real_edgeWeight_pos D birth death hD p) hzero mu hp

end MAIS.Run2PotentialBalancedNormalForms

/-- info: 'MAIS.Run2PotentialBalancedNormalForms.balanced_threshold_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalancedNormalForms.balanced_threshold_eq

/-- info: 'MAIS.Run2PotentialBalancedNormalForms.balanced_of_ambient_radial_equality' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalancedNormalForms.balanced_of_ambient_radial_equality

/-- info: 'MAIS.Run2PotentialBalancedNormalForms.ambient_exponent_le_balanced_output_count' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalancedNormalForms.ambient_exponent_le_balanced_output_count
end
end
-- ==================== end module O7.Run2PotentialBalancedNormalForms ====================

-- ==================== begin module O7.Run2PotentialBalancedWitness (formalization/O7/Run2PotentialBalancedWitness.lean) ====================
section

/-! An actual higher zero-output orbit with balanced independent normal
incidences attains the actual exponent. Genuine well-founded orbit induction
follows actual exponent inheritance until measured radial equality forces
balance. The independent output count never defines the measured exponent. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3200000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialBalancedWitness
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open MAIS.MatrixCoordinateTransport MAIS.BarcodeActiveNormalForm
open MAIS.QuiverIntervalMeasuredNormalForm MAIS.ActiveIntervalDifferential
open MAIS.ActiveIntervalMeasuredSlice MAIS.AnalyticTransfer
open MAIS.Run2PotentialBalancedNormalForms MAIS.Run2PotentialExponentAlternative
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- Every actual zero-output measured exponent is attained at an actual
higher zero-output orbit with a genuinely balanced active normal form, and
equals half that form's independently counted output-target coordinates. -/
theorem exists_balanced_higher_witness
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    ∃ C : Rep ι, ∃ N : ActiveNormalForm C,
      pathMatrix C 0 (Fin.last D) (Nat.zero_le D) = 0 ∧
      A ∈ closure (MulAction.orbit (Gauge ι) C) ∧
      Balanced D N.birth N.death ∧
      lam = (outputCount D N.birth N.death : ℝ) / 2 ∧
      ∃ n : ℕ, HasMeasuredBandPair mu (Metric.ball C)
        (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) C lam n := by
  have hall : ∀ A : Rep ι,
      pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0 →
      ∀ lam : ℝ, ∀ m : ℕ,
      HasMeasuredBandPair mu (Metric.ball A)
        (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m →
      ∃ C : Rep ι, ∃ N : ActiveNormalForm C,
        pathMatrix C 0 (Fin.last D) (Nat.zero_le D) = 0 ∧
        A ∈ closure (MulAction.orbit (Gauge ι) C) ∧
        Balanced D N.birth N.death ∧
        lam = (outputCount D N.birth N.death : ℝ) / 2 ∧
        ∃ n : ℕ, HasMeasuredBandPair mu (Metric.ball C)
          (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) C lam n := by
    intro A
    refine (MAIS.QuiverOrbitFiniteHeight.wellFounded_strict_generization ι).induction
      (C := fun B : Rep ι => pathMatrix B 0 (Fin.last D) (Nat.zero_le D) = 0 →
        ∀ lam : ℝ, ∀ m : ℕ,
        HasMeasuredBandPair mu (Metric.ball B)
          (fun T => ‖pathMatrix T 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) B lam m →
        ∃ C : Rep ι, ∃ N : ActiveNormalForm C,
          pathMatrix C 0 (Fin.last D) (Nat.zero_le D) = 0 ∧
          B ∈ closure (MulAction.orbit (Gauge ι) C) ∧
          Balanced D N.birth N.death ∧
          lam = (outputCount D N.birth N.death : ℝ) / 2 ∧
          ∃ n : ℕ, HasMeasuredBandPair mu (Metric.ball C)
            (fun T => ‖pathMatrix T 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) C lam n) A ?_
    intro A ih hAzero lam m hAp
    obtain ⟨N⟩ := exists_normal_form A
    let muK : Measure (Rep (Index D N.birth N.death)) := addHaar
    have hKzero := intervalRep_zero_of_original_zero N 0 (Fin.last D) (Nat.zero_le D) hAzero
    have hKp := (pair_iff_normal_form N mu muK 0 (Fin.last D) (Nat.zero_le D)
      hAzero lam m).mp hAp
    rcases radial_or_inherited D N.birth N.death N.bounded N.valid muK hKzero hKp with
      hradial | ⟨B, hB, n, hBp⟩
    · have hbal := balanced_of_ambient_radial_equality D N.birth N.death N.bounded
        N.valid hKzero muK hKp hradial
      have hcount := balanced_threshold_eq D N.birth N.death N.bounded hKzero hbal
      exact ⟨A, N, hAzero, subset_closure (MulAction.mem_orbit_self A), hbal,
        hradial.trans hcount, m, hAp⟩
    · let T : Rep ι := transport N.coordinates B
      have hTzero : pathMatrix T 0 (Fin.last D) (Nat.zero_le D) = 0 := by
        rw [path_transport, hB.1]
        rfl
      have hcl : A ∈ closure (MulAction.orbit (Gauge ι) T) := by
        apply MAIS.RealTypeAClosure.mem_closure_orbit_of_path_rank_le
        intro i j hij
        rw [← N.rank_eq i j hij, path_rank_transport]
        exact path_rank_le_of_mem_closure_orbit hB.2.1 i j hij
      have hnot : T ∉ MulAction.orbit (Gauge ι) A := by
        intro horb
        obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp horb
        apply hB.2.2
        apply mem_gauge_orbit_of_path_rank_eq (intervalRep D N.birth N.death) B
        intro i j hij
        have hgr : (pathMatrix T i j hij).rank = (pathMatrix A i j hij).rank := by
          rw [← hg]
          exact path_rank_gauge g A i j hij
        rw [path_rank_transport] at hgr
        exact (N.rank_eq i j hij).trans hgr.symm
      have hTp := (MAIS.QuiverCoordinateMeasuredPair.pair_iff_coordinate_transport
        N.coordinates muK mu B 0 (Fin.last D) (Nat.zero_le D) lam n).mp hBp
      obtain ⟨C, NC, hCzero, hTC, hbal, hcount, nh, hCp⟩ :=
        ih T ⟨hcl, hnot⟩ hTzero lam n hTp
      exact ⟨C, NC, hCzero, closure_orbit_trans hcl hTC, hbal, hcount, nh, hCp⟩
  exact hall A hzero lam m hp

end MAIS.Run2PotentialBalancedWitness

/-- info: 'MAIS.Run2PotentialBalancedWitness.exists_balanced_higher_witness' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalancedWitness.exists_balanced_higher_witness
end
end
-- ==================== end module O7.Run2PotentialBalancedWitness ====================

-- ==================== begin module O7.Run2PotentialSpecialization (formalization/O7/Run2PotentialSpecialization.lean) ====================
section

/-! Actual zero-output measured exponents are monotone under ordinary real
orbit specialization. The two carriers and all normalization data are actual;
no semialgebraic-stratification or supplied exponent-order premise is used. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialSpecialization
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open MAIS.MatrixCoordinateTransport MAIS.BarcodeActiveNormalForm
open MAIS.QuiverIntervalMeasuredNormalForm MAIS.ActiveIntervalDifferential
open MAIS.ActiveIntervalMeasuredSlice MAIS.AnalyticTransfer
open MAIS.Run2PotentialExponentAlternative MAIS.QuiverGaugeMeasuredPair
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- At genuine zero-output points, actual measured exponents weakly increase
towards every higher ordinary-real orbit, with equality allowed. -/
theorem exponent_le_of_mem_closure_orbit
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A B : Rep ι)
    (hAzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (hBzero : pathMatrix B 0 (Fin.last D) (Nat.zero_le D) = 0)
    (hcl : A ∈ closure (MulAction.orbit (Gauge ι) B))
    {lam a : ℝ} {n m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun C => ‖pathMatrix C 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam n)
    (hBp : HasMeasuredBandPair mu (Metric.ball B)
      (fun C => ‖pathMatrix C 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) B a m) : lam ≤ a := by
  classical
  obtain ⟨N⟩ := exists_normal_form A
  let muK : Measure (Rep (Index D N.birth N.death)) := addHaar
  let T : Rep (Index D N.birth N.death) := transport (fun v => (N.coordinates v).symm) B
  have hKzero := intervalRep_zero_of_original_zero N 0 (Fin.last D) (Nat.zero_le D) hAzero
  have hKp := (pair_iff_normal_form N mu muK 0 (Fin.last D) (Nat.zero_le D)
    hAzero lam n).mp hp
  have hTzero : pathMatrix T 0 (Fin.last D) (Nat.zero_le D) = 0 := by
    rw [path_transport, hBzero]
    rfl
  have hTp := (MAIS.QuiverCoordinateMeasuredPair.pair_iff_coordinate_transport
    (fun v => (N.coordinates v).symm) mu muK B 0 (Fin.last D) (Nat.zero_le D) a m).mp hBp
  have hKT : intervalRep D N.birth N.death ∈
      closure (MulAction.orbit (Gauge (Index D N.birth N.death)) T) := by
    apply MAIS.RealTypeAClosure.mem_closure_orbit_of_path_rank_le
    intro i j hij
    rw [path_rank_transport, N.rank_eq i j hij]
    exact path_rank_le_of_mem_closure_orbit hcl i j hij
  by_cases horb : T ∈ MulAction.orbit (Gauge (Index D N.birth N.death))
      (intervalRep D N.birth N.death)
  · obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp horb
    have hgp := (pair_iff_gauge_zero (Index D N.birth N.death) muK muK g
      (intervalRep D N.birth N.death) 0 (Fin.last D) (Nat.zero_le D) hKzero lam n).mp hKp
    rw [hg] at hgp
    exact (O77.PowerLogUniqueness.radius_order_unique hgp hTp).1.le
  · exact exponent_le_strict_higher D N.birth N.death N.bounded N.valid muK hKzero
      T ⟨hTzero, hKT, horb⟩ hKp hTp

end MAIS.Run2PotentialSpecialization

/-- info: 'MAIS.Run2PotentialSpecialization.exponent_le_of_mem_closure_orbit' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialSpecialization.exponent_le_of_mem_closure_orbit
end
end
-- ==================== end module O7.Run2PotentialSpecialization ====================

-- ==================== begin module O7.QuiverZeroFinitePairTable (formalization/O7/QuiverZeroFinitePairTable.lean) ====================
section

/-! Actual finite attained global measured-pair table and finite-image
unique pair function on the literal zero-output fiber of a real chain. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.QuiverZeroFinitePairTable
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.QuiverOrbitFiniteHeight MAIS.QuiverGaugeMeasuredPair
open MAIS.QuiverZeroPairExistence MAIS.AnalyticTransfer
variable {D:ℕ} (ι:Fin (D+1)→Type*)
  [∀ v,Fintype (ι v)] [∀ v,DecidableEq (ι v)]

def ZeroOrbitIndex :=
  {q:MulAction.orbitRel.Quotient (Gauge ι) (Rep ι) //
    ∃ A:Rep ι,pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0 ∧ Quotient.mk'' A=q}

instance zeroOrbitIndexFintype : Fintype (ZeroOrbitIndex ι) := by
  unfold ZeroOrbitIndex
  exact Fintype.ofFinite _

def representative (j:ZeroOrbitIndex ι) : Rep ι := Classical.choose j.property

theorem representative_spec (j:ZeroOrbitIndex ι) :
    pathMatrix (representative ι j) 0 (Fin.last D) (Nat.zero_le D)=0 ∧
      Quotient.mk'' (representative ι j)=j.val := Classical.choose_spec j.property

/-- The literal set of actual measured values attained anywhere on the
actual zero-output fiber. Its definition contains genuine band pairs. -/
def pairValues (mu:Measure (Rep ι)) : Set (ℝ×ℕ) :=
  {p|∃ A:Rep ι,pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0 ∧
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A p.1 p.2}

/-- Actual global existence and actual finite orbit classes give a finite
table all of whose entries are attained at actual matrices. Every actual
zero-output point has exactly the pair of one table label. -/
theorem exists_finite_global_zero_table
    (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] :
    ∃ a:ZeroOrbitIndex ι→ℝ,∃ m:ZeroOrbitIndex ι→ℕ,
      (∀ j:ZeroOrbitIndex ι,HasMeasuredBandPair mu
        (Metric.ball (representative ι j))
        (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2)
        (representative ι j) (a j) (m j)) ∧
      (∀ A:Rep ι,pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0→
        ∃ j:ZeroOrbitIndex ι,∀ lam:ℝ,∀ n:ℕ,
          HasMeasuredBandPair mu (Metric.ball A)
            (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A lam n ↔
              lam=a j ∧ n=m j) ∧
      pairValues ι mu=Set.range (fun j:ZeroOrbitIndex ι=>(a j,m j)) := by
  classical
  have hp:∀ j:ZeroOrbitIndex ι,∃ lam:ℝ,∃ m:ℕ,
      HasMeasuredBandPair mu (Metric.ball (representative ι j))
        (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2)
        (representative ι j) lam m := fun j=>
    exists_pair_zero_output ι mu _ (representative_spec ι j).1
  choose a m hm using hp
  have hc:∀ A:Rep ι,pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0→
      ∃ j:ZeroOrbitIndex ι,HasMeasuredBandPair mu (Metric.ball A)
        (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A (a j) (m j) := by
    intro A hA
    let j:ZeroOrbitIndex ι:=⟨Quotient.mk'' A,A,hA,rfl⟩
    have hq:Quotient.mk'' A=Quotient.mk'' (representative ι j):=
      (representative_spec ι j).2.symm
    have horb:A∈MulAction.orbit (Gauge ι) (representative ι j):=Quotient.exact hq
    obtain ⟨g,hg⟩:=MulAction.mem_orbit_iff.mp horb
    refine ⟨j,?_⟩
    rw [← hg]
    exact (pair_iff_gauge_zero ι mu mu g (representative ι j)
      0 (Fin.last D) (Nat.zero_le D) (representative_spec ι j).1
      (a j) (m j)).mp (hm j)
  refine ⟨a,m,hm,?_,?_⟩
  · intro A hA
    obtain ⟨j,hj⟩:=hc A hA
    refine ⟨j,?_⟩
    intro lam n
    constructor
    · intro h
      exact O77.PowerLogUniqueness.radius_order_unique h hj
    · rintro ⟨rfl,rfl⟩
      exact hj
  · ext p
    constructor
    · rintro ⟨A,hA,hp⟩
      obtain ⟨j,hj⟩:=hc A hA
      obtain ⟨h1,h2⟩:=O77.PowerLogUniqueness.radius_order_unique hp hj
      exact ⟨j,Prod.ext h1.symm h2.symm⟩
    · rintro ⟨j,rfl⟩
      exact ⟨representative ι j,(representative_spec ι j).1,hm j⟩

/-- The set of all actual measured values on the entire actual zero
fiber is finite; an arbitrary real-valued coefficient function is not assumed. -/
theorem finite_pairValues (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] :
    (pairValues ι mu).Finite := by
  obtain ⟨a,m,_,_,h⟩:=exists_finite_global_zero_table ι mu
  rw [h]
  exact Set.finite_range _

abbrev ZeroFiber := {A:Rep ι // pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0}

/-- The actual unique measured pair, selected from the proved actual
existence theorem at each actual zero-output point. -/
def pairValue (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A:ZeroFiber ι) : ℝ×ℕ :=
  Classical.choose (exists_unique_pair_zero_output ι mu A.val A.property)

theorem pairValue_spec (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A:ZeroFiber ι) :
    HasMeasuredBandPair mu (Metric.ball A.val)
      (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A.val
      (pairValue ι mu A).1 (pairValue ι mu A).2 :=
  (Classical.choose_spec (exists_unique_pair_zero_output ι mu A.val A.property)).1

theorem finite_range_pairValue (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] :
    (Set.range (pairValue ι mu)).Finite := by
  apply (finite_pairValues ι mu).subset
  rintro p ⟨A,rfl⟩
  exact ⟨A.val,A.property,pairValue_spec ι mu A⟩

/-- The actual unique measured function is constant on genuine actual
gauge orbits within the actual zero-output fiber. -/
theorem pairValue_eq_of_mem_orbit
    (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A B:ZeroFiber ι) (h:A.val∈MulAction.orbit (Gauge ι) B.val) :
    pairValue ι mu A=pairValue ι mu B := by
  obtain ⟨g,hg⟩:=MulAction.mem_orbit_iff.mp h
  have hB:=pairValue_spec ι mu B
  have hA:HasMeasuredBandPair mu (Metric.ball A.val)
      (fun C=>‖pathMatrix C 0 (Fin.last D) (Nat.zero_le D)‖^2) A.val
      (pairValue ι mu B).1 (pairValue ι mu B).2 := by
    rw [← hg]
    exact (pair_iff_gauge_zero ι mu mu g B.val 0 (Fin.last D) (Nat.zero_le D)
      B.property _ _).mp hB
  obtain ⟨h1,h2⟩:=O77.PowerLogUniqueness.radius_order_unique (pairValue_spec ι mu A) hA
  exact Prod.ext h1 h2

/-- The same actual finite-image value is the unique literal half-loss
pair in all original entry balls, for every prior positive and continuous
at the actual center. No global prior regularity is needed for this iff. -/
theorem entry_half_prior_iff_pairValue
    (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A:ZeroFiber ι)
    (prior:Rep ι→ℝ) (hprior:ContinuousAt prior A.val) (hpos:0<prior A.val)
    (lam:ℝ) (m:ℕ) :
    HasMeasuredBandPair (mu.withDensity (fun B=>ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A.val)
      (fun B=>(1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A.val lam m ↔
      lam=(pairValue ι mu A).1 ∧ m=(pairValue ι mu A).2 := by
  have hs:=MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_positive_scale mu
    (Metric.ball A.val) (fun _ _ h=>Metric.ball_subset_ball h)
    (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A.val (1/2:ℝ) (by norm_num)
    (pairValue ι mu A).1 (pairValue ι mu A).2
  have hf:Measurable (fun B:Rep ι=>(1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2):=
    measurable_const.mul ((continuous_pathMatrix 0 (Fin.last D) (Nat.zero_le D)).norm.pow 2).measurable
  have hp:=
    (MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior mu hf hprior hpos).mp
      (hs.mp (pairValue_spec ι mu A))
  have he:HasMeasuredBandPair (mu.withDensity (fun B=>ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A.val)
      (fun B=>(1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A.val
      (pairValue ι mu A).1 (pairValue ι mu A).2 :=
    (MAIS.MatrixChainEntryWindows.pair_iff_entryBall ι
      (mu.withDensity (fun B=>ENNReal.ofReal (prior B))) A.val).mp hp
  constructor
  · intro h
    exact O77.PowerLogUniqueness.radius_order_unique h he
  · rintro ⟨rfl,rfl⟩
    exact he

/-- A fixed prior continuous and positive at every zero-output point has
only finitely many genuine full-entry half-loss measured values there. -/
theorem finite_entry_half_prior_values
    (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (prior:Rep ι→ℝ)
    (hprior:∀ A:ZeroFiber ι,ContinuousAt prior A.val)
    (hpos:∀ A:ZeroFiber ι,0<prior A.val) :
    {p:ℝ×ℕ|∃ A:ZeroFiber ι,
      HasMeasuredBandPair (mu.withDensity (fun B=>ENNReal.ofReal (prior B)))
        (MAIS.MatrixChainEntryWindows.entryBall ι A.val)
        (fun B=>(1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A.val p.1 p.2}.Finite := by
  apply (finite_range_pairValue ι mu).subset
  rintro p ⟨A,hA⟩
  obtain ⟨h1,h2⟩:=(entry_half_prior_iff_pairValue ι mu A prior (hprior A) (hpos A) p.1 p.2).mp hA
  exact ⟨A,Prod.ext h1.symm h2.symm⟩

end MAIS.QuiverZeroFinitePairTable
end

