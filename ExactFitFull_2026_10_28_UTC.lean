-- ==================== begin module O7.Run2ArithmeticPositiveGeometry (formalization/O7/Run2ArithmeticPositiveGeometry.lean) ====================
section

/-! The executable original-rank algorithm computes the literal geometric
local Hausdorff codimension of every actual complete-product fiber.
Both quantities were independently defined and independently proved correct;
the present adapter identifies them, including depth zero. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2ArithmeticPositiveGeometry
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.Run2BarcodeEnumeration MAIS.Run2ArithmeticPositiveData
open MAIS.Run2ArithmeticPositive MAIS.Run2GeometricPositiveLearning
open MAIS.Run2GeometricCharts MAIS.Run2GeometricCodimCharts
open MAIS.Run2GeometricIntegralCodim MAIS.Run2GeometricFiberAllDepth
open MAIS.Run2PositiveFiberTransport
variable {D : ℕ} (ι : Fin (D+1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

/-- Every returned integer coefficient is the genuine local geometric
codimension of the actual original product fiber. No normal form, pair
witness or codimension equality is supplied as a hypothesis. -/
theorem exactFitPair_coefficient_eq_geometricCodimNat
    (A : Rep ι) {c m : ℕ}
    (hc : (c,m) ∈ exactFitPairs (architecture ι) (pathRankInput ι A)) :
    c = geometricCodimNat (fixedProductFiber ι A) A := by
  let mu : Measure (Rep ι) := addHaar
  have hp := (pointed_pair_iff ι mu A ((c:ℝ)/2) m).mpr ⟨c,hc,rfl⟩
  have hh := exponent_eq_half_geometricCodimNat ι mu A hp
  have he : (c:ℝ)=(geometricCodimNat (fixedProductFiber ι A) A:ℝ) := by linarith
  exact_mod_cast he

/-- The coefficient is the literal ambient dimension minus the infimum of
actual Hausdorff dimensions in EVERY positive-radius original ambient ball. -/
theorem exactFitPair_literal_hausdorff_codimension
    (A : Rep ι) {c m : ℕ}
    (hc : (c,m) ∈ exactFitPairs (architecture ι) (pathRankInput ι A)) :
    (Module.finrank ℝ (Rep ι):ℝ≥0∞)-
      (⨅ (r:ℝ) (_:0<r), dimH
        ({B : Rep ι | pathMatrix B 0 (Fin.last D) (Nat.zero_le D)=
          pathMatrix A 0 (Fin.last D) (Nat.zero_le D)} ∩ Metric.ball A r)) =
      (c:ℝ≥0∞) := by
  change geometricCodimH (fixedProductFiber ι A) A=(c:ℝ≥0∞)
  rw [actualCodimH_eq_nat,
    exactFitPair_coefficient_eq_geometricCodimNat ι A hc]

/-- The same coefficient computes actual integral local Hausdorff dimension,
including every zero-width and depth-zero boundary case. -/
theorem exactFitPair_literal_local_dimension
    (A : Rep ι) {c m : ℕ}
    (hc : (c,m) ∈ exactFitPairs (architecture ι) (pathRankInput ι A)) :
    (⨅ (r:ℝ) (_:0<r), dimH
      ({B : Rep ι | pathMatrix B 0 (Fin.last D) (Nat.zero_le D)=
        pathMatrix A 0 (Fin.last D) (Nat.zero_le D)} ∩ Metric.ball A r)) =
      ((Module.finrank ℝ (Rep ι)-c:ℕ):ℝ≥0∞) := by
  obtain ⟨n,hn⟩ := integralLocalDimension ι A
  have hd : n≤Module.finrank ℝ (Rep ι) := by
    have h:=MAIS.Run2GeometricIntegralCodim.localDimH_le_ambient (fixedProductFiber ι A) A
    rw [hn] at h
    exact_mod_cast h
  have hc' := exactFitPair_coefficient_eq_geometricCodimNat ι A hc
  have he : c=Module.finrank ℝ (Rep ι)-n := by
    simpa only [geometricCodimNat,hn,ENNReal.toReal_natCast,Nat.floor_natCast] using hc'
  change localDimH (fixedProductFiber ι A) A=_
  rw [hn,he,Nat.sub_sub_self hd]

/-- The entire executable output has exactly the genuine geometric
codimension as its sole first coordinate, without an existence premise. -/
theorem exactFitPairs_first_coordinates (A : Rep ι) :
    (exactFitPairs (architecture ι) (pathRankInput ι A)).image Prod.fst =
      {geometricCodimNat (fixedProductFiber ι A) A} := by
  let mu : Measure (Rep ι) := addHaar
  obtain ⟨c,m,hset,_⟩ := exactFitPairs_nonempty_singleton ι mu A
  have hc : (c,m)∈exactFitPairs (architecture ι) (pathRankInput ι A) := by
    rw [hset]
    simp
  rw [hset,Finset.image_singleton,exactFitPair_coefficient_eq_geometricCodimNat ι A hc]

/-- Fixed target form of the literal geometric identity at every exact fit. -/
theorem exactFitPair_target_literal_local_dimension
    (A : Rep ι) (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=target)
    {c m : ℕ} (hc : (c,m) ∈ exactFitPairs (architecture ι) (pathRankInput ι A)) :
    (⨅ (r:ℝ) (_:0<r), dimH
      ({B : Rep ι | pathMatrix B 0 (Fin.last D) (Nat.zero_le D)=target} ∩ Metric.ball A r)) =
      ((Module.finrank ℝ (Rep ι)-c:ℕ):ℝ≥0∞) := by
  simpa only [hfit] using exactFitPair_literal_local_dimension ι A hc

end MAIS.Run2ArithmeticPositiveGeometry

/-- info: 'MAIS.Run2ArithmeticPositiveGeometry.exactFitPair_coefficient_eq_geometricCodimNat' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositiveGeometry.exactFitPair_coefficient_eq_geometricCodimNat

/-- info: 'MAIS.Run2ArithmeticPositiveGeometry.exactFitPair_literal_hausdorff_codimension' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositiveGeometry.exactFitPair_literal_hausdorff_codimension

