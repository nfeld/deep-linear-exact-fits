-- ==================== begin module O7.MatrixSmoothMul (formalization/O7/MatrixSmoothMul.lean) ====================
section

/-! Bounded bilinear multiplication and strict derivatives for actual rectangular
real matrices with the Frobenius norm. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace MAIS.MatrixSmoothMul

open scoped Matrix Matrix.Norms.Frobenius

variable {l m n : Type*} [Fintype l] [Fintype m] [Fintype n]

/-- The literal rectangular matrix product as a bounded bilinear map. -/
noncomputable def mulCLM :
    Matrix l m ℝ →L[ℝ] Matrix m n ℝ →L[ℝ] Matrix l n ℝ :=
  (mulLinearMap ℝ).mkContinuous₂ 1 (by
    intro A B
    simpa using Matrix.frobenius_norm_mul A B)

@[simp]
theorem mulCLM_apply (A : Matrix l m ℝ) (B : Matrix m n ℝ) :
    mulCLM A B = A * B := rfl

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The product rule for the actual rectangular matrix product. -/
theorem hasStrictFDerivAt_matrix_mul
    {f : E → Matrix l m ℝ} {g : E → Matrix m n ℝ}
    {f' : E →L[ℝ] Matrix l m ℝ} {g' : E →L[ℝ] Matrix m n ℝ}
    {x : E} (hf : HasStrictFDerivAt f f' x) (hg : HasStrictFDerivAt g g' x) :
    HasStrictFDerivAt (fun y => f y * g y)
      (((mulCLM (l := l) (m := m) (n := n)) (f x)).comp g' +
        (((mulCLM (l := l) (m := m) (n := n)).flip (g x)).comp f')) x := by
  let B := mulCLM (l := l) (m := m) (n := n)
  convert ((B.hasStrictFDerivAt.comp x hf).clm_apply hg) using 1 <;> rfl

/-- Rectangular multiplication preserves every differentiability order,
    including real analyticity (`ω`). -/
theorem contDiffAt_matrix_mul {k : WithTop ℕ∞}
    {f : E → Matrix l m ℝ} {g : E → Matrix m n ℝ} {x : E}
    (hf : ContDiffAt ℝ k f x) (hg : ContDiffAt ℝ k g x) :
    ContDiffAt ℝ k (fun y => f y * g y) x := by
  let B := mulCLM (l := l) (m := m) (n := n)
  convert ((B.contDiff.contDiffAt.comp x hf).clm_apply hg) using 1
  rfl

/-- The algebra exponential has derivative the identity at zero, after
    composition with an arbitrary actual linear matrix-coordinate map. -/
theorem hasStrictFDerivAt_exp_comp_zero {p : Type*} [Fintype p] [DecidableEq p]
    (dx : E →L[ℝ] Matrix p p ℝ) :
    HasStrictFDerivAt (fun x => NormedSpace.exp (dx x)) dx 0 := by
  have hx : HasStrictFDerivAt NormedSpace.exp
      (1 : Matrix p p ℝ →L[ℝ] Matrix p p ℝ) (dx 0) := by
    convert (hasStrictFDerivAt_exp_zero (𝕂 := ℝ) (𝔸 := Matrix p p ℝ)) using 1 <;> try rfl
    exact map_zero dx
  convert hx.comp 0 dx.hasStrictFDerivAt using 1 <;> rfl

end MAIS.MatrixSmoothMul
end
-- ==================== end module O7.MatrixSmoothMul ====================

-- ==================== begin module O7.OrbitSliceChart (formalization/O7/OrbitSliceChart.lean) ====================
section

/-!
An actual full-ambient normal-slice chart for finite chains of real rectangular
matrices.  The forward map uses literal matrix exponentials and literal matrix
multiplication.  All complements live in the actual entry spaces.
-/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace MAIS.OrbitSliceChart

open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.MatrixSmoothMul
open scoped Matrix Matrix.Norms.Frobenius

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
variable [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- Exponentials are genuine matrix units, with the literal negative
    exponential as inverse, also at zero-dimensional vertices. -/
noncomputable def expGauge (X : Lie ι) : Gauge ι := fun v =>
  { val := NormedSpace.exp (X v)
    inv := NormedSpace.exp (-(X v))
    val_inv := by
      rw [← NormedSpace.exp_add_of_commute (Commute.refl (X v)).neg_right]
      simp
    inv_val := by
      rw [← NormedSpace.exp_add_of_commute (Commute.refl (X v)).neg_left]
      simp }

/-- The genuine change-of-basis/slice map in the full arrow-entry space. -/
noncomputable def sliceMap (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι)) (p : H × N) : Rep ι :=
  fun e => NormedSpace.exp ((p.1 : Lie ι) e.succ) * (A e + (p.2 : Rep ι) e) *
    NormedSpace.exp (-((p.1 : Lie ι) e.castSucc))

/-- The formula is exactly the actual matrix-unit gauge action on A + Y. -/
theorem sliceMap_eq_expGauge_smul (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι)) (p : H × N) :
    sliceMap ι A H N p = expGauge ι (p.1 : Lie ι) • (A + (p.2 : Rep ι)) := rfl

@[simp]
theorem sliceMap_zero (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι)) :
    sliceMap ι A H N 0 = A := by
  funext e
  simp [sliceMap]

/-- Direct differentiation of the actual exponential formula gives the
    invertible orbit-plus-normal derivative, with no assumed slice theorem. -/
theorem hasStrictFDerivAt_sliceMap (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (hH : IsCompl H (orbitDifferential ι A).ker)
    (hN : IsCompl (orbitDifferential ι A).range N) :
    HasStrictFDerivAt (sliceMap ι A H N)
      (sliceDerivativeEquiv ι A H N hH hN : (H × N) →L[ℝ] Rep ι) 0 := by
  let dx (v : Fin (D + 1)) : (H × N) →L[ℝ] Matrix (ι v) (ι v) ℝ :=
    (ContinuousLinearMap.proj v).comp
      (H.subtypeL.comp (ContinuousLinearMap.fst ℝ H N))
  let dy (e : Fin D) : (H × N) →L[ℝ] Matrix (ι e.succ) (ι e.castSucc) ℝ :=
    (ContinuousLinearMap.proj e).comp
      (N.subtypeL.comp (ContinuousLinearMap.snd ℝ H N))
  have he (e : Fin D) : HasStrictFDerivAt (fun p => sliceMap ι A H N p e)
      ((ContinuousLinearMap.proj e).comp
        (sliceDerivativeEquiv ι A H N hH hN : (H × N) →L[ℝ] Rep ι)) 0 := by
    have hl : HasStrictFDerivAt (fun p => NormedSpace.exp (dx e.succ p))
        (dx e.succ) 0 := by
      have hx : HasStrictFDerivAt NormedSpace.exp
          (1 : Matrix (ι e.succ) (ι e.succ) ℝ →L[ℝ] Matrix (ι e.succ) (ι e.succ) ℝ)
          (dx e.succ 0) := by
        convert (hasStrictFDerivAt_exp_zero (𝕂 := ℝ)
          (𝔸 := Matrix (ι e.succ) (ι e.succ) ℝ)) using 1 <;> try rfl
      convert hx.comp 0 (dx e.succ).hasStrictFDerivAt using 1 <;> rfl
    have hm : HasStrictFDerivAt (fun p => A e + dy e p) (dy e) 0 :=
      (dy e).hasStrictFDerivAt.const_add (A e)
    have hr : HasStrictFDerivAt (fun p => NormedSpace.exp (-(dx e.castSucc p)))
        (-(dx e.castSucc)) 0 := by
      have hx : HasStrictFDerivAt NormedSpace.exp
          (1 : Matrix (ι e.castSucc) (ι e.castSucc) ℝ →L[ℝ]
            Matrix (ι e.castSucc) (ι e.castSucc) ℝ) (-(dx e.castSucc 0)) := by
        convert (hasStrictFDerivAt_exp_zero (𝕂 := ℝ)
          (𝔸 := Matrix (ι e.castSucc) (ι e.castSucc) ℝ)) using 1 <;> try rfl
        simp only [map_zero, neg_zero]
      convert hx.comp 0 (dx e.castSucc).hasStrictFDerivAt.neg using 1 <;> rfl
    convert (hasStrictFDerivAt_matrix_mul
      (hasStrictFDerivAt_matrix_mul hl hm) hr) using 1 <;> try rfl
    apply ContinuousLinearMap.ext
    intro p
    simp [dx, dy, orbitDifferential, sub_eq_add_neg]
    abel
  convert (hasStrictFDerivAt_pi.mpr he) using 1 <;> rfl

/-- The inverse-function theorem supplies a chart onto an open subset of the
    complete, literal ambient matrix-entry space. -/
noncomputable def sliceChart (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (hH : IsCompl H (orbitDifferential ι A).ker)
    (hN : IsCompl (orbitDifferential ι A).range N) :
    OpenPartialHomeomorph (H × N) (Rep ι) :=
  (hasStrictFDerivAt_sliceMap ι A H N hH hN).toOpenPartialHomeomorph (sliceMap ι A H N)

@[simp]
theorem sliceChart_coe (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (hH : IsCompl H (orbitDifferential ι A).ker)
    (hN : IsCompl (orbitDifferential ι A).range N) :
    (sliceChart ι A H N hH hN : H × N → Rep ι) = sliceMap ι A H N := rfl

theorem zero_mem_sliceChart_source (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (hH : IsCompl H (orbitDifferential ι A).ker)
    (hN : IsCompl (orbitDifferential ι A).range N) :
    0 ∈ (sliceChart ι A H N hH hN).source :=
  (hasStrictFDerivAt_sliceMap ι A H N hH hN).mem_toOpenPartialHomeomorph_source

theorem base_mem_sliceChart_target (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (hH : IsCompl H (orbitDifferential ι A).ker)
    (hN : IsCompl (orbitDifferential ι A).range N) :
    A ∈ (sliceChart ι A H N hH hN).target := by
  convert (hasStrictFDerivAt_sliceMap ι A H N hH hN).image_mem_toOpenPartialHomeomorph_target using 1 <;> try rfl
  exact (sliceMap_zero ι A H N).symm

/-- The actual local inverse has the inverse orbit-plus-normal differential. -/
theorem hasStrictFDerivAt_sliceChart_symm (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (hH : IsCompl H (orbitDifferential ι A).ker)
    (hN : IsCompl (orbitDifferential ι A).range N) :
    HasStrictFDerivAt (sliceChart ι A H N hH hN).symm
      ((sliceDerivativeEquiv ι A H N hH hN).symm : Rep ι →L[ℝ] H × N) A := by
  convert (hasStrictFDerivAt_sliceMap ι A H N hH hN).to_localInverse using 1 <;> try rfl
  exact (sliceMap_zero ι A H N).symm

end MAIS.OrbitSliceChart
end
-- ==================== end module O7.OrbitSliceChart ====================

-- ==================== begin module O7.OrbitTangent (formalization/O7/OrbitTangent.lean) ====================
section

/-! The actual orbit map really has the asserted differential on every gauge-Lie
algebra direction; the range/kernel are literal image/kernel spaces. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace MAIS.OrbitTangent

open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.MatrixSmoothMul MAIS.OrbitSliceChart
open scoped Matrix Matrix.Norms.Frobenius

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
variable [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- The actual orbit parametrization by genuine exponential matrix units. -/
noncomputable def orbitMap (A : Rep ι) (X : Lie ι) : Rep ι := expGauge ι X • A

@[simp]
theorem orbitMap_zero (A : Rep ι) : orbitMap ι A 0 = A := by
  funext e
  simp [orbitMap, gauge_smul_apply, expGauge]

/-- The derivative on the full actual gauge Lie algebra, not only on a chosen
    complementary space, is exactly X_{e+1} A_e - A_e X_e. -/
theorem hasStrictFDerivAt_orbitMap (A : Rep ι) :
    HasStrictFDerivAt (orbitMap ι A) ((orbitDifferential ι A).toContinuousLinearMap) 0 := by
  let dx (v : Fin (D + 1)) : Lie ι →L[ℝ] Matrix (ι v) (ι v) ℝ :=
    ContinuousLinearMap.proj v
  have he (e : Fin D) : HasStrictFDerivAt (fun X => orbitMap ι A X e)
      ((ContinuousLinearMap.proj e).comp (orbitDifferential ι A).toContinuousLinearMap) 0 := by
    have hl := hasStrictFDerivAt_exp_comp_zero (dx e.succ)
    have hm : HasStrictFDerivAt (fun _ : Lie ι => A e) 0 0 :=
      hasStrictFDerivAt_const (𝕜 := ℝ) (A e) (0 : Lie ι)
    have hr := hasStrictFDerivAt_exp_comp_zero (-(dx e.castSucc))
    convert (hasStrictFDerivAt_matrix_mul
      (hasStrictFDerivAt_matrix_mul hl hm) hr) using 1 <;> try rfl
    apply ContinuousLinearMap.ext
    intro X
    simp [dx, orbitDifferential, sub_eq_add_neg]
    abel
  convert (hasStrictFDerivAt_pi.mpr he) using 1 <;> rfl

omit [∀ v, DecidableEq (ι v)] in
/-- Its literal kernel is the actual representation endomorphism space. -/
theorem orbitMap_derivative_kernel (A : Rep ι) (X : Lie ι) :
    (orbitDifferential ι A).toContinuousLinearMap X = 0 ↔
      ∀ e : Fin D, X e.succ * A e = A e * X e.castSucc :=
  mem_ker_orbitDifferential_iff ι A X

end MAIS.OrbitTangent
end
-- ==================== end module O7.OrbitTangent ====================

-- ==================== begin module O7.MatrixRankClosed (formalization/O7/MatrixRankClosed.lean) ====================
section

/-! Ordinary Euclidean closedness of actual real matrix-rank sublevel
sets, derived from Mathlib's openness of actual operator-rank superlevels. -/

set_option autoImplicit false
set_option maxHeartbeats 1500000
noncomputable section
open scoped Matrix.Norms.Elementwise

namespace MAIS.MatrixRankClosed

variable {m n : Type*} [Fintype m] [Fintype n] [DecidableEq n]

def matrixCLM : Matrix m n ℝ →ₗ[ℝ] ((n → ℝ) →L[ℝ] (m → ℝ)) :=
  (LinearMap.toContinuousLinearMap : ((n → ℝ) →ₗ[ℝ] (m → ℝ)) ≃ₗ[ℝ]
    ((n → ℝ) →L[ℝ] (m → ℝ))).toLinearMap.comp Matrix.toLin'.toLinearMap

lemma continuous_matrixCLM : Continuous (matrixCLM (m := m) (n := n)) :=
  (matrixCLM (m := m) (n := n)).continuous_of_finiteDimensional

theorem isOpen_rank_ge (k : ℕ) : IsOpen {A : Matrix m n ℝ | k ≤ A.rank} := by
  have heq : {A : Matrix m n ℝ | k ≤ A.rank} =
      (matrixCLM (m := m) (n := n)) ⁻¹'
        {f : (n → ℝ) →L[ℝ] (m → ℝ) | (k : Cardinal) ≤ f.toLinearMap.rank} := by
    ext A
    change k ≤ Module.finrank ℝ A.mulVecLin.range ↔
      (k : Cardinal) ≤ Module.rank ℝ A.mulVecLin.range
    rw [← Module.finrank_eq_rank]
    norm_cast
  rw [heq]
  have hopen : IsOpen {f : (n → ℝ) →L[ℝ] (m → ℝ) |
      (k : Cardinal) ≤ f.toLinearMap.rank} :=
    isOpen_setOfPred_nat_le_rank (𝕜 := ℝ) (E := n → ℝ) (F := m → ℝ) k
  exact hopen.preimage continuous_matrixCLM

theorem isClosed_rank_le (k : ℕ) : IsClosed {A : Matrix m n ℝ | A.rank ≤ k} := by
  have heq : {A : Matrix m n ℝ | A.rank ≤ k} =
      {A : Matrix m n ℝ | k + 1 ≤ A.rank}ᶜ := by
    ext A
    simp only [Set.mem_ofPred_eq, Set.mem_compl_iff]
    omega
  rw [heq]
  exact (isOpen_rank_ge (m := m) (n := n) (k + 1)).isClosed_compl

end MAIS.MatrixRankClosed

/--
info: 'MAIS.MatrixRankClosed.isClosed_rank_le' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.MatrixRankClosed.isClosed_rank_le
end
end
-- ==================== end module O7.MatrixRankClosed ====================

-- ==================== begin module O7.QuiverOrbitRank (formalization/O7/QuiverOrbitRank.lean) ====================
section

/-! Actual consecutive matrix ranks are invariant under the real matrix
gauge group and can only decrease in its ordinary Euclidean orbit closure. -/

set_option autoImplicit false
set_option maxHeartbeats 1500000
noncomputable section

namespace MAIS.QuiverOrbitRank

open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.MatrixRankClosed

lemma rank_unit_sandwich {m n : Type*} [Fintype m] [DecidableEq m]
    [Fintype n] [DecidableEq n] (u : (Matrix m m ℝ)ˣ) (v : (Matrix n n ℝ)ˣ)
    (A : Matrix m n ℝ) :
    ((u : Matrix m m ℝ) * A * (v : Matrix n n ℝ)).rank = A.rank := by
  apply le_antisymm
  · exact (Matrix.rank_mul_le_left _ _).trans (Matrix.rank_mul_le_right _ _)
  · have hid : (↑(u⁻¹) : Matrix m m ℝ) * ((u : Matrix m m ℝ) * A *
        (v : Matrix n n ℝ)) * (↑(v⁻¹) : Matrix n n ℝ) = A := by
      calc
        _ = ((↑(u⁻¹) : Matrix m m ℝ) * (u : Matrix m m ℝ)) * A *
            ((v : Matrix n n ℝ) * ↑(v⁻¹)) := by simp only [Matrix.mul_assoc]
        _ = A := by rw [Units.inv_mul, Units.mul_inv, Matrix.one_mul, Matrix.mul_one]
    have hle := (Matrix.rank_mul_le_left
      ((↑(u⁻¹) : Matrix m m ℝ) * ((u : Matrix m m ℝ) * A * (v : Matrix n n ℝ)))
      (↑(v⁻¹) : Matrix n n ℝ)).trans (Matrix.rank_mul_le_right _ _)
    rwa [hid] at hle

variable {D : ℕ} {ι : Fin (D + 1) → Type*}
variable [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

theorem pathMatrix_gauge (g : Gauge ι) (A : Rep ι)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    pathMatrix (g • A) i j hij = (↑(g j) : Matrix (ι j) (ι j) ℝ) *
      pathMatrix A i j hij * (↑((g i)⁻¹) : Matrix (ι i) (ι i) ℝ) := by
  suffices h : ∀ j : Fin (D + 1), ∀ i (hij : i ≤ j),
      pathMatrix (g • A) i j hij = (↑(g j) : Matrix (ι j) (ι j) ℝ) *
        pathMatrix A i j hij * (↑((g i)⁻¹) : Matrix (ι i) (ι i) ℝ) from h j i hij
  intro j
  induction j using Fin.induction with
  | zero =>
    intro i hij
    have hi : i = 0 := le_antisymm hij (by exact Nat.zero_le i.val)
    subst i
    rw [pathMatrix_self, pathMatrix_self, Matrix.mul_one, Units.mul_inv]
  | succ e ih =>
    intro i hij
    by_cases heq : i = e.succ
    · subst i
      rw [pathMatrix_self, pathMatrix_self, Matrix.mul_one, Units.mul_inv]
    · have hne : i.val ≠ e.val + 1 := fun h => heq (Fin.ext h)
      have hij' : i ≤ e.castSucc := by
        change i.val ≤ e.val
        have hle : i.val ≤ e.val + 1 := hij
        omega
      rw [pathMatrix_step (g • A) i e hij', gauge_smul_apply, ih i hij',
        pathMatrix_step A i e hij']
      calc
        _ = (↑(g e.succ) : Matrix (ι e.succ) (ι e.succ) ℝ) * A e *
            ((↑((g e.castSucc)⁻¹) : Matrix (ι e.castSucc) (ι e.castSucc) ℝ) *
              (↑(g e.castSucc) : Matrix (ι e.castSucc) (ι e.castSucc) ℝ)) *
              pathMatrix A i e.castSucc hij' * (↑((g i)⁻¹) : Matrix (ι i) (ι i) ℝ) := by
          simp only [Matrix.mul_assoc]
        _ = _ := by rw [Units.inv_mul, Matrix.mul_one]; simp only [Matrix.mul_assoc]

theorem path_rank_gauge (g : Gauge ι) (A : Rep ι)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (g • A) i j hij).rank = (pathMatrix A i j hij).rank := by
  rw [pathMatrix_gauge]
  exact rank_unit_sandwich (g j) ((g i)⁻¹) _

theorem isClosed_path_rank_le (i j : Fin (D + 1)) (hij : i ≤ j) (k : ℕ) :
    IsClosed {A : Rep ι | (pathMatrix A i j hij).rank ≤ k} :=
  (isClosed_rank_le k).preimage (continuous_pathMatrix i j hij)

/-- Necessity of actual path-rank order for actual real gauge orbit
closure, with the ordinary finite-dimensional matrix topology. -/
theorem path_rank_le_of_mem_closure_orbit {A B : Rep ι}
    (hAB : A ∈ closure (MulAction.orbit (Gauge ι) B))
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix A i j hij).rank ≤ (pathMatrix B i j hij).rank := by
  have hsub : MulAction.orbit (Gauge ι) B ⊆
      {C : Rep ι | (pathMatrix C i j hij).rank ≤ (pathMatrix B i j hij).rank} := by
    intro C hC
    obtain ⟨g, rfl⟩ := MulAction.mem_orbit_iff.mp hC
    exact le_of_eq (path_rank_gauge g B i j hij)
  exact closure_minimal hsub (isClosed_path_rank_le i j hij _) hAB

end MAIS.QuiverOrbitRank

/--
info: 'MAIS.QuiverOrbitRank.path_rank_le_of_mem_closure_orbit' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverOrbitRank.path_rank_le_of_mem_closure_orbit
end
end
-- ==================== end module O7.QuiverOrbitRank ====================

-- ==================== begin module O7.OrbitSliceLoss (formalization/O7/OrbitSliceLoss.lean) ====================
section

/-! Exact path-product conjugation in the actual slice chart, and Frobenius-norm
comparison under genuine real matrix-unit gauges. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace MAIS.OrbitSliceLoss

open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.OrbitSliceChart
open MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open scoped Matrix Matrix.Norms.Frobenius Topology

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
variable [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- Exact equality in the full ambient chart; all intermediate changes of basis
    cancel in the actual consecutive-arrow matrix product. -/
theorem pathMatrix_sliceMap (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι)) (p : H × N)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    pathMatrix (sliceMap ι A H N p) i j hij =
      NormedSpace.exp ((p.1 : Lie ι) j) *
        pathMatrix (A + (p.2 : Rep ι)) i j hij *
          NormedSpace.exp (-((p.1 : Lie ι) i)) := by
  rw [sliceMap_eq_expGauge_smul, pathMatrix_gauge]
  rfl

/-- A literal endpoint gauge changes the actual Frobenius path norm by at most
    the product of the two actual endpoint matrix norms. -/
theorem norm_pathMatrix_gauge_le (g : Gauge ι) (A : Rep ι)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    ‖pathMatrix (g • A) i j hij‖ ≤
      (‖(↑(g j) : Matrix (ι j) (ι j) ℝ)‖ *
        ‖(↑((g i)⁻¹) : Matrix (ι i) (ι i) ℝ)‖) * ‖pathMatrix A i j hij‖ := by
  rw [pathMatrix_gauge]
  calc
    _ ≤ ‖(↑(g j) : Matrix (ι j) (ι j) ℝ) * pathMatrix A i j hij‖ *
        ‖(↑((g i)⁻¹) : Matrix (ι i) (ι i) ℝ)‖ := Matrix.frobenius_norm_mul _ _
    _ ≤ (‖(↑(g j) : Matrix (ι j) (ι j) ℝ)‖ * ‖pathMatrix A i j hij‖) *
        ‖(↑((g i)⁻¹) : Matrix (ι i) (ι i) ℝ)‖ :=
      mul_le_mul_of_nonneg_right (Matrix.frobenius_norm_mul _ _) (norm_nonneg _)
    _ = _ := by ring

/-- The reverse estimate follows from the actual inverse gauge action. -/
theorem norm_pathMatrix_le_gauge (g : Gauge ι) (A : Rep ι)
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    ‖pathMatrix A i j hij‖ ≤
      (‖(↑((g j)⁻¹) : Matrix (ι j) (ι j) ℝ)‖ *
        ‖(↑(g i) : Matrix (ι i) (ι i) ℝ)‖) * ‖pathMatrix (g • A) i j hij‖ := by
  simpa only [inv_smul_smul, Pi.inv_apply, inv_inv] using
    norm_pathMatrix_gauge_le ι g⁻¹ (g • A) i j hij

/-- A fixed positive constant controls the actual squared Frobenius loss
    in both directions on a full neighborhood of the zero slice coordinates.
    No hypothesis about smoothness of the zero set or of the slice loss occurs. -/
theorem exists_local_squared_norm_comparison (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (i j : Fin (D + 1)) (hij : i ≤ j) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ p : H × N in 𝓝 0,
      ‖pathMatrix (A + (p.2 : Rep ι)) i j hij‖ ^ 2 / C ≤
        ‖pathMatrix (sliceMap ι A H N p) i j hij‖ ^ 2 ∧
      ‖pathMatrix (sliceMap ι A H N p) i j hij‖ ^ 2 ≤
        C * ‖pathMatrix (A + (p.2 : Rep ι)) i j hij‖ ^ 2 := by
  let K : ℝ := ‖(1 : Matrix (ι j) (ι j) ℝ)‖ *
    ‖(1 : Matrix (ι i) (ι i) ℝ)‖ + 1
  have hK : 0 < K := by dsimp [K]; positivity
  let dx (v : Fin (D + 1)) : (H × N) →L[ℝ] Matrix (ι v) (ι v) ℝ :=
    (ContinuousLinearMap.proj v).comp
      (H.subtypeL.comp (ContinuousLinearMap.fst ℝ H N))
  have hx (v : Fin (D + 1)) :
      Continuous (fun p : H × N => NormedSpace.exp (dx v p)) :=
    NormedSpace.exp_continuous.comp (dx v).continuous
  have hxn (v : Fin (D + 1)) :
      Continuous (fun p : H × N => NormedSpace.exp (-(dx v p))) :=
    NormedSpace.exp_continuous.comp (dx v).continuous.neg
  have hp : ∀ᶠ p : H × N in 𝓝 0,
      ‖NormedSpace.exp (dx j p)‖ * ‖NormedSpace.exp (-(dx i p))‖ < K := by
    apply Filter.Tendsto.eventually_lt_const _ ((hx j).norm.mul (hxn i).norm).continuousAt
    simp [K]
  have hm : ∀ᶠ p : H × N in 𝓝 0,
      ‖NormedSpace.exp (-(dx j p))‖ * ‖NormedSpace.exp (dx i p)‖ < K := by
    apply Filter.Tendsto.eventually_lt_const _ ((hxn j).norm.mul (hx i).norm).continuousAt
    simp [K]
  refine ⟨K ^ 2, sq_pos_of_pos hK, ?_⟩
  filter_upwards [hp, hm] with p hp hm
  have hu := norm_pathMatrix_gauge_le ι (expGauge ι (p.1 : Lie ι))
    (A + (p.2 : Rep ι)) i j hij
  have hl := norm_pathMatrix_le_gauge ι (expGauge ι (p.1 : Lie ι))
    (A + (p.2 : Rep ι)) i j hij
  rw [← sliceMap_eq_expGauge_smul ι A H N p] at hu hl
  have hu' : ‖pathMatrix (sliceMap ι A H N p) i j hij‖ ≤
      K * ‖pathMatrix (A + (p.2 : Rep ι)) i j hij‖ :=
    hu.trans (mul_le_mul_of_nonneg_right hp.le (norm_nonneg _))
  have hl' : ‖pathMatrix (A + (p.2 : Rep ι)) i j hij‖ ≤
      K * ‖pathMatrix (sliceMap ι A H N p) i j hij‖ :=
    hl.trans (mul_le_mul_of_nonneg_right hm.le (norm_nonneg _))
  have hus := (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hK.le (norm_nonneg _))).mpr hu'
  have hls := (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hK.le (norm_nonneg _))).mpr hl'
  rw [mul_pow] at hus hls
  exact ⟨(div_le_iff₀ (sq_pos_of_pos hK)).mpr (by simpa only [mul_comm] using hls), hus⟩

end MAIS.OrbitSliceLoss
end
-- ==================== end module O7.OrbitSliceLoss ====================

-- ==================== begin module O7.Run2PositivePathDerivative (formalization/O7/Run2PositivePathDerivative.lean) ====================
section

/-! Actual analytic complete-path maps and their derivative on actual orbit
vectors. This is the chain-rule input for positive-target endpoint surjectivity. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace MAIS.Run2PositivePathDerivative
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.MatrixSmoothMul
open MAIS.OrbitSliceLinear MAIS.OrbitSliceChart MAIS.OrbitTangent MAIS.QuiverOrbitRank
open scoped Matrix Matrix.Norms.Frobenius ContDiff
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- Every actual consecutive-arrow product is real analytic in all arrow entries. -/
theorem contDiff_pathMatrix (i j : Fin (D+1)) (hij : i ≤ j) :
    ContDiff ℝ ω (fun A : Rep ι => pathMatrix A i j hij) := by
  suffices h : ∀ j : Fin (D+1), ∀ i (hij : i ≤ j),
      ContDiff ℝ ω (fun A : Rep ι => pathMatrix A i j hij) from h j i hij
  intro j
  induction j using Fin.induction with
  | zero =>
    intro i hij
    have hi : i = 0 := le_antisymm hij (by exact Nat.zero_le i.val)
    subst i
    simpa only [pathMatrix_self] using
      (contDiff_const : ContDiff ℝ ω (fun _ : Rep ι => (1 : Matrix (ι 0) (ι 0) ℝ)))
  | succ e ih =>
    intro i hij
    by_cases heq : i = e.succ
    · subst i
      simpa only [pathMatrix_self] using
        (contDiff_const : ContDiff ℝ ω (fun _ : Rep ι => (1 : Matrix (ι e.succ) (ι e.succ) ℝ)))
    · have hij' : i ≤ e.castSucc := by
        have hne : i.val ≠ e.val + 1 := fun h => heq (Fin.ext h)
        change i.val ≤ e.val
        have hle : i.val ≤ e.val + 1 := hij
        omega
      have hf : (fun A : Rep ι => pathMatrix A i e.succ hij) =
          (fun A : Rep ι => A e * pathMatrix A i e.castSucc hij') := by
        funext A
        exact pathMatrix_step A i e hij'
      rw [hf]
      exact contDiff_iff_contDiffAt.mpr (fun A =>
        contDiffAt_matrix_mul ((ContinuousLinearMap.proj e : Rep ι →L[ℝ] Matrix (ι e.succ) (ι e.castSucc) ℝ).contDiff.contDiffAt)
          (ih i hij').contDiffAt)

/-- Literal endpoint Lie action on a literal product matrix. -/
def endpointDifferential (A : Rep ι) (i j : Fin (D+1)) (hij : i ≤ j) :
    Lie ι →L[ℝ] Matrix (ι j) (ι i) ℝ :=
  (((mulCLM (l := ι j) (m := ι j) (n := ι i)).flip (pathMatrix A i j hij)).comp
      (ContinuousLinearMap.proj j : Lie ι →L[ℝ] Matrix (ι j) (ι j) ℝ)) -
    (((mulCLM (l := ι j) (m := ι i) (n := ι i)) (pathMatrix A i j hij)).comp
      (ContinuousLinearMap.proj i : Lie ι →L[ℝ] Matrix (ι i) (ι i) ℝ))

@[simp] theorem endpointDifferential_apply (A : Rep ι) (i j : Fin (D+1))
    (hij : i ≤ j) (η : Lie ι) :
    endpointDifferential ι A i j hij η =
      η j * pathMatrix A i j hij - pathMatrix A i j hij * η i := rfl

/-- Differentiate the actual endpoint exponential product. -/
theorem hasStrictFDerivAt_path_orbitMap (A : Rep ι)
    (i j : Fin (D+1)) (hij : i ≤ j) :
    HasStrictFDerivAt (fun η : Lie ι => pathMatrix (orbitMap ι A η) i j hij)
      (endpointDifferential ι A i j hij) 0 := by
  have hl := hasStrictFDerivAt_exp_comp_zero (ContinuousLinearMap.proj j :
    Lie ι →L[ℝ] Matrix (ι j) (ι j) ℝ)
  have hm : HasStrictFDerivAt (fun _ : Lie ι => pathMatrix A i j hij) 0 0 :=
    hasStrictFDerivAt_const (𝕜 := ℝ) (pathMatrix A i j hij) (0 : Lie ι)
  have hr := hasStrictFDerivAt_exp_comp_zero (-(ContinuousLinearMap.proj i :
    Lie ι →L[ℝ] Matrix (ι i) (ι i) ℝ))
  have hf : (fun η : Lie ι => pathMatrix (orbitMap ι A η) i j hij) =
      (fun η => NormedSpace.exp (η j) * pathMatrix A i j hij * NormedSpace.exp (-(η i))) := by
    funext η
    rw [orbitMap, pathMatrix_gauge]
    rfl
  rw [hf]
  convert hasStrictFDerivAt_matrix_mul (hasStrictFDerivAt_matrix_mul hl hm) hr using 1 <;> try rfl
  apply ContinuousLinearMap.ext
  intro η
  simp [endpointDifferential, sub_eq_add_neg, add_comm]

/-- The actual derivative of the actual path map sends every actual arrow-orbit
vector to its literal endpoint orbit vector. -/
theorem fderiv_path_orbitDifferential (A : Rep ι)
    (i j : Fin (D+1)) (hij : i ≤ j) (η : Lie ι) :
    fderiv ℝ (fun B : Rep ι => pathMatrix B i j hij) A
      (orbitDifferential ι A η) =
        η j * pathMatrix A i j hij - pathMatrix A i j hij * η i := by
  have hp := (contDiff_pathMatrix ι i j hij).differentiable (by simp)
  have hh : HasFDerivAt (fun B : Rep ι => pathMatrix B i j hij)
      (fderiv ℝ (fun B : Rep ι => pathMatrix B i j hij) A) (orbitMap ι A 0) := by
    simpa only [orbitMap_zero] using (hp A).hasFDerivAt
  have hc := hh.comp 0 (hasStrictFDerivAt_orbitMap ι A).hasFDerivAt
  have he := (hasStrictFDerivAt_path_orbitMap ι A i j hij).hasFDerivAt
  have hder : (fderiv ℝ (fun B : Rep ι => pathMatrix B i j hij) A).comp
      (orbitDifferential ι A).toContinuousLinearMap = endpointDifferential ι A i j hij := by
    apply HasFDerivAt.unique _ he
    convert hc using 1 <;> rfl
  exact congrArg (fun L : Lie ι →L[ℝ] Matrix (ι j) (ι i) ℝ => L η) hder

end MAIS.Run2PositivePathDerivative

/-- info: 'MAIS.Run2PositivePathDerivative.contDiff_pathMatrix' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositivePathDerivative.contDiff_pathMatrix

/-- info: 'MAIS.Run2PositivePathDerivative.hasStrictFDerivAt_path_orbitMap' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositivePathDerivative.hasStrictFDerivAt_path_orbitMap

/-- info: 'MAIS.Run2PositivePathDerivative.fderiv_path_orbitDifferential' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositivePathDerivative.fderiv_path_orbitDifferential
end
end
-- ==================== end module O7.Run2PositivePathDerivative ====================

-- ==================== begin module O7.Run2ParameterRetainingLinear (formalization/O7/Run2ParameterRetainingLinear.lean) ====================
section

/-! Actual linear algebra for a parameter-retaining submersion chart.
No dimension equality or inverse is assumed: an explicit inverse is built
from a right inverse of the actual partial derivative. -/
set_option autoImplicit false
noncomputable section
namespace MAIS.Run2ParameterRetainingLinear

variable {G X Q : Type*}
  [NormedAddCommGroup G] [NormedSpace ℝ G]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]

/-- The actual partial derivative in the gauge variable. -/
def gaugeDerivative (d : (G × X) →L[ℝ] Q) : G →L[ℝ] Q :=
  d.comp (ContinuousLinearMap.inl ℝ G X)

/-- The actual partial derivative in the retained variable. -/
def parameterDerivative (d : (G × X) →L[ℝ] Q) : X →L[ℝ] Q :=
  d.comp (ContinuousLinearMap.inr ℝ G X)

abbrev Kernel (d : (G × X) →L[ℝ] Q) := (gaugeDerivative d).ker

@[simp] theorem gaugeDerivative_apply (d : (G × X) →L[ℝ] Q) (g : G) :
    gaugeDerivative d g = d (g, 0) := rfl

@[simp] theorem parameterDerivative_apply (d : (G × X) →L[ℝ] Q) (x : X) :
    parameterDerivative d x = d (0, x) := rfl

theorem derivative_split (d : (G × X) →L[ℝ] Q) (g : G) (x : X) :
    d (g, x) = gaugeDerivative d g + parameterDerivative d x := by
  change d (g, x) = d (g, 0) + d (0, x)
  simpa only [Prod.mk_add_mk, add_zero, zero_add] using d.map_add (g, 0) (0, x)

/-- A projection into the actual kernel, derived from the actual right inverse. -/
def kernelProjection (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G)
    (hs : Function.RightInverse s (gaugeDerivative d)) : G →L[ℝ] Kernel d :=
  (gaugeDerivative d).projKerOfRightInverse s hs

@[simp] theorem coe_kernelProjection (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G)
    (hs : Function.RightInverse s (gaugeDerivative d)) (g : G) :
    (kernelProjection d s hs g : G) = g - s (gaugeDerivative d g) := rfl

/-- The literal derivative of ((u(g,x), kernelProjection g), x). -/
def forward (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G)
    (hs : Function.RightInverse s (gaugeDerivative d)) :
    (G × X) →L[ℝ] (Q × Kernel d) × X :=
  (d.prod ((kernelProjection d s hs).comp (ContinuousLinearMap.fst ℝ G X))).prod
    (ContinuousLinearMap.snd ℝ G X)

@[simp] theorem forward_apply (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G)
    (hs : Function.RightInverse s (gaugeDerivative d)) (p : G × X) :
    forward d s hs p = ((d p, kernelProjection d s hs p.1), p.2) := rfl

/-- The actual candidate inverse, including the mixed retained-variable term. -/
def backward (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G) :
    ((Q × Kernel d) × X) →L[ℝ] G × X :=
  let q : ((Q × Kernel d) × X) →L[ℝ] Q :=
    (ContinuousLinearMap.fst ℝ Q (Kernel d)).comp
      (ContinuousLinearMap.fst ℝ (Q × Kernel d) X)
  let k : ((Q × Kernel d) × X) →L[ℝ] G :=
    (gaugeDerivative d).ker.subtypeL.comp
      ((ContinuousLinearMap.snd ℝ Q (Kernel d)).comp
        (ContinuousLinearMap.fst ℝ (Q × Kernel d) X))
  let x : ((Q × Kernel d) × X) →L[ℝ] X :=
    ContinuousLinearMap.snd ℝ (Q × Kernel d) X
  ((s.comp (q - (parameterDerivative d).comp x)) + k).prod x

@[simp] theorem backward_apply (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G)
    (p : (Q × Kernel d) × X) :
    backward d s p = (s (p.1.1 - parameterDerivative d p.2) + (p.1.2 : G), p.2) := rfl

theorem backward_forward (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G)
    (hs : Function.RightInverse s (gaugeDerivative d)) (p : G × X) :
    backward d s (forward d s hs p) = p := by
  rcases p with ⟨g, x⟩
  apply Prod.ext
  · change s (d (g, x) - parameterDerivative d x) +
        (kernelProjection d s hs g : G) = g
    rw [derivative_split d, add_sub_cancel_right, coe_kernelProjection]
    abel
  · rfl

theorem forward_backward (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G)
    (hs : Function.RightInverse s (gaugeDerivative d)) (p : (Q × Kernel d) × X) :
    forward d s hs (backward d s p) = p := by
  rcases p with ⟨⟨q, k⟩, x⟩
  have hk : gaugeDerivative d (k : G) = 0 := k.property
  apply Prod.ext
  · apply Prod.ext
    · change d (s (q - parameterDerivative d x) + (k : G), x) = q
      rw [derivative_split d, (gaugeDerivative d).map_add, hs, hk, add_zero,
        sub_add_cancel]
    · apply Subtype.ext
      change (kernelProjection d s hs (s (q - parameterDerivative d x) + (k : G)) : G) =
        (k : G)
      rw [coe_kernelProjection, (gaugeDerivative d).map_add, hs, hk, add_zero]
      abel
  · rfl

/-- Genuine continuous linear equivalence, with the retained variable unchanged. -/
def derivativeEquiv (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G)
    (hs : Function.RightInverse s (gaugeDerivative d)) :
    (G × X) ≃L[ℝ] (Q × Kernel d) × X :=
  ContinuousLinearEquiv.equivOfInverse (forward d s hs) (backward d s)
    (backward_forward d s hs) (forward_backward d s hs)

@[simp] theorem derivativeEquiv_apply (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G)
    (hs : Function.RightInverse s (gaugeDerivative d)) (p : G × X) :
    derivativeEquiv d s hs p = ((d p, kernelProjection d s hs p.1), p.2) := rfl

@[simp] theorem derivativeEquiv_symm_apply (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G)
    (hs : Function.RightInverse s (gaugeDerivative d)) (p : (Q × Kernel d) × X) :
    (derivativeEquiv d s hs).symm p =
      (s (p.1.1 - parameterDerivative d p.2) + (p.1.2 : G), p.2) := rfl

/-- In finite-dimensional output spaces, surjectivity supplies the needed actual
continuous right inverse. No complement or volume hypothesis is an input. -/
theorem exists_rightInverse [FiniteDimensional ℝ Q] (d : (G × X) →L[ℝ] Q)
    (hd : Function.Surjective (gaugeDerivative d)) :
    ∃ s : Q →L[ℝ] G, Function.RightInverse s (gaugeDerivative d) := by
  obtain ⟨s, hs⟩ := (gaugeDerivative d).exists_rightInverse_of_surjective
    (LinearMap.range_eq_top.mpr hd)
  refine ⟨s, ?_⟩
  intro q
  exact congrArg (fun f : Q →L[ℝ] Q => f q) hs

end MAIS.Run2ParameterRetainingLinear

/-- info: 'MAIS.Run2ParameterRetainingLinear.derivativeEquiv' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingLinear.derivativeEquiv

/-- info: 'MAIS.Run2ParameterRetainingLinear.exists_rightInverse' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingLinear.exists_rightInverse
end
end
-- ==================== end module O7.Run2ParameterRetainingLinear ====================

-- ==================== begin module O7.Run2ParameterRetainingChart (formalization/O7/Run2ParameterRetainingChart.lean) ====================
section

/-! The actual inverse-function chart retaining the literal parameter x.
Its inverse, target and source are constructed by the real Banach IFT. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set
namespace MAIS.Run2ParameterRetainingChart
open MAIS.Run2ParameterRetainingLinear

variable {G X Q : Type*}
  [NormedAddCommGroup G] [NormedSpace ℝ G]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]

/-- The genuine nonlinear coordinate map, not an assigned normal form. -/
def coordinateMap (u : G × X → Q) (d : (G × X) →L[ℝ] Q) (s : Q →L[ℝ] G)
    (hs : Function.RightInverse s (gaugeDerivative d))
    (p : G × X) : (Q × Kernel d) × X :=
  ((u p, kernelProjection d s hs p.1), p.2)

@[simp] theorem coordinateMap_retains (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d)) (p : G × X) :
    (coordinateMap u d s hs p).2 = p.2 := rfl

@[simp] theorem coordinateMap_zero (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d)) :
    coordinateMap u d s hs 0 = ((u 0, 0), 0) := by
  simp only [coordinateMap, Prod.fst_zero, Prod.snd_zero, map_zero]

theorem hasStrictFDerivAt_coordinateMap
    (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) :
    HasStrictFDerivAt (coordinateMap u d s hs)
      (derivativeEquiv d s hs : (G × X) →L[ℝ] (Q × Kernel d) × X) 0 := by
  have hk := ((kernelProjection d s hs).comp
    (ContinuousLinearMap.fst ℝ G X)).hasStrictFDerivAt (x := (0 : G × X))
  have hx := (ContinuousLinearMap.snd ℝ G X).hasStrictFDerivAt (x := (0 : G × X))
  exact (hu.prodMk hk).prodMk hx

variable [CompleteSpace G] [CompleteSpace X]

/-- The full, honest local homeomorphism supplied by the actual IFT. -/
def retainedChart (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) :
    OpenPartialHomeomorph (G × X) ((Q × Kernel d) × X) :=
  (hasStrictFDerivAt_coordinateMap u d s hs hu).toOpenPartialHomeomorph
    (coordinateMap u d s hs)

@[simp] theorem retainedChart_coe
    (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) :
    (retainedChart u d s hs hu : G × X → (Q × Kernel d) × X) =
      coordinateMap u d s hs := rfl

theorem zero_mem_source (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) :
    0 ∈ (retainedChart u d s hs hu).source :=
  (hasStrictFDerivAt_coordinateMap u d s hs hu).mem_toOpenPartialHomeomorph_source

theorem base_mem_target (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) :
    ((u 0, 0), 0) ∈ (retainedChart u d s hs hu).target := by
  simpa only [retainedChart, coordinateMap_zero] using
    (hasStrictFDerivAt_coordinateMap u d s hs hu).image_mem_toOpenPartialHomeomorph_target

@[simp] theorem retainedChart_retains
    (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) (p : G × X) :
    (retainedChart u d s hs hu p).2 = p.2 := rfl

/-- Actual inverse coordinates retain x on the actual chart target. -/
theorem inverse_retains (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) (y : (Q × Kernel d) × X)
    (hy : y ∈ (retainedChart u d s hs hu).target) :
    ((retainedChart u d s hs hu).symm y).2 = y.2 := by
  exact congrArg Prod.snd ((retainedChart u d s hs hu).right_inv hy)

/-- The actual regular output is exactly the new regular coordinate. -/
theorem inverse_regular (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) (y : (Q × Kernel d) × X)
    (hy : y ∈ (retainedChart u d s hs hu).target) :
    u ((retainedChart u d s hs hu).symm y) = y.1.1 := by
  exact congrArg (fun z : (Q × Kernel d) × X => z.1.1)
    ((retainedChart u d s hs hu).right_inv hy)

@[simp] theorem inverse_base (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) :
    (retainedChart u d s hs hu).symm ((u 0, 0), 0) = 0 := by
  simpa only [retainedChart_coe, coordinateMap_zero] using
    (retainedChart u d s hs hu).left_inv (zero_mem_source u d s hs hu)

/-- The derivative of the actual inverse is the derived linear inverse. -/
theorem hasStrictFDerivAt_inverse
    (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) :
    HasStrictFDerivAt (retainedChart u d s hs hu).symm
      ((derivativeEquiv d s hs).symm : ((Q × Kernel d) × X) →L[ℝ] G × X)
      ((u 0, 0), 0) := by
  simpa only [retainedChart, HasStrictFDerivAt.localInverse_def, coordinateMap_zero] using
    (hasStrictFDerivAt_coordinateMap u d s hs hu).to_localInverse

end MAIS.Run2ParameterRetainingChart

/-- info: 'MAIS.Run2ParameterRetainingChart.hasStrictFDerivAt_coordinateMap' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingChart.hasStrictFDerivAt_coordinateMap

/-- info: 'MAIS.Run2ParameterRetainingChart.inverse_retains' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingChart.inverse_retains

/-- info: 'MAIS.Run2ParameterRetainingChart.inverse_regular' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingChart.inverse_regular

/-- info: 'MAIS.Run2ParameterRetainingChart.hasStrictFDerivAt_inverse' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingChart.hasStrictFDerivAt_inverse
end
end
-- ==================== end module O7.Run2ParameterRetainingChart ====================

-- ==================== begin module O7.Run2ParameterRetainingAnalytic (formalization/O7/Run2ParameterRetainingAnalytic.lean) ====================
section

/-! Real-analytic regularity and unconditional construction from a surjective
actual partial derivative. Every inverse and retained-coordinate identity
belongs to the actual open partial homeomorphism. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set Filter
open scoped Topology ContDiff
namespace MAIS.Run2ParameterRetainingAnalytic
open MAIS.Run2ParameterRetainingLinear MAIS.Run2ParameterRetainingChart

variable {G X Q : Type*}
  [NormedAddCommGroup G] [NormedSpace ℝ G]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]

 theorem contDiffAt_coordinateMap
    (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : ContDiffAt ℝ ω u 0) : ContDiffAt ℝ ω (coordinateMap u d s hs) 0 := by
  have hk : ContDiffAt ℝ ω (fun p : G × X => kernelProjection d s hs p.1) 0 :=
    ((kernelProjection d s hs).comp (ContinuousLinearMap.fst ℝ G X)).contDiff.contDiffAt
  have hx : ContDiffAt ℝ ω (fun p : G × X => p.2) 0 :=
    (ContinuousLinearMap.snd ℝ G X).contDiff.contDiffAt
  exact (hu.prodMk hk).prodMk hx

 theorem contDiff_coordinateMap
    (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : ContDiff ℝ ω u) : ContDiff ℝ ω (coordinateMap u d s hs) := by
  have hk : ContDiff ℝ ω (fun p : G × X => kernelProjection d s hs p.1) :=
    ((kernelProjection d s hs).comp (ContinuousLinearMap.fst ℝ G X)).contDiff
  have hx : ContDiff ℝ ω (fun p : G × X => p.2) :=
    (ContinuousLinearMap.snd ℝ G X).contDiff
  exact (hu.prodMk hk).prodMk hx

variable [CompleteSpace G] [CompleteSpace X]

/-- Analyticity of the inverse at its actual base point. -/
theorem analyticAt_inverse_base
    (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) (ha : ContDiffAt ℝ ω u 0) :
    AnalyticAt ℝ (retainedChart u d s hs hu).symm ((u 0, 0), 0) := by
  have hd : HasFDerivAt (retainedChart u d s hs hu)
      (derivativeEquiv d s hs : (G × X) →L[ℝ] (Q × Kernel d) × X)
      ((retainedChart u d s hs hu).symm ((u 0, 0), 0)) := by
    simpa only [inverse_base, retainedChart_coe] using
      (hasStrictFDerivAt_coordinateMap u d s hs hu).hasFDerivAt
  have hc : ContDiffAt ℝ ω (retainedChart u d s hs hu)
      ((retainedChart u d s hs hu).symm ((u 0, 0), 0)) := by
    simpa only [inverse_base, retainedChart_coe] using contDiffAt_coordinateMap u d s hs ha
  exact ((retainedChart u d s hs hu).contDiffAt_symm
    (base_mem_target u d s hs hu) hd hc).analyticAt

/-- The actual inverse is analytic on some open target neighborhood. -/
theorem exists_open_analytic_inverse_neighborhood
    (u : G × X → Q) (d : (G × X) →L[ℝ] Q)
    (s : Q →L[ℝ] G) (hs : Function.RightInverse s (gaugeDerivative d))
    (hu : HasStrictFDerivAt u d 0) (ha : ContDiffAt ℝ ω u 0) :
    ∃ U : Set ((Q × Kernel d) × X), IsOpen U ∧ ((u 0, 0), 0) ∈ U ∧
      U ⊆ (retainedChart u d s hs hu).target ∧
      ∀ y ∈ U, AnalyticAt ℝ (retainedChart u d s hs hu).symm y := by
  have h := (analyticAt_inverse_base u d s hs hu ha).eventually_analyticAt
  have ht := (retainedChart u d s hs hu).open_target.mem_nhds (base_mem_target u d s hs hu)
  obtain ⟨U, hU, hUo, hbU⟩ := eventually_nhds_iff.mp (h.and ht)
  exact ⟨U, hUo, hbU, fun y hy => (hU y hy).2, fun y hy => (hU y hy).1⟩

variable [FiniteDimensional ℝ Q]

/-- From actual analyticity and actual surjectivity alone, construct a full
analytic local chart retaining the literal second variable in both directions.
No local inverse, complement, Jacobian or loss factorization is supplied. -/
theorem exists_retained_analytic_chart
    (u : G × X → Q) (hu : ContDiff ℝ ω u) (hu0 : u 0 = 0)
    (hsurj : Function.Surjective (gaugeDerivative (fderiv ℝ u 0))) :
    ∃ (s : Q →L[ℝ] G)
      (hs : Function.RightInverse s (gaugeDerivative (fderiv ℝ u 0)))
      (e : OpenPartialHomeomorph (G × X) ((Q × Kernel (fderiv ℝ u 0)) × X)),
      (e : G × X → (Q × Kernel (fderiv ℝ u 0)) × X) =
        coordinateMap u (fderiv ℝ u 0) s hs ∧
      0 ∈ e.source ∧ 0 ∈ e.target ∧
      (∀ p : G × X, AnalyticAt ℝ e p) ∧
      (∀ y ∈ e.target, (e.symm y).2 = y.2 ∧ u (e.symm y) = y.1.1) ∧
      (∃ U : Set ((Q × Kernel (fderiv ℝ u 0)) × X),
        IsOpen U ∧ 0 ∈ U ∧ U ⊆ e.target ∧
          ∀ y ∈ U, AnalyticAt ℝ e.symm y) := by
  obtain ⟨s, hs⟩ := exists_rightInverse (fderiv ℝ u 0) hsurj
  have hstrict : HasStrictFDerivAt u (fderiv ℝ u 0) 0 :=
    hu.hasStrictFDerivAt (by simp)
  have hz : (((0 : Q), (0 : Kernel (fderiv ℝ u 0))), (0 : X)) = 0 := by
    ext <;> simp
  let e := retainedChart u (fderiv ℝ u 0) s hs hstrict
  refine ⟨s, hs, e, rfl, zero_mem_source u _ s hs hstrict, ?_, ?_, ?_, ?_⟩
  · simpa only [e, hu0, hz] using base_mem_target u _ s hs hstrict
  · intro p
    exact ((contDiff_coordinateMap u _ s hs hu).contDiffAt).analyticAt
  · intro y hy
    exact ⟨inverse_retains u _ s hs hstrict y hy, inverse_regular u _ s hs hstrict y hy⟩
  · simpa only [e, hu0, hz] using
      exists_open_analytic_inverse_neighborhood u _ s hs hstrict hu.contDiffAt

end MAIS.Run2ParameterRetainingAnalytic

/-- info: 'MAIS.Run2ParameterRetainingAnalytic.analyticAt_inverse_base' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingAnalytic.analyticAt_inverse_base

/-- info: 'MAIS.Run2ParameterRetainingAnalytic.exists_open_analytic_inverse_neighborhood' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingAnalytic.exists_open_analytic_inverse_neighborhood

/-- info: 'MAIS.Run2ParameterRetainingAnalytic.exists_retained_analytic_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ParameterRetainingAnalytic.exists_retained_analytic_chart
end
end
-- ==================== end module O7.Run2ParameterRetainingAnalytic ====================

-- ==================== begin module O7.Run2PositiveEndpointRegular (formalization/O7/Run2PositiveEndpointRegular.lean) ====================
section

/-! Actual regular endpoint coordinates and their surjectivity on the genuine
orbit-direction complement. The network has positive depth; no full-product
surjectivity or guessed normal form is assumed. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace MAIS.Run2PositiveEndpointRegular
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.OrbitSliceChart MAIS.Run2PositivePathDerivative
open scoped Matrix Matrix.Norms.Frobenius ContDiff
variable {R M N : Type*} [Fintype R] [Fintype M] [Fintype N]
  [DecidableEq R] [DecidableEq M] [DecidableEq N]

abbrev RegularSpace (R M N : Type*) :=
  Matrix R R ℝ × (Matrix R N ℝ × Matrix M R ℝ)

/-- Literal regular blocks of the output matrix. -/
def regularBlocks : Matrix (R ⊕ M) (R ⊕ N) ℝ →L[ℝ] RegularSpace R M N :=
  ({toFun := fun Y => (Y.toBlocks₁₁,(Y.toBlocks₁₂,Y.toBlocks₂₁))
    map_add' := fun _ _ => rfl
    map_smul' := fun _ _ => rfl} :
      Matrix (R ⊕ M) (R ⊕ N) ℝ →ₗ[ℝ] RegularSpace R M N).toContinuousLinearMap

omit [DecidableEq R] [DecidableEq M] [DecidableEq N] in
@[simp] theorem regularBlocks_apply (Y : Matrix (R ⊕ M) (R ⊕ N) ℝ) :
    regularBlocks Y = (Y.toBlocks₁₁,(Y.toBlocks₁₂,Y.toBlocks₂₁)) := rfl

/-- The actual rank-r standard target, including r=0 and empty complements. -/
def standardTarget : Matrix (R ⊕ M) (R ⊕ N) ℝ :=
  Matrix.fromBlocks 1 0 0 0

variable {D : ℕ} (κ : Fin (D+1) → Type*)
  [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]
abbrev Carrier := fun v => R ⊕ κ v

omit [∀ v, DecidableEq (κ v)] in
/-- Actual endpoint Lie directions prescribe every regular block independently.
The separate endpoints are essential: D=0 is deliberately excluded. -/
theorem endpoint_regular_surjective (hD : 0 < D) :
    Function.Surjective (fun η : Lie (Carrier (R:=R) κ) =>
      regularBlocks (R:=R) (M:=κ (Fin.last D)) (N:=κ 0) (η (Fin.last D) *
        (standardTarget : Matrix (R ⊕ κ (Fin.last D)) (R ⊕ κ 0) ℝ) -
          (standardTarget : Matrix (R ⊕ κ (Fin.last D)) (R ⊕ κ 0) ℝ) * η 0)) := by
  rintro ⟨q11,q12,q21⟩
  let out : Matrix (R ⊕ κ (Fin.last D)) (R ⊕ κ (Fin.last D)) ℝ :=
    Matrix.fromBlocks q11 0 q21 0
  let inp : Matrix (R ⊕ κ 0) (R ⊕ κ 0) ℝ :=
    Matrix.fromBlocks 0 (-q12) 0 0
  let η : Lie (Carrier (R:=R) κ) := Pi.single (Fin.last D) out + Pi.single 0 inp
  have hne : Fin.last D ≠ (0 : Fin (D+1)) := by
    intro h
    have := congrArg Fin.val h
    simp only [Fin.val_last,Fin.val_zero] at this
    omega
  refine ⟨η, ?_⟩
  have ho : η (Fin.last D) = out := by simp [η,hne]
  have hi : η 0 = inp := by simp [η,Ne.symm hne]
  simp only []
  rw [ho,hi]
  simp [out,inp,standardTarget,regularBlocks,Matrix.fromBlocks_multiply,
    Matrix.toBlocks₁₁,Matrix.toBlocks₁₂,Matrix.toBlocks₂₁,Matrix.of]
  exact ⟨rfl,rfl,rfl⟩

omit [DecidableEq R] [∀ v, DecidableEq (κ v)] in
/-- Genuine projection to an orbit-direction complement preserves the actual
arrow derivative. No independently supplied endpoint map is substituted. -/
theorem exists_complement_same_differential
    (A : Rep (Carrier (R:=R) κ))
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (Carrier (R:=R) κ) A).ker)
    (η : Lie (Carrier (R:=R) κ)) :
    ∃ h : H, orbitDifferential (Carrier (R:=R) κ) A (h : Lie _) =
      orbitDifferential (Carrier (R:=R) κ) A η := by
  let E := (orbitDifferential (Carrier (R:=R) κ) A).kerComplementEquivRange hH
  let y : (orbitDifferential (Carrier (R:=R) κ) A).range :=
    ⟨orbitDifferential (Carrier (R:=R) κ) A η,η,rfl⟩
  refine ⟨E.symm y, ?_⟩
  exact congrArg Subtype.val (E.apply_symm_apply y)

/-- Actual regular product derivative is onto even after restriction to the
actual gauge complement of the stabilizer. -/
theorem regular_path_derivative_surjective
    (hD : 0 < D) (A : Rep (Carrier (R:=R) κ))
    (hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _) = standardTarget)
    (H : Submodule ℝ (Lie (Carrier (R:=R) κ)))
    (hH : IsCompl H (orbitDifferential (Carrier (R:=R) κ) A).ker) :
    Function.Surjective (fun h : H => regularBlocks (R:=R) (M:=κ (Fin.last D)) (N:=κ 0)
      (fderiv ℝ (fun B : Rep (Carrier (R:=R) κ) =>
        pathMatrix B 0 (Fin.last D) (Fin.zero_le _)) A
          (orbitDifferential (Carrier (R:=R) κ) A (h : Lie _)))) := by
  intro q
  obtain ⟨η,hη⟩ := endpoint_regular_surjective (R:=R) κ hD q
  obtain ⟨h,hh⟩ := exists_complement_same_differential κ A H hH η
  refine ⟨h, ?_⟩
  simp only []
  rw [hh, fderiv_path_orbitDifferential, hA]
  exact hη

end MAIS.Run2PositiveEndpointRegular

/-- info: 'MAIS.Run2PositiveEndpointRegular.endpoint_regular_surjective' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveEndpointRegular.endpoint_regular_surjective

/-- info: 'MAIS.Run2PositiveEndpointRegular.exists_complement_same_differential' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveEndpointRegular.exists_complement_same_differential

/-- info: 'MAIS.Run2PositiveEndpointRegular.regular_path_derivative_surjective' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveEndpointRegular.regular_path_derivative_surjective
end
end
-- ==================== end module O7.Run2PositiveEndpointRegular ====================

-- ==================== begin module O7.Run2SchurOutputCoordinates (formalization/O7/Run2SchurOutputCoordinates.lean) ====================
section

/-! Genuine nonlinear Schur output coordinates, their literal inverse, and
analytic regularity at the fixed rank-r output. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Matrix
open scoped Matrix Matrix.Norms.Frobenius ContDiff Topology
namespace MAIS.Run2SchurOutputCoordinates
open MAIS.Run2SchurRectangular MAIS.Run2PositiveEndpointRegular
variable {R M N : Type*} [Fintype R] [Fintype M] [Fintype N]
  [DecidableEq R] [DecidableEq M] [DecidableEq N]
abbrev Output := Matrix (R ⊕ M) (R ⊕ N) ℝ
abbrev Coordinate := RegularSpace R M N × Matrix M N ℝ

def coordinates (Y : Output (R:=R) (M:=M) (N:=N)) : Coordinate (R:=R) (M:=M) (N:=N) :=
  ((Y.toBlocks₁₁-1,(Y.toBlocks₁₂,Y.toBlocks₂₁)),schur Y)

def inverseCoordinates (p : Coordinate (R:=R) (M:=M) (N:=N)) : Output (R:=R) (M:=M) (N:=N) :=
  fromBlocks (1+p.1.1) p.1.2.1 p.1.2.2
    (p.2+p.1.2.2*(1+p.1.1)⁻¹*p.1.2.1)

omit [Fintype M] [Fintype N] [DecidableEq M] [DecidableEq N] in
/-- These algebraic maps are inverse even off the invertible-leading-block
locus; only their local analytic regularity requires the unit neighborhood. -/
theorem coordinates_inverse (p : Coordinate (R:=R) (M:=M) (N:=N)) :
    coordinates (inverseCoordinates p) = p := by
  rcases p with ⟨⟨A,B,C⟩,S⟩
  simp [coordinates,inverseCoordinates,schur_fromBlocks]

omit [Fintype M] [Fintype N] [DecidableEq M] [DecidableEq N] in
theorem inverse_coordinates (Y : Output (R:=R) (M:=M) (N:=N)) :
    inverseCoordinates (coordinates Y) = Y := by
  simp only [coordinates,inverseCoordinates,schur]
  have h : (1 : Matrix R R ℝ) + (Y.toBlocks₁₁-1) = Y.toBlocks₁₁ := by abel
  rw [h,sub_add_cancel]
  exact Matrix.fromBlocks_toBlocks Y

omit [Fintype M] [Fintype N] [DecidableEq M] [DecidableEq N] in
@[simp] theorem coordinates_target :
    coordinates (standardTarget : Output (R:=R) (M:=M) (N:=N)) = 0 := by
  simp [coordinates,standardTarget,schur_fromBlocks]

omit [Fintype M] [Fintype N] [DecidableEq M] [DecidableEq N] in
@[simp] theorem inverseCoordinates_zero :
    inverseCoordinates (0 : Coordinate (R:=R) (M:=M) (N:=N)) = standardTarget := by
  simp [inverseCoordinates,standardTarget]

omit [DecidableEq M] [DecidableEq N] in
/-- The regular output coordinates are literally the linear regular blocks
of the actual output minus the actual standard target. -/
theorem coordinates_regular_eq (Y : Output (R:=R) (M:=M) (N:=N)) :
    (coordinates Y).1 = regularBlocks (Y-standardTarget) := by
  rw [map_sub]
  simp only [coordinates,regularBlocks_apply,standardTarget,toBlocks_fromBlocks₁₁,
    toBlocks_fromBlocks₁₂,toBlocks_fromBlocks₂₁]
  simp

/-- The true product norm and the sum of component squares are uniformly
comparable with dimension-independent constants. -/
theorem norm_prod_squared_bounds {E F : Type*} [SeminormedAddCommGroup E]
    [SeminormedAddCommGroup F] (p : E × F) :
    ‖p‖^2 ≤ ‖p.1‖^2+‖p.2‖^2 ∧ ‖p.1‖^2+‖p.2‖^2 ≤ 2*‖p‖^2 := by
  rw [Prod.norm_def]
  rcases le_total ‖p.1‖ ‖p.2‖ with h | h
  · rw [max_eq_right h]
    have hs := (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr h
    constructor <;> nlinarith [sq_nonneg ‖p.1‖,sq_nonneg ‖p.2‖]
  · rw [max_eq_left h]
    have hs := (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr h
    constructor <;> nlinarith [sq_nonneg ‖p.1‖,sq_nonneg ‖p.2‖]

/-- The actual nonsingular matrix inverse is analytic at every actual unit,
including a zero-dimensional square matrix. -/
theorem contDiffAt_matrix_inverse {K : Type*} [Fintype K] [DecidableEq K]
    (A : Matrix K K ℝ) (hA : IsUnit A) :
    ContDiffAt ℝ ω (fun B : Matrix K K ℝ => B⁻¹) A := by
  obtain ⟨a,rfl⟩ := hA
  simpa only [Matrix.nonsing_inv_eq_ringInverse] using
    (contDiffAt_ringInverse ℝ a : ContDiffAt ℝ ω Ring.inverse (a : Matrix K K ℝ))

/-- Actual finite entry restriction as a continuous linear map. -/
def submatrixCLM {I J K L : Type*} [Fintype I] [Fintype J] [Fintype K] [Fintype L]
    (f : K → I) (g : L → J) : Matrix I J ℝ →L[ℝ] Matrix K L ℝ :=
  ({toFun := fun Y => Y.submatrix f g
    map_add' := fun _ _ => rfl
    map_smul' := fun _ _ => rfl} : Matrix I J ℝ →ₗ[ℝ] Matrix K L ℝ).toContinuousLinearMap

/-- Actual block assembly as a continuous linear map. -/
def assemble : Coordinate (R:=R) (M:=M) (N:=N) →L[ℝ] Output (R:=R) (M:=M) (N:=N) :=
  ({toFun := fun p => fromBlocks p.1.1 p.1.2.1 p.1.2.2 p.2
    map_add' := by intro p q; ext i j; cases i <;> cases j <;> rfl
    map_smul' := by intro c p; ext i j; cases i <;> cases j <;> rfl} :
      Coordinate (R:=R) (M:=M) (N:=N) →ₗ[ℝ] Output (R:=R) (M:=M) (N:=N)).toContinuousLinearMap

omit [DecidableEq M] [DecidableEq N] in
/-- Literal Schur coordinates are analytic at every output with invertible
leading block; this is an actual inverse operation, not a formal symbol. -/
theorem contDiffAt_coordinates (Y : Output (R:=R) (M:=M) (N:=N))
    (hY : IsUnit Y.toBlocks₁₁) : ContDiffAt ℝ ω coordinates Y := by
  have h11 : ContDiffAt ℝ ω (fun Z : Output (R:=R) (M:=M) (N:=N) => Z.toBlocks₁₁) Y :=
    (submatrixCLM (I:=R⊕M) (J:=R⊕N) (K:=R) (L:=R) Sum.inl Sum.inl).contDiff.contDiffAt
  have h12 : ContDiffAt ℝ ω (fun Z : Output (R:=R) (M:=M) (N:=N) => Z.toBlocks₁₂) Y :=
    (submatrixCLM (I:=R⊕M) (J:=R⊕N) (K:=R) (L:=N) Sum.inl Sum.inr).contDiff.contDiffAt
  have h21 : ContDiffAt ℝ ω (fun Z : Output (R:=R) (M:=M) (N:=N) => Z.toBlocks₂₁) Y :=
    (submatrixCLM (I:=R⊕M) (J:=R⊕N) (K:=M) (L:=R) Sum.inr Sum.inl).contDiff.contDiffAt
  have h22 : ContDiffAt ℝ ω (fun Z : Output (R:=R) (M:=M) (N:=N) => Z.toBlocks₂₂) Y :=
    (submatrixCLM (I:=R⊕M) (J:=R⊕N) (K:=M) (L:=N) Sum.inr Sum.inr).contDiff.contDiffAt
  have hi := (contDiffAt_matrix_inverse Y.toBlocks₁₁ hY).comp Y h11
  exact ((h11.sub contDiffAt_const).prodMk (h12.prodMk h21)).prodMk
    (h22.sub (MAIS.MatrixSmoothMul.contDiffAt_matrix_mul
      (MAIS.MatrixSmoothMul.contDiffAt_matrix_mul h21 hi) h12))

omit [DecidableEq M] [DecidableEq N] in
/-- The literal inverse output coordinate map is analytic at zero. -/
theorem contDiffAt_inverseCoordinates_zero :
    ContDiffAt ℝ ω (inverseCoordinates : Coordinate (R:=R) (M:=M) (N:=N) → Output) 0 := by
  have h11 : ContDiffAt ℝ ω (fun p : Coordinate (R:=R) (M:=M) (N:=N) => p.1.1) 0 := by fun_prop
  have h12 : ContDiffAt ℝ ω (fun p : Coordinate (R:=R) (M:=M) (N:=N) => p.1.2.1) 0 := by fun_prop
  have h21 : ContDiffAt ℝ ω (fun p : Coordinate (R:=R) (M:=M) (N:=N) => p.1.2.2) 0 := by fun_prop
  have h22 : ContDiffAt ℝ ω (fun p : Coordinate (R:=R) (M:=M) (N:=N) => p.2) 0 := by fun_prop
  have hi0 : ContDiffAt ℝ ω (fun B : Matrix R R ℝ => B⁻¹)
      ((1 : Matrix R R ℝ)+(0 : Coordinate (R:=R) (M:=M) (N:=N)).1.1) := by
    simpa only [Prod.fst_zero,add_zero] using
      contDiffAt_matrix_inverse (1 : Matrix R R ℝ) isUnit_one
  have hplus : ContDiffAt ℝ ω (fun p : Coordinate (R:=R) (M:=M) (N:=N) => (1:Matrix R R ℝ)+p.1.1) 0 :=
    contDiffAt_const.add h11
  have hi : ContDiffAt ℝ ω (fun p : Coordinate (R:=R) (M:=M) (N:=N) => (1+p.1.1)⁻¹) 0 :=
    hi0.comp (0 : Coordinate (R:=R) (M:=M) (N:=N)) hplus
  have hD := h22.add (MAIS.MatrixSmoothMul.contDiffAt_matrix_mul
    (MAIS.MatrixSmoothMul.contDiffAt_matrix_mul h21 hi) h12)
  exact assemble.contDiff.contDiffAt.comp 0
    ((hplus.prodMk (h12.prodMk h21)).prodMk hD)

omit [DecidableEq M] [DecidableEq N] in
/-- The actual Schur output coordinate map and its actual inverse derive
uniform two-sided squared-norm bounds near the fixed rank-r target. -/
theorem exists_output_squared_comparison :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ Y : Output (R:=R) (M:=M) (N:=N) in 𝓝 standardTarget,
      ‖Y-standardTarget‖^2/C ≤ ‖coordinates Y‖^2 ∧
        ‖coordinates Y‖^2 ≤ C * ‖Y-standardTarget‖^2 := by
  have hunit : IsUnit (standardTarget : Output (R:=R) (M:=M) (N:=N)).toBlocks₁₁ := by
    simpa only [standardTarget,toBlocks_fromBlocks₁₁] using
      (isUnit_one : IsUnit (1 : Matrix R R ℝ))
  simpa only [sub_zero] using
    MAIS.Run2PositiveLocalNormComparison.exists_squared_comparison
      (coordinates : Output (R:=R) (M:=M) (N:=N) → Coordinate) inverseCoordinates
      standardTarget 0 ((contDiffAt_coordinates standardTarget hunit).differentiableAt (by simp))
      (contDiffAt_inverseCoordinates_zero.differentiableAt (by simp))
      coordinates_target inverseCoordinates_zero (Filter.Eventually.of_forall inverse_coordinates)

omit [DecidableEq M] [DecidableEq N] in
/-- Actual matrix loss is uniformly equivalent to the sum of the literal
regular-block norm square and literal Schur-residual Frobenius square. -/
theorem exists_output_loss_comparison :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ Y : Output (R:=R) (M:=M) (N:=N) in 𝓝 standardTarget,
      (‖(coordinates Y).1‖^2+‖schur Y‖^2)/C ≤ ‖Y-standardTarget‖^2 ∧
      ‖Y-standardTarget‖^2 ≤ C*(‖(coordinates Y).1‖^2+‖schur Y‖^2) := by
  obtain ⟨C,hC,h⟩ := exists_output_squared_comparison (R:=R) (M:=M) (N:=N)
  refine ⟨2*C,by positivity, ?_⟩
  filter_upwards [h] with Y hY
  have hb := norm_prod_squared_bounds (coordinates Y)
  have hsum : 0 ≤ ‖(coordinates Y).1‖^2+‖schur Y‖^2 := by positivity
  have hb' : ‖(coordinates Y).1‖^2+‖schur Y‖^2 ≤ 2*‖coordinates Y‖^2 := hb.2
  have hl : ‖Y-standardTarget‖^2 ≤ C*‖coordinates Y‖^2 :=
    (div_le_iff₀ hC).mp hY.1 |>.trans_eq (mul_comm _ _)
  constructor
  · apply (div_le_iff₀ (by positivity : 0 < 2*C)).mpr
    exact hb'.trans (by nlinarith [mul_le_mul_of_nonneg_left hY.2 (by norm_num : (0:ℝ)≤2)])
  · calc
      _ ≤ C*‖coordinates Y‖^2 := hl
      _ ≤ C*(‖(coordinates Y).1‖^2+‖schur Y‖^2) :=
        mul_le_mul_of_nonneg_left hb.1 hC.le
      _ ≤ _ := by nlinarith

end MAIS.Run2SchurOutputCoordinates

