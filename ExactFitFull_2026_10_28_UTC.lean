-- ==================== begin module O7.ActiveIntervalStrictGenerization (formalization/O7/ActiveIntervalStrictGenerization.lean) ====================
section

/-! Actual strict rank generization everywhere on the full physical affine
normal slice, derived from actual minors, the inverse function theorem and
an actual positive gauge contraction. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000
noncomputable section
open Set Filter
open scoped Topology Matrix
namespace MAIS.ActiveIntervalStrictGenerization
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalEndpointRows MAIS.ActiveIntervalRankMinors
open MAIS.ActiveIntervalNormalContraction MAIS.MatrixChainIsomorphism
open MAIS.QuiverRealOrbit MAIS.QuiverOrbitRank
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D+1)

/-- The actual local rank-minor isolation upgrades globally because every
    positive contraction point remains in the actual same matrix orbit. -/
theorem eq_zero_of_path_rank_le (t : NormalParams birth death)
    (hrank : ∀ i j (hij:i≤j),
      (pathMatrix (normalFamily D birth death hD t) i j hij).rank ≤
      (pathMatrix (intervalRep D birth death) i j hij).rank) : t=0 := by
  obtain ⟨U,hU,hlocal⟩ := local_eq_zero_of_path_rank_le D birth death hD
  have hc : Tendsto (fun r : ℝ => dilation birth death r t)
      (nhdsWithin 0 (Ioi 0)) (nhds (0:NormalParams birth death)) := by
    have ht := (continuous_dilation birth death t).tendsto (0:ℝ)
    rw [dilation_zero] at ht
    exact ht.mono_left nhdsWithin_le_nhds
  have he : ∀ᶠ r : ℝ in nhdsWithin 0 (Ioi 0),
      0<r ∧ dilation birth death r t∈U :=
    (show ∀ᶠ r : ℝ in nhdsWithin 0 (Ioi 0), 0<r from self_mem_nhdsWithin).and
      (hc.eventually hU)
  obtain ⟨r,hr,hru⟩ := he.exists
  have hd : dilation birth death r t=0 := by
    apply hlocal _ hru
    intro i j hij
    obtain ⟨g,hg⟩ := MulAction.mem_orbit_iff.mp
      (normalFamily_dilation_mem_orbit birth death D hD t r hr)
    rw [← hg,path_rank_gauge]
    exact hrank i j hij
  funext p
  have hp := congrFun hd p
  change r ^ heightWeight birth death p * t p = 0 at hp
  exact (mul_eq_zero.mp hp).resolve_left (pow_ne_zero _ (ne_of_gt hr))

/-- Every nonzero actual normal coordinate has some strictly increased
    actual consecutive-path matrix rank, globally on the affine slice. -/
theorem exists_path_rank_strict (t : NormalParams birth death) (ht:t≠0) :
    ∃ i j, ∃ hij:i≤j,
      (pathMatrix (intervalRep D birth death) i j hij).rank <
      (pathMatrix (normalFamily D birth death hD t) i j hij).rank := by
  by_contra h
  apply ht
  apply eq_zero_of_path_rank_le D birth death hD t
  intro i j hij
  by_contra hn
  exact h ⟨i,j,hij,Nat.lt_of_not_ge hn⟩

/-- Equal actual path ranks recover only the actual base point in this
    physical entrance slice. -/
theorem path_rank_eq_iff (t : NormalParams birth death) :
    (∀ i j (hij:i≤j),
      (pathMatrix (normalFamily D birth death hD t) i j hij).rank =
      (pathMatrix (intervalRep D birth death) i j hij).rank) ↔ t=0 := by
  constructor
  · intro h
    exact eq_zero_of_path_rank_le D birth death hD t (fun i j hij => (h i j hij).le)
  · rintro rfl
    intro i j hij
    rw [MAIS.ActiveIntervalPathDerivative.normalFamily_zero]

/-- The entire literal affine normal slice meets the actual real gauge
    orbit of its interval base at exactly its origin. -/
theorem mem_base_orbit_iff (t : NormalParams birth death) :
    normalFamily D birth death hD t∈MulAction.orbit (Gauge (Index D birth death))
      (intervalRep D birth death) ↔ t=0 := by
  constructor
  · intro h
    obtain ⟨g,hg⟩ := MulAction.mem_orbit_iff.mp h
    apply eq_zero_of_path_rank_le D birth death hD t
    intro i j hij
    rw [← hg,path_rank_gauge]
  · rintro rfl
    rw [MAIS.ActiveIntervalPathDerivative.normalFamily_zero]
    exact MulAction.mem_orbit_self _

/-- Every nonzero point gives a genuine strict real orbit generization,
    with all path ranks weakly increased and at least one strictly increased. -/
theorem strict_generization (t : NormalParams birth death) (ht:t≠0) :
    intervalRep D birth death∈closure
      (MulAction.orbit (Gauge (Index D birth death)) (normalFamily D birth death hD t)) ∧
    normalFamily D birth death hD t∉MulAction.orbit (Gauge (Index D birth death))
      (intervalRep D birth death) ∧
    (∀ i j (hij:i≤j),
      (pathMatrix (intervalRep D birth death) i j hij).rank ≤
      (pathMatrix (normalFamily D birth death hD t) i j hij).rank) ∧
    (∃ i j, ∃ hij:i≤j,
      (pathMatrix (intervalRep D birth death) i j hij).rank <
      (pathMatrix (normalFamily D birth death hD t) i j hij).rank) :=
  ⟨intervalRep_mem_closure_orbit_normalFamily birth death D hD t,
    fun h => ht ((mem_base_orbit_iff D birth death hD t).mp h),
    path_rank_base_le_normalFamily birth death D hD t,
    exists_path_rank_strict D birth death hD t ht⟩

end MAIS.ActiveIntervalStrictGenerization
end

/-- info: 'MAIS.ActiveIntervalStrictGenerization.eq_zero_of_path_rank_le' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalStrictGenerization.eq_zero_of_path_rank_le

/-- info: 'MAIS.ActiveIntervalStrictGenerization.exists_path_rank_strict' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalStrictGenerization.exists_path_rank_strict

/-- info: 'MAIS.ActiveIntervalStrictGenerization.path_rank_eq_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalStrictGenerization.path_rank_eq_iff

/-- info: 'MAIS.ActiveIntervalStrictGenerization.mem_base_orbit_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalStrictGenerization.mem_base_orbit_iff

/-- info: 'MAIS.ActiveIntervalStrictGenerization.strict_generization' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalStrictGenerization.strict_generization
end
