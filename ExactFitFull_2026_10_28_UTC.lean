-- ==================== begin module O7.Run2ArithmeticCriticalPathBellman (formalization/O7/Run2ArithmeticCriticalPathBellman.lean) ====================
section

/-! Actual measured Bellman laws on the independently executable arithmetic
graph. Successors are derived from actual measured higher witnesses and then
encoded as bounded arrays; none is assumed as graph data. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3200000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2ArithmeticCriticalPathBellman
open MAIS.Run2BarcodeEnumerationData MAIS.Run2ArithmeticCriticalPathData
open MAIS.Run2ArithmeticCriticalPathRealization MAIS.Run2ArithmeticCriticalPathMeasuredStep
open MAIS.Run2BarcodeEnumeration MAIS.Run2BarcodeEnumerationEncoding
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitFiniteHeight
open MAIS.BarcodeActiveNormalForm MAIS.QuiverOrbitRank MAIS.QuiverGaugeMeasuredPair
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]
variable (ν : Finset (Multiplicities D (dimensionSum ι)))
  (hν : ν = candidates (architecture ι) (fun _ _ => 0))

theorem edge_multiplicity_le
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    {h k : Node ν} (he : nodeEdge ν h k) :
    nodeMultiplicity ι ν hν mu k + nodeWeight ν h ≤ nodeMultiplicity ι ν hν mu h := by
  have hkp := node_pair ι ν hν mu k
  have hc : coefficient ν k.val = coefficient ν h.val := he.2.symm
  rw [hc] at hkp
  have hh := higher_multiplicity_le ι mu (nodeRep ι ν hν h) (nodeRep ι ν hν k)
    (nodeNormalForm ι ν hν h) (nodeRep_zero ι ν hν h) (node_higher_of_edge ι ν hν he)
    (node_pair ι ν hν mu h) hkp
  rw [← node_weight ι ν hν h] at hh
  exact hh

/-- Strictness of actual ordinary real orbit closure is strictness in at
least one counted consecutive path, rather than inequality of labels. -/
theorem rankLT_of_actual_higher {h k : Node ν}
    (hc : nodeRep ι ν hν h ∈ closure (MulAction.orbit (Gauge ι) (nodeRep ι ν hν k)))
    (hn : nodeRep ι ν hν k ∉ MulAction.orbit (Gauge ι) (nodeRep ι ν hν h)) :
    RankLT h.val k.val := by
  have hle : RankLE h.val k.val := by
    intro i j hij
    rw [← nodeRep_rank ι ν hν h i j hij, ← nodeRep_rank ι ν hν k i j hij]
    exact path_rank_le_of_mem_closure_orbit hc i j hij
  refine ⟨hle, ?_⟩
  by_contra hstrict
  apply hn
  apply MAIS.MatrixChainIsomorphism.mem_gauge_orbit_of_path_rank_eq
  intro i j hij
  rw [nodeRep_rank, nodeRep_rank]
  apply Nat.le_antisymm (hle i j hij)
  exact Nat.le_of_not_gt (fun hh => hstrict ⟨i, j, hij, hh⟩)

/-- Every actual multiplicity larger than one has an attained arithmetic
successor satisfying equality in the Bellman bound. -/
theorem exists_maximizing_edge
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (h : Node ν) (hmgt : 1 < nodeMultiplicity ι ν hν mu h) :
    ∃ k : Node ν, nodeEdge ν h k ∧
      nodeMultiplicity ι ν hν mu h = nodeMultiplicity ι ν hν mu k + nodeWeight ν h := by
  obtain ⟨B, n, hB, hBp, hm⟩ := exists_maximizing_higher ι mu (nodeRep ι ν hν h)
    (nodeNormalForm ι ν hν h) (nodeRep_zero ι ν hν h) (node_pair ι ν hν mu h) hmgt
  let N : ActiveNormalForm B := Classical.choice (exists_normal_form B)
  have hkν : encode N ∈ ν := by
    rw [hν, mem_candidates]
    refine ⟨encode_valid N, encode_vertexCount N, ?_, fun _ _ _ => Nat.zero_le _⟩
    rw [encode_pathCount N 0 (Fin.last D) (Nat.zero_le D), hB.1, Matrix.rank_zero]
  let k : Node ν := ⟨encode N, hkν⟩
  have hkgauge : nodeRep ι ν hν k ∈ MulAction.orbit (Gauge ι) B := by
    apply MAIS.MatrixChainIsomorphism.mem_gauge_orbit_of_path_rank_eq B (nodeRep ι ν hν k)
    intro i j hij
    rw [nodeRep_rank]
    exact (encode_pathCount N i j hij).symm
  obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp hkgauge
  have hkp := (pair_iff_gauge_zero ι mu mu g B 0 (Fin.last D) (Nat.zero_le D)
    hB.1 ((coefficient ν h.val : ℝ) / 2) n).mp hBp
  rw [hg] at hkp
  have hvalues := O77.PowerLogUniqueness.radius_order_unique hkp (node_pair ι ν hν mu k)
  have hcoef : coefficient ν h.val = coefficient ν k.val := by
    have hc : (coefficient ν h.val : ℝ) = (coefficient ν k.val : ℝ) := by linarith [hvalues.1]
    exact_mod_cast hc
  have hcl : nodeRep ι ν hν h ∈
      closure (MulAction.orbit (Gauge ι) (nodeRep ι ν hν k)) :=
    closure_orbit_trans hB.2.1 (subset_closure (MulAction.mem_orbit_symm.mp hkgauge))
  have hnot : nodeRep ι ν hν k ∉ MulAction.orbit (Gauge ι) (nodeRep ι ν hν h) := by
    intro hh
    apply hB.2.2
    exact MulAction.mem_orbit_trans (MulAction.mem_orbit_symm.mp hkgauge) hh
  refine ⟨k, ⟨rankLT_of_actual_higher ι ν hν hcl hnot, hcoef⟩, ?_⟩
  rw [← node_weight ι ν hν h] at hm
  simpa only [hvalues.2] using hm

end MAIS.Run2ArithmeticCriticalPathBellman

/-- info: 'MAIS.Run2ArithmeticCriticalPathBellman.edge_multiplicity_le' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathBellman.edge_multiplicity_le

/-- info: 'MAIS.Run2ArithmeticCriticalPathBellman.exists_maximizing_edge' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathBellman.exists_maximizing_edge
end
end
-- ==================== end module O7.Run2ArithmeticCriticalPathBellman ====================

-- ==================== begin module O7.Run2ArithmeticCriticalPath (formalization/O7/Run2ArithmeticCriticalPath.lean) ====================
section

/-! The actual zero-output measured pair is computed by finite integer
incidence minimization and exact-rational weighted longest-path evaluation.
All arithmetic definitions precede the actual measured correctness proof. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3200000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2ArithmeticCriticalPath
open MAIS.Run2BarcodeEnumerationData MAIS.Run2ArithmeticCriticalPathData
open MAIS.Run2ArithmeticCriticalPathRealization MAIS.Run2ArithmeticCriticalPathBellman
open MAIS.Run2ArithmeticCriticalPathMeasuredStep MAIS.Run2ArithmeticCriticalPathDynamic
open MAIS.Run2BarcodeEnumeration MAIS.Run2BarcodeEnumerationEncoding
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitFiniteHeight
open MAIS.BarcodeActiveNormalForm MAIS.QuiverZeroFinitePairTable MAIS.QuiverGaugeMeasuredPair
open MAIS.AnalyticTransfer
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]
variable (ν : Finset (Multiplicities D (dimensionSum ι)))
  (hν : ν = candidates (architecture ι) (fun _ _ => 0))
include hν

theorem node_multiplicity_eq
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (h : Node ν) :
    nodeMultiplicity ι ν hν mu h = 1 + criticalDepth ν h := by
  have hd := depthFuel_eq_of_bellman (nodeEdge ν) (nodeWeight ν)
    (fun k : Node ν => defect k.val) (nodeMultiplicity ι ν hν mu)
    (node_multiplicity_pos ι ν hν mu)
    (fun _ _ he => edge_multiplicity_le ι ν hν mu he)
    (exists_maximizing_edge ι ν hν mu)
    (fun _ _ he => node_defect_progress ι ν hν he)
    (capacity D (dimensionSum ι)) h (Nat.sub_le _ _)
  have hm := node_multiplicity_pos ι ν hν mu h
  change criticalDepth ν h = nodeMultiplicity ι ν hν mu h - 1 at hd
  omega

/-- The finite evaluator agrees with the independently defined maximum
over genuine finite arithmetic graph paths, including its terminal-zero
convention. This equality is derived, not used to define the evaluator. -/
theorem criticalDepth_eq_pathMaximum (h : Node ν) :
    criticalDepth ν h = MAIS.Run2PotentialWeightedPaths.criticalDepth
      (nodeEdge ν) (nodeWeight ν) h := by
  let mu : Measure (Rep ι) := addHaar
  exact depthFuel_eq_criticalDepth_of_bellman (nodeEdge ν) (nodeWeight ν)
    (fun k : Node ν => defect k.val) (nodeMultiplicity ι ν hν mu)
    (node_multiplicity_pos ι ν hν mu)
    (fun _ _ he => edge_multiplicity_le ι ν hν mu he)
    (exists_maximizing_edge ι ν hν mu)
    (fun _ _ he => node_defect_progress ι ν hν he)
    (capacity D (dimensionSum ι)) h (Nat.sub_le _ _)

theorem node_pair_iff
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (h : Node ν) (lam : ℝ) (m : ℕ) :
    NativePair ι mu (nodeRep ι ν hν h) lam m ↔
      lam = (coefficient ν h.val : ℝ) / 2 ∧ m = 1 + criticalDepth ν h := by
  constructor
  · intro hp
    have hv := O77.PowerLogUniqueness.radius_order_unique hp (node_pair ι ν hν mu h)
    exact ⟨hv.1, hv.2.trans (node_multiplicity_eq ι ν hν mu h)⟩
  · rintro ⟨rfl, rfl⟩
    rw [← node_multiplicity_eq ι ν hν mu h]
    exact node_pair ι ν hν mu h

/-- Every actual zero-output chain has a source in the finite arithmetic
list with exactly its actual consecutive path ranks. -/
theorem exists_matching_node (A : Rep ι)
    (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    ∃ h : Node ν, ∀ i j (hij : i ≤ j),
      pathCount h.val i j = (pathMatrix A i j hij).rank := by
  let N : ActiveNormalForm A := Classical.choice (exists_normal_form A)
  have hh : encode N ∈ ν := by
    rw [hν, mem_candidates]
    refine ⟨encode_valid N, encode_vertexCount N, ?_, fun _ _ _ => Nat.zero_le _⟩
    rw [encode_pathCount N 0 (Fin.last D) (Nat.zero_le D), hzero, Matrix.rank_zero]
  exact ⟨⟨encode N, hh⟩, fun i j hij => encode_pathCount N i j hij⟩

/-- COMPLETE actual Haar measured pair at any actual zero-output chain,
using any arithmetic source with its supplied exact integer path-rank data.
Only the conversion of an arbitrary real chain to integer ranks is external
to the executable finite arithmetic algorithm. -/
theorem actual_pair_iff_of_matching
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (h : Node ν) (hmatch : ∀ i j (hij : i ≤ j),
      pathCount h.val i j = (pathMatrix A i j hij).rank)
    (lam : ℝ) (m : ℕ) :
    NativePair ι mu A lam m ↔
      lam = (coefficient ν h.val : ℝ) / 2 ∧ m = 1 + criticalDepth ν h := by
  have horb : nodeRep ι ν hν h ∈ MulAction.orbit (Gauge ι) A := by
    apply MAIS.MatrixChainIsomorphism.mem_gauge_orbit_of_path_rank_eq A (nodeRep ι ν hν h)
    intro i j hij
    rw [nodeRep_rank]
    exact (hmatch i j hij).symm
  obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp horb
  have ht := pair_iff_gauge_zero ι mu mu g A 0 (Fin.last D) (Nat.zero_le D) hzero lam m
  rw [hg] at ht
  exact ht.trans (node_pair_iff ι ν hν mu h lam m)

/-- Literal half-squared loss, all original entry Euclidean windows, and an
arbitrary coupled source prior positive and continuous at the center have
the same fully finite arithmetic pair. -/
theorem entry_half_prior_pair_iff_of_matching
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (h : Node ν) (hmatch : ∀ i j (hij : i ≤ j),
      pathCount h.val i j = (pathMatrix A i j hij).rank)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1 / 2 : ℝ) * ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m ↔
      lam = (coefficient ν h.val : ℝ) / 2 ∧ m = 1 + criticalDepth ν h := by
  let z : ZeroFiber ι := ⟨A, hzero⟩
  have hp := pairValue_spec ι mu z
  have hv := (actual_pair_iff_of_matching ι ν hν mu A hzero h hmatch _ _).mp hp
  have ht := entry_half_prior_iff_pairValue ι mu z prior hprior hpos lam m
  simpa only [hv.1, hv.2] using ht

/-- Full proof-free integer-input algorithm: no matching-source witness is
required in this endpoint. The source search, coefficient minimization and
path recursion all occur inside `computedPairs`. -/
theorem actual_pair_iff_computedPairs
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (lam : ℝ) (m : ℕ) :
    NativePair ι mu A lam m ↔
      ∃ c : ℕ, (c, m) ∈ computedPairs ν (pathRankInput ι A) ∧ lam = (c : ℝ) / 2 := by
  constructor
  · intro hp
    obtain ⟨h, hmatch⟩ := exists_matching_node ι ν hν A hzero
    have hv := (actual_pair_iff_of_matching ι ν hν mu A hzero h hmatch lam m).mp hp
    refine ⟨coefficient ν h.val, ?_, hv.1⟩
    apply Finset.mem_image.mpr
    refine ⟨h, Finset.mem_filter.mpr ⟨Finset.mem_attach _ _, ?_⟩, ?_⟩
    · intro i j hij
      simpa only [pathRankInput, dite_eq_left hij] using hmatch i j hij
    · exact Prod.ext rfl hv.2.symm
  · rintro ⟨c, hc, rfl⟩
    obtain ⟨h, hh, heq⟩ := Finset.mem_image.mp hc
    have hm := (Finset.mem_filter.mp hh).2
    have hmatch : ∀ i j (hij : i ≤ j),
        pathCount h.val i j = (pathMatrix A i j hij).rank := by
      intro i j hij
      simpa only [pathRankInput, dite_eq_left hij] using hm i j hij
    apply (actual_pair_iff_of_matching ι ν hν mu A hzero h hmatch _ _).mpr
    have hfirst : coefficient ν h.val = c := congrArg Prod.fst heq
    have hsecond : 1 + criticalDepth ν h = m := congrArg Prod.snd heq
    exact ⟨by rw [hfirst], hsecond.symm⟩

/-- On every actual zero-output input the total executable algorithm has
exactly one output pair. Thus infeasible input fallbacks cannot affect an
actual measured endpoint. -/
theorem computedPairs_nonempty_singleton
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    ∃ c m : ℕ, computedPairs ν (pathRankInput ι A) = {(c, m)} ∧
      NativePair ι mu A ((c : ℝ) / 2) m := by
  obtain ⟨h, hmatch⟩ := exists_matching_node ι ν hν A hzero
  let c := coefficient ν h.val
  let m := 1 + criticalDepth ν h
  have hp : NativePair ι mu A ((c : ℝ) / 2) m :=
    (actual_pair_iff_of_matching ι ν hν mu A hzero h hmatch _ _).mpr ⟨rfl, rfl⟩
  have hmem : (c, m) ∈ computedPairs ν (pathRankInput ι A) := by
    obtain ⟨a, ha, heq⟩ := (actual_pair_iff_computedPairs ι ν hν mu A hzero _ _).mp hp
    have hac : a = c := by
      have hh : (a : ℝ) = (c : ℝ) := by linarith
      exact_mod_cast hh
    simpa only [hac] using ha
  refine ⟨c, m, ?_, hp⟩
  apply Finset.eq_singleton_iff_unique_mem.mpr
  refine ⟨hmem, ?_⟩
  rintro ⟨a, n⟩ han
  have hp' : NativePair ι mu A ((a : ℝ) / 2) n :=
    (actual_pair_iff_computedPairs ι ν hν mu A hzero _ _).mpr ⟨a, han, rfl⟩
  have hv := O77.PowerLogUniqueness.radius_order_unique hp' hp
  have hac : a = c := by
    have hh : (a : ℝ) = (c : ℝ) := by linarith [hv.1]
    exact_mod_cast hh
  exact Prod.ext hac hv.2

theorem entry_half_prior_pair_iff_computedPairs
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1 / 2 : ℝ) * ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m ↔
      ∃ c : ℕ, (c, m) ∈ computedPairs ν (pathRankInput ι A) ∧ lam = (c : ℝ) / 2 := by
  let z : ZeroFiber ι := ⟨A, hzero⟩
  have hp := pairValue_spec ι mu z
  have hn : NativePair ι mu A lam m ↔
      lam = (pairValue ι mu z).1 ∧ m = (pairValue ι mu z).2 := by
    constructor
    · intro h
      exact O77.PowerLogUniqueness.radius_order_unique h hp
    · rintro ⟨rfl, rfl⟩
      exact hp
  exact (entry_half_prior_iff_pairValue ι mu z prior hprior hpos lam m).trans
    (hn.symm.trans (actual_pair_iff_computedPairs ι ν hν mu A hzero lam m))

end MAIS.Run2ArithmeticCriticalPath

/-- info: 'MAIS.Run2ArithmeticCriticalPath.criticalDepth_eq_pathMaximum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPath.criticalDepth_eq_pathMaximum

/-- info: 'MAIS.Run2ArithmeticCriticalPath.exists_matching_node' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPath.exists_matching_node

/-- info: 'MAIS.Run2ArithmeticCriticalPath.actual_pair_iff_of_matching' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPath.actual_pair_iff_of_matching

/-- info: 'MAIS.Run2ArithmeticCriticalPath.entry_half_prior_pair_iff_of_matching' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPath.entry_half_prior_pair_iff_of_matching

/-- info: 'MAIS.Run2ArithmeticCriticalPath.actual_pair_iff_computedPairs' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPath.actual_pair_iff_computedPairs

/-- info: 'MAIS.Run2ArithmeticCriticalPath.computedPairs_nonempty_singleton' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPath.computedPairs_nonempty_singleton

/-- info: 'MAIS.Run2ArithmeticCriticalPath.entry_half_prior_pair_iff_computedPairs' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPath.entry_half_prior_pair_iff_computedPairs
end
