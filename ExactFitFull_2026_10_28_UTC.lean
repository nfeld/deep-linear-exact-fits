-- ==================== begin module O7.Run2GeometricCylinderCodim (formalization/O7/Run2GeometricCylinderCodim.lean) ====================
section

/-! Actual geometric codimension of a spectator/regular/residual zero-fiber
model, derived from finite real orbit patches and actual chart invariance. -/
set_option autoImplicit false
set_option maxHeartbeats 1700000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricCylinderCodim
open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear
open MAIS.Run2GeometricCharts MAIS.Run2GeometricZeroFiber MAIS.Run2GeometricCodimension
open MAIS.Run2GeometricCylinderPatch MAIS.Run2GeometricCylinderZeroFiber
open MAIS.Run2GeometricGerms MAIS.Run2GeometricCodimCharts

variable {K Q F : Type*}
  [NormedAddCommGroup K] [NormedSpace ℝ K] [FiniteDimensional ℝ K]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q] [FiniteDimensional ℝ Q]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

theorem geometricCodimNat_zeroFiber (A : Rep ι) :
    geometricCodimNat (zeroFiber ι) A = localCodimNat ι A := rfl

theorem geometricCodimNat_cylinder_zeroFiber
    (A : Rep ι) (hA : A ∈ zeroFiber ι) (k : K) :
    geometricCodimNat (cylinder (zeroFiber ι) : Set (K × (Q × Rep ι))) (k, (0, A)) =
      Module.finrank ℝ Q + localCodimNat ι A := by
  obtain ⟨B, _, _, hdim, _⟩ := exists_orbit_realizing_localDimH ι hA
  have hd := localDimH_cylinder_zeroFiber (K := K) (Q := Q) ι A hA k
  have hle := (orbitDifferential ι B).range.finrank_le
  simp only [geometricCodimNat, localCodimNat, hd, hdim, ← Nat.cast_add,
    ENNReal.toReal_natCast, Nat.floor_natCast, Module.finrank_prod]
  omega

/-- Once an actual differentiable ambient chart has the literal fiber
q=0 and residual full product zero, its true codimension follows geometrically.
There is no measured exponent or proposed codimension among the premises. -/
theorem geometricCodimNat_of_cylinder_chart
    (e : OpenPartialHomeomorph (K × (Q × Rep ι)) F)
    (A : Rep ι) (hA : A ∈ zeroFiber ι) (k : K)
    (ha : (k, ((0 : Q), A)) ∈ e.source)
    (T U : Set F) (hU : IsOpen U) (haU : e (k, (0, A)) ∈ U)
    (hUt : U ⊆ e.target)
    (hf : DifferentiableOn ℝ e e.source)
    (hi : DifferentiableOn ℝ e.symm U)
    (hiff : ∀ x ∈ e.source, e x ∈ T ↔
      x.2.1 = 0 ∧ x.2.2 ∈ zeroFiber ι) :
    geometricCodimNat T (e (k, (0, A))) =
      Module.finrank ℝ Q + localCodimNat ι A := by
  exact (geometricCodimNat_fiber_chart e (k, (0, A)) ha
    (MAIS.Run2GeometricCylinderPatch.cylinder (zeroFiber ι)) T U hU haU hUt hf hi hiff).trans
      (geometricCodimNat_cylinder_zeroFiber ι A hA k)

end MAIS.Run2GeometricCylinderCodim

/-- info: 'MAIS.Run2GeometricCylinderCodim.geometricCodimNat_zeroFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderCodim.geometricCodimNat_zeroFiber

/-- info: 'MAIS.Run2GeometricCylinderCodim.geometricCodimNat_cylinder_zeroFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderCodim.geometricCodimNat_cylinder_zeroFiber

/-- info: 'MAIS.Run2GeometricCylinderCodim.geometricCodimNat_of_cylinder_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCylinderCodim.geometricCodimNat_of_cylinder_chart
end
end
-- ==================== end module O7.Run2GeometricCylinderCodim ====================

-- ==================== begin module O7.Run2GeometricNormalSuspension (formalization/O7/Run2GeometricNormalSuspension.lean) ====================
section

/-! Absorption of actual reduced orbit directions into genuine free retained
kernel coordinates. The resulting codimension is computed from actual full
reduced zero-fiber geometry, with every regular parameter retained. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
noncomputable section
open Set Filter
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2GeometricNormalSuspension
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.OrbitSliceChart MAIS.OrbitSliceAnalytic MAIS.Run2GeometricCodimCharts
open MAIS.Run2GeometricZeroFiber MAIS.Run2GeometricCodimension
open MAIS.Run2GeometricAnalyticFiber MAIS.Run2GeometricRetainedCoordinates
open MAIS.Run2GeometricSliceZeroFiber MAIS.Run2GeometricCylinderCodim
open MAIS.Run2GeometricCharts MAIS.Run2GeometricCylinderZeroFiber
variable {D : ℕ} (κ : Fin (D+1) → Type*)
  [∀ v,Fintype (κ v)] [∀ v,DecidableEq (κ v)]
variable {Q K N X : Type*}
  [NormedAddCommGroup Q] [NormedSpace ℝ Q] [FiniteDimensional ℝ Q]
  [NormedAddCommGroup K] [NormedSpace ℝ K] [FiniteDimensional ℝ K]
  [NormedAddCommGroup N] [NormedSpace ℝ N] [FiniteDimensional ℝ N]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [FiniteDimensional ℝ X]

def retainedFiber (R : N → Matrix (κ (Fin.last D)) (κ 0) ℝ) : Set ((Q × K) × N) :=
  {p | p.1.1=0 ∧ R p.2=0}

/-- An actual retained normal-product germ has the independently measured
geometric codimension of the full reduced zero-product fiber plus the genuine
regular output dimension. The free spectator is constructed elsewhere by an
actual linear injection; here its actual equivalence is used explicitly. -/
theorem codim_retainedFiber_and_integral
    (C : Rep κ) (hC : C ∈ zeroFiber κ)
    (Nr : Submodule ℝ (Rep κ))
    (hNr : IsCompl (orbitDifferential κ C).range Nr)
    (eK : K ≃L[ℝ] (orbitDirections κ C) × X) (eN : N ≃L[ℝ] Nr)
    (R : N → Matrix (κ (Fin.last D)) (κ 0) ℝ)
    (hR : ∀ n,R n = pathMatrix (C+(eN n:Rep κ))
      0 (Fin.last D) (Fin.zero_le _)) :
    geometricCodimNat (retainedFiber (Q:=Q) (K:=K) κ R) 0 =
      Module.finrank ℝ Q + localCodimNat κ C ∧
      ∃ n : ℕ,localDimH (retainedFiber (Q:=Q) (K:=K) κ R) 0=(n:ℝ≥0∞) := by
  let Hr := orbitDirections κ C
  have hHr := orbitDirections_isCompl κ C
  let r := sliceChart κ C Hr Nr hHr hNr
  let g := regroup (Q:=Q) eK eN
  let s := (OpenPartialHomeomorph.refl X).prod
    ((OpenPartialHomeomorph.refl Q).prod r.symm)
  let c := s.trans g.toHomeomorph.toOpenPartialHomeomorph
  let a : X × (Q × Rep κ) := (0,(0,C))
  have hs0 : a∈s.source :=
    ⟨mem_univ _,mem_univ _,base_mem_sliceChart_target κ C Hr Nr hHr hNr⟩
  have hc0 : a∈c.source := ⟨hs0,mem_univ _⟩
  have hca : c a=0 := by
    change g (0,(0,r.symm C))=0
    rw [sliceChart_symm_base]
    exact map_zero g
  have hsAn : AnalyticAt ℝ s a := by
    have hq : AnalyticAt ℝ (fun y : X × (Q × Rep κ) => y.2.1) a :=
      ((ContinuousLinearMap.fst ℝ Q (Rep κ)).comp
        (ContinuousLinearMap.snd ℝ X (Q × Rep κ))).analyticAt a
    have hr : AnalyticAt ℝ (fun y : X × (Q × Rep κ) => y.2.2) a :=
      ((ContinuousLinearMap.snd ℝ Q (Rep κ)).comp
        (ContinuousLinearMap.snd ℝ X (Q × Rep κ))).analyticAt a
    exact analyticAt_fst.prod (hq.prod
      ((analyticAt_sliceChart_symm κ C Hr Nr hHr hNr).comp hr))
  have hcAn : AnalyticAt ℝ c a := (g.analyticAt (s a)).comp hsAn
  have hsInv (z : X × (Q × (Hr × Nr))) : AnalyticAt ℝ s.symm z := by
    change AnalyticAt ℝ (fun y : X × (Q × (Hr × Nr)) =>
      (y.1,(y.2.1,sliceMap κ C Hr Nr y.2.2))) z
    have hq : AnalyticAt ℝ (fun y : X × (Q × (Hr × Nr)) => y.2.1) z :=
      ((ContinuousLinearMap.fst ℝ Q (Hr × Nr)).comp
        (ContinuousLinearMap.snd ℝ X (Q × (Hr × Nr)))).analyticAt z
    have hr : AnalyticAt ℝ (fun y : X × (Q × (Hr × Nr)) => y.2.2) z :=
      ((ContinuousLinearMap.snd ℝ Q (Hr × Nr)).comp
        (ContinuousLinearMap.snd ℝ X (Q × (Hr × Nr)))).analyticAt z
    exact analyticAt_fst.prod (hq.prod
      ((analyticAt_sliceMap κ C Hr Nr z.2.2).comp
        (f:=fun y : X × (Q × (Hr × Nr)) => y.2.2) (x:=z) hr))
  have hcInv : AnalyticAt ℝ c.symm (c a) := by
    rw [hca]
    exact (hsInv (g.symm 0)).comp (g.symm.analyticAt 0)
  have hiff (y : X × (Q × Rep κ)) (hy : y∈c.source) :
      c y ∈ retainedFiber (Q:=Q) (K:=K) κ R ↔
        y ∈ MAIS.Run2GeometricCylinderPatch.cylinder (K:=X) (Q:=Q) (zeroFiber κ) := by
    have hyt : y.2.2∈r.target := hy.1.2.2
    let p := r.symm y.2.2
    have hrp : sliceMap κ C Hr Nr p = y.2.2 := r.right_inv hyt
    change (y.2.1=0 ∧ R (eN.symm p.2)=0) ↔
      (y.2.1=0 ∧ pathMatrix y.2.2 0 (Fin.last D) (Fin.zero_le _)=0)
    rw [hR,ContinuousLinearEquiv.apply_symm_apply]
    apply and_congr Iff.rfl
    have hz := sliceMap_mem_zeroFiber_iff κ C Hr Nr p
    change pathMatrix (sliceMap κ C Hr Nr p) 0 (Fin.last D) (Fin.zero_le _)=0 ↔
      pathMatrix (C+(p.2:Rep κ)) 0 (Fin.last D) (Fin.zero_le _)=0 at hz
    rw [hrp] at hz
    exact hz.symm
  obtain ⟨V,hV,hVo,haV⟩ := eventually_nhds_iff.mp
    (hcAn.eventually_analyticAt.and (c.open_source.mem_nhds hc0))
  have hcod := geometricCodimNat_of_local_analytic_chart c a V hVo haV
    (fun y hy => (hV y hy).2) (fun y hy => (hV y hy).1) hcInv
    (MAIS.Run2GeometricCylinderPatch.cylinder (K:=X) (Q:=Q) (zeroFiber κ))
    (retainedFiber (Q:=Q) (K:=K) κ R)
    (fun y hy => hiff y (hV y hy).2)
  rw [hca] at hcod
  have hnat := hcod.trans (geometricCodimNat_cylinder_zeroFiber (K:=X) (Q:=Q) κ C hC 0)
  have hloc := localDimH_of_local_analytic_chart c a V hVo haV
    (fun y hy => (hV y hy).2) (fun y hy => (hV y hy).1) hcInv
    (MAIS.Run2GeometricCylinderPatch.cylinder (K:=X) (Q:=Q) (zeroFiber κ))
    (retainedFiber (Q:=Q) (K:=K) κ R)
    (fun y hy => hiff y (hV y hy).2)
  rw [hca] at hloc
  obtain ⟨B,_,_,hdim,_⟩ := exists_orbit_realizing_localDimH κ hC
  refine ⟨hnat,Module.finrank ℝ X+Module.finrank ℝ (orbitDifferential κ B).range,?_⟩
  rw [hloc,localDimH_cylinder_zeroFiber (K:=X) (Q:=Q) κ C hC 0,hdim]
  exact (Nat.cast_add _ _).symm

theorem codim_retainedFiber
    (C : Rep κ) (hC : C ∈ zeroFiber κ)
    (Nr : Submodule ℝ (Rep κ))
    (hNr : IsCompl (orbitDifferential κ C).range Nr)
    (eK : K ≃L[ℝ] (orbitDirections κ C) × X) (eN : N ≃L[ℝ] Nr)
    (R : N → Matrix (κ (Fin.last D)) (κ 0) ℝ)
    (hR : ∀ n,R n = pathMatrix (C+(eN n:Rep κ))
      0 (Fin.last D) (Fin.zero_le _)) :
    geometricCodimNat (retainedFiber (Q:=Q) (K:=K) κ R) 0 =
      Module.finrank ℝ Q + localCodimNat κ C := by
  exact (codim_retainedFiber_and_integral κ C hC Nr hNr eK eN R hR).1
end MAIS.Run2GeometricNormalSuspension

/-- info: 'MAIS.Run2GeometricNormalSuspension.codim_retainedFiber_and_integral' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricNormalSuspension.codim_retainedFiber_and_integral

/-- info: 'MAIS.Run2GeometricNormalSuspension.codim_retainedFiber' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricNormalSuspension.codim_retainedFiber
end
end
