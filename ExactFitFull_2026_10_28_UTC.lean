-- ==================== begin module O7.ActiveIntervalHigherPairs (formalization/O7/ActiveIntervalHigherPairs.lean) ====================
section

/-! Actual higher-orbit full ambient pairs yield actual local residual
pairs on the complete compact annulus. No angular-pair existence oracle. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.ActiveIntervalHigherPairs
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalGaussianChart
open MAIS.ActiveIntervalMeasuredSlice MAIS.ActiveIntervalAnnulusRecurrence
open MAIS.ActiveIntervalWeightedResidual MAIS.ActiveIntervalRadialBand
open MAIS.ActiveIntervalStrictGenerization MAIS.MatrixChainIsomorphism
open MAIS.QuiverRealOrbit MAIS.WeightedDyadicShells MAIS.WeightedCompactAnnulus
open MAIS.AnalyticTransfer
variable {S:Type*} [Fintype S] [DecidableEq S]
variable (D:ℕ) (birth death:S→ℕ) (hD:∀ s,death s≤D+1)

/-- Every nonzero actual residual point gives a nonzero actual parameter
through the genuine Gaussian homeomorphism fixing zero. -/
theorem zeroDirectParameter_ne_zero (z:Residual D birth death) (hz:z≠0) :
    zeroDirectParameter D birth death hD z≠0 := by
  intro h
  have hh:(z,(0:Regular D birth death))=0:=
    (gaussianHomeomorph D birth death hD).injective
      (h.trans (gaussianHomeomorph_zero D birth death hD).symm)
  exact hz (congrArg Prod.fst hh)

/-- Actual local residual-pair existence and type coverage are derived from
actual full-matrix pair data on all genuine strict orbit generizations.
The table need not be finite or known nonempty for this local theorem. -/
theorem local_residual_pairs_of_higher_table {J:Type*} (a:J→ℝ) (m:J→ℕ)
    (hvalid:∀ s,birth s<death s)
    (muA:Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muT:Measure (NormalParams birth death)) [Measure.IsAddHaarMeasure muT]
    (muR:Measure (Residual D birth death)) [Measure.IsAddHaarMeasure muR]
    (hzero:pathMatrix (intervalRep D birth death) 0 (Fin.last D) (by exact Nat.zero_le D)=0)
    (hcover:∀ A:Ambient D birth death,
      pathMatrix A 0 (Fin.last D) (by exact Nat.zero_le D)=0→
      intervalRep D birth death∈closure (MulAction.orbit (Gauge (Index D birth death)) A)→
      A∉MulAction.orbit (Gauge (Index D birth death)) (intervalRep D birth death)→
      ∃ j,HasMeasuredBandPair muA (Metric.ball A)
        (ambientLoss D birth death 0 (Fin.last D) (by exact Nat.zero_le D)) A (a j) (m j)) :
    ∀ z∈compactAnnulus (integerWeights D birth death),residualLoss D birth death hD z=0→
      ∃ j,HasMeasuredBandPair muR (Metric.ball z) (residualLoss D birth death hD) z
        (a j-(Fintype.card (DirectIndex D birth death):ℝ)/2) (m j) := by
  obtain ⟨V,hVo,h0V,hnear⟩:=
    MAIS.ActiveIntervalNearbyResidual.exists_open_residual_pair_of_ambient_pair
      D birth death hD hvalid muA muT muR
  have hW:∀ p:ResidualIndex D birth death,0 < integerWeights D birth death p:=
    fun p=>((zero_base_weight_data D birth death hD hzero).2 p).1
  have hhom:∀ r:ℝ,0<r→∀ z:Residual D birth death,
      residualLoss D birth death hD (dilation (integerWeights D birth death) r z)=
      r^(2*MAIS.IntervalIntegerPotentials.commonDenominator D birth death)*residualLoss D birth death hD z:=by
    intro r hr z
    exact zero_base_residualLoss_integerDilation D birth death hD hzero r hr z
  intro z hzK hz
  have hz0:z≠0:=by
    intro hh
    subst z
    exact zero_not_mem_compactAnnulus _ hzK
  obtain ⟨r,hr,hyV,hy0⟩:=MAIS.WeightedDilationNeighborhood.exists_positive_dilation_mem_nhds_ne_zero
    (integerWeights D birth death) hW z hz0 V (hVo.mem_nhds h0V)
  let y:=dilation (integerWeights D birth death) r z
  have hy:residualLoss D birth death hD y=0:=by rw [hhom r hr z,hz,mul_zero]
  have hstrict:=strict_generization D birth death hD (zeroDirectParameter D birth death hD y)
    (zeroDirectParameter_ne_zero D birth death hD y hy0)
  obtain ⟨j,hj⟩:=hcover (zeroDirectRep D birth death hD y)
    (fullProduct_zeroDirectRep_eq_zero D birth death hD y hy) hstrict.1 hstrict.2.1
  have hyp:=hnear y hyV hy (a j) (m j) hj
  refine ⟨j,?_⟩
  exact (MAIS.WeightedAnnulusPairTransport.pair_iff_dilation muR
    (integerWeights D birth death) (2*MAIS.IntervalIntegerPotentials.commonDenominator D birth death)
    (residualLoss D birth death hD) (continuous_residualLoss D birth death hD).measurable
    hhom r hr z _ _).mpr hyp

end MAIS.ActiveIntervalHigherPairs
end

/-- info: 'MAIS.ActiveIntervalHigherPairs.zeroDirectParameter_ne_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalHigherPairs.zeroDirectParameter_ne_zero

