-- ==================== begin module O7.Run2PotentialCriticalPath (formalization/O7/Run2PotentialCriticalPath.lean) ====================
section

/-! Exact actual logarithmic multiplicity from an independently defined
finite-orbit weighted-path maximum. The graph, exponent tests, vertex weights
and finite-path cost contain no actual multiplicity or desired pair value. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2600000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialCriticalPath
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitFiniteHeight
open MAIS.Run2PotentialOrbitGraph MAIS.Run2PotentialOrbitBellman
open MAIS.Run2PotentialBalancedMinimum MAIS.QuiverZeroFinitePairTable MAIS.AnalyticTransfer
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- Independent costs of actual finite constant-exponent strict orbit paths. -/
def pathCosts (j : Node ι) : Set ℕ :=
  MAIS.Run2PotentialWeightedPaths.costs (edge ι) (weight ι) j

/-- Independently defined greatest path cost; finiteness and actual
attainment are proved before identifying it with a measured multiplicity. -/
def criticalDepth (j : Node ι) : ℕ := sSup (pathCosts ι j)

theorem pathCosts_nonempty (j : Node ι) : (pathCosts ι j).Nonempty :=
  ⟨0, MAIS.Run2PotentialWeightedPaths.zero_mem_costs (edge ι) (weight ι) j⟩

/-- Path costs form an actual finite integer set, independently of measured
multiplicities, because every actual edge strictly lowers the true rank defect. -/
theorem finite_pathCosts (j : Node ι) : (pathCosts ι j).Finite :=
  MAIS.Run2PotentialWeightedPaths.finite_costs (edge ι) (weight ι)
    (fun k => rankDefect ι (rep ι k)) (weight_le_one ι)
    (fun _ _ h => edge_rankDefect_lt ι h) j

/-- The independent maximum is actually attained by a genuine finite path. -/
theorem criticalDepth_mem_pathCosts (j : Node ι) : criticalDepth ι j ∈ pathCosts ι j :=
  (pathCosts_nonempty ι j).csSup_mem (finite_pathCosts ι j)

theorem criticalDepth_le_rankDefect (j : Node ι) :
    criticalDepth ι j ≤ rankDefect ι (rep ι j) := by
  apply csSup_le (pathCosts_nonempty ι j)
  rintro c ⟨k, hp⟩
  exact MAIS.Run2PotentialWeightedPaths.path_cost_le_rank (edge ι) (weight ι)
    (fun k => rankDefect ι (rep ι k)) (weight_le_one ι)
    (fun _ _ h => edge_rankDefect_lt ι h) hp

/-- Actual measured multiplicity is one plus the independent attained
maximum critical path cost on the true finite zero-output orbit graph. -/
theorem multiplicity_eq_one_add_criticalDepth
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (j : Node ι) :
    multiplicity ι mu j = 1 + criticalDepth ι j :=
  MAIS.Run2PotentialWeightedPaths.multiplicity_eq_one_add_criticalDepth
    (edge ι) (weight ι) (multiplicity ι mu) (wellFounded_edge ι)
    (multiplicity_pos ι mu) (fun _ _ h => edge_multiplicity_inequality ι mu h)
    (exists_maximizing_edge ι mu) j

/-- Exact logarithmic critical-path formula for EVERY actual Haar pair at
EVERY actual rectangular zero-output matrix chain. -/
theorem actual_multiplicity_eq_one_add_criticalDepth
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    m = 1 + criticalDepth ι (indexOf ι A hzero) :=
  (measured_values_eq_indexOf ι mu A hzero hp).2.trans
    (multiplicity_eq_one_add_criticalDepth ι mu (indexOf ι A hzero))

/-- The COMPLETE actual zero-output pair equals the independent incidence
minimum and independent critical-path maximum. Neither number was defined
from a measured pair or proposed multiplicity. -/
theorem actual_pair_iff
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m ↔
      lam = (balancedOutputMinimum ι A : ℝ) / 2 ∧
      m = 1 + criticalDepth ι (indexOf ι A hzero) := by
  constructor
  · intro hp
    exact ⟨exponent_eq_half_balancedOutputMinimum ι mu A hzero hp,
      actual_multiplicity_eq_one_add_criticalDepth ι mu A hzero hp⟩
  · rintro ⟨hlam, hm⟩
    obtain ⟨a, n, hp⟩ := MAIS.QuiverZeroPairExistence.exists_pair_zero_output ι mu A hzero
    have ha := (exponent_eq_half_balancedOutputMinimum ι mu A hzero hp).trans hlam.symm
    have hn := (actual_multiplicity_eq_one_add_criticalDepth ι mu A hzero hp).trans hm.symm
    simpa only [ha, hn] using hp

/-- Literal half-squared loss in actual full-original-entry Euclidean balls,
with an arbitrary coupled prior continuous and positive at the center, obeys
the SAME exact independent incidence-minimum/critical-path pair formula. -/
theorem entry_half_prior_pair_iff
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1 / 2 : ℝ) * ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m ↔
      lam = (balancedOutputMinimum ι A : ℝ) / 2 ∧
      m = 1 + criticalDepth ι (indexOf ι A hzero) := by
  let z : ZeroFiber ι := ⟨A, hzero⟩
  have h := entry_half_prior_iff_pairValue ι mu z prior hprior hpos lam m
  have hp := pairValue_spec ι mu z
  have ha := exponent_eq_half_balancedOutputMinimum ι mu A hzero hp
  have hn := actual_multiplicity_eq_one_add_criticalDepth ι mu A hzero hp
  simpa only [ha, hn] using h

end MAIS.Run2PotentialCriticalPath

/-- info: 'MAIS.Run2PotentialCriticalPath.finite_pathCosts' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialCriticalPath.finite_pathCosts

/-- info: 'MAIS.Run2PotentialCriticalPath.criticalDepth_mem_pathCosts' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialCriticalPath.criticalDepth_mem_pathCosts

/-- info: 'MAIS.Run2PotentialCriticalPath.multiplicity_eq_one_add_criticalDepth' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialCriticalPath.multiplicity_eq_one_add_criticalDepth

/-- info: 'MAIS.Run2PotentialCriticalPath.actual_pair_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialCriticalPath.actual_pair_iff

/-- info: 'MAIS.Run2PotentialCriticalPath.entry_half_prior_pair_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialCriticalPath.entry_half_prior_pair_iff
end
end
