-- ==================== begin module O7.Run2GeometricLinearPatch (formalization/O7/Run2GeometricLinearPatch.lean) ====================
section

/-! A genuine free linear family contained in a fiber supplies a geometric
local dimension lower bound after an actual differentiable ambient chart. -/
set_option autoImplicit false
set_option maxHeartbeats 1500000
noncomputable section
open Set MeasureTheory Filter
open scoped Topology ENNReal NNReal

namespace MAIS.Run2GeometricLinearPatch
open MAIS.Run2GeometricCharts

variable {P E F : Type*}
  [NormedAddCommGroup P] [NormedSpace ℝ P] [FiniteDimensional ℝ P]
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

theorem dimH_image_injective_linear (j : P →ₗ[ℝ] E)
    (hj : Function.Injective j) (u : Set P) :
    dimH (j '' u) = dimH u := by
  let e : P ≃L[ℝ] j.range :=
    (LinearEquiv.ofInjective j hj).toContinuousLinearEquiv
  have he : j '' u = (Subtype.val : j.range → E) '' (e '' u) := by
    ext x
    constructor
    · rintro ⟨p, hp, rfl⟩
      exact ⟨e p, ⟨p, hp, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨p, hp, rfl⟩, rfl⟩
      exact ⟨p, hp, rfl⟩
  rw [he, isometry_subtype_coe.dimH_image, e.dimH_image]

/-- Every actual regular/free-normal parameter is retained; an arbitrary
positive-radius target ball still contains a full parameter neighborhood. -/
theorem localDimH_ge_of_chart_linear_patch
    (e : OpenPartialHomeomorph E F)
    (he : DifferentiableOn ℝ e e.source)
    (s U : Set F) (hU : IsOpen U)
    (hi : DifferentiableOn ℝ e.symm U)
    (j : P →L[ℝ] E) (hj : Function.Injective j)
    (hp : (0 : E) ∈ e.source) (hpU : e 0 ∈ U)
    (hcontains : ∀ p : P, j p ∈ e.source → e (j p) ∈ s) :
    (Module.finrank ℝ P : ℝ≥0∞) ≤ localDimH s (e 0) := by
  apply le_localDimH
  intro r hr
  let v : Set E := e.source ∩ e ⁻¹' (U ∩ Metric.ball (e 0) r)
  let u : Set P := j ⁻¹' v
  have heAt : ContinuousAt e (0 : E) :=
    e.continuousOn.continuousAt (e.open_source.mem_nhds hp)
  have hv : v ∈ 𝓝 (0 : E) :=
    inter_mem (e.open_source.mem_nhds hp)
      (heAt.preimage_mem_nhds (inter_mem (hU.mem_nhds hpU)
        (Metric.ball_mem_nhds (e 0) hr)))
  have hu : u ∈ 𝓝 (0 : P) := by
    have hvj : v ∈ 𝓝 (j (0 : P)) := by simpa only [map_zero] using hv
    exact j.continuous.continuousAt.preimage_mem_nhds hvj
  have hjs : j '' u ⊆ e.source := by
    rintro _ ⟨p, hp, rfl⟩
    exact hp.1
  have heU : e '' (j '' u) ⊆ U := by
    rintro _ ⟨_, ⟨p, hp, rfl⟩, rfl⟩
    exact hp.2.1
  have hd : dimH (e '' (j '' u)) = Module.finrank ℝ P := by
    calc
      dimH (e '' (j '' u)) = dimH (j '' u) :=
        dimH_image_eq_of_left_inverse (he.mono hjs) (hi.mono heU)
          (fun p hp => e.left_inv (hjs hp))
      _ = dimH u := dimH_image_injective_linear j.toLinearMap hj u
      _ = Module.finrank ℝ P := Real.dimH_of_mem_nhds hu
  rw [← hd]
  apply dimH_mono
  rintro _ ⟨_, ⟨p, hp, rfl⟩, rfl⟩
  exact ⟨hcontains p hp.1, hp.2.2⟩

end MAIS.Run2GeometricLinearPatch

/-- info: 'MAIS.Run2GeometricLinearPatch.dimH_image_injective_linear' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricLinearPatch.dimH_image_injective_linear

/-- info: 'MAIS.Run2GeometricLinearPatch.localDimH_ge_of_chart_linear_patch' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricLinearPatch.localDimH_ge_of_chart_linear_patch
end
end
-- ==================== end module O7.Run2GeometricLinearPatch ====================

-- ==================== begin module O7.Run2OutputCut (formalization/O7/Run2OutputCut.lean) ====================
section

/-! The output cut in the actual independent interval normal coordinates.
The full, untruncated matrix product vanishes on this literal coordinate
subspace. Neither a tangent-cone approximation nor a supplied fiber
dimension formula is used. -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
noncomputable section

namespace MAIS.Run2OutputCut

open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.MatrixPrefixPolynomial MAIS.MatrixChainIsomorphism
open scoped Matrix

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ)

/-- Actual normal entries whose target interval reaches the output. -/
abbrev OutputIndex := {p : NormalIndex birth death // death p.val.1 = D + 1}

/-- Read precisely the output-target normal entries. -/
def outputCoordinates : NormalParams birth death →ₗ[ℝ] (OutputIndex D birth death → ℝ) where
  toFun t p := t p.val
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- A genuine coordinate linear subspace of the full normal parameter space. -/
def outputCut : Submodule ℝ (NormalParams birth death) :=
  (outputCoordinates D birth death).ker

omit [Fintype S] [DecidableEq S] in
theorem mem_outputCut_iff (t : NormalParams birth death) :
    t ∈ outputCut D birth death ↔
      ∀ p : NormalIndex birth death, death p.val.1 = D + 1 → t p = 0 := by
  change outputCoordinates D birth death t = 0 ↔ _
  constructor
  · intro h p hp
    exact congrFun h ⟨p, hp⟩
  · intro h
    funext p
    exact h p.val p.property

omit [Fintype S] [DecidableEq S] in
theorem outputCoordinates_surjective :
    Function.Surjective (outputCoordinates D birth death) := by
  intro y
  refine ⟨fun p => if h : death p.val.1 = D + 1 then y ⟨p, h⟩ else 0, ?_⟩
  funext p
  simp only [outputCoordinates, LinearMap.coe_mk, AddHom.coe_mk]
  exact dite_eq_left p.property

omit [DecidableEq S] in
/-- The cut imposes exactly one independent equation per actual output entry. -/
theorem finrank_outputCut_add_cardOutput :
    Module.finrank ℝ (outputCut D birth death) +
      Fintype.card (OutputIndex D birth death) =
        Fintype.card (NormalIndex birth death) := by
  have hrange : (outputCoordinates D birth death).range = ⊤ :=
    LinearMap.range_eq_top.mpr (outputCoordinates_surjective D birth death)
  have h := (outputCoordinates D birth death).finrank_range_add_finrank_ker
  rw [hrange, finrank_top] at h
  simpa [outputCut, Module.finrank_pi, Nat.add_comm] using h

variable (hD : ∀ s, death s ≤ D + 1)

omit [Fintype S] [DecidableEq S] in
/-- Every normal entrance into an output-reaching interval is zero on the cut. -/
theorem normalInjection_output_row_zero (t : NormalParams birth death)
    (ht : t ∈ outputCut D birth death)
    (e : Fin D) (r : Index D birth death e.succ)
    (s : Index D birth death e.castSucc) (hr : death r.val = D + 1) :
    MAIS.ActiveIntervalNormal.normalInjection D birth death hD t e r s = 0 := by
  rw [MAIS.ActiveIntervalNormal.normalInjection_apply]
  by_cases h : Linked birth death r.val s.val
  · simp only [dite_eq_left h]
    rw [(mem_outputCut_iff D birth death t).mp ht ⟨(r.val, s.val), h⟩ hr]
    simp
  · simp only [dite_eq_right h]

include hD in
/-- No input-to-output base slot survives an actual zero complete product. -/
theorem no_output_slot_at_input
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (r : Index D birth death 0) : death r.val ≠ D + 1 := by
  intro hr
  have hp := MAIS.IntervalPositivePotentials.denominator_pos_of_zero_path
    D birth death hD hzero r.val
  have hb : birth r.val = 0 := Nat.eq_zero_of_le_zero r.property.1
  simp [MAIS.IntervalPositivePotentials.denominator, hb, hr] at hp

/-- Each actual prefix row in an output-reaching slot is zero on the cut.
The proof follows the literal finite matrix multiplication, not just its
linear part or an assigned collection of path monomials. -/
theorem prefix_output_row_zero
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (t : NormalParams birth death) (ht : t ∈ outputCut D birth death)
    (j : Fin (D + 1)) (r : Index D birth death j)
    (hr : death r.val = D + 1) (s : Index D birth death 0) :
    prefixProduct (Index D birth death)
      (intervalRep D birth death +
        MAIS.ActiveIntervalNormal.normalInjection D birth death hD t) j r s = 0 := by
  induction j using Fin.induction with
  | zero => exact False.elim ((no_output_slot_at_input D birth death hD hzero r) hr)
  | succ e ih =>
    rw [prefixProduct_succ, Matrix.mul_apply]
    apply Finset.sum_eq_zero
    intro k _
    by_cases h : r.val = k.val
    · have hk : death k.val = D + 1 := by rw [← h]; exact hr
      rw [ih k hk, mul_zero]
    · have hb : intervalRep D birth death e r k = 0 := by
        simp only [intervalRep, ite_eq_right h]
      have hn := normalInjection_output_row_zero D birth death hD t ht e r k hr
      change (intervalRep D birth death e r k +
        MAIS.ActiveIntervalNormal.normalInjection D birth death hD t e r k) * _ = 0
      rw [hb, hn, zero_add, zero_mul]

/-- Exact full zero-fiber containment for the actual affine normal matrices. -/
theorem completeProduct_eq_zero_on_outputCut
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D)
      (by exact Nat.zero_le D) = 0)
    (t : NormalParams birth death) (ht : t ∈ outputCut D birth death) :
    pathMatrix (intervalRep D birth death +
      MAIS.ActiveIntervalNormal.normalInjection D birth death hD t)
      0 (Fin.last D) (by exact Nat.zero_le D) = 0 := by
  rw [pathMatrix_zero_eq_prefixProduct]
  ext r s
  have hr : death r.val = D + 1 := by
    have ha := r.property.2
    change D < death r.val at ha
    have hd := hD r.val
    omega
  exact prefix_output_row_zero D birth death hD hzero t ht (Fin.last D) r hr s

end MAIS.Run2OutputCut

/-- info: 'MAIS.Run2OutputCut.mem_outputCut_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OutputCut.mem_outputCut_iff

/-- info: 'MAIS.Run2OutputCut.outputCoordinates_surjective' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OutputCut.outputCoordinates_surjective

/-- info: 'MAIS.Run2OutputCut.finrank_outputCut_add_cardOutput' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OutputCut.finrank_outputCut_add_cardOutput

/-- info: 'MAIS.Run2OutputCut.normalInjection_output_row_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OutputCut.normalInjection_output_row_zero

/-- info: 'MAIS.Run2OutputCut.no_output_slot_at_input' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OutputCut.no_output_slot_at_input

/-- info: 'MAIS.Run2OutputCut.prefix_output_row_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OutputCut.prefix_output_row_zero

/-- info: 'MAIS.Run2OutputCut.completeProduct_eq_zero_on_outputCut' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2OutputCut.completeProduct_eq_zero_on_outputCut
end
end
