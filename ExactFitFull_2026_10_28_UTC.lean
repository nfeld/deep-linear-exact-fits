-- ==================== begin module O7.Run2GeometricPositiveLearning (formalization/O7/Run2GeometricPositiveLearning.lean) ====================
section

/-! The actual measured exact-fit exponent is half the true geometric local
Hausdorff codimension, at every finite depth and arbitrary rectangular widths.
Actual prior/entry half-loss statements and actual existence are included. The
geometric formula and its integral-dimension witness were proved separately. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2GeometricPositiveLearning
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.BarcodeActiveNormalForm MAIS.AnalyticTransfer
open MAIS.Run2GeometricCharts MAIS.Run2GeometricCodimCharts MAIS.Run2GeometricIntegralCodim
open MAIS.Run2GeometricActualFiber MAIS.Run2GeometricFiberAllDepth MAIS.Run2PositiveFiberTransport
open MAIS.Run2PositivePairFormula MAIS.Run2PositiveAllDepthExistence
variable {D : ℕ} (ι : Fin (D+1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

/-- The measured exponent equals half the independently proved genuine
geometric codimension of the actual complete-product fiber at its actual center.
The actual normal form is constructed internally. -/
theorem exponent_eq_half_geometricCodimNat
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-
        pathMatrix A 0 (Fin.last D) (Nat.zero_le D)‖^2) A lam m) :
    lam=(geometricCodimNat (fixedProductFiber ι A) A:ℝ)/2 := by
  by_cases hD : 0<D
  · obtain ⟨N⟩ := exists_normal_form A
    have hl := ((MAIS.Run2PositivePairFormula.pair_iff_formula hD N mu lam m).mp hp).1
    have hc := geometricCodimNat_eq_balanced_count ι hD N
    change geometricCodimNat (fixedProductFiber ι A) A=
      MAIS.Run2PositiveNormalFormCounts.regularCount A+residualMinimum N at hc
    rw [hc]
    exact hl
  · have hz : D=0 := by omega
    subst D
    have hn := neutral_pair_depth_zero ι mu A
    obtain ⟨hl,_⟩ := O77.PowerLogUniqueness.radius_order_unique hp hn
    rw [hl,geometricCodimNat_depth_zero]
    norm_num

theorem two_mul_exponent_eq_true_codim
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-
        pathMatrix A 0 (Fin.last D) (Nat.zero_le D)‖^2) A lam m) :
    2*lam=(geometricCodimH (fixedProductFiber ι A) A).toReal := by
  rw [actualCodimH_eq_nat,ENNReal.toReal_natCast]
  have h:=exponent_eq_half_geometricCodimNat ι mu A hp
  linarith

/-- The actual pointed pair with the geometric exponent exists; the preceding
implication is not merely a statement conditional on an unproved pair. -/
theorem exists_pair_with_geometric_exponent
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι) :
    ∃ m : ℕ,HasMeasuredBandPair mu (Metric.ball A)
      (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-
        pathMatrix A 0 (Fin.last D) (Nat.zero_le D)‖^2)
      A ((geometricCodimNat (fixedProductFiber ι A) A:ℝ)/2) m := by
  obtain ⟨p,hp,_⟩ := exists_unique_pair_pointed ι mu A
  have h:=exponent_eq_half_geometricCodimNat ι mu A hp
  refine ⟨p.2,?_⟩
  rw [←h]
  exact hp

/-- Literal original-entry Euclidean windows, half loss and an arbitrary
coupled prior continuous and positive at the actual exact fit. All depths are
included, without applying positive-depth reconstruction at depth zero. -/
theorem entry_half_prior_pair_iff_pointed
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι)
    (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=target)
    (prior : Rep ι→ℝ) (hprior : ContinuousAt prior A) (hpos : 0<prior A)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-
        pathMatrix A 0 (Fin.last D) (Nat.zero_le D)‖^2) A lam m ↔
    HasMeasuredBandPair (mu.withDensity (fun B=>ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B=>(1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2) A lam m := by
  let f : Rep ι→ℝ := fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2
  have hs := MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_positive_scale mu
    (Metric.ball A) (fun _ _ h=>Metric.ball_subset_ball h) f A (1/2:ℝ) (by norm_num) lam m
  have hf : Measurable (fun B : Rep ι=>(1/2:ℝ)*f B) :=
    measurable_const.mul (((continuous_pathMatrix 0 (Fin.last D) (Nat.zero_le D)).sub
      continuous_const).norm.pow 2).measurable
  have hp := MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior mu hf hprior hpos
    (lam:=lam) (m:=m)
  have hw := MAIS.MatrixChainEntryWindows.pair_iff_entryBall ι
    (mu.withDensity (fun B=>ENNReal.ofReal (prior B))) A
    (f:=fun B=>(1/2:ℝ)*f B) (lam:=lam) (m:=m)
  simpa only [hfit] using (hs.trans hp).trans hw

theorem entry_half_prior_exponent_eq_half_geometricCodimNat
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι)
    (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=target)
    (prior : Rep ι→ℝ) (hprior : ContinuousAt prior A) (hpos : 0<prior A)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair (mu.withDensity (fun B=>ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B=>(1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2) A lam m) :
    lam=(geometricCodimNat (fixedProductFiber ι A) A:ℝ)/2 := by
  exact exponent_eq_half_geometricCodimNat ι mu A
    ((entry_half_prior_pair_iff_pointed ι mu A target hfit prior hprior hpos lam m).mpr hp)

theorem entry_half_prior_exists_geometric_pair
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι)
    (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=target)
    (prior : Rep ι→ℝ) (hprior : ContinuousAt prior A) (hpos : 0<prior A) :
    ∃ m : ℕ,HasMeasuredBandPair (mu.withDensity (fun B=>ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B=>(1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-target‖^2)
      A ((geometricCodimNat (fixedProductFiber ι A) A:ℝ)/2) m := by
  obtain ⟨m,hm⟩ := exists_pair_with_geometric_exponent ι mu A
  exact ⟨m,(entry_half_prior_pair_iff_pointed ι mu A target hfit prior hprior hpos _ m).mp hm⟩
end MAIS.Run2GeometricPositiveLearning

/-- info: 'MAIS.Run2GeometricPositiveLearning.exponent_eq_half_geometricCodimNat' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricPositiveLearning.exponent_eq_half_geometricCodimNat

/-- info: 'MAIS.Run2GeometricPositiveLearning.two_mul_exponent_eq_true_codim' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricPositiveLearning.two_mul_exponent_eq_true_codim

/-- info: 'MAIS.Run2GeometricPositiveLearning.exists_pair_with_geometric_exponent' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricPositiveLearning.exists_pair_with_geometric_exponent

/-- info: 'MAIS.Run2GeometricPositiveLearning.entry_half_prior_pair_iff_pointed' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricPositiveLearning.entry_half_prior_pair_iff_pointed

/-- info: 'MAIS.Run2GeometricPositiveLearning.entry_half_prior_exponent_eq_half_geometricCodimNat' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricPositiveLearning.entry_half_prior_exponent_eq_half_geometricCodimNat

/-- info: 'MAIS.Run2GeometricPositiveLearning.entry_half_prior_exists_geometric_pair' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricPositiveLearning.entry_half_prior_exists_geometric_pair
end
end
