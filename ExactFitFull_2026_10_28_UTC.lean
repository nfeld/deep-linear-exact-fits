-- ==================== begin module O7.WeightedDilationNeighborhood (formalization/O7/WeightedDilationNeighborhood.lean) ====================
section

/-! Actual positive polynomial weighted dilations contract every point
into every genuine neighborhood of zero, preserving nonzero centers. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1200000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology
namespace MAIS.WeightedDilationNeighborhood
open MAIS.WeightedDyadicShells
variable {I : Type*} [Fintype I]

omit [Fintype I] in
/-- The literal dilation curve is globally continuous, including radius0. -/
theorem continuous_dilation_curve (W : I→ℕ) (x : I→ℝ) :
    Continuous (fun r:ℝ=>dilation W r x) := by
  apply continuous_pi
  intro i
  exact (continuous_id.pow (W i)).mul_const (x i)

omit [Fintype I] in
/-- Positive weights force the actual polynomial radius-zero value to zero. -/
theorem dilation_zero (W : I→ℕ) (hW : ∀ i,0<W i) (x : I→ℝ) :
    dilation W 0 x=0 := by
  funext i
  simp only [dilation,zero_pow (Nat.ne_zero_of_lt (hW i)),zero_mul,Pi.zero_apply]

omit [Fintype I] in
/-- No specific neighborhood or rate witness is supplied: continuity of
the actual polynomial curve derives a suitable strictly positive radius. -/
theorem exists_positive_dilation_mem_nhds (W : I→ℕ) (hW : ∀ i,0<W i)
    (x : I→ℝ) (U : Set (I→ℝ)) (hU : U∈nhds (0:I→ℝ)) :
    ∃ r:ℝ,0<r ∧ dilation W r x∈U := by
  have he : ∀ᶠ r:ℝ in nhds 0,dilation W r x∈U := by
    have ht := ((continuous_dilation_curve W x).continuousAt (x:=(0:ℝ))).tendsto
    rw [dilation_zero W hW x] at ht
    exact ht.eventually hU
  obtain ⟨delta,hd,hball⟩ := Metric.mem_nhds_iff.mp he
  refine ⟨delta/2,half_pos hd,hball ?_⟩
  rw [Metric.mem_ball,Real.dist_eq,sub_zero,abs_of_pos (half_pos hd)]
  exact half_lt_self hd

/-- Actual nonzero centers stay nonzero under every positive dilation,
by the genuine diagonal linear equivalence, including arbitrary weights. -/
theorem dilation_ne_zero (W : I→ℕ) {r : ℝ} (hr : 0<r) {x : I→ℝ} (hx : x≠0) :
    dilation W r x≠0 := by
  classical
  intro h
  have h0 : dilation W r (0:I→ℝ)=0 := by funext i;simp [dilation]
  have heq : dilationEquiv W r hr.ne' x=dilationEquiv W r hr.ne' 0 := h.trans h0.symm
  exact hx ((dilationEquiv W r hr.ne').injective heq)

/-- Every nonzero actual center has a nonzero positive-dilation image
inside every actual neighborhood of zero. -/
theorem exists_positive_dilation_mem_nhds_ne_zero (W : I→ℕ) (hW : ∀ i,0<W i)
    (x : I→ℝ) (hx : x≠0) (U : Set (I→ℝ)) (hU : U∈nhds (0:I→ℝ)) :
    ∃ r:ℝ,0<r ∧ dilation W r x∈U ∧ dilation W r x≠0 := by
  obtain ⟨r,hr,hy⟩ := exists_positive_dilation_mem_nhds W hW x U hU
  exact ⟨r,hr,hy,dilation_ne_zero W hr hx⟩

end MAIS.WeightedDilationNeighborhood
end

/-- info: 'MAIS.WeightedDilationNeighborhood.exists_positive_dilation_mem_nhds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedDilationNeighborhood.exists_positive_dilation_mem_nhds

/-- info: 'MAIS.WeightedDilationNeighborhood.dilation_ne_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedDilationNeighborhood.dilation_ne_zero

/-- info: 'MAIS.WeightedDilationNeighborhood.exists_positive_dilation_mem_nhds_ne_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedDilationNeighborhood.exists_positive_dilation_mem_nhds_ne_zero
end
