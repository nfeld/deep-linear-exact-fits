-- ==================== begin module O7.WeightedPolarJacobian (formalization/O7/WeightedPolarJacobian.lean) ====================
section

/-! Actual positive-radius weighted polar coordinates and their derived
exact Haar change-of-variables density. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000
noncomputable section
open Set MeasureTheory
open scoped Matrix Topology ENNReal
namespace MAIS.WeightedPolarJacobian
open MAIS.WeightedCoordinateSlice MAIS.WeightedChartJacobian
variable {I : Type*} [Fintype I] [DecidableEq I]

/-- Only the actual selected radial coordinate is replaced by its logarithm. -/
def logCoordinate (p:I) (x:I→ℝ) : I→ℝ := Function.update x p (Real.log (x p))
def logDifferential (p:I) (x:I→ℝ) : (I→ℝ)→L[ℝ] (I→ℝ) :=
  ContinuousLinearMap.pi (fun i => (if i=p then (x p)⁻¹ else 1) •
    (ContinuousLinearMap.proj (R:=ℝ) i : (I→ℝ)→L[ℝ] ℝ))

theorem hasFDerivAt_logCoordinate (p:I) (x:I→ℝ) (hx:x p≠0) :
    HasFDerivAt (logCoordinate p) (logDifferential p x) x := by
  apply hasFDerivAt_pi.mpr
  intro i
  by_cases hi:i=p
  · subst i
    convert ((ContinuousLinearMap.proj (R:=ℝ) p : (I→ℝ)→L[ℝ] ℝ).hasFDerivAt).log hx using 1 <;> try rfl
    · funext y
      simp [logCoordinate]
    · simp
  · convert (ContinuousLinearMap.proj (R:=ℝ) i : (I→ℝ)→L[ℝ] ℝ).hasFDerivAt using 1 <;> try rfl
    · funext y
      simp [logCoordinate,hi]
    · simp [hi]

theorem det_logDifferential (p:I) (x:I→ℝ) : (logDifferential p x).det=(x p)⁻¹ := by
  change LinearMap.det (logDifferential p x).toLinearMap = _
  rw [← LinearMap.det_toMatrix']
  have hm : LinearMap.toMatrix' (logDifferential p x).toLinearMap =
      Matrix.diagonal (fun i => if i=p then (x p)⁻¹ else 1) := by
    ext i j
    rw [LinearMap.toMatrix'_apply]
    by_cases hi:i=p <;> by_cases hij:i=j <;>
      simp_all [logDifferential,smul_eq_mul]
  rw [hm,Matrix.det_diagonal]
  simp

/-- The genuine positive-radius version of the actual logarithmic chart. -/
def polarForward (a:I→ℝ) (p:I) (b:ℝ) (x:I→ℝ) : I→ℝ :=
  coordinateForward a p b (logCoordinate p x)

omit [Fintype I] in
theorem polarForward_apply (a:I→ℝ) (p:I) (b:ℝ) (x:I→ℝ) (hx:0<x p) (i:I) :
    polarForward a p b x i=(x p)^(a i)*(if i=p then b else x i) := by
  rw [polarForward,coordinateForward_apply]
  by_cases hi:i=p
  · simp only [logCoordinate,Function.update_self,ite_eq_left hi]
    rw [Real.rpow_def_of_pos hx]
  · simp only [logCoordinate,Function.update_self,ite_eq_right hi,Function.update_of_ne hi]
    rw [Real.rpow_def_of_pos hx]

theorem hasFDerivAt_polarForward (a:I→ℝ) (p:I) (b:ℝ) (x:I→ℝ) (hx:x p≠0) :
    HasFDerivAt (polarForward a p b)
      ((differential a p b (logCoordinate p x)).comp (logDifferential p x)) x :=
  (hasFDerivAt_coordinateForward a p b (logCoordinate p x)).comp x
    (hasFDerivAt_logCoordinate p x hx)

/-- The actual positive-radius Jacobian, derived from genuine derivatives
    in the same literal standard coordinate basis. -/
theorem det_fderiv_polarForward (a:I→ℝ) (p:I) (b:ℝ) (x:I→ℝ) (hx:0<x p) :
    (fderiv ℝ (polarForward a p b) x).det = a p*b*(x p)^((∑ i,a i)-1) := by
  rw [(hasFDerivAt_polarForward a p b x (ne_of_gt hx)).fderiv]
  change LinearMap.det ((differential a p b (logCoordinate p x)).toLinearMap.comp
    (logDifferential p x).toLinearMap) = _
  rw [LinearMap.det_comp]
  change (differential a p b (logCoordinate p x)).det*(logDifferential p x).det = _
  rw [det_logDifferential]
  rw [← (hasFDerivAt_coordinateForward a p b (logCoordinate p x)).fderiv,
    det_fderiv_coordinateForward]
  simp only [logCoordinate,Function.update_self]
  rw [Real.rpow_sub_one (ne_of_gt hx),Real.rpow_def_of_pos hx]
  ring

theorem abs_det_fderiv_polarForward (a:I→ℝ) (p:I) (b:ℝ) (x:I→ℝ) (hx:0<x p) :
    |(fderiv ℝ (polarForward a p b) x).det| = |a p*b| * (x p)^((∑ i,a i)-1) := by
  rw [det_fderiv_polarForward a p b x hx,abs_mul,
    abs_of_pos (Real.rpow_pos_of_pos hx _)]

omit [Fintype I] in
/-- The chart is genuinely injective on the positive-radius half-space. -/
theorem polarForward_injOn (a:I→ℝ) (p:I) {b:ℝ} (hb:b≠0) (ha:a p≠0) :
    InjOn (polarForward a p b) {x | 0<x p} := by
  intro x hx y hy h
  have he := coordinateForward_injective a p hb ha h
  have hp := congrFun he p
  simp only [logCoordinate,Function.update_self] at hp
  have hxy : x p=y p := by
    rw [← Real.exp_log hx,← Real.exp_log hy,hp]
  funext i
  by_cases hi:i=p
  · simpa only [hi] using hxy
  · have hh:=congrFun he i
    simpa only [logCoordinate,Function.update_of_ne hi] using hh

/-- Exact derived weighted radial density in the actual Haar integral. -/
theorem lintegral_image_polarForward (mu:Measure (I→ℝ))
    [Measure.IsAddHaarMeasure mu] (a:I→ℝ) (p:I) {b:ℝ}
    (hb:b≠0) (ha:a p≠0) {U:Set (I→ℝ)} (hU:MeasurableSet U)
    (hpos:∀ x∈U,0<x p) (g:(I→ℝ)→ℝ≥0∞) :
    ∫⁻ y in polarForward a p b '' U,g y ∂mu =
      ∫⁻ x in U,ENNReal.ofReal (|a p*b| * (x p)^((∑ i,a i)-1))*
        g (polarForward a p b x) ∂mu := by
  have hdet : ∀ x∈U, |((differential a p b (logCoordinate p x)).comp
      (logDifferential p x)).det| = |a p*b| * (x p)^((∑ i,a i)-1) := by
    intro x hx
    rw [← (hasFDerivAt_polarForward a p b x (ne_of_gt (hpos x hx))).fderiv,
      abs_det_fderiv_polarForward a p b x (hpos x hx)]
  have hh := MeasureTheory.lintegral_image_eq_lintegral_abs_det_fderiv_mul mu hU
    (fun x hx => (hasFDerivAt_polarForward a p b x (ne_of_gt (hpos x hx))).hasFDerivWithinAt)
    ((polarForward_injOn a p hb ha).mono hpos) g
  rw [hh]
  apply setLIntegral_congr_fun hU
  intro x hx
  change ENNReal.ofReal _ * _ = ENNReal.ofReal _ * _
  rw [hdet x hx]

end MAIS.WeightedPolarJacobian
end

