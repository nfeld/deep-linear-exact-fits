-- ==================== begin module O7.ActualAnnulusRadialOrder (formalization/O7/ActualAnnulusRadialOrder.lean) ====================
section

/-! Actual monotone finite annulus bands imply the complete actual radial
and dyadic-series trichotomy. The saturation cutoff is proved, not assumed. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.ActualAnnulusRadialOrder
open MAIS.ClippedBandComparison MAIS.ClippedRadialModel
open MAIS.DyadicRadialComparison MAIS.DyadicRadialOrder O77.Residual

/-- Complete actual radial integration of a bounded monotone band mass,
from its actual small-level power-log order. -/
theorem radial_trichotomy_of_order {A d : ℕ} (hA : 0<A) (hd : 0<d)
    {B : ℝ→ℝ≥0∞} (hB : Monotone B) {beta : ℝ} {n : ℕ}
    (hp : EThetaZeroPowerLog B beta n) {M : ℝ} (hM : 0<M)
    (hbound : ∀ x,B x≤ENNReal.ofReal M) :
    (beta<(A:ℝ)/(d:ℝ)→EThetaZeroPowerLog (fun eps=>weightedIntegral A d B eps) beta n) ∧
    (beta=(A:ℝ)/(d:ℝ)→EThetaZeroPowerLog (fun eps=>weightedIntegral A d B eps) ((A:ℝ)/(d:ℝ)) (n+1)) ∧
    ((A:ℝ)/(d:ℝ)<beta→EThetaZeroPowerLog (fun eps=>weightedIntegral A d B eps) ((A:ℝ)/(d:ℝ)) 0) := by
  obtain ⟨eta,heta,heta1,htransfer⟩ := radial_order_of_actual_band hB hp hM hbound A d
  obtain ⟨hlt,heq,hgt⟩ := clipped_integral_trichotomy hA hd heta heta1 beta n
  exact ⟨fun h=>htransfer _ _ (hlt h),fun h=>htransfer _ _ (heq h),fun h=>htransfer _ _ (hgt h)⟩

/-- The genuine dyadic series has the same complete three branches. -/
theorem series_trichotomy_of_order {A d : ℕ} (hA : 0<A) (hd : 0<d)
    {B : ℝ→ℝ≥0∞} (hB : Monotone B) {beta : ℝ} {n : ℕ}
    (hp : EThetaZeroPowerLog B beta n) {M : ℝ} (hM : 0<M)
    (hbound : ∀ x,B x≤ENNReal.ofReal M) :
    (beta<(A:ℝ)/(d:ℝ)→EThetaZeroPowerLog (fun eps=>series A d B eps) beta n) ∧
    (beta=(A:ℝ)/(d:ℝ)→EThetaZeroPowerLog (fun eps=>series A d B eps) ((A:ℝ)/(d:ℝ)) (n+1)) ∧
    ((A:ℝ)/(d:ℝ)<beta→EThetaZeroPowerLog (fun eps=>series A d B eps) ((A:ℝ)/(d:ℝ)) 0) := by
  obtain ⟨hlt,heq,hgt⟩ := radial_trichotomy_of_order hA hd hB hp hM hbound
  exact ⟨fun h=>(order_iff hA d B hB _ _).mpr (hlt h),
    fun h=>(order_iff hA d B hB _ _).mpr (heq h),
    fun h=>(order_iff hA d B hB _ _).mpr (hgt h)⟩

/-- A literal finite annulus measure supplies the bound and monotonicity
itself, so no band, integrability or cutoff oracle is a premise. -/
theorem finite_annulus_radial_trichotomy {E : Type*} [MeasurableSpace E]
    (mu : Measure E) (K : Set E) (f : E→ℝ) (hK : mu K≠⊤)
    {A d : ℕ} (hA : 0<A) (hd : 0<d) {beta : ℝ} {n : ℕ}
    (hp : EThetaZeroPowerLog (fun eps=>mu {x | x∈K ∧ f x<eps}) beta n) :
    (beta<(A:ℝ)/(d:ℝ)→EThetaZeroPowerLog
      (fun eps=>weightedIntegral A d (fun e=>mu {x | x∈K ∧ f x<e}) eps) beta n) ∧
    (beta=(A:ℝ)/(d:ℝ)→EThetaZeroPowerLog
      (fun eps=>weightedIntegral A d (fun e=>mu {x | x∈K ∧ f x<e}) eps) ((A:ℝ)/(d:ℝ)) (n+1)) ∧
    ((A:ℝ)/(d:ℝ)<beta→EThetaZeroPowerLog
      (fun eps=>weightedIntegral A d (fun e=>mu {x | x∈K ∧ f x<e}) eps) ((A:ℝ)/(d:ℝ)) 0) := by
  have hmon : Monotone (fun eps:ℝ=>mu {x | x∈K ∧ f x<eps}) := by
    intro a b hab
    exact measure_mono (fun x hx=>⟨hx.1,hx.2.trans_le hab⟩)
  apply radial_trichotomy_of_order hA hd hmon hp
    (show 0<(mu K).toReal+1 by positivity)
  intro eps
  calc
    _ ≤ mu K := measure_mono (fun _ hx=>hx.1)
    _ = ENNReal.ofReal (mu K).toReal := (ENNReal.ofReal_toReal hK).symm
    _ ≤ ENNReal.ofReal ((mu K).toReal+1) := ENNReal.ofReal_le_ofReal (by linarith)

/-- The literal annulus-band dyadic sum version is ready to compose with
an actual homogeneous shell partition. -/
theorem finite_annulus_series_trichotomy {E : Type*} [MeasurableSpace E]
    (mu : Measure E) (K : Set E) (f : E→ℝ) (hK : mu K≠⊤)
    {A d : ℕ} (hA : 0<A) (hd : 0<d) {beta : ℝ} {n : ℕ}
    (hp : EThetaZeroPowerLog (fun eps=>mu {x | x∈K ∧ f x<eps}) beta n) :
    (beta<(A:ℝ)/(d:ℝ)→EThetaZeroPowerLog
      (fun eps=>series A d (fun e=>mu {x | x∈K ∧ f x<e}) eps) beta n) ∧
    (beta=(A:ℝ)/(d:ℝ)→EThetaZeroPowerLog
      (fun eps=>series A d (fun e=>mu {x | x∈K ∧ f x<e}) eps) ((A:ℝ)/(d:ℝ)) (n+1)) ∧
    ((A:ℝ)/(d:ℝ)<beta→EThetaZeroPowerLog
      (fun eps=>series A d (fun e=>mu {x | x∈K ∧ f x<e}) eps) ((A:ℝ)/(d:ℝ)) 0) := by
  have hmon : Monotone (fun eps:ℝ=>mu {x | x∈K ∧ f x<eps}) := by
    intro a b hab
    exact measure_mono (fun x hx=>⟨hx.1,hx.2.trans_le hab⟩)
  obtain ⟨hlt,heq,hgt⟩ := finite_annulus_radial_trichotomy mu K f hK hA hd hp
  exact ⟨fun h=>(order_iff hA d _ hmon _ _).mpr (hlt h),
    fun h=>(order_iff hA d _ hmon _ _).mpr (heq h),
    fun h=>(order_iff hA d _ hmon _ _).mpr (hgt h)⟩

end MAIS.ActualAnnulusRadialOrder
end

/-- info: 'MAIS.ActualAnnulusRadialOrder.radial_trichotomy_of_order' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActualAnnulusRadialOrder.radial_trichotomy_of_order

/-- info: 'MAIS.ActualAnnulusRadialOrder.series_trichotomy_of_order' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActualAnnulusRadialOrder.series_trichotomy_of_order

