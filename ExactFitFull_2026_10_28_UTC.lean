-- ==================== begin module O7.OrbitSliceAnalytic (formalization/O7/OrbitSliceAnalytic.lean) ====================
section

/-! Real-analytic regularity of the genuine full-ambient exponential slice chart
and its actual inverse on a neighborhood of the base representation. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace MAIS.OrbitSliceAnalytic

open MAIS.QuiverRealOrbit MAIS.OrbitSliceLinear MAIS.MatrixSmoothMul MAIS.OrbitSliceChart
open scoped Matrix Matrix.Norms.Frobenius ContDiff Topology

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
variable [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- The literal matrix-exponential slice formula is real analytic everywhere. -/
theorem contDiff_sliceMap (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι)) :
    ContDiff ℝ ω (sliceMap ι A H N) := by
  apply contDiff_iff_contDiffAt.mpr
  intro p
  apply contDiffAt_pi.mpr
  intro e
  let dx (v : Fin (D + 1)) : (H × N) →L[ℝ] Matrix (ι v) (ι v) ℝ :=
    (ContinuousLinearMap.proj v).comp
      (H.subtypeL.comp (ContinuousLinearMap.fst ℝ H N))
  let dy : (H × N) →L[ℝ] Matrix (ι e.succ) (ι e.castSucc) ℝ :=
    (ContinuousLinearMap.proj e).comp
      (N.subtypeL.comp (ContinuousLinearMap.snd ℝ H N))
  have hl : ContDiffAt ℝ ω (fun q => NormedSpace.exp (dx e.succ q)) p := by
    convert (NormedSpace.exp_analytic (𝕂 := ℝ) (dx e.succ p)).contDiffAt.comp p
      (dx e.succ).contDiff.contDiffAt using 1 <;> rfl
  have hm : ContDiffAt ℝ ω (fun q => A e + dy q) p :=
    contDiffAt_const.add dy.contDiff.contDiffAt
  have hr : ContDiffAt ℝ ω (fun q => NormedSpace.exp (-(dx e.castSucc q))) p := by
    convert (NormedSpace.exp_analytic (𝕂 := ℝ) (-(dx e.castSucc p))).contDiffAt.comp p
      (dx e.castSucc).contDiff.contDiffAt.neg using 1 <;> rfl
  convert (contDiffAt_matrix_mul (contDiffAt_matrix_mul hl hm) hr) using 1
  rfl

/-- Analyticity here concerns the actual matrix-entry map. -/
theorem analyticAt_sliceMap (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι)) (p : H × N) :
    AnalyticAt ℝ (sliceMap ι A H N) p :=
  (contDiff_sliceMap ι A H N).contDiffAt.analyticAt

/-- The inverse chart sends the base matrix chain to the actual zero coordinates. -/
@[simp]
theorem sliceChart_symm_base (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (hH : IsCompl H (orbitDifferential ι A).ker)
    (hN : IsCompl (orbitDifferential ι A).range N) :
    (sliceChart ι A H N hH hN).symm A = 0 := by
  have h := (sliceChart ι A H N hH hN).left_inv
    (zero_mem_sliceChart_source ι A H N hH hN)
  simpa only [sliceChart_coe, sliceMap_zero] using h

/-- The actual inverse to the full ambient chart is real analytic at A. -/
theorem analyticAt_sliceChart_symm (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (hH : IsCompl H (orbitDifferential ι A).ker)
    (hN : IsCompl (orbitDifferential ι A).range N) :
    AnalyticAt ℝ (sliceChart ι A H N hH hN).symm A := by
  have hd : HasFDerivAt (sliceChart ι A H N hH hN)
      (sliceDerivativeEquiv ι A H N hH hN : (H × N) →L[ℝ] Rep ι)
      ((sliceChart ι A H N hH hN).symm A) := by
    simpa only [sliceChart_coe, sliceChart_symm_base] using
      (hasStrictFDerivAt_sliceMap ι A H N hH hN).hasFDerivAt
  have hc : ContDiffAt ℝ ω (sliceChart ι A H N hH hN)
      ((sliceChart ι A H N hH hN).symm A) := by
    simpa only [sliceChart_coe] using
      (contDiff_sliceMap ι A H N).contDiffAt
  exact ((sliceChart ι A H N hH hN).contDiffAt_symm
    (base_mem_sliceChart_target ι A H N hH hN) hd hc).analyticAt

/-- Thus some open ambient neighborhood has an analytic inverse at every point. -/
theorem exists_open_analytic_inverse_neighborhood (A : Rep ι)
    (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι))
    (hH : IsCompl H (orbitDifferential ι A).ker)
    (hN : IsCompl (orbitDifferential ι A).range N) :
    ∃ U : Set (Rep ι), IsOpen U ∧ A ∈ U ∧
      U ⊆ (sliceChart ι A H N hH hN).target ∧
      ∀ B ∈ U, AnalyticAt ℝ (sliceChart ι A H N hH hN).symm B := by
  have h := (analyticAt_sliceChart_symm ι A H N hH hN).eventually_analyticAt
  have ht := (sliceChart ι A H N hH hN).open_target.mem_nhds
    (base_mem_sliceChart_target ι A H N hH hN)
  obtain ⟨U, hU, hUo, hAU⟩ := eventually_nhds_iff.mp (h.and ht)
  exact ⟨U, hUo, hAU, fun B hBU => (hU B hBU).2, fun B hBU => (hU B hBU).1⟩

/-- Unconditional full-ambient analytic normal-slice coordinates for every
    finite chain of actual real matrices, including zero-dimensional vertices.
    Both complementary spaces are honest subspaces of the actual entry spaces. -/
theorem exists_full_ambient_analytic_slice (A : Rep ι) :
    ∃ (H : Submodule ℝ (Lie ι)) (N : Submodule ℝ (Rep ι)),
      IsCompl H (orbitDifferential ι A).ker ∧
      IsCompl (orbitDifferential ι A).range N ∧
      ∃ e : OpenPartialHomeomorph (H × N) (Rep ι),
        (e : H × N → Rep ι) = sliceMap ι A H N ∧
        0 ∈ e.source ∧ A ∈ e.target ∧
        (∀ p : H × N, AnalyticAt ℝ e p) ∧
        (∃ U : Set (Rep ι), IsOpen U ∧ A ∈ U ∧ U ⊆ e.target ∧
          ∀ B ∈ U, AnalyticAt ℝ e.symm B) := by
  let H := orbitDirections ι A
  let N := normalSpace ι A
  have hH := orbitDirections_isCompl ι A
  have hN := normalSpace_isCompl ι A
  refine ⟨H, N, hH, hN, sliceChart ι A H N hH hN, rfl,
    zero_mem_sliceChart_source ι A H N hH hN,
    base_mem_sliceChart_target ι A H N hH hN, ?_,
    exists_open_analytic_inverse_neighborhood ι A H N hH hN⟩
  intro p
  simpa only [sliceChart_coe] using analyticAt_sliceMap ι A H N p

end MAIS.OrbitSliceAnalytic
end
