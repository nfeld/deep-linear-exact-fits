-- ==================== begin module O7.WeightedChartJacobian (formalization/O7/WeightedChartJacobian.lean) ====================
section

/-! Literal derivative and exact Jacobian of the actual weighted coordinate
chart, in genuine same-carrier entry coordinates. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000
noncomputable section
open Set MeasureTheory
open scoped Matrix Topology ENNReal
namespace MAIS.WeightedChartJacobian
open MAIS.WeightedCoordinateSlice
variable {I : Type*} [Fintype I] [DecidableEq I]

/-- Actual coordinate separation: the selected input entry is radial and
    every other entry is an independent angular coordinate. -/
def parametersEquiv (p : I) : (I→ℝ)≃ₗ[ℝ] Parameters p where
  toFun x := (x p, fun i => x i.val)
  invFun u := lift p u.1 u.2
  left_inv x := lift_restrict p x
  right_inv u := by
    apply Prod.ext
    · exact lift_same p u.1 u.2
    · funext i
      exact lift_other p u.1 u.2 i
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def parametersContinuousEquiv (p : I) : (I→ℝ)≃L[ℝ] Parameters p :=
  (parametersEquiv p).toContinuousLinearEquiv

/-- The existing actual chart, conjugated by the literal coordinate split. -/
def coordinateForward (a : I→ℝ) (p : I) (b : ℝ) (x : I→ℝ) : I→ℝ :=
  forward a p b (parametersEquiv p x)

omit [Fintype I] in
theorem coordinateForward_apply (a : I→ℝ) (p : I) (b : ℝ) (x : I→ℝ) (i : I) :
    coordinateForward a p b x i =
      Real.exp (x p*a i)*(if i=p then b else x i) := by
  unfold coordinateForward forward dilate parametersEquiv
  simp only [LinearEquiv.coe_mk]
  unfold lift
  split_ifs <;> rfl

/-- The actual derivative as a continuous linear coordinate map. -/
def differential (a : I→ℝ) (p : I) (b : ℝ) (x : I→ℝ) : (I→ℝ)→L[ℝ] (I→ℝ) :=
  ContinuousLinearMap.pi (fun i =>
    if i=p then (b*Real.exp (x p*a i)*a i) • (ContinuousLinearMap.proj (R:=ℝ) p : (I→ℝ)→L[ℝ] ℝ) else
      Real.exp (x p*a i) • (ContinuousLinearMap.proj (R:=ℝ) i : (I→ℝ)→L[ℝ] ℝ) +
        (x i*Real.exp (x p*a i)*a i) • (ContinuousLinearMap.proj (R:=ℝ) p : (I→ℝ)→L[ℝ] ℝ))

theorem hasFDerivAt_coordinateForward (a : I→ℝ) (p : I) (b : ℝ) (x : I→ℝ) :
    HasFDerivAt (coordinateForward a p b) (differential a p b x) x := by
  apply hasFDerivAt_pi.mpr
  intro i
  have he : HasFDerivAt (fun y : I→ℝ => Real.exp (y p*a i))
      (Real.exp (x p*a i) • (a i • (ContinuousLinearMap.proj (R:=ℝ) p : (I→ℝ)→L[ℝ] ℝ))) x := by
    convert (((ContinuousLinearMap.proj (R:=ℝ) p : (I→ℝ)→L[ℝ]ℝ).hasFDerivAt).mul_const (a i)).exp using 1 <;> try rfl
  by_cases hi : i=p
  · have hh := he.mul_const b
    simp_rw [coordinateForward_apply,ite_eq_left hi]
    convert hh using 1 <;> try rfl
    all_goals simp [hi,smul_smul,mul_comm,mul_left_comm]
  · have hh := he.mul (ContinuousLinearMap.proj (R:=ℝ) i : (I→ℝ)→L[ℝ]ℝ).hasFDerivAt
    simp_rw [coordinateForward_apply,ite_eq_right hi]
    convert hh using 1 <;> try rfl
    all_goals simp [smul_smul,mul_comm,mul_left_comm]

/-- The literal derivative matrix is a row-scaled identity with its actual
    selected column replaced by the actual radial derivative vector. -/
def jacobianMatrix (a : I→ℝ) (p : I) (b : ℝ) (x : I→ℝ) : Matrix I I ℝ :=
  Matrix.of fun i j => Real.exp (x p*a i) *
    (Matrix.updateCol (1:Matrix I I ℝ) p
      (fun i => a i*(if i=p then b else x i))) i j

theorem toMatrix_differential (a : I→ℝ) (p : I) (b : ℝ) (x : I→ℝ) :
    LinearMap.toMatrix' (differential a p b x).toLinearMap = jacobianMatrix a p b x := by
  ext i j
  rw [LinearMap.toMatrix'_apply]
  by_cases hi : i=p <;> by_cases hj : j=p <;> by_cases hij : i=j <;>
    simp_all [differential,jacobianMatrix,Matrix.of_apply,Matrix.updateCol_apply,Matrix.one_apply,
      smul_eq_mul] <;> ring

private theorem det_updateCol_one (p : I) (v : I→ℝ) :
    (Matrix.updateCol (1:Matrix I I ℝ) p v).det=v p := by
  simpa [Matrix.one_apply,smul_eq_mul] using
    Matrix.det_updateCol_sum (1:Matrix I I ℝ) p v

/-- Exact actual determinant, with no supplied Jacobian witness. -/
theorem det_jacobianMatrix (a : I→ℝ) (p : I) (b : ℝ) (x : I→ℝ) :
    (jacobianMatrix a p b x).det = a p*b*Real.exp (x p*∑ i,a i) := by
  unfold jacobianMatrix
  rw [Matrix.det_mul_column,det_updateCol_one]
  simp only [ite_true]
  rw [← Real.exp_sum]
  rw [← Finset.mul_sum]
  ring

/-- The determinant is computed from the actual Fréchet derivative in the
    actual standard entry basis, so this is an intrinsic actual Jacobian. -/
theorem det_fderiv_coordinateForward (a : I→ℝ) (p : I) (b : ℝ) (x : I→ℝ) :
    (fderiv ℝ (coordinateForward a p b) x).det =
      a p*b*Real.exp (x p*∑ i,a i) := by
  rw [(hasFDerivAt_coordinateForward a p b x).fderiv]
  change LinearMap.det (differential a p b x).toLinearMap = _
  rw [← LinearMap.det_toMatrix']
  change (LinearMap.toMatrix' (differential a p b x).toLinearMap).det = _
  rw [toMatrix_differential,det_jacobianMatrix]

theorem abs_det_fderiv_coordinateForward (a : I→ℝ) (p : I) (b : ℝ) (x : I→ℝ) :
    |(fderiv ℝ (coordinateForward a p b) x).det| =
      |a p*b| *Real.exp (x p*∑ i,a i) := by
  rw [det_fderiv_coordinateForward,abs_mul,abs_of_pos (Real.exp_pos _)]

omit [Fintype I] in
/-- Injectivity is derived from the actual explicit chart and coordinate
    equivalence, with no injectivity premise on the change of variables. -/
theorem coordinateForward_injective (a : I→ℝ) (p : I) {b:ℝ} (hb:b≠0) (ha:a p≠0) :
    Function.Injective (coordinateForward a p b) := by
  intro x y h
  apply (parametersEquiv p).injective
  have hx := inverse_forward a p hb ha (parametersEquiv p x)
  have hy := inverse_forward a p hb ha (parametersEquiv p y)
  rw [← hx,← hy]
  exact congrArg (inverse a p b) h

/-- The actual chart's exact change-of-variables density for any additive
    Haar measure on the literal same finite coordinate carrier. -/
theorem lintegral_image_coordinateForward (mu : Measure (I→ℝ))
    [Measure.IsAddHaarMeasure mu] (a : I→ℝ) (p : I) {b:ℝ}
    (hb:b≠0) (ha:a p≠0) {U:Set (I→ℝ)} (hU:MeasurableSet U)
    (g:(I→ℝ)→ℝ≥0∞) :
    ∫⁻ y in coordinateForward a p b '' U, g y ∂mu =
      ∫⁻ x in U, ENNReal.ofReal (|a p*b| * Real.exp (x p*∑ i,a i)) *
        g (coordinateForward a p b x) ∂mu := by
  have hdet : ∀ x, |(differential a p b x).det| =
      |a p*b| * Real.exp (x p*∑ i,a i) := by
    intro x
    rw [← (hasFDerivAt_coordinateForward a p b x).fderiv,
      abs_det_fderiv_coordinateForward]
  have h := MeasureTheory.lintegral_image_eq_lintegral_abs_det_fderiv_mul mu hU
    (fun x _ => (hasFDerivAt_coordinateForward a p b x).hasFDerivWithinAt)
    (coordinateForward_injective a p hb ha).injOn g
  simpa only [hdet] using h

end MAIS.WeightedChartJacobian
end

/-- info: 'MAIS.WeightedChartJacobian.hasFDerivAt_coordinateForward' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedChartJacobian.hasFDerivAt_coordinateForward

/-- info: 'MAIS.WeightedChartJacobian.toMatrix_differential' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedChartJacobian.toMatrix_differential

/-- info: 'MAIS.WeightedChartJacobian.det_jacobianMatrix' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedChartJacobian.det_jacobianMatrix

/-- info: 'MAIS.WeightedChartJacobian.det_fderiv_coordinateForward' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedChartJacobian.det_fderiv_coordinateForward

/-- info: 'MAIS.WeightedChartJacobian.abs_det_fderiv_coordinateForward' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedChartJacobian.abs_det_fderiv_coordinateForward

/-- info: 'MAIS.WeightedChartJacobian.coordinateForward_injective' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedChartJacobian.coordinateForward_injective

/-- info: 'MAIS.WeightedChartJacobian.lintegral_image_coordinateForward' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.WeightedChartJacobian.lintegral_image_coordinateForward
end
