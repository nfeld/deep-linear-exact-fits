-- ==================== begin module O7.Run2GeometricLearningCodimension (formalization/O7/Run2GeometricLearningCodimension.lean) ====================
section

/-! The actual measured zero-product learning exponent equals one half of the
independently defined true local Hausdorff codimension. All ordinary real
orbit geometry, zero-cut containment and incidence optimization are derived. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2600000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricLearningCodimension
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.BarcodeActiveNormalForm
open MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalGaussianCoordinates
open MAIS.QuiverIntervalMeasuredNormalForm MAIS.MatrixCoordinateTransport
open MAIS.Run2GeometricZeroFiber MAIS.Run2GeometricCodimension
open MAIS.Run2GeometricClosure MAIS.Run2GeometricFiberInvariance
open MAIS.Run2GeometricOutputCut MAIS.Run2GeometricBalancedAttainer
open MAIS.Run2PotentialBalancedNormalForms MAIS.Run2PotentialBalancedMinimum
open MAIS.AnalyticTransfer

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- The genuine output cut at any actual higher zero orbit supplies a bound
on the true geometric codimension at the chosen base. -/
theorem localCodimNat_le_outputCount_of_normal_form
    (A B : Rep ι) (N : ActiveNormalForm B)
    (hB : pathMatrix B 0 (Fin.last D) (Nat.zero_le D) = 0)
    (hAB : A ∈ closure (MulAction.orbit (Gauge ι) B)) :
    localCodimNat ι A ≤ outputCount D N.birth N.death := by
  have hCzero := intervalRep_zero_of_original_zero N
    0 (Fin.last D) (Nat.zero_le D) hB
  calc
    localCodimNat ι A ≤ localCodimNat ι B :=
      localCodimNat_mono_of_mem_closure_orbit ι hAB
    _ = localCodimNat ι (transport N.coordinates (intervalRep D N.birth N.death)) :=
      localCodimNat_eq_of_mem_orbit N.original_in_orbit
    _ = localCodimNat (Index D N.birth N.death) (intervalRep D N.birth N.death) :=
      localCodimNat_coordinate N.coordinates (intervalRep D N.birth N.death)
    _ ≤ outputCount D N.birth N.death :=
      localCodimNat_le_outputCount D N.birth N.death N.bounded N.valid hCzero

/-- The independently defined balanced incidence minimum equals the true
geometric local codimension; neither side is defined using the other. -/
theorem localCodimNat_eq_balancedOutputMinimum
    (A : Rep ι) (hA : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    localCodimNat ι A = balancedOutputMinimum ι A := by
  apply le_antisymm
  · obtain ⟨B, N, hB, hAB, _, hcount⟩ := balancedOutputMinimum_mem ι A hA
    rw [hcount]
    exact localCodimNat_le_outputCount_of_normal_form ι A B N hB hAB
  · obtain ⟨B, hB, hAB, hdim, hmax⟩ := exists_orbit_realizing_localDimH ι hA
    have hcod : localCodimNat ι A = Module.finrank ℝ (Rep ι) -
        Module.finrank ℝ (MAIS.OrbitSliceLinear.orbitDifferential ι B).range := by
      simp only [localCodimNat, hdim, ENNReal.toReal_natCast, Nat.floor_natCast]
    obtain ⟨N⟩ := exists_normal_form B
    let _ : IsEmpty (ResidualIndex D N.birth N.death) :=
      isEmpty_residual_of_maximal_rank A B N hB hAB hmax
    have hbal : Balanced D N.birth N.death :=
      balanced_of_isEmpty_residual D N.birth N.death
    have hout := outputCount_eq_cardNormal_of_isEmpty_residual D N.birth N.death
    have hcount : localCodimNat ι A = outputCount D N.birth N.death :=
      hcod.trans ((normal_count_eq_cokernel B N).symm.trans hout.symm)
    have hmem : localCodimNat ι A ∈ balancedOutputCounts ι A :=
      ⟨B, N, hB, hAB, hbal, hcount⟩
    exact (isLeast_csInf (balancedOutputCounts_nonempty ι A hA)).2 hmem

/-- Actual Haar sublevel exponent and actual geometric local codimension. -/
theorem exponent_eq_half_localCodimNat
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hA : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    lam = (localCodimNat ι A : ℝ) / 2 := by
  rw [localCodimNat_eq_balancedOutputMinimum ι A hA]
  exact exponent_eq_half_balancedOutputMinimum ι mu A hA hp

theorem two_mul_exponent_eq_localCodimNat
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hA : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    2 * lam = (localCodimNat ι A : ℝ) := by
  have h := exponent_eq_half_localCodimNat ι mu A hA hp
  linarith

/-- Literal original-entry Euclidean half-squared loss and any coupled
continuous prior positive at the center have the same geometric exponent. -/
theorem entry_half_prior_exponent_eq_half_localCodimNat
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hA : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1 / 2 : ℝ) * ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2)
      A lam m) :
    lam = (localCodimNat ι A : ℝ) / 2 := by
  rw [localCodimNat_eq_balancedOutputMinimum ι A hA]
  exact entry_half_prior_exponent_eq_half_balancedOutputMinimum
    ι mu A hA prior hprior hpos hp

end MAIS.Run2GeometricLearningCodimension

/-- info: 'MAIS.Run2GeometricLearningCodimension.localCodimNat_le_outputCount_of_normal_form' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricLearningCodimension.localCodimNat_le_outputCount_of_normal_form

/-- info: 'MAIS.Run2GeometricLearningCodimension.localCodimNat_eq_balancedOutputMinimum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricLearningCodimension.localCodimNat_eq_balancedOutputMinimum

/-- info: 'MAIS.Run2GeometricLearningCodimension.exponent_eq_half_localCodimNat' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricLearningCodimension.exponent_eq_half_localCodimNat

/-- info: 'MAIS.Run2GeometricLearningCodimension.two_mul_exponent_eq_localCodimNat' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricLearningCodimension.two_mul_exponent_eq_localCodimNat

/-- info: 'MAIS.Run2GeometricLearningCodimension.entry_half_prior_exponent_eq_half_localCodimNat' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricLearningCodimension.entry_half_prior_exponent_eq_half_localCodimNat
end
end
