    join k (diagonalVelocity a, angularEntries a) = a := by
  funext ij
  rcases ij with ⟨⟨i, j⟩, hij⟩
  by_cases heq : i = j
  · subst j
    exact join_diagonal _ _ i
  · exact join_strictUpper _ _ ⟨(i, j), lt_of_le_of_ne hij heq⟩

