-- ==================== begin module O7.Run2PositiveAllDepthExistence (formalization/O7/Run2PositiveAllDepthExistence.lean) ====================
section

/-! All-depth pointed measured pair existence. At depth zero the actual path
product is constant and its actual pair is neutral; the positive-depth rank
suspension is never applied to that case. -/
set_option autoImplicit false
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PositiveAllDepthExistence
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.AnalyticTransfer

/-- With no arrows the actual complete product is independent of all
parameters (the identity after identifying the unique vertex). -/
theorem completeProduct_depth_zero
    (ι : Fin 1 → Type*) [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)] (A B : Rep ι) :
    pathMatrix A 0 (Fin.last 0) (Nat.zero_le 0) =
      pathMatrix B 0 (Fin.last 0) (Nat.zero_le 0) := by
  exact congrArg (fun C : Rep ι => pathMatrix C 0 (Fin.last 0) (Nat.zero_le 0))
    (Subsingleton.elim A B)

/-- The actual pointed loss is identically zero at depth zero, so its true
Haar pair is (0,1), including empty vertex spaces. -/
theorem neutral_pair_depth_zero
    (ι : Fin 1 → Type*) [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last 0) (Nat.zero_le 0)-
        pathMatrix A 0 (Fin.last 0) (Nat.zero_le 0)‖^2) A 0 1 := by
  have hf : (fun B : Rep ι => ‖pathMatrix B 0 (Fin.last 0) (Nat.zero_le 0)-
      pathMatrix A 0 (Fin.last 0) (Nat.zero_le 0)‖^2) = fun _ => (0:ℝ) := by
    funext B
    rw [completeProduct_depth_zero ι B A,sub_self,norm_zero]
    norm_num
  rw [hf]
  exact MAIS.LinearObservationTransfer.constant_pair mu A 0

variable {D : ℕ} (ι : Fin (D+1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

/-- Every actual real rectangular chain at every finite depth has a unique
actual pointed complete-product Haar pair. Positive-depth and constant
zero-depth cases are proved separately. -/
theorem exists_unique_pair_pointed
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι) :
    ∃! p : ℝ×ℕ,HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-
        pathMatrix A 0 (Fin.last D) (Nat.zero_le D)‖^2) A p.1 p.2 := by
  by_cases hD : 0<D
  · exact MAIS.Run2PositivePairExistence.exists_unique_pair_exact_fit
      ι hD mu A (pathMatrix A 0 (Fin.last D) (Nat.zero_le D)) rfl
  · have hz : D=0 := by omega
    subst D
    have hp := neutral_pair_depth_zero ι mu A
    refine ⟨(0,1),hp,?_⟩
    rintro ⟨a,m⟩ ha
    obtain ⟨h1,h2⟩ := O77.PowerLogUniqueness.radius_order_unique ha hp
    exact Prod.ext h1 h2

end MAIS.Run2PositiveAllDepthExistence

/-- info: 'MAIS.Run2PositiveAllDepthExistence.completeProduct_depth_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveAllDepthExistence.completeProduct_depth_zero

/-- info: 'MAIS.Run2PositiveAllDepthExistence.neutral_pair_depth_zero' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveAllDepthExistence.neutral_pair_depth_zero

/-- info: 'MAIS.Run2PositiveAllDepthExistence.exists_unique_pair_pointed' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveAllDepthExistence.exists_unique_pair_pointed
end
end
-- ==================== end module O7.Run2PositiveAllDepthExistence ====================

-- ==================== begin module O7.Run2ArithmeticPositive (formalization/O7/Run2ArithmeticPositive.lean) ====================
section

/-! Complete executable arithmetic exact-fit pair correctness on the actual
original entry carrier, at every finite depth. Normal forms are derived in
the proof only; the program consumes just original integer dimensions and
consecutive path ranks. No residual ranks or measured answer are supplied. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2ArithmeticPositive
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.BarcodeActiveNormalForm
open MAIS.Run2BarcodeEnumeration MAIS.Run2ArithmeticPositiveData
open MAIS.Run2ArithmeticPositiveResidualCarrier MAIS.Run2PositivePairFormula
open MAIS.Run2ArithmeticCriticalPathData MAIS.Run2ArithmeticCriticalPathMeasuredStep
open MAIS.Run2FullSpanProduct MAIS.Run2FullSpanCoordinates
open MAIS.QuiverCoordinateMeasuredPair MAIS.AnalyticTransfer
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

local instance matrixSecondCountable (I J : Type*) [Fintype I] [Fintype J] :
    SecondCountableTopology (Matrix I J ℝ) :=
  inferInstanceAs (SecondCountableTopology (I → J → ℝ))

theorem regularCoefficient_eq (A : Rep ι) :
    regularCoefficient (architecture ι) (originalRank A) =
      MAIS.Run2PositiveNormalFormCounts.regularCount A := by
  rw [regularCoefficient, originalRank_eq]
  rfl

/-- The true reduced zero chain identifies the pure residual program
output. This is derived by actual coordinate transport and measured
correctness; no numerical output is a hypothesis or a program definition. -/
theorem residualPairs_eq {A : Rep ι} (N : ActiveNormalForm A) :
    residualPairs (architecture ι) (pathRankInput ι A) (originalRank A) =
      {(residualMinimum N, 1 + residualCriticalDepth N)} := by
  let muR : Measure (Rep (ReducedCarrier N)) := addHaar
  let muC : Measure (Rep (CanonicalCarrier A)) := addHaar
  have hzR := reduced_base_completeProduct_zero D N.birth N.death N.bounded
  have hpR : NativePair (ReducedCarrier N) muR (reducedBase N)
      ((residualMinimum N : ℝ) / 2) (1 + residualCriticalDepth N) :=
    (MAIS.Run2PotentialCriticalPath.actual_pair_iff (ReducedCarrier N) muR
      (reducedBase N) hzR _ _).mpr ⟨rfl, rfl⟩
  have hpC := (pair_iff_coordinate_transport (residualCoordinates N) muR muC
    (reducedBase N) 0 (Fin.last D) (Nat.zero_le D)
    ((residualMinimum N : ℝ) / 2) (1 + residualCriticalDepth N)).mp hpR
  obtain ⟨c, m, hset, hp⟩ := MAIS.Run2ArithmeticCriticalPathFast.computedPairs_nonempty_singleton
    (CanonicalCarrier A) muC (residualPoint N) (residualPoint_zero N)
  have hv := O77.PowerLogUniqueness.radius_order_unique hp hpC
  have hc : c = residualMinimum N := by
    have hh : (c : ℝ) = (residualMinimum N : ℝ) := by linarith [hv.1]
    exact_mod_cast hh
  rw [canonical_computedPairs N] at hset
  simpa only [hc, hv.2] using hset

theorem exactFitPairs_eq (hD : 0 < D) {A : Rep ι} (N : ActiveNormalForm A) :
    exactFitPairs (architecture ι) (pathRankInput ι A) =
      {(MAIS.Run2PositiveNormalFormCounts.regularCount A + residualMinimum N,
        1 + residualCriticalDepth N)} := by
  rw [exactFitPairs, ite_eq_right (Nat.ne_of_gt hD)]
  change (residualPairs (architecture ι) (pathRankInput ι A) (originalRank A)).image
    (fun p => (regularCoefficient (architecture ι) (originalRank A) + p.1, p.2)) = _
  rw [residualPairs_eq ι N, Finset.image_singleton]
  change {(regularCoefficient (architecture ι) (originalRank A) + residualMinimum N,
    1 + residualCriticalDepth N)} = _
  rw [regularCoefficient_eq]

theorem pointed_pair_iff_positive_depth
    (hD : 0 < D) (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D) -
        pathMatrix A 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m ↔
      ∃ c : ℕ, (c, m) ∈ exactFitPairs (architecture ι) (pathRankInput ι A) ∧
        lam = (c : ℝ) / 2 := by
  let N : ActiveNormalForm A := Classical.choice (exists_normal_form A)
  rw [MAIS.Run2PositivePairFormula.pair_iff_formula hD N mu lam m,
    exactFitPairs_eq ι hD N]
  simp only [Finset.mem_singleton, Prod.mk.injEq]
  constructor
  · rintro ⟨hl, hm⟩
    exact ⟨_, ⟨rfl, hm⟩, hl⟩
  · rintro ⟨c, ⟨hc, hm⟩, hl⟩
    subst c
    exact ⟨hl, hm⟩

/-- At ANY actual point and ANY finite depth the pointed complete-product
pair is computed from the original integer dimension and path-rank table.
The depth-zero neutral branch is proved separately from the suspension. -/
theorem pointed_pair_iff
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D) -
        pathMatrix A 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m ↔
      ∃ c : ℕ, (c, m) ∈ exactFitPairs (architecture ι) (pathRankInput ι A) ∧
        lam = (c : ℝ) / 2 := by
  by_cases hD : 0 < D
  · exact pointed_pair_iff_positive_depth ι hD mu A lam m
  · have hz : D = 0 := by omega
    subst D
    have hp := MAIS.Run2PositiveAllDepthExistence.neutral_pair_depth_zero ι mu A
    have he : HasMeasuredBandPair mu (Metric.ball A)
        (fun B => ‖pathMatrix B 0 (Fin.last 0) (Nat.zero_le 0) -
          pathMatrix A 0 (Fin.last 0) (Nat.zero_le 0)‖ ^ 2) A lam m ↔ lam = 0 ∧ m = 1 := by
      constructor
      · intro h
        exact O77.PowerLogUniqueness.radius_order_unique h hp
      · rintro ⟨rfl, rfl⟩
        exact hp
    rw [he]
    simp [exactFitPairs, and_comm]

/-- Every literal exact fit for every actual real target is covered; the
complete-product rank input is then the actual target matrix rank. -/
theorem exact_fit_pair_iff
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = target)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D) - target‖ ^ 2) A lam m ↔
      ∃ c : ℕ, (c, m) ∈ exactFitPairs (architecture ι) (pathRankInput ι A) ∧
        lam = (c : ℝ) / 2 := by
  simpa only [hfit] using pointed_pair_iff ι mu A lam m

/-- Literal original-entry half loss with any coupled source prior
continuous and positive at the center obeys the same proof-free program. -/
theorem entry_half_prior_pair_iff
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (target : Matrix (ι (Fin.last D)) (ι 0) ℝ)
    (hfit : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = target)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1 / 2 : ℝ) * ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D) - target‖ ^ 2)
      A lam m ↔ ∃ c : ℕ, (c, m) ∈ exactFitPairs (architecture ι) (pathRankInput ι A) ∧
        lam = (c : ℝ) / 2 := by
  let f : Rep ι → ℝ := fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D) - target‖ ^ 2
  have hs := MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_positive_scale mu
    (Metric.ball A) (fun _ _ h => Metric.ball_subset_ball h) f A (1 / 2 : ℝ) (by norm_num) lam m
  have hf : Measurable (fun B : Rep ι => (1 / 2 : ℝ) * f B) :=
    measurable_const.mul (((continuous_pathMatrix 0 (Fin.last D) (Nat.zero_le D)).sub
      continuous_const).norm.pow 2).measurable
  have hp := MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior mu hf hprior hpos
    (lam := lam) (m := m)
  have hw := MAIS.MatrixChainEntryWindows.pair_iff_entryBall ι
    (mu.withDensity (fun B => ENNReal.ofReal (prior B))) A
    (f := fun B => (1 / 2 : ℝ) * f B) (lam := lam) (m := m)
  exact ((hs.trans hp).trans hw).symm.trans (exact_fit_pair_iff ι mu A target hfit lam m)

/-- The full integer-input program returns exactly one actual pair on every
actual original rank table, at all depths and with no supplied normal form. -/
theorem exactFitPairs_nonempty_singleton
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A : Rep ι) :
    ∃ c m : ℕ, exactFitPairs (architecture ι) (pathRankInput ι A) = {(c, m)} ∧
      HasMeasuredBandPair mu (Metric.ball A)
        (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D) -
          pathMatrix A 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A ((c : ℝ) / 2) m := by
  obtain ⟨⟨a, n⟩, hp, _⟩ := MAIS.Run2PositiveAllDepthExistence.exists_unique_pair_pointed ι mu A
  obtain ⟨c, hc, ha⟩ := (pointed_pair_iff ι mu A a n).mp hp
  have hpc := hp
  rw [ha] at hpc
  refine ⟨c, n, Finset.eq_singleton_iff_unique_mem.mpr ⟨hc, ?_⟩, hpc⟩
  rintro ⟨b, m⟩ hbm
  have hpb := (pointed_pair_iff ι mu A ((b : ℝ) / 2) m).mpr ⟨b, hbm, rfl⟩
  have hv := O77.PowerLogUniqueness.radius_order_unique hpb hpc
  have hbc : b = c := by
    have hh : (b : ℝ) = (c : ℝ) := by linarith [hv.1]
    exact_mod_cast hh
  exact Prod.ext hbc hv.2

end MAIS.Run2ArithmeticPositive

/-- info: 'MAIS.Run2ArithmeticPositive.residualPairs_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositive.residualPairs_eq

/-- info: 'MAIS.Run2ArithmeticPositive.exactFitPairs_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositive.exactFitPairs_eq

/-- info: 'MAIS.Run2ArithmeticPositive.pointed_pair_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositive.pointed_pair_iff

/-- info: 'MAIS.Run2ArithmeticPositive.exact_fit_pair_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositive.exact_fit_pair_iff

/-- info: 'MAIS.Run2ArithmeticPositive.entry_half_prior_pair_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticPositive.entry_half_prior_pair_iff

/-- info: 'MAIS.Run2ArithmeticPositive.exactFitPairs_nonempty_singleton' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
