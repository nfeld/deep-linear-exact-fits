-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverDirectSumRanks.path_rank_directSum

/--
info: 'MAIS.QuiverDirectSumRanks.closure_transfer_of_path_rank_eq' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.QuiverDirectSumRanks.closure_transfer_of_path_rank_eq
end
