      (∫ x : Fin d → ℝ, gramTest rho T (∑ i, (x i) ^ 2)
        ∂coordinateLebesgue (Fin d)) =
      ∫ x : EuclideanSpace ℝ (Fin d), gramTest rho T (‖x‖ ^ 2) := by
    rw [← he.map_eq]
    rw [integral_map he.measurable.aemeasurable
      (gramTest_continuous_norm_sq rho hT).aestronglyMeasurable]
