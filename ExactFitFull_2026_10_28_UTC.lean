-- ==================== begin module O7.ActiveIntervalMeasuredSlice (formalization/O7/ActiveIntervalMeasuredSlice.lean) ====================
section

/-! Actual Haar band-pair reduction from all ambient interval matrix entries
through the genuine analytic chart to its independent scalar normal loss. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory MeasureTheory.Measure
open scoped Topology ENNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.ActiveIntervalMeasuredSlice
open MAIS.QuiverRealOrbit MAIS.ActiveIntervalDifferential MAIS.MatrixChainIsomorphism
open MAIS.ActiveIntervalSliceChart MAIS.AnalyticTransfer
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D+1)

abbrev Ambient := Rep (Index D birth death)
abbrev Normal := MAIS.IntervalCochainProduct.NormalParams birth death
abbrev Parameters := TangentParameters D birth death × Normal birth death

/-- The literal squared Frobenius norm of an actual consecutive product. -/
def ambientLoss (i j : Fin (D+1)) (hij : i ≤ j) (A : Ambient D birth death) : ℝ :=
  ‖pathMatrix A i j hij‖ ^ 2

/-- The literal loss on the actual independent physical entrance parameters. -/
def normalLoss (i j : Fin (D+1)) (hij : i ≤ j) (t : Normal birth death) : ℝ :=
  ambientLoss D birth death i j hij
    (intervalRep D birth death + MAIS.ActiveIntervalNormal.normalInjection D birth death hD t)

theorem continuous_ambientLoss (i j : Fin (D+1)) (hij : i ≤ j) :
    Continuous (ambientLoss D birth death i j hij) :=
  (continuous_pathMatrix i j hij).norm.pow 2

theorem continuous_normalLoss (i j : Fin (D+1)) (hij : i ≤ j) :
    Continuous (normalLoss D birth death hD i j hij) := by
  apply (continuous_ambientLoss D birth death i j hij).comp
  exact continuous_const.add
    (MAIS.ActiveIntervalNormal.normalInjection D birth death hD).toContinuousLinearMap.continuous

/-- A genuine zero-output base is the only loss condition. Actual chart
regularity, volume distortion, carrier equivalence and spectators are derived. -/
theorem pair_iff_normal_slice
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muN : Measure (Normal birth death)) [Measure.IsAddHaarMeasure muN]
    (i j : Fin (D+1)) (hij : i ≤ j)
    (hzero : pathMatrix (intervalRep D birth death) i j hij = 0)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair muA (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death i j hij) (intervalRep D birth death) lam m ↔
    HasMeasuredBandPair muN (Metric.ball 0)
      (normalLoss D birth death hD i j hij) 0 lam m := by
  let P := Parameters D birth death
  let muP : Measure P := addHaar
  let e := parameterChart D birth death hD hvalid
  let f : P → ℝ := fun p => ambientLoss D birth death i j hij (e p)
  let g : P → ℝ := fun p => normalLoss D birth death hD i j hij p.2
  have he0 : e (0 : P) = intervalRep D birth death := by
    change parameterChart D birth death hD hvalid (0,0) = _
    simpa only [map_zero, add_zero] using
      parameterChart_normal D birth death hD hvalid (0 : Normal birth death)
  have he : Continuous e := continuous_iff_continuousAt.mpr
    (fun p => (analyticAt_parameterChart D birth death hD hvalid p).continuousAt)
  have hf : Measurable f := (continuous_ambientLoss D birth death i j hij).measurable.comp
    he.measurable
  have hchart := MAIS.CrossCarrierChartTransfer.pair_iff_of_chart_local muP muA e
    (zero_mem_parameterChart_source D birth death hD hvalid)
    (analyticAt_parameterChart D birth death hD hvalid 0).contDiffAt
    (by simpa only [he0] using
      (analyticAt_parameterChart_symm D birth death hD hvalid).contDiffAt)
    hf (continuous_ambientLoss D birth death i j hij).measurable
    (fun _ _ => rfl) (lam := lam) (m := m)
  rw [he0] at hchart
  have hA0 : ambientLoss D birth death i j hij (intervalRep D birth death) = 0 := by
    simp only [ambientLoss, hzero, norm_zero, zero_pow (by decide : 2 ≠ 0)]
  have hf0 : f 0 = 0 := by change ambientLoss D birth death i j hij (e 0) = 0; rw [he0, hA0]
  have hg0 : g 0 = 0 := by
    change normalLoss D birth death hD i j hij 0 = 0
    simpa only [normalLoss, map_zero, add_zero] using hA0
  obtain ⟨C, hC, hc⟩ := exists_local_squared_norm_comparison D birth death hD hvalid i j hij
  obtain ⟨rho, hrho, hball⟩ := Metric.eventually_nhds_iff.mp hc
  have hcompare : ∀ p ∈ Metric.ball (0 : P) rho,
      (1/C) * |g p - g 0| ≤ |f p - f 0| ∧
      |f p - f 0| ≤ C * |g p - g 0| := by
    intro p hp
    have hh := hball hp
    have hfp : 0 ≤ f p := sq_nonneg _
    have hgp : 0 ≤ g p := sq_nonneg _
    rw [hg0, hf0, sub_zero, sub_zero, abs_of_nonneg hgp, abs_of_nonneg hfp]
    constructor
    · simpa only [f, g, e, normalLoss, ambientLoss, one_div, div_eq_mul_inv,
        mul_comm, mul_one, one_mul] using hh.1
    · exact hh.2
  have hcmp := MAIS.AnalyticTransfer.pair_iff_of_local_comparison
    (mu := muP) (windows := Metric.ball (0 : P)) (f := g) (g := f)
    (fun _ _ hab => Metric.ball_subset_ball hab) hrho (one_div_pos.mpr hC) hC hcompare
    (lam := lam) (m := m)
  let q : P →L[ℝ] Normal birth death := ContinuousLinearMap.snd ℝ _ _
  have hq : Function.Surjective q := fun t => ⟨(0,t), rfl⟩
  have hobs := MAIS.LinearObservationTransfer.pair_iff_surjective_observation muP muN
    q hq 0 (continuous_normalLoss D birth death hD i j hij).measurable (lam := lam) (m := m)
  exact hchart.symm.trans (hcmp.symm.trans hobs)

/-- The actual ambient prior may be any density continuous and positive at
this matrix chain; it is not required to factor in slice coordinates. -/
theorem pair_iff_normal_slice_prior
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (muN : Measure (Normal birth death)) [Measure.IsAddHaarMeasure muN]
    (i j : Fin (D+1)) (hij : i ≤ j)
    (hzero : pathMatrix (intervalRep D birth death) i j hij = 0)
    (prior : Ambient D birth death → ℝ)
    (hprior : ContinuousAt prior (intervalRep D birth death))
    (hpos : 0 < prior (intervalRep D birth death)) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair (muA.withDensity (fun A => ENNReal.ofReal (prior A)))
      (Metric.ball (intervalRep D birth death)) (ambientLoss D birth death i j hij)
      (intervalRep D birth death) lam m ↔
    HasMeasuredBandPair muN (Metric.ball 0)
      (normalLoss D birth death hD i j hij) 0 lam m :=
  (MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior muA
    (continuous_ambientLoss D birth death i j hij).measurable hprior hpos).symm.trans
    (pair_iff_normal_slice D birth death hD hvalid muA muN i j hij hzero lam m)

end MAIS.ActiveIntervalMeasuredSlice
end

/--
info: 'MAIS.ActiveIntervalMeasuredSlice.continuous_ambientLoss' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalMeasuredSlice.continuous_ambientLoss

/--
info: 'MAIS.ActiveIntervalMeasuredSlice.continuous_normalLoss' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalMeasuredSlice.continuous_normalLoss

/--
info: 'MAIS.ActiveIntervalMeasuredSlice.pair_iff_normal_slice' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalMeasuredSlice.pair_iff_normal_slice

/--
info: 'MAIS.ActiveIntervalMeasuredSlice.pair_iff_normal_slice_prior' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ActiveIntervalMeasuredSlice.pair_iff_normal_slice_prior
end
-- ==================== end module O7.ActiveIntervalMeasuredSlice ====================

-- ==================== begin module O7.Run2PositiveIntervalSuspension (formalization/O7/Run2PositiveIntervalSuspension.lean) ====================
section

/-! Genuine positive-target suspension for actual interval families. All full-span
splitting and normal complements are derived from actual interval coordinates;
the residual input is precisely an actual measured pair of the reduced chain. -/
set_option autoImplicit false
set_option maxHeartbeats 1800000
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius Topology
namespace MAIS.Run2PositiveIntervalSuspension
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.ActiveIntervalDifferential MAIS.Run2FullSpanCoordinates MAIS.Run2FullSpanProduct
open MAIS.Run2FullSpanSlice MAIS.Run2PositiveNetworkLoss MAIS.AnalyticTransfer
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D+1)

local instance matrixSecondCountable (I J : Type*) [Fintype I] [Fintype J] :
    SecondCountableTopology (Matrix I J ℝ) :=
  inferInstanceAs (SecondCountableTopology (I → J → ℝ))

/-- The residual in the actual transported normal subspace is literally the
complete product in the reduced independent entrance parameters. -/
theorem normalResidual_reduced (t : MAIS.IntervalCochainProduct.NormalParams
    (reducedBirth D birth death) (reducedDeath D birth death)) :
    normalResidual (ReducedIndex D birth death) (splitBase D birth death)
      (splitNormalSpace D birth death hD) (reducedNormalParamEquiv D birth death hD t) =
    pathMatrix (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death) +
      MAIS.ActiveIntervalNormal.normalInjection D (reducedBirth D birth death)
        (reducedDeath D birth death) (reduced_bound D birth death hD) t)
      0 (Fin.last D) (Nat.zero_le D) := by
  unfold normalResidual
  rw [reduced_normal_completeProduct]
  exact Matrix.toBlocks_fromBlocks₂₂ _ _ _ _

/-- Every actual reduced ambient pair yields an actual pair in the literal
transported normal subspace. Both Haar factors and all spectators are derived. -/
theorem normal_pair_of_reduced_pair
    (hvalid : ∀ s, birth s < death s)
    (muRed : Measure (Rep (ReducedIndex D birth death))) [Measure.IsAddHaarMeasure muRed]
    (muN : Measure (splitNormalSpace D birth death hD)) [Measure.IsAddHaarMeasure muN]
    {a : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair muRed
      (Metric.ball (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death)))
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2)
      (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death)) a m) :
    HasMeasuredBandPair muN (Metric.ball 0)
      (fun x => ‖normalResidual (ReducedIndex D birth death) (splitBase D birth death)
        (splitNormalSpace D birth death hD) x‖^2) 0 a m := by
  let N := splitNormalSpace D birth death hD
  let _ : ProperSpace N := FiniteDimensional.proper ℝ N
  let _ : SecondCountableTopology N := secondCountable_of_proper
  let muT : Measure (MAIS.IntervalCochainProduct.NormalParams
    (reducedBirth D birth death) (reducedDeath D birth death)) := addHaar
  have hred := (MAIS.ActiveIntervalMeasuredSlice.pair_iff_normal_slice D
    (reducedBirth D birth death) (reducedDeath D birth death) (reduced_bound D birth death hD)
    (fun s => hvalid s.val) muRed muT 0 (Fin.last D) (Nat.zero_le D)
    (reduced_base_completeProduct_zero D birth death hD) a m).mp hp
  have ht := MAIS.LinearObservationTransfer.pair_iff_haar_linear muT muN
    (reducedNormalParamEquiv D birth death hD) 0
    ((continuous_normalResidual (ReducedIndex D birth death) (splitBase D birth death)
      (splitNormalSpace D birth death hD)).norm.pow 2).measurable
    (g := fun x => ‖normalResidual (ReducedIndex D birth death) (splitBase D birth death)
      (splitNormalSpace D birth death hD) x‖^2) (lam:=a) (m:=m)
  simp only [map_zero] at ht
  apply ht.mp
  simp only [normalResidual_reduced]
  exact hred

include hD in
/-- Actual full-span elimination and the genuine retaining chart give the
Gaussian suspension for all interval families at their own complete product.
No structural splitting or complement hypothesis is supplied. -/
theorem pair_of_reduced_pair (hposD : 0 < D)
    (hvalid : ∀ s, birth s < death s)
    (mu : Measure (Rep (Index D birth death))) [Measure.IsAddHaarMeasure mu]
    (muRed : Measure (Rep (ReducedIndex D birth death))) [Measure.IsAddHaarMeasure muRed]
    {a : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair muRed
      (Metric.ball (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death)))
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2)
      (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death)) a m) :
    HasMeasuredBandPair mu (Metric.ball (intervalRep D birth death))
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-
        pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D)‖^2)
      (intervalRep D birth death)
      (a+(Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace
        (FullSlot D birth death) (ReducedIndex D birth death (Fin.last D))
        (ReducedIndex D birth death 0)) : ℝ)/2) m := by
  let A := splitBase D birth death
  let N := splitNormalSpace D birth death hD
  let H := orbitDirections (SplitIndex D birth death) A
  let _ : ProperSpace N := FiniteDimensional.proper ℝ N
  let _ : SecondCountableTopology N := secondCountable_of_proper
  let muA : Measure (Rep (SplitIndex D birth death)) := addHaar
  let muN : Measure N := addHaar
  let muQ : Measure (MAIS.Run2PositiveEndpointRegular.RegularSpace
    (FullSlot D birth death) (ReducedIndex D birth death (Fin.last D))
    (ReducedIndex D birth death 0)) := addHaar
  have hnp := normal_pair_of_reduced_pair D birth death hD hvalid muRed muN hp
  have hs := MAIS.Run2PositiveNetworkMeasured.pair_of_normal_residual_pair
    (ReducedIndex D birth death) hposD A (split_base_completeProduct D birth death hD)
    H N (orbitDirections_isCompl (SplitIndex D birth death) A)
    (splitNormalSpace_isCompl D birth death hD hvalid)
    (splitNormalSpace_completeProduct D birth death hD) muA muN muQ hnp
  have hc := MAIS.Run2PositiveCoordinateTransport.pair_iff_coordinate_pointed
    (vertexEquiv D birth death) mu muA (intervalRep D birth death)
    0 (Fin.last D) (Nat.zero_le D)
      (a+(Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace
        (FullSlot D birth death) (ReducedIndex D birth death (Fin.last D))
        (ReducedIndex D birth death 0)) : ℝ)/2) m
  apply hc.mpr
  change HasMeasuredBandPair muA (Metric.ball A)
    (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)-
      pathMatrix A 0 (Fin.last D) (Nat.zero_le D)‖^2) A _ m
  have hbase : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) =
      MAIS.Run2PositiveEndpointRegular.standardTarget := split_base_completeProduct D birth death hD
  rw [hbase]
  exact hs

end MAIS.Run2PositiveIntervalSuspension

