-- ==================== begin module O7.RegularSquareSuspension (formalization/O7/RegularSquareSuspension.lean) ====================
section

/-! Radius-first measured pairs for literal independent nonnegative sums.
The product sublevel inclusions are proved in the actual product measure;
no convolution formula or assigned learning exponent is assumed. -/

set_option autoImplicit false
noncomputable section
open Set MeasureTheory
open scoped ENNReal
namespace MAIS.RegularSquareSuspension
open MAIS.AnalyticTransfer

variable {E F : Type*} [PseudoMetricSpace E] [MeasurableSpace E]
  [PseudoMetricSpace F] [MeasurableSpace F]

lemma sum_band_bounds (mu : Measure E) (nu : Measure F) [SigmaFinite nu]
    (f : E → ℝ) (g : F → ℝ) (w : E) (v : F) (R eps : ℝ)
    (hf : ∀ x ∈ Metric.ball w R, 0 ≤ f x - f w)
    (hg : ∀ y ∈ Metric.ball v R, 0 ≤ g y - g v) :
    bandMass mu (Metric.ball w) f w R (eps / 2) *
        bandMass nu (Metric.ball v) g v R (eps / 2) ≤
      bandMass (mu.prod nu) (Metric.ball (w,v)) (fun p => f p.1 + g p.2)
        (w,v) R eps ∧
    bandMass (mu.prod nu) (Metric.ball (w,v)) (fun p => f p.1 + g p.2)
        (w,v) R eps ≤
      bandMass mu (Metric.ball w) f w R eps *
        bandMass nu (Metric.ball v) g v R eps := by
  let A := fun e => {x | x ∈ Metric.ball w R ∧ |f x - f w| < e}
  let B := fun e => {y | y ∈ Metric.ball v R ∧ |g y - g v| < e}
  let C := {p : E × F | p ∈ Metric.ball (w,v) R ∧
    |(f p.1 + g p.2) - (f w + g v)| < eps}
  have hlow : A (eps/2) ×ˢ B (eps/2) ⊆ C := by
    rintro ⟨x,y⟩ ⟨⟨hx,hfx⟩,⟨hy,hgy⟩⟩
    refine ⟨?_, ?_⟩
    · simpa only [Metric.mem_ball, Prod.dist_eq, max_lt_iff] using And.intro hx hy
    · have h := abs_add_le (f x - f w) (g y - g v)
      dsimp
      rw [show f x + g y - (f w + g v) = (f x-f w)+(g y-g v) by ring]
      linarith
  have hupp : C ⊆ A eps ×ˢ B eps := by
    rintro ⟨x,y⟩ ⟨hxy,hfg⟩
    have hh : x ∈ Metric.ball w R ∧ y ∈ Metric.ball v R := by
      simpa only [Metric.mem_ball, Prod.dist_eq, max_lt_iff] using hxy
    have hfx := hf x hh.1
    have hgy := hg y hh.2
    have hsum : 0 ≤ f x+g y-(f w+g v) := by linarith
    rw [abs_of_nonneg hsum] at hfg
    refine ⟨⟨hh.1, ?_⟩,⟨hh.2, ?_⟩⟩
    · rw [abs_of_nonneg hfx]; linarith
    · rw [abs_of_nonneg hgy]; linarith
  constructor
  · have h := measure_mono (μ := mu.prod nu) hlow
    simpa only [C,A,B,Measure.prod_prod,bandMass] using h
  · have h := measure_mono (μ := mu.prod nu) hupp
    simpa only [C,A,B,Measure.prod_prod,bandMass] using h

/-- Independent nonnegative loss germs add exponents and logarithmic degrees,
using literal metric balls, centered losses and the product measure. -/
theorem pair_of_independent_sum
    {mu : Measure E} {nu : Measure F} [SigmaFinite nu]
    {f : E → ℝ} {g : F → ℝ} {w : E} {v : F}
    {a b rho : ℝ} {m n : ℕ}
    (hfp : HasMeasuredBandPair mu (Metric.ball w) f w a m)
    (hgp : HasMeasuredBandPair nu (Metric.ball v) g v b n)
    (hrho : 0 < rho)
    (hf : ∀ x ∈ Metric.ball w rho, 0 ≤ f x - f w)
    (hg : ∀ y ∈ Metric.ball v rho, 0 ≤ g y - g v) :
    HasMeasuredBandPair (mu.prod nu) (Metric.ball (w,v))
      (fun p => f p.1 + g p.2) (w,v) (a+b) (m+n-1) := by
  rcases hfp with ⟨ha,hm,rf,hrf,hfp⟩
  rcases hgp with ⟨hb,hn,rg,hrg,hgp⟩
  refine ⟨add_nonneg ha hb, by omega, min rho (min rf rg),
    lt_min hrho (lt_min hrf hrg), ?_⟩
  intro R hR hsmall
  have hRrho : R < rho := hsmall.trans_le (min_le_left _ _)
  have hRfg := hsmall.trans_le (min_le_right _ _)
  have hp := O77.NormalForm0906.product_order
    (hfp R hR (hRfg.trans_le (min_le_left _ _)))
    (hgp R hR (hRfg.trans_le (min_le_right _ _)))
  have hdeg : m+n-1-1 = (m-1)+(n-1) := by omega
  rw [hdeg]
  have hlower := O77.NormalForm0906.rescale_order hp (show (0:ℝ)<1/2 by norm_num)
  apply O77.Transport0906.order_of_two_window_bounds
    (by simpa only [one_div, div_eq_mul_inv, mul_comm] using hlower)
    hp zero_lt_one zero_lt_one
  intro eps _heps
  simp only [ENNReal.ofReal_one, one_mul]
  exact sum_band_bounds mu nu f g w v R eps
    (fun x hx => hf x (Metric.ball_subset_ball hRrho.le hx))
    (fun y hy => hg y (Metric.ball_subset_ball hRrho.le hy))

section Quadratic
variable {Q : Type*} [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  [FiniteDimensional ℝ Q] [MeasurableSpace Q] [BorelSpace Q]

omit [NormedSpace ℝ Q] [FiniteDimensional ℝ Q] in
lemma quadratic_band_eq_sublevel (nu : Measure Q) (R eps : ℝ) :
    bandMass nu (Metric.ball (0:Q)) (fun x => ‖x‖^2) 0 R eps =
      O77.Residual.sublevelMass (nu.restrict (Metric.ball (0:Q) R))
        (fun x => ‖x‖^2) eps := by
  unfold bandMass O77.Residual.sublevelMass
  rw [Measure.restrict_apply (measurableSet_lt (by fun_prop) measurable_const)]
  congr 1
  ext x
  simp only [norm_zero, zero_pow (by decide : (2:ℕ) ≠ 0), sub_zero,
    abs_of_nonneg (sq_nonneg ‖x‖), mem_ofPred_eq, mem_inter_iff]
  exact and_comm

/-- The actual Haar quadratic block has pair(dim/2,1), including dimension0. -/
theorem quadratic_pair (nu : Measure Q) [Measure.IsAddHaarMeasure nu] :
    HasMeasuredBandPair nu (Metric.ball (0:Q)) (fun x => ‖x‖^2) 0
      ((Module.finrank ℝ Q:ℝ)/2) 1 := by
  refine ⟨by positivity, le_rfl, 1, zero_lt_one, ?_⟩
  intro R hR _
  change O77.Residual.EThetaZeroPowerLog
    (fun eps => bandMass nu (Metric.ball (0:Q)) (fun x => ‖x‖^2) 0 R eps) _ _
  simp_rw [quadratic_band_eq_sublevel]
  exact O77.NormalForm0906.quadratic_ball_order nu hR

/-- Multiplying the actual quadratic loss by a positive scalar preserves
its literal Haar measured pair. -/
theorem quadratic_pair_scaled (nu : Measure Q) [Measure.IsAddHaarMeasure nu]
    (c : ℝ) (hc : 0 < c) :
    HasMeasuredBandPair nu (Metric.ball (0:Q)) (fun x => c*‖x‖^2) 0
      ((Module.finrank ℝ Q:ℝ)/2) 1 := by
  apply MAIS.AnalyticTransfer.pair_of_local_comparison (quadratic_pair nu)
    (fun _ _ h => Metric.ball_subset_ball h) zero_lt_one hc hc
  intro x _
  simp only [norm_zero, zero_pow (by decide : (2:ℕ) ≠ 0), mul_zero, sub_zero,
    abs_mul, abs_of_pos hc]
  exact ⟨le_rfl,le_rfl⟩

/-- Literal independent quadratic suspension of a nonnegative centered germ.
The measure and all small-radius metric windows are the actual product ones;
no regular-block mass estimate is supplied as an assumption. -/
theorem pair_of_quadratic_suspension
    {mu : Measure E} (nu : Measure Q) [Measure.IsAddHaarMeasure nu]
    {f : E → ℝ} {w : E} {a rho : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball w) f w a m)
    (hrho : 0 < rho)
    (hf : ∀ x ∈ Metric.ball w rho, 0 ≤ f x-f w) :
    HasMeasuredBandPair (mu.prod nu) (Metric.ball (w,(0:Q)))
      (fun p => f p.1 + ‖p.2‖^2) (w,0)
      (a+(Module.finrank ℝ Q:ℝ)/2) m := by
  have h := pair_of_independent_sum hp (quadratic_pair nu) hrho hf
    (fun y _ => by simp only [norm_zero, zero_pow (by decide : (2:ℕ) ≠ 0), sub_zero]; positivity)
  simpa only [Nat.add_sub_cancel] using h
/-- The same actual suspension theorem with any positive quadratic scale. -/
theorem pair_of_scaled_quadratic_suspension
    {mu : Measure E} (nu : Measure Q) [Measure.IsAddHaarMeasure nu]
    {f : E → ℝ} {w : E} {a rho : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball w) f w a m)
    (hrho : 0 < rho)
    (hf : ∀ x ∈ Metric.ball w rho, 0 ≤ f x-f w)
    (c : ℝ) (hc : 0 < c) :
    HasMeasuredBandPair (mu.prod nu) (Metric.ball (w,(0:Q)))
      (fun p => f p.1 + c*‖p.2‖^2) (w,0)
      (a+(Module.finrank ℝ Q:ℝ)/2) m := by
  have h := pair_of_independent_sum hp (quadratic_pair_scaled nu c hc) hrho hf
    (fun y _ => by simp only [norm_zero,zero_pow (by decide : (2:ℕ) ≠ 0),mul_zero,sub_zero]; positivity)
  simpa only [Nat.add_sub_cancel] using h

/-- Uniqueness turns the constructed suspension pair into an iff table. -/
theorem pair_iff_scaled_quadratic_suspension
    {mu : Measure E} (nu : Measure Q) [Measure.IsAddHaarMeasure nu]
    {f : E → ℝ} {w : E} {a rho : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball w) f w a m)
    (hrho : 0 < rho)
    (hf : ∀ x ∈ Metric.ball w rho, 0 ≤ f x-f w)
    (c : ℝ) (hc : 0 < c) (lam : ℝ) (n : ℕ) :
    HasMeasuredBandPair (mu.prod nu) (Metric.ball (w,(0:Q)))
      (fun p => f p.1 + c*‖p.2‖^2) (w,0) lam n ↔
      lam = a+(Module.finrank ℝ Q:ℝ)/2 ∧ n=m := by
  have hs := pair_of_scaled_quadratic_suspension nu hp hrho hf c hc
  constructor
  · exact fun h => O77.PowerLogUniqueness.radius_order_unique h hs
  · rintro ⟨rfl,rfl⟩
    exact hs
end Quadratic

end MAIS.RegularSquareSuspension

