-- ==================== begin module O7.Run2PotentialBalancedMinimum (formalization/O7/Run2PotentialBalancedMinimum.lean) ====================
section

/-! The actual zero-output exponent is half an independently defined minimum
of balanced output incidences over genuine higher real orbits. The set being
minimized contains no measured predicate or candidate exponent. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialBalancedMinimum
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.BarcodeActiveNormalForm
open MAIS.QuiverIntervalMeasuredNormalForm MAIS.ActiveIntervalDifferential
open MAIS.Run2PotentialBalancedNormalForms MAIS.Run2PotentialBalancedWitness
open MAIS.Run2PotentialSpecialization MAIS.AnalyticTransfer
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- Independent integer incidence candidates at genuine higher zero-output
orbits, including equality. No exponent or measured-pair predicate occurs. -/
def balancedOutputCounts (A : Rep ι) : Set ℕ :=
  {k | ∃ B : Rep ι, ∃ N : ActiveNormalForm B,
    pathMatrix B 0 (Fin.last D) (Nat.zero_le D) = 0 ∧
    A ∈ closure (MulAction.orbit (Gauge ι) B) ∧
    Balanced D N.birth N.death ∧ k = outputCount D N.birth N.death}

/-- A purely geometric/combinatorial minimum, independently defined using
actual zero products, ordinary real closure and literal normal incidences. -/
def balancedOutputMinimum (A : Rep ι) : ℕ := sInf (balancedOutputCounts ι A)

/-- Every actual measured exponent is half an attained least independently
counted balanced output incidence. Existence of a balanced candidate and its
leastness are conclusions, not assumptions. -/
theorem exists_least_balanced_count
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    ∃ k : ℕ, IsLeast (balancedOutputCounts ι A) k ∧ lam = (k : ℝ) / 2 := by
  obtain ⟨C, NC, hCzero, hAC, hbalC, hcountC, _⟩ :=
    exists_balanced_higher_witness ι mu A hzero hp
  refine ⟨outputCount D NC.birth NC.death,
    ⟨⟨C, NC, hCzero, hAC, hbalC, rfl⟩, ?_⟩, hcountC⟩
  intro k hk
  rcases hk with ⟨B, NB, hBzero, hAB, hbalB, rfl⟩
  obtain ⟨a, n, hBp⟩ := MAIS.QuiverZeroPairExistence.exists_pair_zero_output ι mu B hBzero
  have hmono := exponent_le_of_mem_closure_orbit ι mu A B hzero hBzero hAB hp hBp
  let muK : Measure (Rep (Index D NB.birth NB.death)) := addHaar
  have hKzero := intervalRep_zero_of_original_zero NB 0 (Fin.last D) (Nat.zero_le D) hBzero
  have hKp := (pair_iff_normal_form NB mu muK 0 (Fin.last D) (Nat.zero_le D)
    hBzero a n).mp hBp
  have hbound := ambient_exponent_le_balanced_output_count D NB.birth NB.death NB.bounded
    NB.valid hKzero hbalB muK hKp
  have hr : (outputCount D NC.birth NC.death : ℝ) ≤
      (outputCount D NB.birth NB.death : ℝ) := by linarith
  exact_mod_cast hr

/-- Actual incidence candidates are nonempty on every genuine zero-output
fiber; this follows from actual measured existence and the proved witness. -/
theorem balancedOutputCounts_nonempty
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    (balancedOutputCounts ι A).Nonempty := by
  let mu : Measure (Rep ι) := addHaar
  obtain ⟨lam, m, hp⟩ := MAIS.QuiverZeroPairExistence.exists_pair_zero_output ι mu A hzero
  obtain ⟨k, hk, _⟩ := exists_least_balanced_count ι mu A hzero hp
  exact ⟨k, hk.1⟩

/-- The true independently defined minimum is attained. -/
theorem balancedOutputMinimum_mem
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    balancedOutputMinimum ι A ∈ balancedOutputCounts ι A :=
  (isLeast_csInf (balancedOutputCounts_nonempty ι A hzero)).1

/-- Actual measured exponent equals half the independent attained minimum.
This is a theorem about the actual Haar sublevel volumes, not a definition
of a learning coefficient by an integer optimization formula. -/
theorem exponent_eq_half_balancedOutputMinimum
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    lam = (balancedOutputMinimum ι A : ℝ) / 2 := by
  obtain ⟨k, hk, hval⟩ := exists_least_balanced_count ι mu A hzero hp
  have hmin : sInf (balancedOutputCounts ι A) = k := hk.csInf_eq
  simpa only [balancedOutputMinimum, hmin] using hval

/-- Literal full-entry Euclidean half-loss and arbitrary positive continuous
coupled priors have exactly the same independent incidence-minimum exponent. -/
theorem entry_half_prior_exponent_eq_half_balancedOutputMinimum
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1 / 2 : ℝ) * ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2)
      A lam m) : lam = (balancedOutputMinimum ι A : ℝ) / 2 := by
  let z : MAIS.QuiverZeroFinitePairTable.ZeroFiber ι := ⟨A, hzero⟩
  have heq := (MAIS.QuiverZeroFinitePairTable.entry_half_prior_iff_pairValue
    ι mu z prior hprior hpos lam m).mp hp
  exact heq.1.trans (exponent_eq_half_balancedOutputMinimum ι mu A hzero
    (MAIS.QuiverZeroFinitePairTable.pairValue_spec ι mu z))

end MAIS.Run2PotentialBalancedMinimum

/-- info: 'MAIS.Run2PotentialBalancedMinimum.exists_least_balanced_count' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalancedMinimum.exists_least_balanced_count

/-- info: 'MAIS.Run2PotentialBalancedMinimum.balancedOutputCounts_nonempty' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalancedMinimum.balancedOutputCounts_nonempty

/-- info: 'MAIS.Run2PotentialBalancedMinimum.balancedOutputMinimum_mem' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalancedMinimum.balancedOutputMinimum_mem

/-- info: 'MAIS.Run2PotentialBalancedMinimum.exponent_eq_half_balancedOutputMinimum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalancedMinimum.exponent_eq_half_balancedOutputMinimum

/-- info: 'MAIS.Run2PotentialBalancedMinimum.entry_half_prior_exponent_eq_half_balancedOutputMinimum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalancedMinimum.entry_half_prior_exponent_eq_half_balancedOutputMinimum
end
end
-- ==================== end module O7.Run2PotentialBalancedMinimum ====================

-- ==================== begin module O7.Run2PotentialThresholdMinimum (formalization/O7/Run2PotentialThresholdMinimum.lean) ====================
section

/-! Actual minimum over higher-orbit potential thresholds, independent of
EVERY chosen admissible real potential at every actual normal form. The
threshold candidates are geometric finite sums and contain no measured pair. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialThresholdMinimum
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.BarcodeActiveNormalForm
open MAIS.QuiverIntervalMeasuredNormalForm MAIS.ActiveIntervalDifferential
open MAIS.ActiveIntervalMeasuredSlice MAIS.ActiveIntervalWeightedResidual
open MAIS.Run2PotentialBalancedNormalForms MAIS.Run2PotentialBalancedWitness
open MAIS.Run2PotentialSpecialization MAIS.Run2PotentialBalance
open MAIS.Run2PotentialNormalBound MAIS.Run2PotentialRadialThreshold MAIS.AnalyticTransfer
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- The independent potential threshold at an actual balanced form equals
half its independent integer count, for EVERY admissible real potential. -/
theorem balanced_threshold_eq_for_potential
    {C : Rep ι} (N : ActiveNormalForm C)
    (hbal : Balanced D N.birth N.death) (q : N.Label → ℝ)
    (hq : AdmissiblePotential D N.birth N.death q) :
    threshold N.birth N.death q = (outputCount D N.birth N.death : ℝ) / 2 := by
  apply MAIS.Run2PotentialStationarity.threshold_eq_half_output_count
    (sourceSlot N.birth N.death) (targetSlot N.birth N.death)
    (inputSlots N.birth) (outputSlots D N.death) q hq
  · intro v hi ho
    apply hbal v
    · simpa only [inputSlots, Finset.mem_filter, Finset.mem_univ, true_and] using hi
    · simpa only [outputSlots, Finset.mem_filter, Finset.mem_univ, true_and] using ho
  · exact source_not_output D N.birth N.death N.bounded

/-- A true higher zero orbit with any chosen admissible potential bounds
the actual base measured exponent by its independent threshold. -/
theorem exponent_le_higher_potential_threshold
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A C : Rep ι)
    (hAzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (hCzero : pathMatrix C 0 (Fin.last D) (Nat.zero_le D) = 0)
    (hAC : A ∈ closure (MulAction.orbit (Gauge ι) C))
    (N : ActiveNormalForm C) (q : N.Label → ℝ)
    (hq : AdmissiblePotential D N.birth N.death q)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    lam ≤ threshold N.birth N.death q := by
  obtain ⟨a, n, hCp⟩ := MAIS.QuiverZeroPairExistence.exists_pair_zero_output ι mu C hCzero
  have hmono := exponent_le_of_mem_closure_orbit ι mu A C hAzero hCzero hAC hp hCp
  let muK : Measure (Rep (Index D N.birth N.death)) := addHaar
  let muN : Measure (MAIS.IntervalCochainProduct.NormalParams N.birth N.death) := addHaar
  have hKzero := intervalRep_zero_of_original_zero N 0 (Fin.last D) (Nat.zero_le D) hCzero
  have hKp := (pair_iff_normal_form N mu muK 0 (Fin.last D) (Nat.zero_le D)
    hCzero a n).mp hCp
  have hNp := (pair_iff_normal_slice D N.birth N.death N.bounded N.valid muK muN
    0 (Fin.last D) (Nat.zero_le D) hKzero a n).mp hKp
  exact hmono.trans (bound_of_normal_pair D N.birth N.death N.bounded q hq hKzero muN hNp)

/-- A family may choose its potential independently at every actual higher
normal form. The candidate set itself contains no measured invariant. -/
def thresholdValues
    (q : ∀ C : Rep ι, (N : ActiveNormalForm C) → N.Label → ℝ) (A : Rep ι) : Set ℝ :=
  {v | ∃ C : Rep ι, ∃ N : ActiveNormalForm C,
    pathMatrix C 0 (Fin.last D) (Nat.zero_le D) = 0 ∧
    A ∈ closure (MulAction.orbit (Gauge ι) C) ∧ v = threshold N.birth N.death (q C N)}

/-- Actual exponent equals the ATTAINED least higher-orbit threshold for
EVERY independently chosen family of admissible REAL slot potentials. -/
theorem isLeast_thresholdValues
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (q : ∀ C : Rep ι, (N : ActiveNormalForm C) → N.Label → ℝ)
    (hq : ∀ C : Rep ι, ∀ N : ActiveNormalForm C,
      pathMatrix C 0 (Fin.last D) (Nat.zero_le D) = 0 →
      AdmissiblePotential D N.birth N.death (q C N))
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    IsLeast (thresholdValues ι q A) lam := by
  obtain ⟨C, NC, hCzero, hAC, hbal, hcount, _⟩ :=
    exists_balanced_higher_witness ι mu A hzero hp
  have ht := balanced_threshold_eq_for_potential ι NC hbal (q C NC) (hq C NC hCzero)
  refine ⟨⟨C, NC, hCzero, hAC, hcount.trans ht.symm⟩, ?_⟩
  rintro v ⟨B, NB, hBzero, hAB, rfl⟩
  exact exponent_le_higher_potential_threshold ι mu A B hzero hBzero hAB NB
    (q B NB) (hq B NB hBzero) hp

/-- In particular, the actual exponent is the least canonical-potential
threshold over all true higher zero-output normal forms. -/
theorem isLeast_canonical_thresholdValues
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    IsLeast (thresholdValues ι (fun _ N => realPotential D N.birth N.death) A) lam := by
  apply isLeast_thresholdValues ι mu _ ?_ A hzero hp
  intro C N hC
  exact canonical_admissible D N.birth N.death N.bounded
    (intervalRep_zero_of_original_zero N 0 (Fin.last D) (Nat.zero_le D) hC)

end MAIS.Run2PotentialThresholdMinimum

/-- info: 'MAIS.Run2PotentialThresholdMinimum.balanced_threshold_eq_for_potential' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialThresholdMinimum.balanced_threshold_eq_for_potential

/-- info: 'MAIS.Run2PotentialThresholdMinimum.exponent_le_higher_potential_threshold' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialThresholdMinimum.exponent_le_higher_potential_threshold

/-- info: 'MAIS.Run2PotentialThresholdMinimum.isLeast_thresholdValues' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialThresholdMinimum.isLeast_thresholdValues

/-- info: 'MAIS.Run2PotentialThresholdMinimum.isLeast_canonical_thresholdValues' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialThresholdMinimum.isLeast_canonical_thresholdValues
end
end
-- ==================== end module O7.Run2PotentialThresholdMinimum ====================

-- ==================== begin module O7.Run2PotentialMultiplicityBound (formalization/O7/Run2PotentialMultiplicityBound.lean) ====================
section

/-! An actual logarithmic multiplicity bound by the genuine path-rank defect.
The bound is derived by well-founded real orbit induction from the actual
measured higher-orbit recurrence, including its boundary logarithm. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3200000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PotentialMultiplicityBound
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open MAIS.MatrixCoordinateTransport MAIS.BarcodeActiveNormalForm
open MAIS.QuiverIntervalMeasuredNormalForm MAIS.ActiveIntervalDifferential
open MAIS.ActiveIntervalMeasuredSlice MAIS.AnalyticTransfer
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalRecursivePair
open MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalExistenceStep MAIS.Run2PotentialActualRecurrence
open MAIS.QuiverFinitePairTable MAIS.QuiverOrbitFiniteHeight

section LocalStep
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s, death s ≤ D + 1)
include hD in
/-- The actual base multiplicity is one or is at most one greater than an
actual strict higher measured multiplicity; no numerical witness is assumed. -/
theorem one_or_higher_multiplicity
    (hvalid : ∀ s, birth s < death s)
    (muA : Measure (Ambient D birth death)) [Measure.IsAddHaarMeasure muA]
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair muA (Metric.ball (intervalRep D birth death))
      (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D))
      (intervalRep D birth death) lam m) :
    m = 1 ∨ ∃ B : Ambient D birth death, ∃ a : ℝ, ∃ n : ℕ,
      IsHigherZero (Index D birth death) (intervalRep D birth death) B ∧
      HasMeasuredBandPair muA (Metric.ball B)
        (ambientLoss D birth death 0 (Fin.last D) (Nat.zero_le D)) B a n ∧ m ≤ n + 1 := by
  rcases isEmpty_or_nonempty (ResidualIndex D birth death) with hR | hR
  · let _ : IsEmpty (ResidualIndex D birth death) := hR
    let muT : Measure (NormalParams birth death) := addHaar
    let muR : Measure (Residual D birth death) := addHaar
    let q : ℝ := (Fintype.card (DirectIndex D birth death) : ℝ) / 2
    have hh := MAIS.ActiveIntervalEmptyResidual.ambient_entry_half_pair_iff D birth death hD hvalid
      muA muT muR hzero (fun _ => 1) continuousAt_const zero_lt_one q 1
    have hc : ambientHalfPair D birth death muA (fun _ => 1) q 1 := hh.mpr ⟨rfl, rfl⟩
    exact Or.inl (O77.PowerLogUniqueness.radius_order_unique hp
      (native_pair_of_entry_half_one D birth death muA hc)).2
  · let _ : Nonempty (ResidualIndex D birth death) := hR
    obtain ⟨B, a, n, hB, hBp, _, _, hm⟩ :=
      actual_nonterminal_recurrence D birth death hD hvalid muA hzero hp
    refine Or.inr ⟨B, a, n, hB, hBp, ?_⟩
    rw [hm]
    split_ifs <;> omega
end LocalStep

variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- Literal actual Haar logarithmic multiplicity is bounded by one plus the
actual finite path-rank defect. This includes empty widths and neutral germs. -/
theorem multiplicity_le_rankDefect_add_one
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    m ≤ rankDefect ι A + 1 := by
  have hall : ∀ A : Rep ι, pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0 →
      ∀ lam : ℝ, ∀ m : ℕ,
      HasMeasuredBandPair mu (Metric.ball A)
        (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m →
      m ≤ rankDefect ι A + 1 := by
    intro A
    refine (wellFounded_strict_generization ι).induction
      (C := fun B : Rep ι => pathMatrix B 0 (Fin.last D) (Nat.zero_le D) = 0 →
        ∀ lam : ℝ, ∀ m : ℕ,
        HasMeasuredBandPair mu (Metric.ball B)
          (fun T => ‖pathMatrix T 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) B lam m →
        m ≤ rankDefect ι B + 1) A ?_
    intro A ih hAzero lam m hAp
    obtain ⟨N⟩ := exists_normal_form A
    let muK : Measure (Rep (Index D N.birth N.death)) := addHaar
    have hKzero := intervalRep_zero_of_original_zero N 0 (Fin.last D) (Nat.zero_le D) hAzero
    have hKp := (pair_iff_normal_form N mu muK 0 (Fin.last D) (Nat.zero_le D)
      hAzero lam m).mp hAp
    rcases one_or_higher_multiplicity D N.birth N.death N.bounded N.valid muK hKzero hKp with
      hm | ⟨B, a, n, hB, hBp, hmn⟩
    · omega
    · let T : Rep ι := transport N.coordinates B
      have hTzero : pathMatrix T 0 (Fin.last D) (Nat.zero_le D) = 0 := by
        rw [path_transport, hB.1]
        rfl
      have hcl : A ∈ closure (MulAction.orbit (Gauge ι) T) := by
        apply MAIS.RealTypeAClosure.mem_closure_orbit_of_path_rank_le
        intro i j hij
        rw [← N.rank_eq i j hij, path_rank_transport]
        exact path_rank_le_of_mem_closure_orbit hB.2.1 i j hij
      have hnot : T ∉ MulAction.orbit (Gauge ι) A := by
        intro horb
        obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp horb
        apply hB.2.2
        apply mem_gauge_orbit_of_path_rank_eq (intervalRep D N.birth N.death) B
        intro i j hij
        have hgr : (pathMatrix T i j hij).rank = (pathMatrix A i j hij).rank := by
          rw [← hg]
          exact path_rank_gauge g A i j hij
        rw [path_rank_transport] at hgr
        exact (N.rank_eq i j hij).trans hgr.symm
      have hTp := (MAIS.QuiverCoordinateMeasuredPair.pair_iff_coordinate_transport
        N.coordinates muK mu B 0 (Fin.last D) (Nat.zero_le D) a n).mp hBp
      have hn := ih T ⟨hcl, hnot⟩ hTzero a n hTp
      have hprogress := rankDefect_lt_of_strict_generization ι A T hcl hnot
      omega
  exact hall A hzero lam m hp

/-- Same genuine logarithmic bound for the actual full-entry half-loss and
any coupled prior continuous and positive at the actual zero-output center. -/
theorem entry_half_prior_multiplicity_le_rankDefect_add_one
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    {lam : ℝ} {m : ℕ}
    (hp : HasMeasuredBandPair (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1 / 2 : ℝ) * ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m) :
    m ≤ rankDefect ι A + 1 := by
  let z : MAIS.QuiverZeroFinitePairTable.ZeroFiber ι := ⟨A, hzero⟩
  have heq := (MAIS.QuiverZeroFinitePairTable.entry_half_prior_iff_pairValue
    ι mu z prior hprior hpos lam m).mp hp
  rw [heq.2]
  exact multiplicity_le_rankDefect_add_one ι mu A hzero
    (MAIS.QuiverZeroFinitePairTable.pairValue_spec ι mu z)

end MAIS.Run2PotentialMultiplicityBound

/-- info: 'MAIS.Run2PotentialMultiplicityBound.one_or_higher_multiplicity' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialMultiplicityBound.one_or_higher_multiplicity

/-- info: 'MAIS.Run2PotentialMultiplicityBound.multiplicity_le_rankDefect_add_one' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialMultiplicityBound.multiplicity_le_rankDefect_add_one

/-- info: 'MAIS.Run2PotentialMultiplicityBound.entry_half_prior_multiplicity_le_rankDefect_add_one' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialMultiplicityBound.entry_half_prior_multiplicity_le_rankDefect_add_one
end
end
