section

/-! The complete actual finite-arithmetic pair formula instantiated with
the proved exhaustive padded-slot enumeration. Computing arbitrary real
matrix ranks remains an input-conversion task; all subsequent candidate,
coefficient, rational-edge and longest-path operations are executable. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2ArithmeticCriticalPathFast
open MAIS.Run2BarcodeEnumerationData MAIS.Run2ArithmeticCriticalPathData
open MAIS.Run2BarcodeFastEnumerationData MAIS.Run2BarcodeFastEnumerationComplete
open MAIS.Run2BarcodeEnumeration MAIS.QuiverOrbitFiniteHeight
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism
open MAIS.Run2ArithmeticCriticalPathMeasuredStep MAIS.AnalyticTransfer
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

/-- The finite list itself is independent of the input orbit. -/
def nodes : Finset (Multiplicities D (dimensionSum ι)) :=
  fastCandidates (architecture ι) (fun _ _ => 0)

omit [∀v,DecidableEq (ι v)] in
theorem nodes_eq : nodes ι = candidates (architecture ι) (fun _ _ => 0) :=
  fastCandidates_eq _ _ le_rfl

theorem exists_matching_node (A : Rep ι)
    (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    ∃ h : Node (nodes ι), ∀ i j (hij : i ≤ j),
      pathCount h.val i j = (pathMatrix A i j hij).rank :=
  MAIS.Run2ArithmeticCriticalPath.exists_matching_node ι (nodes ι) (nodes_eq ι) A hzero

/-- Actual radius-first Haar bands have exactly the independently computed
minimum coefficient and finite exact-rational critical-path multiplicity. -/
theorem actual_pair_iff_of_matching
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (h : Node (nodes ι)) (hmatch : ∀ i j (hij : i ≤ j),
      pathCount h.val i j = (pathMatrix A i j hij).rank)
    (lam : ℝ) (m : ℕ) :
    NativePair ι mu A lam m ↔
      lam = (coefficient (nodes ι) h.val : ℝ) / 2 ∧
      m = 1 + criticalDepth (nodes ι) h :=
  MAIS.Run2ArithmeticCriticalPath.actual_pair_iff_of_matching ι (nodes ι) (nodes_eq ι)
    mu A hzero h hmatch lam m

/-- Literal entry-half loss and arbitrary coupled continuous positive
priors obey the same finite algorithm, without a supplied pair witness. -/
theorem entry_half_prior_pair_iff_of_matching
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (h : Node (nodes ι)) (hmatch : ∀ i j (hij : i ≤ j),
      pathCount h.val i j = (pathMatrix A i j hij).rank)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1 / 2 : ℝ) * ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m ↔
      lam = (coefficient (nodes ι) h.val : ℝ) / 2 ∧
      m = 1 + criticalDepth (nodes ι) h :=
  MAIS.Run2ArithmeticCriticalPath.entry_half_prior_pair_iff_of_matching
    ι (nodes ι) (nodes_eq ι) mu A hzero h hmatch prior hprior hpos lam m

theorem actual_pair_iff_computedPairs
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (lam : ℝ) (m : ℕ) :
    NativePair ι mu A lam m ↔
      ∃ c : ℕ, (c, m) ∈ computedPairs (nodes ι) (pathRankInput ι A) ∧ lam = (c : ℝ) / 2 :=
  MAIS.Run2ArithmeticCriticalPath.actual_pair_iff_computedPairs
    ι (nodes ι) (nodes_eq ι) mu A hzero lam m

theorem computedPairs_nonempty_singleton
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0) :
    ∃ c m : ℕ, computedPairs (nodes ι) (pathRankInput ι A) = {(c, m)} ∧
      NativePair ι mu A ((c : ℝ) / 2) m :=
  MAIS.Run2ArithmeticCriticalPath.computedPairs_nonempty_singleton
    ι (nodes ι) (nodes_eq ι) mu A hzero

theorem entry_half_prior_pair_iff_computedPairs
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (hzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (prior : Rep ι → ℝ) (hprior : ContinuousAt prior A) (hpos : 0 < prior A)
    (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair (mu.withDensity (fun B => ENNReal.ofReal (prior B)))
      (MAIS.MatrixChainEntryWindows.entryBall ι A)
      (fun B => (1 / 2 : ℝ) * ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m ↔
      ∃ c : ℕ, (c, m) ∈ computedPairs (nodes ι) (pathRankInput ι A) ∧ lam = (c : ℝ) / 2 :=
  MAIS.Run2ArithmeticCriticalPath.entry_half_prior_pair_iff_computedPairs
    ι (nodes ι) (nodes_eq ι) mu A hzero prior hprior hpos lam m

end MAIS.Run2ArithmeticCriticalPathFast

