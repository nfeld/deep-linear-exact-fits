-- ==================== begin module O7.CrossCarrierChartTransfer (formalization/O7/CrossCarrierChartTransfer.lean) ====================
section

/-! Actual Haar band pairs under C1 local charts between different carriers.
The derivative equivalence, Haar scale and local volume comparison are derived. -/
set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped ENNReal Topology
namespace MAIS.CrossCarrierChartTransfer
open MAIS.AnalyticTransfer

section Differential
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- Actual local chart inverse identities force both derivative inverse identities. -/
theorem derivative_inverse_identities (e : OpenPartialHomeomorph E F) {w : E}
    (hw : w ∈ e.source) (he : ContDiffAt ℝ 1 e w)
    (hei : ContDiffAt ℝ 1 e.symm (e w)) :
    (fderiv ℝ e.symm (e w)).comp (fderiv ℝ e w) = ContinuousLinearMap.id ℝ E ∧
    (fderiv ℝ e w).comp (fderiv ℝ e.symm (e w)) = ContinuousLinearMap.id ℝ F := by
  constructor
  · apply O77.Transport0906.derivative_left_inverse
      (he.differentiableAt one_ne_zero).hasFDerivAt
      (hei.differentiableAt one_ne_zero).hasFDerivAt
    filter_upwards [e.open_source.mem_nhds hw] with x hx
    exact e.left_inv hx
  · have he' : HasFDerivAt e (fderiv ℝ e w) (e.symm (e w)) := by
      simpa only [e.left_inv hw] using (he.differentiableAt one_ne_zero).hasFDerivAt
    apply O77.Transport0906.derivative_left_inverse
      (hei.differentiableAt one_ne_zero).hasFDerivAt he'
    filter_upwards [e.open_target.mem_nhds (e.map_source hw)] with y hy
    exact e.right_inv hy

/-- No dimension equality or linear-coordinate equivalence is assumed:
it is constructed from the two actual chart derivatives. -/
def derivativeEquiv (e : OpenPartialHomeomorph E F) {w : E}
    (hw : w ∈ e.source) (he : ContDiffAt ℝ 1 e w)
    (hei : ContDiffAt ℝ 1 e.symm (e w)) : E ≃L[ℝ] F :=
  ContinuousLinearEquiv.equivOfInverse' (fderiv ℝ e w) (fderiv ℝ e.symm (e w))
    (derivative_inverse_identities e hw he hei).2 (derivative_inverse_identities e hw he hei).1

/-- Conjugate the codomain by a genuine linear equivalence. -/
def normalizedChart (e : OpenPartialHomeomorph E F) (T : E ≃L[ℝ] F) :
    OpenPartialHomeomorph E E := e.trans T.symm.toHomeomorph.toOpenPartialHomeomorph

@[simp]
theorem normalizedChart_source (e : OpenPartialHomeomorph E F) (T : E ≃L[ℝ] F) :
    (normalizedChart e T).source = e.source := by
  ext x
  change (x ∈ e.source ∧ e x ∈ (univ : Set F)) ↔ x ∈ e.source
  simp

@[simp]
theorem normalizedChart_target (e : OpenPartialHomeomorph E F) (T : E ≃L[ℝ] F) :
    (normalizedChart e T).target = T ⁻¹' e.target := by
  ext x
  change (x ∈ (univ : Set E) ∧ T x ∈ e.target) ↔ T x ∈ e.target
  simp

end Differential

section Measured
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  [FiniteDimensional ℝ F] [MeasurableSpace F] [BorelSpace F]
  (mu : Measure E) (nu : Measure F) [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]

/-- Actual radius-first local-band invariance between different finite real
carriers. No linear equivalence, Jacobian bound, or volume estimate is assumed. -/
theorem pair_iff_of_chart (e : OpenPartialHomeomorph E F) {w : E}
    {f : E → ℝ} {g : F → ℝ} {lam : ℝ} {m : ℕ}
    (hw : w ∈ e.source)
    (he : ∀ x ∈ e.source, ContDiffAt ℝ 1 e x)
    (hei : ∀ z ∈ e.target, ContDiffAt ℝ 1 e.symm z)
    (hf : Measurable f) (hg : Measurable g)
    (hmatch : ∀ x ∈ e.source, f x = g (e x)) :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (e w)) g (e w) lam m := by
  let T := derivativeEquiv e hw (he w hw) (hei (e w) (e.map_source hw))
  let e0 := normalizedChart e T
  let g0 : E → ℝ := fun x => g (T x)
  have hw0 : w ∈ e0.source := by simpa only [e0, normalizedChart_source] using hw
  have he0 : ∀ x ∈ e0.source, ContDiffAt ℝ 1 e0 x := by
    intro x hx
    have hx' : x ∈ e.source := by simpa only [e0, normalizedChart_source] using hx
    change ContDiffAt ℝ 1 (fun x => T.symm (e x)) x
    exact T.symm.contDiff.contDiffAt.comp x (he x hx')
  have hei0 : ∀ x ∈ e0.target, ContDiffAt ℝ 1 e0.symm x := by
    intro x hx
    have hx' : T x ∈ e.target := by simpa only [e0, normalizedChart_target, mem_preimage] using hx
    change ContDiffAt ℝ 1 (fun x => e.symm (T x)) x
    exact (hei (T x) hx').comp x T.contDiff.contDiffAt
  have hg0 : Measurable g0 := hg.comp T.continuous.measurable
  have hmatch0 : ∀ x ∈ e0.source, f x = g0 (e0 x) := by
    intro x hx
    have hx' : x ∈ e.source := by simpa only [e0, normalizedChart_source] using hx
    change f x = g (T (T.symm (e x)))
    rw [T.apply_symm_apply]
    exact hmatch x hx'
  have hp := MAIS.LocalDiffeomorphismTransfer.pair_iff_of_chart mu e0 hw0 he0 hei0 hf hg0 hmatch0
    (lam := lam) (m := m)
  have ht := MAIS.LinearObservationTransfer.pair_iff_haar_linear mu nu T (e0 w)
    (g := g) hg (lam := lam) (m := m)
  have hcenter : T (e0 w) = e w := by
    change T (T.symm (e w)) = e w
    exact T.apply_symm_apply _
  rw [hcenter] at ht
  exact hp.trans ht

/-- Only actual C1 regularity at the two base points is needed. The required
open chart restriction is constructed from the two C1 germs. -/
theorem pair_iff_of_chart_local (e : OpenPartialHomeomorph E F) {w : E}
    {f : E → ℝ} {g : F → ℝ} {lam : ℝ} {m : ℕ}
    (hw : w ∈ e.source) (he : ContDiffAt ℝ 1 e w)
    (hei : ContDiffAt ℝ 1 e.symm (e w))
    (hf : Measurable f) (hg : Measurable g)
    (hmatch : ∀ x ∈ e.source, f x = g (e x)) :
    HasMeasuredBandPair mu (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (e w)) g (e w) lam m := by
  have hev := he.eventually (by simp)
  have heiv := he.continuousAt.tendsto.eventually (hei.eventually (by simp))
  obtain ⟨U, hU, hUo, hwU⟩ := eventually_nhds_iff.mp (hev.and heiv)
  let e1 := e.restrOpen U hUo
  have hw1 : w ∈ e1.source := ⟨hw, hwU⟩
  have he1 : ∀ x ∈ e1.source, ContDiffAt ℝ 1 e1 x := by
    intro x hx
    exact (hU x hx.2).1
  have hei1 : ∀ z ∈ e1.target, ContDiffAt ℝ 1 e1.symm z := by
    intro z hz
    have hz' : z ∈ e.target ∧ e.symm z ∈ U := hz
    change ContDiffAt ℝ 1 e.symm z
    simpa only [e.right_inv hz'.1] using (hU (e.symm z) hz'.2).2
  have hmatch1 : ∀ x ∈ e1.source, f x = g (e1 x) := by
    intro x hx
    exact hmatch x hx.1
  exact pair_iff_of_chart mu nu e1 hw1 he1 hei1 hf hg hmatch1

/-- An arbitrary continuous positive source prior is allowed; it need not
be a pullback or a product density in the actual chart coordinates. -/
theorem pair_iff_of_chart_prior (e : OpenPartialHomeomorph E F) {w : E}
    {f prior : E → ℝ} {g : F → ℝ} {lam : ℝ} {m : ℕ}
    (hw : w ∈ e.source)
    (he : ∀ x ∈ e.source, ContDiffAt ℝ 1 e x)
    (hei : ∀ z ∈ e.target, ContDiffAt ℝ 1 e.symm z)
    (hf : Measurable f) (hg : Measurable g)
    (hmatch : ∀ x ∈ e.source, f x = g (e x))
    (hprior : ContinuousAt prior w) (hpos : 0 < prior w) :
    HasMeasuredBandPair (mu.withDensity (fun x => ENNReal.ofReal (prior x)))
      (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (e w)) g (e w) lam m :=
  (MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior mu hf hprior hpos).symm.trans
    (pair_iff_of_chart mu nu e hw he hei hf hg hmatch)

/-- Local C1 chart invariance with any actual continuous positive source prior. -/
theorem pair_iff_of_chart_local_prior (e : OpenPartialHomeomorph E F) {w : E}
    {f prior : E → ℝ} {g : F → ℝ} {lam : ℝ} {m : ℕ}
    (hw : w ∈ e.source) (he : ContDiffAt ℝ 1 e w)
    (hei : ContDiffAt ℝ 1 e.symm (e w))
    (hf : Measurable f) (hg : Measurable g)
    (hmatch : ∀ x ∈ e.source, f x = g (e x))
    (hprior : ContinuousAt prior w) (hpos : 0 < prior w) :
    HasMeasuredBandPair (mu.withDensity (fun x => ENNReal.ofReal (prior x)))
      (Metric.ball w) f w lam m ↔
      HasMeasuredBandPair nu (Metric.ball (e w)) g (e w) lam m :=
  (MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior mu hf hprior hpos).symm.trans
    (pair_iff_of_chart_local mu nu e hw he hei hf hg hmatch)

end Measured
end MAIS.CrossCarrierChartTransfer
end

