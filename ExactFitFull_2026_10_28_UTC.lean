-- ==================== begin module O7.Run2PositiveMeasuredNormalForm (formalization/O7/Run2PositiveMeasuredNormalForm.lean) ====================
section

/-! Every actual pointed path loss reduces to its actual interval normal form,
with the target transformed together with the actual center. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2PositiveMeasuredNormalForm
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.MatrixCoordinateTransport
open MAIS.BarcodeActiveNormalForm MAIS.ActiveIntervalDifferential MAIS.AnalyticTransfer
open MAIS.Run2PositiveGaugeTransport MAIS.Run2PositiveCoordinateTransport
variable {D : ℕ} {ι : Fin (D+1) → Type*}
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

/-- Actual Haar pairs of the pointed complete or subpath loss are preserved
by actual barcode normalization, without restricting the center's output. -/
theorem pair_iff_normal_form_pointed {A : Rep ι} (N : ActiveNormalForm A)
    (mu : Measure (Rep ι)) (nu : Measure (Rep (Index D N.birth N.death)))
    [Measure.IsAddHaarMeasure mu] [Measure.IsAddHaarMeasure nu]
    (i j : Fin (D+1)) (hij : i ≤ j) (lam : ℝ) (m : ℕ) :
    HasMeasuredBandPair mu (Metric.ball A)
      (fun B => ‖pathMatrix B i j hij-pathMatrix A i j hij‖^2) A lam m ↔
    HasMeasuredBandPair nu (Metric.ball (intervalRep D N.birth N.death))
      (fun B => ‖pathMatrix B i j hij-pathMatrix (intervalRep D N.birth N.death) i j hij‖^2)
      (intervalRep D N.birth N.death) lam m := by
  let C := intervalRep D N.birth N.death
  let B := transport N.coordinates C
  obtain ⟨g,hg⟩ := MulAction.mem_orbit_iff.mp N.original_in_orbit
  have hc := pair_iff_coordinate_pointed N.coordinates nu mu C i j hij lam m
  have hgauge := pair_iff_gauge_pointed ι mu mu g B i j hij lam m
  change g • B = A at hg
  rw [hg] at hgauge
  exact (hc.trans hgauge).symm

end MAIS.Run2PositiveMeasuredNormalForm

/-- info: 'MAIS.Run2PositiveMeasuredNormalForm.pair_iff_normal_form_pointed' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveMeasuredNormalForm.pair_iff_normal_form_pointed
end
end
