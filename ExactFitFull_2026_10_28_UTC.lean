-- ==================== begin module O7.DirectBandOrder (formalization/O7/DirectBandOrder.lean) ====================
section
/-
A review-facing predicate with all power-log quantifiers in one body.
Its equivalence below is checked against the actual project predicate.
This file does not prove or import the arbitrary-depth classification.
-/

set_option autoImplicit false
noncomputable section

namespace MAIS.DirectBandOrder

/-- Two-sided small-loss order at every sufficiently small fixed radius. -/
def HasOrder (volume : _root_.Real → _root_.Real → ENNReal)
    (exponent : _root_.Real) (multiplicity : Nat) : Prop :=
  0 ≤ exponent ∧ 1 ≤ multiplicity ∧
  ∃ radius : _root_.Real, 0 < radius ∧
    ∀ delta : _root_.Real, 0 < delta → delta < radius →
      ∃ lower upper cutoff : _root_.Real,
        0 < lower ∧ lower ≤ upper ∧ 0 < cutoff ∧ cutoff < Real.exp (-1) ∧
        ∀ epsilon : _root_.Real, 0 < epsilon → epsilon < cutoff →
          ENNReal.ofReal lower *
            ENNReal.ofReal (Real.rpow epsilon exponent *
              (Real.log (1 / epsilon)) ^ (multiplicity - 1)) ≤ volume delta epsilon ∧
          volume delta epsilon ≤ ENNReal.ofReal upper *
            ENNReal.ofReal (Real.rpow epsilon exponent *
              (Real.log (1 / epsilon)) ^ (multiplicity - 1))

/-- Definitional equivalence, not a new asymptotic theorem. -/
theorem measuredBandPair_iff
    {E : Type*} [MeasurableSpace E]
    (mu : MeasureTheory.Measure E) (windows : _root_.Real → Set E)
    (loss : E → _root_.Real) (center : E)
    (exponent : _root_.Real) (multiplicity : Nat) :
    _root_.MAIS.AnalyticTransfer.HasMeasuredBandPair
      mu windows loss center exponent multiplicity ↔
    HasOrder
      (fun delta epsilon =>
        mu {x | x ∈ windows delta ∧ |loss x - loss center| < epsilon})
      exponent multiplicity := by
  rfl

end MAIS.DirectBandOrder

/-- info: 'MAIS.DirectBandOrder.measuredBandPair_iff' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.DirectBandOrder.measuredBandPair_iff
end
end
-- ==================== end module O7.DirectBandOrder ====================

-- ==================== begin module O7.ExactFitStatement (formalization/O7/ExactFitStatement.lean) ====================
section

/-!
# The exact-fit classification as a single statement

This file restates the main theorem about deep linear networks at an exact fit
as **one** Lean theorem, `exact_fit_classification`, whose statement uses only:

* Mathlib vocabulary (real matrices, the Frobenius norm, Haar measures,
  `withDensity`, metric balls, Hausdorff dimension, `Module.finrank`);
* the definitions `idx`, `Chain`, `product`, `rankTable`, `halfLoss`, `entryBall`
  given below, each a one-line abbreviation of existing project definitions;
* `MAIS.DirectBandOrder.HasOrder` (one explicit predicate, `formalization/O7/DirectBandOrder.lean`);
* `MAIS.Run2ArithmeticPositiveData.exactFitPairs` (the finite program for the
  multiplicity; only needed for the arithmetic conjunct).

It is proved by composing three existing theorems; no new mathematics is proved
here.  The script `scripts/audit/ExactFitStatementAudit.lean` prints the statement
and the complete list of non-Mathlib definitions on which the statement depends.

Status (27 October 2026): written by Claude (Anthropic) for review; compiled only
if the CI log in `ci-results/exact-fit` says so.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory
open scoped ENNReal Matrix.Norms.Frobenius

namespace MAIS.ExactFitStatement

/-- Coordinate index family: the vertex `v` carries the coordinate set `Fin (n v)`. -/
abbrev idx {D : ℕ} (n : Fin (D + 1) → ℕ) : Fin (D + 1) → Type :=
  fun v => Fin (n v)

/-- A chain `A = (A_0, …, A_{D-1})`, where `A e` is a real `n (e+1) × n e` matrix.
It unfolds to `(e : Fin D) → Matrix (Fin (n e.succ)) (Fin (n e.castSucc)) ℝ`. -/
abbrev Chain {D : ℕ} (n : Fin (D + 1) → ℕ) : Type :=
  MAIS.QuiverRealOrbit.Rep (idx n)

/-- The product `A_{D-1} ⋯ A_0` (the identity matrix when `D = 0`). -/
def product {D : ℕ} (n : Fin (D + 1) → ℕ) (A : Chain n) :
    Matrix (Fin (n (Fin.last D))) (Fin (n 0)) ℝ :=
  MAIS.MatrixChainIsomorphism.pathMatrix (ι := idx n) A 0 (Fin.last D) (Nat.zero_le D)

/-- `rankTable n A i j` is the rank of `A_{j-1} ⋯ A_i` when `i ≤ j`, and `0` otherwise. -/
def rankTable {D : ℕ} (n : Fin (D + 1) → ℕ) (A : Chain n) (i j : Fin (D + 1)) : ℕ :=
  MAIS.Run2BarcodeEnumeration.pathRankInput (idx n) A i j

/-- The loss `B ↦ ½ ‖P(B) - Φ‖²`, with the Frobenius norm. -/
def halfLoss {D : ℕ} (n : Fin (D + 1) → ℕ)
    (Φ : Matrix (Fin (n (Fin.last D))) (Fin (n 0)) ℝ) (B : Chain n) : ℝ :=
  (1 / 2 : ℝ) * ‖product n B - Φ‖ ^ 2

/-- The Euclidean ball of radius `δ` around `A`, in all matrix entries. -/
def entryBall {D : ℕ} (n : Fin (D + 1) → ℕ) (A : Chain n) (δ : ℝ) : Set (Chain n) :=
  {B | Real.sqrt (∑ e : Fin D, ∑ r : Fin (n e.succ), ∑ s : Fin (n e.castSucc),
      (B e r s - A e r s) ^ 2) < δ}

/-- **Exact-fit classification.**  Let `A` be a chain with product `Φ`, let `μ` be an
additive Haar measure and `φ` a real function, continuous at `A`, with `φ A > 0`.
Then there are natural numbers `c` and `m` such that

1. the finite program returns exactly `{(c, m)}`;
2. `c` is the local Hausdorff codimension of the fibre `{B | P(B) = Φ}` at `A`
   (ambient dimension minus the infimum over all radii `r > 0` of the Hausdorff
   dimension of the fibre inside the open ball of radius `r`; the balls and the
   Hausdorff dimension are those of the norm `max_e ‖B e‖_F`);
3. for every real `lam` and natural `m'`, the band volume
   `(δ, ε) ↦ ∫_{B ∈ entryBall A δ, |L(B) - L(A)| < ε} φ⁺ dμ` has the two-sided
   power-log order `(lam, m')` (`HasOrder`) if and only if `lam = c / 2` and `m' = m`. -/
theorem exact_fit_classification
    {D : ℕ} (n : Fin (D + 1) → ℕ)
    (μ : Measure (Chain n)) [μ.IsAddHaarMeasure]
    (A : Chain n) (Φ : Matrix (Fin (n (Fin.last D))) (Fin (n 0)) ℝ)
    (hfit : product n A = Φ)
    (φ : Chain n → ℝ) (hφ : ContinuousAt φ A) (hφA : 0 < φ A) :
    ∃ c m : ℕ,
      MAIS.Run2ArithmeticPositiveData.exactFitPairs n (rankTable n A) = {(c, m)} ∧
      (Module.finrank ℝ (Chain n) : ℝ≥0∞) -
          (⨅ (r : ℝ) (_ : 0 < r),
            dimH ({B : Chain n | product n B = Φ} ∩ Metric.ball A r)) =
        (c : ℝ≥0∞) ∧
      ∀ (lam : ℝ) (m' : ℕ),
        MAIS.DirectBandOrder.HasOrder
            (fun δ ε => μ.withDensity (fun B => ENNReal.ofReal (φ B))
              {B | B ∈ entryBall n A δ ∧ |halfLoss n Φ B - halfLoss n Φ A| < ε})
            lam m' ↔
          (lam = (c : ℝ) / 2 ∧ m' = m) := by
  classical
  subst hfit
  have harch : MAIS.Run2BarcodeEnumeration.architecture (idx n) = n := by
    funext v
    simp [MAIS.Run2BarcodeEnumeration.architecture, idx]
  obtain ⟨c, m, hset, -⟩ :=
    MAIS.Run2ArithmeticPositive.exactFitPairs_nonempty_singleton (idx n) μ A
  have hc : (c, m) ∈ MAIS.Run2ArithmeticPositiveData.exactFitPairs
      (MAIS.Run2BarcodeEnumeration.architecture (idx n))
      (MAIS.Run2BarcodeEnumeration.pathRankInput (idx n) A) := by
    rw [hset]
    exact Finset.mem_singleton_self _
  have hset' : MAIS.Run2ArithmeticPositiveData.exactFitPairs n (rankTable n A) =
      {(c, m)} := by
    have h := hset
    rw [harch] at h
    exact h
  refine ⟨c, m, hset', ?_, ?_⟩
  · exact MAIS.Run2ArithmeticPositiveGeometry.exactFitPair_literal_hausdorff_codimension
      (idx n) A hc
  · intro lam m'
    have h1 := MAIS.DirectBandOrder.measuredBandPair_iff
      (μ.withDensity (fun B => ENNReal.ofReal (φ B)))
      (MAIS.MatrixChainEntryWindows.entryBall (idx n) A)
      (fun B : Chain n => (1 / 2 : ℝ) *
        ‖MAIS.MatrixChainIsomorphism.pathMatrix (ι := idx n) B 0 (Fin.last D)
            (Nat.zero_le D) - product n A‖ ^ 2)
      A lam m'
    have h2 := MAIS.Run2ArithmeticPositive.entry_half_prior_pair_iff (idx n) μ A
      (product n A) rfl φ hφ hφA lam m'
    refine h1.symm.trans (h2.trans ?_)
    rw [hset]
    constructor
    · rintro ⟨c', hc', hl⟩
      rw [Finset.mem_singleton, Prod.mk.injEq] at hc'
      obtain ⟨rfl, rfl⟩ := hc'
      exact ⟨hl, rfl⟩
    · rintro ⟨hl, rfl⟩
      exact ⟨c, Finset.mem_singleton_self _, hl⟩

end MAIS.ExactFitStatement

/-- info: 'MAIS.ExactFitStatement.exact_fit_classification' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.ExactFitStatement.exact_fit_classification
end
end
-- ==================== end module O7.ExactFitStatement ====================
