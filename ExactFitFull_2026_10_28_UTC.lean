-- ==================== begin module O7.Run2GeometricFullSpanFiber (formalization/O7/Run2GeometricFullSpanFiber.lean) ====================
section

/-! The actual full-span interval normalization discharges every structural
premise of the geometric positive-target fiber theorem. No geometric dimension
or measured learning pair is among the hypotheses. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
noncomputable section
open scoped ENNReal NNReal Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2GeometricFullSpanFiber
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.OrbitSliceLinear
open MAIS.ActiveIntervalDifferential MAIS.ActiveIntervalCoordinates
open MAIS.Run2FullSpanCoordinates MAIS.Run2FullSpanProduct MAIS.Run2FullSpanSlice
open MAIS.Run2PositiveEndpointRegular MAIS.Run2PositiveNetworkLoss
open MAIS.Run2GeometricReducedGauge MAIS.Run2GeometricPositiveSplit
open MAIS.Run2GeometricZeroFiber MAIS.Run2GeometricCodimension MAIS.Run2GeometricCodimCharts
open MAIS.Run2GeometricCharts MAIS.Run2GeometricIntegralCodim
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ) (hD : ∀ s,death s≤D+1)
include hD

/-- The actual split interval arrows are literal block identity/reduced arrows. -/
theorem splitBase_eq_splitChain : splitBase D birth death =
    splitChain (R:=FullSlot D birth death) (ReducedIndex D birth death)
      (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death)) := by
  funext e
  have h := reindex_normal_arrow D birth death hD 0 e
  simp only [map_zero,add_zero] at h
  exact h

/-- Actual geometric positive-fiber codimension in full-span coordinates. The
actual reduced complete product is zero, and every normal identity and kernel
embedding required by the previous theorem is constructed. -/
theorem split_fiber_codim_and_integral (hposD : 0<D) (hvalid : ∀ s,birth s<death s) :
    geometricCodimNat
      {B : Rep (SplitIndex D birth death) | pathMatrix B 0 (Fin.last D) (Fin.zero_le _)=
        pathMatrix (splitBase D birth death) 0 (Fin.last D) (Fin.zero_le _)}
      (splitBase D birth death) =
      Module.finrank ℝ (RegularSpace (FullSlot D birth death)
        (ReducedIndex D birth death (Fin.last D)) (ReducedIndex D birth death 0)) +
      localCodimNat (ReducedIndex D birth death)
        (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death)) ∧
    ∃ n : ℕ,localDimH
      {B : Rep (SplitIndex D birth death) | pathMatrix B 0 (Fin.last D) (Fin.zero_le _)=
        pathMatrix (splitBase D birth death) 0 (Fin.last D) (Fin.zero_le _)}
      (splitBase D birth death)=(n:ℝ≥0∞) := by
  let κ := ReducedIndex D birth death
  let A := splitBase D birth death
  let C := intervalRep D (reducedBirth D birth death) (reducedDeath D birth death)
  let H := orbitDirections (SplitIndex D birth death) A
  let N := splitNormalSpace D birth death hD
  let Nr := MAIS.ActiveIntervalNormal.normalSpace D (reducedBirth D birth death)
    (reducedDeath D birth death) (reduced_bound D birth death hD)
  let eN : N ≃L[ℝ] Nr := (reducedNormalParamEquiv D birth death hD).symm.trans
    (MAIS.ActiveIntervalSliceChart.normalParamEquiv D (reducedBirth D birth death)
      (reducedDeath D birth death) (reduced_bound D birth death hD))
  have hA : pathMatrix A 0 (Fin.last D) (Fin.zero_le _)=standardTarget :=
    split_base_completeProduct D birth death hD
  have hC : C∈zeroFiber κ := reduced_base_completeProduct_zero D birth death hD
  have hvalidr : ∀ s : ReducedSlot D birth death,
      reducedBirth D birth death s < reducedDeath D birth death s := fun s=>hvalid s.val
  have hNr : IsCompl (orbitDifferential κ C).range Nr :=
    MAIS.ActiveIntervalNormal.orbitDifferential_normalSpace_isCompl D
      (reducedBirth D birth death) (reducedDeath D birth death)
      (reduced_bound D birth death hD) hvalidr
  have hR (n:N) : normalResidual κ A N n =
      pathMatrix (C+(eN n:Rep κ)) 0 (Fin.last D) (Fin.zero_le _) := by
    have h := reduced_normal_completeProduct D birth death hD
      ((reducedNormalParamEquiv D birth death hD).symm n)
    rw [(reducedNormalParamEquiv D birth death hD).apply_symm_apply] at h
    have h22 := congrArg Matrix.toBlocks₂₂ h
    change (pathMatrix (A+(n:Rep (SplitIndex D birth death))) 0 (Fin.last D)
      (Fin.zero_le _)).toBlocks₂₂ = pathMatrix
        (C+MAIS.ActiveIntervalNormal.normalInjection D (reducedBirth D birth death)
          (reducedDeath D birth death) (reduced_bound D birth death hD)
          ((reducedNormalParamEquiv D birth death hD).symm n))
        0 (Fin.last D) (Fin.zero_le _)
    simpa only [Matrix.toBlocks_fromBlocks₂₂] using h22
  have hf := geometricCodimNat_split_fiber_and_integral κ hposD A hA H N
    (orbitDirections_isCompl _ _) (splitNormalSpace_isCompl D birth death hD hvalid)
    (splitNormalSpace_completeProduct D birth death hD) C hC
    (splitBase_eq_splitChain D birth death hD) Nr hNr eN hR
  change geometricCodimNat {B : Rep (SplitIndex D birth death) |
    pathMatrix B 0 (Fin.last D) (Fin.zero_le _)=pathMatrix A 0 (Fin.last D) (Fin.zero_le _)} A = _ ∧
    ∃ n : ℕ,localDimH {B : Rep (SplitIndex D birth death) |
      pathMatrix B 0 (Fin.last D) (Fin.zero_le _)=pathMatrix A 0 (Fin.last D) (Fin.zero_le _)} A=(n:ℝ≥0∞)
  rw [hA]
  exact hf

theorem split_fiber_codim (hposD : 0<D) (hvalid : ∀ s,birth s<death s) :
    geometricCodimNat
      {B : Rep (SplitIndex D birth death) | pathMatrix B 0 (Fin.last D) (Fin.zero_le _)=
        pathMatrix (splitBase D birth death) 0 (Fin.last D) (Fin.zero_le _)}
      (splitBase D birth death) =
      Module.finrank ℝ (RegularSpace (FullSlot D birth death)
        (ReducedIndex D birth death (Fin.last D)) (ReducedIndex D birth death 0)) +
      localCodimNat (ReducedIndex D birth death)
        (intervalRep D (reducedBirth D birth death) (reducedDeath D birth death)) := by
  exact (split_fiber_codim_and_integral D birth death hD hposD hvalid).1
end MAIS.Run2GeometricFullSpanFiber

/-- info: 'MAIS.Run2GeometricFullSpanFiber.splitBase_eq_splitChain' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricFullSpanFiber.splitBase_eq_splitChain

/-- info: 'MAIS.Run2GeometricFullSpanFiber.split_fiber_codim_and_integral' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricFullSpanFiber.split_fiber_codim_and_integral

/-- info: 'MAIS.Run2GeometricFullSpanFiber.split_fiber_codim' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricFullSpanFiber.split_fiber_codim
end
end
