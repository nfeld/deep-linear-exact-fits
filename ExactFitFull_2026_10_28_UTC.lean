-- ==================== begin module O7.Run2BarcodeEnumerationData (formalization/O7/Run2BarcodeEnumerationData.lean) ====================
section

/-! An executable finite search space of bounded interval multiplicities.
All predicates below use finite integer slots and arithmetic; no measured
pair, geometric dimension or real matrix rank occurs in their definitions. -/
set_option autoImplicit false
namespace MAIS.Run2BarcodeEnumerationData

abbrev Endpoint (D : ℕ) := Fin (D + 2)
abbrev IntervalKey (D : ℕ) := Endpoint D × Endpoint D
abbrev Multiplicities (D M : ℕ) := IntervalKey D → Fin (M + 1)
abbrev Slot {D M : ℕ} (h : Multiplicities D M) := Σ p : IntervalKey D, Fin (h p).val

def birth {D M : ℕ} {h : Multiplicities D M} (s : Slot h) : ℕ := s.1.1.val
def death {D M : ℕ} {h : Multiplicities D M} (s : Slot h) : ℕ := s.1.2.val

def Valid {D M : ℕ} (h : Multiplicities D M) : Prop :=
  ∀ s : Slot h, birth s < death s

def vertexCount {D M : ℕ} (h : Multiplicities D M) (v : Fin (D + 1)) : ℕ :=
  Fintype.card {s : Slot h // birth s ≤ v.val ∧ v.val < death s}

def pathCount {D M : ℕ} (h : Multiplicities D M) (i j : Fin (D + 1)) : ℕ :=
  Fintype.card {s : Slot h // birth s ≤ i.val ∧ j.val < death s}

def Linked {D M : ℕ} {h : Multiplicities D M} (r s : Slot h) : Prop :=
  birth s < birth r ∧ birth r ≤ death s ∧ death s < death r
instance linkedDecidable {D M : ℕ} {h : Multiplicities D M} (r s : Slot h) :
    Decidable (Linked r s) := inferInstanceAs (Decidable (_ ∧ _ ∧ _))

def incoming {D M : ℕ} {h : Multiplicities D M} (r : Slot h) : ℕ :=
  Fintype.card {s : Slot h // Linked r s}
def outgoing {D M : ℕ} {h : Multiplicities D M} (s : Slot h) : ℕ :=
  Fintype.card {r : Slot h // Linked r s}
def Balanced {D M : ℕ} (h : Multiplicities D M) : Prop :=
  ∀ s : Slot h, birth s ≠ 0 → death s ≠ D + 1 → incoming s = outgoing s

def outputCount {D M : ℕ} (h : Multiplicities D M) : ℕ :=
  Fintype.card {p : Slot h × Slot h // Linked p.1 p.2 ∧ death p.1 = D + 1}

/-- Actual finite arithmetic feasibility for a prescribed architecture and
prescribed integer path-rank input. -/
def Feasible {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) (h : Multiplicities D M) : Prop :=
  Valid h ∧ (∀ v, vertexCount h v = dims v) ∧
  pathCount h 0 (Fin.last D) = 0 ∧
  ∀ i j, i ≤ j → ranks i j ≤ pathCount h i j

instance validDecidable {D M : ℕ} (h : Multiplicities D M) : Decidable (Valid h) := by
  unfold Valid
  infer_instance
instance balancedDecidable {D M : ℕ} (h : Multiplicities D M) : Decidable (Balanced h) := by
  unfold Balanced
  infer_instance
instance feasibleDecidable {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) (h : Multiplicities D M) :
    Decidable (Feasible dims ranks h) := by
  unfold Feasible
  infer_instance

/-- Literal exhaustive list: the ambient list has exactly
(M+1)^((D+2)^2) entries before filtering. -/
def candidates {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : Finset (Multiplicities D M) :=
  Finset.univ.filter (Feasible dims ranks)

def balancedCandidates {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : Finset (Multiplicities D M) :=
  (candidates dims ranks).filter Balanced

def outputValues {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : Finset ℕ :=
  (balancedCandidates (M := M) dims ranks).image outputCount

@[simp] theorem mem_candidates {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) (h : Multiplicities D M) :
    h ∈ candidates dims ranks ↔ Feasible dims ranks h := by simp [candidates]

@[simp] theorem mem_balancedCandidates {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) (h : Multiplicities D M) :
    h ∈ balancedCandidates dims ranks ↔ Feasible dims ranks h ∧ Balanced h := by
  simp [balancedCandidates]

/-- Every listed integer value has an actual attained finite-array witness. -/
@[simp] theorem mem_outputValues {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) (k : ℕ) :
    k ∈ outputValues (M := M) dims ranks ↔
      ∃ h : Multiplicities D M, Feasible dims ranks h ∧ Balanced h ∧ outputCount h = k := by
  simp only [outputValues, Finset.mem_image, mem_balancedCandidates]
  constructor
  · rintro ⟨h, ⟨hf, hb⟩, hk⟩
    exact ⟨h, hf, hb, hk⟩
  · rintro ⟨h, hf, hb, hk⟩
    exact ⟨h, ⟨hf, hb⟩, hk⟩

/-- The complete list before filtering has an explicit finite cardinality. -/
theorem multiplicities_card (D M : ℕ) :
    Fintype.card (Multiplicities D M) = (M + 1) ^ ((D + 2) * (D + 2)) := by
  simp only [Multiplicities, IntervalKey, Endpoint, Fintype.card_fun,
    Fintype.card_fin, Fintype.card_prod]

/-- Executable minimum, with infinity for an empty feasible list. -/
def minimum {D M : ℕ} (dims : Fin (D + 1) → ℕ)
    (ranks : Fin (D + 1) → Fin (D + 1) → ℕ) : WithTop ℕ :=
  (outputValues (M := M) dims ranks).min

end MAIS.Run2BarcodeEnumerationData

/-- info: 'MAIS.Run2BarcodeEnumerationData.multiplicities_card' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumerationData.multiplicities_card

/-- info: 'MAIS.Run2BarcodeEnumerationData.mem_outputValues' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2BarcodeEnumerationData.mem_outputValues
end
-- ==================== end module O7.Run2BarcodeEnumerationData ====================

-- ==================== begin module O7.IntervalIncidence (formalization/O7/IntervalIncidence.lean) ====================
section

/-! The literal finite path-incidence matrix controlling a linked interval pair.
Its image is proved to be the zero-sum hyperplane; the actual first arrow entry
is a genuine complementary normal direction. -/
set_option autoImplicit false

namespace MAIS.IntervalIncidence

open scoped Matrix

variable (K : Type*) [Field K]

/-- One column for every consecutive edge of a finite path: +1 at its first
    endpoint and -1 at its next endpoint. -/
def boundaryMatrix (n : ℕ) : Matrix (Fin (n + 1)) (Fin n) K := fun i j =>
  (if i = j.castSucc then 1 else 0) - (if i = j.succ then 1 else 0)

/-- The scalar obstruction is the actual sum of all arrow coordinates. -/
def total (n : ℕ) : (Fin (n + 1) → K) →ₗ[K] K where
  toFun y := ∑ i, y i
  map_add' _ _ := Finset.sum_add_distrib
  map_smul' r x := by simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]

/-- The actual entrance-arrow vector. -/
def entrance (n : ℕ) : Fin (n + 1) → K := Pi.single 0 1

@[simp]
theorem total_entrance (n : ℕ) : total K n (entrance K n) = 1 := by
  simp [total, entrance]

/-- Every genuine incidence column has zero total. -/
theorem sum_boundary_mulVec (n : ℕ) (x : Fin n → K) :
    total K n ((boundaryMatrix K n).mulVec x) = 0 := by
  change (∑ i, ∑ j, boundaryMatrix K n i j * x j) = 0
  rw [Finset.sum_comm]
  apply Finset.sum_eq_zero
  intro j _
  simp [boundaryMatrix, sub_mul, Finset.sum_sub_distrib]

/-- Deleting only the last row gives a genuine unit lower triangular matrix. -/
theorem boundary_minor_lower (n : ℕ) :
    ((boundaryMatrix K n).submatrix Fin.castSucc id).IsLowerTriangular := by
  intro i j hij
  have h : i.val < j.val := hij
  have hne : i.castSucc ≠ j.castSucc := by intro he; have := congrArg Fin.val he; simp at this; omega
  have hns : i.castSucc ≠ j.succ := by intro he; have := congrArg Fin.val he; simp at this; omega
  simp [boundaryMatrix, hne, hns]

@[simp]
theorem boundary_minor_diag (n : ℕ) (i : Fin n) :
    ((boundaryMatrix K n).submatrix Fin.castSucc id) i i = 1 := by
  have hne : i.castSucc ≠ i.succ := by intro he; have := congrArg Fin.val he; simp at this
  simp [boundaryMatrix, hne]

@[simp]
theorem boundary_minor_det (n : ℕ) :
    ((boundaryMatrix K n).submatrix Fin.castSucc id).det = 1 := by
  rw [Matrix.det_of_isLowerTriangular _ (boundary_minor_lower K n)]
  apply Finset.prod_eq_one
  intro i _
  exact boundary_minor_diag K n i

/-- Actual matrix rank, including the empty domain n=0. -/
theorem boundary_rank (n : ℕ) : (boundaryMatrix K n).rank = n := by
  have hminor : ((boundaryMatrix K n).submatrix Fin.castSucc id).rank = n := by
    simpa using Matrix.rank_of_det_ne_zero
      (A := (boundaryMatrix K n).submatrix Fin.castSucc id)
      (by rw [boundary_minor_det]; exact one_ne_zero)
  have hle := Matrix.rank_submatrix_le (boundaryMatrix K n) Fin.castSucc id
  have hupper := Matrix.rank_le_card_width (boundaryMatrix K n)
  apply le_antisymm
  · simpa only [Fintype.card_fin] using hupper
  · rw [hminor] at hle
    exact hle

/-- The actual linear map of the actual incidence matrix. -/
noncomputable def boundaryLinear (n : ℕ) : (Fin n → K) →ₗ[K] (Fin (n + 1) → K) :=
  Matrix.toLin' (boundaryMatrix K n)

@[simp]
theorem boundaryLinear_apply (n : ℕ) (x : Fin n → K) :
    boundaryLinear K n x = (boundaryMatrix K n).mulVec x := rfl

/-- The scalar obstruction is genuinely nonzero, even when n=0. -/
theorem total_ne_zero (n : ℕ) : total K n ≠ 0 := by
  intro h
  have he := congrArg (fun f : (Fin (n + 1) → K) →ₗ[K] K => f (entrance K n)) h
  exact one_ne_zero (by simpa only [total_entrance, LinearMap.zero_apply] using he)

/-- The image is exactly the zero-sum hyperplane, not merely contained in it. -/
theorem boundary_range_eq_ker_total (n : ℕ) :
    (boundaryLinear K n).range = (total K n).ker := by
  have hle : (boundaryLinear K n).range ≤ (total K n).ker := by
    rintro y ⟨x, rfl⟩
    exact sum_boundary_mulVec K n x
  have hdimR : Module.finrank K (boundaryLinear K n).range = n := by
    change (boundaryMatrix K n).rank = n
    exact boundary_rank K n
  have hdimT : Module.finrank K (total K n).ker = n := by
    have h := Module.Dual.finrank_ker_add_one_of_ne_zero (total_ne_zero K n)
    simp only [Module.finrank_pi, Fintype.card_fin] at h
    omega
  exact Submodule.eq_of_le_of_finrank_eq hle (hdimR.trans hdimT.symm)

/-- The entrance-arrow vector does not lie in the actual tangent image. -/
theorem entrance_not_mem_range (n : ℕ) :
    entrance K n ∉ (boundaryLinear K n).range := by
  rw [boundary_range_eq_ker_total, LinearMap.mem_ker, total_entrance]
  exact one_ne_zero

/-- The literal entrance-arrow coordinate is an honest complementary subspace
    to the actual incidence image. -/
theorem boundary_entrance_isCompl (n : ℕ) :
    IsCompl (boundaryLinear K n).range (Submodule.span K {entrance K n}) := by
  rw [boundary_range_eq_ker_total]
  refine ⟨Submodule.disjoint_span_singleton_of_notMem ?_, ?_⟩
  · simp only [LinearMap.mem_ker, total_entrance]
    exact one_ne_zero
  · exact codisjoint_iff.mpr (by
      rw [sup_comm]
      exact LinearMap.span_singleton_sup_ker_eq_top (total K n) (by simp))

end MAIS.IntervalIncidence
end
