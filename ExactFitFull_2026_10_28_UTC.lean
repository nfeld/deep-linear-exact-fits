-- ==================== begin module O7.Run2PositiveRegularDimension (formalization/O7/Run2PositiveRegularDimension.lean) ====================
section

/-! The actual number of regular coordinates equals the actual rank-r output
manifold dimension formula. This is finite matrix/dimension algebra only. -/
set_option autoImplicit false
noncomputable section
namespace MAIS.Run2PositiveRegularDimension
open MAIS.Run2PositiveEndpointRegular MAIS.QuiverDirectSumRanks
variable {R M N : Type*} [Fintype R] [Fintype M] [Fintype N]
  [DecidableEq R] [DecidableEq M] [DecidableEq N]

omit [DecidableEq M] [DecidableEq N] in
/-- The literal identity/zero target has its actual matrix rank. -/
theorem rank_standardTarget :
    (standardTarget : Matrix (R⊕M) (R⊕N) ℝ).rank = Fintype.card R := by
  simpa only [standardTarget,Matrix.rank_one,Matrix.rank_zero,add_zero] using
    rank_fromBlocks_zero (1 : Matrix R R ℝ) (0 : Matrix M N ℝ)

omit [DecidableEq R] [DecidableEq M] [DecidableEq N] in
/-- Count the actual regular block carrier using its genuine finite dimension. -/
theorem finrank_regularSpace :
    Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace R M N) =
      Fintype.card R*Fintype.card R+Fintype.card R*Fintype.card N+
        Fintype.card M*Fintype.card R := by
  simp only [MAIS.Run2PositiveEndpointRegular.RegularSpace,Module.finrank_prod,
    Module.finrank_matrix,Module.finrank_self,mul_one]
  omega

omit [DecidableEq M] [DecidableEq N] in
/-- The regular Gaussian factor is counted by actual output rank and actual
endpoint cardinalities; no codimension or exponent is defined by this formula. -/
theorem finrank_regularSpace_eq_rank_formula :
    Module.finrank ℝ (MAIS.Run2PositiveEndpointRegular.RegularSpace R M N) =
      (standardTarget : Matrix (R⊕M) (R⊕N) ℝ).rank *
        (Fintype.card (R⊕N)+Fintype.card (R⊕M)-
          (standardTarget : Matrix (R⊕M) (R⊕N) ℝ).rank) := by
  rw [finrank_regularSpace,rank_standardTarget,Fintype.card_sum,Fintype.card_sum]
  have h : Fintype.card R+Fintype.card N+(Fintype.card R+Fintype.card M)-Fintype.card R =
      Fintype.card R+Fintype.card N+Fintype.card M := by omega
  rw [h]
  ring

end MAIS.Run2PositiveRegularDimension

/-- info: 'MAIS.Run2PositiveRegularDimension.rank_standardTarget' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveRegularDimension.rank_standardTarget

/-- info: 'MAIS.Run2PositiveRegularDimension.finrank_regularSpace' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveRegularDimension.finrank_regularSpace

/-- info: 'MAIS.Run2PositiveRegularDimension.finrank_regularSpace_eq_rank_formula' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PositiveRegularDimension.finrank_regularSpace_eq_rank_formula
end
end
