-- ==================== begin module O7.Run2GeometricBalancedAttainer (formalization/O7/Run2GeometricBalancedAttainer.lean) ====================
section

/-! A true maximal-dimensional zero-fiber orbit has no residual normal
coordinates: any actual residual axis would stay in the zero product fiber
and give a strict increase of the actual orbit-differential rank. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricBalancedAttainer
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank MAIS.OrbitSliceLinear
open MAIS.MatrixCoordinateTransport MAIS.BarcodeActiveNormalForm
open MAIS.QuiverCoordinateMeasuredPair MAIS.QuiverIntervalMeasuredNormalForm
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct
open MAIS.ActiveIntervalEndpointRows MAIS.ActiveIntervalDirectElimination
open MAIS.ActiveIntervalGaussianCoordinates MAIS.ActiveIntervalResidualAxis
open MAIS.Run2StrictOrbitDimension MAIS.Run2OrbitDifferentialGauge
open MAIS.Run2OrbitDifferentialCoordinates
open MAIS.Run2GeometricZeroFiber MAIS.Run2GeometricCodimension
open MAIS.Run2GeometricFiberInvariance MAIS.Run2GeometricOutputCut
open MAIS.Run2PotentialBalancedNormalForms MAIS.Run2PotentialBalance MAIS.Run2PotentialStationarity

variable {D : ℕ} {ι : Fin (D + 1) → Type*}
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

theorem normal_count_eq_cokernel (B : Rep ι) (N : ActiveNormalForm B) :
    Fintype.card (NormalIndex N.birth N.death) =
      Module.finrank ℝ (Rep ι) - Module.finrank ℝ (orbitDifferential ι B).range := by
  let C := intervalRep D N.birth N.death
  have hq := Submodule.finrank_quotient_add_finrank
    (orbitDifferential (Index D N.birth N.death) C).range
  rw [MAIS.ActiveIntervalNormal.finrank_orbitDifferential_cokernel
    D N.birth N.death N.bounded N.valid] at hq
  have hamb := (coordinateContinuousEquiv N.coordinates).toLinearEquiv.finrank_eq
  have hr :
      Module.finrank ℝ (orbitDifferential ι B).range =
        Module.finrank ℝ (orbitDifferential (Index D N.birth N.death) C).range := by
    calc
      _ = Module.finrank ℝ (orbitDifferential ι (transport N.coordinates C)).range :=
        finrank_range_eq_of_mem_orbit ι N.original_in_orbit
      _ = _ := finrank_range_transport N.coordinates C
  omega

theorem isEmpty_residual_of_maximal_rank
    (A B : Rep ι) (N : ActiveNormalForm B)
    (hB : B ∈ zeroFiber ι)
    (hAB : A ∈ closure (MulAction.orbit (Gauge ι) B))
    (hmax : ∀ C : Rep ι, C ∈ zeroFiber ι →
      A ∈ closure (MulAction.orbit (Gauge ι) C) →
      Module.finrank ℝ (orbitDifferential ι C).range ≤
        Module.finrank ℝ (orbitDifferential ι B).range) :
    IsEmpty (ResidualIndex D N.birth N.death) := by
  refine ⟨fun p => ?_⟩
  let C := intervalRep D N.birth N.death
  let t : NormalParams N.birth N.death := Pi.single p.val 1
  let T := normalFamily D N.birth N.death N.bounded t
  let T₀ := transport N.coordinates T
  have ht : t ≠ 0 := by
    intro ht
    have hp := congrFun ht p.val
    have hp1 : (1 : ℝ) = 0 := by
      simpa only [t, Pi.single_eq_same, Pi.zero_apply] using hp
    exact one_ne_zero hp1
  have hCzero : pathMatrix C 0 (Fin.last D) (Nat.zero_le D) = 0 :=
    intervalRep_zero_of_original_zero N 0 (Fin.last D) (Nat.zero_le D) hB
  have hTzero : T ∈ zeroFiber (Index D N.birth N.death) := by
    have h := fullProduct_axis_eq_base D N.birth N.death N.bounded p.val p.property (1 : ℝ)
    change pathMatrix T 0 (Fin.last D) (Nat.zero_le D) = 0
    calc
      _ = pathMatrix C 0 (Fin.last D) (Nat.zero_le D) := by
        simpa only [one_smul] using h
      _ = 0 := hCzero
  have hT₀zero : T₀ ∈ zeroFiber ι := by
    rw [← coordinate_image_zeroFiber N.coordinates]
    exact ⟨T, hTzero, rfl⟩
  have hCT : C ∈ closure (MulAction.orbit (Gauge (Index D N.birth N.death)) T) :=
    (MAIS.ActiveIntervalStrictGenerization.strict_generization
      D N.birth N.death N.bounded t ht).1
  have hBT : B ∈ closure (MulAction.orbit (Gauge ι) T₀) :=
    quiver_orbit_closure_trans ι (subset_closure N.original_in_orbit)
      (transport_mem_closure_orbit N.coordinates hCT)
  have hAT : A ∈ closure (MulAction.orbit (Gauge ι) T₀) :=
    quiver_orbit_closure_trans ι hAB hBT
  have hr := normal_finrank_range_strict D N.birth N.death N.bounded N.valid t ht
  have hTB := hmax T₀ hT₀zero hAT
  have hBdim :
      Module.finrank ℝ (orbitDifferential ι B).range =
        Module.finrank ℝ (orbitDifferential (Index D N.birth N.death) C).range := by
    calc
      _ = Module.finrank ℝ (orbitDifferential ι (transport N.coordinates C)).range :=
        finrank_range_eq_of_mem_orbit ι N.original_in_orbit
      _ = _ := finrank_range_transport N.coordinates C
  have hTdim :
      Module.finrank ℝ (orbitDifferential ι T₀).range =
        Module.finrank ℝ (orbitDifferential (Index D N.birth N.death) T).range :=
    finrank_range_transport N.coordinates T
  rw [hBdim, hTdim] at hTB
  exact (not_lt_of_ge hTB) hr

section EmptyResidual
variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ)
variable [IsEmpty (ResidualIndex D birth death)]

omit [Fintype S] [DecidableEq S] in
theorem isDirect_of_isEmpty_residual (p : NormalIndex birth death) :
    IsDirect D birth death p := by
  by_contra hp
  exact isEmptyElim (⟨p, hp⟩ : ResidualIndex D birth death)

theorem balanced_of_isEmpty_residual : Balanced D birth death := by
  intro v hb hd
  have htarget : fiberCount (targetSlot birth death) v = 0 := by
    apply Finset.card_eq_zero.mpr
    apply Finset.filter_eq_empty_iff.mpr
    intro p _ hp
    apply hd
    rw [← hp]
    exact (isDirect_of_isEmpty_residual D birth death p).2
  have hsource : fiberCount (sourceSlot birth death) v = 0 := by
    apply Finset.card_eq_zero.mpr
    apply Finset.filter_eq_empty_iff.mpr
    intro p _ hp
    apply hb
    rw [← hp]
    exact (isDirect_of_isEmpty_residual D birth death p).1
  rw [htarget, hsource]

theorem outputCount_eq_cardNormal_of_isEmpty_residual :
    outputCount D birth death = Fintype.card (NormalIndex birth death) := by
  unfold outputCount outputEdgeCount
  have hf : Finset.univ.filter
      (fun p : NormalIndex birth death => targetSlot birth death p ∈ outputSlots D death) =
      Finset.univ := by
    apply Finset.filter_eq_self.mpr
    intro p _
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
      (isDirect_of_isEmpty_residual D birth death p).2⟩
  rw [hf, Finset.card_univ]

end EmptyResidual
end MAIS.Run2GeometricBalancedAttainer

