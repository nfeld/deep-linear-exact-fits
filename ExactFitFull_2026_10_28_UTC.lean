-- ==================== begin module O7.MatrixRankGeneration (formalization/O7/MatrixRankGeneration.lean) ====================
section

/-!
Full generation of actual nonnegative integer matrix northwest order by
positive linked switches, with all intermediates between the endpoints.
The proof constructs actual canonical permutations and projects their verified
terminating swap chain.  Idle projected swaps become reflexive steps.
-/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open scoped BigOperators

namespace MAIS.MatrixRankGeneration

open MAIS.CanonicalPermutation
open MAIS.MatrixBlockProjection
open MAIS.PermutationRankOrder
open MAIS.PermutationInterpolation

variable {m n : ℕ}

lemma entry_as_double_sum (A : Fin m → Fin n → ℕ) (r : Fin m) (c : Fin n) :
    A r c = ∑ a, ∑ k, if a = r ∧ k = c then A a k else 0 := by
  classical
  symm
  rw [Finset.sum_eq_single r]
  · simp
  · intro a _ha hne
    simp [hne]
  · simp

/-- Actual matrix entries are recovered by four adjacent actual prefix sums. -/
lemma northwest_second_difference (A : Fin m → Fin n → ℕ) (r : Fin m) (c : Fin n) :
    northWest A (r.val + 1) (c.val + 1) + northWest A r.val c.val =
      northWest A (r.val + 1) c.val + northWest A r.val (c.val + 1) + A r c := by
  rw [entry_as_double_sum A r c]
  unfold northWest
  simp only [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro a _ha
  apply Finset.sum_congr rfl
  intro k _hk
  simp only [Fin.ext_iff]
  split_ifs <;> omega

lemma eq_of_northwest (A B : Fin m → Fin n → ℕ)
    (h : ∀ i j, northWest A i j = northWest B i j) : A = B := by
  funext r c
  have hA := northwest_second_difference A r c
  have hB := northwest_second_difference B r c
  simp only [h] at hA
  omega

noncomputable def rowLabel (A : Fin m → Fin n → ℕ) (p : Fin (mass A)) : Fin m :=
  (rowEnumeration A p).1

noncomputable def valueLabel (A : Fin m → Fin n → ℕ) (p : Fin (mass A)) : Fin n :=
  (columnEnumeration A p).2.1

noncomputable def project (A : Fin m → Fin n → ℕ)
    (u : Equiv.Perm (Fin (mass A))) : Fin m → Fin n → ℕ :=
  cellCount (rowLabel A) (valueLabel A) u

lemma rowLabel_cut (A : Fin m → Fin n → ℕ) (i : ℕ) :
    cutCard (rowLabel A) i = rowBoundary A i := by
  exact enumeration_count A (rowEnumeration A).toEquiv (fun r _c => r.val < i)

lemma valueLabel_cut (A : Fin m → Fin n → ℕ) (j : ℕ) :
    cutCard (valueLabel A) j = columnBoundary A j := by
  exact enumeration_count A
    ((columnEnumeration A).toEquiv.trans (rowToColumn A).symm) (fun _r c => c.val < j)

lemma project_northwest (A : Fin m → Fin n → ℕ)
    (u : Equiv.Perm (Fin (mass A))) (i j : ℕ) :
    northWest (project A u) i j = Q u (rowBoundary A i) (columnBoundary A j) := by
  rw [show northWest (project A u) i j = Q u (cutCard (rowLabel A) i)
      (cutCard (valueLabel A) j) from
      northwest_eq_Q (rowLabel A) (valueLabel A) (row_monotone A) (column_monotone A) u i j]
  rw [rowLabel_cut, valueLabel_cut]

lemma project_canonical (A : Fin m → Fin n → ℕ) : project A (canonical A) = A := by
  apply eq_of_northwest
  intro i j
  rw [project_northwest, Q_boundaries]

lemma project_reindexed (A B : Fin m → Fin n → ℕ) (hmass : mass B = mass A)
    (hrow : ∀ i, rowBoundary B i = rowBoundary A i)
    (hcol : ∀ j, columnBoundary B j = columnBoundary A j) :
    project A (reindexPermutation hmass (canonical B)) = B := by
  apply eq_of_northwest
  intro i j
  rw [project_northwest, Q_reindex, ← hrow i, ← hcol j, Q_boundaries]

lemma project_columnBoundary (A : Fin m → Fin n → ℕ)
    (u : Equiv.Perm (Fin (mass A))) (j : ℕ) :
    columnBoundary (project A u) j = columnBoundary A j := by
  exact (columnBoundary_cellCount (rowLabel A) (valueLabel A) u j).trans (valueLabel_cut A j)

/-- All actual northwest sums lie between the endpoint sums. -/
def Between (lo hi M : Fin m → Fin n → ℕ) : Prop :=
  ∀ i j, northWest lo i j ≤ northWest M i j ∧ northWest M i j ≤ northWest hi i j

/-- A linked switch retaining the full endpoint rank sandwich. -/
def BoundedLinkedSwitch (lo hi X Y : Fin m → Fin m → ℕ) : Prop :=
  LinkedSwitch X Y ∧ Between lo hi X ∧ Between lo hi Y

lemma upper_of_between (A B : Fin m → Fin m → ℕ)
    (hA : ∀ r c, c < r → A r c = 0) (hB : ∀ r c, c < r → B r c = 0)
    (hcol : ∀ j, columnBoundary B j = columnBoundary A j)
    (u : Equiv.Perm (Fin (mass A))) (hbounds : Between B A (project A u)) :
    ∀ r c, c < r → project A u r c = 0 := by
  apply upper_of_diagonal (rowLabel A) (valueLabel A) u
  intro k
  have hAk := MAIS.IntervalPaddingOrder.northwest_eq_column_of_upper A hA k k (le_refl k)
  have hBk := MAIS.IntervalPaddingOrder.northwest_eq_column_of_upper B hB k k (le_refl k)
  have hb := hbounds k k
  rw [hAk, hBk, hcol k] at hb
  have heq : northWest (project A u) k k = columnBoundary A k := by omega
  exact heq.trans (project_columnBoundary A u k).symm

/-- Projecting a finite chain and removing its idle steps gives a finite genuine relation path. -/
lemma relation_path_of_chain {α β : Type*} (f : α → β)
    (R : α → α → Prop) (S : β → β → Prop) (x : α) (tail : List α)
    (hchain : (x :: tail).IsChain R)
    (hstep : ∀ a ∈ x :: tail, ∀ b ∈ x :: tail, R a b → f a = f b ∨ S (f a) (f b)) :
    Relation.ReflTransGen S (f x) (f ((x :: tail).getLast (List.cons_ne_nil _ _))) := by
  induction tail generalizing x with
  | nil => exact Relation.ReflTransGen.refl
  | cons y ys ih =>
    obtain ⟨hxy, hrest⟩ := List.isChain_cons_cons.mp hchain
    have htail := ih y hrest (by
      intro a ha b hb hab
      exact hstep a (List.mem_cons_of_mem x ha) b (List.mem_cons_of_mem x hb) hab)
    have hedge := hstep x (by simp) y (by simp) hxy
    simp only [List.getLast_cons_cons]
    rcases hedge with heq | hs
    · rw [heq]
      exact htail
    · exact (Relation.ReflTransGen.single hs).trans htail

/-- Full finite generation of triangular integer-matrix northwest order by actual linked
    switches, with every intermediate northwest rank between the endpoint ranks. -/
theorem matrix_rank_order_generated (A B : Fin m → Fin m → ℕ)
    (hrow : ∀ i, rowBoundary B i = rowBoundary A i)
    (hcol : ∀ j, columnBoundary B j = columnBoundary A j)
    (hNW : ∀ i j, northWest B i j ≤ northWest A i j)
    (hA : ∀ r c, c < r → A r c = 0) (hB : ∀ r c, c < r → B r c = 0) :
    Relation.ReflTransGen (BoundedLinkedSwitch B A) A B := by
  have hmass : mass B = mass A := by simpa only [rowBoundary_total] using hrow m
  let w := reindexPermutation hmass (canonical B)
  obtain ⟨tail, hchain, hlast, hbounds⟩ := canonical_swap_chain A B hrow hcol hNW
  change (canonical A :: tail).getLast (List.cons_ne_nil _ _) = w at hlast
  change ∀ u ∈ canonical A :: tail, RankLE w u ∧ RankLE u (canonical A) at hbounds
  have hbetween : ∀ u ∈ canonical A :: tail, Between B A (project A u) := by
    intro u hu i j
    have hr := hbounds u hu
    have hlow := northwest_mono_of_RankLE (rowLabel A) (valueLabel A)
      (row_monotone A) (column_monotone A) u w hr.1 i j
    have hhigh := northwest_mono_of_RankLE (rowLabel A) (valueLabel A)
      (row_monotone A) (column_monotone A) (canonical A) u hr.2 i j
    change northWest (project A w) i j ≤ northWest (project A u) i j at hlow
    change northWest (project A u) i j ≤ northWest (project A (canonical A)) i j at hhigh
    rw [show project A w = B from project_reindexed A B hmass hrow hcol] at hlow
    rw [project_canonical] at hhigh
    exact ⟨hlow, hhigh⟩
  have hupper : ∀ u ∈ canonical A :: tail, ∀ r c, c < r → project A u r c = 0 := by
    intro u hu
    exact upper_of_between A B hA hB hcol u (hbetween u hu)
  have hstep : ∀ x ∈ canonical A :: tail, ∀ y ∈ canonical A :: tail,
      IncreasingSwap x y → project A x = project A y ∨
        BoundedLinkedSwitch B A (project A x) (project A y) := by
    intro x hx y hy hxy
    obtain ⟨p, q, hpq, hv, hyEq⟩ := hxy
    subst y
    rcases increasing_swap_projects (rowLabel A) (valueLabel A)
      (row_monotone A) (column_monotone A) x p q hpq hv with heq | hs
    · exact Or.inl heq.symm
    · exact Or.inr ⟨linked_of_switch_upper _ _ hs (hupper _ hy), hbetween x hx, hbetween _ hy⟩
  have hp := relation_path_of_chain (project A) IncreasingSwap (BoundedLinkedSwitch B A)
    (canonical A) tail hchain hstep
  rw [hlast, project_canonical, show project A w = B from project_reindexed A B hmass hrow hcol] at hp
  exact hp

/-- The full finite linked-interval generation theorem for actual padded multiplicities. -/
theorem interval_rank_order_generated (S R : Fin m → Fin m → ℕ) (N : ℕ)
    (hS : ∀ a, MAIS.TypeAPadding.starts S a ≤ N)
    (hR : ∀ a, MAIS.TypeAPadding.starts R a ≤ N)
    (hdim : ∀ i, MAIS.IntervalPaddingOrder.crossing S i i = MAIS.IntervalPaddingOrder.crossing R i i)
    (hrank : ∀ i j, i ≤ j →
      MAIS.IntervalPaddingOrder.crossing S i j ≤ MAIS.IntervalPaddingOrder.crossing R i j) :
    Relation.ReflTransGen
      (BoundedLinkedSwitch (MAIS.TypeAPadding.padding R N) (MAIS.TypeAPadding.padding S N))
      (MAIS.TypeAPadding.padding S N) (MAIS.TypeAPadding.padding R N) := by
  apply matrix_rank_order_generated
  · exact MAIS.IntervalPaddingOrder.padding_row_margins S R N hS hR
  · exact MAIS.IntervalPaddingOrder.padding_column_margins S R N hS hR hdim
  · exact MAIS.IntervalPaddingOrder.padding_northwest_order S R N hS hR hdim hrank
  · exact MAIS.IntervalPaddingOrder.padding_upper S N
  · exact MAIS.IntervalPaddingOrder.padding_upper R N

end MAIS.MatrixRankGeneration




/--
info: 'MAIS.MatrixRankGeneration.matrix_rank_order_generated' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.MatrixRankGeneration.matrix_rank_order_generated

/--
info: 'MAIS.MatrixRankGeneration.interval_rank_order_generated' depends on axioms:
  [propext, Classical.choice, Quot.sound]
-/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.MatrixRankGeneration.interval_rank_order_generated
end
