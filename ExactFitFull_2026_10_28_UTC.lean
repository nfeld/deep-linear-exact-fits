#guard_msgs (whitespace := lax) in
#print axioms MAIS.DyadicRadialMeasure.iUnion_shell

/-- info: 'MAIS.DyadicRadialMeasure.radialMeasure_shell' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.DyadicRadialMeasure.radialMeasure_shell

