-- ==================== begin module O7.Run2ArithmeticCriticalPathCounts (formalization/O7/Run2ArithmeticCriticalPathCounts.lean) ====================
section

/-! Exact soundness of the arithmetic coefficient and rational threshold.
These identities precede all measured multiplicity data. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Set MeasureTheory
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2ArithmeticCriticalPathCounts
open MAIS.Run2BarcodeEnumerationData MAIS.Run2ArithmeticCriticalPathData
open MAIS.Run2BarcodeEnumerationRealization MAIS.Run2BarcodeEnumeration
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitFiniteHeight
variable {D M : ℕ}

theorem feasible_rankInput_iff (dims : Fin (D + 1) → ℕ)
    (h k : Multiplicities D M) :
    Feasible dims (rankInput h) k ↔ Feasible dims (fun _ _ => 0) k ∧ RankLE h k := by
  constructor
  · rintro ⟨hv, hd, hz, hr⟩
    refine ⟨⟨hv, hd, hz, fun _ _ _ => Nat.zero_le _⟩, ?_⟩
    intro i j hij
    simpa only [rankInput, ite_eq_left hij] using hr i j hij
  · rintro ⟨⟨hv, hd, hz, _⟩, hr⟩
    refine ⟨hv, hd, hz, ?_⟩
    intro i j hij
    simpa only [rankInput, ite_eq_left hij] using hr i j hij

theorem higherOutputValues_eq (dims : Fin (D + 1) → ℕ)
    (ν : Finset (Multiplicities D M))
    (hν : ν = candidates dims (fun _ _ => 0)) (h : Multiplicities D M) :
    higherOutputValues ν h = outputValues (M := M) dims (rankInput h) := by
  ext k
  simp only [higherOutputValues, Finset.mem_image, Finset.mem_filter]
  rw [mem_outputValues]
  constructor
  · rintro ⟨a, ⟨ha, hr, hb⟩, hk⟩
    have hf : Feasible dims (fun _ _ => 0) a := by simpa only [hν, mem_candidates] using ha
    exact ⟨a, (feasible_rankInput_iff dims h a).mpr ⟨hf, hr⟩, hb, hk⟩
  · rintro ⟨a, hf, hb, hk⟩
    obtain ⟨ha, hr⟩ := (feasible_rankInput_iff dims h a).mp hf
    exact ⟨a, ⟨by simpa only [hν, mem_candidates] using ha, hr, hb⟩, hk⟩

theorem coefficient_eq_untopD_minimum (dims : Fin (D + 1) → ℕ)
    (ν : Finset (Multiplicities D M))
    (hν : ν = candidates dims (fun _ _ => 0)) (h : Multiplicities D M) :
    coefficient ν h = (minimum (M := M) dims (rankInput h)).untopD 0 := by
  unfold coefficient minimum
  rw [higherOutputValues_eq dims ν hν h]

/-- The exact rational threshold casts to the actual canonical real full
normal threshold of this literal interval representation. -/
theorem threshold_cast (h : Multiplicities D M) :
    (Run2ArithmeticCriticalPathData.threshold h : ℝ) =
      MAIS.Run2PotentialNormalBound.threshold (slotBirth h) (slotDeath h)
        (MAIS.ActiveIntervalWeightedResidual.realPotential D (slotBirth h) (slotDeath h)) := by
  simp only [Run2ArithmeticCriticalPathData.threshold, Rat.cast_div,
    Rat.cast_sum, Rat.cast_ofNat, MAIS.Run2PotentialNormalBound.threshold,
    MAIS.Run2PotentialNormalBound.edgeWeights,
    MAIS.IntervalPositivePotentials.edgeWeight, Rat.cast_sub,
    MAIS.ActiveIntervalWeightedResidual.realPotential]
  rfl

variable (ι : Fin (D + 1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]

theorem actualRep_rankInput (h : Multiplicities D (dimensionSum ι))
    (hd : ∀v, vertexCount h v = Fintype.card (ι v)) :
    pathRankInput ι (actualRep h ι hd) = rankInput h := by
  funext i j
  unfold pathRankInput rankInput
  split_ifs with hij
  · exact actualRep_rank h ι hd i j hij
  · rfl

/-- The independently executable coefficient is exactly the independently
defined actual balanced-incidence minimum, with no measured hypothesis. -/
theorem coefficient_eq_balancedOutputMinimum
    (ν : Finset (Multiplicities D (dimensionSum ι)))
    (hν : ν = candidates (architecture ι) (fun _ _ => 0))
    (h : Multiplicities D (dimensionSum ι))
    (hd : ∀v, vertexCount h v = Fintype.card (ι v))
    (hz : pathCount h 0 (Fin.last D) = 0) :
    coefficient ν h = MAIS.Run2PotentialBalancedMinimum.balancedOutputMinimum ι
      (actualRep h ι hd) := by
  rw [coefficient_eq_untopD_minimum (architecture ι) ν hν h,
    ← actualRep_rankInput ι h hd,
    executable_minimum_eq ι (actualRep h ι hd) (actualRep_zero h ι hd hz)]
  rfl

end MAIS.Run2ArithmeticCriticalPathCounts

/-- info: 'MAIS.Run2ArithmeticCriticalPathCounts.higherOutputValues_eq' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathCounts.higherOutputValues_eq

/-- info: 'MAIS.Run2ArithmeticCriticalPathCounts.threshold_cast' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathCounts.threshold_cast

/-- info: 'MAIS.Run2ArithmeticCriticalPathCounts.coefficient_eq_balancedOutputMinimum' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathCounts.coefficient_eq_balancedOutputMinimum
end
end
-- ==================== end module O7.Run2ArithmeticCriticalPathCounts ====================

-- ==================== begin module O7.Run2ArithmeticCriticalPathMeasuredStep (formalization/O7/Run2ArithmeticCriticalPathMeasuredStep.lean) ====================
section

/-! Actual measured Bellman laws at an arbitrary supplied, geometrically
derived active normal form. The normal form is allowed to be the literal
realization of an arithmetic array, rather than a separately chosen orbit
representative; no multiplicity value is used to choose it. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3200000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2ArithmeticCriticalPathMeasuredStep
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open MAIS.MatrixCoordinateTransport MAIS.BarcodeActiveNormalForm
open MAIS.QuiverIntervalMeasuredNormalForm MAIS.ActiveIntervalDifferential
open MAIS.ActiveIntervalMeasuredSlice MAIS.QuiverFinitePairTable
open MAIS.Run2PotentialMultiplicityStep MAIS.Run2PotentialNormalBound
open MAIS.ActiveIntervalWeightedResidual MAIS.AnalyticTransfer
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]

abbrev NativePair (mu : Measure (Rep ι)) (A : Rep ι) (lam : ℝ) (m : ℕ) : Prop :=
  HasMeasuredBandPair mu (Metric.ball A)
    (fun B => ‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖ ^ 2) A lam m

/-- The actual inequality is valid for the canonical threshold of any
actual active normal form of the source, including literal array forms. -/
theorem higher_multiplicity_le
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A B : Rep ι) (N : ActiveNormalForm A)
    (hAzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    (hB : IsHigherZero ι A B) {lam : ℝ} {m n : ℕ}
    (hp : NativePair ι mu A lam m) (hBp : NativePair ι mu B lam n) :
    n + radialIndicator lam (threshold N.birth N.death
      (realPotential D N.birth N.death)) ≤ m := by
  let muK : Measure (Rep (Index D N.birth N.death)) := addHaar
  let T : Rep (Index D N.birth N.death) :=
    transport (fun v => (N.coordinates v).symm) B
  have hKzero := intervalRep_zero_of_original_zero N 0 (Fin.last D) (Nat.zero_le D) hAzero
  have hKp := (pair_iff_normal_form N mu muK 0 (Fin.last D) (Nat.zero_le D)
    hAzero lam m).mp hp
  have hTzero : pathMatrix T 0 (Fin.last D) (Nat.zero_le D) = 0 := by
    rw [path_transport, hB.1]
    rfl
  have hTp := (MAIS.QuiverCoordinateMeasuredPair.pair_iff_coordinate_transport
    (fun v => (N.coordinates v).symm) mu muK B
    0 (Fin.last D) (Nat.zero_le D) lam n).mp hBp
  have hKT : intervalRep D N.birth N.death ∈
      closure (MulAction.orbit (Gauge (Index D N.birth N.death)) T) := by
    apply MAIS.RealTypeAClosure.mem_closure_orbit_of_path_rank_le
    intro a b hab
    rw [path_rank_transport, N.rank_eq a b hab]
    exact path_rank_le_of_mem_closure_orbit hB.2.1 a b hab
  have hnot : T ∉ MulAction.orbit (Gauge (Index D N.birth N.death))
      (intervalRep D N.birth N.death) := by
    intro horb
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp horb
    apply hB.2.2
    apply mem_gauge_orbit_of_path_rank_eq A B
    intro a b hab
    have hr : (pathMatrix T a b hab).rank =
        (pathMatrix (intervalRep D N.birth N.death) a b hab).rank := by
      rw [← hg]
      exact path_rank_gauge g _ a b hab
    rw [path_rank_transport] at hr
    exact (N.rank_eq a b hab).symm.trans hr.symm
  exact same_exponent_higher_multiplicity_le D N.birth N.death N.bounded N.valid
    muK hKzero T ⟨hTzero, hKT, hnot⟩ hKp hTp

/-- If the actual multiplicity exceeds its terminal one, a true higher
zero-output chain attains equality at the same actual exponent. -/
theorem exists_maximizing_higher
    (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A : Rep ι) (N : ActiveNormalForm A)
    (hAzero : pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0)
    {lam : ℝ} {m : ℕ} (hp : NativePair ι mu A lam m) (hmgt : 1 < m) :
    ∃ B : Rep ι, ∃ n : ℕ, IsHigherZero ι A B ∧ NativePair ι mu B lam n ∧
      m = n + radialIndicator lam (threshold N.birth N.death
        (realPotential D N.birth N.death)) := by
  let muK : Measure (Rep (Index D N.birth N.death)) := addHaar
  have hKzero := intervalRep_zero_of_original_zero N 0 (Fin.last D) (Nat.zero_le D) hAzero
  have hKp := (pair_iff_normal_form N mu muK 0 (Fin.last D) (Nat.zero_le D)
    hAzero lam m).mp hp
  obtain ⟨B, n, hB, hBp, hm⟩ := exists_same_exponent_maximizing_successor
    D N.birth N.death N.bounded N.valid muK hKzero hKp hmgt
  let T : Rep ι := transport N.coordinates B
  have hTzero : pathMatrix T 0 (Fin.last D) (Nat.zero_le D) = 0 := by
    rw [path_transport, hB.1]
    rfl
  have hcl : A ∈ closure (MulAction.orbit (Gauge ι) T) := by
    apply MAIS.RealTypeAClosure.mem_closure_orbit_of_path_rank_le
    intro a b hab
    rw [← N.rank_eq a b hab, path_rank_transport]
    exact path_rank_le_of_mem_closure_orbit hB.2.1 a b hab
  have hnot : T ∉ MulAction.orbit (Gauge ι) A := by
    intro horb
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp horb
    apply hB.2.2
    apply mem_gauge_orbit_of_path_rank_eq (intervalRep D N.birth N.death) B
    intro a b hab
    have hr : (pathMatrix T a b hab).rank = (pathMatrix A a b hab).rank := by
      rw [← hg]
      exact path_rank_gauge g _ a b hab
    rw [path_rank_transport] at hr
    exact (N.rank_eq a b hab).trans hr.symm
  have hTp := (MAIS.QuiverCoordinateMeasuredPair.pair_iff_coordinate_transport
    N.coordinates muK mu B 0 (Fin.last D) (Nat.zero_le D) lam n).mp hBp
  exact ⟨T, n, ⟨hTzero, hcl, hnot⟩, hTp, hm⟩

end MAIS.Run2ArithmeticCriticalPathMeasuredStep

/-- info: 'MAIS.Run2ArithmeticCriticalPathMeasuredStep.higher_multiplicity_le' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathMeasuredStep.higher_multiplicity_le

/-- info: 'MAIS.Run2ArithmeticCriticalPathMeasuredStep.exists_maximizing_higher' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2ArithmeticCriticalPathMeasuredStep.exists_maximizing_higher
end
end
-- ==================== end module O7.Run2ArithmeticCriticalPathMeasuredStep ====================

-- ==================== begin module O7.Run2ArithmeticCriticalPathRealization (formalization/O7/Run2ArithmeticCriticalPathRealization.lean) ====================
section

/-! Actual original-carrier realizations of every independently enumerated
arithmetic node, with exact ranks, zero output, coefficient, threshold and
genuine measured pair. This module does not define the graph by its answer. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2800000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.Run2ArithmeticCriticalPathRealization
open MAIS.Run2BarcodeEnumerationData MAIS.Run2ArithmeticCriticalPathData
open MAIS.Run2ArithmeticCriticalPathCounts MAIS.Run2BarcodeEnumerationRealization
open MAIS.Run2BarcodeEnumeration MAIS.Run2BarcodeEnumerationEncoding
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitFiniteHeight
open MAIS.BarcodeActiveNormalForm MAIS.QuiverZeroFinitePairTable
open MAIS.Run2ArithmeticCriticalPathMeasuredStep MAIS.Run2PotentialMultiplicityStep
variable {D : ℕ} (ι : Fin (D + 1) → Type*)
  [∀v,Fintype (ι v)] [∀v,DecidableEq (ι v)]
variable (ν : Finset (Multiplicities D (dimensionSum ι)))
  (hν : ν = candidates (architecture ι) (fun _ _ => 0))

omit [∀v,DecidableEq (ι v)] in
include hν in
theorem nodeFeasible (h : Node ν) :
    Feasible (architecture ι) (fun _ _ => 0) h.val := by
  simpa only [hν, mem_candidates] using h.property

def nodeRep (h : Node ν) : Rep ι := actualRep h.val ι (nodeFeasible ι ν hν h).2.1

def nodeNormalForm (h : Node ν) : ActiveNormalForm (nodeRep ι ν hν h) :=
  actualNormalForm h.val ι (nodeFeasible ι ν hν h).1 (nodeFeasible ι ν hν h).2.1

theorem nodeRep_zero (h : Node ν) :
    pathMatrix (nodeRep ι ν hν h) 0 (Fin.last D) (Nat.zero_le D) = 0 :=
  actualRep_zero h.val ι (nodeFeasible ι ν hν h).2.1 (nodeFeasible ι ν hν h).2.2.1

theorem nodeRep_rank (h : Node ν) (i j : Fin (D + 1)) (hij : i ≤ j) :
    (pathMatrix (nodeRep ι ν hν h) i j hij).rank = pathCount h.val i j :=
  actualRep_rank h.val ι (nodeFeasible ι ν hν h).2.1 i j hij

theorem node_coefficient (h : Node ν) :
    coefficient ν h.val = MAIS.Run2PotentialBalancedMinimum.balancedOutputMinimum ι
      (nodeRep ι ν hν h) :=
  coefficient_eq_balancedOutputMinimum ι ν hν h.val
    (nodeFeasible ι ν hν h).2.1 (nodeFeasible ι ν hν h).2.2.1

def nodeMultiplicity (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (h : Node ν) : ℕ :=
  (pairValue ι mu ⟨nodeRep ι ν hν h, nodeRep_zero ι ν hν h⟩).2

theorem node_pair (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (h : Node ν) : NativePair ι mu (nodeRep ι ν hν h)
      ((coefficient ν h.val : ℝ) / 2) (nodeMultiplicity ι ν hν mu h) := by
  have hp := pairValue_spec ι mu ⟨nodeRep ι ν hν h, nodeRep_zero ι ν hν h⟩
  have ha := MAIS.Run2PotentialBalancedMinimum.exponent_eq_half_balancedOutputMinimum
    ι mu (nodeRep ι ν hν h) (nodeRep_zero ι ν hν h) hp
  rw [← node_coefficient ι ν hν h] at ha
  simpa only [ha, nodeMultiplicity] using hp

theorem node_multiplicity_pos (mu : Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (h : Node ν) : 1 ≤ nodeMultiplicity ι ν hν mu h :=
  (node_pair ι ν hν mu h).2.1

theorem node_weight (h : Node ν) :
    nodeWeight ν h = radialIndicator ((coefficient ν h.val : ℝ) / 2)
      (MAIS.Run2PotentialNormalBound.threshold (nodeNormalForm ι ν hν h).birth
        (nodeNormalForm ι ν hν h).death
        (MAIS.ActiveIntervalWeightedResidual.realPotential D
          (nodeNormalForm ι ν hν h).birth (nodeNormalForm ι ν hν h).death)) := by
  change weight ν h.val = radialIndicator ((coefficient ν h.val : ℝ) / 2)
    (MAIS.Run2PotentialNormalBound.threshold (slotBirth h.val) (slotDeath h.val)
      (MAIS.ActiveIntervalWeightedResidual.realPotential D (slotBirth h.val) (slotDeath h.val)))
  rw [← threshold_cast h.val]
  have heq : ((coefficient ν h.val : ℚ) / 2 = threshold h.val) ↔
      (coefficient ν h.val : ℝ) / 2 = (threshold h.val : ℝ) := by
    constructor
    · intro hh
      have hc := congrArg (fun q : ℚ => (q : ℝ)) hh
      simpa only [Rat.cast_div, Rat.cast_natCast, Rat.cast_ofNat] using hc
    · intro hh
      apply Rat.cast_injective (α := ℝ)
      simpa only [Rat.cast_div, Rat.cast_natCast, Rat.cast_ofNat] using hh
  simp only [weight, radialIndicator, heq]

omit [∀v,DecidableEq (ι v)] in
include hν in
theorem node_height_le (h : Node ν) : height h.val ≤ capacity D (dimensionSum ι) := by
  apply height_le_capacity h.val
  intro v
  rw [(nodeFeasible ι ν hν h).2.1 v]
  exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ v)

omit [∀v,DecidableEq (ι v)] in
include hν in
theorem node_defect_progress {h k : Node ν} (hh : nodeEdge ν h k) :
    defect k.val < defect h.val :=
  defect_lt_of_rankLT hh.1 (node_height_le ι ν hν k)

theorem node_higher_of_edge {h k : Node ν} (hh : nodeEdge ν h k) :
    MAIS.QuiverFinitePairTable.IsHigherZero ι (nodeRep ι ν hν h) (nodeRep ι ν hν k) := by
  refine ⟨nodeRep_zero ι ν hν k, ?_, ?_⟩
  · apply MAIS.RealTypeAClosure.mem_closure_orbit_of_path_rank_le
    intro i j hij
    rw [nodeRep_rank, nodeRep_rank]
    exact hh.1.1 i j hij
  · intro horb
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp horb
    obtain ⟨i, j, hij, hlt⟩ := hh.1.2
    have hr : (pathMatrix (nodeRep ι ν hν k) i j hij).rank =
        (pathMatrix (nodeRep ι ν hν h) i j hij).rank := by
      rw [← hg]
      exact MAIS.QuiverOrbitRank.path_rank_gauge g _ i j hij
    rw [nodeRep_rank, nodeRep_rank] at hr
    omega

end MAIS.Run2ArithmeticCriticalPathRealization

