-- ==================== begin module O7.DyadicRadialMeasure (formalization/O7/DyadicRadialMeasure.lean) ====================
section

/-! Actual dyadic radius partition and literal polynomial radial density. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal Function
namespace MAIS.DyadicRadialMeasure

def scale (k : ℕ) : ℝ := (1/2:ℝ)^k

def shell (k : ℕ) : Set ℝ := Ioc (scale (k+1)) (scale k)

def radialMeasure (A : ℕ) : Measure ℝ :=
  volume.withDensity (fun r : ℝ => ENNReal.ofReal (r^(A-1)))

def shellConstant (A : ℕ) : ℝ := (1-(1/2:ℝ)^A)/(A:ℝ)

def ratio (A : ℕ) : ℝ≥0∞ := ENNReal.ofReal ((1/2:ℝ)^A)

theorem scale_pos (k : ℕ) : 0< scale k := pow_pos (by norm_num) _

theorem scale_antitone : Antitone scale := by
  apply antitone_nat_of_succ_le
  intro k
  unfold scale
  rw [pow_succ]
  have h := pow_nonneg (by norm_num : (0:ℝ)≤1/2) k
  nlinarith

theorem scale_le_one (k : ℕ) : scale k≤1 := by
  simpa [scale] using scale_antitone (Nat.zero_le k)

theorem shell_pairwise_disjoint : Pairwise (Disjoint on shell) := by
  intro i j hij
  rcases lt_or_gt_of_ne hij with hlt | hgt
  · apply disjoint_left.mpr
    intro r hri hrj
    have h := scale_antitone (Nat.succ_le_of_lt hlt)
    exact (not_lt_of_ge (hrj.2.trans h)) hri.1
  · apply disjoint_left.mpr
    intro r hri hrj
    have h := scale_antitone (Nat.succ_le_of_lt hgt)
    exact (not_lt_of_ge (hri.2.trans h)) hrj.1

theorem iUnion_shell : (⋃ k:ℕ,shell k) = Ioc (0:ℝ) 1 := by
  ext r
  constructor
  · intro hr
    obtain ⟨k,hk⟩ := mem_iUnion.mp hr
    exact ⟨(scale_pos (k+1)).trans hk.1,hk.2.trans (scale_le_one k)⟩
  · intro hr
    have hex : ∃ n:ℕ,scale n<r := exists_pow_lt_of_lt_one hr.1 (by norm_num : (1/2:ℝ)<1)
    let n := Nat.find hex
    have hn : scale n<r := Nat.find_spec hex
    have hn0 : n≠0 := by intro h; simp only [h,scale,pow_zero] at hn; linarith [hr.2]
    have hprev : r≤ scale (n-1) := by
      by_contra h
      have hlt : scale (n-1)<r := lt_of_not_ge h
      have hmin : n≤n-1 := Nat.find_min' hex hlt
      omega
    refine mem_iUnion.mpr ⟨n-1,?_,hprev⟩
    simpa only [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hn0)] using hn

theorem shellConstant_pos {A : ℕ} (hA : 0<A) : 0<shellConstant A := by
  have hpow : (1/2:ℝ)^A<1 := pow_lt_one₀ (by norm_num) (by norm_num) (Nat.ne_zero_of_lt hA)
  unfold shellConstant
  exact div_pos (sub_pos.mpr hpow) (by exact_mod_cast hA)

/-- The actual radial density mass of each literal dyadic interval is computed
from the proved polynomial integral, rather than assigned as a shell weight. -/
theorem radialMeasure_shell {A : ℕ} (hA : 0<A) (k : ℕ) :
    radialMeasure A (shell k) = ENNReal.ofReal (shellConstant A) * ratio A ^ k := by
  have hab : scale (k+1)≤ scale k := scale_antitone (by omega)
  have hfint : IntegrableOn (fun r : ℝ => r^(A-1)) (Ioc (scale (k+1)) (scale k)) :=
    ((continuous_id.pow (A-1)).intervalIntegrable _ _).1
  have hfnn : 0≤ᵐ[volume.restrict (Ioc (scale (k+1)) (scale k))]
      (fun r : ℝ => r^(A-1)) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with r hr
    exact pow_nonneg ((scale_pos (k+1)).trans hr.1).le _
  have hmass : radialMeasure A (shell k) =
      ENNReal.ofReal ((scale k^A-scale (k+1)^A)/(A:ℝ)) := by
    rw [radialMeasure,shell,withDensity_apply _ measurableSet_Ioc,
      ← ofReal_integral_eq_lintegral_ofReal hfint hfnn,
      ← intervalIntegral.integral_of_le hab,integral_pow]
    simp only [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr (Nat.ne_zero_of_lt hA))]
    congr 2
    exact_mod_cast Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr (Nat.ne_zero_of_lt hA))
  rw [hmass]
  have heq : (scale k^A-scale (k+1)^A)/(A:ℝ) =
      shellConstant A * ((1/2:ℝ)^A)^k := by
    unfold scale shellConstant
    rw [pow_succ,mul_pow]
    have hp : ((1/2:ℝ)^k)^A=((1/2:ℝ)^A)^k := by rw [← pow_mul,← pow_mul,Nat.mul_comm]
    rw [hp]
    ring
  rw [heq,ENNReal.ofReal_mul (shellConstant_pos hA).le]
  simp only [ratio,ENNReal.ofReal_pow (by positivity : (0:ℝ)≤(1/2:ℝ)^A)]

/-- Actual integration splits over the proved measurable disjoint dyadic
partition, without any measurability premise on the nonnegative integrand. -/
theorem lintegral_eq_tsum_shell (A : ℕ) (f : ℝ→ℝ≥0∞) :
    ∫⁻ r in Ioc (0:ℝ) 1,f r ∂radialMeasure A =
      ∑' k:ℕ,∫⁻ r in shell k,f r ∂radialMeasure A := by
  rw [← iUnion_shell]
  exact lintegral_iUnion (fun _ => measurableSet_Ioc) shell_pairwise_disjoint f

end MAIS.DyadicRadialMeasure
end

