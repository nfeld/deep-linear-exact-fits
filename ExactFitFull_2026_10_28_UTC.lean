-- ==================== begin module O7.Run2GeometricFiberInvariance (formalization/O7/Run2GeometricFiberInvariance.lean) ====================
section

/-! True geometric local dimensions and codimensions are invariant under
actual full-entry gauge and vertex-coordinate equivalences. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricFiberInvariance
open MAIS.Run2GeometricCharts MAIS.Run2GeometricZeroFiber
open MAIS.Run2GeometricCodimension MAIS.Run2GeometricClosure
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open MAIS.QuiverCoordinateMeasuredPair MAIS.MatrixCoordinateTransport

section Linear
variable {E F : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

theorem localDimH_le_linear_image (e : E ≃L[ℝ] F) (s : Set E) (a : E) :
    localDimH s a ≤ localDimH (e '' s) (e a) := by
  apply le_localDimH
  intro r hr
  have hn : e ⁻¹' Metric.ball (e a) r ∈ 𝓝 a :=
    e.continuous.continuousAt.preimage_mem_nhds (Metric.ball_mem_nhds (e a) hr)
  obtain ⟨ρ, hρ, hρsub⟩ := Metric.mem_nhds_iff.mp hn
  calc
    localDimH s a ≤ dimH (s ∩ Metric.ball a ρ) := localDimH_le _ _ hρ
    _ = dimH (e '' (s ∩ Metric.ball a ρ)) := (e.dimH_image _).symm
    _ ≤ dimH ((e '' s) ∩ Metric.ball (e a) r) := by
      apply dimH_mono
      rintro _ ⟨x, hx, rfl⟩
      exact ⟨⟨x, hx.1, rfl⟩, hρsub hx.2⟩

theorem localDimH_linear_image (e : E ≃L[ℝ] F) (s : Set E) (a : E) :
    localDimH (e '' s) (e a) = localDimH s a := by
  apply le_antisymm
  · have h := localDimH_le_linear_image e.symm (e '' s) (e a)
    simpa only [e.symm_image_image, e.symm_apply_apply] using h
  · exact localDimH_le_linear_image e s a

end Linear

variable {D : ℕ} {ι κ : Fin (D + 1) → Type*}
  [∀ v, Fintype (ι v)] [∀ v, DecidableEq (ι v)]
  [∀ v, Fintype (κ v)] [∀ v, DecidableEq (κ v)]

theorem localCodimNat_eq_of_mem_orbit {A B : Rep ι}
    (hAB : A ∈ MulAction.orbit (Gauge ι) B) :
    localCodimNat ι A = localCodimNat ι B := by
  apply le_antisymm
  · exact localCodimNat_mono_of_mem_closure_orbit ι (subset_closure hAB)
  · exact localCodimNat_mono_of_mem_closure_orbit ι
      (subset_closure (MulAction.mem_orbit_symm.mp hAB))

theorem coordinate_image_zeroFiber (e : ∀ v, ι v ≃ κ v) :
    coordinateContinuousEquiv e '' zeroFiber ι = zeroFiber κ := by
  let f := coordinateContinuousEquiv e
  have hforward (A : Rep ι) (hA : A ∈ zeroFiber ι) :
      f A ∈ zeroFiber κ := by
    change pathMatrix A 0 (Fin.last D) (Nat.zero_le D) = 0 at hA
    change pathMatrix (transport e A) 0 (Fin.last D) (Nat.zero_le D) = 0
    rw [path_transport, hA]
    rfl
  have hbackward (B : Rep κ) (hB : B ∈ zeroFiber κ) :
      f.symm B ∈ zeroFiber ι := by
    change pathMatrix B 0 (Fin.last D) (Nat.zero_le D) = 0 at hB
    change pathMatrix (transport (fun v => (e v).symm) B)
      0 (Fin.last D) (Nat.zero_le D) = 0
    rw [path_transport, hB]
    rfl
  ext B
  constructor
  · rintro ⟨A, hA, rfl⟩
    exact hforward A hA
  · intro hB
    exact ⟨f.symm B, hbackward B hB, f.apply_symm_apply B⟩

theorem localDimH_coordinate (e : ∀ v, ι v ≃ κ v) (A : Rep ι) :
    localDimH (zeroFiber κ) (transport e A) =
      localDimH (zeroFiber ι) A := by
  rw [← coordinate_image_zeroFiber e]
  exact localDimH_linear_image (coordinateContinuousEquiv e) _ _

theorem localCodimNat_coordinate (e : ∀ v, ι v ≃ κ v) (A : Rep ι) :
    localCodimNat κ (transport e A) = localCodimNat ι A := by
  have hd := (coordinateContinuousEquiv e).toLinearEquiv.finrank_eq
  simp only [localCodimNat, localDimH_coordinate, hd]

end MAIS.Run2GeometricFiberInvariance

/-- info: 'MAIS.Run2GeometricFiberInvariance.localDimH_le_linear_image' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricFiberInvariance.localDimH_le_linear_image

