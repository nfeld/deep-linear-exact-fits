-- ==================== begin module O7.ClippedBandComparison (formalization/O7/ClippedBandComparison.lean) ====================
section

/-! A genuine bounded monotone band mass can be replaced by a saturated
power-log kernel, with the saturation cutoff derived from its actual order. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace MAIS.ClippedBandComparison
open O77.Residual MAIS.DyadicRadialComparison MAIS.DyadicRadialMeasure

def clippedModel (eta lam : ℝ) (n : ℕ) (x : ℝ) : ℝ≥0∞ :=
  if x<eta then powerLogZero lam n x else 1

private theorem gauge_pos {x : ℝ} (hx : 0<x) (hx1 : x<1) (lam : ℝ) (n : ℕ) :
    0<powerLogZeroReal lam n x := by
  unfold powerLogZeroReal
  apply mul_pos (Real.rpow_pos_of_pos hx _)
  apply pow_pos
  apply Real.log_pos
  exact (lt_div_iff₀ hx).mpr (by simpa using hx1)

/-- The small-level order and a genuine global finite bound imply a global
comparison with a clipped kernel. The lower bound at all larger levels is
proved from monotonicity and one positive small-level band. -/
theorem global_clipped_bounds {B : ℝ→ℝ≥0∞} (hB : Monotone B)
    {lam : ℝ} {n : ℕ} (hp : EThetaZeroPowerLog B lam n)
    {M : ℝ} (_hM : 0<M) (hbound : ∀ x, B x≤ENNReal.ofReal M) :
    ∃ eta c C : ℝ, 0<eta ∧ eta<1 ∧ 0<c ∧ c≤C ∧
      ∀ x, 0<x → ENNReal.ofReal c*clippedModel eta lam n x ≤ B x ∧
        B x≤ENNReal.ofReal C*clippedModel eta lam n x := by
  obtain ⟨a,b,e,ha,hab,he,heExp,hp⟩ := hp
  let eta := e/2
  let x0 := eta/2
  have heta : 0<eta := half_pos he
  have heta_e : eta<e := half_lt_self he
  have hExp1 : Real.exp (-1)<1 := by rw [← Real.exp_zero];exact Real.exp_lt_exp.mpr (by norm_num)
  have heta1 : eta<1 := heta_e.trans (heExp.trans hExp1)
  have hx0 : 0<x0 := half_pos heta
  have hx0eta : x0<eta := half_lt_self heta
  have hx01 : x0<1 := hx0eta.trans heta1
  let q := powerLogZeroReal lam n x0
  have hq : 0<q := gauge_pos hx0 hx01 lam n
  let c := min a (a*q)
  let C := max b M
  have hc : 0<c := lt_min ha (mul_pos ha hq)
  have hcC : c≤C := (min_le_left _ _).trans (hab.trans (le_max_left _ _))
  refine ⟨eta,c,C,heta,heta1,hc,hcC,?_⟩
  intro x hx
  by_cases hxe : x<eta
  · rw [clippedModel,ite_eq_left hxe]
    obtain ⟨hl,hu⟩ := hp x hx (hxe.trans heta_e)
    exact ⟨(mul_le_mul' (ENNReal.ofReal_le_ofReal (min_le_left _ _)) le_rfl).trans hl,
      hu.trans (mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_left _ _)) le_rfl)⟩
  · rw [clippedModel,ite_eq_right hxe,mul_one,mul_one]
    constructor
    · calc
        ENNReal.ofReal c ≤ ENNReal.ofReal (a*q) := ENNReal.ofReal_le_ofReal (min_le_right _ _)
        _ = ENNReal.ofReal a*powerLogZero lam n x0 := by
          rw [ENNReal.ofReal_mul ha.le]
          rfl
        _ ≤ B x0 := (hp x0 hx0 (hx0eta.trans heta_e)).1
        _ ≤ B x := hB (hx0eta.le.trans (le_of_not_gt hxe))
    · exact (hbound x).trans (ENNReal.ofReal_le_ofReal (le_max_right _ _))

/-- Pointwise kernel comparison integrates to the literal radial comparison;
only the positivity of the genuine radius and epsilon is used. -/
theorem radial_bounds_of_global {B G : ℝ→ℝ≥0∞} {c C : ℝ}
    (_hc : 0<c) (_hC : 0<C)
    (hb : ∀ x,0<x→ENNReal.ofReal c*G x≤B x ∧ B x≤ENNReal.ofReal C*G x)
    (A d : ℕ) {eps : ℝ} (heps : 0<eps) :
    ENNReal.ofReal c*weightedIntegral A d G eps ≤ weightedIntegral A d B eps ∧
      weightedIntegral A d B eps ≤ ENNReal.ofReal C*weightedIntegral A d G eps := by
  constructor
  · rw [weightedIntegral,weightedIntegral,
      ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact setLIntegral_mono' measurableSet_Ioc (fun r hr =>
      (hb _ (div_pos heps (pow_pos hr.1 d))).1)
  · rw [weightedIntegral,weightedIntegral,
      ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact setLIntegral_mono' measurableSet_Ioc (fun r hr =>
      (hb _ (div_pos heps (pow_pos hr.1 d))).2)

/-- A measured clipped-kernel order transfers to the actual band integral;
its constants and its large-level comparison have been derived above. -/
theorem radial_order_of_actual_band {B : ℝ→ℝ≥0∞} (hB : Monotone B)
    {beta : ℝ} {m : ℕ} (hp : EThetaZeroPowerLog B beta m)
    {M : ℝ} (hM : 0<M) (hbound : ∀ x, B x≤ENNReal.ofReal M) (A d : ℕ) :
    ∃ eta : ℝ,0<eta ∧ eta<1 ∧ ∀ lam n,
      EThetaZeroPowerLog (fun eps => weightedIntegral A d (clippedModel eta beta m) eps) lam n →
      EThetaZeroPowerLog (fun eps => weightedIntegral A d B eps) lam n := by
  obtain ⟨eta,c,C,heta,heta1,hc,hcC,hb⟩ := global_clipped_bounds hB hp hM hbound
  refine ⟨eta,heta,heta1,fun lam n h => ?_⟩
  apply O77.Transport0906.order_of_two_window_bounds h h hc (hc.trans_le hcC)
  intro eps heps
  exact radial_bounds_of_global hc (hc.trans_le hcC) hb A d heps

/-- For a genuine finite measured annulus, the global bound is derived from
its actual measure. The loss and every measured band are literal. -/
theorem actual_band_clipped_bounds {E : Type*} [MeasurableSpace E]
    (mu : Measure E) (K : Set E) (f : E→ℝ) (hK : mu K≠⊤)
    {lam : ℝ} {n : ℕ}
    (hp : EThetaZeroPowerLog (fun e => mu {x | x∈K ∧ |f x|<e}) lam n) :
    ∃ eta c C : ℝ,0<eta ∧ eta<1 ∧ 0<c ∧ c≤C ∧
      ∀ e,0<e→ENNReal.ofReal c*clippedModel eta lam n e ≤ mu {x | x∈K ∧ |f x|<e} ∧
        mu {x | x∈K ∧ |f x|<e}≤ENNReal.ofReal C*clippedModel eta lam n e := by
  apply global_clipped_bounds (MAIS.DyadicRadialOrder.monotone_actual_band mu K f) hp
    (show 0<(mu K).toReal+1 by positivity)
  intro e
  calc
    _ ≤ mu K := measure_mono (fun _ hx => hx.1)
    _ = ENNReal.ofReal (mu K).toReal := (ENNReal.ofReal_toReal hK).symm
    _ ≤ ENNReal.ofReal ((mu K).toReal+1) := ENNReal.ofReal_le_ofReal (by linarith)

end MAIS.ClippedBandComparison
end

