-- ==================== begin module O7.Run2GeometricOutputCut (formalization/O7/Run2GeometricOutputCut.lean) ====================
section

/-! The full actual output cut supplies a geometric local codimension upper
bound, retaining every regular orbit coordinate and every free cut coordinate. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
noncomputable section
open Set MeasureTheory
open scoped Topology ENNReal NNReal Matrix Matrix.Norms.Frobenius

namespace MAIS.Run2GeometricOutputCut
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank MAIS.OrbitSliceLinear
open MAIS.ActiveIntervalDifferential MAIS.IntervalCochainProduct MAIS.ActiveIntervalSliceChart
open MAIS.ActiveIntervalEndpointRows MAIS.Run2AllHigherAttainment
open MAIS.Run2GeometricCharts MAIS.Run2GeometricZeroFiber MAIS.Run2GeometricCodimension
open MAIS.Run2GeometricOrbitDimension MAIS.Run2GeometricLinearPatch
open MAIS.Run2OutputCut MAIS.Run2PotentialBalancedNormalForms
open MAIS.Run2PotentialBalance MAIS.Run2PotentialStationarity

variable {S : Type*} [Fintype S] [DecidableEq S]
variable (D : ℕ) (birth death : S → ℕ)

def cutEmbedding :
    (TangentParameters D birth death × outputCut D birth death) →L[ℝ]
      (TangentParameters D birth death × NormalParams birth death) :=
  ((LinearMap.id : TangentParameters D birth death →ₗ[ℝ] TangentParameters D birth death).prodMap
    (outputCut D birth death).subtype).toContinuousLinearMap

theorem cutEmbedding_injective : Function.Injective (cutEmbedding D birth death) := by
  intro p q hpq
  apply Prod.ext
  · exact congrArg (fun z : TangentParameters D birth death × NormalParams birth death => z.1) hpq
  · apply Subtype.ext
    exact congrArg (fun z : TangentParameters D birth death × NormalParams birth death => z.2) hpq

theorem outputCount_eq_cardOutput :
    outputCount D birth death = Fintype.card (OutputIndex D birth death) := by
  simp only [outputCount, outputEdgeCount, targetSlot, outputSlots,
    Finset.mem_filter, Finset.mem_univ, true_and, OutputIndex, Fintype.card_subtype]

variable (hD : ∀ s, death s ≤ D + 1)
include hD

theorem cut_dimension_add_output (hvalid : ∀ s, birth s < death s) :
    Module.finrank ℝ (TangentParameters D birth death × outputCut D birth death) +
      Fintype.card (OutputIndex D birth death) =
        Module.finrank ℝ (Rep (Index D birth death)) := by
  have hc := finrank_outputCut_add_cardOutput D birth death
  have hq := Submodule.finrank_quotient_add_finrank
    (orbitDifferential (Index D birth death) (intervalRep D birth death)).range
  rw [MAIS.ActiveIntervalNormal.finrank_orbitDifferential_cokernel
    D birth death hD hvalid] at hq
  rw [Module.finrank_prod]
  have ht := tangent_finrank D birth death
  omega

theorem localDimH_ge_cut_dimension (hvalid : ∀ s, birth s < death s)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0) :
    (Module.finrank ℝ (TangentParameters D birth death × outputCut D birth death) : ℝ≥0∞) ≤
      localDimH (zeroFiber (Index D birth death)) (intervalRep D birth death) := by
  let e := parameterChart D birth death hD hvalid
  obtain ⟨U, hU, hbU, _, hi⟩ :=
    exists_open_inverse_neighborhood D birth death hD hvalid
  have hf : DifferentiableOn ℝ e e.source := by
    intro p _
    exact (analyticAt_parameterChart D birth death hD hvalid p).differentiableAt.differentiableWithinAt
  have hInv : DifferentiableOn ℝ e.symm U := by
    intro A hA
    exact (hi A hA).differentiableAt.differentiableWithinAt
  have hp : (0 : TangentParameters D birth death × NormalParams birth death) ∈ e.source :=
    zero_mem_parameterChart_source D birth death hD hvalid
  have he0 : e 0 = intervalRep D birth death := by
    change parameterChart D birth death hD hvalid (0, 0) = _
    rw [parameterChart_normal, map_zero, add_zero]
  have hcontains : ∀ p : TangentParameters D birth death × outputCut D birth death,
      cutEmbedding D birth death p ∈ e.source →
      e (cutEmbedding D birth death p) ∈ zeroFiber (Index D birth death) := by
    intro p _
    have hz := completeProduct_eq_zero_on_outputCut D birth death hD hzero p.2.val p.2.property
    change pathMatrix (normalFamily D birth death hD p.2.val)
      0 (Fin.last D) (Nat.zero_le D) = 0 at hz
    change pathMatrix (parameterChart D birth death hD hvalid (p.1, p.2.val))
      0 (Fin.last D) (Nat.zero_le D) = 0
    rw [parameterChart_eq_gauge, pathMatrix_gauge, hz, Matrix.mul_zero, Matrix.zero_mul]
  have hd := localDimH_ge_of_chart_linear_patch e hf
    (zeroFiber (Index D birth death)) U hU hInv
    (cutEmbedding D birth death) (cutEmbedding_injective D birth death) hp
    (he0.symm ▸ hbU) hcontains
  simpa only [he0] using hd

theorem localCodimNat_le_outputCount (hvalid : ∀ s, birth s < death s)
    (hzero : pathMatrix (intervalRep D birth death) 0 (Fin.last D) (Nat.zero_le D) = 0) :
    localCodimNat (Index D birth death) (intervalRep D birth death) ≤
      outputCount D birth death := by
  have hd := localDimH_ge_cut_dimension D birth death hD hvalid hzero
  have hr := ENNReal.toReal_mono
    (localDimH_lt_top (Index D birth death) (intervalRep D birth death)).ne hd
  have hfloor :
      Module.finrank ℝ (TangentParameters D birth death × outputCut D birth death) ≤
        ⌊(localDimH (zeroFiber (Index D birth death)) (intervalRep D birth death)).toReal⌋₊ := by
    simpa only [ENNReal.toReal_natCast, Nat.floor_natCast] using Nat.floor_mono hr
  have hsum := cut_dimension_add_output D birth death hD hvalid
  rw [outputCount_eq_cardOutput]
  unfold localCodimNat
  omega

end MAIS.Run2GeometricOutputCut

/-- info: 'MAIS.Run2GeometricOutputCut.cutEmbedding_injective' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricOutputCut.cutEmbedding_injective

/-- info: 'MAIS.Run2GeometricOutputCut.outputCount_eq_cardOutput' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricOutputCut.outputCount_eq_cardOutput

/-- info: 'MAIS.Run2GeometricOutputCut.cut_dimension_add_output' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricOutputCut.cut_dimension_add_output

/-- info: 'MAIS.Run2GeometricOutputCut.localDimH_ge_cut_dimension' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricOutputCut.localDimH_ge_cut_dimension

/-- info: 'MAIS.Run2GeometricOutputCut.localCodimNat_le_outputCount' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricOutputCut.localCodimNat_le_outputCount
end
end
