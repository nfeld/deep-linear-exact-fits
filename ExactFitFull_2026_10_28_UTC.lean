  · calc
      ENNReal.ofReal low * powerLogZero lam k eps ≤
          ENNReal.ofReal (lo*a) * powerLogZero lam k eps :=
        mul_le_mul' (ENNReal.ofReal_le_ofReal (min_le_left _ _)) le_rfl
      _ = ENNReal.ofReal lo *
          (ENNReal.ofReal a * powerLogZero lam k eps) := by
