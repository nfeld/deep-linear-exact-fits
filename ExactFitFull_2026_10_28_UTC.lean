-- ==================== begin module O7.Run2GeometricGerms (formalization/O7/Run2GeometricGerms.lean) ====================
section

/-! Actual local Hausdorff dimension is invariant under a genuine partial
differentiable chart.  Only actual neighborhood cofinality is used. -/
set_option autoImplicit false
set_option maxHeartbeats 1700000
noncomputable section
open Set MeasureTheory Filter
open scoped Topology ENNReal NNReal

namespace MAIS.Run2GeometricGerms
open MAIS.Run2GeometricCharts

variable {E F : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

omit [NormedSpace ℝ E] in
theorem localDimH_inter_of_mem_nhds (s : Set E) {U : Set E} {a : E}
    (hU : U ∈ 𝓝 a) :
    localDimH (s ∩ U) a = localDimH s a := by
  apply le_antisymm (localDimH_mono inter_subset_left a)
  obtain ⟨ρ, hρ, hρU⟩ := Metric.mem_nhds_iff.mp hU
  apply le_localDimH
  intro r hr
  calc
    localDimH s a ≤ dimH (s ∩ Metric.ball a (min r ρ)) :=
      localDimH_le _ _ (lt_min hr hρ)
    _ ≤ dimH ((s ∩ U) ∩ Metric.ball a r) := by
      apply dimH_mono
      intro x hx
      have hxr : x ∈ Metric.ball a r :=
        (Metric.ball_subset_ball (min_le_left r ρ)) hx.2
      have hxρ : x ∈ Metric.ball a ρ :=
        (Metric.ball_subset_ball (min_le_right r ρ)) hx.2
      exact ⟨⟨hx.1, hρU hxρ⟩, hxr⟩

theorem localDimH_le_partial_image (e : OpenPartialHomeomorph E F)
    (s : Set E) (hs : s ⊆ e.source) (a : E) (ha : a ∈ e.source)
    (hf : DifferentiableOn ℝ e s)
    (hi : DifferentiableOn ℝ e.symm (e '' s)) :
    localDimH s a ≤ localDimH (e '' s) (e a) := by
  apply le_localDimH
  intro r hr
  have hc : ContinuousAt e a :=
    e.continuousOn.continuousAt (e.open_source.mem_nhds ha)
  obtain ⟨ρ, hρ, hρpre⟩ := Metric.mem_nhds_iff.mp
    (hc.preimage_mem_nhds (Metric.ball_mem_nhds (e a) hr))
  have hdim : dimH (e '' (s ∩ Metric.ball a ρ)) =
      dimH (s ∩ Metric.ball a ρ) :=
    dimH_image_eq_of_left_inverse (hf.mono inter_subset_left)
      (hi.mono (image_mono inter_subset_left))
      (fun x hx => e.left_inv (hs hx.1))
  calc
    localDimH s a ≤ dimH (s ∩ Metric.ball a ρ) := localDimH_le _ _ hρ
    _ = dimH (e '' (s ∩ Metric.ball a ρ)) := hdim.symm
    _ ≤ dimH ((e '' s) ∩ Metric.ball (e a) r) := by
      apply dimH_mono
      rintro _ ⟨x, hx, rfl⟩
      exact ⟨⟨x, hx.1, rfl⟩, hρpre hx.2⟩

theorem localDimH_partial_image (e : OpenPartialHomeomorph E F)
    (s : Set E) (hs : s ⊆ e.source) (a : E) (ha : a ∈ e.source)
    (hf : DifferentiableOn ℝ e s)
    (hi : DifferentiableOn ℝ e.symm (e '' s)) :
    localDimH (e '' s) (e a) = localDimH s a := by
  apply le_antisymm
  · have hs' : e '' s ⊆ e.symm.source :=
      fun _ hx => by
        obtain ⟨x, hx, rfl⟩ := hx
        exact e.map_source (hs hx)
    have hset : e.symm '' (e '' s) = s := e.symm_image_image_of_subset_source hs
    have hf' : DifferentiableOn ℝ e.symm.symm (e.symm '' (e '' s)) := by
      rw [hset]
      exact hf
    have h := localDimH_le_partial_image e.symm (e '' s) hs' (e a)
      (e.map_source ha) hi hf'
    simpa only [hset, e.left_inv ha] using h
  · exact localDimH_le_partial_image e s hs a ha hf hi

/-- A genuine local fiber identity transports its literal local Hausdorff
dimension. The inverse is required only on the actual open target neighborhood. -/
theorem localDimH_fiber_chart
    (e : OpenPartialHomeomorph E F)
    (a : E) (ha : a ∈ e.source)
    (s : Set E) (t U : Set F)
    (hU : IsOpen U) (haU : e a ∈ U) (hUt : U ⊆ e.target)
    (hf : DifferentiableOn ℝ e e.source)
    (hi : DifferentiableOn ℝ e.symm U)
    (hiff : ∀ x ∈ e.source, e x ∈ t ↔ x ∈ s) :
    localDimH t (e a) = localDimH s a := by
  let V : Set E := e.source ∩ e ⁻¹' U
  let s' : Set E := s ∩ V
  have hc : ContinuousAt e a :=
    e.continuousOn.continuousAt (e.open_source.mem_nhds ha)
  have hV : V ∈ 𝓝 a :=
    inter_mem (e.open_source.mem_nhds ha) (hc.preimage_mem_nhds (hU.mem_nhds haU))
  have hs : s' ⊆ e.source := fun _ hx => hx.2.1
  have himage : e '' s' = t ∩ U := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact ⟨(hiff x hx.2.1).mpr hx.1, hx.2.2⟩
    · intro hy
      let x := e.symm y
      have hx : x ∈ e.source := e.map_target (hUt hy.2)
      have hexy : e x = y := e.right_inv (hUt hy.2)
      refine ⟨x, ⟨?_, hx, ?_⟩, hexy⟩
      · exact (hiff x hx).mp (hexy.symm ▸ hy.1)
      · change e x ∈ U
        rw [hexy]
        exact hy.2
  have hInv : DifferentiableOn ℝ e.symm (e '' s') := by
    rw [himage]
    exact hi.mono inter_subset_right
  have hdim := localDimH_partial_image e s' hs a ha (hf.mono hs) hInv
  rw [himage] at hdim
  calc
    localDimH t (e a) = localDimH (t ∩ U) (e a) :=
      (localDimH_inter_of_mem_nhds t (hU.mem_nhds haU)).symm
    _ = localDimH s' a := hdim
    _ = localDimH s a := localDimH_inter_of_mem_nhds s hV

end MAIS.Run2GeometricGerms

/-- info: 'MAIS.Run2GeometricGerms.localDimH_inter_of_mem_nhds' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricGerms.localDimH_inter_of_mem_nhds

/-- info: 'MAIS.Run2GeometricGerms.localDimH_le_partial_image' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricGerms.localDimH_le_partial_image

/-- info: 'MAIS.Run2GeometricGerms.localDimH_partial_image' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricGerms.localDimH_partial_image

/-- info: 'MAIS.Run2GeometricGerms.localDimH_fiber_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricGerms.localDimH_fiber_chart
end
end
-- ==================== end module O7.Run2GeometricGerms ====================

-- ==================== begin module O7.Run2GeometricCodimCharts (formalization/O7/Run2GeometricCodimCharts.lean) ====================
section

/-! Genuine geometric codimension for arbitrary actual fibers and its
invariance under an actual local differentiable ambient chart. -/
set_option autoImplicit false
set_option maxHeartbeats 1700000
noncomputable section
open Set MeasureTheory Filter
open scoped Topology ENNReal NNReal

namespace MAIS.Run2GeometricCodimCharts
open MAIS.Run2GeometricCharts MAIS.Run2GeometricGerms

variable {E F : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]

/-- Derived from actual local Hausdorff dimension, independently of all
measured pairs or orbit incidence counts. -/
def geometricCodimNat (s : Set E) (a : E) : ℕ :=
  Module.finrank ℝ E - ⌊(localDimH s a).toReal⌋₊

theorem finrank_eq_of_differentiable_chart
    (e : OpenPartialHomeomorph E F)
    (a : E) (ha : a ∈ e.source)
    (U : Set F) (hU : IsOpen U) (haU : e a ∈ U) (hUt : U ⊆ e.target)
    (hf : DifferentiableOn ℝ e e.source)
    (hi : DifferentiableOn ℝ e.symm U) :
    Module.finrank ℝ E = Module.finrank ℝ F := by
  let V : Set E := e.source ∩ e ⁻¹' U
  have hc : ContinuousAt e a :=
    e.continuousOn.continuousAt (e.open_source.mem_nhds ha)
  have hV : V ∈ 𝓝 a :=
    inter_mem (e.open_source.mem_nhds ha) (hc.preimage_mem_nhds (hU.mem_nhds haU))
  have heU : e '' V = U := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact hx.2
    · intro hy
      refine ⟨e.symm y, ⟨e.map_target (hUt hy), ?_⟩, e.right_inv (hUt hy)⟩
      change e (e.symm y) ∈ U
      rw [e.right_inv (hUt hy)]
      exact hy
  have hInv : DifferentiableOn ℝ e.symm (e '' V) := by
    rw [heU]
    exact hi
  have hd := dimH_image_eq_of_left_inverse (hf.mono inter_subset_left) hInv
    (fun x hx => e.left_inv hx.1)
  rw [heU, Real.dimH_of_mem_nhds hV, Real.dimH_of_mem_nhds (hU.mem_nhds haU)] at hd
  exact_mod_cast hd.symm

theorem geometricCodimNat_fiber_chart
    (e : OpenPartialHomeomorph E F)
    (a : E) (ha : a ∈ e.source)
    (s : Set E) (t U : Set F)
    (hU : IsOpen U) (haU : e a ∈ U) (hUt : U ⊆ e.target)
    (hf : DifferentiableOn ℝ e e.source)
    (hi : DifferentiableOn ℝ e.symm U)
    (hiff : ∀ x ∈ e.source, e x ∈ t ↔ x ∈ s) :
    geometricCodimNat t (e a) = geometricCodimNat s a := by
  have hd := finrank_eq_of_differentiable_chart e a ha U hU haU hUt hf hi
  have hloc := localDimH_fiber_chart e a ha s t U hU haU hUt hf hi hiff
  simp only [geometricCodimNat, hloc, hd]

end MAIS.Run2GeometricCodimCharts

/-- info: 'MAIS.Run2GeometricCodimCharts.finrank_eq_of_differentiable_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCodimCharts.finrank_eq_of_differentiable_chart

/-- info: 'MAIS.Run2GeometricCodimCharts.geometricCodimNat_fiber_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricCodimCharts.geometricCodimNat_fiber_chart
end
end
-- ==================== end module O7.Run2GeometricCodimCharts ====================

-- ==================== begin module O7.Run2GeometricAnalyticFiber (formalization/O7/Run2GeometricAnalyticFiber.lean) ====================
section

/-! Actual local analytic fiber charts transport the independently defined
geometric codimension. Their identities are only required on a genuine open
source neighborhood; the inverse need only be analytic at the center. -/
set_option autoImplicit false
set_option maxHeartbeats 1600000
noncomputable section
open Set Filter
open scoped Topology
namespace MAIS.Run2GeometricAnalyticFiber
open MAIS.Run2GeometricCodimCharts
variable {E F : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]

theorem geometricCodimNat_of_local_analytic_chart
    (e : OpenPartialHomeomorph E F) (a : E)
    (V : Set E) (hV : IsOpen V) (haV : a ∈ V) (hVs : V ⊆ e.source)
    (hf : ∀ x ∈ V, AnalyticAt ℝ e x) (hi : AnalyticAt ℝ e.symm (e a))
    (s : Set E) (t : Set F)
    (hiff : ∀ x ∈ V, e x ∈ t ↔ x ∈ s) :
    geometricCodimNat t (e a) = geometricCodimNat s a := by
  let e' := e.restrOpen V hV
  have has : a ∈ e'.source := ⟨hVs haV,haV⟩
  obtain ⟨W,hW,hWo,haW⟩ := mem_nhds_iff.mp hi.eventually_analyticAt
  let U := W ∩ e'.target
  have hU : IsOpen U := hWo.inter e'.open_target
  have haU : e' a ∈ U := ⟨haW,e'.map_source has⟩
  apply geometricCodimNat_fiber_chart e' a has s t U hU haU inter_subset_right
  · intro x hx
    exact (hf x hx.2).differentiableAt.differentiableWithinAt
  · intro y hy
    exact (hW hy.1).differentiableAt.differentiableWithinAt
  · intro x hx
    exact hiff x hx.2
omit [FiniteDimensional ℝ F] in
theorem localDimH_of_local_analytic_chart
    (e : OpenPartialHomeomorph E F) (a : E)
    (V : Set E) (hV : IsOpen V) (haV : a ∈ V) (hVs : V ⊆ e.source)
    (hf : ∀ x ∈ V, AnalyticAt ℝ e x) (hi : AnalyticAt ℝ e.symm (e a))
    (s : Set E) (t : Set F)
    (hiff : ∀ x ∈ V, e x ∈ t ↔ x ∈ s) :
    MAIS.Run2GeometricCharts.localDimH t (e a) = MAIS.Run2GeometricCharts.localDimH s a := by
  let e' := e.restrOpen V hV
  have has : a ∈ e'.source := ⟨hVs haV,haV⟩
  obtain ⟨W,hW,hWo,haW⟩ := mem_nhds_iff.mp hi.eventually_analyticAt
  let U := W ∩ e'.target
  have hU : IsOpen U := hWo.inter e'.open_target
  have haU : e' a ∈ U := ⟨haW,e'.map_source has⟩
  apply MAIS.Run2GeometricGerms.localDimH_fiber_chart e' a has s t U hU haU inter_subset_right
  · intro x hx
    exact (hf x hx.2).differentiableAt.differentiableWithinAt
  · intro y hy
    exact (hW hy.1).differentiableAt.differentiableWithinAt
  · intro x hx
    exact hiff x hx.2
end MAIS.Run2GeometricAnalyticFiber

/-- info: 'MAIS.Run2GeometricAnalyticFiber.geometricCodimNat_of_local_analytic_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricAnalyticFiber.geometricCodimNat_of_local_analytic_chart

/-- info: 'MAIS.Run2GeometricAnalyticFiber.localDimH_of_local_analytic_chart' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2GeometricAnalyticFiber.localDimH_of_local_analytic_chart
end
end
