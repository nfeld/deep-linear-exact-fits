#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalance.balanced_of_normal_threshold_eq

/-- info: 'MAIS.Run2PotentialBalance.normal_radial_exponent_eq_half_output_count' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalance.normal_radial_exponent_eq_half_output_count

/-- info: 'MAIS.Run2PotentialBalance.normal_radial_exponent_half_integer' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms MAIS.Run2PotentialBalance.normal_radial_exponent_half_integer

