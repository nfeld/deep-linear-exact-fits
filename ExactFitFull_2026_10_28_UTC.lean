-- ==================== begin module O7.QuiverZeroPairExistence (formalization/O7/QuiverZeroPairExistence.lean) ====================
section

/-! General actual zero-output measured-pair existence, obtained by genuine
well-founded reverse orbit induction, actual interval normalization and the
proved recursive measured construction. No pair/type/exponent oracle. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 3000000
noncomputable section
open Set MeasureTheory MeasureTheory.Measure
open scoped Matrix Matrix.Norms.Frobenius
namespace MAIS.QuiverZeroPairExistence
open MAIS.QuiverRealOrbit MAIS.MatrixChainIsomorphism MAIS.QuiverOrbitRank
open MAIS.MatrixCoordinateTransport MAIS.BarcodeActiveNormalForm
open MAIS.QuiverIntervalMeasuredNormalForm MAIS.ActiveIntervalDifferential
open MAIS.ActiveIntervalMeasuredSlice MAIS.AnalyticTransfer
variable {D:ℕ} (ι:Fin (D+1)→Type*)
  [∀ v,Fintype (ι v)] [∀ v,DecidableEq (ι v)]

/-- Every actual finite rectangular real matrix chain on the zero-output
fiber has an actual radius-first Haar pair. The induction and finite measured
higher tables are constructed from actual orbit/rank geometry, not assumed. -/
theorem exists_pair_zero_output (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A:Rep ι) (hzero:pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0) :
    ∃ a:ℝ,∃ m:ℕ,HasMeasuredBandPair mu (Metric.ball A)
      (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A a m := by
  have hall:∀ A:Rep ι,pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0→
      ∃ a:ℝ,∃ m:ℕ,HasMeasuredBandPair mu (Metric.ball A)
        (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A a m:=by
    intro A
    refine (MAIS.QuiverOrbitFiniteHeight.wellFounded_strict_generization ι).induction
      (C:=fun B:Rep ι=>pathMatrix B 0 (Fin.last D) (Nat.zero_le D)=0→
        ∃ a:ℝ,∃ m:ℕ,HasMeasuredBandPair mu (Metric.ball B)
          (fun T=>‖pathMatrix T 0 (Fin.last D) (Nat.zero_le D)‖^2) B a m) A ?_
    intro A ih hAzero
    obtain ⟨N⟩:=exists_normal_form A
    let muK:Measure (Rep (Index D N.birth N.death)):=addHaar
    have hKzero:pathMatrix (intervalRep D N.birth N.death) 0 (Fin.last D) (Nat.zero_le D)=0:=
      intervalRep_zero_of_original_zero N 0 (Fin.last D) (Nat.zero_le D) hAzero
    have hpoint:∀ B:Rep (Index D N.birth N.death),
        pathMatrix B 0 (Fin.last D) (Nat.zero_le D)=0→
        intervalRep D N.birth N.death∈closure
          (MulAction.orbit (Gauge (Index D N.birth N.death)) B)→
        B∉MulAction.orbit (Gauge (Index D N.birth N.death)) (intervalRep D N.birth N.death)→
        ∃ a:ℝ,∃ m:ℕ,HasMeasuredBandPair muK (Metric.ball B)
          (ambientLoss D N.birth N.death 0 (Fin.last D) (Nat.zero_le D)) B a m:=by
      intro B hBzero hBcl hBnot
      let T:Rep ι:=transport N.coordinates B
      have hTzero:pathMatrix T 0 (Fin.last D) (Nat.zero_le D)=0:=by
        rw [path_transport,hBzero]
        rfl
      have hcl:A∈closure (MulAction.orbit (Gauge ι) T):=by
        apply MAIS.RealTypeAClosure.mem_closure_orbit_of_path_rank_le
        intro i j hij
        rw [← N.rank_eq i j hij,path_rank_transport]
        exact path_rank_le_of_mem_closure_orbit hBcl i j hij
      have hnot:T∉MulAction.orbit (Gauge ι) A:=by
        intro horb
        obtain ⟨g,hg⟩:=MulAction.mem_orbit_iff.mp horb
        apply hBnot
        apply mem_gauge_orbit_of_path_rank_eq (intervalRep D N.birth N.death) B
        intro i j hij
        have hgr:(pathMatrix T i j hij).rank=(pathMatrix A i j hij).rank:=by
          rw [← hg]
          exact path_rank_gauge g A i j hij
        rw [path_rank_transport] at hgr
        exact (N.rank_eq i j hij).trans hgr.symm
      obtain ⟨a,m,hTpair⟩:=ih T ⟨hcl,hnot⟩ hTzero
      have hc:=MAIS.QuiverCoordinateMeasuredPair.pair_iff_coordinate_transport
        N.coordinates muK mu B 0 (Fin.last D) (Nat.zero_le D) a m
      exact ⟨a,m,hc.mpr hTpair⟩
    obtain ⟨a,m,hKpair⟩:=MAIS.ActiveIntervalExistenceStep.exists_pair_of_pointwise_higher
      D N.birth N.death N.bounded N.valid muK hKzero hpoint
    exact ⟨a,m,(pair_iff_normal_form N mu muK 0 (Fin.last D) (Nat.zero_le D) hAzero a m).mpr hKpair⟩
  exact hall A hzero

/-- The corresponding actual half-squared complete-product loss on true
all-original-entry Euclidean balls, with an arbitrary continuous positive
ambient prior. The pair is derived for every zero-output real matrix chain. -/
theorem exists_entry_half_pair_zero_output_prior
    (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A:Rep ι)
    (hzero:pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0)
    (prior:Rep ι→ℝ) (hprior:ContinuousAt prior A) (hpos:0<prior A) :
    ∃ a:ℝ,∃ m:ℕ,
      HasMeasuredBandPair (mu.withDensity (fun B=>ENNReal.ofReal (prior B)))
        (MAIS.MatrixChainEntryWindows.entryBall ι A)
        (fun B=>(1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A a m := by
  obtain ⟨a,m,hp⟩:=exists_pair_zero_output ι mu A hzero
  have hs:=MAIS.ActiveIntervalMeasuredEntrySlice.pair_iff_positive_scale mu
    (Metric.ball A) (fun _ _ h=>Metric.ball_subset_ball h)
    (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A (1/2:ℝ) (by norm_num) a m
  have hhalf:=hs.mp hp
  have hf:Measurable (fun B:Rep ι=>(1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2):=
    measurable_const.mul ((continuous_pathMatrix 0 (Fin.last D) (Nat.zero_le D)).norm.pow 2).measurable
  have hpriorpair:=
    (MAIS.ContinuousPriorTransfer.pair_iff_continuous_positive_prior mu hf hprior hpos).mp hhalf
  exact ⟨a,m,(MAIS.MatrixChainEntryWindows.pair_iff_entryBall ι
    (mu.withDensity (fun B=>ENNReal.ofReal (prior B))) A).mp hpriorpair⟩


/-- The actual radius-first pair at every zero-output chain is uniquely
well defined, by the proved measured power-log uniqueness theorem. -/
theorem exists_unique_pair_zero_output (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu]
    (A:Rep ι) (hzero:pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0) :
    ∃! p:ℝ×ℕ,HasMeasuredBandPair mu (Metric.ball A)
      (fun B=>‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A p.1 p.2 := by
  obtain ⟨a,m,hp⟩:=exists_pair_zero_output ι mu A hzero
  refine ⟨(a,m),hp,?_⟩
  rintro ⟨b,n⟩ hb
  obtain ⟨h1,h2⟩:=O77.PowerLogUniqueness.radius_order_unique hb hp
  exact Prod.ext h1 h2

/-- The literal full-original-entry half-loss with every continuous
positive ambient prior also has a unique actual pair on the zero fiber. -/
theorem exists_unique_entry_half_pair_zero_output_prior
    (mu:Measure (Rep ι)) [Measure.IsAddHaarMeasure mu] (A:Rep ι)
    (hzero:pathMatrix A 0 (Fin.last D) (Nat.zero_le D)=0)
    (prior:Rep ι→ℝ) (hprior:ContinuousAt prior A) (hpos:0<prior A) :
    ∃! p:ℝ×ℕ,
      HasMeasuredBandPair (mu.withDensity (fun B=>ENNReal.ofReal (prior B)))
        (MAIS.MatrixChainEntryWindows.entryBall ι A)
        (fun B=>(1/2:ℝ)*‖pathMatrix B 0 (Fin.last D) (Nat.zero_le D)‖^2) A p.1 p.2 := by
  obtain ⟨a,m,hp⟩:=exists_entry_half_pair_zero_output_prior ι mu A hzero prior hprior hpos
  refine ⟨(a,m),hp,?_⟩
  rintro ⟨b,n⟩ hb
  obtain ⟨h1,h2⟩:=O77.PowerLogUniqueness.radius_order_unique hb hp
  exact Prod.ext h1 h2

end MAIS.QuiverZeroPairExistence
end

