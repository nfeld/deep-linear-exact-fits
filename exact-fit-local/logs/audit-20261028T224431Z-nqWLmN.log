  (μ : MeasureTheory.Measure (MAIS.ExactFitStatement.Chain n)) [μ.IsAddHaarMeasure] (A : MAIS.ExactFitStatement.Chain n)
  (Φ : Matrix (Fin (n (Fin.last D))) (Fin (n 0)) ℝ),
  MAIS.ExactFitStatement.product n A = Φ →
    ∀ (φ : MAIS.ExactFitStatement.Chain n → ℝ),
      ContinuousAt φ A →
        0 < φ A →
          ∃ c m,
            MAIS.Run2ArithmeticPositiveData.exactFitPairs n (MAIS.ExactFitStatement.rankTable n A) = {(c, m)} ∧
              ↑(Module.finrank ℝ (MAIS.ExactFitStatement.Chain n)) -
                    ⨅ r, ⨅ (_ : 0 < r), dimH ({B | MAIS.ExactFitStatement.product n B = Φ} ∩ Metric.ball A r) =
                  ↑c ∧
                ∀ (lam : ℝ) (m' : ℕ),
                  MAIS.DirectBandOrder.HasOrder
                      (fun δ ε =>
                        (μ.withDensity fun B => ENNReal.ofReal (φ B))
                          {B |
                            B ∈ MAIS.ExactFitStatement.entryBall n A δ ∧
                              |MAIS.ExactFitStatement.halfLoss n Φ B - MAIS.ExactFitStatement.halfLoss n Φ A| < ε})
                      lam m' ↔
                    lam = ↑c / 2 ∧ m' = m
