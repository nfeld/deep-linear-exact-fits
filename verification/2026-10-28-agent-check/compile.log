def O77.GramWishart.HigherRankConeEigenvalueFormula : Prop :=
∀ (k d : ℕ),
  2 ≤ k →
    k ≤ d →
      ∃ D,
        0 < D ∧
          D < ⊤ ∧
            ∀ (rho T : ℝ),
              0 ≤ rho →
                0 ≤ T →
                  O77.GramBorder.coneLIntegral k d (O77.GramBorder.determinantTest rho T) =
                    D * O77.Residual.laguerreOrthantLIntegral k (O77.Residual.wishartEta k d) rho T
O77.GlobalSpectralIntegral.cone_eq_spectralConstant_mul_laguerre : ∀ (k d : ℕ) (rho T : ℝ),
  0 ≤ T →
    O77.GramBorder.coneLIntegral k d (O77.GramBorder.determinantTest rho T) =
      O77.GlobalSpectralIntegral.spectralConstant k *
        O77.Residual.laguerreOrthantLIntegral k (O77.Residual.wishartEta k d) rho T
