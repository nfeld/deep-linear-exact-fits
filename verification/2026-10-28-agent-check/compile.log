    (orth_v : ∀ (i j : Fin r), v i ⬝ᵥ v j = if i = j then 1 else 0) : O77.RungGeometry0906.SingularData I O r
def O77.RungGeometry0906.SingularData.OnRung : {I O r : ℕ} →
  O77.RungGeometry0906.SingularData I O r → {H : ℕ} → ℕ → O77.Native.Parameters I O H → Prop :=
fun {I O r} D {H} k w =>
  w.2 * w.1 = D.prefix k ∧
