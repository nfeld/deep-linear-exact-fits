O77.answersO77_of_wishart : O77.External.RealWishartEigenvalueFormula →
  ∀ {I O H : ℕ} (Phi : O77.Reconstruction0905.RM O I), 0 < I → 0 < O → Matrix.rank Phi < H → O77.AnswersO77 Phi
def O77.AnswersO77 : {I O : ℕ} → {H : ℕ} → O77.Reconstruction0905.RM O I → Prop :=
fun {I O H} Phi =>
  (∀ (w : O77.Native.Parameters I O H),
      w.2 * w.1 = Phi →
        O77.RankData I O H (Matrix.rank Phi) (Matrix.rank w.1) (Matrix.rank w.2) ∧
          0 < ↑(O77.candidateTwiceLambda I O H (Matrix.rank Phi) (Matrix.rank w.1) (Matrix.rank w.2)) / 2 ∧
            ∀ (lam : ℝ) (m : ℕ),
              O77.Native.HasLocalBandPair Phi w lam m ↔
                lam = ↑(O77.candidateTwiceLambda I O H (Matrix.rank Phi) (Matrix.rank w.1) (Matrix.rank w.2)) / 2 ∧
                  m = O77.candidateMultiplicity I O H (Matrix.rank Phi) (Matrix.rank w.1) (Matrix.rank w.2)) ∧
    (∀ (a b : ℕ),
        O77.RankData I O H (Matrix.rank Phi) a b ↔ ∃ w, w.2 * w.1 = Phi ∧ Matrix.rank w.1 = a ∧ Matrix.rank w.2 = b) ∧
      (∀ (w : O77.Native.Parameters I O H),
          w.2 * w.1 = Phi →
            (O77.Native.IsThresholdMinimizer Phi w ↔
              O77.MinimumRankCondition I O H (Matrix.rank Phi) (Matrix.rank w.1) (Matrix.rank w.2))) ∧
        IsLeast {lam | ∃ w, w.2 * w.1 = Phi ∧ ∃ m, O77.Native.HasLocalBandPair Phi w lam m}
            (O77.Native.globalThresholdFormula I O H (Matrix.rank Phi)) ∧
          IsGreatest {m | ∃ w, O77.Native.IsThresholdMinimizer Phi w ∧ ∃ lam, O77.Native.HasLocalBandPair Phi w lam m}
              (if
                  (I + O + H + Matrix.rank Phi) % 2 = 1 ∧
                    O + Matrix.rank Phi ≤ I + H ∧ I + Matrix.rank Phi ≤ O + H ∧ H + Matrix.rank Phi ≤ I + O then
                2
              else 1) ∧
            ∀ (D : O77.RungGeometry0906.SingularData I O (Matrix.rank Phi)),
              D.target = Phi →
                (∀ k ≤ Matrix.rank Phi, ∃ w, D.OnRung k w) ∧
                  ∀ k < Matrix.rank Phi,
                    ∀ (w : O77.Native.Parameters I O H), D.OnRung k w → O77.Native.HasLocalBandPair Phi w 1 1
def O77.Native.IsThresholdMinimizer : {I O H : ℕ} →
  O77.Reconstruction0905.RM O I → O77.Native.Parameters I O H → Prop :=
fun {I O H} Phi w =>
  w.2 * w.1 = Phi ∧
    ∃ lam m,
      O77.Native.HasLocalBandPair Phi w lam m ∧
        ∀ (z : O77.Native.Parameters I O H),
          z.2 * z.1 = Phi → ∀ (mu : ℝ) (n : ℕ), O77.Native.HasLocalBandPair Phi z mu n → lam ≤ mu
def O77.candidateTwiceLambda : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ :=
fun I O H r a b => O77.regularDim I O a b + O77.residualMin (O - b) (I - a) (O77.residualHidden H r a b)
def O77.candidateMultiplicity : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ :=
fun I O H r a b => O77.residualMultiplicity (O - b) (I - a) (O77.residualHidden H r a b)
def O77.regularDim : ℕ → ℕ → ℕ → ℕ → ℕ :=
fun I O a b => O * a + b * (I - a)
def O77.residualHidden : ℕ → ℕ → ℕ → ℕ → ℕ :=
fun H r a b => H + r - (a + b)
def O77.residualCost : ℕ → ℕ → ℕ → ℕ → ℕ :=
fun p q h t => (h - t) * (q - t) + p * t
def O77.residualMin : ℕ → ℕ → ℕ → ℕ :=
fun p q h => (O77.Arithmetic.minimumUpTo (O77.residualQuadratic p q h) (min h q)).toNat
def O77.residualMinimizerList : ℕ → ℕ → ℕ → List ℕ :=
fun p q h => O77.Arithmetic.minimizerList (O77.residualQuadratic p q h) (min h q)
def O77.residualMultiplicity : ℕ → ℕ → ℕ → ℕ :=
fun p q h => (O77.residualMinimizerList p q h).length
def O77.Native.HasLocalBandPair : {I O H : ℕ} →
  O77.Reconstruction0905.RM O I → O77.Native.Parameters I O H → ℝ → ℕ → Prop :=
fun {I O H} Phi w lam m => O77.Transport0906.RadiusOrder (O77.Native.bandVolume Phi w) lam m
def O77.Transport0906.RadiusOrder : (ℝ → ℝ → ENNReal) → ℝ → ℕ → Prop :=
fun V lam m =>
  0 ≤ lam ∧
    1 ≤ m ∧
      ∃ rho, 0 < rho ∧ ∀ (delta : ℝ), 0 < delta → delta < rho → O77.Residual.EThetaZeroPowerLog (V delta) lam (m - 1)
def O77.Residual.EThetaZeroPowerLog : (ℝ → ENNReal) → ℝ → ℕ → Prop :=
fun V lam k =>
  ∃ c C eps0,
    0 < c ∧
      c ≤ C ∧
        0 < eps0 ∧
          eps0 < Real.exp (-1) ∧
            ∀ (eps : ℝ),
              0 < eps →
                eps < eps0 →
                  ENNReal.ofReal c * O77.Residual.powerLogZero lam k eps ≤ V eps ∧
                    V eps ≤ ENNReal.ofReal C * O77.Residual.powerLogZero lam k eps
def O77.Residual.powerLogZero : ℝ → ℕ → ℝ → ENNReal :=
fun lam k eps => ENNReal.ofReal (O77.Residual.powerLogZeroReal lam k eps)
def O77.Residual.powerLogZeroReal : ℝ → ℕ → ℝ → ℝ :=
fun lam k eps => eps ^ lam * Real.log (1 / eps) ^ k
def O77.Native.entryMeasure : (I O H : ℕ) → MeasureTheory.Measure (O77.Native.Parameters I O H) :=
fun I O H => (O77.Residual.matrixLebesgue (Fin H) (Fin I)).prod (O77.Residual.matrixLebesgue (Fin O) (Fin H))
def O77.Residual.matrixLebesgue.{u_1, u_2} : (p : Type u_1) →
  (h : Type u_2) → [Fintype p] → [Fintype h] → MeasureTheory.Measure (Matrix p h ℝ) :=
fun p h [Fintype p] [Fintype h] => MeasureTheory.Measure.pi fun x => O77.Residual.coordinateLebesgue h
def O77.Residual.coordinateLebesgue.{u_1} : (ι : Type u_1) → [Fintype ι] → MeasureTheory.Measure (ι → ℝ) :=
fun ι [Fintype ι] => MeasureTheory.Measure.pi fun x => MeasureTheory.volume
def O77.Native.ambientSq : {I O H : ℕ} → O77.Native.Parameters I O H → ℝ :=
fun {I O H} w => O77.Residual.frobeniusSq w.1 + O77.Residual.frobeniusSq w.2
def O77.Native.entryNorm : {I O H : ℕ} → O77.Native.Parameters I O H → ℝ :=
fun {I O H} w => √(O77.Native.ambientSq w)
def O77.Native.entryBall : {I O H : ℕ} → O77.Native.Parameters I O H → ℝ → Set (O77.Native.Parameters I O H) :=
fun {I O H} w R => {v | O77.Native.entryNorm (v - w) < R}
def O77.Native.loss : {I O H : ℕ} → O77.Reconstruction0905.RM O I → O77.Native.Parameters I O H → ℝ :=
fun {I O H} Phi w => O77.Residual.frobeniusSq (w.2 * w.1 - Phi) / 2
def O77.Native.bandSet : {I O H : ℕ} →
  O77.Reconstruction0905.RM O I → O77.Native.Parameters I O H → ℝ → ℝ → Set (O77.Native.Parameters I O H) :=
fun {I O H} Phi w R eps => {v | v ∈ O77.Native.entryBall w R ∧ |O77.Native.loss Phi v - O77.Native.loss Phi w| < eps}
def O77.Native.bandVolume : {I O H : ℕ} →
  O77.Reconstruction0905.RM O I → O77.Native.Parameters I O H → ℝ → ℝ → ENNReal :=
fun {I O H} Phi w R eps => (O77.Native.entryMeasure I O H) (O77.Native.bandSet Phi w R eps)
