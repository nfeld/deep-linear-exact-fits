  O77.RungGeometry0906.SingularData.mk {I O r : ℕ} (sigma : Fin r → ℝ) (sigma_pos : ∀ (j : Fin r), 0 < sigma j)
    (decreasing : StrictAnti sigma) (u : Fin r → Fin O → ℝ) (v : Fin r → Fin I → ℝ)
