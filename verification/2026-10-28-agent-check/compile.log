def O77.External.RealWishartEigenvalueFormula : Prop :=
∀ (k d : ℕ), k ≤ d → O77.Residual.ConcreteRealWishartEigenvalueFormula k d
def O77.Residual.ConcreteRealWishartEigenvalueFormula : ℕ → ℕ → Prop :=
fun k d => ∃ C, O77.Residual.HasConcreteRealWishartFormula k d C
def O77.Residual.HasConcreteRealWishartFormula : ℕ → ℕ → ENNReal → Prop :=
fun k d C =>
  k ≤ d ∧
    0 < C ∧
      C < ⊤ ∧
        ∀ (rho T : ℝ),
          0 ≤ rho →
            0 ≤ T →
              O77.Residual.leftGramLaplaceLIntegral k d rho T =
                  C * O77.Residual.laguerreOrthantLIntegral k (O77.Residual.wishartEta k d) rho T ∧
                O77.Residual.rightGramLaplaceLIntegral d k rho T =
                  C * O77.Residual.laguerreOrthantLIntegral k (O77.Residual.wishartEta k d) rho T
O77.GramPushforward.gaussianGramLIntegral_eq_gramMass_mul_cone : ∀ (k d : ℕ),
  k ≤ d →
    ∀ (F : Matrix (Fin k) (Fin k) ℝ → ENNReal),
      Measurable F →
        O77.GramBorder.gaussianGramLIntegral k d F =
          ENNReal.ofReal (O77.GramBorder.gramMass k d) * O77.GramBorder.coneLIntegral k d F
